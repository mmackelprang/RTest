# Build results
[Bb]in/

# The kiosk helper scripts are SOURCE that happens to live in a directory called bin/, so the
# [Bb]in/ rule above swallows them: `git add` skips them silently and the helper ships only to
# the box, never to the repo. Un-ignore the directory itself — [Bb]in/ has a trailing slash and
# so matches directories only, which means nothing inside it is ignored once this line applies.
!deploy/debian-x64/kiosk/bin/
[Oo]bj/
[Oo]ut/
[Ll]og/
[Ll]ogs/

# Publish output (deploy artifacts)
publish/

# Data files (runtime databases, not source code)
/data/
*.db
!src/**/Data/

# Runtime data generated by the app at runtime (albumart, fingerprints, secrets, config DBs)
# Use explicit paths to avoid matching source code directories like Metrics/Data/
src/Radio.API/data/
src/Radio.Web/data/

# NuGet
*.nupkg
*.snupkg
**/[Pp]ackages/*
!**/[Pp]ackages/build/

# Local NuGet feed (packages/ at repo root) — keep directory, ignore contents
!/packages/.gitkeep

# Visual Studio
.vs/
*.user
*.suo
*.userosscache
*.sln.docstates

# JetBrains Rider
.idea/
*.sln.iml

# VS Code
.vscode/

# Test results
[Tt]est[Rr]esult*/
[Bb]uild[Ll]og.*
*.trx
*.coverage
*.coveragexml

# NCrunch
_NCrunch_*

# Misc
*.ncrunchsolution
*.cache
*.orig
.fake
.paket/
paket-files/
nul

# User files
*.csproj.user
*.vspx
*.bak
*.tmp
*.temp

# Mac
.DS_Store
.AppleDouble
.LSOverride

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# Linux
*~

# Secrets and local configuration
appsettings.Development.json
appsettings.Local.json
secrets.json
*.pfx
*.key
task_plan.md

# Playwright MCP scratch output (console logs + page snapshots)
.playwright-mcp/

# Stray UAT screenshots dropped in the repo root by browser-driving agents.
# Root-anchored on purpose: curated UAT evidence under docs/uat/ and
# docs/design-handoffs/ IS tracked and must stay tracked.
/uat-*.png
/uat-*.jpg
