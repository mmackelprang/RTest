<Project>
  <PropertyGroup>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <WarningsAsErrors />
    <NoWarn>$(NoWarn);CS1591;CS1998;NU1605</NoWarn>
    <!-- IDE style rules: enforced as warnings, not errors (pre-existing violations in older code) -->
    <WarningsNotAsErrors>$(WarningsNotAsErrors);IDE0011;IDE0161</WarningsNotAsErrors>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
  </PropertyGroup>

  <!-- Shared NuGet packaging defaults — only applies to projects with a PackageId -->
  <PropertyGroup Condition="'$(PackageId)' != ''">
    <Authors>Mark Mackelprang</Authors>
    <Copyright>Copyright (c) 2026 Mark Mackelprang</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/mmackelprang/RTest</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>
</Project>
