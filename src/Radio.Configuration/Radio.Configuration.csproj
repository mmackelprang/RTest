<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>

    <PackageId>Radio.Configuration</PackageId>
    <Version>1.0.0</Version>
    <Description>Managed configuration library with JSON and SQLite backing stores, encrypted secrets, backup/restore, and .NET IConfiguration bridge.</Description>
    <PackageTags>configuration;sqlite;json;secrets;encryption;dataprotection;backup;options</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Radio.Infrastructure" />
    <InternalsVisibleTo Include="Radio.Infrastructure.Tests" />
    <InternalsVisibleTo Include="Radio.IntegrationTests" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.0" />
    <!-- Pin SQLitePCLRaw 3.0.x to clear GHSA-2m69-gcr7-jv3q (CVE-2025-6965). Microsoft.Data.Sqlite
         declares bundle_e_sqlite3 (>= 2.1.11), which NuGet resolves to the vulnerable 2.1.11 (ships
         the deprecated lib.e_sqlite3 with SQLite < 3.50.2). The 3.0.x line replaces lib.e_sqlite3
         with SourceGear.sqlite3 (>= 3.50.4) and carries no advisory. -->
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="3.0.3" />
    <PackageReference Include="SQLitePCLRaw.core" Version="3.0.3" />
    <!-- 10.0.10 (not 10.0.8) to clear NU1903 on the transitive System.Security.Cryptography.Xml:
         DataProtection 10.0.8 declares Cryptography.Xml 10.0.8, which carries five high-severity
         advisories (GHSA-23rf-6693-g89p, GHSA-8q5v-6pqq-x66h, GHSA-cvvh-rhrc-wg4q,
         GHSA-g8r8-53c2-pm3f, GHSA-mmjf-rqrv-855v — all patched in 10.0.10). DataProtection 10.0.10
         declares Cryptography.Xml 10.0.10, so bumping the parent lifts the transitive. Keep these
         in lockstep with the DataProtection.Extensions pins in the test projects. -->
    <PackageReference Include="Microsoft.AspNetCore.DataProtection" Version="10.0.10" />
    <PackageReference Include="Microsoft.Extensions.Configuration" Version="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" Version="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="10.0.0" />
  </ItemGroup>
  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>
</Project>
