@inherits LayoutComponentBase
@using Radio.Web.Components.Dialogs
@using Radio.Web.Models
@inject SystemApiService SystemApi
@inject SourcesApiService SourcesApi
@inject DevicesApiService DevicesApi
@inject AudioApiService AudioApi
@inject AudioStateHubService HubService
@inject QueueApiService QueueApi
@inject NavigationManager NavigationManager
@inject ILogger<MainLayout> Logger
@inject IDialogService DialogService
@inject Radio.Web.Services.DeviceDisplayStateService DeviceDisplayState
@inject Radio.Web.Services.RadioPanelToggleService RadioPanelToggle
@implements IDisposable
@implements IAsyncDisposable

<MudThemeProvider Theme="@_customTheme" IsDarkMode="true" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<div class="layout-container" style="width: 1920px; height: 720px; overflow: hidden;">
  <!-- Top Bar — Command Surface -->
  <div class="topbar">
    <!-- Clock: DSEG amber LED -->
    <div class="display-clock">@_currentTime</div>

    <div class="topbar-separator"></div>

    <!-- Source Routing: Icon toggle group -->
    <div class="route-group">
      <span class="route-label">IN</span>
      @foreach (var source in _availableSources)
      {
        <div class="route-toggle @(source.Id == _selectedSourceId ? "route-active" : "") @(!IsSourceAvailable(source) ? "route-disabled" : "")"
             data-source="@GetSourceDataAttr(source.Type)"
             @onclick="@(() => HandleSourceToggleAsync(source))"
             title="@source.Name">
          <MudIcon Icon="@GetSourceIcon(source.Type)" Size="Size.Medium" />
        </div>
      }
      @if (IsBluetoothSourceSelected())
      {
        <div class="route-toggle" @onclick="@(() => NavigationManager.NavigateTo("/bluetooth"))" title="Bluetooth Settings">
          <MudIcon Icon="@Icons.Material.Filled.SettingsBluetooth" Size="Size.Medium" />
        </div>
      }
    </div>

    <div class="topbar-separator"></div>

    <!-- Output Routing: Icon toggle group -->
    <div class="route-group">
      <span class="route-label">OUT</span>
      @foreach (var output in _availableOutputs)
      {
        <div class="route-toggle @(output.Id == _selectedOutputId ? "route-active" : "")"
             @onclick="@(() => HandleOutputChangeAsync(output.Id))"
             title="@output.Name"
             style="position: relative;">
          <MudIcon Icon="@GetOutputIcon(output)" Size="Size.Medium" />
          @if (output.Id == "google-cast" && _isCastConnecting)
          {
            <div class="cast-connecting" style="position:absolute; inset:0; border-radius:inherit; border: 2px solid var(--accent-primary);"></div>
          }
        </div>
      }
      @if (_selectedOutputId == "google-cast" && _defaultCastDevice != null)
      {
        <span style="font-size: 11px; color: var(--text-low); max-width: 80px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">
          @_defaultCastDevice.Name
        </span>
      }
      @if (_selectedOutputId == "google-cast")
      {
        <div class="route-toggle" @onclick="@OpenCastDeviceDialog" title="Select Cast Device">
          <MudIcon Icon="@Icons.Material.Filled.Settings" Size="Size.Medium" />
        </div>
      }
    </div>

    <!-- Navigation Icons (right-aligned) -->
    <div class="topbar-nav">
      <MudIconButton Icon="@Icons.Material.Filled.Home" Class="@NavClass("/")" Href="/" Size="Size.Large" title="Home" />
      <MudBadge Content="@_queueCount" Overlap="true" Color="Color.Primary" Visible="@(_queueCount > 0)">
        <MudIconButton Icon="@Icons.Material.Filled.QueueMusic" Class="@NavClass("/queue")" Href="/queue" Size="Size.Large" title="Queue" />
      </MudBadge>
      <MudIconButton Icon="@Icons.Material.Filled.Dashboard" Class="@NavClass("/metrics")" Href="/metrics" Size="Size.Large" title="Metrics" />
      <MudIconButton Icon="@Icons.Material.Filled.Devices" Class="@NavClass("/devices")" Href="/devices" Size="Size.Large" title="Devices" />
      <MudIconButton Icon="@Icons.Material.Filled.History" Class="@NavClass("/history")" Href="/history" Size="Size.Large" title="History" />
      <MudIconButton Icon="@Icons.Material.Filled.Settings" Class="@NavClass("/system")" Href="/system" Size="Size.Large" title="Settings" />
    </div>
  </div>

  <!-- Main Content Area — 640px (720 - 80) -->
  <div class="content-area">
    <div class="page-transition">
      @Body
    </div>
  </div>
</div>

@code {
  private string _currentTime = DateTime.Now.ToString("HH:mm");
  private string _cpuUsage = "0";
  private string _ramUsage = "0";
  private string _threadCount = "0";
  private System.Timers.Timer? _timer;
  private List<AudioSourceDto> _availableSources = new();
  private List<AudioDeviceDto> _availableOutputs = new();
  private string? _selectedSourceId = null;
  private string? _selectedOutputId = null;
  private CastDeviceDto? _defaultCastDevice;
  private bool _isCastConnecting;

  private int _queueCount = 0;

  private readonly MudTheme _customTheme = new()
  {
    PaletteLight = new PaletteLight()
    {
      Primary = "#5CD4E8",
      Secondary = "#404045",
      Background = "#0D0D0F",
      Surface = "#141416",
      AppbarBackground = "#0D0D0F",
    },
    PaletteDark = new PaletteDark()
    {
      Primary = "#5CD4E8",
      PrimaryContrastText = "#0D0D0F",
      Secondary = "#4A4A4F",
      SecondaryContrastText = "#F0EFF4",
      Tertiary = "#9CA3AF",
      Background = "#0D0D0F",
      Surface = "#141416",
      AppbarBackground = "#0D0D0F",
      DrawerBackground = "#0D0D0F",
      TextPrimary = "#F0EFF4",
      TextSecondary = "#9CA3AF",
      ActionDefault = "#9CA3AF",
      ActionDisabled = "#4B5563",
      ActionDisabledBackground = "#0D0D0F",
      Divider = "#1F1F22",
      LinesDefault = "#1F1F22",
      Error = "#F87171",
      Warning = "#F0A830",
      Info = "#5CD4E8",
      Success = "#4ADE80",
    },
    LayoutProperties = new LayoutProperties()
    {
      DefaultBorderRadius = "8px",
    }
  };

  protected override async Task OnInitializedAsync()
  {
    try
    {
      Logger.LogDebug("MainLayout.OnInitializedAsync - Starting initialization");

      // Load available sources and outputs
      await LoadSourcesAsync();
      await LoadOutputDevicesAsync();

      // Start the SignalR hub connection (subscribes to RadioState/Queue groups)
      await HubService.StartAsync();

      // Subscribe to audio state updates
      HubService.PlaybackStateChanged += OnPlaybackStateChanged;
      HubService.NowPlayingChanged += OnNowPlayingChanged;
      HubService.QueueChanged += OnQueueChanged;
      HubService.SourceChanged += OnSourceChanged;
      DeviceDisplayState.DisplaySettingsChanged += OnDeviceDisplaySettingsChanged;
      Logger.LogDebug("MainLayout - Subscribed to audio state events");

      // Load initial state
      await RefreshQueueCountAsync();

      // Update time immediately
      _currentTime = DateTime.Now.ToString("HH:mm");
      Logger.LogDebug("MainLayout - Initial time set to {Time}", _currentTime);

      // Start the clock timer using System.Timers.Timer (works reliably in Blazor Server)
      _timer = new System.Timers.Timer(1000);
      _timer.Elapsed += OnTimerElapsed;
      _timer.AutoReset = true;
      _timer.Start();
      Logger.LogDebug("MainLayout - Timer started, initialization complete");
    }
    catch (Exception ex)
    {
      Logger.LogError(ex, "CRITICAL: Exception in MainLayout.OnInitializedAsync - this will crash the Blazor circuit!");
      throw;
    }
  }

  private void OnTimerElapsed(object? sender, System.Timers.ElapsedEventArgs e)
  {
    _currentTime = DateTime.Now.ToString("HH:mm");

    try
    {
      // Invoke state update on the UI thread - use fire-and-forget with error handling
      _ = SafeInvokeAsync();
    }
    catch (ObjectDisposedException)
    {
      // Component was disposed, stop the timer
      _timer?.Stop();
    }
  }

  private async Task SafeInvokeAsync()
  {
    try
    {
      await InvokeAsync(async () =>
      {
        StateHasChanged();
        await UpdateSystemStatsAsync();
      });
    }
    catch (ObjectDisposedException)
    {
      _timer?.Stop();
    }
    catch (Exception ex)
    {
      Logger.LogWarning(ex, "Error in timer update");
    }
  }

  private async Task LoadSourcesAsync()
  {
    try
    {
      Logger.LogDebug("Loading audio sources...");
      var sources = await SourcesApi.GetSourcesAsync();

      if (sources != null && sources.Count > 0)
      {
        Logger.LogDebug("Loaded {Count} audio sources: {Sources}",
          sources.Count, string.Join(", ", sources.Select(s => s.Name)));
        _availableSources = sources;

        // Try to get primary source, but don't fail if not available
        try
        {
          var primary = await SourcesApi.GetPrimarySourceAsync();
          if (primary != null)
          {
            // Match by type since the API returns UUID-based IDs that don't match
            // the dropdown items which use sourceType.ToLowerInvariant() as IDs
            var matchingSource = _availableSources.FirstOrDefault(s =>
              s.Type.Equals(primary.Type, StringComparison.OrdinalIgnoreCase));
            if (matchingSource != null)
            {
              _selectedSourceId = matchingSource.Id;
  
            }
            else
            {
              _selectedSourceId = primary.Type.ToLowerInvariant();
            }
            return;
          }
        }
        catch (Exception ex)
        {
          Logger.LogDebug(ex, "No primary source active (expected when no source is playing)");
        }

        // No primary source active - auto-select Radio as the default source
        Logger.LogDebug("No active primary source, auto-selecting Radio as default");
        var radioSource = sources.FirstOrDefault(s => s.Type.Equals("Radio", StringComparison.OrdinalIgnoreCase));
        if (radioSource != null)
        {
          var success = await SourcesApi.SwitchSourceAsync(radioSource.Type);
          if (success)
          {
            _selectedSourceId = radioSource.Id;
            Logger.LogDebug("Auto-selected Radio source: {SourceType}", radioSource.Type);
            return;
          }
          Logger.LogWarning("Failed to auto-select Radio source");
        }

        // Fallback to first source if Radio not available
        if (sources.Count > 0)
        {
          _selectedSourceId = sources[0].Id;
        }
      }
      else
      {
        Logger.LogWarning("No audio sources returned from API");
      }
    }
    catch (Exception ex)
    {
      Logger.LogError(ex, "Failed to load audio sources");
    }
  }

  private async Task LoadOutputDevicesAsync()
  {
    try
    {
      Logger.LogDebug("Loading audio output devices...");
      var outputsTask = DevicesApi.GetOutputDevicesAsync();
      var defaultCastTask = DevicesApi.GetDefaultCastDeviceAsync();
      var displayTask = DevicesApi.GetDeviceDisplaySettingsAsync();
      await Task.WhenAll(outputsTask, defaultCastTask, displayTask);

      var outputs = await outputsTask;
      _defaultCastDevice = await defaultCastTask;
      var displaySettings = await displayTask;

      if (outputs != null && outputs.Count > 0)
      {
        // Filter out hidden devices using display settings
        if (displaySettings != null)
        {
          var hiddenNames = displaySettings
            .Where(d => d.IsHidden)
            .Select(d => d.RawName)
            .ToHashSet(StringComparer.OrdinalIgnoreCase);
          outputs = outputs.Where(o => !hiddenNames.Contains(o.Name)).ToList();

          // Apply friendly names from display settings
          foreach (var output in outputs)
          {
            var display = displaySettings.FirstOrDefault(d =>
              d.RawName.Equals(output.Name, StringComparison.OrdinalIgnoreCase));
            if (display?.FriendlyNameOverride != null)
              output.Name = display.FriendlyNameOverride;
          }
        }

        Logger.LogDebug("Loaded {Count} visible output devices: {Devices}",
          outputs.Count, string.Join(", ", outputs.Select(d => d.Name)));
        _availableOutputs = outputs;
        UpdateCastOutputDisplayName();

        // Try to get current output device
        try
        {
          var current = await DevicesApi.GetCurrentOutputDeviceAsync();
          if (current != null)
          {
            _selectedOutputId = current.Id;
            return;
          }
        }
        catch (Exception ex)
        {
          Logger.LogDebug(ex, "No current output device set");
        }

        // Default to first (usually the default device)
        var defaultDevice = outputs.FirstOrDefault(d => d.IsDefault) ?? outputs[0];
        _selectedOutputId = defaultDevice.Id;
      }
      else
      {
        Logger.LogWarning("No output devices returned from API");
      }
    }
    catch (Exception ex)
    {
      Logger.LogError(ex, "Failed to load output devices");
    }
  }

  private void UpdateCastOutputDisplayName()
  {
    var castOutput = _availableOutputs.FirstOrDefault(o =>
      o.Id.Equals("google-cast", StringComparison.OrdinalIgnoreCase));
    if (castOutput == null) return;

    castOutput.Name = _defaultCastDevice != null
      ? _defaultCastDevice.Name
      : "Google Cast";
  }

  private async Task HandleSourceChangeAsync(string newSourceId)
  {
    if (string.IsNullOrEmpty(newSourceId) || newSourceId == _selectedSourceId) return;

    try
    {
      var source = _availableSources.FirstOrDefault(s => s.Id == newSourceId);
      if (source == null) return;

      var success = await SourcesApi.SwitchSourceAsync(source.Type);
      if (success)
      {
        _selectedSourceId = newSourceId;
        Logger.LogInformation("Switched to source: {SourceType}", source.Type);
      }
    }
    catch (Exception ex)
    {
      Logger.LogError(ex, "Failed to switch audio source");
    }
  }

  private async Task HandleOutputChangeAsync(string newOutputId)
  {
    if (string.IsNullOrEmpty(newOutputId) || newOutputId == _selectedOutputId) return;

    // When selecting Google Cast with a default device, auto-connect
    if (newOutputId == "google-cast" && _defaultCastDevice != null)
    {
      await AutoConnectCastDeviceAsync(newOutputId);
      return;
    }

    try
    {
      var success = await DevicesApi.SetOutputDeviceAsync(newOutputId);
      if (success)
      {
        _selectedOutputId = newOutputId;
        Logger.LogInformation("Switched audio output to: {OutputId}", newOutputId);
      }
    }
    catch (Exception ex)
    {
      Logger.LogError(ex, "Failed to switch audio output");
    }
  }

  private async Task AutoConnectCastDeviceAsync(string outputId)
  {
    _isCastConnecting = true;
    _selectedOutputId = outputId;
    StateHasChanged();

    try
    {
      // Switch to the Cast output first
      var outputSuccess = await DevicesApi.SetOutputDeviceAsync(outputId);
      if (!outputSuccess)
      {
        Logger.LogWarning("Failed to switch to Cast output");
        return;
      }

      // Try to connect to the default Cast device
      Logger.LogInformation("Auto-connecting to default Cast device: {DeviceName}", _defaultCastDevice!.Name);
      var connectSuccess = await DevicesApi.ConnectToCastDeviceAsync(_defaultCastDevice);

      if (connectSuccess)
      {
        Logger.LogInformation("Auto-connected to Cast device: {DeviceName}", _defaultCastDevice.Name);
      }
      else
      {
        // Device not reachable — clear default and open dialog for manual selection
        Logger.LogWarning("Failed to auto-connect to {DeviceName}, clearing default", _defaultCastDevice.Name);
        await DevicesApi.ClearDefaultCastDeviceAsync();
        _defaultCastDevice = null;
        UpdateCastOutputDisplayName();
        StateHasChanged();
        await OpenCastDeviceDialog();
      }
    }
    catch (Exception ex)
    {
      Logger.LogError(ex, "Error auto-connecting to Cast device");
      await DevicesApi.ClearDefaultCastDeviceAsync();
      _defaultCastDevice = null;
      UpdateCastOutputDisplayName();
      StateHasChanged();
      await OpenCastDeviceDialog();
    }
    finally
    {
      _isCastConnecting = false;
      StateHasChanged();
    }
  }

  // Source icon mapping
  private static string GetSourceIcon(string sourceType) => sourceType switch
  {
    "Vinyl" => Icons.Material.Filled.Album,
    "FilePlayer" => Icons.Material.Filled.AudioFile,
    "Radio" or "RTLSDRCore" or "RF320" => Icons.Material.Filled.Radio,
    "Bluetooth" => Icons.Material.Filled.Bluetooth,
    "GenericUSB" => Icons.Material.Filled.Usb,
    _ => Icons.Material.Filled.MusicNote
  };

  // Data attribute for source-specific CSS coloring
  private static string GetSourceDataAttr(string sourceType) => sourceType switch
  {
    "Vinyl" => "vinyl",
    "FilePlayer" => "file",
    "Radio" or "RTLSDRCore" or "RF320" => "radio",
    "Bluetooth" => "bluetooth",
    "GenericUSB" => "usb",
    _ => "file"
  };

  // Source availability check
  private static bool IsSourceAvailable(AudioSourceDto source) =>
    source.State != "Unavailable" && source.State != "Error";

  private bool IsBluetoothSourceSelected()
  {
    if (_selectedSourceId == null) return false;
    var source = _availableSources.FirstOrDefault(s => s.Id == _selectedSourceId);
    return source?.Type == "Bluetooth";
  }

  // Active page detection for nav highlighting
  private bool IsCurrentPage(string path)
  {
    var uri = NavigationManager.ToBaseRelativePath(NavigationManager.Uri);
    if (string.IsNullOrEmpty(uri) && path == "/") return true;
    return $"/{uri}".StartsWith(path, StringComparison.OrdinalIgnoreCase);
  }

  private string NavClass(string path) =>
    IsCurrentPage(path) ? "nav-icon nav-active" : "nav-icon";

  // Combined source toggle: switch source AND navigate for Radio/Bluetooth
  private async Task HandleSourceToggleAsync(AudioSourceDto source)
  {
    if (!IsSourceAvailable(source)) return;
    if (source.Id == _selectedSourceId)
    {
      // Already selected — toggle inline panel or navigate
      if (IsRadioSource(source.Type))
      {
        // Toggle radio control panel in the Home page center area
        var currentPath = NavigationManager.ToBaseRelativePath(NavigationManager.Uri);
        if (!string.IsNullOrEmpty(currentPath))
        {
          // Not on Home page — navigate there first, panel will auto-show
          RadioPanelToggle.IsRadioPanelVisible = true;
          NavigationManager.NavigateTo("/");
        }
        else
        {
          await RadioPanelToggle.ToggleRadioPanelAsync();
        }
        return;
      }
      NavigateToSourcePage(source.Type);
      return;
    }

    // Show radio panel when switching TO Radio, hide when switching away
    if (IsRadioSource(source.Type))
    {
      await HandleSourceChangeAsync(source.Id);
      await RadioPanelToggle.ShowRadioPanelAsync();
    }
    else
    {
      await RadioPanelToggle.HideRadioPanelAsync();
      await HandleSourceChangeAsync(source.Id);
    }
  }

  private static bool IsRadioSource(string sourceType) =>
    sourceType is "Radio" or "RTLSDRCore" or "RF320";

  private void NavigateToSourcePage(string sourceType)
  {
    switch (sourceType)
    {
      case "Radio":
      case "RTLSDRCore":
      case "RF320":
        NavigationManager.NavigateTo("/radio");
        break;
      case "Bluetooth":
        NavigationManager.NavigateTo("/bluetooth");
        break;
      default:
        NavigationManager.NavigateTo("/");
        break;
    }
  }

  private static string GetOutputIcon(AudioDeviceDto device)
  {
    if (device.Name.Contains("Cast", StringComparison.OrdinalIgnoreCase) ||
        device.Name.Contains("Chromecast", StringComparison.OrdinalIgnoreCase))
      return Icons.Material.Filled.Cast;
    if (device.Name.Contains("HTTP", StringComparison.OrdinalIgnoreCase) ||
        device.Name.Contains("Stream", StringComparison.OrdinalIgnoreCase))
      return Icons.Material.Filled.Stream;
    if (device.IsUSBDevice)
      return Icons.Material.Filled.Usb;
    if (device.IsDefault)
      return Icons.Material.Filled.VolumeUp;
    return Icons.Material.Filled.Speaker;
  }

  private async Task OpenCastDeviceDialog()
  {
    var parameters = new DialogParameters
    {
      { "DevicesApi", DevicesApi },
      { "Logger", Logger }
    };

    var options = new DialogOptions
    {
      CloseButton = true,
      MaxWidth = MaxWidth.False,
      FullWidth = true,
      BackgroundClass = "bottom-sheet-backdrop",
      Position = DialogPosition.BottomCenter,
      BackdropClick = true
    };

    var dialog = await DialogService.ShowAsync<CastDeviceDialog>("Select Cast Device", parameters, options);
    var result = await dialog.Result;

    if (result is { Canceled: false, Data: CastDeviceDto selectedDevice })
    {
      Logger.LogInformation("Selected Cast device: {DeviceName}", selectedDevice.Name);

      // Save as default and update dropdown display
      await DevicesApi.SetDefaultCastDeviceAsync(selectedDevice);
      _defaultCastDevice = selectedDevice;
      UpdateCastOutputDisplayName();
      StateHasChanged();
    }
  }

  private async Task UpdateSystemStatsAsync()
  {
    try
    {
      var stats = await SystemApi.GetSystemStatsAsync();
      if (stats != null)
      {
        _cpuUsage = stats.CpuUsagePercent.ToString("F1");
        _ramUsage = stats.RamUsageMb.ToString("F0");
        _threadCount = stats.ThreadCount.ToString();
      }
    }
    catch (Exception)
    {
      // Silently fail to avoid disrupting UI updates
    }
  }

  private async Task OnPlaybackStateChanged()
  {
    await InvokeAsync(StateHasChanged);
  }

  private async Task OnNowPlayingChanged()
  {
    await InvokeAsync(StateHasChanged);
  }

  private async Task OnQueueChanged()
  {
    await RefreshQueueCountAsync();
    await InvokeAsync(StateHasChanged);
  }

  private async Task OnSourceChanged()
  {
    // Refresh selected source and hide radio panel if source changed away from Radio
    await LoadSourcesAsync();
    var activeSource = _availableSources.FirstOrDefault(s => s.Id == _selectedSourceId);
    if (activeSource != null && !IsRadioSource(activeSource.Type))
    {
      await RadioPanelToggle.HideRadioPanelAsync();
    }
    await InvokeAsync(StateHasChanged);
  }

  private async Task OnDeviceDisplaySettingsChanged()
  {
    await LoadOutputDevicesAsync();
    await InvokeAsync(StateHasChanged);
  }

  private async Task RefreshQueueCountAsync()
  {
    try
    {
      var queue = await QueueApi.GetQueueAsync();
      _queueCount = queue?.Count ?? 0;
      Logger.LogDebug("MainLayout - Queue count updated: {Count}", _queueCount);
    }
    catch (Exception ex)
    {
      Logger.LogError(ex, "Error refreshing queue count in MainLayout");
    }
  }

  public void Dispose()
  {
    // Unsubscribe from events to prevent memory leaks
    HubService.PlaybackStateChanged -= OnPlaybackStateChanged;
    HubService.NowPlayingChanged -= OnNowPlayingChanged;
    HubService.QueueChanged -= OnQueueChanged;
    HubService.SourceChanged -= OnSourceChanged;
    DeviceDisplayState.DisplaySettingsChanged -= OnDeviceDisplaySettingsChanged;

    _timer?.Stop();
    _timer?.Dispose();
  }

  public ValueTask DisposeAsync()
  {
    Dispose();
    return ValueTask.CompletedTask;
  }
}
