@inherits LayoutComponentBase
@using Radio.Web.Components.Dialogs
@using Radio.Web.Models
@inject SystemApiService SystemApi
@inject SourcesApiService SourcesApi
@inject DevicesApiService DevicesApi
@inject AudioApiService AudioApi
@inject AudioStateHubService HubService
@inject QueueApiService QueueApi
@inject NavigationManager NavigationManager
@inject ILogger<MainLayout> Logger
@inject IDialogService DialogService
@implements IDisposable
@implements IAsyncDisposable

<MudThemeProvider Theme="@_customTheme" IsDarkMode="true" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<div class="layout-container" style="width: 1920px; height: 576px; overflow: hidden;">
  <!-- Top Navigation Bar - 60px height -->
  <MudAppBar Fixed="true" Elevation="1" Style="height: 60px;">
    <!-- LEFT: Date/Time Display (fixed width to prevent layout shift) -->
    <div style="font-size: 22px; width: 100px; font-family: 'JetBrains Mono', 'Consolas', 'Courier New', monospace; font-weight: 500; color: #F2F2F2; letter-spacing: 1px;">
      @_currentTime
    </div>

    <!-- Audio Source Selector - Material 3 Style -->
    <MudSpacer />
    <MudSelect T="string" Value="@_selectedSourceId" ValueChanged="@HandleSourceChangeAsync"
               Label="Audio Source" Variant="Variant.Text" Dense="true"
               AnchorOrigin="Origin.BottomCenter" TransformOrigin="Origin.TopCenter"
               Style="min-width: 180px; margin-right: 16px; border-bottom: 1px solid rgba(255,255,255,0.3);"
               Underline="true">
      @if (_availableSources.Count == 0)
      {
        <MudSelectItem Value="@string.Empty" Disabled="true">No sources available</MudSelectItem>
      }
      @foreach (var source in _availableSources)
      {
        <MudSelectItem Value="@source.Id">@source.Name</MudSelectItem>
      }
    </MudSelect>

    <!-- Audio Output Selector - Material 3 Style -->
    <div style="display: flex; align-items: center; gap: 4px;">
      <MudSelect T="string" Value="@_selectedOutputId" ValueChanged="@HandleOutputChangeAsync"
                 Label="Audio Output" Variant="Variant.Text" Dense="true"
                 AnchorOrigin="Origin.BottomCenter" TransformOrigin="Origin.TopCenter"
                 Style="min-width: 200px; border-bottom: 1px solid rgba(255,255,255,0.3);"
                 Underline="true">
        @if (_availableOutputs.Count == 0)
        {
          <MudSelectItem Value="@string.Empty" Disabled="true">No outputs available</MudSelectItem>
        }
        @foreach (var output in _availableOutputs)
        {
          <MudSelectItem Value="@output.Id">
            <div style="display: flex; align-items: center; gap: 8px;">
              <MudIcon Icon="@GetOutputIcon(output)" Size="Size.Small" />
              @output.Name
            </div>
          </MudSelectItem>
        }
      </MudSelect>
      @if (_selectedOutputId == "google-cast")
      {
        <MudTooltip Text="Select Cast Device">
          <MudIconButton Icon="@Icons.Material.Filled.Settings" Color="Color.Inherit"
                         Size="Size.Small" OnClick="@OpenCastDeviceDialog" />
        </MudTooltip>
      }
    </div>
    <div style="width: 24px;"></div>

    <!-- CENTER: System Stats with Icons -->
    <div style="display: flex; align-items: center; gap: 20px; font-family: 'Inter', sans-serif; font-size: 14px; color: #BFBFC2;">
      <MudTooltip Text="CPU Usage">
        <div style="display: flex; align-items: center; gap: 4px;">
          <MudIcon Icon="@Icons.Material.Filled.Memory" Size="Size.Small" />
          <span>@_cpuUsage%</span>
        </div>
      </MudTooltip>
      <MudTooltip Text="RAM Usage">
        <div style="display: flex; align-items: center; gap: 4px;">
          <MudIcon Icon="@Icons.Material.Filled.Storage" Size="Size.Small" />
          <span>@_ramUsage MB</span>
        </div>
      </MudTooltip>
      <MudTooltip Text="Thread Count">
        <div style="display: flex; align-items: center; gap: 4px;">
          <MudIcon Icon="@Icons.Material.Filled.AccountTree" Size="Size.Small" />
          <span>@_threadCount</span>
        </div>
      </MudTooltip>
    </div>
    <MudSpacer />
    
    <!-- NOW PLAYING WIDGET - Compact display between stats and nav -->
    <div style="display: flex; align-items: center; gap: 12px; padding: 0 16px; border-left: 1px solid rgba(255,255,255,0.1); border-right: 1px solid rgba(255,255,255,0.1); max-width: 500px; cursor: pointer;" @onclick="NavigateToHome">
      <!-- Album Art / Music Icon -->
      <div style="width: 40px; height: 40px; flex-shrink: 0;">
        @if (string.IsNullOrEmpty(_nowPlayingAlbumArt) || _nowPlayingAlbumArt == "/images/default-album-art.png")
        {
          <MudIcon Icon="@Icons.Material.Filled.MusicNote" Style="font-size: 40px; color: var(--mud-palette-text-secondary);" />
        }
        else
        {
          <img src="@_nowPlayingAlbumArt" alt="Album Art" style="width: 40px; height: 40px; object-fit: cover; border-radius: 4px;" />
        }
      </div>
      
      <!-- Track Info -->
      <div style="flex: 1; min-width: 0; overflow: hidden;">
        <div style="font-size: 14px; font-weight: 600; color: var(--mud-palette-text-primary); white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">
          @(_nowPlayingTitle ?? "No Track")
        </div>
        <div style="font-size: 12px; color: var(--mud-palette-text-secondary); white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">
          @(_nowPlayingArtist ?? "--")
        </div>
      </div>
      
      <!-- Transport Controls -->
      <div style="display: flex; align-items: center; gap: 4px;" @onclick:stopPropagation="true">
        <MudIconButton Icon="@Icons.Material.Filled.SkipPrevious" 
                       Color="Color.Default" 
                       Size="Size.Small"
                       Style="width: 48px; height: 48px;"
                       OnClick="@HandlePreviousAsync"
                       title="Previous" />
        
        <MudIconButton Icon="@(_isPlaying ? Icons.Material.Filled.Pause : Icons.Material.Filled.PlayArrow)" 
                       Color="Color.Primary" 
                       Size="Size.Medium"
                       Style="width: 48px; height: 48px;"
                       OnClick="@HandlePlayPauseAsync"
                       title="@(_isPlaying ? "Pause" : "Play")" />
        
        <MudIconButton Icon="@Icons.Material.Filled.SkipNext" 
                       Color="Color.Default" 
                       Size="Size.Small"
                       Style="width: 48px; height: 48px;"
                       OnClick="@HandleNextAsync"
                       title="Next" />
      </div>
      
      <!-- Volume Control (compact) -->
      <div style="width: 100px;" @onclick:stopPropagation="true">
        <div style="display: flex; align-items: center; gap: 4px;">
          <MudIconButton Icon="@(_isMuted ? Icons.Material.Filled.VolumeOff : Icons.Material.Filled.VolumeUp)" 
                         Color="Color.Default" 
                         Size="Size.Small"
                         OnClick="@HandleMuteAsync"
                         title="@(_isMuted ? "Unmute" : "Mute")" />
          <MudSlider T="double" 
                     Value="_volume" 
                     ValueChanged="@OnVolumeChanged" 
                     Min="0" 
                     Max="1" 
                     Step="0.01" 
                     Size="Size.Small"
                     Color="Color.Primary"
                     Style="width: 60px;" />
        </div>
      </div>
    </div>
    <MudSpacer />
    
    <!-- RIGHT: Navigation Icons (48px touch targets) -->
    <MudIconButton Icon="@Icons.Material.Filled.Home" Color="Color.Inherit" Href="/" Size="Size.Large" title="Home / Now Playing" />
    
    <!-- Queue is always visible with badge showing count -->
    <MudBadge Content="@_queueCount" Overlap="true" Color="@(_queueCount > 0 ? Color.Primary : Color.Default)" Visible="@(_queueCount > 0)">
      <MudIconButton Icon="@Icons.Material.Filled.QueueMusic" Color="Color.Inherit" Href="/queue" Size="Size.Large" title="@(_queueCount > 0 ? $"Queue ({_queueCount} items)" : "Queue (empty)")" />
    </MudBadge>
    
    @if (_showSpotifyNav)
    {
      <MudIconButton Icon="@Icons.Material.Filled.Search" Color="Color.Inherit" Href="/spotify" Size="Size.Large" title="Spotify Search" />
    }
    @if (_showRadioNav)
    {
      <MudIconButton Icon="@Icons.Material.Filled.Radio" Color="Color.Inherit" Href="/radio" Size="Size.Large" title="Radio Controls" />
    }
    @if (_showFilesNav)
    {
      <MudIconButton Icon="@Icons.Material.Filled.Folder" Color="Color.Inherit" Href="/files" Size="Size.Large" title="File Browser" />
    }
    <MudIconButton Icon="@Icons.Material.Filled.ShowChart" Color="Color.Inherit" Href="/visualizer" Size="Size.Large" title="Visualizer" />
    <MudIconButton Icon="@Icons.Material.Filled.Dashboard" Color="Color.Inherit" Href="/metrics" Size="Size.Large" title="Metrics" />
    <MudIconButton Icon="@Icons.Material.Filled.History" Color="Color.Inherit" Href="/history" Size="Size.Large" title="Play History" />
    <MudIconButton Icon="@Icons.Material.Filled.Devices" Color="Color.Inherit" Href="/devices" Size="Size.Large" title="Device Management" />
    <MudIconButton Icon="@Icons.Material.Filled.Settings" Color="Color.Inherit" Href="/system" Size="Size.Large" title="System Config" />
  </MudAppBar>
  
  <!-- Main Content Area - 516px height (576 - 60) -->
  <div class="content-area" style="height: 516px; margin-top: 60px; overflow-y: auto; position: relative;">
    <div class="page-transition">
      @Body
    </div>
  </div>
</div>

@code {
  private string _currentTime = DateTime.Now.ToString("HH:mm:ss");
  private string _cpuUsage = "0";
  private string _ramUsage = "0";
  private string _threadCount = "0";
  private System.Timers.Timer? _timer;
  private List<AudioSourceDto> _availableSources = new();
  private List<AudioDeviceDto> _availableOutputs = new();
  private string? _selectedSourceId = null;
  private string? _selectedOutputId = null;

  // Conditional navigation visibility
  private bool _showSpotifyNav = false;
  private bool _showRadioNav = false;
  private bool _showFilesNav = false;

  // Now Playing state
  private bool _isPlaying = false;
  private bool _isMuted = false;
  private double _volume = 0.75;
  private string? _nowPlayingTitle = null;
  private string? _nowPlayingArtist = null;
  private string? _nowPlayingAlbumArt = null;
  private int _queueCount = 0;

  private readonly MudTheme _customTheme = new()
  {
    PaletteLight = new PaletteLight()
    {
      Primary = "#5CD4E8",
      Secondary = "#404045",
      Background = "#2D2D30",
      Surface = "#404045",
      AppbarBackground = "#1E1E20",
    },
    PaletteDark = new PaletteDark()
    {
      Primary = "#5CD4E8",
      Secondary = "#404045",
      Background = "#2D2D30",
      Surface = "#404045",
      AppbarBackground = "#1E1E20",
      TextPrimary = "#F2F2F2",
      TextSecondary = "#BFBFC2",
      Tertiary = "#8C8C8F",
    }
  };

  protected override async Task OnInitializedAsync()
  {
    try
    {
      Logger.LogInformation("MainLayout.OnInitializedAsync - Starting initialization");

      // Load available sources and outputs
      await LoadSourcesAsync();
      await LoadOutputDevicesAsync();

      // Subscribe to audio state updates
      HubService.PlaybackStateChanged += OnPlaybackStateChanged;
      HubService.NowPlayingChanged += OnNowPlayingChanged;
      HubService.QueueChanged += OnQueueChanged;
      Logger.LogDebug("MainLayout - Subscribed to audio state events");

      // Load initial audio state
      await RefreshAudioStateAsync();
      await RefreshQueueCountAsync();

      // Update time immediately
      _currentTime = DateTime.Now.ToString("HH:mm:ss");
      Logger.LogInformation("MainLayout - Initial time set to {Time}", _currentTime);

      // Start the clock timer using System.Timers.Timer (works reliably in Blazor Server)
      _timer = new System.Timers.Timer(1000);
      _timer.Elapsed += OnTimerElapsed;
      _timer.AutoReset = true;
      _timer.Start();
      Logger.LogInformation("MainLayout - Timer started, initialization complete");
    }
    catch (Exception ex)
    {
      Logger.LogError(ex, "CRITICAL: Exception in MainLayout.OnInitializedAsync - this will crash the Blazor circuit!");
      throw;
    }
  }

  private void OnTimerElapsed(object? sender, System.Timers.ElapsedEventArgs e)
  {
    _currentTime = DateTime.Now.ToString("HH:mm:ss");

    try
    {
      // Invoke state update on the UI thread - use fire-and-forget with error handling
      _ = SafeInvokeAsync();
    }
    catch (ObjectDisposedException)
    {
      // Component was disposed, stop the timer
      _timer?.Stop();
    }
  }

  private async Task SafeInvokeAsync()
  {
    try
    {
      await InvokeAsync(async () =>
      {
        StateHasChanged();
        await UpdateSystemStatsAsync();
      });
    }
    catch (ObjectDisposedException)
    {
      _timer?.Stop();
    }
    catch (Exception ex)
    {
      Logger.LogWarning(ex, "Error in timer update");
    }
  }

  private async Task LoadSourcesAsync()
  {
    try
    {
      Logger.LogInformation("Loading audio sources...");
      var sources = await SourcesApi.GetSourcesAsync();

      if (sources != null && sources.Count > 0)
      {
        Logger.LogInformation("Loaded {Count} audio sources: {Sources}",
          sources.Count, string.Join(", ", sources.Select(s => s.Name)));
        _availableSources = sources;

        // Try to get primary source, but don't fail if not available
        try
        {
          var primary = await SourcesApi.GetPrimarySourceAsync();
          if (primary != null)
          {
            _selectedSourceId = primary.Id;
            UpdateNavigationVisibility(primary);
            return;
          }
        }
        catch (Exception ex)
        {
          Logger.LogDebug(ex, "No primary source active (expected when no source is playing)");
        }

        // No primary source active - auto-select Radio as the default source
        Logger.LogInformation("No active primary source, auto-selecting Radio as default");
        var radioSource = sources.FirstOrDefault(s => s.Type.Equals("Radio", StringComparison.OrdinalIgnoreCase));
        if (radioSource != null)
        {
          var success = await SourcesApi.SwitchSourceAsync(radioSource.Type);
          if (success)
          {
            _selectedSourceId = radioSource.Id;
            UpdateNavigationVisibility(radioSource);
            Logger.LogInformation("Auto-selected Radio source: {SourceType}", radioSource.Type);
            return;
          }
          Logger.LogWarning("Failed to auto-select Radio source");
        }

        // Fallback to first source if Radio not available
        if (sources.Count > 0)
        {
          _selectedSourceId = sources[0].Id;
          UpdateNavigationVisibility(sources[0]);
        }
      }
      else
      {
        Logger.LogWarning("No audio sources returned from API");
      }
    }
    catch (Exception ex)
    {
      Logger.LogError(ex, "Failed to load audio sources");
    }
  }

  private async Task LoadOutputDevicesAsync()
  {
    try
    {
      Logger.LogInformation("Loading audio output devices...");
      var outputs = await DevicesApi.GetOutputDevicesAsync();

      if (outputs != null && outputs.Count > 0)
      {
        Logger.LogInformation("Loaded {Count} output devices: {Devices}",
          outputs.Count, string.Join(", ", outputs.Select(d => d.Name)));
        _availableOutputs = outputs;

        // Try to get current output device
        try
        {
          var current = await DevicesApi.GetCurrentOutputDeviceAsync();
          if (current != null)
          {
            _selectedOutputId = current.Id;
            return;
          }
        }
        catch (Exception ex)
        {
          Logger.LogDebug(ex, "No current output device set");
        }

        // Default to first (usually the default device)
        var defaultDevice = outputs.FirstOrDefault(d => d.IsDefault) ?? outputs[0];
        _selectedOutputId = defaultDevice.Id;
      }
      else
      {
        Logger.LogWarning("No output devices returned from API");
      }
    }
    catch (Exception ex)
    {
      Logger.LogError(ex, "Failed to load output devices");
    }
  }

  private async Task HandleSourceChangeAsync(string newSourceId)
  {
    if (string.IsNullOrEmpty(newSourceId) || newSourceId == _selectedSourceId) return;

    try
    {
      var source = _availableSources.FirstOrDefault(s => s.Id == newSourceId);
      if (source == null) return;

      var success = await SourcesApi.SwitchSourceAsync(source.Type);
      if (success)
      {
        _selectedSourceId = newSourceId;
        UpdateNavigationVisibility(source);
        Logger.LogInformation("Switched to source: {SourceType}", source.Type);
      }
    }
    catch (Exception ex)
    {
      Logger.LogError(ex, "Failed to switch audio source");
    }
  }

  private async Task HandleOutputChangeAsync(string newOutputId)
  {
    if (string.IsNullOrEmpty(newOutputId) || newOutputId == _selectedOutputId) return;

    try
    {
      var success = await DevicesApi.SetOutputDeviceAsync(newOutputId);
      if (success)
      {
        _selectedOutputId = newOutputId;
        Logger.LogInformation("Switched audio output to: {OutputId}", newOutputId);
      }
    }
    catch (Exception ex)
    {
      Logger.LogError(ex, "Failed to switch audio output");
    }
  }

  private void UpdateNavigationVisibility(AudioSourceDto source)
  {
    // Queue is now always visible, no need to set _showQueueNav
    _showSpotifyNav = source.Type == "Spotify";
    _showRadioNav = source.Type == "Radio" || source.Type == "RTLSDRCore" || source.Type == "RF320";
    _showFilesNav = source.Type == "FilePlayer";
  }

  private static string GetOutputIcon(AudioDeviceDto device)
  {
    if (device.Name.Contains("Cast", StringComparison.OrdinalIgnoreCase) ||
        device.Name.Contains("Chromecast", StringComparison.OrdinalIgnoreCase))
      return Icons.Material.Filled.Cast;
    if (device.Name.Contains("HTTP", StringComparison.OrdinalIgnoreCase) ||
        device.Name.Contains("Stream", StringComparison.OrdinalIgnoreCase))
      return Icons.Material.Filled.Stream;
    if (device.IsUSBDevice)
      return Icons.Material.Filled.Usb;
    if (device.IsDefault)
      return Icons.Material.Filled.VolumeUp;
    return Icons.Material.Filled.Speaker;
  }

  private async Task OpenCastDeviceDialog()
  {
    var parameters = new DialogParameters
    {
      { "DevicesApi", DevicesApi },
      { "Logger", Logger }
    };

    var options = new DialogOptions
    {
      CloseButton = true,
      MaxWidth = MaxWidth.Small,
      FullWidth = true,
      BackdropClick = true
    };

    var dialog = await DialogService.ShowAsync<CastDeviceDialog>("Select Cast Device", parameters, options);
    var result = await dialog.Result;

    if (result is { Canceled: false, Data: CastDeviceDto selectedDevice })
    {
      Logger.LogInformation("Selected Cast device: {DeviceName}", selectedDevice.Name);
    }
  }

  private async Task UpdateSystemStatsAsync()
  {
    try
    {
      var stats = await SystemApi.GetSystemStatsAsync();
      if (stats != null)
      {
        _cpuUsage = stats.CpuUsagePercent.ToString("F1");
        _ramUsage = stats.RamUsageMb.ToString("F0");
        _threadCount = stats.ThreadCount.ToString();
      }
    }
    catch (Exception)
    {
      // Silently fail to avoid disrupting UI updates
    }
  }

  private async Task OnPlaybackStateChanged()
  {
    await RefreshAudioStateAsync();
    await InvokeAsync(StateHasChanged);
  }

  private async Task OnNowPlayingChanged()
  {
    await RefreshAudioStateAsync();
    await InvokeAsync(StateHasChanged);
  }

  private async Task OnQueueChanged()
  {
    await RefreshQueueCountAsync();
    await InvokeAsync(StateHasChanged);
  }

  private async Task RefreshAudioStateAsync()
  {
    try
    {
      var state = await AudioApi.GetPlaybackStateAsync();
      if (state != null)
      {
        _isPlaying = state.IsPlaying;
        _isMuted = state.IsMuted;
        _volume = state.Volume;
      }

      var nowPlaying = await AudioApi.GetNowPlayingAsync();
      if (nowPlaying != null)
      {
        _nowPlayingTitle = nowPlaying.Title;
        _nowPlayingArtist = nowPlaying.Artist;
        _nowPlayingAlbumArt = nowPlaying.AlbumArtUrl;
      }
    }
    catch (Exception ex)
    {
      Logger.LogError(ex, "Error refreshing audio state in MainLayout");
    }
  }

  private async Task RefreshQueueCountAsync()
  {
    try
    {
      var queue = await QueueApi.GetQueueAsync();
      _queueCount = queue?.Count ?? 0;
      Logger.LogDebug("MainLayout - Queue count updated: {Count}", _queueCount);
    }
    catch (Exception ex)
    {
      Logger.LogError(ex, "Error refreshing queue count in MainLayout");
    }
  }

  private async Task HandlePlayPauseAsync()
  {
    try
    {
      if (_isPlaying)
      {
        await AudioApi.UpdatePlaybackStateAsync(new UpdatePlaybackRequest("pause", null, null, null));
      }
      else
      {
        await AudioApi.StartAsync();
      }
      await RefreshAudioStateAsync();
    }
    catch (Exception ex)
    {
      Logger.LogError(ex, "Error in HandlePlayPauseAsync");
    }
  }

  private async Task HandleNextAsync()
  {
    try
    {
      await AudioApi.NextAsync();
      await RefreshAudioStateAsync();
    }
    catch (Exception ex)
    {
      Logger.LogError(ex, "Error in HandleNextAsync");
    }
  }

  private async Task HandlePreviousAsync()
  {
    try
    {
      await AudioApi.PreviousAsync();
      await RefreshAudioStateAsync();
    }
    catch (Exception ex)
    {
      Logger.LogError(ex, "Error in HandlePreviousAsync");
    }
  }

  private async Task HandleMuteAsync()
  {
    try
    {
      await AudioApi.ToggleMuteAsync(!_isMuted);
      await RefreshAudioStateAsync();
    }
    catch (Exception ex)
    {
      Logger.LogError(ex, "Error in HandleMuteAsync");
    }
  }

  private async Task OnVolumeChanged(double newVolume)
  {
    try
    {
      _volume = newVolume;
      await AudioApi.SetVolumeAsync((float)newVolume);
    }
    catch (Exception ex)
    {
      Logger.LogError(ex, "Error in OnVolumeChanged");
    }
  }

  private void NavigateToHome()
  {
    NavigationManager.NavigateTo("/");
  }

  public void Dispose()
  {
    _timer?.Stop();
    _timer?.Dispose();
  }

  public async ValueTask DisposeAsync()
  {
    // Unsubscribe from events
    HubService.PlaybackStateChanged -= OnPlaybackStateChanged;
    HubService.NowPlayingChanged -= OnNowPlayingChanged;
    HubService.QueueChanged -= OnQueueChanged;
    
    Dispose();
    await Task.CompletedTask;
  }
}
