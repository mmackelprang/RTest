@inherits LayoutComponentBase
@using Radio.Web.Models
@using Microsoft.Extensions.Options
@inject SystemApiService SystemApi
@inject SourcesApiService SourcesApi
@inject DevicesApiService DevicesApi
@inject AudioApiService AudioApi
@inject AudioStateHubService HubService
@inject QueueApiService QueueApi
@inject NavigationManager NavigationManager
@inject ILogger<MainLayout> Logger
@inject IJSRuntime JSRuntime
@inject Radio.Web.Services.DeviceDisplayStateService DeviceDisplayState
@inject Radio.Web.Services.RadioPanelToggleService RadioPanelToggle
@inject IConfiguration Configuration
@inject IOptionsMonitor<DevicesOptions> DevicesOptionsMonitor
@implements IDisposable
@implements IAsyncDisposable

<RadzenComponents />

<div class="layout-container" style="width: 1920px; height: 720px; overflow: hidden;">
  @* Top Bar — two-row Command Surface (PR 2):
       row 1 .topbar-primary  → time / IN / arrow / OUT / nav pills
       row 2 .topbar-sources  → SourceBubble strip *@
  <div class="topbar">

    <!-- Row 1: primary command row -->
    <div class="topbar-primary">

      <!-- Time cluster -->
      <div class="cluster">
        <span class="cluster-label">Time</span>
        <span class="cluster-value"><span class="font-led">@_currentTime</span></span>
      </div>

      <div class="topbar-separator"></div>

      <!-- IN cluster: active source name + swatch.
           Label routed through DisplayNames.Source so a missing/empty Name on the
           DTO falls through to a humanized Type instead of leaking a GUID-shaped Id. -->
      <div class="cluster">
        <span class="cluster-label">In</span>
        <span class="cluster-value" title="@(ActiveSource?.Name ?? ActiveSource?.Id ?? "")">
          <span class="cluster-swatch" style="@($"--bubble-accent: var({GetActiveSourceAccentVar()});")"></span>
          @(ActiveSource is null ? "—" : DisplayNames.Source(ActiveSource))
        </span>
      </div>

      <span class="topbar-arrow" aria-hidden="true">→</span>

      <!-- OUT cluster: active output name + swatch.
           Label routed through DisplayNames.Device with the configured alias map so
           "CABLE Input (VB-Audio Virtual Cable)" surfaces as "VB-Audio Cable In", etc.
           Tooltip preserves the raw name for debugging / a11y. -->
      <div class="cluster">
        <span class="cluster-label">Out</span>
        <span class="cluster-value" title="@(ActiveOutput?.Name ?? "")">
          <span class="cluster-swatch" style="@($"--bubble-accent: var({GetActiveOutputAccentVar()});")"></span>
          @(ActiveOutput is null ? "—" : DisplayNames.Device(ActiveOutput, DeviceAliases))
          @if (ActiveOutput?.Id.Equals("google-cast", StringComparison.OrdinalIgnoreCase) == true && _isCastConnecting)
          {
            <span class="cast-connecting" style="display:inline-block; width:8px; height:8px; border-radius:50%; background: var(--accent-primary);"></span>
          }
        </span>
      </div>

      @if (_availableOutputs.Any(o => o.Id.Equals("google-cast", StringComparison.OrdinalIgnoreCase)))
      {
        <div style="position: relative;">
          <button type="button" class="nav-pill"
                  @onclick="@(() => HandleOutputChangeAsync("google-cast"))"
                  aria-label="Cast device picker"
                  title="Cast">
            <RadzenIcon Icon="cast" />
            <span class="nav-pill-label">Cast</span>
          </button>
          <CastDeviceDropdown IsOpen="_showCastDropdown"
                              IsOpenChanged="@((bool v) => { _showCastDropdown = v; StateHasChanged(); })"
                              OnDeviceSelected="OnCastDeviceSelected"
                              OnDisconnect="OnCastDeviceDisconnected"
                              DevicesApi="DevicesApi"
                              ConnectedDevice="_defaultCastDevice"
                              Logger="Logger" />
        </div>
      }

      <!-- Output picker entry (for non-Cast switches) -->
      <button type="button" class="nav-pill" @onclick="ToggleOutputPicker"
              aria-label="Output device picker"
              title="Select audio output">
        <RadzenIcon Icon="speaker" />
        <span class="nav-pill-label">Out</span>
      </button>

      <!-- Nav pills (right-aligned) -->
      <div class="topbar-nav">
        <a href="/" class="nav-pill @(IsCurrentPage("/") ? "nav-active" : "")" title="Home" aria-label="Home">
          <RadzenIcon Icon="home" />
          <span class="nav-pill-label">Home</span>
        </a>
        <button type="button" class="nav-pill @(IsCurrentPage("/") ? "nav-active" : "")"
                @onclick="HandleQueueNavAsync"
                title="Queue"
                aria-label="@($"Queue, {_queueCount} item{(_queueCount == 1 ? "" : "s")}")">
          <RadzenIcon Icon="queue_music" />
          <span class="nav-pill-label">Queue</span>
          @if (_queueCount > 0)
          {
            <span class="nav-badge" aria-hidden="true">@_queueCount</span>
          }
        </button>
        <a href="/metrics" class="nav-pill @(IsCurrentPage("/metrics") ? "nav-active" : "")" title="Metrics" aria-label="Metrics">
          <RadzenIcon Icon="dashboard" />
          <span class="nav-pill-label">Metrics</span>
        </a>
        <a href="/devices" class="nav-pill @(IsCurrentPage("/devices") ? "nav-active" : "")" title="Devices" aria-label="Devices">
          <RadzenIcon Icon="devices" />
          <span class="nav-pill-label">Devices</span>
        </a>
        <a href="/history" class="nav-pill @(IsCurrentPage("/history") ? "nav-active" : "")" title="History" aria-label="History">
          <RadzenIcon Icon="history" />
          <span class="nav-pill-label">History</span>
        </a>
        <a href="/system" class="nav-pill @(IsCurrentPage("/system") ? "nav-active" : "")" title="Settings" aria-label="Settings">
          <RadzenIcon Icon="settings" />
          <span class="nav-pill-label">Settings</span>
        </a>
        <a href="/phone" class="nav-pill @(IsCurrentPage("/phone") ? "nav-active" : "")" title="Phone" aria-label="Phone">
          <RadzenIcon Icon="phone" />
          <span class="nav-pill-label">Phone</span>
        </a>
        @if (IsDebugBuild)
        {
          @* Debug-only: distortion marker. PR 6 removes this entirely. *@
          <button type="button"
                  class="nav-pill debug-distortion-btn @_distortionMarkerColor"
                  @onclick="HandleDistortionMarkerAsync"
                  title="Mark audio distortion"
                  aria-label="Mark audio distortion">
            <RadzenIcon Icon="bug_report" />
            <span class="nav-pill-label">Mark</span>
          </button>
        }
        <button type="button" class="nav-pill" @onclick="HandleSleepButtonAsync"
                title="Sleep"
                aria-label="Enter sleep mode">
          <RadzenIcon Icon="power_settings_new" />
          <span class="nav-pill-label">Sleep</span>
        </button>
      </div>
    </div>

    <!-- Row 2: SourceBubble strip -->
    <div class="topbar-sources" role="tablist" aria-label="Audio source selection">
      @foreach (var source in _availableSources)
      {
        var isActive = source.Id == _selectedSourceId;
        var dataAttr = GetSourceDataAttr(source.Type);
        var accent = GetAccentVarForSource(source.Type);
        <SourceBubble Icon="@GetSourceIcon(source.Type)"
                      Label="@DisplayNames.Source(source)"
                      RawName="@(source.Name ?? source.Id)"
                      Sub="@GetSourceSubLabel(source)"
                      Accent="@accent"
                      IsActive="isActive"
                      IsDisabled="!IsSourceAvailable(source)"
                      HasDetail="@HasSourceDetail(source.Type)"
                      DataSourceAttr="@dataAttr"
                      OnSwitch="@(EventCallback.Factory.Create(this, () => HandleSourceToggleAsync(source)))"
                      OnOpenDetail="@(EventCallback.Factory.Create(this, () => HandleSourceDetailAsync(source)))" />
      }
    </div>
  </div>

  @* Main Content Area (height = viewport - topbar = 720 - var(--topbar-height)).
     The .has-dock modifier engages on every route except Home so .page-transition
     reserves the bottom 64px for <NowPlayingDock> and routed content never slides
     under it (handoff §P1·1). *@
  <div class="content-area @(IsDockVisible ? "has-dock" : "")">
    <div class="page-transition">
      @Body
    </div>
    @if (IsDockVisible)
    {
      <NowPlayingDock />
    }
  </div>
</div>

@code {
  /// <summary>
  /// True for Debug builds — gates the temporary distortion-marker pill in the
  /// topbar. PR 6 removes the marker entirely; until then it should not
  /// appear in Release builds. Wrapped as a static readonly so the @if guard
  /// in markup doesn't trip the WAE "unreachable code" rule in Release.
  /// </summary>
  private static readonly bool IsDebugBuild =
#if DEBUG
    true;
#else
    false;
#endif

  private string _currentTime = DateTime.Now.ToString("HH:mm");
  private string _cpuUsage = "0";
  private string _ramUsage = "0";
  private string _threadCount = "0";
  private System.Timers.Timer? _timer;
  // Cached on every LocationChanged so the render condition is a cheap field
  // read instead of re-parsing the URI inside the template (handoff §P1·1).
  private bool _isOnHome = true;
  private List<AudioSourceDto> _availableSources = new();
  private List<AudioDeviceDto> _availableOutputs = new();
  private string? _selectedSourceId = null;
  private string? _selectedOutputId = null;
  private CastDeviceDto? _defaultCastDevice;
  private bool _isCastConnecting;
  private bool _showCastDropdown;

  private int _queueCount = 0;
  private string _distortionMarkerColor = "";
  private DotNetObjectReference<MainLayout>? _selfReference;

  private AudioSourceDto? ActiveSource =>
    _availableSources.FirstOrDefault(s => s.Id == _selectedSourceId);
  private AudioDeviceDto? ActiveOutput =>
    _availableOutputs.FirstOrDefault(o => o.Id == _selectedOutputId);

  /// <summary>
  /// Live view of the configured raw-name → friendly-name alias map.
  /// Read on every render so <c>appsettings.json</c> hot-reloads via <c>IOptionsMonitor</c>
  /// propagate without a circuit restart.
  /// </summary>
  private IDictionary<string, string> DeviceAliases =>
    DevicesOptionsMonitor.CurrentValue.Aliases;

  protected override async Task OnInitializedAsync()
  {
    try
    {
      Logger.LogDebug("MainLayout.OnInitializedAsync - Starting initialization");

      // Load available sources and outputs concurrently
      await Task.WhenAll(LoadSourcesAsync(), LoadOutputDevicesAsync());

      // Start the SignalR hub connection (subscribes to RadioState/Queue groups)
      await HubService.StartAsync();

      // Subscribe to audio state updates
      HubService.PlaybackStateChanged += OnPlaybackStateChanged;
      HubService.NowPlayingChanged += OnNowPlayingChanged;
      HubService.QueueChanged += OnQueueChanged;
      HubService.SourceChanged += OnSourceChanged;
      HubService.SleepStateChanged += OnSleepStateChanged;
      DeviceDisplayState.DisplaySettingsChanged += OnDeviceDisplaySettingsChanged;

      // Dock visibility is route-dependent (handoff §P1·1: dock only on
      // non-Home routes). Seed from the current URI and update on every nav.
      _isOnHome = IsCurrentlyOnHome();
      NavigationManager.LocationChanged += OnLocationChanged;
      Logger.LogDebug("MainLayout - Subscribed to audio state events");

      // Load initial state
      await RefreshQueueCountAsync();

      // Update time immediately
      _currentTime = DateTime.Now.ToString("HH:mm");
      Logger.LogDebug("MainLayout - Initial time set to {Time}", _currentTime);

      // Start the clock timer using System.Timers.Timer (works reliably in Blazor Server)
      _timer = new System.Timers.Timer(1000);
      _timer.Elapsed += OnTimerElapsed;
      _timer.AutoReset = true;
      _timer.Start();
      Logger.LogDebug("MainLayout - Timer started, initialization complete");
    }
    catch (Exception ex)
    {
      Logger.LogError(ex, "CRITICAL: Exception in MainLayout.OnInitializedAsync - this will crash the Blazor circuit!");
      throw;
    }
  }

  protected override async Task OnAfterRenderAsync(bool firstRender)
  {
    if (firstRender)
    {
      // Set API base URL for idle-dimmer.js (still used by other JS callers)
      var apiBaseUrl = Configuration["ApiBaseUrl"] ?? WebConstants.DefaultApiBaseUrl;
      await JSRuntime.InvokeVoidAsync("radioSetApiBaseUrl", apiBaseUrl);

      // Register .NET reference so JS sleep/wake can call back into Blazor
      _selfReference = DotNetObjectReference.Create(this);
      await JSRuntime.InvokeVoidAsync("radioSleepManager.setBlazorRef", _selfReference);
    }
  }

  /// <summary>
  /// Called from JS (idle-dimmer.js) when user interaction triggers sleep or wake.
  /// Routes through Blazor server-side HttpClient to avoid browser CORS issues.
  /// </summary>
  [JSInvokable]
  public async Task OnJsSleepRequested(bool sleep)
  {
    try
    {
      await SystemApi.SetSleepAsync(sleep);
    }
    catch (Exception ex)
    {
      Logger.LogWarning(ex, "Error setting sleep state to {Sleep} from JS callback", sleep);
    }
  }

  private void OnTimerElapsed(object? sender, System.Timers.ElapsedEventArgs e)
  {
    _currentTime = DateTime.Now.ToString("HH:mm");

    try
    {
      // Invoke state update on the UI thread - use fire-and-forget with error handling
      _ = SafeInvokeAsync();
    }
    catch (ObjectDisposedException)
    {
      // Component was disposed, stop the timer
      _timer?.Stop();
    }
  }

  private async Task SafeInvokeAsync()
  {
    try
    {
      await InvokeAsync(async () =>
      {
        StateHasChanged();
        await UpdateSystemStatsAsync();
      });
    }
    catch (ObjectDisposedException)
    {
      _timer?.Stop();
    }
    catch (Exception ex)
    {
      Logger.LogWarning(ex, "Error in timer update");
    }
  }

  private async Task LoadSourcesAsync()
  {
    try
    {
      Logger.LogDebug("Loading audio sources...");
      var sources = await SourcesApi.GetSourcesAsync();

      if (sources != null && sources.Count > 0)
      {
        Logger.LogDebug("Loaded {Count} audio sources: {Sources}",
          sources.Count, string.Join(", ", sources.Select(s => s.Name)));
        _availableSources = sources;

        // Try to get primary source, but don't fail if not available
        try
        {
          var primary = await SourcesApi.GetPrimarySourceAsync();
          if (primary != null)
          {
            // Match by type since the API returns UUID-based IDs that don't match
            // the dropdown items which use sourceType.ToLowerInvariant() as IDs
            var matchingSource = _availableSources.FirstOrDefault(s =>
              s.Type.Equals(primary.Type, StringComparison.OrdinalIgnoreCase));
            if (matchingSource != null)
            {
              _selectedSourceId = matchingSource.Id;

            }
            else
            {
              _selectedSourceId = primary.Type.ToLowerInvariant();
            }
            return;
          }
        }
        catch (Exception ex)
        {
          Logger.LogDebug(ex, "No primary source active (expected when no source is playing)");
        }

        // No primary source active - auto-select Radio as the default source
        Logger.LogDebug("No active primary source, auto-selecting Radio as default");
        var radioSource = sources.FirstOrDefault(s => s.Type.Equals("Radio", StringComparison.OrdinalIgnoreCase));
        if (radioSource != null)
        {
          var success = await SourcesApi.SwitchSourceAsync(radioSource.Type);
          if (success)
          {
            _selectedSourceId = radioSource.Id;
            Logger.LogDebug("Auto-selected Radio source: {SourceType}", radioSource.Type);
            return;
          }
          Logger.LogWarning("Failed to auto-select Radio source");
        }

        // Fallback to first source if Radio not available
        if (sources.Count > 0)
        {
          _selectedSourceId = sources[0].Id;
        }
      }
      else
      {
        Logger.LogWarning("No audio sources returned from API");
      }
    }
    catch (Exception ex)
    {
      Logger.LogError(ex, "Failed to load audio sources");
    }
  }

  private async Task LoadOutputDevicesAsync()
  {
    try
    {
      Logger.LogDebug("Loading audio output devices...");
      var outputsTask = DevicesApi.GetOutputDevicesAsync();
      var defaultCastTask = DevicesApi.GetDefaultCastDeviceAsync();
      var displayTask = DevicesApi.GetDeviceDisplaySettingsAsync();
      await Task.WhenAll(outputsTask, defaultCastTask, displayTask);

      var outputs = await outputsTask;
      _defaultCastDevice = await defaultCastTask;
      var displaySettings = await displayTask;

      if (outputs != null && outputs.Count > 0)
      {
        // Filter out hidden devices using display settings
        if (displaySettings != null)
        {
          var hiddenNames = displaySettings
            .Where(d => d.IsHidden)
            .Select(d => d.RawName)
            .ToHashSet(StringComparer.OrdinalIgnoreCase);
          outputs = outputs.Where(o => !hiddenNames.Contains(o.Name)).ToList();

          // Apply friendly names from display settings
          foreach (var output in outputs)
          {
            var display = displaySettings.FirstOrDefault(d =>
              d.RawName.Equals(output.Name, StringComparison.OrdinalIgnoreCase));
            if (display?.FriendlyNameOverride != null)
              output.Name = display.FriendlyNameOverride;
          }
        }

        Logger.LogDebug("Loaded {Count} visible output devices: {Devices}",
          outputs.Count, string.Join(", ", outputs.Select(d => d.Name)));
        _availableOutputs = outputs;
        UpdateCastOutputDisplayName();

        // Try to get current output device
        try
        {
          var current = await DevicesApi.GetCurrentOutputDeviceAsync();
          if (current != null)
          {
            _selectedOutputId = current.Id;
            return;
          }
        }
        catch (Exception ex)
        {
          Logger.LogDebug(ex, "No current output device set");
        }

        // Default to first (usually the default device)
        var defaultDevice = outputs.FirstOrDefault(d => d.IsDefault) ?? outputs[0];
        _selectedOutputId = defaultDevice.Id;
      }
      else
      {
        Logger.LogWarning("No output devices returned from API");
      }
    }
    catch (Exception ex)
    {
      Logger.LogError(ex, "Failed to load output devices");
    }
  }

  private void UpdateCastOutputDisplayName()
  {
    var castOutput = _availableOutputs.FirstOrDefault(o =>
      o.Id.Equals("google-cast", StringComparison.OrdinalIgnoreCase));
    if (castOutput == null) return;

    castOutput.Name = _defaultCastDevice != null
      ? _defaultCastDevice.Name
      : "Google Cast";
  }

  private async Task HandleSourceChangeAsync(string newSourceId)
  {
    if (string.IsNullOrEmpty(newSourceId) || newSourceId == _selectedSourceId) return;

    try
    {
      var source = _availableSources.FirstOrDefault(s => s.Id == newSourceId);
      if (source == null) return;

      var success = await SourcesApi.SwitchSourceAsync(source.Type);
      if (success)
      {
        _selectedSourceId = newSourceId;
        Logger.LogInformation("Switched to source: {SourceType}", source.Type);

        // Immediately notify NowPlayingPanel of the source change so it refreshes
        // without waiting for the 500ms AudioStateUpdateService polling cycle.
        await HubService.NotifySourceChangedAsync();
      }
    }
    catch (Exception ex)
    {
      Logger.LogError(ex, "Failed to switch audio source");
    }
  }

  private async Task HandleOutputChangeAsync(string newOutputId)
  {
    if (string.IsNullOrEmpty(newOutputId)) return;

    if (newOutputId == "google-cast")
    {
      // Cast already active → toggle dropdown for device switching
      if (newOutputId == _selectedOutputId)
      {
        _showCastDropdown = !_showCastDropdown;
        return;
      }

      // First click on Cast with a saved default → auto-connect (no dropdown)
      if (_defaultCastDevice != null)
      {
        await AutoConnectCastDeviceAsync(newOutputId);
        return;
      }

      // First click on Cast with no default → open dropdown for device selection
      _selectedOutputId = newOutputId;
      _showCastDropdown = true;
      return;
    }

    if (newOutputId == _selectedOutputId) return;

    // Switching away from Cast → close dropdown if open
    if (_showCastDropdown)
      _showCastDropdown = false;

    try
    {
      var success = await DevicesApi.SetOutputDeviceAsync(newOutputId);
      if (success)
      {
        _selectedOutputId = newOutputId;
        Logger.LogInformation("Switched audio output to: {OutputId}", newOutputId);
      }
    }
    catch (Exception ex)
    {
      Logger.LogError(ex, "Failed to switch audio output");
    }
  }

  private void ToggleOutputPicker()
  {
    // Output device picker is a deferred concern (PR 3 owns DeviceManagementPage).
    // For PR 2 the pill simply navigates to the Devices page so the user can pick.
    NavigationManager.NavigateTo("/devices");
  }

  private async Task AutoConnectCastDeviceAsync(string outputId)
  {
    _isCastConnecting = true;
    _selectedOutputId = outputId;
    StateHasChanged();

    try
    {
      // Switch to the Cast output first
      var outputSuccess = await DevicesApi.SetOutputDeviceAsync(outputId);
      if (!outputSuccess)
      {
        Logger.LogWarning("Failed to switch to Cast output");
        return;
      }

      // Try to connect to the default Cast device
      Logger.LogInformation("Auto-connecting to default Cast device: {DeviceName}", _defaultCastDevice!.Name);
      var connectSuccess = await DevicesApi.ConnectToCastDeviceAsync(_defaultCastDevice);

      if (connectSuccess)
      {
        Logger.LogInformation("Auto-connected to Cast device: {DeviceName}", _defaultCastDevice.Name);
      }
      else
      {
        // Device not reachable — clear default and open dialog for manual selection
        Logger.LogWarning("Failed to auto-connect to {DeviceName}, clearing default", _defaultCastDevice.Name);
        await DevicesApi.ClearDefaultCastDeviceAsync();
        _defaultCastDevice = null;
        UpdateCastOutputDisplayName();
        _showCastDropdown = true;
        StateHasChanged();
      }
    }
    catch (Exception ex)
    {
      Logger.LogError(ex, "Error auto-connecting to Cast device");
      await DevicesApi.ClearDefaultCastDeviceAsync();
      _defaultCastDevice = null;
      UpdateCastOutputDisplayName();
      _showCastDropdown = true;
      StateHasChanged();
    }
    finally
    {
      _isCastConnecting = false;
      StateHasChanged();
    }
  }

  // Source icon mapping — delegates to shared helper
  private static string GetSourceIcon(string sourceType) => SourceTypeHelper.GetIcon(sourceType);

  // Data attribute for source-specific CSS coloring — delegates to shared helper
  private static string GetSourceDataAttr(string sourceType) => SourceTypeHelper.GetDataAttribute(sourceType);

  /// <summary>
  /// Map a source type to the CSS custom-property name for its accent colour.
  /// Used by SourceBubble (Accent parameter), the IN cluster swatch, and the
  /// NowPlayingDock source-color dot. Delegates to <see cref="SourceTypeHelper"/>
  /// so every consumer reads from the same matrix.
  /// </summary>
  private static string GetAccentVarForSource(string sourceType) =>
    SourceTypeHelper.GetAccentVar(sourceType);

  private string GetActiveSourceAccentVar() =>
    ActiveSource is null ? "--text-low" : GetAccentVarForSource(ActiveSource.Type);

  private string GetActiveOutputAccentVar()
  {
    if (ActiveOutput is null) return "--text-low";
    if (ActiveOutput.Id.Equals("google-cast", StringComparison.OrdinalIgnoreCase))
      return "--accent-primary";
    if (ActiveOutput.IsUSBDevice) return "--source-usb";
    return "--accent-primary";
  }

  /// <summary>
  /// Optional sub-label rendered under the source name in a SourceBubble.
  /// Kept minimal in PR 2 — richer metadata (station name, BT device, current
  /// file) is the consumer's job in PR 3.
  /// </summary>
  private static string? GetSourceSubLabel(AudioSourceDto source) =>
    source.State switch
    {
      "Unavailable" => "unavailable",
      "Error" => "error",
      _ => null
    };

  /// <summary>
  /// True if a source has a dedicated detail surface (Radio control panel,
  /// Bluetooth pairing page) that the chevron can open. Delegates to
  /// <see cref="SourceTypeHelper.HasDetail(string)"/> so the matrix is defined
  /// in exactly one place — adding a new source with a detail surface only
  /// requires updating <c>SourcesWithDetail</c> there.
  /// </summary>
  private static bool HasSourceDetail(string sourceType) =>
    SourceTypeHelper.HasDetail(sourceType);

  // Source availability check
  private static bool IsSourceAvailable(AudioSourceDto source) =>
    source.State != "Unavailable" && source.State != "Error";

  // Active page detection for nav highlighting
  private bool IsCurrentPage(string path)
  {
    var uri = NavigationManager.ToBaseRelativePath(NavigationManager.Uri);
    if (string.IsNullOrEmpty(uri) && path == "/") return true;
    return $"/{uri}".StartsWith(path, StringComparison.OrdinalIgnoreCase);
  }

  /// <summary>
  /// True when the routed page is anywhere other than Home — the NowPlayingPanel
  /// already owns the player surface on <c>/</c>, so the dock is suppressed there
  /// (handoff §P1·1).
  /// </summary>
  private bool IsDockVisible => !_isOnHome;

  private bool IsCurrentlyOnHome()
  {
    var rel = NavigationManager.ToBaseRelativePath(NavigationManager.Uri);
    // Strip query/fragment so "/?foo=bar" still counts as home.
    var slash = rel.IndexOfAny(new[] { '?', '#' });
    if (slash >= 0) rel = rel[..slash];
    return string.IsNullOrEmpty(rel) || rel == "/";
  }

  private void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
  {
    var wasOnHome = _isOnHome;
    _isOnHome = IsCurrentlyOnHome();
    if (wasOnHome != _isOnHome)
    {
      // Dock visibility flipped — trigger a re-render so the <NowPlayingDock>
      // appears/disappears and .has-dock toggles on .content-area.
      _ = InvokeAsync(StateHasChanged);
    }
  }

  /// <summary>
  /// Source pill body tap (handoff §P1·2). Tapping a source pill ALWAYS switches
  /// to that source — nothing else. The pill no longer toggles the radio panel
  /// on second-tap and no longer navigates between detail surfaces; those
  /// affordances live on the chevron (<see cref="HandleSourceDetailAsync"/>).
  ///
  /// We still maintain the side-effect that switching TO Radio shows the radio
  /// control panel on Home and switching AWAY hides it — the panel-visibility
  /// state is a function of the active source, not of user-tap intent.
  /// </summary>
  private async Task HandleSourceToggleAsync(AudioSourceDto source)
  {
    if (!IsSourceAvailable(source)) return;
    // Idempotent: tapping the currently-active pill is a no-op for source
    // switching. The body never opens panels or navigates — that's the chevron.
    if (source.Id == _selectedSourceId) return;

    if (IsRadioSource(source.Type))
    {
      await HandleSourceChangeAsync(source.Id);
      await RadioPanelToggle.ShowRadioPanelAsync();
    }
    else
    {
      await RadioPanelToggle.HideRadioPanelAsync();
      await HandleSourceChangeAsync(source.Id);
    }
  }

  /// <summary>
  /// Chevron tap on a source bubble (handoff §P1·2). The chevron is only rendered
  /// when the source is active AND has a detail surface (see
  /// <see cref="SourceTypeHelper.HasDetail(string)"/>). Dispatch:
  ///
  /// <list type="bullet">
  ///   <item>Radio family (Radio / RTLSDRCore / RF320) → navigate Home and show
  ///         the radio control panel (idempotent).</item>
  ///   <item>Bluetooth → navigate to the BT pairing page.</item>
  /// </list>
  ///
  /// Unknown / unmapped types fall through silently; the chevron wouldn't have
  /// rendered for them.
  /// </summary>
  private async Task HandleSourceDetailAsync(AudioSourceDto source)
  {
    if (IsRadioSource(source.Type))
    {
      NavigationManager.NavigateTo("/");
      await RadioPanelToggle.ShowRadioPanelAsync();
      return;
    }
    if (source.Type == "Bluetooth")
    {
      NavigationManager.NavigateTo("/bluetooth");
    }
  }

  private static bool IsRadioSource(string sourceType) =>
    sourceType is "Radio" or "RTLSDRCore" or "RF320";

  private async Task HandleDistortionMarkerAsync()
  {
    _distortionMarkerColor = "distortion-active";
    StateHasChanged();
    await AudioApi.ReportDistortionAsync();
    await Task.Delay(1000);
    _distortionMarkerColor = "";
    StateHasChanged();
  }

  private async Task HandleQueueNavAsync()
  {
    await RadioPanelToggle.HideRadioPanelAsync();
    NavigationManager.NavigateTo("/");
  }

  private async Task OnCastDeviceSelected(CastDeviceDto selectedDevice)
  {
    Logger.LogInformation("Selected Cast device: {DeviceName}", selectedDevice.Name);
    await DevicesApi.SetDefaultCastDeviceAsync(selectedDevice);
    _defaultCastDevice = selectedDevice;
    UpdateCastOutputDisplayName();
    StateHasChanged();
  }

  private async Task OnCastDeviceDisconnected()
  {
    Logger.LogInformation("Disconnected from Cast device");
    await DevicesApi.ClearDefaultCastDeviceAsync();
    _defaultCastDevice = null;
    UpdateCastOutputDisplayName();
    StateHasChanged();
  }

  private async Task UpdateSystemStatsAsync()
  {
    try
    {
      var stats = await SystemApi.GetSystemStatsAsync();
      if (stats != null)
      {
        _cpuUsage = stats.CpuUsagePercent.ToString("F1");
        _ramUsage = stats.RamUsageMb.ToString("F0");
        _threadCount = stats.ThreadCount.ToString();
      }
    }
    catch (Exception)
    {
      // Silently fail to avoid disrupting UI updates
    }
  }

  private async Task OnPlaybackStateChanged()
  {
    await InvokeAsync(StateHasChanged);
  }

  private async Task OnNowPlayingChanged(NowPlayingDto? _)
  {
    await InvokeAsync(StateHasChanged);
  }

  private async Task OnQueueChanged()
  {
    await RefreshQueueCountAsync();
    await InvokeAsync(StateHasChanged);
  }

  private async Task OnSourceChanged()
  {
    // Refresh selected source and sync radio panel with new source
    await LoadSourcesAsync();
    var activeSource = _availableSources.FirstOrDefault(s => s.Id == _selectedSourceId);
    if (activeSource != null)
    {
      if (IsRadioSource(activeSource.Type))
      {
        await RadioPanelToggle.ShowRadioPanelAsync();
      }
      else
      {
        await RadioPanelToggle.HideRadioPanelAsync();
      }
    }
    await InvokeAsync(StateHasChanged);
  }

  private async Task OnSleepStateChanged(bool isSleeping)
  {
    try
    {
      await InvokeAsync(async () =>
      {
        if (isSleeping)
        {
          await JSRuntime.InvokeVoidAsync("radioSleepManager.enterSleep", "server");
        }
        else
        {
          await JSRuntime.InvokeVoidAsync("radioSleepManager.wake", "server");
        }
      });
    }
    catch (Exception ex)
    {
      Logger.LogWarning(ex, "Error handling sleep state change");
    }
  }

  private async Task HandleSleepButtonAsync()
  {
    try
    {
      // Show black overlay immediately via JS
      await JSRuntime.InvokeVoidAsync("radioSleepManager.enterSleep", "server");
      // Call API server-side to pause audio (avoids browser CORS issues)
      await SystemApi.SetSleepAsync(true);
    }
    catch (Exception ex)
    {
      Logger.LogWarning(ex, "Error entering sleep mode");
    }
  }

  private async Task OnDeviceDisplaySettingsChanged()
  {
    await LoadOutputDevicesAsync();
    await InvokeAsync(StateHasChanged);
  }

  private async Task RefreshQueueCountAsync()
  {
    try
    {
      var queue = await QueueApi.GetQueueAsync();
      _queueCount = queue?.Count ?? 0;
      Logger.LogDebug("MainLayout - Queue count updated: {Count}", _queueCount);
    }
    catch (Exception ex)
    {
      Logger.LogError(ex, "Error refreshing queue count in MainLayout");
    }
  }

  public void Dispose()
  {
    // Unsubscribe from events to prevent memory leaks
    HubService.PlaybackStateChanged -= OnPlaybackStateChanged;
    HubService.NowPlayingChanged -= OnNowPlayingChanged;
    HubService.QueueChanged -= OnQueueChanged;
    HubService.SourceChanged -= OnSourceChanged;
    HubService.SleepStateChanged -= OnSleepStateChanged;
    DeviceDisplayState.DisplaySettingsChanged -= OnDeviceDisplaySettingsChanged;
    NavigationManager.LocationChanged -= OnLocationChanged;

    _timer?.Stop();
    _timer?.Dispose();
    _selfReference?.Dispose();
  }

  public ValueTask DisposeAsync()
  {
    Dispose();
    return ValueTask.CompletedTask;
  }
}
