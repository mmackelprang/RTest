  // --- ENC-12: encoder fault badge + notification ---
  //
  // Every decision is in EncoderFaultRules / EncoderFaultAnnouncer rather than here, because
  // MainLayoutTests renders nothing (Radzen + JSInterop) and logic written in this file would ship
  // with no automated coverage. Same reason BellHealthRules exists.

  private string? _encoderStatus;
  private bool? _encoderConnected;
  private bool _encoderWasEverConnected;
  // Seeded true so a console whose provisioning pull fails is treated as having the knobs switched
  // ON — the direction that still shows a fault — rather than silently suppressing every indicator.
  // GET /api/integrations/encoder/provisioning carries the real value.
  private bool _encoderEnabled = true;
  // Set by either broadcast handler, and read by SeedEncoderStateAsync so the boot seed does not
  // overwrite a value a broadcast has already delivered. The subscriptions are wired before the
  // seed's HTTP call, so anything arriving during that await is newer than the response in flight.
  private bool _encoderBroadcastSeen;

  private string EncoderBadgeIcon => EncoderFaultRules.BadgeIcon(_encoderStatus, _encoderConnected, _encoderEnabled);
  private string EncoderBadgeClass => EncoderFaultRules.BadgeClass(_encoderStatus, _encoderConnected, _encoderEnabled);
  private string EncoderNavLabel =>
    EncoderFaultRules.NavPillAriaLabel(_encoderStatus, _encoderConnected, _encoderEnabled, _encoderFirmwareCheck);

  // ENC-19: why a hard fault happened, when the reason is firmware that ignores host writes.
  private string? _encoderFirmwareCheck;

  /// <summary>
  /// Seeds the badge fields from <c>GET /api/integrations/encoder/provisioning</c>, falling back to
  /// <see cref="AudioStateStore"/>'s cached broadcasts when that call returns nothing.
  /// </summary>
  /// <remarks>
  /// Never throws. <c>OnInitializedAsync</c> rethrows what reaches it, which crashes the circuit, and
  /// a fault badge is not worth a blank screen.
  /// </remarks>
  private async Task SeedEncoderStateAsync()
  {
    try
    {
      EncoderProvisioningDto? provisioning = await IntegrationsApi.GetEncoderProvisioningAsync();

      if (_encoderBroadcastSeen)
      {
        // A broadcast landed while the pull was in flight. It describes a later moment than the
        // response now in hand, so it stands and the response is discarded.
        return;
      }

      if (provisioning is not null)
      {
        _encoderEnabled = provisioning.Enabled;
        // Status is already the serialized tier name on the DTO, which is the shape
        // EncoderFaultRules takes — no enum conversion in between.
        _encoderStatus = provisioning.Status;
        _encoderFirmwareCheck = provisioning.FirmwareCheck;
        _encoderConnected = provisioning.IsConnected;
        _encoderWasEverConnected = provisioning.WasEverConnected;
        return;
      }

      // IntegrationsApiService swallows its own transport failures and returns null, so this covers
      // both "the API said nothing" and "the API could not be reached".
      Logger.LogDebug("Encoder provisioning pull returned nothing; seeding the badge from the cache");
    }
    catch (Exception ex)
    {
      Logger.LogDebug(ex, "Encoder provisioning pull failed; seeding the badge from the cache");
    }

    _encoderStatus = AudioState.EncoderConfigStatus?.Status;
    _encoderFirmwareCheck = AudioState.EncoderConfigStatus?.FirmwareCheck;
    _encoderConnected = AudioState.EncoderConnection?.IsConnected;
    _encoderWasEverConnected = AudioState.EncoderConnection?.WasEverConnected ?? false;
  }

  // The new value is captured into a local out here but ASSIGNED to the field inside InvokeAsync, so
  // each broadcast is evaluated against the state it carried. Assigning the field out here let two
  // broadcasts arriving back to back both be evaluated against the newer one, collapsing
  // Degraded → HardFault into a single toast — and one notification per escalation is the single
  // requirement this row is judged on (plan §0.5).
  private async Task OnEncoderConfigStatusChangedAsync()
  {
    string? status = AudioState.EncoderConfigStatus?.Status;
    string? firmwareCheck = AudioState.EncoderConfigStatus?.FirmwareCheck;
    await InvokeAsync(() =>
    {
      _encoderStatus = status;
      _encoderFirmwareCheck = firmwareCheck;
      _encoderBroadcastSeen = true;
      AnnounceEncoderStateIfNeeded();
      StateHasChanged();
    });
  }

  /// <remarks>
  /// ⚠ Nothing before the first await may throw — but NOT for the UI-6 starvation reason an earlier
  /// draft of this remark gave, which was wrong in both directions. This handler is subscribed to
  /// ConsolePlaybackState.Changed (:434), and that fan-out walks GetInvocationList() and wraps each
  /// handler in its own try/catch (ConsolePlaybackState.cs:88-100), so a synchronous throw here cannot
  /// reach AudioStateStore.NotifyAsync at all — and NotifyAsync has its own try/catch and exactly one
  /// subscriber besides.
  ///
  /// The real cost is that such a throw would be SWALLOWED: one LogWarning, and this circuit's chip
  /// silently stops re-rendering while every other circuit carries on. A wall panel showing a stale
  /// chip is indistinguishable from a correct one, and nothing on the box would say otherwise.
  /// Keeping this body to a bare InvokeAsync is what makes that unreachable rather than merely
  /// unlikely.
  /// </remarks>
  private Task OnConsolePlaybackChangedAsync() => InvokeAsync(StateHasChanged);

  // Handoff §Cross-3: the chip's LABEL is the kind; the SENDER goes in title and aria-label, which
  // have room. The seam's Label is already "Voicemail from Jane" and is capped at 128 chars server
  // side (PHN-1b §0.3), so it is safe to interpolate.
  // ⚠ The RemoteMedia arm is UNCHANGED, byte for byte — PHN-2 shipped it and it has a test.
  // The Speech arm is new (PHN-3) and exists because handoff §Cross-3 :145/:147 specifies
  // "Reading a message from {sender} on the console." and one kind-agnostic "Playing {label}"
  // string cannot produce it. The sender arrives inside Label, shaped by MessageBubble.SpeakLabel
  // as "a message from Jane" so this reads as a sentence.
  private string ConsolePlaybackTitle => ConsolePlayback.Snapshot switch
  {
    { Kind: "Speech", Label: { Length: > 0 } label } =>
      $"Reading {label} on the console. Tap to stop.",
    { Kind: "Speech" } => "Reading a message on the console. Tap to stop.",
    { Label: { Length: > 0 } label } => $"Playing {label} on the console. Tap to stop.",
    _ => "Playing on the console. Tap to stop."
  };

  private string ConsolePlaybackAriaLabel => ConsolePlayback.Snapshot switch
  {
    { Kind: "Speech", Label: { Length: > 0 } label } => $"Stop reading {label}",
    { Kind: "Speech" } => "Stop reading message",
    { Label: { Length: > 0 } label } => $"Stop playing {label}",
    _ => "Stop playing on the console"
  };

  /// <remarks>
  /// ⚠ One tap, no confirm. Stopping playback is not destructive, and a confirm dialog on a wall panel
  /// costs more than the mistake it prevents (handoff §Cross-3).
  ///
  /// ⚠ No optimistic hide. The chip disappears when the SERVER says so, because a chip that vanished
  /// on tap and then came back — a stop that raced a natural end, or lost — is worse than one that
  /// takes ~5 ms to go. The round trip is Web to API on the same box.
  /// </remarks>
  private async Task StopConsolePlaybackAsync()
  {
    var id = ConsolePlayback.Snapshot?.Id;
    if (!string.IsNullOrEmpty(id))
    {
      await EventPlaybackApi.StopAsync(id);
    }
  }

  // ENC-12 Task 8b. This is the branch that finally consumes WasEverConnected — the flag ENC-0 added
  // specifically to tell absent-at-boot from dropped-mid-session, and which nothing has used since.
  // Same locals-capture as above, and for the same reason.
  private async Task OnEncoderConnectionChangedAsync()
  {
    bool? isConnected = AudioState.EncoderConnection?.IsConnected;
    bool? wasEverConnected = AudioState.EncoderConnection?.WasEverConnected;
    await InvokeAsync(() =>
    {
      _encoderConnected = isConnected;
      _encoderWasEverConnected = wasEverConnected ?? _encoderWasEverConnected;
      _encoderBroadcastSeen = true;
      AnnounceEncoderStateIfNeeded();
      StateHasChanged();
    });
  }

  // ENC-20. Any encoder activity undims the screen and resets both idle timers. The input is NOT
  // consumed: the knob's action already happened in the API, and this only makes the panel visible
  // for it.
  //
  // ⚠ GUARDED ON A CARD BEING PRESENT, which is the whole subtlety. StateChanged also fires on
  // Dismiss() — the hold timer expiring, and the device DISCONNECTING. Waking on the first would
  // reset the five-minute idle countdown a second or two after the user stopped touching anything,
  // quietly extending it by the card's hold duration on every interaction; waking on the second
  // would let unplugging the encoder count as human activity. A non-null Current is the only state
  // that means "something is on screen because a hand is on a knob".
  private void OnEncoderHudActivity()
  {
    if (!_sleepManagerReady || EncoderHud.Current is null)
    {
      return;
    }

    // EncoderHudService raises this from whichever thread published — for the dismissal timer that
    // is a thread-pool thread with no Blazor context — so the interop is marshalled onto the
    // circuit, exactly as OnEncoderConnectionChangedAsync above does.
    _ = InvokeAsync(async () =>
    {
      try
      {
        await JSRuntime.InvokeVoidAsync("radioSleepManager.wake", "encoder");
      }
      catch (JSDisconnectedException)
      {
        // Circuit is gone. A wake is cosmetic, so there is nothing to recover and nothing to say.
      }
      catch (ObjectDisposedException)
      {
        // Same: raced this circuit's teardown. The service is a singleton and can raise
        // concurrently with Dispose's unsubscribe.
      }
      catch (TaskCanceledException)
      {
        // The interop call was cut short by the circuit closing.
      }
    });
  }

  /// <summary>
  /// Raises at most one notification per escalation, per browser session. The latch is in
  /// EncoderFaultAnnouncer; this method only renders what it decides.
  /// </summary>
  private void AnnounceEncoderStateIfNeeded()
  {
    var announcement = EncoderAnnouncer.Evaluate(
      _encoderStatus, _encoderConnected, _encoderWasEverConnected, _encoderFirmwareCheck);
    if (announcement is not { } a)
    {
      return;
    }

    NotificationService.Notify(new NotificationMessage
    {
      Severity = a.Level switch
      {
        EncoderFaultLevel.Critical => NotificationSeverity.Error,
        EncoderFaultLevel.Warning => NotificationSeverity.Warning,
        _ => NotificationSeverity.Success,
      },
      Summary = a.Summary,
      Detail = a.Detail,
      // Longer than the 5 s preset-undo toast: that one races a user who is already looking at the
      // control they just used, while this one may land while nobody is at the cabinet.
      Duration = 10000,
      // Handoff §7.6 gives each of these an action: "-> Open encoder settings". Clicking the toast
      // body is how this codebase already does toast actions (RadioControlPanel.razor:1372).
      // It lands on /system, not on the Integrations sub-tab: SystemConfigPage's RadzenTabs has no
      // route parameter, so this is one tap short of the card. Recorded in design/FUTURE-WORK.md;
      // the copy does not promise more than it delivers.
      Click = _ => NavigationManager.NavigateTo("/system"),
    });
  }

  // --- ENC-4a: persistent mute indicator ---

  private bool _isMuted;

  private async Task LoadMuteStateAsync()
  {
    try
    {
      var volume = await AudioApi.GetVolumeAsync();
      if (volume is not null)
      {
        _isMuted = volume.IsMuted;
      }
    }
    catch (Exception ex)
    {
      // A layout that cannot reach the API still has to render. Failing closed (chip hidden) is
      // the right direction: a spurious MUTED on a console that is playing would be worse than a
      // missing one, because it invites someone to "fix" audio that is not broken.
      Logger.LogDebug(ex, "Could not load initial mute state for the topbar chip");
    }
  }

  private async Task OnVolumeChanged(VolumeDto? dto)
  {
    if (dto is null || dto.IsMuted == _isMuted)
    {
      return;
    }

    _isMuted = dto.IsMuted;
    await InvokeAsync(StateHasChanged);
  }

  private async Task UnmuteAsync()
  {
    try
    {
      await AudioApi.ToggleMuteAsync(false);
      // Do not set _isMuted here — the VolumeChanged broadcast is what confirms the console
      // actually unmuted. Optimistically clearing the chip would hide the one indicator the user
      // has if the call silently failed.
    }
    catch (Exception ex)
    {
      Logger.LogWarning(ex, "Unmute from the topbar chip failed");
    }
  }

  public void Dispose()
  {
    // Unsubscribe from events to prevent memory leaks
    HubService.PlaybackStateChanged -= OnPlaybackStateChanged;
    HubService.NowPlayingChanged -= OnNowPlayingChanged;
    HubService.QueueChanged -= OnQueueChanged;
    HubService.SourceChanged -= OnSourceChanged;
    HubService.OutputChanged -= OnOutputChanged;
    HubService.SleepStateChanged -= OnSleepStateChanged;
    HubService.VolumeChanged -= OnVolumeChanged;
    DeviceDisplayState.DisplaySettingsChanged -= OnDeviceDisplaySettingsChanged;
    GainPopover.StateChanged -= OnGainPopoverStateChanged;
    PhoneUnread.Changed -= OnPhoneUnreadChanged;
    BellHealth.HealthChanged -= OnBellHealthChanged;
    // ENC-12. AudioStateStore is a singleton, so a missed unsubscribe here would keep every circuit
    // that has ever rendered this layout alive for the life of the process.
    AudioState.EncoderConfigStatusChanged -= OnEncoderConfigStatusChangedAsync;
    AudioState.EncoderConnectionChanged -= OnEncoderConnectionChangedAsync;
    // ADR-029 PR 6. ConsolePlaybackState is a singleton for the same reason AudioStateStore is, so
    // the same hazard applies: a missed unsubscribe here pins every circuit that has ever rendered
    // this layout for the life of the process.
    ConsolePlayback.Changed -= OnConsolePlaybackChangedAsync;
    // ENC-20. EncoderHudService is a singleton for the same reason AudioStateStore is, so the same
    // hazard applies: a missed unsubscribe here pins every circuit that has ever rendered this
    // layout for the life of the process.
    EncoderHud.StateChanged -= OnEncoderHudActivity;
    NavigationManager.LocationChanged -= OnLocationChanged;

    _timer?.Stop();
    _timer?.Dispose();
    _selfReference?.Dispose();
    _devTrayRef?.Dispose();
  }

  public async ValueTask DisposeAsync()
  {
    // Tear down the dev-gesture JS module before releasing the .NET reference
    // so the module's handlers don't fire one more time into a disposed ref.
    if (_devGestureModule != null)
    {
      try
      {
        await _devGestureModule.InvokeVoidAsync("dispose");
        await _devGestureModule.DisposeAsync();
      }
      catch (Exception ex)
      {
        Logger.LogDebug(ex, "Error disposing dev-gesture JS module");
      }
      _devGestureModule = null;
    }
    Dispose();
  }
}
