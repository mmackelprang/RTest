@inherits LayoutComponentBase
@using Radio.Web.Formatting
@using Radio.Web.Models
@using Microsoft.Extensions.Options
@inject SystemApiService SystemApi
@inject SourcesApiService SourcesApi
@inject DevicesApiService DevicesApi
@inject AudioStateHubService HubService
@inject AudioApiService AudioApi
@inject QueueApiService QueueApi
@inject IntegrationsApiService IntegrationsApi
@inject NavigationManager NavigationManager
@inject ILogger<MainLayout> Logger
@inject IJSRuntime JSRuntime
@inject Radio.Web.Services.DeviceDisplayStateService DeviceDisplayState
@inject Radio.Web.Services.CentrePanelViewService CentrePanelView
@inject Radio.Web.Services.GainPopoverService GainPopover
@inject Radio.Web.Services.PhoneUnreadState PhoneUnread
@inject Radio.Web.Services.BellHealthService BellHealth
@inject AudioStateStore AudioState
@inject Radio.Web.Services.ConsolePlaybackState ConsolePlayback
@inject EventPlaybackApiService EventPlaybackApi
@inject NotificationService NotificationService
@inject Radio.Web.Services.EncoderFaultAnnouncer EncoderAnnouncer
@inject Radio.Web.Services.EncoderHudService EncoderHud
@inject IConfiguration Configuration
@inject IOptionsMonitor<DevicesOptions> DevicesOptionsMonitor
@inject IOptionsMonitor<DisplayOptions> DisplayOptionsMonitor
@implements IDisposable
@implements IAsyncDisposable

<RadzenComponents />

<div class="layout-container" style="width: 1920px; height: 720px; overflow: hidden;">
  @* Top Bar — two-row Command Surface (PR 2):
       row 1 .topbar-primary  → time / IN / arrow / OUT / nav pills
       row 2 .topbar-sources  → SourceBubble strip *@
  <div class="topbar">

    <!-- Row 1: primary command row -->
    <div class="topbar-primary">

      <!-- Time cluster -->
      <div class="cluster cluster-time">
        <span class="cluster-label">Time</span>
        <span class="cluster-value"><span class="font-led">@_currentTime</span></span>
      </div>

      <div class="topbar-separator"></div>

      <!-- IN cluster: active source name + swatch.
           Label routed through DisplayNames.Source so a missing/empty Name on the
           DTO falls through to a humanized Type instead of leaking a GUID-shaped Id. -->
      <div class="cluster">
        <span class="cluster-label">In</span>
        <span class="cluster-value" title="@(ActiveSource?.Name ?? ActiveSource?.Id ?? "")">
          <span class="cluster-swatch" style="@($"--bubble-accent: var({GetActiveSourceAccentVar()});")"></span>
          @(ActiveSource is null ? "—" : DisplayNames.Source(ActiveSource))
        </span>
      </div>

      <span class="topbar-arrow" aria-hidden="true">→</span>

      <!-- OUT cluster: active output name + swatch.
           Label routed through DisplayNames.Device with the configured alias map so
           "CABLE Input (VB-Audio Virtual Cable)" surfaces as "VB-Audio Cable In", etc.
           Tooltip preserves the raw name for debugging / a11y. -->
      <div class="cluster">
        <span class="cluster-label">Out</span>
        <span class="cluster-value" title="@(ActiveOutput?.Name ?? "")">
          <span class="cluster-swatch" style="@($"--bubble-accent: var({GetActiveOutputAccentVar()});")"></span>
          @(ActiveOutput is null ? "—" : DisplayNames.Device(ActiveOutput, DeviceAliases))
          @if (ActiveOutput?.Id.Equals("google-cast", StringComparison.OrdinalIgnoreCase) == true && _isCastConnecting)
          {
            <span class="cast-connecting" style="display:inline-block; width:8px; height:8px; border-radius:50%; background: var(--accent-primary);"></span>
          }
        </span>
      </div>

      @* ENC-4a — persistent mute indicator (handoff §6.7).
         Mute previously showed only as a glyph inside NowPlayingPanel, which lives in Home's
         left rail, so /queue, /metrics, /devices, /history and /phone had NO mute indication at
         all. A muted console with no visible reason is indistinguishable from a broken one. *@
      @if (_isMuted)
      {
        <button type="button" class="topbar-mute-chip" @onclick="UnmuteAsync"
                title="Muted — tap to unmute" aria-label="Audio is muted. Tap to unmute.">
          <RadzenIcon Icon="volume_off" />
          <span>Muted</span>
        </button>
      }

      @if (_availableOutputs.Any(o => o.Id.Equals("google-cast", StringComparison.OrdinalIgnoreCase)))
      {
        <div style="position: relative;">
          <button type="button" class="nav-pill"
                  @onclick="@(() => HandleOutputChangeAsync("google-cast"))"
                  aria-label="Cast device picker"
                  title="Cast">
            <RadzenIcon Icon="cast" />
            <span class="nav-pill-label">Cast</span>
          </button>
          <CastDeviceDropdown IsOpen="_showCastDropdown"
                              IsOpenChanged="@((bool v) => { _showCastDropdown = v; StateHasChanged(); })"
                              OnDeviceSelected="OnCastDeviceSelected"
                              OnDisconnect="OnCastDeviceDisconnected"
                              DevicesApi="DevicesApi"
                              ConnectedDevice="_connectedCastDevice"
                              Logger="Logger" />
        </div>
      }

      <!-- Output picker entry (for non-Cast switches).
           Wrapper provides the absolute-positioning anchor for the popover. -->
      <div style="position: relative;">
        <button type="button" class="nav-pill" @onclick="ToggleOutputPicker"
                aria-label="Output device picker"
                title="Select audio output">
          <RadzenIcon Icon="speaker" />
          <span class="nav-pill-label">Out</span>
        </button>
        <OutputPickerDropdown IsOpen="_showOutputDropdown"
                              IsOpenChanged="@((bool v) => { _showOutputDropdown = v; StateHasChanged(); })"
                              OnOutputSelected="OnLocalOutputSelectedAsync"
                              CurrentOutputId="@_selectedOutputId"
                              AvailableOutputs="_availableOutputs"
                              DeviceAliases="DeviceAliases" />
      </div>

      @* ADR-029 §7.2 / handoff §Cross-3 — the console-playback chip: the global stop control, and
         the thing that earns "playback survives navigation."

         Here and NOT in NowPlayingDock, because the dock is gated on IsDockVisible => !_isOnHome
         (defined at :1036, applied at :273 and :277) — a stop control absent on the landing page is
         not a global remote.

         A real <button>, not a marker on the /phone pill: that pill's bottom-right is already the
         bell-fault glyph (.phone-nav-fault), which is pointer-events: none, and this must be tappable.

         No pulse, no blink — a pulsing element on a wall panel in a dark room is what the sleep work
         exists to prevent. It occupies no space at rest: the markup is not rendered at all. *@
      @if (ConsolePlayback.IsLive)
      {
        <button type="button" class="nav-pill nav-pill-playing"
                @onclick="StopConsolePlaybackAsync"
                title="@ConsolePlaybackTitle"
                aria-label="@ConsolePlaybackAriaLabel">
          <RadzenIcon Icon="volume_up" />
          <span class="nav-pill-label">@ConsolePlayback.KindLabel</span>
          <RadzenIcon Icon="stop_circle" />
        </button>
      }

      <!-- Nav pills (right-aligned) -->
      <div class="topbar-nav">
        @* Dev-tray triple-tap target (handoff §P2·2, PR 6). An invisible, pill-sized slot directly left
           of Home. It used to be a 48×48 zone in the viewport's top-right corner, which a finger cannot
           reach on the kiosk panel — only a mouse could open the tray. Here it is a full nav-row-height
           target, and a near miss lands on Home (harmless) rather than on Sleep. dev-gesture.js finds it
           by the data-dev-gesture attribute. *@
        <div class="dev-gesture-hit" data-dev-gesture aria-hidden="true"></div>
        <a href="/" class="nav-pill @(IsCurrentPage("/") ? "nav-active" : "")" title="Home" aria-label="Home">
          <RadzenIcon Icon="home" />
          <span class="nav-pill-label">Home</span>
        </a>
        <button type="button" class="nav-pill @(IsCurrentPage("/") ? "nav-active" : "")"
                @onclick="HandleQueueNavAsync"
                title="Queue"
                aria-label="@($"Queue, {_queueCount} item{(_queueCount == 1 ? "" : "s")}")">
          <RadzenIcon Icon="queue_music" />
          <span class="nav-pill-label">Queue</span>
          @if (_queueCount > 0)
          {
            <span class="nav-badge" aria-hidden="true">@_queueCount</span>
          }
        </button>
        @* UI-2 / D11: there is no Metrics pill. Diagnostics live under Settings (/diagnostics opens
           the Settings page on its Diagnostics tab), so the Settings pill below lights for both. *@
        <a href="/devices" class="nav-pill @(IsCurrentPage("/devices") ? "nav-active" : "")" title="Devices" aria-label="Devices">
          <RadzenIcon Icon="devices" />
          <span class="nav-pill-label">Devices</span>
        </a>
        <a href="/history" class="nav-pill @(IsCurrentPage("/history") ? "nav-active" : "")" title="History" aria-label="History">
          <RadzenIcon Icon="history" />
          <span class="nav-pill-label">History</span>
        </a>
        @* ENC-12 — encoder fault badge (encoder handoff §7.6 surface 1), reusing the pattern the
           bell fault badge established at §3.7 of HANDOFF-bell-failure-surfacing.md. It sits on the
           SETTINGS pill because that is where the explanation is, exactly as the bell badge sits on
           /phone for the same reason. Bottom-right, so it would clear a count badge if this pill ever
           gained one.
           Three states get three GLYPHS, not one glyph in two colours: Designer separates Degraded
           from a hard fault by colour alone, and colour alone fails WCAG 1.4.1 and this project's own
           §8.3 rule. EncoderNavLabel carries the state in text regardless.
           title stays the short static "Settings", matching every other pill: mirroring the dynamic
           aria-label would give the element an identical accessible name and description, which
           several screen readers announce twice. *@
        <a href="/system" class="nav-pill @(IsCurrentPage("/system") || IsCurrentPage("/diagnostics") ? "nav-active" : "")"
           title="Settings"
           aria-label="@EncoderNavLabel">
          <RadzenIcon Icon="settings" />
          <span class="nav-pill-label">Settings</span>
          @if (EncoderBadgeIcon.Length > 0)
          {
            <span class="@EncoderBadgeClass">
              <RadzenIcon Icon="@EncoderBadgeIcon" aria-hidden="true" />
            </span>
          }
        </a>
        @* Bell-failure handoff §3.7 — the fault badge is what makes a dead bell
           findable without being on /phone, which matters because the phone page is
           not where anyone is standing when a call comes in. The badge is a crossed-
           bell GLYPH, not a coloured dot, so the signal survives for a user who cannot
           distinguish red (§8.3); PhoneNavLabel carries the same fact in text.
           It is pinned bottom-right so it clears the unread .nav-badge, which in the
           TOPBAR is an ordinary in-flow flex item (only the RAIL variant is corner-
           pinned) — so the badge does not move. The pill is a wayfinding cue only; the
           full explanation lives on /phone.
           title stays the short static "Phone", matching every other pill in this row:
           mirroring the dynamic aria-label would give the element an identical
           accessible name and description, which several screen readers announce twice.
           §5.6 only ever specified the accessible NAME. *@
        <a href="/phone" class="nav-pill @(IsCurrentPage("/phone") ? "nav-active" : "")"
           title="Phone"
           aria-label="@PhoneNavLabel">
          <RadzenIcon Icon="phone" />
          <span class="nav-pill-label">Phone</span>
          @if (_phoneUnread > 0)
          {
            <span class="nav-badge" aria-hidden="true">@_phoneUnread</span>
          }
          @if (BellHealthRules.IsFaulted(_bellHealth))
          {
            <span class="phone-nav-fault">
              <RadzenIcon Icon="notifications_off" aria-hidden="true" />
            </span>
          }
        </a>
        @* The distortion-marker pill was DEBUG-gated in PR 2 and is now hosted
           inside the DevTray (PR 6 / §P2·2). Topbar stays clean — production
           and dev chrome are identical until the 3-tap gesture activates. *@
        @* ENC-23: a tap is today's Standby; a hold (600 ms, lift to commit) also powers the panel off. *@
        <SleepPill OnSleep="HandleSleepButtonAsync" OnDeepSleep="HandleDeepSleepButtonAsync" />
      </div>
    </div>

    <!-- Row 2: SourceBubble strip -->
    <div class="topbar-sources" role="tablist" aria-label="Audio source selection">
      @foreach (var source in _availableSources)
      {
        var isActive = source.Id == _selectedSourceId;
        var dataAttr = GetSourceDataAttr(source.Type);
        var accent = GetAccentVarForSource(source.Type);
        <SourceBubble Icon="@GetSourceIcon(source.Type)"
                      Label="@DisplayNames.Source(source)"
                      RawName="@(source.Name ?? source.Id)"
                      Sub="@GetSourceSubLabel(source)"
                      Accent="@accent"
                      IsActive="isActive"
                      IsDisabled="!IsSourceAvailable(source)"
                      HasDetail="@HasSourceDetail(source.Type)"
                      DataSourceAttr="@dataAttr"
                      OnSwitch="@(EventCallback.Factory.Create(this, () => HandleSourceToggleAsync(source)))"
                      OnOpenDetail="@(EventCallback.Factory.Create(this, () => HandleSourceDetailAsync(source)))" />
      }
    </div>
  </div>

  @* Main Content Area (height = viewport - topbar = 720 - var(--topbar-height)).
     The .has-dock modifier engages on every route except Home so .page-transition
     reserves the bottom 64px for <NowPlayingDock> and routed content never slides
     under it (handoff §P1·1). *@
  <div class="content-area @(IsDockVisible ? "has-dock" : "")">
    <div class="page-transition">
      @Body
    </div>
    @if (IsDockVisible)
    {
      <NowPlayingDock />
    }
  </div>

  @* Dev tray (handoff §P2·2, PR 6).
       - .dev-gesture-hit is an invisible slot left of the Home pill in .topbar-nav.
         dev-gesture.js counts taps on it and calls back into Blazor
         (ToggleDevTray) when it sees three within 1.5s.
       - <DevTray> stays mounted but renders closed (max-height: 0) until
         _isDevTrayOpen flips. Mounting unconditionally keeps the
         VisualizerTelemetryService subscription alive so the "Updates: NN/sec"
         card has fresh values the moment the tray slides open.
       - UI-25: it opens under the area that was pressed. dev-gesture.js passes the tap's x, the
         slot's top and bottom edges and the viewport size; DevTrayPlacement turns those into a
         clamped position.
       - Now that it floats mid-screen, a tap anywhere outside it closes it, through the same kind of
         transparent backdrop as the gain popover below, one tier under the tray. *@
  @if (_isDevTrayOpen)
  {
    <div class="dev-tray-backdrop" @onclick="CloseDevTrayAsync" aria-hidden="true"></div>
  }
  <DevTray IsOpen="@_isDevTrayOpen" Placement="@_devTrayPlacement" OnClose="@CloseDevTrayAsync"
           ApiDocsUrl="@_apiDocsUrl" />

  @* Task #15 PR E item #47 — gain-popover click-away backdrop.
       Mounted at the layout root (outside .page-transition) so the
       backdrop escapes the .page-transition stacking context trap that
       previously prevented its z-index: 9999 from rendering above the
       RadioControlPanel. NowPlayingPanel owns the popover itself; this
       element only catches the click-away dismiss. Visibility is driven
       by the scoped GainPopoverService — opening the popover in NowPlayingPanel
       calls GainPopover.Open(); the backdrop's @onclick → HandleBackdropClick
       fires the OnClose event so NowPlayingPanel can tear down its popover
       state in sync. *@
  @if (GainPopover.IsOpen)
  {
    <div class="np-gain-popover-backdrop"
         style="position: fixed; inset: 0; z-index: 9999;"
         @onclick="@(() => GainPopover.HandleBackdropClick())"></div>
  }

  @* ENC-4 — encoder HUD host for every normal route.
       Mounted at the layout root (outside .page-transition) for the same reason the gain backdrop
       is: .page-transition declares transform + will-change, which creates a stacking context that
       traps a descendant's z-index no matter how large it is. The HUD sits one tier above that
       backdrop (10000 vs 9999).
       The /sleep route is on EmptyLayout and is not in this tree, so it hosts its own copy. *@
  <EncoderHud />
</div>

@code {
  // Seeded with the default 24h, no-seconds form at field-init time so the topbar
  // renders something sensible before OnInitializedAsync runs. The real format
  // (honoring the user's Display:TimeFormat / Display:ShowSeconds settings) is
  // applied at the bottom of OnInitializedAsync and on every subsequent timer tick.
  private string _currentTime = DateTime.Now.ToString("HH:mm");
  private string _cpuUsage = "0";
  private string _ramUsage = "0";
  private string _threadCount = "0";
  private System.Timers.Timer? _timer;
  // Cached on every LocationChanged so the render condition is a cheap field
  // read instead of re-parsing the URI inside the template (handoff §P1·1).
  private bool _isOnHome = true;
  private List<AudioSourceDto> _availableSources = new();
  private List<AudioDeviceDto> _availableOutputs = new();
  private string? _selectedSourceId = null;
  private string? _selectedOutputId = null;
  // AUD-85 (re-review M-b). The active output as the server last reported it — every OutputChanged
  // broadcast (recorded even when it equals _selectedOutputId, which during a pick is only an
  // optimistic guess), and every output-switching call the API answered with success. Null until
  // the first such report. A failed pick restores the selection from this, not blindly from what
  // was selected before the pick: the API may have ended on Cast even though this circuit's request
  // failed (a client-side timeout while the API completed, or a 502 whose restore could not run).
  private string? _serverOutputId = null;
  // The saved default Cast device — what a one-tap Cast pick connects to. NOT a claim that it is
  // connected: since AUD-85 a failed pick keeps the default.
  private CastDeviceDto? _defaultCastDevice;
  // The Cast device this layout believes is connected, and what the Cast dropdown shows as such.
  // Set by a successful pick or dropdown selection, or when an OutputChanged broadcast reports
  // google-cast and a default is known; cleared on a failed pick that does not end on Cast, on Stop
  // Casting, and whenever the active output moves off Cast (AUD-85 review H1). Page load can only
  // clear it: it reads /api/devices/output/default, the device manager's default local output
  // device, which is never google-cast.
  private CastDeviceDto? _connectedCastDevice;
  private bool _isCastConnecting;
  private bool _showCastDropdown;
  private bool _showOutputDropdown;

  private int _queueCount = 0;
  private int _phoneUnread = 0;
  // Seeded Unknown so nothing alarms before the first status poll returns (§7m).
  private BellHealth _bellHealth = Radio.Web.Models.BellHealth.Unknown;
  private DotNetObjectReference<MainLayout>? _selfReference;
  // ENC-20. Gates OnEncoderHudActivity's interop: StateChanged is a process-wide singleton event and
  // can fire during prerender, before any JS exists to call. Set at the same point the layout's
  // other radioSleepManager interop happens, so "ready" means that object is actually there.
  private bool _sleepManagerReady;
  private DotNetObjectReference<MainLayout>? _devTrayRef;
  private IJSObjectReference? _devGestureModule;
  private bool _isDevTrayOpen;
  private DevTrayPlacement? _devTrayPlacement;

  // OPS-14: the API docs address shown (as text) in the DevTray — this machine's name and the API's port.
  private string? _apiDocsUrl;

  private AudioSourceDto? ActiveSource =>
    _availableSources.FirstOrDefault(s => s.Id == _selectedSourceId);
  private AudioDeviceDto? ActiveOutput =>
    _availableOutputs.FirstOrDefault(o => o.Id == _selectedOutputId);

  /// <summary>
  /// Live view of the configured raw-name → friendly-name alias map.
  /// Read on every render so <c>appsettings.json</c> hot-reloads via <c>IOptionsMonitor</c>
  /// propagate without a circuit restart.
  /// </summary>
  private IDictionary<string, string> DeviceAliases =>
    DevicesOptionsMonitor.CurrentValue.Aliases;

  protected override async Task OnInitializedAsync()
  {
    try
    {
      Logger.LogDebug("MainLayout.OnInitializedAsync - Starting initialization");

      _apiDocsUrl = DevTray.BuildApiDocsUrl(
        Configuration["ApiBaseUrl"] ?? WebConstants.DefaultApiBaseUrl, Environment.MachineName);

      // Load available sources and outputs concurrently
      await Task.WhenAll(LoadSourcesAsync(), LoadOutputDevicesAsync());

      // Start the SignalR hub connection (subscribes to RadioState/Queue groups)
      await HubService.StartAsync();

      // Subscribe to audio state updates
      HubService.PlaybackStateChanged += OnPlaybackStateChanged;
      HubService.NowPlayingChanged += OnNowPlayingChanged;
      HubService.QueueChanged += OnQueueChanged;
      HubService.SourceChanged += OnSourceChanged;
      HubService.OutputChanged += OnOutputChanged;
      HubService.SleepStateChanged += OnSleepStateChanged;
      HubService.VolumeChanged += OnVolumeChanged;
      DeviceDisplayState.DisplaySettingsChanged += OnDeviceDisplaySettingsChanged;

      // ENC-4a: seed the mute chip. VolumeChanged only fires on a CHANGE, so without this the
      // chip would stay hidden on a page that loads while already muted — which is precisely the
      // case it exists for (walk up to a quiet console and ask why).
      await LoadMuteStateAsync();

      // Task #15 PR E item #47 — re-render when the gain popover service
      // toggles so the layout-mounted backdrop mounts/unmounts in lock-step
      // with NowPlayingPanel's popover open/close. Subscription is paired
      // with the unsubscribe in Dispose().
      GainPopover.StateChanged += OnGainPopoverStateChanged;

      // GV Messages: mirror the shared UI-local unread count onto the topbar
      // /phone pill badge (PhonePage owns the count; we only read + subscribe).
      _phoneUnread = PhoneUnread.Count;
      PhoneUnread.Changed += OnPhoneUnreadChanged;

      // Bell-failure handoff §3.7 — seed + subscribe to the app-wide bell health so
      // the /phone pill can show a fault from any route. Unlike PhoneUnread (which
      // PhonePage publishes), BellHealthService polls on its own, so the badge does
      // not require the user to have already visited the page it points at.
      _bellHealth = BellHealth.Health;
      BellHealth.HealthChanged += OnBellHealthChanged;

      // ENC-12 — subscribe first, then seed the encoder fault badge from the API.
      //
      // The seed is an authoritative PULL, following the same precedent as LoadMuteStateAsync above,
      // which reads AudioApi.GetVolumeAsync() rather than any cached broadcast. The change-only
      // EncoderConfigStatusChanged / EncoderConnectionChanged broadcasts subscribed here are what
      // keep it current afterwards; AudioStateStore's cache of those broadcasts is the FALLBACK for
      // when the API cannot be reached, not the primary.
      //
      // Seeding from that cache alone was wrong on exactly the boot the badge exists for: a deploy
      // restarts radio-api and radio-web together, so the API's boot config push can fire while
      // AudioStateHubService.StartAsync is still in its retry loop. That broadcast reaches nobody,
      // the cache stays null, and the badge never appears for the life of the process.
      //
      // Order: the subscriptions go on BEFORE the await so a broadcast arriving while the pull is in
      // flight is not dropped, and SeedEncoderStateAsync yields to it rather than overwriting it with
      // an older response.
      AudioState.EncoderConfigStatusChanged += OnEncoderConfigStatusChangedAsync;
      AudioState.EncoderConnectionChanged += OnEncoderConnectionChangedAsync;

      // ADR-029 PR 6 — the chip. ConsolePlaybackState subscribes to the STORE itself; this subscribes
      // to IT, so the store's own event keeps exactly one handler no matter how many circuits are
      // open (plan §0.6).
      ConsolePlayback.Changed += OnConsolePlaybackChangedAsync;
      await SeedEncoderStateAsync();

      // ENC-20 — a knob turn has to wake the dimmed screen.
      //
      // idle-dimmer.js drops the panel to brightness(0.3) after five idle minutes and undims on
      // pointerdown / keydown / wheel / pointermove. Encoder input produces NONE of those: it
      // arrives as a SignalR push from the API, so before this the knobs acted on a screen that
      // stayed dim and, worse, never reset dimTimer or sleepTimer — turning the volume up for five
      // minutes still put the console to sleep on schedule.
      //
      // ⚠ This is NOT ENC-6's /sleep wake and must not be folded into it. ENC-6 owns the 30-minute
      // sleep route, where Rule 1 deliberately CONSUMES the first input to light a dark panel. This
      // is the 5-minute dim, where the input is not consumed at all — the knob has already acted,
      // in the API, before the HUD event that triggers this was ever published.
      //
      // The two stay separate BY CONSTRUCTION rather than by a runtime check: Sleep.razor declares
      // `@layout Radio.Web.Components.Layout.EmptyLayout`, so MainLayout is not mounted on /sleep
      // and this handler cannot run there to be wrong. (radioSleepManager.wake early-returns on
      // that route as well, but that is a second belt, not the reason.)
      EncoderHud.StateChanged += OnEncoderHudActivity;

      // ENC-12 — a circuit that opens onto a fault that is already live must still speak once.
      // Together with the pull above this is the COMMON case rather than an edge one: the fault
      // happens during boot, before any browser exists, so without this nothing is ever said about
      // it.
      //
      // This does not breach the silent-boot rule (handoff §7.4), because the decision is not taken
      // here — EncoderAnnouncer's own latch takes it, and it returns null for Configured, Transient,
      // Unknown and for a device that was already absent at boot (wasEverConnected == false). A
      // healthy console still says nothing at all. A RELOAD facing a live fault does re-announce,
      // and that is intended: the announcer is scoped, so a reload is a new session (Test Plan T7).
      AnnounceEncoderStateIfNeeded();

      // Dock visibility is route-dependent (handoff §P1·1: dock only on
      // non-Home routes). Seed from the current URI and update on every nav.
      _isOnHome = IsCurrentlyOnHome();
      NavigationManager.LocationChanged += OnLocationChanged;
      Logger.LogDebug("MainLayout - Subscribed to audio state events");

      // Load initial state
      await RefreshQueueCountAsync();

      // Update time immediately. Routed through Clocks.FormatWallClock so the
      // user's saved Display:TimeFormat / Display:ShowSeconds preferences are
      // honored from first paint — not just on the next timer tick.
      _currentTime = Clocks.FormatWallClock(DateTime.Now, DisplayOptionsMonitor.CurrentValue);
      Logger.LogDebug("MainLayout - Initial time set to {Time}", _currentTime);

      // Start the clock timer using System.Timers.Timer (works reliably in Blazor Server)
      _timer = new System.Timers.Timer(1000);
      _timer.Elapsed += OnTimerElapsed;
      _timer.AutoReset = true;
      _timer.Start();
      Logger.LogDebug("MainLayout - Timer started, initialization complete");
    }
    catch (Exception ex)
    {
      Logger.LogError(ex, "CRITICAL: Exception in MainLayout.OnInitializedAsync - this will crash the Blazor circuit!");
      throw;
    }
  }

  protected override async Task OnAfterRenderAsync(bool firstRender)
  {
    if (firstRender)
    {
      // Set API base URL for idle-dimmer.js (still used by other JS callers)
      var apiBaseUrl = Configuration["ApiBaseUrl"] ?? WebConstants.DefaultApiBaseUrl;
      await JSRuntime.InvokeVoidAsync("radioSetApiBaseUrl", apiBaseUrl);

      // Register .NET reference so JS sleep/wake can call back into Blazor
      _selfReference = DotNetObjectReference.Create(this);
      await JSRuntime.InvokeVoidAsync("radioSleepManager.setBlazorRef", _selfReference);

      // ENC-20. Only now is radioSleepManager known to be reachable — this line is deliberately
      // after the call above rather than at the top of the firstRender block, so a failed interop
      // leaves the flag false instead of licensing a call that would throw.
      _sleepManagerReady = true;

      // Wire the dev-tray triple-tap gesture (handoff §P2·2, PR 6). The JS
      // module listens on the invisible .dev-gesture-hit element and calls
      // ToggleDevTray when it detects 3 taps within 1.5s.
      try
      {
        _devTrayRef = DotNetObjectReference.Create(this);
        _devGestureModule = await JSRuntime.InvokeAsync<IJSObjectReference>(
          "import", "./js/dev-gesture.js");
        await _devGestureModule.InvokeVoidAsync("init", _devTrayRef);
      }
      catch (Exception ex)
      {
        // Module import failure is non-fatal — the layout still works without
        // the gesture; the dev tray simply stays unreachable in that build.
        Logger.LogWarning(ex, "Failed to initialize dev-gesture JS module");
      }

      // ENC-6. MainLayout rendering is proof the sleep screen is not up, which is what corrects a
      // stale flag left behind when a hard navigation killed Sleep.razor's circuit before its
      // dispose could report. Fire-and-forget on purpose: the layout must render whether or not the
      // API is reachable.
      _ = SystemApi.SetSleepScreenVisibleAsync(false);
    }
  }

  /// <summary>
  /// Called from JS (dev-gesture.js) when the user triple-taps the invisible
  /// hit area left of the Home pill within 1.5s. Toggles the DevTray open/closed.
  /// UI-25: the arguments are the third tap's x, the pressed slot's top and bottom edges, and the
  /// viewport size, in CSS pixels; opening places the tray under the slot at the tap's x. Closing
  /// leaves the last placement alone — the closed tray is invisible wherever it sits.
  /// </summary>
  [JSInvokable]
  public Task ToggleDevTray(
    double tapX, double pressedTop, double pressedBottom, double viewportWidth, double viewportHeight)
  {
    return InvokeAsync(() =>
    {
      _isDevTrayOpen = !_isDevTrayOpen;
      if (_isDevTrayOpen)
      {
        _devTrayPlacement = DevTrayPlacement.ForPress(
          tapX, pressedTop, pressedBottom, viewportWidth, viewportHeight);
      }
      StateHasChanged();
    });
  }

  /// <summary>
  /// Closes the dev tray. Fires from the × button and from the tray's
  /// 30-second auto-lock timer.
  /// </summary>
  private Task CloseDevTrayAsync()
  {
    return InvokeAsync(() =>
    {
      _isDevTrayOpen = false;
      StateHasChanged();
    });
  }

  /// <summary>
  /// Called from JS (idle-dimmer.js) when user interaction triggers sleep or wake.
  /// Routes through Blazor server-side HttpClient to avoid browser CORS issues.
  /// </summary>
  /// <remarks>
  /// ⚠ <b>UNREACHABLE TODAY, and worth knowing before counting it as an entry point into sleep.</b>
  /// Its only JS caller is <c>idle-dimmer.js</c>'s <c>enterSleep()</c>, which has zero callers in the
  /// tracked tree — the Sleep pill and the server push both use
  /// <c>NavigationManager.NavigateTo("/sleep")</c> directly, and the idle timer deliberately calls
  /// nothing server-side. ADR-029 §7.5 counted this path as live, built a stop condition on it, and
  /// the condition never fired for the case it was written about (§16.4). Kept because it is the
  /// seam a future JS-driven sleep would use; do not treat it as a route that runs.
  /// </remarks>
  [JSInvokable]
  public async Task OnJsSleepRequested(bool sleep)
  {
    try
    {
      await SystemApi.SetSleepAsync(sleep);
    }
    catch (Exception ex)
    {
      Logger.LogWarning(ex, "Error setting sleep state to {Sleep} from JS callback", sleep);
    }
  }

  private void OnTimerElapsed(object? sender, System.Timers.ElapsedEventArgs e)
  {
    // Read DisplayOptionsMonitor.CurrentValue on every tick so saves from the
    // System Configuration page repaint the topbar Time cluster within 1 s of
    // the SQLite-bridge change-token fire — no extra OnChange subscription
    // required, no circuit restart.
    _currentTime = Clocks.FormatWallClock(DateTime.Now, DisplayOptionsMonitor.CurrentValue);

    try
    {
      // Invoke state update on the UI thread - use fire-and-forget with error handling
      _ = SafeInvokeAsync();
    }
    catch (ObjectDisposedException)
    {
      // Component was disposed, stop the timer
      _timer?.Stop();
    }
  }

  private async Task SafeInvokeAsync()
  {
    try
    {
      await InvokeAsync(async () =>
      {
        StateHasChanged();
        await UpdateSystemStatsAsync();
      });
    }
    catch (ObjectDisposedException)
    {
      _timer?.Stop();
    }
    catch (Exception ex)
    {
      Logger.LogWarning(ex, "Error in timer update");
    }
  }

  private async Task LoadSourcesAsync()
  {
    try
    {
      Logger.LogDebug("Loading audio sources...");
      var sources = await SourcesApi.GetSourcesAsync();

      if (sources != null && sources.Count > 0)
      {
        Logger.LogDebug("Loaded {Count} audio sources: {Sources}",
          sources.Count, string.Join(", ", sources.Select(s => s.Name)));
        _availableSources = sources;

        // Try to get primary source, but don't fail if not available
        try
        {
          var primary = await SourcesApi.GetPrimarySourceAsync();
          if (primary != null)
          {
            // Match by type since the API returns UUID-based IDs that don't match
            // the dropdown items which use sourceType.ToLowerInvariant() as IDs
            var matchingSource = _availableSources.FirstOrDefault(s =>
              s.Type.Equals(primary.Type, StringComparison.OrdinalIgnoreCase));
            if (matchingSource != null)
            {
              _selectedSourceId = matchingSource.Id;

            }
            else
            {
              _selectedSourceId = primary.Type.ToLowerInvariant();
            }
            return;
          }
        }
        catch (Exception ex)
        {
          Logger.LogDebug(ex, "No primary source active (expected when no source is playing)");
        }

        // No primary source active - auto-select Radio as the default source
        Logger.LogDebug("No active primary source, auto-selecting Radio as default");
        var radioSource = sources.FirstOrDefault(s => s.Type.Equals("Radio", StringComparison.OrdinalIgnoreCase));
        if (radioSource != null)
        {
          var success = await SourcesApi.SwitchSourceAsync(radioSource.Type);
          if (success)
          {
            _selectedSourceId = radioSource.Id;
            Logger.LogDebug("Auto-selected Radio source: {SourceType}", radioSource.Type);
            return;
          }
          Logger.LogWarning("Failed to auto-select Radio source");
        }

        // Fallback to first source if Radio not available
        if (sources.Count > 0)
        {
          _selectedSourceId = sources[0].Id;
        }
      }
      else
      {
        Logger.LogWarning("No audio sources returned from API");
      }
    }
    catch (Exception ex)
    {
      Logger.LogError(ex, "Failed to load audio sources");
    }
  }

  private async Task LoadOutputDevicesAsync()
  {
    try
    {
      Logger.LogDebug("Loading audio output devices...");
      var outputsTask = DevicesApi.GetOutputDevicesAsync();
      var defaultCastTask = DevicesApi.GetDefaultCastDeviceAsync();
      var displayTask = DevicesApi.GetDeviceDisplaySettingsAsync();
      await Task.WhenAll(outputsTask, defaultCastTask, displayTask);

      var outputs = await outputsTask;
      _defaultCastDevice = await defaultCastTask;
      var displaySettings = await displayTask;

      if (outputs != null && outputs.Count > 0)
      {
        // Filter out hidden devices using display settings
        if (displaySettings != null)
        {
          var hiddenNames = displaySettings
            .Where(d => d.IsHidden)
            .Select(d => d.RawName)
            .ToHashSet(StringComparer.OrdinalIgnoreCase);
          outputs = outputs.Where(o => !hiddenNames.Contains(o.Name)).ToList();

          // Apply friendly names from display settings
          foreach (var output in outputs)
          {
            var display = displaySettings.FirstOrDefault(d =>
              d.RawName.Equals(output.Name, StringComparison.OrdinalIgnoreCase));
            if (display?.FriendlyNameOverride != null)
              output.Name = display.FriendlyNameOverride;
          }
        }

        Logger.LogDebug("Loaded {Count} visible output devices: {Devices}",
          outputs.Count, string.Join(", ", outputs.Select(d => d.Name)));
        _availableOutputs = outputs;
        UpdateCastOutputDisplayName();

        // AUD-97: the output in use is the one the list marks active. /output/default answers the
        // box's hardware default sink (the Soundbar) whatever is playing, so after a restart with Cast
        // restored the panel showed the Soundbar while Cast played. This reads the visible list, so an
        // active device the owner has hidden falls through to the old lookup below, as before.
        var active = outputs.FirstOrDefault(o => o.IsActive);
        if (active != null)
        {
          _selectedOutputId = active.Id;
          SyncConnectedCastDeviceToOutput();
          return;
        }

        // No output reports itself active (e.g. the API is still starting): fall back to the default.
        try
        {
          var current = await DevicesApi.GetCurrentOutputDeviceAsync();
          if (current != null)
          {
            _selectedOutputId = current.Id;
            SyncConnectedCastDeviceToOutput();
            return;
          }
        }
        catch (Exception ex)
        {
          Logger.LogDebug(ex, "No current output device set");
        }

        // Default to first (usually the default device)
        var defaultDevice = outputs.FirstOrDefault(d => d.IsDefault) ?? outputs[0];
        _selectedOutputId = defaultDevice.Id;
        SyncConnectedCastDeviceToOutput();
      }
      else
      {
        Logger.LogWarning("No output devices returned from API");
      }
    }
    catch (Exception ex)
    {
      Logger.LogError(ex, "Failed to load output devices");
    }
  }

  private void UpdateCastOutputDisplayName()
  {
    var castOutput = _availableOutputs.FirstOrDefault(o =>
      o.Id.Equals("google-cast", StringComparison.OrdinalIgnoreCase));
    if (castOutput == null) return;

    castOutput.Name = _defaultCastDevice != null
      ? _defaultCastDevice.Name
      : "Google Cast";
  }

  /// <summary>
  /// AUD-85 review H1. Keeps <see cref="_connectedCastDevice"/> in line with the active output:
  /// off Cast, nothing is connected; on Cast, the device already recorded as connected stands,
  /// or else the saved default (the device the API connects to when it restores Cast).
  /// Called after <see cref="_selectedOutputId"/> changes: from an OutputChanged broadcast and from
  /// this layout's own output switches, from page load (which, since AUD-97, reads the active output
  /// and so can set it when Cast was restored before the page loaded), and after a failed pick — never
  /// before a pick's connect returns.
  /// </summary>
  private void SyncConnectedCastDeviceToOutput()
  {
    if (string.Equals(_selectedOutputId, "google-cast", StringComparison.OrdinalIgnoreCase))
    {
      _connectedCastDevice ??= _defaultCastDevice;
    }
    else
    {
      _connectedCastDevice = null;
    }
  }

  private async Task HandleSourceChangeAsync(string newSourceId)
  {
    if (string.IsNullOrEmpty(newSourceId) || newSourceId == _selectedSourceId) return;

    try
    {
      var source = _availableSources.FirstOrDefault(s => s.Id == newSourceId);
      if (source == null) return;

      var success = await SourcesApi.SwitchSourceAsync(source.Type);
      if (success)
      {
        _selectedSourceId = newSourceId;
        Logger.LogInformation("Switched to source: {SourceType}", source.Type);

        // Immediately notify NowPlayingPanel of the source change so it refreshes
        // without waiting for the 500ms AudioStateUpdateService polling cycle.
        await HubService.NotifySourceChangedAsync();
      }
    }
    catch (Exception ex)
    {
      Logger.LogError(ex, "Failed to switch audio source");
    }
  }

  private async Task HandleOutputChangeAsync(string newOutputId)
  {
    if (string.IsNullOrEmpty(newOutputId)) return;

    if (newOutputId == "google-cast")
    {
      // Cast pill closes the sibling Output picker so the two popovers never
      // overlap (the two are mutually exclusive — see ToggleOutputPicker).
      if (_showOutputDropdown)
      {
        _showOutputDropdown = false;
      }

      // Cast already active → toggle dropdown for device switching
      if (newOutputId == _selectedOutputId)
      {
        _showCastDropdown = !_showCastDropdown;
        return;
      }

      // First click on Cast with a saved default → auto-connect (no dropdown)
      if (_defaultCastDevice != null)
      {
        await AutoConnectCastDeviceAsync(newOutputId);
        return;
      }

      // First click on Cast with no default → open dropdown for device selection
      _selectedOutputId = newOutputId;
      _showCastDropdown = true;
      return;
    }

    if (newOutputId == _selectedOutputId) return;

    // Switching away from Cast → close dropdown if open
    if (_showCastDropdown)
      _showCastDropdown = false;

    try
    {
      var success = await DevicesApi.SetOutputDeviceAsync(newOutputId);
      if (success)
      {
        _selectedOutputId = newOutputId;
        _serverOutputId = newOutputId;
        SyncConnectedCastDeviceToOutput();
        Logger.LogInformation("Switched audio output to: {OutputId}", newOutputId);
      }
    }
    catch (Exception ex)
    {
      Logger.LogError(ex, "Failed to switch audio output");
    }
  }

  /// <summary>
  /// Toggles the output-picker popover. The two topbar popovers (Cast and Output)
  /// are mutually exclusive — opening Output closes Cast and vice versa — so the
  /// user can't end up with overlapping menus.
  /// </summary>
  private void ToggleOutputPicker()
  {
    _showOutputDropdown = !_showOutputDropdown;
    if (_showOutputDropdown && _showCastDropdown)
    {
      _showCastDropdown = false;
    }
    StateHasChanged();
  }

  /// <summary>
  /// Output-picker selection handler. Calls the same API endpoint that the
  /// legacy <c>/devices</c> page already uses; the server side
  /// (<c>DevicesController.SetOutputDevice</c>) handles the mutual-exclusivity
  /// invariant — tearing down the Cast + HTTP outputs and un-muting local
  /// speakers when a local device is selected — so no extra Cast disconnect
  /// dispatch is needed here.
  /// </summary>
  private async Task OnLocalOutputSelectedAsync(AudioDeviceDto device)
  {
    if (device is null || string.IsNullOrEmpty(device.Id))
    {
      return;
    }
    if (device.Id == _selectedOutputId)
    {
      return;
    }

    try
    {
      var success = await DevicesApi.SetOutputDeviceAsync(device.Id);
      if (success)
      {
        _selectedOutputId = device.Id;
        _serverOutputId = device.Id;
        SyncConnectedCastDeviceToOutput();
        Logger.LogInformation("Switched audio output via picker to: {Name} ({Id})", device.Name, device.Id);
      }
      else
      {
        Logger.LogWarning("DevicesApi.SetOutputDeviceAsync returned false for {Id}", device.Id);
      }
    }
    catch (Exception ex)
    {
      Logger.LogError(ex, "Failed to switch audio output via picker to {Id}", device.Id);
    }
  }

  private async Task AutoConnectCastDeviceAsync(string outputId)
  {
    var previousOutputId = _selectedOutputId;
    var device = _defaultCastDevice!;
    _isCastConnecting = true;
    _selectedOutputId = outputId;
    StateHasChanged();

    try
    {
      // AUD-85: one request only. The connect endpoint itself promotes Cast through the
      // output gate, so there is no preceding SetOutputDeviceAsync("google-cast") — that
      // would start the API's own auto-connect and race this one.
      var outcome = await CastDefaultPick.ConnectAsync(DevicesApi, device, Logger);

      if (outcome == CastDefaultPickOutcome.Connected)
      {
        _connectedCastDevice = device;
        _serverOutputId = outputId;
      }
      else
      {
        // AUD-85: a failed request is not evidence the device is gone, so the saved
        // default is kept — but this request connected nothing, so the dropdown must not say
        // it did (review H1). The output selection goes back to what the server last reported
        // (re-review M-b) — which may be Cast, if the API completed after this request gave up
        // or its restore could not run — and otherwise to what it was before the pick, so the
        // next tap on the Cast pill retries this one-tap connect instead of only toggling the
        // dropdown. The dropdown opens so the user can pick a device, as the no-default path does.
        _connectedCastDevice = null;
        _selectedOutputId = _serverOutputId ?? previousOutputId;
        SyncConnectedCastDeviceToOutput();
        _showCastDropdown = true;
      }
    }
    finally
    {
      _isCastConnecting = false;
      StateHasChanged();
    }
  }

