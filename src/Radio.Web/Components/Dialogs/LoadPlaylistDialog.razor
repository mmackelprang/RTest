@inject PlaylistApiService PlaylistApi
@inject DialogService DialogService
@inject NotificationService NotificationService
@inject ILogger<LoadPlaylistDialog> Logger

@if (_loading)
{
  <div style="display: flex; justify-content: center; padding: 32px;">
    <RadzenProgressBarCircular Size="ProgressBarCircularSize.Small" Mode="ProgressBarMode.Indeterminate" />
  </div>
}
else if (_playlists == null || _playlists.Count == 0)
{
  <div style="text-align: center; padding: 32px;">
    <RadzenIcon Icon="playlist_remove" Style="font-size: 64px; opacity: 0.5;" />
    <div style="margin-top: 16px;">
      <span>No saved playlists</span>
    </div>
    <div>
      <span style="font-size:0.875rem">
        Save the current queue as a playlist first
      </span>
    </div>
  </div>
}
else
{
  <div class="playlist-list">
    @foreach (var playlist in _playlists)
    {
      <div class="playlist-item" style="min-height: 64px; display: flex; justify-content: space-between; align-items: center; width: 100%; padding: 8px 0;">
        <div style="flex: 1;">
          <span style="font-weight: 500;">@playlist.Name</span>
          <br />
          <span style="font-size:0.75rem; color:var(--text-low)">
            @playlist.ItemCount tracks
            @if (!string.IsNullOrEmpty(playlist.Description))
            {
              @($" - {playlist.Description}")
            }
          </span>
        </div>
        <div style="display: flex; gap: 8px;">
          <RadzenButton Variant="Variant.Filled"
                        ButtonStyle="ButtonStyle.Primary"
                        Size="ButtonSize.Small"
                        Click="@(() => LoadPlaylistAsync(playlist))"
                        Disabled="@_actionInProgress"
                        Text="Load" />
          <RadzenButton Icon="delete"
                        ButtonStyle="ButtonStyle.Danger"
                        Variant="Variant.Text"
                        Size="ButtonSize.Small"
                        Click="@(() => DeletePlaylistAsync(playlist))"
                        Disabled="@_actionInProgress"
                        title="Delete" />
        </div>
      </div>
      <hr style="border-color:var(--surface-separator); margin:0" />
    }
  </div>
}

<div style="display: flex; justify-content: flex-end; padding-top: 16px;">
  <RadzenButton Variant="Variant.Text"
                ButtonStyle="ButtonStyle.Light"
                Click="Cancel"
                Text="Close" />
</div>

@code {
  private List<Radio.Web.Models.PlaylistSummaryDto>? _playlists;
  private bool _loading = true;
  private bool _actionInProgress = false;

  protected override async Task OnInitializedAsync()
  {
    await LoadPlaylistsAsync();
  }

  private async Task LoadPlaylistsAsync()
  {
    _loading = true;
    try
    {
      _playlists = await PlaylistApi.GetAllAsync();
    }
    catch (Exception ex)
    {
      Logger.LogError(ex, "Failed to load playlists");
    }
    finally
    {
      _loading = false;
    }
  }

  private void Cancel() => DialogService.Close();

  private async Task LoadPlaylistAsync(Radio.Web.Models.PlaylistSummaryDto playlist)
  {
    _actionInProgress = true;
    Logger.LogInformation("LoadPlaylistAsync called for: {Name} (Id: {Id})", playlist.Name, playlist.Id);
    try
    {
      using var cts = new CancellationTokenSource(TimeSpan.FromSeconds(10));
      Logger.LogInformation("Calling PlaylistApi.LoadAsync...");
      var success = await PlaylistApi.LoadAsync(playlist.Id, cts.Token);
      Logger.LogInformation("PlaylistApi.LoadAsync returned: {Success}", success);
      if (success)
      {
        NotificationService.Notify(NotificationSeverity.Success, "Success", $"Loaded '{playlist.Name}' ({playlist.ItemCount} tracks)");
        DialogService.Close(playlist);
      }
      else
      {
        NotificationService.Notify(NotificationSeverity.Error, "Error", "Failed to load playlist");
      }
    }
    catch (OperationCanceledException)
    {
      Logger.LogError("Timeout loading playlist {Id}", playlist.Id);
      NotificationService.Notify(NotificationSeverity.Error, "Error", "Timed out loading playlist — is the API running?");
    }
    catch (Exception ex)
    {
      Logger.LogError(ex, "Failed to load playlist {Id}", playlist.Id);
      NotificationService.Notify(NotificationSeverity.Error, "Error", "Error loading playlist");
    }
    finally
    {
      _actionInProgress = false;
    }
  }

  private async Task DeletePlaylistAsync(Radio.Web.Models.PlaylistSummaryDto playlist)
  {
    _actionInProgress = true;
    try
    {
      var success = await PlaylistApi.DeleteAsync(playlist.Id);
      if (success)
      {
        NotificationService.Notify(NotificationSeverity.Info, "Info", $"Deleted '{playlist.Name}'");
        _playlists?.Remove(playlist);
      }
      else
      {
        NotificationService.Notify(NotificationSeverity.Error, "Error", "Failed to delete playlist");
      }
    }
    catch (Exception ex)
    {
      Logger.LogError(ex, "Failed to delete playlist {Id}", playlist.Id);
      NotificationService.Notify(NotificationSeverity.Error, "Error", "Error deleting playlist");
    }
    finally
    {
      _actionInProgress = false;
    }
  }
}
