@using Radzen
@using Radzen.Blazor
@using System.Text.Json
@using Radio.Web.Services.ApiClients
@inject FileApiService FileApi
@inject ConfigurationApiService ConfigApi
@inject DialogService DialogService
@inject ILogger<FileBrowserDialog> Logger

<div style="display: flex; flex-direction: column; max-height: 480px; min-height: 320px;">
  <!-- Breadcrumbs + Location/Path bar + Search/Filter toolbar -->
  <div class="file-browser-toolbar">
    <!-- Location button (drive/mount picker) -->
    <div style="position: relative; flex-shrink: 0;">
      <RadzenButton Icon="folder_open" Size="ButtonSize.Small"
                    ButtonStyle="@(_isAbsoluteMode ? ButtonStyle.Warning : ButtonStyle.Light)"
                    Variant="Variant.Text"
                    Click="@ToggleLocationDropdown"
                    title="Browse location" />
      @if (_showLocationDropdown)
      {
        <div class="file-browser-location-overlay" @onclick="CloseLocationDropdown"></div>
        <div class="file-browser-location-dropdown" @onclick:stopPropagation="true">
          @* Bookmarked folders — highlighted at top *@
          @if (_bookmarks.Any())
          {
            @foreach (var bookmark in _bookmarks)
            {
              var isActive = _isAbsoluteMode && (_absolutePath == bookmark.Path ||
                _absolutePath?.StartsWith(bookmark.Path.TrimEnd('/') + "/", StringComparison.OrdinalIgnoreCase) == true);
              <div class="file-browser-location-item @(bookmark.IsAccessible ? "" : "file-browser-location-disabled")"
                   @onclick="@(() => NavigateToBookmark(bookmark))"
                   style="@(bookmark.IsAccessible ? "" : "opacity: 0.45; pointer-events: none;")">
                <RadzenIcon Icon="star" Style="font-size: 20px; color: var(--rz-warning);" />
                <div style="flex: 1; min-width: 0;">
                  <span style="font-weight: 500; color: var(--rz-warning);">@bookmark.Label</span>
                  <div style="font-size: 11px; color: var(--text-low); overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">
                    @bookmark.Path
                  </div>
                </div>
                @if (isActive)
                {
                  <RadzenIcon Icon="check" Style="font-size: 20px; flex-shrink: 0; color: var(--rz-primary);" />
                }
                @if (!bookmark.IsAccessible)
                {
                  <RadzenIcon Icon="cloud_off" Style="font-size: 20px; flex-shrink: 0; color: var(--text-low);" title="Not accessible" />
                }
              </div>
            }
            <div style="border-top: 1px solid var(--border-subtle); margin: 4px 0;"></div>
          }
          @* Media Library *@
          <div class="file-browser-location-item" @onclick="ReturnToMediaLibrary">
            <RadzenIcon Icon="library_music" Style="font-size: 20px; color: var(--rz-primary);" />
            <span>Media Library</span>
            @if (!_isAbsoluteMode)
            {
              <RadzenIcon Icon="check" Style="font-size: 20px; margin-left: auto; color: var(--rz-primary);" />
            }
          </div>
          @if (_drives.Any())
          {
            <div style="border-top: 1px solid var(--border-subtle); margin: 4px 0;"></div>
            @foreach (var drive in _drives.Where(d => d.IsReady))
            {
              <div class="file-browser-location-item" @onclick="@(() => NavigateToDrive(drive.Name))">
                <RadzenIcon Icon="storage" Style="font-size: 20px;" />
                <span>@drive.Label</span>
                @if (_isAbsoluteMode && _absolutePath?.StartsWith(drive.Name) == true)
                {
                  <RadzenIcon Icon="check" Style="font-size: 20px; margin-left: auto; color: var(--rz-primary);" />
                }
              </div>
            }
          }
        </div>
      }
    </div>

    <!-- Breadcrumbs / Path bar -->
    <div class="file-browser-breadcrumbs">
      @if (_isEditingPath)
      {
        <div style="display: flex; align-items: center; flex: 1; gap: 4px;">
          <RadzenTextBox @ref="_pathTextField" @bind-Value="_pathBarText" Placeholder="Enter absolute path..."
                         @onkeydown="OnPathBarKeyDown"
                         Style="flex: 1; font-size: 13px;" />
          <RadzenButton Icon="keyboard_return" Size="ButtonSize.Small"
                        Variant="Variant.Text" ButtonStyle="ButtonStyle.Primary"
                        Click="@NavigateToPathBarAsync" title="Go" />
        </div>
      }
      else if (_isAbsoluteMode && !string.IsNullOrEmpty(_absolutePath))
      {
        @* Absolute mode breadcrumbs *@
        <RadzenButton Variant="Variant.Text" ButtonStyle="ButtonStyle.Primary" Size="ButtonSize.Small"
                      Click="@(() => NavigateToAbsoluteAsync(_driveRoot ?? "/"))">
          <ChildContent>
            <RadzenIcon Icon="storage" Style="font-size: 18px; margin-right: 4px; vertical-align: middle;" />
            @(_driveRoot ?? "/")
          </ChildContent>
        </RadzenButton>
        @foreach (var seg in GetAbsoluteSegmentsWithPaths())
        {
          <RadzenIcon Icon="chevron_right" Style="font-size: 20px; color: var(--text-low); flex-shrink: 0;" />
          <RadzenButton Variant="Variant.Text"
                        ButtonStyle="@(seg.IsLast ? ButtonStyle.Light : ButtonStyle.Primary)"
                        Size="ButtonSize.Small"
                        Disabled="@seg.IsLast"
                        Click="@(() => NavigateToAbsoluteAsync(seg.FullPath))">
            @seg.Name
          </RadzenButton>
        }
      }
      else
      {
        @* Relative mode breadcrumbs (existing) *@
        <RadzenButton Variant="Variant.Text" ButtonStyle="ButtonStyle.Primary" Size="ButtonSize.Small"
                      Click="@(() => NavigateToPathAsync(null))"
                      Disabled="@(string.IsNullOrEmpty(_relativePath))">
          <ChildContent>
            <RadzenIcon Icon="home" Style="font-size: 18px; margin-right: 4px; vertical-align: middle;" />
            Home
          </ChildContent>
        </RadzenButton>
        @if (!string.IsNullOrEmpty(_relativePath))
        {
          var pathParts = _relativePath.Split('/').Where(p => !string.IsNullOrEmpty(p)).ToArray();
          for (int i = 0; i < pathParts.Length; i++)
          {
            var index = i;
            var partialRelative = string.Join("/", pathParts.Take(index + 1));
            <RadzenIcon Icon="chevron_right" Style="font-size: 20px; color: var(--text-low); flex-shrink: 0;" />
            <RadzenButton Variant="Variant.Text"
                          ButtonStyle="@(i == pathParts.Length - 1 ? ButtonStyle.Light : ButtonStyle.Primary)"
                          Size="ButtonSize.Small"
                          Disabled="@(i == pathParts.Length - 1)"
                          Click="@(() => NavigateToRelativeAsync(partialRelative))">
              @pathParts[index]
            </RadzenButton>
          }
        }
      }
    </div>

    <!-- Path edit toggle + Search/Filter chips -->
    <div style="display: flex; gap: 8px; align-items: center; flex-shrink: 0;">
      <RadzenButton Icon="@(_isEditingPath ? "close" : "edit")"
                    Size="ButtonSize.Small" ButtonStyle="ButtonStyle.Light"
                    Variant="Variant.Text"
                    Click="@TogglePathEditing"
                    title="@(_isEditingPath ? "Cancel path editing" : "Edit path")" />
      <div style="display: flex; align-items: center; gap: 4px; max-width: 200px;">
        <RadzenIcon Icon="search" Style="font-size: 18px; color: var(--text-low);" />
        <RadzenTextBox @bind-Value="_searchText" Placeholder="Search..."
                       Style="font-size: 13px; width: 100%;"
                       Change="@OnSearchChanged" />
      </div>
      @* Extension chips. Each chip is a token in _filterExtensions; clicking the ×
         removes it and re-filters immediately (no Apply button). Adding goes through
         the dashed "+ add type" affordance which pops a curated extension list. *@
      <div class="file-browser-chip-row" role="list" aria-label="File type filter">
        @foreach (var ext in _filterExtensions)
        {
          var localExt = ext; // capture for lambda
          <span class="file-browser-chip" role="listitem">
            <span class="file-browser-chip-label">@localExt</span>
            <button type="button" class="file-browser-chip-remove"
                    @onclick="@(() => RemoveExtensionFilter(localExt))"
                    title="@($"Remove {localExt} filter")"
                    aria-label="@($"Remove {localExt} filter")">×</button>
          </span>
        }
        <div style="position: relative;">
          <button type="button" class="file-browser-chip file-browser-chip-add"
                  @onclick="ToggleAddTypeDropdown"
                  title="Add file type filter"
                  aria-label="Add file type filter"
                  aria-haspopup="true"
                  aria-expanded="@(_showAddTypeDropdown ? "true" : "false")">＋ add type</button>
          @if (_showAddTypeDropdown)
          {
            <div class="file-browser-location-overlay" @onclick="CloseAddTypeDropdown"></div>
            <div class="file-browser-chip-dropdown" @onclick:stopPropagation="true" role="menu">
              @foreach (var ext in CuratedExtensions)
              {
                var localExt = ext;
                var alreadySelected = _filterExtensions.Contains(localExt, StringComparer.OrdinalIgnoreCase);
                <button type="button"
                        class="file-browser-location-item"
                        role="menuitem"
                        disabled="@alreadySelected"
                        style="@(alreadySelected ? "opacity:0.4; cursor:default;" : "")"
                        @onclick="@(() => AddExtensionFilter(localExt))">
                  <span style="font-family: var(--font-mono); flex: 1;">@localExt</span>
                  @if (alreadySelected)
                  {
                    <RadzenIcon Icon="check" Style="font-size: 18px; color: var(--rz-primary);" />
                  }
                </button>
              }
            </div>
          }
        </div>
      </div>
    </div>
  </div>

  <!-- File list -->
  @if (_isLoading)
  {
    <div style="flex: 1; display: flex; justify-content: center; align-items: center; padding: 32px;">
      <RadzenProgressBarCircular Mode="ProgressBarMode.Indeterminate" ProgressBarStyle="ProgressBarStyle.Primary" />
    </div>
  }
  else if (_errorMessage != null)
  {
    <div style="flex: 1; display: flex; flex-direction: column; align-items: center; justify-content: center; padding: 32px;">
      <RadzenIcon Icon="error" Style="font-size: 64px; opacity: 0.4; color: var(--rz-danger);" />
      <span style="margin-top: 12px; color: var(--text-low);">
        @_errorMessage
      </span>
      @if (_isAbsoluteMode)
      {
        <RadzenButton Variant="Variant.Text" ButtonStyle="ButtonStyle.Primary" Size="ButtonSize.Small"
                      Style="margin-top: 8px;" Click="@ReturnToMediaLibrary">
          Return to Media Library
        </RadzenButton>
      }
    </div>
  }
  else if (!FilteredDirectories.Any() && !FilteredFiles.Any())
  {
    <div style="flex: 1; display: flex; flex-direction: column; align-items: center; justify-content: center; padding: 32px;">
      <RadzenIcon Icon="folder_off" Style="font-size: 64px; opacity: 0.4;" />
      <span style="margin-top: 12px; color: var(--text-low);">
        @(string.IsNullOrEmpty(_searchText) ? "No audio files or folders found" : "No matching files")
      </span>
    </div>
  }
  else
  {
    <div class="file-browser-list">
      @* Directories first *@
      @foreach (var dir in FilteredDirectories)
      {
        <div class="file-item list-item-touch" @onclick="@(() => NavigateToFolderAsync(dir.Name))">
          <RadzenIcon Icon="folder" Style="color: var(--rz-warning);" />
          <div style="flex: 1; min-width: 0;">
            <span style="font-weight: 500;">@dir.Name</span>
          </div>
          <RadzenIcon Icon="chevron_right" Style="color: var(--text-low);" />
        </div>
      }

      @* Files *@
      @foreach (var file in FilteredFiles)
      {
        var isSelected = AllowMultiSelect ? _selectedPaths.Contains(file.Path) : _selectedPath == file.Path;
        <div class="file-item list-item-touch @(isSelected ? "file-item-selected" : "")"
             @onclick="@(() => ToggleFileSelection(file))">
          @if (AllowMultiSelect)
          {
            <RadzenCheckBox TValue="bool" Value="@isSelected" ReadOnly="true"
                            Style="margin: 0; padding: 0; pointer-events: none;" />
          }
          else
          {
            <RadzenIcon Icon="music_note"
                        Style="@($"flex-shrink: 0; color: {(isSelected ? "var(--rz-primary)" : "var(--rz-text-color)")}")" />
          }
          <div style="flex: 1; min-width: 0;">
            <div style="font-weight: 500; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">
              @(file.Name)
            </div>
            <div class="file-item-meta">
              @if (!string.IsNullOrEmpty(file.Artist))
              {
                @file.Artist
              }
              @if (!string.IsNullOrEmpty(file.Album))
              {
                <text> · @file.Album</text>
              }
              @if (!string.IsNullOrEmpty(file.Duration))
              {
                <text> · @file.Duration</text>
              }
            </div>
          </div>
          @if (ShowPlayButton)
          {
            <div @onclick:stopPropagation="true">
              <RadzenButton Icon="play_arrow" Size="ButtonSize.Small"
                            ButtonStyle="ButtonStyle.Primary" Variant="Variant.Text"
                            Click="@(() => PlayFileAsync(file))"
                            title="Play" />
            </div>
          }
          @if (AllowAddToQueue)
          {
            <div @onclick:stopPropagation="true">
              <RadzenButton Icon="add_to_queue" Size="ButtonSize.Small"
                            ButtonStyle="ButtonStyle.Light" Variant="Variant.Text"
                            Click="@(() => AddSingleToQueueAsync(file))"
                            title="Add to Queue" />
            </div>
          }
        </div>
      }
    </div>
  }
</div>

<!-- Dialog action buttons -->
<div style="display: flex; align-items: center; justify-content: flex-end; gap: 8px; padding-top: 12px;">
  @if (AllowMultiSelect)
  {
    <div style="display: flex; align-items: center; gap: 8px; margin-right: auto;">
      <RadzenButton Size="ButtonSize.Small" Variant="Variant.Text" ButtonStyle="ButtonStyle.Primary"
                    Click="@SelectAllFiles" Disabled="@(!FilteredFiles.Any())">
        Select All
      </RadzenButton>
      @if (_selectedPaths.Count > 0)
      {
        <span style="font-size: 0.875rem; color: var(--text-medium);">@_selectedPaths.Count selected</span>
      }
    </div>
  }
  <RadzenButton Click="@Cancel" Variant="Variant.Text" Text="Cancel" />
  @if (AllowAddToQueue && _selectedPaths.Count > 0)
  {
    <RadzenButton Click="@AddSelectedToQueueAsync" Variant="Variant.Outlined" ButtonStyle="ButtonStyle.Primary"
                  Text="@($"Add to Queue ({_selectedPaths.Count})")" />
  }
  @if (!AllowAddToQueue)
  {
    <RadzenButton Click="@Submit" Variant="Variant.Filled" ButtonStyle="ButtonStyle.Primary"
                  Disabled="@(AllowMultiSelect ? _selectedPaths.Count == 0 : _selectedPath == null)"
                  Text="@(AllowMultiSelect && _selectedPaths.Count > 1 ? $"Select ({_selectedPaths.Count})" : "Select")" />
  }
</div>

@code {
  [Parameter] public string? InitialSelection { get; set; }
  [Parameter] public string? Subdirectory { get; set; }
  [Parameter] public bool AllowMultiSelect { get; set; }
  [Parameter] public bool AllowAddToQueue { get; set; }
  [Parameter] public bool ShowPlayButton { get; set; }
  [Parameter] public EventCallback<List<string>> OnAddToQueue { get; set; }

  /// <summary>
  /// Tag to match against bookmark tags for selecting the initial default folder.
  /// E.g., "music" opens the NAS music bookmark, "sounds" opens the local audio folder.
  /// </summary>
  [Parameter] public string? PreferredBookmarkTag { get; set; }

  private List<FileItemDto> _directories = new();
  private List<FileItemDto> _files = new();
  private bool _isLoading = true;
  private string? _currentPath; // Full filesystem path (relative mode)
  private string? _relativePath; // Path relative to media root for display
  private string? _mediaRoot; // Configured media root directory
  private string _searchText = "";
  /// <summary>
  /// Active file-extension filter chips. Empty list = no filter (show all audio files).
  /// Persisted to <c>ui.filebrowser</c>:<c>extensions</c> via <see cref="ConfigurationApiService"/>
  /// as a JSON <c>string[]</c> — see <see cref="LoadFilterAsync"/> for the double-escape repair pass.
  /// </summary>
  private List<string> _filterExtensions = new();
  private bool _showAddTypeDropdown;
  private string? _selectedPath; // Single-select
  private HashSet<string> _selectedPaths = new(); // Multi-select
  private string? _errorMessage;

  // Absolute path / drive browsing state
  private bool _isAbsoluteMode;
  private string? _absolutePath; // Current absolute path being browsed
  private string? _driveRoot; // Root of the current drive (e.g., "/" or "C:\")
  private string _pathBarText = "";
  private bool _isEditingPath;
  private bool _showLocationDropdown;
  private List<DriveInfoDto> _drives = new();
  private List<BookmarkDto> _bookmarks = new();
  private RadzenTextBox? _pathTextField;

  /// <summary>
  /// Curated list of common audio extensions surfaced in the "+ add type" popover.
  /// Order matters: most-common formats first so the dropdown reads top-to-bottom.
  /// </summary>
  private static readonly string[] CuratedExtensions =
    new[] { ".mp3", ".flac", ".wav", ".m4a", ".aac", ".ogg", ".opus", ".wma" };

  /// <summary>
  /// Configuration store key for filter persistence. Kept stable so future PRs can
  /// add a one-time repair migration without re-keying.
  /// </summary>
  private const string FilterConfigSection = "ui.filebrowser";
  private const string FilterConfigKey = "extensions";

  private IEnumerable<FileItemDto> FilteredDirectories
  {
    get
    {
      var dirs = _directories.AsEnumerable();
      if (!string.IsNullOrWhiteSpace(_searchText))
      {
        var search = _searchText.Trim();
        dirs = dirs.Where(d => d.Name.Contains(search, StringComparison.OrdinalIgnoreCase));
      }
      return dirs;
    }
  }

  private IEnumerable<FileItemDto> FilteredFiles
  {
    get
    {
      var files = _files.AsEnumerable();
      if (!string.IsNullOrWhiteSpace(_searchText))
      {
        var search = _searchText.Trim();
        files = files.Where(f =>
          f.Name.Contains(search, StringComparison.OrdinalIgnoreCase) ||
          (f.Artist?.Contains(search, StringComparison.OrdinalIgnoreCase) ?? false) ||
          (f.Album?.Contains(search, StringComparison.OrdinalIgnoreCase) ?? false));
      }
      // Chip filter: case-insensitive EndsWith across any chip extension.
      // Empty chip list = no filter (show all files).
      if (_filterExtensions.Count > 0)
      {
        files = files.Where(f =>
          _filterExtensions.Any(ext => f.Name.EndsWith(ext, StringComparison.OrdinalIgnoreCase)));
      }
      return files;
    }
  }

  protected override async Task OnInitializedAsync()
  {
    // Load persisted filter chips (handles the legacy double-escaped form via
    // LoadFilterAsync's repair pass) alongside drives, bookmarks, and media root.
    var drivesTask = LoadDrivesAsync();
    var bookmarksTask = LoadBookmarksAsync();
    var rootTask = LoadMediaRootAsync();
    var filterTask = LoadFilterAsync();
    await Task.WhenAll(drivesTask, bookmarksTask, rootTask, filterTask);

    // Try to open the best default location:
    // 1. If Subdirectory is set, use it (relative mode)
    // 2. If a bookmark matches the preferred tag and is accessible, open it
    // 3. If any bookmark is accessible, open the first one
    // 4. Fall back to media library root
    if (!string.IsNullOrEmpty(Subdirectory))
    {
      _currentPath = Subdirectory;
      UpdateRelativePath();
      await LoadContentsAsync();
    }
    else
    {
      var defaultBookmark = FindDefaultBookmark();
      if (defaultBookmark != null)
      {
        _isAbsoluteMode = true;
        _absolutePath = defaultBookmark.Path;
        _driveRoot = "/";
        _pathBarText = defaultBookmark.Path;
        await LoadContentsAsync();
      }
      else
      {
        _currentPath = null;
        UpdateRelativePath();
        await LoadContentsAsync();
      }
    }
  }

  private BookmarkDto? FindDefaultBookmark()
  {
    if (!_bookmarks.Any())
    {
      return null;
    }

    // Prefer a bookmark matching the requested tag
    if (!string.IsNullOrEmpty(PreferredBookmarkTag))
    {
      var tagged = _bookmarks.FirstOrDefault(b =>
        b.IsAccessible && b.Tag.Equals(PreferredBookmarkTag, StringComparison.OrdinalIgnoreCase));
      if (tagged != null)
      {
        return tagged;
      }
    }

    // Fall back to first accessible bookmark
    return _bookmarks.FirstOrDefault(b => b.IsAccessible);
  }

  private async Task LoadDrivesAsync()
  {
    try
    {
      var drives = await FileApi.GetDrivesAsync();
      if (drives != null)
      {
        _drives = drives;
      }
    }
    catch (Exception ex)
    {
      Logger.LogDebug(ex, "Failed to load drives");
    }
  }

  private async Task LoadBookmarksAsync()
  {
    try
    {
      var bookmarks = await FileApi.GetBookmarksAsync();
      if (bookmarks != null)
      {
        _bookmarks = bookmarks;
      }
    }
    catch (Exception ex)
    {
      Logger.LogDebug(ex, "Failed to load bookmarks");
    }
  }

  private async Task LoadMediaRootAsync()
  {
    try
    {
      var config = await ConfigApi.GetConfigurationAsync<FilePlayerConfigDto>("fileplayer");
      if (config != null && !string.IsNullOrWhiteSpace(config.RootDirectory)
          && config.RootDirectory != "media/audio")
      {
        _mediaRoot = config.RootDirectory.TrimEnd('/');
      }
    }
    catch (Exception ex)
    {
      Logger.LogDebug(ex, "Failed to load FilePlayer config for media root");
    }
  }

  private void UpdateRelativePath()
  {
    if (string.IsNullOrEmpty(_currentPath) || _currentPath == "/")
    {
      _relativePath = null;
      return;
    }

    // Strip media root prefix if present (for absolute paths from config)
    if (!string.IsNullOrEmpty(_mediaRoot) &&
        _currentPath.StartsWith(_mediaRoot, StringComparison.OrdinalIgnoreCase))
    {
      var relative = _currentPath[_mediaRoot.Length..].TrimStart('/');
      _relativePath = string.IsNullOrEmpty(relative) ? null : relative;
      return;
    }

    // API returns relative paths — use as-is
    _relativePath = _currentPath.TrimStart('/');
    if (string.IsNullOrEmpty(_relativePath)) _relativePath = null;
  }

  private async Task LoadContentsAsync()
  {
    _isLoading = true;
    _errorMessage = null;
    StateHasChanged();

    try
    {
      FileListDto? result;

      if (_isAbsoluteMode && !string.IsNullOrEmpty(_absolutePath))
      {
        result = await FileApi.BrowseAbsoluteAsync(_absolutePath);
      }
      else
      {
        result = await FileApi.BrowseAsync(_currentPath);
      }

      if (result != null)
      {
        _directories = result.Items.Where(i => i.IsDirectory).OrderBy(i => i.Name).ToList();
        _files = result.Items.Where(i => !i.IsDirectory).OrderBy(i => i.Name).ToList();

        // Update current path from API response
        if (!string.IsNullOrEmpty(result.CurrentPath))
        {
          if (_isAbsoluteMode)
          {
            _absolutePath = result.CurrentPath;
            _pathBarText = _absolutePath;
            // Keep the drive root in sync with whatever the API ended up resolving to.
            // Prevents a stale "C:\" selector while the breadcrumb shows "D:\..." after
            // a redirect or symlink walk.
            _driveRoot = DeriveDriveRoot(_absolutePath);
          }
          else
          {
            _currentPath = result.CurrentPath;
            UpdateRelativePath();
          }
        }

        // Pre-select initial file if provided
        if (!string.IsNullOrWhiteSpace(InitialSelection))
        {
          var match = _files.FirstOrDefault(f => f.Path == InitialSelection);
          if (match != null)
          {
            if (AllowMultiSelect)
              _selectedPaths.Add(match.Path);
            else
              _selectedPath = match.Path;
          }
          InitialSelection = null; // Only apply once
        }
      }
      else
      {
        _directories = new();
        _files = new();
        if (_isAbsoluteMode)
          _errorMessage = $"Could not access: {_absolutePath}";
      }
    }
    catch (Exception ex)
    {
      Logger.LogError(ex, "Failed to load files at path {Path}",
        _isAbsoluteMode ? _absolutePath : _currentPath);
      _directories = new();
      _files = new();
      _errorMessage = "Failed to load directory contents";
    }
    finally
    {
      _isLoading = false;
      StateHasChanged();
    }
  }

  // --- Navigation: Relative mode ---

  private async Task NavigateToFolderAsync(string folderName)
  {
    if (_isAbsoluteMode)
    {
      // In absolute mode, append folder to current absolute path
      var newPath = _absolutePath?.TrimEnd('/') + "/" + folderName;
      await NavigateToAbsoluteAsync(newPath!);
      return;
    }

    _currentPath = (string.IsNullOrEmpty(_currentPath) || _currentPath == "/")
      ? folderName
      : $"{_currentPath}/{folderName}";
    _searchText = "";
    UpdateRelativePath();
    await LoadContentsAsync();
  }

  private async Task NavigateToPathAsync(string? path)
  {
    _currentPath = path;
    _searchText = "";
    UpdateRelativePath();
    await LoadContentsAsync();
  }

  private async Task NavigateToRelativeAsync(string relativePath)
  {
    _currentPath = relativePath;
    _searchText = "";
    UpdateRelativePath();
    await LoadContentsAsync();
  }

  // --- Navigation: Absolute mode ---

  private async Task NavigateToAbsoluteAsync(string path)
  {
    _isAbsoluteMode = true;
    _absolutePath = path;
    _pathBarText = path;
    _searchText = "";
    _errorMessage = null;
    await LoadContentsAsync();
  }

  private async Task NavigateToBookmark(BookmarkDto bookmark)
  {
    if (!bookmark.IsAccessible)
    {
      return;
    }
    _showLocationDropdown = false;
    // Derive the drive root from the bookmark path so breadcrumb + drive selector
    // remain consistent. Previously hard-coded "/" which forced the breadcrumb to
    // show a POSIX-style root even when the bookmark pointed at a Windows drive.
    _driveRoot = DeriveDriveRoot(bookmark.Path);
    await NavigateToAbsoluteAsync(bookmark.Path);
  }

  private async Task NavigateToDrive(string driveName)
  {
    _showLocationDropdown = false;
    _driveRoot = driveName.TrimEnd('/');
    if (string.IsNullOrEmpty(_driveRoot)) _driveRoot = "/";
    await NavigateToAbsoluteAsync(_driveRoot == "/" ? "/" : _driveRoot);
  }

  /// <summary>
  /// Inspects an absolute path and returns the appropriate drive root: <c>"/"</c> for
  /// POSIX-style paths, the <c>"X:\"</c> prefix for Windows-style paths. Keeps the drive
  /// selector and breadcrumb in sync regardless of which entry-point landed us in
  /// absolute mode (bookmark, drive picker, path bar).
  /// </summary>
  private static string DeriveDriveRoot(string path)
  {
    if (string.IsNullOrEmpty(path)) return "/";
    if (path.StartsWith('/')) return "/";
    if (path.Length >= 3 && path[1] == ':' && (path[2] == '\\' || path[2] == '/'))
    {
      return path[..3];
    }
    return "/";
  }

  private async Task ReturnToMediaLibrary()
  {
    _showLocationDropdown = false;
    _isAbsoluteMode = false;
    _absolutePath = null;
    _driveRoot = null;
    _pathBarText = "";
    _isEditingPath = false;
    _errorMessage = null;
    _currentPath = null;
    _searchText = "";
    UpdateRelativePath();
    await LoadContentsAsync();
  }

  // --- Path bar ---

  private void TogglePathEditing()
  {
    _isEditingPath = !_isEditingPath;
    if (_isEditingPath)
    {
      // Pre-fill with current path
      _pathBarText = _isAbsoluteMode ? (_absolutePath ?? "/") : "/";
    }
  }

  private async Task OnPathBarKeyDown(KeyboardEventArgs e)
  {
    if (e.Key == "Enter")
    {
      await NavigateToPathBarAsync();
    }
    else if (e.Key == "Escape")
    {
      _isEditingPath = false;
    }
  }

  private async Task NavigateToPathBarAsync()
  {
    var path = _pathBarText?.Trim();
    if (string.IsNullOrWhiteSpace(path)) return;

    _isEditingPath = false;

    // Determine drive root from the path
    if (path.StartsWith("/"))
    {
      _driveRoot = "/";
    }
    else if (path.Length >= 3 && path[1] == ':' && (path[2] == '\\' || path[2] == '/'))
    {
      _driveRoot = path[..3];
    }

    await NavigateToAbsoluteAsync(path);
  }

  // --- Location dropdown ---

  private void ToggleLocationDropdown()
  {
    _showLocationDropdown = !_showLocationDropdown;
  }

  private void CloseLocationDropdown()
  {
    _showLocationDropdown = false;
  }

  // --- Search handler ---

  private void OnSearchChanged(string value)
  {
    _searchText = value;
    StateHasChanged();
  }

  // --- Extension chip handlers + persistence ---

  private void ToggleAddTypeDropdown()
  {
    _showAddTypeDropdown = !_showAddTypeDropdown;
  }

  private void CloseAddTypeDropdown()
  {
    _showAddTypeDropdown = false;
  }

  private async Task AddExtensionFilter(string extension)
  {
    if (string.IsNullOrWhiteSpace(extension)) return;
    var normalized = extension.StartsWith('.') ? extension : "." + extension;
    if (_filterExtensions.Any(e => string.Equals(e, normalized, StringComparison.OrdinalIgnoreCase)))
    {
      _showAddTypeDropdown = false;
      return;
    }
    _filterExtensions.Add(normalized);
    _showAddTypeDropdown = false;
    await SaveFilterAsync();
    StateHasChanged();
  }

  private async Task RemoveExtensionFilter(string extension)
  {
    var idx = _filterExtensions.FindIndex(e => string.Equals(e, extension, StringComparison.OrdinalIgnoreCase));
    if (idx < 0) return;
    _filterExtensions.RemoveAt(idx);
    await SaveFilterAsync();
    StateHasChanged();
  }

  /// <summary>
  /// Loads the persisted filter chips, handling legacy double-escaped JSON via a
  /// best-effort repair pass: if the stored value is a string-of-a-string-of-..., we
  /// recursively <see cref="JsonSerializer.Deserialize{T}(string,JsonSerializerOptions?)"/>
  /// until we land on a <c>string[]</c>. Capped at 4 unwrap iterations to avoid pathological
  /// loops. Silent on failure — an absent / corrupt blob just leaves the chip list empty.
  /// </summary>
  private async Task LoadFilterAsync()
  {
    try
    {
      var prefs = await ConfigApi.GetConfigurationAsync<Dictionary<string, object>>(FilterConfigSection);
      if (prefs == null || !prefs.TryGetValue(FilterConfigKey, out var raw) || raw is null) return;

      var extensions = ParsePersistedFilterValue(raw);
      if (extensions != null)
      {
        _filterExtensions = extensions
          .Where(e => !string.IsNullOrWhiteSpace(e))
          .Select(e => e.StartsWith('.') ? e : "." + e)
          .Distinct(StringComparer.OrdinalIgnoreCase)
          .ToList();
      }
    }
    catch (Exception ex)
    {
      Logger.LogDebug(ex, "Failed to load file browser filter chips");
    }
  }

  /// <summary>
  /// Repair-pass parser exposed as <c>internal static</c> so unit tests can pin the
  /// double-escape behaviour. Accepts a raw value from the config store and returns
  /// the recovered <c>string[]</c>, or null when no shape is recognized.
  /// </summary>
  internal static string[]? ParsePersistedFilterValue(object raw)
  {
    // Already deserialized into a JsonElement (the typical ConfigApi happy path).
    if (raw is JsonElement element)
    {
      return TryUnwrapJsonElement(element);
    }

    if (raw is string s)
    {
      return TryUnwrapEscapedJsonString(s);
    }

    // Some store backends round-trip arrays as IEnumerable<object>.
    if (raw is IEnumerable<object> seq)
    {
      return seq.Select(o => o?.ToString() ?? string.Empty).ToArray();
    }

    return null;
  }

  private static string[]? TryUnwrapJsonElement(JsonElement element)
  {
    // Native array → fast path.
    if (element.ValueKind == JsonValueKind.Array)
    {
      var list = new List<string>(element.GetArrayLength());
      foreach (var item in element.EnumerateArray())
      {
        if (item.ValueKind == JsonValueKind.String)
        {
          list.Add(item.GetString() ?? string.Empty);
        }
      }
      return list.ToArray();
    }

    // String → could be a legacy escaped blob; retry the repair pass.
    if (element.ValueKind == JsonValueKind.String)
    {
      var inner = element.GetString();
      return inner is null ? null : TryUnwrapEscapedJsonString(inner);
    }

    return null;
  }

  /// <summary>
  /// Recursively deserializes a string that may have been JSON-escaped one or more times
  /// before being persisted. Each pass tries to parse as <c>string[]</c>; if that fails
  /// and the result is another string, we unwrap once more (up to 4 levels).
  /// </summary>
  private static string[]? TryUnwrapEscapedJsonString(string s)
  {
    if (string.IsNullOrWhiteSpace(s)) return null;
    var current = s;
    for (var i = 0; i < 4; i++)
    {
      try
      {
        // Each level was JSON-stringified, so quotes may be escaped. Try the array shape first.
        var arr = JsonSerializer.Deserialize<string[]>(current);
        if (arr != null) return arr;
      }
      catch (JsonException)
      {
        // Fall through and try unwrapping one more level.
      }

      try
      {
        var inner = JsonSerializer.Deserialize<string>(current);
        if (inner is null || inner == current) return null;
        current = inner;
      }
      catch (JsonException)
      {
        return null;
      }
    }
    return null;
  }

  private async Task SaveFilterAsync()
  {
    try
    {
      // Persist as a real array — ConfigApi handles the JSON shape so we never re-introduce
      // the double-escape that the repair pass exists to handle.
      await ConfigApi.UpdateConfigurationAsync(
        FilterConfigSection, FilterConfigKey, _filterExtensions.ToArray());
    }
    catch (Exception ex)
    {
      Logger.LogDebug(ex, "Failed to save file browser filter chips");
    }
  }

  // --- Absolute path breadcrumb helpers ---

  private record struct BreadcrumbSegment(string Name, string FullPath, bool IsLast);

  private List<BreadcrumbSegment> GetAbsoluteSegmentsWithPaths()
  {
    if (string.IsNullOrEmpty(_absolutePath) || string.IsNullOrEmpty(_driveRoot))
      return new();

    var relative = _absolutePath;
    if (_driveRoot == "/")
    {
      relative = _absolutePath.TrimStart('/');
    }
    else if (_absolutePath.StartsWith(_driveRoot, StringComparison.OrdinalIgnoreCase))
    {
      relative = _absolutePath[_driveRoot.Length..].TrimStart('/').TrimStart('\\');
    }

    if (string.IsNullOrEmpty(relative)) return new();

    var parts = relative.Split('/', StringSplitOptions.RemoveEmptyEntries);
    var root = _driveRoot ?? "/";
    var result = new List<BreadcrumbSegment>(parts.Length);

    for (int i = 0; i < parts.Length; i++)
    {
      var partial = string.Join("/", parts.Take(i + 1));
      var fullPath = root == "/" ? ("/" + partial) : (root.TrimEnd('/') + "/" + partial);
      result.Add(new BreadcrumbSegment(parts[i], fullPath, i == parts.Length - 1));
    }

    return result;
  }

  // --- File selection ---

  private void ToggleFileSelection(FileItemDto file)
  {
    if (AllowMultiSelect)
    {
      if (!_selectedPaths.Add(file.Path))
        _selectedPaths.Remove(file.Path);
    }
    else
    {
      _selectedPath = _selectedPath == file.Path ? null : file.Path;
    }
  }

  private void SelectAllFiles()
  {
    foreach (var file in FilteredFiles)
      _selectedPaths.Add(file.Path);
  }

  private async Task PlayFileAsync(FileItemDto file)
  {
    try
    {
      await FileApi.PlayFileAsync(file.Path);
    }
    catch (Exception ex)
    {
      Logger.LogWarning(ex, "Failed to play file {Path}", file.Path);
    }
  }

  private async Task AddSingleToQueueAsync(FileItemDto file)
  {
    try
    {
      var (success, _) = await FileApi.AddFileToQueueAsync(file.Path);
      if (success)
        Logger.LogDebug("Added {Path} to queue", file.Path);
    }
    catch (Exception ex)
    {
      Logger.LogWarning(ex, "Failed to add file to queue: {Path}", file.Path);
    }
  }

  private async Task AddSelectedToQueueAsync()
  {
    if (_selectedPaths.Count == 0) return;

    if (OnAddToQueue.HasDelegate)
    {
      await OnAddToQueue.InvokeAsync(_selectedPaths.ToList());
      _selectedPaths.Clear();
      StateHasChanged();
    }
  }

  private void Submit()
  {
    if (AllowMultiSelect)
      DialogService.Close(_selectedPaths.ToList());
    else
      DialogService.Close(_selectedPath);
  }

  private void Cancel() => DialogService.Close();
}
