@inject PlaylistApiService PlaylistApi
@inject DialogService DialogService
@inject NotificationService NotificationService
@inject ILogger<SavePlaylistDialog> Logger

<div style="min-width: 400px;">
  <div style="margin-bottom: 16px;">
    <label style="display: block; margin-bottom: 4px;">Playlist Name</label>
    <RadzenTextBox @bind-Value="_name"
                   Placeholder="My Playlist"
                   Style="width: 100%;"
                   AutoFocus="true" />
    @if (string.IsNullOrWhiteSpace(_name))
    {
      <span style="color: var(--rz-danger); font-size: 0.75rem;">Name is required</span>
    }
  </div>
  <div style="margin-bottom: 16px;">
    <label style="display: block; margin-bottom: 4px;">Description (optional)</label>
    <RadzenTextArea @bind-Value="_description"
                    Placeholder="Add a description..."
                    Rows="2"
                    Style="width: 100%;" />
  </div>
  <div style="display: flex; justify-content: flex-end; gap: 8px; margin-top: 16px;">
    <RadzenButton Text="Cancel"
                  Variant="Variant.Outlined"
                  ButtonStyle="ButtonStyle.Light"
                  Click="Cancel" />
    <RadzenButton Text="Save"
                  Variant="Variant.Filled"
                  ButtonStyle="ButtonStyle.Primary"
                  Click="SaveAsync"
                  Disabled="@(string.IsNullOrWhiteSpace(_name) || _saving)"
                  IsBusy="@_saving" />
  </div>
</div>

@code {
  private string _name = "";
  private string _description = "";
  private bool _saving = false;

  private void Cancel() => DialogService.Close();

  private async Task SaveAsync()
  {
    if (string.IsNullOrWhiteSpace(_name)) return;

    _saving = true;
    try
    {
      var result = await PlaylistApi.CreateAsync(_name.Trim(),
        string.IsNullOrWhiteSpace(_description) ? null : _description.Trim());

      if (result != null)
      {
        NotificationService.Notify(NotificationSeverity.Success, "Success", $"Playlist '{result.Name}' saved ({result.ItemCount} tracks)");
        DialogService.Close(result);
      }
      else
      {
        NotificationService.Notify(NotificationSeverity.Error, "Error", "Failed to save playlist");
      }
    }
    catch (Exception ex)
    {
      Logger.LogError(ex, "Failed to save playlist");
      NotificationService.Notify(NotificationSeverity.Error, "Error", "Error saving playlist");
    }
    finally
    {
      _saving = false;
    }
  }
}
