@using MudBlazor
@using Radio.Web.Models
@using Radio.Web.Services.ApiClients

<MudDialog>
  <TitleContent>
    <MudText Typo="Typo.h6">
      <MudIcon Icon="@Icons.Material.Filled.Cast" Class="mr-2" />
      Select Cast Device
    </MudText>
  </TitleContent>
  <DialogContent>
    @if (_isLoading)
    {
      <div style="display: flex; flex-direction: column; align-items: center; gap: 16px; padding: 32px;">
        <MudProgressCircular Color="Color.Primary" Indeterminate="true" />
        <MudText Typo="Typo.body2" Color="Color.Secondary">Loading devices...</MudText>
      </div>
    }
    else if (_error != null)
    {
      <MudAlert Severity="Severity.Error" Class="mb-4">@_error</MudAlert>
      <MudButton Variant="Variant.Outlined" Color="Color.Primary" OnClick="RefreshDevicesAsync" FullWidth="true">
        <MudIcon Icon="@Icons.Material.Filled.Refresh" Class="mr-2" />
        Retry Discovery
      </MudButton>
    }
    else if ((_devices == null || _devices.Count == 0) && !_isScanning)
    {
      <MudAlert Severity="Severity.Info" Class="mb-4">
        No Cast devices found on your network. Make sure your Chromecast or Cast-enabled device is powered on and connected to the same network.
      </MudAlert>
      <MudButton Variant="Variant.Outlined" Color="Color.Primary" OnClick="RefreshDevicesAsync" FullWidth="true">
        <MudIcon Icon="@Icons.Material.Filled.Refresh" Class="mr-2" />
        Scan Again
      </MudButton>
    }
    else
    {
      @if (_isScanning)
      {
        <MudProgressLinear Color="Color.Primary" Indeterminate="true" Class="mb-2" />
        <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mb-2">
          Scanning for new devices...
        </MudText>
      }

      @if (_devices != null && _devices.Count > 0)
      {
        <MudList T="CastDeviceDto" Dense="false" Style="max-height: 300px; overflow-y: auto;">
          @foreach (var device in _devices)
          {
            var isSelected = _selectedDevice?.Id == device.Id;
            var isDefault = _defaultDevice?.Id == device.Id;
            var isLive = _discoveredDeviceIds.Contains(device.Id);
            <MudListItem T="CastDeviceDto"
                         OnClick="@(() => SelectDevice(device))"
                         Style="@(isSelected ? "background-color: var(--mud-palette-action-default-hover);" : "")">
              <div style="display: flex; align-items: center; gap: 16px; padding: 12px 0;">
                <MudIcon Icon="@GetDeviceIcon(device)" Color="@(isSelected ? Color.Primary : Color.Default)" Size="Size.Large" />
                <div style="flex: 1; min-width: 0;">
                  <div style="display: flex; align-items: center; gap: 4px;">
                    @if (isDefault)
                    {
                      <MudIcon Icon="@Icons.Material.Filled.Star" Color="Color.Warning" Size="Size.Small" />
                    }
                    <MudText Typo="Typo.body1" Style="font-weight: 500;">@device.Name</MudText>
                  </div>
                  <div style="display: flex; align-items: center; gap: 8px; flex-wrap: wrap;">
                    <MudText Typo="Typo.caption" Color="Color.Secondary">@device.Model - @device.IpAddress</MudText>
                    @if (_scanCompleted)
                    {
                      @if (isLive)
                      {
                        <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Success"
                                 Icon="@Icons.Material.Filled.Wifi" Style="height: 20px; font-size: 0.7rem;">
                          Live
                        </MudChip>
                      }
                      else
                      {
                        <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Default"
                                 Icon="@Icons.Material.Filled.Cached" Style="height: 20px; font-size: 0.7rem;">
                          Cached
                        </MudChip>
                      }
                    }
                  </div>
                </div>
                @if (isSelected)
                {
                  <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Color="Color.Success" />
                }
              </div>
            </MudListItem>
            <MudDivider />
          }
        </MudList>
      }
      else if (_isScanning)
      {
        <div style="display: flex; flex-direction: column; align-items: center; gap: 16px; padding: 32px;">
          <MudProgressCircular Color="Color.Primary" Indeterminate="true" />
          <MudText Typo="Typo.body2" Color="Color.Secondary">Searching for Cast devices...</MudText>
        </div>
      }

      <MudButton Variant="Variant.Text" Color="Color.Primary" OnClick="RefreshDevicesAsync"
                 Class="mt-2" Size="Size.Small" Disabled="@_isScanning">
        <MudIcon Icon="@Icons.Material.Filled.Refresh" Size="Size.Small" Class="mr-1" />
        Scan Again
      </MudButton>
    }

    @if (_isConnecting)
    {
      <div style="display: flex; align-items: center; gap: 8px; margin-top: 16px; padding: 12px; background: var(--mud-palette-background-grey); border-radius: 8px;">
        <MudProgressCircular Color="Color.Primary" Size="Size.Small" Indeterminate="true" />
        <MudText Typo="Typo.body2">Connecting to @_selectedDevice?.Name...</MudText>
      </div>
    }
  </DialogContent>
  <DialogActions>
    <MudButton OnClick="Cancel" Variant="Variant.Text">Cancel</MudButton>
    <MudButton OnClick="ConnectToDevice"
               Variant="Variant.Filled"
               Color="Color.Primary"
               Disabled="@(_selectedDevice == null || _isConnecting)">
      Connect
    </MudButton>
  </DialogActions>
</MudDialog>

@code {
  [CascadingParameter]
  public IMudDialogInstance MudDialog { get; set; } = null!;

  [Parameter]
  public DevicesApiService DevicesApi { get; set; } = null!;

  [Parameter]
  public ILogger Logger { get; set; } = null!;

  private List<CastDeviceDto>? _devices;
  private CastDeviceDto? _selectedDevice;
  private CastDeviceDto? _defaultDevice;
  private HashSet<string> _discoveredDeviceIds = new();
  private bool _isLoading = true;
  private bool _isScanning;
  private bool _scanCompleted;
  private bool _isConnecting;
  private string? _error;

  protected override async Task OnInitializedAsync()
  {
    // Phase 1: Instant cache load (< 100ms)
    try
    {
      var cachedTask = DevicesApi.GetCachedCastDevicesAsync();
      var defaultTask = DevicesApi.GetDefaultCastDeviceAsync();
      await Task.WhenAll(cachedTask, defaultTask);

      _devices = await cachedTask ?? new();
      _defaultDevice = await defaultTask;
    }
    catch (Exception ex)
    {
      Logger.LogWarning(ex, "Failed to load cached Cast devices");
      _devices = new();
    }
    finally
    {
      _isLoading = false;
      StateHasChanged();
    }

    // Phase 2: Background mDNS discovery (10-15s)
    await ScanForDevicesAsync();
  }

  private async Task ScanForDevicesAsync()
  {
    _isScanning = true;
    StateHasChanged();

    try
    {
      var discovered = await DevicesApi.DiscoverCastDevicesAsync();
      if (discovered != null)
      {
        _discoveredDeviceIds = discovered.Select(d => d.Id).ToHashSet();

        // Merge: live devices first, then append cached-only devices
        var merged = new List<CastDeviceDto>(discovered);
        foreach (var cached in _devices ?? [])
        {
          if (!_discoveredDeviceIds.Contains(cached.Id))
            merged.Add(cached);
        }
        _devices = merged;
      }
    }
    catch (Exception ex)
    {
      Logger.LogWarning(ex, "Background Cast discovery failed");
      // Keep cached devices — don't show error, discovery is best-effort
    }
    finally
    {
      _isScanning = false;
      _scanCompleted = true;
      StateHasChanged();
    }
  }

  private async Task RefreshDevicesAsync()
  {
    _selectedDevice = null;
    await ScanForDevicesAsync();
  }

  private void SelectDevice(CastDeviceDto device)
  {
    _selectedDevice = device;
  }

  private async Task ConnectToDevice()
  {
    if (_selectedDevice == null) return;

    _isConnecting = true;
    StateHasChanged();

    try
    {
      var success = await DevicesApi.ConnectToCastDeviceAsync(_selectedDevice);
      if (success)
      {
        Logger.LogInformation("Connected to Cast device: {DeviceName}", _selectedDevice.Name);
        MudDialog.Close(DialogResult.Ok(_selectedDevice));
      }
      else
      {
        _error = $"Failed to connect to {_selectedDevice.Name}. Please try again.";
      }
    }
    catch (Exception ex)
    {
      Logger.LogError(ex, "Error connecting to Cast device: {DeviceName}", _selectedDevice.Name);
      _error = $"Error connecting to {_selectedDevice.Name}: {ex.Message}";
    }
    finally
    {
      _isConnecting = false;
      StateHasChanged();
    }
  }

  private void Cancel()
  {
    MudDialog.Cancel();
  }

  private static string GetDeviceIcon(CastDeviceDto device)
  {
    var model = device.Model.ToLowerInvariant();

    if (model.Contains("audio") || model.Contains("speaker") || model.Contains("home"))
      return Icons.Material.Filled.Speaker;

    if (model.Contains("tv") || model.Contains("ultra"))
      return Icons.Material.Filled.Tv;

    if (model.Contains("display") || model.Contains("hub"))
      return Icons.Material.Filled.TabletAndroid;

    return Icons.Material.Filled.Cast;
  }
}
