@using MudBlazor
@inject SourcesApiService SourcesApi
@inject QueueApiService QueueApi
@inject ILogger<AudioFileSelectionDialog> Logger

<MudDialog>
  <TitleContent>
    <MudText Typo="Typo.h6">
      <MudIcon Icon="@Icons.Material.Filled.AudioFile" Class="mr-2" />
      @(AllowMultiSelect ? "Select Audio Files" : "Select Audio File")
    </MudText>
  </TitleContent>
  <DialogContent>
    @* Breadcrumb navigation *@
    <div style="display: flex; align-items: center; gap: 8px; margin-bottom: 16px; flex-wrap: wrap;">
      <MudButton Variant="Variant.Text"
                 Color="Color.Primary"
                 Size="Size.Small"
                 OnClick="@(() => NavigateToPath(null))"
                 Disabled="@(string.IsNullOrEmpty(_currentPath))">
        <MudIcon Icon="@Icons.Material.Filled.Home" Size="Size.Small" Class="mr-1" />
        Root
      </MudButton>
      @if (!string.IsNullOrEmpty(_currentPath))
      {
        var pathParts = _currentPath.Split('/', '\\').Where(p => !string.IsNullOrEmpty(p)).ToArray();
        for (int i = 0; i < pathParts.Length; i++)
        {
          var index = i;
          var partialPath = string.Join("/", pathParts.Take(index + 1));
          <MudIcon Icon="@Icons.Material.Filled.ChevronRight" Size="Size.Small" Style="color: var(--mud-palette-text-secondary);" />
          <MudButton Variant="Variant.Text"
                     Color="@(i == pathParts.Length - 1 ? Color.Default : Color.Primary)"
                     Size="Size.Small"
                     Disabled="@(i == pathParts.Length - 1)"
                     OnClick="@(() => NavigateToPath(partialPath))">
            @pathParts[index]
          </MudButton>
        }
      }
    </div>

    @* Multi-select controls *@
    @if (AllowMultiSelect && _files != null && _files.Count > 0)
    {
      <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 12px; padding: 8px; background-color: rgba(var(--mud-palette-primary-rgb), 0.1); border-radius: 4px;">
        <div style="display: flex; gap: 8px; align-items: center;">
          <MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Primary" OnClick="SelectAllFiles">
            Select All
          </MudButton>
          <MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Primary" OnClick="DeselectAllFiles" Disabled="@(!SelectedFiles.Any())">
            Deselect All
          </MudButton>
        </div>
        @if (SelectedFiles.Any())
        {
          <MudText Typo="Typo.body2" Color="Color.Primary">
            @SelectedFiles.Count selected (@FormatTotalDuration())
          </MudText>
        }
      </div>
    }

    @if (_isLoading)
    {
      <div style="display: flex; justify-content: center; padding: 32px;">
        <MudProgressCircular Color="Color.Primary" Indeterminate="true" />
      </div>
    }
    else if ((_directories == null || _directories.Count == 0) && (_files == null || _files.Count == 0))
    {
      <MudAlert Severity="Severity.Info">No audio files or folders found.</MudAlert>
    }
    else
    {
      <MudList T="string" Dense="false" Style="max-height: 400px; overflow-y: auto;">
        @* Back button if in a subdirectory *@
        @if (!string.IsNullOrEmpty(_currentPath))
        {
          <MudListItem T="string" OnClick="NavigateUp">
            <div style="display: flex; align-items: center; gap: 16px; padding: 8px 0;">
              <MudIcon Icon="@Icons.Material.Filled.ArrowBack" Color="Color.Secondary" Size="Size.Large" />
              <MudText Typo="Typo.body1" Style="font-weight: 500; color: var(--mud-palette-text-secondary);">
                .. (Go back)
              </MudText>
            </div>
          </MudListItem>
          <MudDivider />
        }

        @* Folders first *@
        @if (_directories != null)
        {
          @foreach (var folder in _directories)
          {
            <MudListItem T="string" OnClick="@(() => NavigateToFolder(folder))">
              <div style="display: flex; align-items: center; gap: 16px; padding: 8px 0;">
                <MudIcon Icon="@Icons.Material.Filled.Folder" Color="Color.Warning" Size="Size.Large" />
                <div style="flex: 1; min-width: 0;">
                  <MudText Typo="Typo.body1" Style="font-weight: 500;">@folder</MudText>
                  <MudText Typo="Typo.caption" Color="Color.Secondary">Folder</MudText>
                </div>
                <MudIcon Icon="@Icons.Material.Filled.ChevronRight" Color="Color.Secondary" />
              </div>
            </MudListItem>
            <MudDivider />
          }
        }

        @* Then files *@
        @if (_files != null)
        {
          @foreach (var file in _files)
          {
            var isSelected = AllowMultiSelect ? SelectedFiles.Contains(file) : SelectedFile == file;
            <MudListItem T="string"
                         OnClick="@(() => ToggleFileSelection(file))"
                         Style="@(isSelected ? "background-color: var(--mud-palette-action-default-hover);" : "")">
              <div style="display: flex; align-items: center; gap: 16px; padding: 12px 0;">
                @if (AllowMultiSelect)
                {
                  <MudCheckBox T="bool" Value="@isSelected" ReadOnly="true" Color="Color.Primary" />
                }
                <MudIcon Icon="@Icons.Material.Filled.MusicNote" Color="Color.Primary" Size="Size.Large" />
                <div style="flex: 1; min-width: 0;">
                  <MudText Typo="Typo.body1" Style="font-weight: 500;">@file.FileName</MudText>
                  <MudText Typo="Typo.caption" Color="Color.Secondary">@FormatFileSize(file.FileSize)</MudText>
                </div>
                @if (isSelected)
                {
                  <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Color="Color.Success" />
                }
              </div>
            </MudListItem>
            <MudDivider />
          }
        }
      </MudList>
    }
  </DialogContent>
  <DialogActions>
    <MudButton OnClick="Cancel" Variant="Variant.Text">Cancel</MudButton>
    @if (AllowAddToQueue && (AllowMultiSelect ? SelectedFiles.Any() : SelectedFile != null))
    {
      <MudButton OnClick="AddToQueue" Variant="Variant.Outlined" Color="Color.Primary">
        Add to Queue
      </MudButton>
    }
    <MudButton OnClick="Submit" Variant="Variant.Filled" Color="Color.Primary" Disabled="@(AllowMultiSelect ? !SelectedFiles.Any() : SelectedFile == null)">
      @(AllowMultiSelect && SelectedFiles.Count > 1 ? $"Select ({SelectedFiles.Count})" : "Select")
    </MudButton>
  </DialogActions>
</MudDialog>

@code {
  [CascadingParameter]
  public IMudDialogInstance MudDialog { get; set; } = null!;

  [Parameter]
  public string? InitialSelection { get; set; }

  [Parameter]
  public string? Subdirectory { get; set; }

  [Parameter]
  public bool AllowMultiSelect { get; set; } = false;

  [Parameter]
  public bool AllowAddToQueue { get; set; } = false;

  [Parameter]
  public EventCallback<List<string>> OnAddToQueue { get; set; }

  private List<string>? _directories;
  private List<NotificationSoundDto>? _files;
  private bool _isLoading = true;
  private string? _currentPath;
  private NotificationSoundDto? SelectedFile { get; set; }
  private HashSet<NotificationSoundDto> SelectedFiles { get; set; } = new();

  protected override async Task OnInitializedAsync()
  {
    _currentPath = Subdirectory;
    await LoadContentsAsync();
  }

  private async Task LoadContentsAsync()
  {
    _isLoading = true;
    StateHasChanged();

    try
    {
      // Load both directories and files in parallel
      var dirTask = SourcesApi.GetSoundDirectoriesAsync(_currentPath);
      var filesTask = SourcesApi.GetNotificationSoundsAsync(_currentPath);

      await Task.WhenAll(dirTask, filesTask);

      _directories = await dirTask;
      _files = await filesTask;

      // Set initial selection if provided and we're at the right path
      if (!string.IsNullOrWhiteSpace(InitialSelection) && _files != null)
      {
        var initialFile = _files.FirstOrDefault(f => f.FilePath == InitialSelection);
        if (initialFile != null)
        {
          if (AllowMultiSelect)
          {
            SelectedFiles.Add(initialFile);
          }
          else
          {
            SelectedFile = initialFile;
          }
        }
      }
    }
    catch (Exception ex)
    {
      Logger.LogError(ex, "Failed to load audio files for selection dialog");
      _directories = null;
      _files = null;
    }
    finally
    {
      _isLoading = false;
      StateHasChanged();
    }
  }

  private async Task NavigateToFolder(string folderName)
  {
    _currentPath = string.IsNullOrEmpty(_currentPath)
      ? folderName
      : $"{_currentPath}/{folderName}";

    // Clear selection when navigating
    SelectedFile = null;
    SelectedFiles.Clear();
    await LoadContentsAsync();
  }

  private async Task NavigateUp()
  {
    if (string.IsNullOrEmpty(_currentPath))
      return;

    var parts = _currentPath.Split('/', '\\').Where(p => !string.IsNullOrEmpty(p)).ToArray();
    _currentPath = parts.Length > 1
      ? string.Join("/", parts.Take(parts.Length - 1))
      : null;

    // Clear selection when navigating
    SelectedFile = null;
    SelectedFiles.Clear();
    await LoadContentsAsync();
  }

  private async Task NavigateToPath(string? path)
  {
    _currentPath = path;
    // Clear selection when navigating
    SelectedFile = null;
    SelectedFiles.Clear();
    await LoadContentsAsync();
  }

  private void ToggleFileSelection(NotificationSoundDto file)
  {
    if (AllowMultiSelect)
    {
      if (SelectedFiles.Contains(file))
      {
        SelectedFiles.Remove(file);
      }
      else
      {
        SelectedFiles.Add(file);
      }
    }
    else
    {
      SelectedFile = file;
    }
  }

  private void SelectAllFiles()
  {
    if (_files != null)
    {
      SelectedFiles = new HashSet<NotificationSoundDto>(_files);
      StateHasChanged();
    }
  }

  private void DeselectAllFiles()
  {
    SelectedFiles.Clear();
    StateHasChanged();
  }

  private string FormatTotalDuration()
  {
    // Calculate total file size of selected files
    var totalSize = SelectedFiles.Sum(f => f.FileSize);
    return FormatFileSize(totalSize);
  }

  private async Task AddToQueue()
  {
    if (OnAddToQueue.HasDelegate)
    {
      var filePaths = AllowMultiSelect
        ? SelectedFiles.Select(f => f.FilePath).ToList()
        : SelectedFile != null ? new List<string> { SelectedFile.FilePath } : new List<string>();

      await OnAddToQueue.InvokeAsync(filePaths);
      
      // Don't close dialog, just clear selection to allow adding more
      if (AllowMultiSelect)
      {
        SelectedFiles.Clear();
      }
      else
      {
        SelectedFile = null;
      }
      StateHasChanged();
    }
  }

  private void Submit()
  {
    if (AllowMultiSelect)
    {
      var filePaths = SelectedFiles.Select(f => f.FilePath).ToList();
      MudDialog.Close(DialogResult.Ok(filePaths));
    }
    else
    {
      MudDialog.Close(DialogResult.Ok(SelectedFile?.FilePath));
    }
  }

  private void Cancel()
  {
    MudDialog.Cancel();
  }

  private static string FormatFileSize(long bytes)
  {
    string[] sizes = { "B", "KB", "MB", "GB" };
    double len = bytes;
    int order = 0;
    while (len >= 1024 && order < sizes.Length - 1)
    {
      order++;
      len = len / 1024;
    }
    return $"{len:0.##} {sizes[order]}";
  }
}
