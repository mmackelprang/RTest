@using Radio.Web.Models
@using Radio.Web.Services.ApiClients

<!-- Click-away overlay (onclick + ontouchend for reliable touch dismissal) -->
@if (IsOpen)
{
  <div @onclick="Close" @onclick:stopPropagation="true"
       @ontouchend="Close" @ontouchend:stopPropagation="true"
       style="position: fixed; inset: 0; z-index: 99; -webkit-tap-highlight-color: transparent;"></div>
  <div @onclick:stopPropagation="true" @ontouchend:stopPropagation="true"
       style="position: absolute; top: 100%; right: 0; z-index: 100; min-width: 280px; max-width: 340px;
              background: rgba(30,30,30,0.95); backdrop-filter: blur(12px);
              border: 1px solid rgba(255,255,255,0.15); border-radius: 8px;
              box-shadow: 0 8px 24px rgba(0,0,0,0.5); overflow: hidden;">

    <!-- Header -->
    <div style="display: flex; justify-content: space-between; align-items: center; padding: 8px 12px;
                border-bottom: 1px solid rgba(255,255,255,0.1); background: rgba(0,0,0,0.3);">
      <span style="font-size: 12px; font-weight: 500; color: var(--text-medium);">Cast Devices</span>
      @if (_isScanning)
      {
        <MudProgressCircular Size="Size.Small" Color="Color.Primary" Indeterminate="true"
                             Style="width: 14px; height: 14px;" />
      }
      else
      {
        <MudIconButton Icon="@Icons.Material.Filled.Refresh" Size="Size.Small"
                       Style="padding: 2px;" OnClick="RescanAsync" title="Rescan" />
      }
    </div>

    <!-- Connected device banner -->
    @if (_connectedDevice != null)
    {
      <div style="display: flex; align-items: center; gap: 8px; padding: 8px 12px;
                  background: rgba(76,175,80,0.12); border-bottom: 1px solid rgba(255,255,255,0.06);">
        <MudIcon Icon="@Icons.Material.Filled.CastConnected" Size="Size.Small" Color="Color.Success" />
        <span style="flex: 1; font-size: 12px; color: #4caf50; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">
          @_connectedDevice.Name
        </span>
        <MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Error"
                   OnClick="DisconnectAsync" Style="font-size: 11px; text-transform: none; min-width: auto; padding: 0 6px;">
          Disconnect
        </MudButton>
      </div>
    }

    <!-- Device list -->
    <div style="max-height: 200px; overflow-y: auto;">
      @if (_devices != null && _devices.Count > 0)
      {
        @foreach (var device in _devices)
        {
          var isConnected = _connectedDevice?.Id == device.Id;
          var isLive = _discoveredIds.Contains(device.Id);
          <div @onclick="@(() => SelectDeviceAsync(device))"
               style="display: flex; align-items: center; gap: 8px; padding: 6px 12px; cursor: pointer;
                      @(isConnected ? "opacity: 0.5; pointer-events: none;" : "")
                      transition: background 0.15s;"
               class="cast-device-row">
            <MudIcon Icon="@GetDeviceIcon(device)" Size="Size.Small"
                     Style="font-size: 18px; color: var(--text-medium);" />
            <div style="flex: 1; min-width: 0;">
              <div style="font-size: 12px; color: var(--text-high); white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">
                @device.Name
              </div>
              <div style="font-size: 10px; color: var(--text-low);">@device.Model</div>
            </div>
            @if (_scanCompleted)
            {
              <span style="font-size: 9px; padding: 1px 5px; border-radius: 4px;
                           @(isLive
                             ? "color: #4caf50; border: 1px solid rgba(76,175,80,0.4);"
                             : "color: var(--text-low); border: 1px solid rgba(255,255,255,0.15);")">
                @(isLive ? "Live" : "Cached")
              </span>
            }
          </div>
        }
      }
      else if (!_isScanning)
      {
        <div style="padding: 16px; text-align: center; font-size: 12px; color: var(--text-low);">
          No Cast devices found
        </div>
      }
      else
      {
        <div style="padding: 16px; text-align: center; font-size: 12px; color: var(--text-low);">
          Searching...
        </div>
      }
    </div>

    @if (_isConnecting)
    {
      <div style="display: flex; align-items: center; gap: 6px; padding: 8px 12px;
                  border-top: 1px solid rgba(255,255,255,0.06); background: rgba(0,0,0,0.2);">
        <MudProgressCircular Size="Size.Small" Color="Color.Primary" Indeterminate="true"
                             Style="width: 14px; height: 14px;" />
        <span style="font-size: 11px; color: var(--text-medium);">Connecting...</span>
      </div>
    }
  </div>
}

<style>
  .cast-device-row:hover {
    background: rgba(255,255,255,0.06);
  }
</style>

@code {
  [Parameter] public bool IsOpen { get; set; }
  [Parameter] public EventCallback<bool> IsOpenChanged { get; set; }
  [Parameter] public EventCallback<CastDeviceDto> OnDeviceSelected { get; set; }
  [Parameter] public EventCallback OnDisconnect { get; set; }
  [Parameter] public DevicesApiService DevicesApi { get; set; } = null!;
  [Parameter] public CastDeviceDto? ConnectedDevice { get; set; }
  [Parameter] public ILogger? Logger { get; set; }

  private List<CastDeviceDto>? _devices;
  private CastDeviceDto? _connectedDevice;
  private HashSet<string> _discoveredIds = new();
  private bool _isScanning;
  private bool _scanCompleted;
  private bool _isConnecting;
  private bool _initialized;
  private CancellationTokenSource? _scanCts;

  protected override void OnParametersSet()
  {
    _connectedDevice = ConnectedDevice;

    if (IsOpen && !_initialized)
    {
      _initialized = true;
      _ = LoadAndScanAsync();
    }
    else if (!IsOpen)
    {
      _initialized = false;
    }
  }

  private async Task LoadAndScanAsync()
  {
    _scanCts?.Cancel();
    _scanCts = new CancellationTokenSource();
    var token = _scanCts.Token;

    // Phase 1: instant cache
    try
    {
      _devices = await DevicesApi.GetCachedCastDevicesAsync() ?? new();
      StateHasChanged();
    }
    catch (Exception ex)
    {
      Logger?.LogWarning(ex, "Failed to load cached Cast devices");
      _devices = new();
    }

    if (token.IsCancellationRequested) return;

    // Phase 2: background mDNS
    await ScanAsync(token);
  }

  private async Task ScanAsync(CancellationToken cancellationToken = default)
  {
    _isScanning = true;
    StateHasChanged();

    try
    {
      var discovered = await DevicesApi.DiscoverCastDevicesAsync(cancellationToken);
      if (cancellationToken.IsCancellationRequested) return;
      if (discovered != null)
      {
        _discoveredIds = discovered.Select(d => d.Id).ToHashSet();
        var merged = new List<CastDeviceDto>(discovered);
        foreach (var cached in _devices ?? [])
        {
          if (!_discoveredIds.Contains(cached.Id))
            merged.Add(cached);
        }
        _devices = merged;
      }
    }
    catch (OperationCanceledException)
    {
      // Discovery cancelled (dropdown closed)
    }
    catch (Exception ex)
    {
      Logger?.LogWarning(ex, "Cast discovery failed");
    }
    finally
    {
      _isScanning = false;
      _scanCompleted = true;
      if (!cancellationToken.IsCancellationRequested)
        StateHasChanged();
    }
  }

  private async Task RescanAsync()
  {
    _scanCts?.Cancel();
    _scanCts = new CancellationTokenSource();
    await ScanAsync(_scanCts.Token);
  }

  private async Task SelectDeviceAsync(CastDeviceDto device)
  {
    if (_connectedDevice?.Id == device.Id) return;

    _isConnecting = true;
    StateHasChanged();

    try
    {
      var success = await DevicesApi.ConnectToCastDeviceAsync(device);
      if (success)
      {
        _connectedDevice = device;
        await OnDeviceSelected.InvokeAsync(device);
        await Close();
      }
    }
    catch (Exception ex)
    {
      Logger?.LogError(ex, "Error connecting to Cast device: {Name}", device.Name);
    }
    finally
    {
      _isConnecting = false;
      StateHasChanged();
    }
  }

  private async Task DisconnectAsync()
  {
    try
    {
      await DevicesApi.DisconnectFromCastDeviceAsync();
      _connectedDevice = null;
      await OnDisconnect.InvokeAsync();
      await Close();
    }
    catch (Exception ex)
    {
      Logger?.LogError(ex, "Error disconnecting from Cast device");
    }
  }

  private async Task Close()
  {
    _scanCts?.Cancel();
    _isScanning = false;
    await IsOpenChanged.InvokeAsync(false);
  }

  private static string GetDeviceIcon(CastDeviceDto device)
  {
    var model = device.Model.ToLowerInvariant();
    if (model.Contains("audio") || model.Contains("speaker") || model.Contains("home"))
      return Icons.Material.Filled.Speaker;
    if (model.Contains("tv") || model.Contains("ultra"))
      return Icons.Material.Filled.Tv;
    if (model.Contains("display") || model.Contains("hub"))
      return Icons.Material.Filled.TabletAndroid;
    return Icons.Material.Filled.Cast;
  }
}
