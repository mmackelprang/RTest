@using Radio.Core.Configuration
@inject Radio.Web.Services.EncoderHudService Hud
@implements IDisposable

@*
  ENC-4 — the encoder HUD.

  A transient readout that appears beside the knob that produced it, at the same height. One
  component, two hosts: MainLayout renders it for every normal route (Variant=Normal, anchored to
  the left edge on the knob's own band), and Sleep.razor renders it inside the anti-burn-in drift
  wrapper (Variant=Sleep, centered by that wrapper's flex layout).

  The knobs are a vertical column to the LEFT of the LCD (handoff §9), so the bands run down the
  720px axis rather than across the 1920px one. ENC-4 originally shipped the horizontal reading of
  a since-corrected drawing; this is the 90° rotation of that, not a redesign.

  Geometry keys off the encoder index; content keys off the payload. The two are independent on
  purpose — the router's index-to-handler table is still the pre-ENC-5 one, so today a card can be
  in the right place and say the wrong word. Remapping the handlers later changes what it says
  without touching this component.

  Phase is an open string, not an enum. A phase this build does not know renders nothing rather
  than throwing, which is the correct degraded behaviour on a kiosk nobody is watching.
*@

@{
  var card = Hud.Current;
}

@if (card is not null && IsKnownPhase(card.Phase))
{
  @* role/aria-live make this a polite live region. Everything that carries meaning here is text —
     the fill bar and the ring are decoration and are aria-hidden — so what a screen reader (and
     AT-SPI, which is how this kiosk gets inspected remotely) announces is the label plus whatever
     the card is reading out. The muted state says the word MUTED; it is not signalled by colour
     alone. *@
  <div class="@RootClass(card)"
       style="@GeometryStyle(card)"
       data-encoder-index="@FrontPanelGeometry.ForIndex(card.EncoderIndex).Index"
       role="status"
       aria-live="polite"
       aria-atomic="true">

    <div class="encoder-hud-label">
      <span class="encoder-hud-label-text">@card.Label</span>
      @if (card.IsMuted)
      {
        <span class="encoder-hud-muted-chip">MUTED</span>
      }
      else if (card.PrimaryIsFrequency && !string.IsNullOrWhiteSpace(card.SecondaryText))
      {
        @* Frequency cards put their secondary line on the label row's right (handoff §6.4). *@
        <span class="encoder-hud-label-aside">@card.SecondaryText</span>
      }
    </div>

    @if (card.VolumePercent is int percent)
    {
      @* Volume card. Chosen off the payload rather than off the label so a relabelled card
         (for example the HOLD FOR STANDBY hold card) still renders as volume. *@
      <div class="encoder-hud-volume">
        <div class="encoder-hud-value-wrap">
          @if (Hud.IsHolding)
          {
            @* The ring is CSS-driven from 300 ms to 600 ms; the server sends only the two discrete
               hold edges. It is inside the volume branch, so only a card that carries a volume
               percentage can draw one. *@
            <div class="encoder-hud-ring" aria-hidden="true"></div>
          }
          <div class="encoder-hud-value">@percent</div>
        </div>
        <div class="encoder-hud-bar" aria-hidden="true">
          <div class="encoder-hud-bar-fill" style="width: @(ClampPercent(percent))%;"></div>
        </div>
      </div>
    }
    else if (card.PrimaryIsFrequency)
    {
      @* .display-frequency is applied verbatim, with no font-size override. The handoff quotes
         43px; the class is 42px after the PR #371 hot-fix, and reusing the class as-is is what
         keeps this readout and the tuner's frequency well from drifting apart. *@
      <div class="display-frequency">@card.PrimaryText</div>
    }
    else
    {
      @if (!string.IsNullOrWhiteSpace(card.PrimaryText))
      {
        <div class="encoder-hud-primary">@card.PrimaryText</div>
      }
      @if (!string.IsNullOrWhiteSpace(card.SecondaryText))
      {
        <div class="encoder-hud-secondary">@card.SecondaryText</div>
      }
    }
  </div>
}

@code {
  /// <summary>Which host this instance is rendering into. Decides geometry and chrome.</summary>
  [Parameter]
  public EncoderHudVariant Variant { get; set; } = EncoderHudVariant.Normal;

  private bool _disposed;

  protected override void OnInitialized()
  {
    Hud.StateChanged += OnHudStateChanged;
  }

  public void Dispose()
  {
    _disposed = true;
    Hud.StateChanged -= OnHudStateChanged;
  }

  // EncoderHudService raises StateChanged from whichever thread published — for the 1500 ms
  // dismissal that is a thread-pool thread — so the re-render is marshalled onto the circuit.
  // The service is a process-wide singleton and can raise concurrently with Dispose's
  // unsubscribe, so the flag is checked as well.
  private void OnHudStateChanged()
  {
    if (_disposed) return;
    _ = InvokeAsync(() =>
    {
      if (_disposed) return;
      StateHasChanged();
    });
  }

  /// <summary>
  /// Phases this build renders. Anything else renders nothing — the forward-compatibility contract
  /// a newer API build relies on (handoff §6.10).
  /// </summary>
  private static bool IsKnownPhase(string? phase) => EncoderHudService.IsKnownPhase(phase);

  private static int ClampPercent(int percent) => Math.Clamp(percent, 0, 100);

  // Normal: the card is pinned to its knob's band. The inline style carries only the band centre;
  // the left offset, the vertical centring on that centre and the viewport clamp are all in the
  // .encoder-hud rule, which reads this one value. --encoder-band-y is not a design token (handoff
  // §6.9 forbids adding any) — it is the one per-encoder number the stylesheet cannot know, the
  // same standing --ring-turn has in that file.
  //
  // Sleep: no inline position at all — the drift wrapper in Sleep.razor centers it, and a
  // fixed-position card could not ride that wrapper.
  private string? GeometryStyle(EncoderHudDto card)
    => Variant == EncoderHudVariant.Sleep
      ? null
      : $"--encoder-band-y: {FrontPanelGeometry.ForIndex(card.EncoderIndex).HudBandYPx}px;";

  private string RootClass(EncoderHudDto card)
  {
    var classes = new List<string> { "encoder-hud" };
    if (Variant == EncoderHudVariant.Sleep)
    {
      // The sleep card is centred by the drift wrapper, not anchored to an edge, so it keeps the
      // original bottom-anchored .snackbar-enter. Handoff §6.1 scopes the mirrored pair to the
      // Normal variant only, and this is the half it deliberately leaves alone.
      classes.Add("encoder-hud--sleep");
      classes.Add("snackbar-enter");
    }
    else
    {
      // The mirrored, left-anchored entrance — handoff §6.1's declared exception to its own
      // "no new keyframes" rule, because a left-anchored card entering on translateY(100%) slides
      // in from an edge it is not attached to.
      classes.Add("encoder-hud-enter");
    }
    if (card.IsMuted)
    {
      classes.Add("is-muted");
    }
    return string.Join(' ', classes);
  }
}
