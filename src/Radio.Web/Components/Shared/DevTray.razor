@using System.Globalization
@inject AudioApiService AudioApi
@inject SystemApiService SystemApi
@inject AudioStateHubService AudioState
@inject VisualizerTelemetryService VizTelemetry
@inject NavigationManager Nav
@inject IJSRuntime JS
@inject ILogger<DevTray> Logger
@implements IDisposable

@*
  DevTray (handoff §P2·2, PR 6 of the design tightening arc).

  Hidden developer surface revealed by a 3-tap gesture on the invisible
  hit area left of the Home pill (see dev-gesture.js + MainLayout). Since UI-25 it opens under the
  point that was tapped (DevTrayPlacement), not in a fixed corner. Inside: a strip of live
  read-only readings, then a grid of action cards. Auto-locks after 30 seconds of no interaction so
  the tray never sits unlocked in a kiosk that was triple-tapped accidentally.

  UI-25: actions and readings are styled as different kinds of thing. Every action is a raised,
  accent-bordered card with an icon and a pressed state; readings are flat text with no border and
  are not buttons at all.

  UI-26: NO card navigates the browser away from the app. The kiosk has no tabs, address bar or back
  button, so a page outside the app is a page a finger cannot leave. File-shaped results are fetched
  server-side and saved with a blob download (fileDownload.downloadFromStream), and every outcome —
  success or failure — is written into the card that was tapped.

  Why a component instead of just an overlay:
    - The "Updates: NN/sec" reading needs a live SignalR-style subscription
      against VisualizerTelemetryService. That's a component subscription
      lifecycle, not a one-shot render.
    - The auto-lock countdown ticks every second and updates the header.
    - The "Mark distortion" action used to live in the topbar as a Debug-only
      pill (PR 2). Folding it into a real surface keeps the topbar clean.
*@

<div class="dev-tray @(IsOpen ? "is-open" : "")"
     style="@TrayStyle"
     role="dialog"
     aria-label="Dev tray"
     aria-hidden="@(IsOpen ? "false" : "true")">
  <div class="dev-tray-header">
    <span class="dev-tray-status">● Dev Tray · unlocked · auto-lock @_autoLockRemaining</span>
    <button type="button"
            class="dev-tray-close"
            @onclick="HandleCloseAsync"
            aria-label="Close dev tray">×</button>
  </div>

  @* Read-only readings. Plain elements, not buttons, so nothing about them invites a tap. *@
  <div class="dev-tray-readouts">
    <div class="dev-readout">
      <span class="dev-readout-label">Updates</span>
      <span class="dev-readout-value">@_updatesPerSecond/sec</span>
    </div>
    <div class="dev-readout">
      <span class="dev-readout-label">Engine state</span>
      <span class="dev-readout-value">@_engineState</span>
    </div>
  </div>

  <div class="dev-tray-grid">
    <button type="button"
            class="dev-card dev-card--action"
            @onclick="MarkDistortionAsync"
            disabled="@_distortionBusy"
            aria-label="Mark audio distortion">
      <span class="dev-card-head">
        <span class="dev-card-label">Mark distortion</span>
        <span class="dev-card-icon" aria-hidden="true"><RadzenIcon Icon="flag" /></span>
      </span>
      @StatusLine(_distortion, "logs an audio-state snapshot")
    </button>

    <button type="button"
            class="dev-card dev-card--action"
            @onclick="DumpAudioFrameAsync"
            disabled="@_dumpBusy"
            aria-label="Dump audio frame">
      <span class="dev-card-head">
        <span class="dev-card-label">Dump audio frame</span>
        <span class="dev-card-icon" aria-hidden="true"><RadzenIcon Icon="download" /></span>
      </span>
      @StatusLine(_dump, "asks the API for a WAV")
    </button>

    <button type="button"
            class="dev-card dev-card--action"
            @onclick="DownloadLogsAsync"
            disabled="@_logsBusy"
            aria-label="Download logs">
      <span class="dev-card-head">
        <span class="dev-card-label">Download logs</span>
        <span class="dev-card-icon" aria-hidden="true"><RadzenIcon Icon="download" /></span>
      </span>
      @StatusLine(_logs, "last hour · .zip")
    </button>

    <button type="button"
            class="dev-card dev-card--action"
            @onclick="ViewFingerprintEvents"
            aria-label="View fingerprint events">
      <span class="dev-card-head">
        <span class="dev-card-label">Fingerprint events</span>
        <span class="dev-card-icon" aria-hidden="true"><RadzenIcon Icon="chevron_right" /></span>
      </span>
      @StatusLine(null, "opens Diagnostics")
    </button>

    @* LOG-5: flips radio-api's Radio / Radio.* log levels between configuration and Debug at
       runtime, without a restart. "Off" resets every switch to configuration, so it also undoes a
       change made directly through the endpoint. *@
    <button type="button"
            class="dev-card dev-card--action dev-card--wide @(_logVerbose ? "is-on" : "")"
            @onclick="ToggleVerboseLoggingAsync"
            disabled="@_logBusy"
            aria-pressed="@(_logVerbose ? "true" : "false")"
            aria-label="Toggle verbose logging">
      <span class="dev-card-head">
        <span class="dev-card-label">Verbose logs</span>
        <span class="dev-card-icon" aria-hidden="true"><RadzenIcon Icon="@(_logVerbose ? "toggle_on" : "toggle_off")" /></span>
      </span>
      <span class="dev-card-status">@_logStatus</span>
    </button>
  </div>
</div>

@code {
  /// <summary>Whether the tray is rendered open. Parent owns this state.</summary>
  [Parameter] public bool IsOpen { get; set; }

  /// <summary>
  /// Where to open (UI-25), computed by the parent from the tap that opened the tray. Null keeps the
  /// stylesheet's default position — the top-right corner, as before UI-25.
  /// </summary>
  [Parameter] public DevTrayPlacement? Placement { get; set; }

  /// <summary>
  /// Raised when the user explicitly closes the tray (× button) or the
  /// auto-lock timer elapses. Parent should set its own state to closed.
  /// </summary>
  [Parameter] public EventCallback OnClose { get; set; }

  private const int AutoLockSeconds = 30;

  // Bounds the two file fetches. Under SystemApiService's HttpClient timeout (30 s) so a slow API
  // reads "timed out" rather than "unreachable".
  private static readonly TimeSpan FileCallTimeout = TimeSpan.FromSeconds(25);

  private enum StatusKind { Busy, Ok, Error }

  /// <summary>
  /// The outcome a card shows after it was tapped: one status line, plus an optional single-line
  /// detail (the saved file's name).
  /// </summary>
  private sealed record CardStatus(string Text, StatusKind Kind, string? Detail = null)
  {
    public string CssClass => Kind switch
    {
      StatusKind.Ok => "is-ok",
      StatusKind.Error => "is-error",
      _ => "is-busy",
    };
  }

  private int _updatesPerSecond;
  private string _engineState = "—";
  private string _autoLockRemaining = "0:30";
  private CardStatus? _distortion;
  private CardStatus? _dump;
  private CardStatus? _logs;
  private bool _distortionBusy;
  private bool _dumpBusy;
  private bool _logsBusy;
  private string _logStatus = "checking…";
  private bool _logVerbose;
  private bool _logBusy;
  private Timer? _autoLockTimer;
  private DateTime _lastInteractionUtc = DateTime.UtcNow;
  private bool _disposed;
  private bool _wasOpen;

  // Width and open height come from DevTrayPlacement so the placement maths and the rendered box
  // share one definition. The CSS custom property drives .dev-tray.is-open's max-height.
  private string TrayStyle
  {
    get
    {
      var style = FormattableString.Invariant(
        $"width:{DevTrayPlacement.WidthPx}px;--dev-tray-open-h:{DevTrayPlacement.MaxHeightPx}px;");
      if (Placement is { } p)
      {
        style += FormattableString.Invariant($"left:{p.Left:0.#}px;right:auto;");
        style += p.Top is double top
          ? FormattableString.Invariant($"top:{top:0.#}px;bottom:auto;")
          : FormattableString.Invariant($"bottom:{p.Bottom:0.#}px;top:auto;");
      }
      return style;
    }
  }

  // A card's second line: its outcome once tapped, else a short low-contrast hint saying what it does.
  private RenderFragment StatusLine(CardStatus? status, string hint) => __builder =>
  {
    if (status is null)
    {
      <span class="dev-card-hint">@hint</span>
    }
    else
    {
      <span class="dev-card-status @status.CssClass" aria-live="polite">@status.Text</span>
      @if (status.Detail is not null)
      {
        <span class="dev-card-detail">@status.Detail</span>
      }
    }
  };

  protected override void OnInitialized()
  {
    VizTelemetry.UpdatesPerSecondChanged += OnUpdatesPerSecondChanged;
    _updatesPerSecond = VizTelemetry.UpdatesPerSecond;
    UpdateEngineState();

    // Ticks once per second to drive the auto-lock countdown header text
    // and to fire OnClose when the window elapses.
    _autoLockTimer = new Timer(_ =>
    {
      if (_disposed) return;
      _ = InvokeAsync(TickAutoLockAsync);
    }, null, TimeSpan.FromSeconds(1), TimeSpan.FromSeconds(1));
  }

  protected override void OnParametersSet()
  {
    // Each fresh open resets the auto-lock window. Closing the tray pauses
    // the countdown logic (TickAutoLockAsync no-ops while IsOpen=false).
    if (IsOpen && !_wasOpen)
    {
      _lastInteractionUtc = DateTime.UtcNow;
      _autoLockRemaining = FormatRemaining(AutoLockSeconds);
      UpdateEngineState();
      // Last session's outcomes are stale on a fresh open. A card still mid-call keeps its line so
      // the result lands where the operator expects it.
      if (!_distortionBusy) _distortion = null;
      if (!_dumpBusy) _dump = null;
      if (!_logsBusy) _logs = null;
      // Re-read on every open: the levels may have been changed through the endpoint, or reset by
      // an API restart, since the tray last looked.
      _ = InvokeAsync(RefreshLogStateOnOpenAsync);
    }
    _wasOpen = IsOpen;
  }

  private void OnUpdatesPerSecondChanged(int n)
  {
    _updatesPerSecond = n;
    _ = InvokeAsync(StateHasChanged);
  }

  private void UpdateEngineState()
  {
    // Engine state surfaces the audio-state hub's SignalR connection — when
    // it's "Connected" the engine is reachable; "Disconnected"/"Reconnecting"
    // signals the API tier is down (kiosk-debug useful).
    _engineState = AudioState.ConnectionState.ToString();
  }

  private async Task TickAutoLockAsync()
  {
    if (_disposed) return;
    if (!IsOpen)
    {
      // Tray closed — reset the countdown so the next open starts fresh.
      _lastInteractionUtc = DateTime.UtcNow;
      _autoLockRemaining = FormatRemaining(AutoLockSeconds);
      return;
    }

    UpdateEngineState();

    var elapsed = (int)(DateTime.UtcNow - _lastInteractionUtc).TotalSeconds;
    var remaining = AutoLockSeconds - elapsed;
    if (remaining <= 0)
    {
      _autoLockRemaining = "0:00";
      StateHasChanged();
      await OnClose.InvokeAsync();
      return;
    }

    _autoLockRemaining = FormatRemaining(remaining);
    StateHasChanged();
  }

  private static string FormatRemaining(int seconds)
  {
    var s = Math.Max(0, seconds);
    return $"0:{s:00}";
  }

  private void RecordInteraction()
  {
    _lastInteractionUtc = DateTime.UtcNow;
    _autoLockRemaining = FormatRemaining(AutoLockSeconds);
  }

  private async Task HandleCloseAsync()
  {
    RecordInteraction();
    await OnClose.InvokeAsync();
  }

  private async Task MarkDistortionAsync()
  {
    RecordInteraction();
    if (_distortionBusy) return;
    _distortionBusy = true;
    _distortion = new CardStatus("marking…", StatusKind.Busy);
    StateHasChanged();
    try
    {
      var ok = await AudioApi.ReportDistortionAsync();
      _distortion = ok
        ? new CardStatus("marked", StatusKind.Ok)
        : new CardStatus("failed · radio-api did not accept it", StatusKind.Error);
    }
    catch (Exception ex)
    {
      Logger.LogWarning(ex, "DevTray: failed to mark distortion");
      _distortion = new CardStatus("failed · unexpected error", StatusKind.Error);
    }
    finally
    {
      _distortionBusy = false;
      if (!_disposed) StateHasChanged();
    }
  }

  private Task DumpAudioFrameAsync() =>
    RunFileActionAsync(
      ct => SystemApi.DumpAudioFrameAsync(ct),
      "dumping…",
      busy => _dumpBusy = busy,
      status => _dump = status,
      () => _dumpBusy);

  private Task DownloadLogsAsync() =>
    RunFileActionAsync(
      ct => SystemApi.DownloadLogsAsync("1h", ct),
      "fetching…",
      busy => _logsBusy = busy,
      status => _logs = status,
      () => _logsBusy);

  /// <summary>
  /// UI-26. Fetch a file from radio-api on the server side, then either save it in the page (blob
  /// download — no navigation) or explain the failure in the card. The browser is never pointed at
  /// radio-api, so neither an error body nor an unreachable host can replace the app on screen.
  /// </summary>
  private async Task RunFileActionAsync(
    Func<CancellationToken, Task<ApiFileResult>> fetch,
    string busyText,
    Action<bool> setBusy,
    Action<CardStatus> setStatus,
    Func<bool> isBusy)
  {
    RecordInteraction();
    if (isBusy()) return;
    setBusy(true);
    setStatus(new CardStatus(busyText, StatusKind.Busy));
    StateHasChanged();
    try
    {
      ApiFileResult result;
      using (var cts = new CancellationTokenSource(FileCallTimeout))
      {
        result = await fetch(cts.Token);
      }
      setStatus(await SaveOrExplainAsync(result));
    }
    catch (Exception ex)
    {
      Logger.LogWarning(ex, "DevTray: file action failed");
      setStatus(new CardStatus("failed · unexpected error", StatusKind.Error));
    }
    finally
    {
      setBusy(false);
      // The fetch can take up to FileCallTimeout; restart the auto-lock window so the result stays
      // on screen long enough to be read.
      RecordInteraction();
      if (!_disposed) StateHasChanged();
    }
  }

  private async Task<CardStatus> SaveOrExplainAsync(ApiFileResult result)
  {
    if (!result.Success || result.Content is null)
    {
      var reason = result.Error ?? "failed";
      return new CardStatus(result.StatusCode is int code ? $"{code} · {reason}" : reason, StatusKind.Error);
    }

    var fileName = result.FileName ?? "download.bin";
    bool handedOver;
    try
    {
      using var stream = new MemoryStream(result.Content, writable: false);
      using var streamRef = new DotNetStreamReference(stream);
      handedOver = await JS.InvokeAsync<bool>("fileDownload.downloadFromStream", fileName, streamRef);
    }
    catch (Exception ex)
    {
      Logger.LogWarning(ex, "DevTray: browser save failed");
      handedOver = false;
    }

    // "Sent", not "saved": true from the page means the download was handed to the browser. Whether
    // it then lands on disk silently, asks where to save, or is blocked is browser policy, which
    // nothing here can observe. On the kiosk it lands in the box user's Downloads folder.
    return handedOver
      ? new CardStatus($"sent to downloads · {FormatSize(result.Content.Length)}", StatusKind.Ok, fileName)
      : new CardStatus("failed · the browser would not take the file", StatusKind.Error);
  }

  internal static string FormatSize(long bytes) => bytes switch
  {
    < 1024 => string.Create(CultureInfo.InvariantCulture, $"{bytes} B"),
    < 1024 * 1024 => string.Create(CultureInfo.InvariantCulture, $"{bytes / 1024.0:0.#} KB"),
    _ => string.Create(CultureInfo.InvariantCulture, $"{bytes / (1024.0 * 1024.0):0.#} MB"),
  };

  // Bounds each logging-endpoint call so a hung API cannot leave the card disabled for HttpClient's
  // 100 s default.
  private static readonly TimeSpan LogCallTimeout = TimeSpan.FromSeconds(10);

  private async Task RefreshLogStateOnOpenAsync()
  {
    // Busy while the first read is in flight, so a tap cannot act on the stale "off" default.
    _logBusy = true;
    try
    {
      await RefreshLogStateAsync();
    }
    finally
    {
      _logBusy = false;
      if (!_disposed) StateHasChanged();
    }
  }

  private async Task RefreshLogStateAsync()
  {
    if (_disposed) return;
    using var cts = new CancellationTokenSource(LogCallTimeout);
    var levels = await SystemApi.GetLogLevelsAsync(cts.Token);
    if (levels is null)
    {
      _logStatus = "unavailable";
    }
    else
    {
      // "Runtime" means any switch differs from configuration — including one changed directly
      // through the endpoint, not only by this card. A tap then resets everything.
      _logVerbose = SystemApiService.IsRuntimeModified(levels);
      _logStatus = _logVerbose ? "runtime · tap to reset" : "config · tap for Debug";
    }
    if (!_disposed) StateHasChanged();
  }

  private async Task ToggleVerboseLoggingAsync()
  {
    RecordInteraction();
    _logBusy = true;
    _logStatus = "…";
    StateHasChanged();
    try
    {
      bool ok;
      using (var cts = new CancellationTokenSource(LogCallTimeout))
      {
        ok = _logVerbose
          ? await SystemApi.ResetLogLevelsAsync(cts.Token)
          : await SystemApi.EnableVerboseRadioLoggingAsync(cts.Token);
      }
      // Refresh either way: a partly failed enable can still have changed some switches, and the
      // reading must reflect what the API is actually running.
      await RefreshLogStateAsync();
      if (!ok)
      {
        _logStatus = "failed";
      }
    }
    finally
    {
      _logBusy = false;
      if (!_disposed) StateHasChanged();
    }
  }

  private async Task ViewFingerprintEvents()
  {
    RecordInteraction();
    // UI-5 / UI-2: the fingerprint.* tiles live in Settings → Diagnostics, which /diagnostics opens
    // directly. There is no fingerprint-only view; the card lands on the whole panel, where the
    // FINGERPRINT group is one of the categories. An in-app route: the topbar stays on screen, so
    // this is not a UI-26 trap. The tray closes as it goes, rather than floating over the page it
    // just opened.
    Nav.NavigateTo("/diagnostics");
    await OnClose.InvokeAsync();
  }

  public void Dispose()
  {
    _disposed = true;
    VizTelemetry.UpdatesPerSecondChanged -= OnUpdatesPerSecondChanged;
    _autoLockTimer?.Dispose();
    _autoLockTimer = null;
  }
}
