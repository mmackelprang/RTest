@rendermode InteractiveServer
@inject AudioApiService AudioApi
@inject RadioApiService RadioApi
@inject AudioStateHubService HubService
@inject ConfigurationApiService ConfigApi
@inject ILogger<NowPlayingPanel> Logger
@inject NotificationService NotificationService
@implements IAsyncDisposable

<div style="height: 100%; display: flex; flex-direction: column; position: relative; overflow: hidden;">
  @* PR 4 note: NowPlayingPanel already had no centered-spinner initial-load
     branch — it renders an empty/"No Track Playing" state immediately, then
     swaps to real content via SignalR updates. The handoff §P1·5 skeleton
     swap is therefore a no-op here. Acceptance criterion ("no centered
     spinner in any panel-body loading branch") is met without a Skeleton. *@

  <!-- Full-bleed album art background -->
  @if (_hasValidAlbumArt)
  {
    <div style="position: absolute; inset: 0; background-image: url('@_albumArtUrl'); background-size: cover; background-position: center; filter: blur(20px) brightness(0.3); transform: scale(1.1);"></div>
    @* Static on purpose. This layer used to run an infinite "Ken Burns" zoom while playing, and
       because it is blurred, every frame re-blurred it: measured on the kiosk 2026-10-06, the zoom
       alone cost ~41% of a core in Chrome (91% -> 50% with it off). Do not animate a filtered layer. *@
    <img src="@_albumArtUrl" alt="" referrerpolicy="no-referrer"
         style="display: none;" @onerror="OnAlbumArtError" />
  }
  else
  {
    <div style="position: absolute; inset: 0; background: var(--surface-inset);"></div>
  }

  @* The 36 px source + frequency strip that used to sit here was removed by the main-page status-bar
     redesign (owner, 2026-10-06): the source is named by the topbar's IN cluster and the frequency by
     the radio panel. Its gain cell moved to the status bar at the top of the transport block below. *@

  <!-- Album art — large, nearly panel-width -->
  <div style="position: relative; z-index: 1; flex: 1; display: flex; align-items: center; justify-content: center; padding: 12px; min-height: 0;">
    @if (_showFingerprintDetail)
    {
      @* Recognition stream — replaces the legacy <table>+telemetry-strip block
         per PR 2 of the Radio Controller Polish arc. NOW/EARLIER headers
         anchor the active match (_radioState.NowPlayingMatchId) at the top
         with an amber left-border + dot; older matches list beneath with
         time-ago labels. Failed lookups render as italic "No match in window"
         sentences. Confidence reads as <ConfidencePips/>, never as a raw
         percentage. The telemetry strip (Fingerprints/min · Lookups/min) is
         removed entirely from the panel header; if it resurfaces it'll live
         in the DevTray (Arc 1 PR 6) in a future PR. *@
      <div style="width: 100%; height: 100%; display: flex; flex-direction: column; background: rgba(0,0,0,0.75); backdrop-filter: blur(8px); border-radius: 8px; overflow: hidden; border: 1px solid rgba(255,255,255,0.1);">
        <div style="display: flex; justify-content: flex-end; align-items: center; padding: 6px 8px; border-bottom: 1px solid rgba(255,255,255,0.1); background: rgba(0,0,0,0.3);">
          <RadzenButton Icon="close" Size="ButtonSize.Small" ButtonStyle="ButtonStyle.Light"
                        Variant="Variant.Text" Click="@ToggleFingerprintDetail" Style="padding: 2px;"
                        title="Close recognition stream" />
        </div>
        <div style="flex: 1; overflow-y: auto;">
          @if (_fpEventsReversed != null && _fpEventsReversed.Count > 0)
          {
            var nowMatchId = _radioState?.NowPlayingMatchId;
            var nowMatch = !string.IsNullOrEmpty(nowMatchId)
              ? _fpEventsReversed.FirstOrDefault(e => e.MatchId == nowMatchId)
              : null;
            var earlierMatches = nowMatch != null
              ? _fpEventsReversed.Where(e => e.MatchId != nowMatch.MatchId).ToList()
              : _fpEventsReversed.ToList();
            <div class="np-recognition-stream">
              @if (nowMatch != null)
              {
                <div class="np-recognition-header">NOW</div>
                <div class="np-recognition-row np-recognition-row-current" data-match-id="@nowMatch.MatchId">
                  <span class="np-recognition-art-wrap is-current">
                    <span class="np-recognition-art-placeholder">♪</span>
                  </span>
                  @if (string.IsNullOrEmpty(nowMatch.Title))
                  {
                    <span class="np-recognition-title np-recognition-no-match">No match in window</span>
                  }
                  else
                  {
                    <div class="np-recognition-text">
                      <div class="np-recognition-title">@nowMatch.Title</div>
                      <div class="np-recognition-artist">@(string.IsNullOrEmpty(nowMatch.Artist) ? "—" : nowMatch.Artist)</div>
                    </div>
                  }
                  <ConfidencePips Bucket="@nowMatch.Confidence" />
                  <span class="np-recognition-now-tag">now</span>
                </div>
              }
              @if (earlierMatches.Count > 0)
              {
                <div class="np-recognition-header">EARLIER</div>
                @foreach (var evt in earlierMatches)
                {
                  <div class="np-recognition-row" data-match-id="@evt.MatchId">
                    <span class="np-recognition-art-wrap">
                      <span class="np-recognition-art-placeholder">♪</span>
                    </span>
                    @if (string.IsNullOrEmpty(evt.Title))
                    {
                      <span class="np-recognition-title np-recognition-no-match">No match in window</span>
                    }
                    else
                    {
                      <div class="np-recognition-text">
                        <div class="np-recognition-title">@evt.Title</div>
                        <div class="np-recognition-artist">@(string.IsNullOrEmpty(evt.Artist) ? "—" : evt.Artist)</div>
                      </div>
                    }
                    <ConfidencePips Bucket="@evt.Confidence" />
                    <span class="np-recognition-time-ago">@Timestamps.FormatRecentRelative(evt.Timestamp)</span>
                  </div>
                }
              }
            </div>
          }
          else
          {
            <div style="padding: 16px; text-align: center; color: var(--text-low); font-family: var(--font-mono); font-size: 11px;">
              No fingerprint events yet
            </div>
          }
        </div>
      </div>
    }
    else if (_hasValidAlbumArt)
    {
      <div style="position: relative; width: 100%; max-width: 340px; aspect-ratio: 1; border-radius: 8px; overflow: hidden; box-shadow: 0 8px 32px rgba(0,0,0,0.5);">
        <img src="@_albumArtUrl" alt="Album Art" referrerpolicy="no-referrer"
             style="width: 100%; height: 100%; object-fit: cover;" />
        <!-- Metadata overlay on bottom of art.
             Title/subtitle routed through DisplayNames.Track so a generic "Track N"
             from the metadata reader gets upgraded to the cleaned-up filename, and
             the default-placeholder artist "--" surfaces as an em-dash. -->
        <div style="position: absolute; bottom: 0; left: 0; right: 0; padding: 12px 14px 10px; background: linear-gradient(transparent, rgba(0,0,0,0.85) 40%); text-align: left;">
          <div style="font-size: 22px; font-weight: 600; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; color: #fff; text-shadow: 0 1px 6px rgba(0,0,0,0.8);">
            @_displayTitle
          </div>
          <div style="font-size: 15px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; color: rgba(255,255,255,0.85); text-shadow: 0 1px 3px rgba(0,0,0,0.7); margin-top: 2px;">
            @_displaySubtitle
          </div>
          @if (!string.IsNullOrEmpty(_album) && _album != "--")
          {
            <div style="font-size: 13px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; color: rgba(255,255,255,0.6); text-shadow: 0 1px 2px rgba(0,0,0,0.6); margin-top: 1px;">
              @_album
            </div>
          }
        </div>
      </div>
    }
    else
    {
      <div style="display: flex; flex-direction: column; align-items: center; justify-content: center; text-align: center;">
        <RadzenIcon Icon="music_note" Style="font-size: 96px; color: var(--text-low); margin-bottom: 16px;" />
        <div style="font-size: 28px; font-weight: 600; color: var(--text-high);">
          @_displayTitle
        </div>
        <div style="font-size: 18px; color: var(--text-medium); margin-top: 4px;">
          @_displaySubtitle
        </div>
      </div>
    }

  </div>

  <!-- Transport bar — anchored to bottom with glass effect -->
  @* The glass (background + backdrop blur) is its own layer rather than a style on this box. A
     backdrop-filter or z-index here would make this box a stacking context, and the source-gain
     popover and its backdrop below — 10000 and 9999 — would then be trapped inside it, under the
     album-art container (z-index 1) and the radio panel. See design-system.css §Z. *@
  <div class="np-transport">
    <div class="np-transport-glass" aria-hidden="true"></div>
    <div class="np-transport-body">
    @* Status bar (main-page status-bar redesign, 2026-10-06): the first row of the transport block,
       for every source. Three slots at fixed widths — Mute (104 px) | Fingerprint (flex) | Gain (96 px)
       — so no state change moves anything. The fingerprint slot reports song recognition only; RDS
       plays no part in recognition and is not shown here. CSS: design-system.css §Y. *@
    <div class="np-status-bar" role="group" aria-label="Playback status">
      <button type="button"
              class="np-bar-slot np-bar-mute @(_isMuted ? "is-muted" : null)"
              @onclick="HandleMuteAsync"
              aria-pressed="@(_isMuted ? "true" : "false")"
              aria-label="@(_isMuted ? "Audio is muted. Tap to unmute." : "Tap to mute")">
        <RadzenIcon Icon="@(_isMuted ? "volume_off" : "volume_up")" />
        <span class="np-bar-label">@(_isMuted ? "Muted" : "Sound")</span>
      </button>
      @{
        var fpState = FingerprintSlot;
      }
      <button type="button"
              class="np-bar-slot np-bar-fp @FingerprintSlotClass(fpState)"
              @onclick="ToggleFingerprintDetail"
              aria-label="@($"Song recognition: {FingerprintSlotLabel(fpState)}. Tap to view the recognition stream.")">
        @if (fpState == FingerprintSlotState.Match)
        {
          <ConfidencePips Bucket="@(_activeMatch?.Confidence ?? ConfidenceBucket.None)" />
        }
        <span class="np-bar-fp-label">@FingerprintSlotLabel(fpState)</span>
      </button>
      <button type="button"
              class="np-bar-slot np-bar-gain @(IsSourceGainOffset ? "is-offset" : null)"
              @onclick="ToggleGainPopover"
              disabled="@string.IsNullOrEmpty(_nowPlayingSourceType)"
              aria-expanded="@(_showGainPopover ? "true" : "false")"
              aria-label="@($"Source gain {GainControlPopover.FormatGainDb(_currentSourceGain)}. Tap to adjust.")">
        <span class="np-bar-gain-value">@GainControlPopover.FormatGainDb(_currentSourceGain)</span>
      </button>
    </div>

    <!-- Progress Bar (full width) -->
    @if (!string.IsNullOrEmpty(_position) && !string.IsNullOrEmpty(_duration))
    {
      <div style="margin-bottom: 4px;">
        @if (_canSeek)
        {
          @* AUD-28 (owner ruling 2026-09-25): SEEK ON RELEASE, no debounce. RadzenSlider's Change fires
             on every drag frame (Radzen.Blazor 6.6.4's mousemove/touchmove handler invokes
             OnValueChange each time) and it has no release event, so every frame became an engine
             seek and scrubbing stuttered. SeekBar commits once, on release; OnScrub only moves the
             elapsed readout. *@
          <SeekBar Class="np-seek-bar"
                   Fraction="@(_progressPercent / 100.0)"
                   OnScrub="OnSeekScrub"
                   OnSeek="@((double f) => HandleSeekAsync(f * 100.0))"
                   AriaLabel="Playback position"
                   AriaValueMin="0"
                   AriaValueMax="100"
                   AriaValueNow="@((_scrubPercent ?? _progressPercent).ToString("0", System.Globalization.CultureInfo.InvariantCulture))"
                   AriaValueText="@(_scrubPosition ?? _position)" />
        }
        else
        {
          @* Value stays full-precision so the bar width is smooth; the Template
             overrides RadzenProgressBar's default label (which would print the
             raw double, e.g. "47.8234917%") with the rounded whole-number
             string from the shared projection. *@
          <RadzenProgressBar Value="@_progressPercent" ProgressBarStyle="ProgressBarStyle.Primary" Style="height: 4px;">
            <Template>@_progressPercentDisplay</Template>
          </RadzenProgressBar>
        }
        <div style="display: flex; justify-content: space-between; font-size: 13px; color: var(--text-medium); margin-top: -2px; font-family: var(--font-mono); font-variant-numeric: tabular-nums;">
          <span>@(_scrubPosition ?? _position)</span>
          <span>@_duration</span>
        </div>
      </div>
    }
    else if (!string.IsNullOrEmpty(_position) && _position != "0:00")
    {
      <div style="text-align: center; font-size: 13px; color: var(--text-medium); margin-bottom: 4px; font-family: var(--font-mono); font-variant-numeric: tabular-nums;">
        <span>@_position</span>
      </div>
    }

    <!-- Volume Control -->
    <div style="display: flex; align-items: center; gap: 8px; margin-bottom: 4px;">
      @* Kept beside the slider by owner decision (2026-10-06), although the status bar's Mute slot
         toggles the same state. *@
      <RadzenButton Icon="@(_isMuted ? "volume_off" : "volume_up")"
                    ButtonStyle="ButtonStyle.Light" Size="ButtonSize.Medium"
                    Variant="Variant.Text"
                    Style="min-width: 44px; min-height: 44px;"
                    Click="@HandleMuteAsync" />
      <RadzenSlider TValue="double" Value="_volume" Change="@OnVolumeChanged"
                    Min="0" Max="1" Step="0.01"
                    Style="flex: 1;" />
      <span style="font-family: var(--font-mono); font-size: 14px; color: var(--text-medium); min-width: 40px; text-align: right;">@((_volume * 100).ToString("F0"))%</span>
    </div>

    <!-- Transport Controls -->
    <div class="transport-group">
      <RadzenButton Icon="shuffle"
                    ButtonStyle="@(_isShuffleEnabled ? ButtonStyle.Primary : ButtonStyle.Light)"
                    Size="ButtonSize.Medium"
                    Variant="Variant.Text"
                    class="transport-btn"
                    Style="@(_isShuffleEnabled ? "background: rgba(92,212,232,0.15); border: 1px solid rgba(92,212,232,0.4); border-radius: 8px;" : "")"
                    Click="@HandleShuffleAsync"
                    title="Shuffle" />
      <RadzenButton Icon="skip_previous"
                    ButtonStyle="ButtonStyle.Light"
                    Size="ButtonSize.Medium"
                    Variant="Variant.Text"
                    class="transport-btn"
                    Click="@HandlePreviousAsync"
                    title="Previous" />
      <RadzenButton Icon="@(_isPlaying ? "pause" : "play_arrow")"
                    ButtonStyle="ButtonStyle.Primary"
                    Size="ButtonSize.Large"
                    Variant="Variant.Text"
                    class="transport-btn-primary"
                    Click="@HandlePlayPauseAsync"
                    title="@(_isPlaying ? "Pause" : "Play")" />
      <RadzenButton Icon="skip_next"
                    ButtonStyle="ButtonStyle.Light"
                    Size="ButtonSize.Medium"
                    Variant="Variant.Text"
                    class="transport-btn"
                    Click="@HandleNextAsync"
                    title="Next" />
      <RadzenButton Icon="@(_repeatMode == "One" ? "repeat_one" : "repeat")"
                    ButtonStyle="@(_repeatMode != "Off" ? ButtonStyle.Primary : ButtonStyle.Light)"
                    Size="ButtonSize.Medium"
                    Variant="Variant.Text"
                    class="transport-btn"
                    Style="@(_repeatMode != "Off" ? "background: rgba(92,212,232,0.15); border: 1px solid rgba(92,212,232,0.4); border-radius: 8px;" : "")"
                    Click="@HandleRepeatAsync"
                    title="@($"Repeat: {_repeatMode}")" />
    </div>
    </div> @* .np-transport-body *@

    @* Source-gain popover, opening upward from the bar's gain slot, with its click-away backdrop
       (design-system.css §Z). Both are children of .np-transport, which is not a stacking context, so
       their z-indexes compete across the whole Home page: the backdrop covers the radio panel too, and
       a tap anywhere outside the card closes it. (The backdrop used to be mounted by MainLayout,
       outside .page-transition, and so painted above this card as well: hit-tested in Chromium on a
       replica of the layout's stacking, 2026-10-06, a tap on the card landed on the backdrop.) *@
    @if (_showGainPopover && !string.IsNullOrEmpty(_nowPlayingSourceType))
    {
      <div class="np-gain-popover-backdrop" @onclick="CloseGainPopover" aria-hidden="true"></div>
      <div class="np-gain-popover-anchor">
        <GainControlPopover IsOpen="true"
                            SourceKicker="@GainPopoverKicker"
                            Title="Source gain"
                            CurrentValue="@_currentSourceGain"
                            OnValueChanged="OnGainSliderChanged"
                            OnReset="ResetGain" />
      </div>
    }
  </div>
</div>

@code {
  private bool _isPlaying;
  private bool _isMuted;
  private bool _isShuffleEnabled;
  private string _repeatMode = "Off";
  private double _volume = 0.75;
  private string? _title;
  private string? _artist;
  private string? _album;
  // Cached display projections recomputed by ApplyDisplayProjection() whenever the
  // underlying now-playing payload changes. We keep _title/_artist as raw caches so
  // change detection / polling fallbacks still work; the UI binds to _display* instead.
  private string _displayTitle = "No Track Playing";
  private string _displaySubtitle = "—";
  private string? _albumArtUrl;
  private bool _albumArtFailed;
  private string? _source;
  private string? _position;
  private string? _duration;
  private bool _canSeek;
  private double _progressPercent;
  // Rounded, human-readable progress percent (e.g. "48%") from the shared
  // projection. Bound to the progress-bar label so it never shows the raw
  // decimal tail; _progressPercent (full precision) still drives the bar width.
  private string _progressPercentDisplay = "0%";
  // AUD-28: set only while the seek bar is being dragged, so the elapsed readout follows the finger
  // even though no seek is sent until release. Null otherwise; a poll landing mid-drag writes
  // _position underneath without moving what is displayed.
  private string? _scrubPosition;
  private double? _scrubPercent;
  private double _totalDurationSeconds;
  // Fingerprint status state
  private FingerprintStatusDto? _fpStatus;
  // Pre-reversed event list cached when fingerprint status refreshes,
  // avoids calling .Reverse() on every render.
  private List<FingerprintEventDto>? _fpEventsReversed;
  private bool _showFingerprintDetail;
  // Set once the first fingerprint-status read has returned, either way. The API client answers a
  // failed read with null, so a null _fpStatus after this means "unavailable", before it "not yet".
  private bool _fpStatusReadAttempted;

  // PR 2 of the Radio Controller Polish arc — radio state snapshot for the
  // recognition stream's NOW-row anchor (binds against NowPlayingMatchId).
  // Refreshed on RadioStateChanged hub events; null until the first load.
  private RadioStateDto? _radioState;

  // Source gain state
  private float _currentSourceGain = 1.0f;
  private string? _nowPlayingSourceType;
  private bool _showGainPopover;
  private Dictionary<string, float> _sourceGainOffsets = new();

  /// <summary>
  /// The clock both debounce timers are armed against. Production never writes this; the default
  /// <em>is</em> the production behaviour.
  ///
  /// <para>
  /// <b>Why a settable property and not <c>@inject</c>.</b> The house idiom for a clock seam is an
  /// optional constructor parameter falling back to <see cref="TimeProvider.System"/>
  /// (<c>EncoderHudService</c>), and a Blazor component has no constructor to hang one on — the
  /// renderer activates it parameterlessly. <c>@inject</c> is the obvious substitute and is the
  /// wrong one twice over: it is a <em>required</em> resolve against a container that registers no
  /// <see cref="TimeProvider"/> in either host, deliberately (see the three comments saying so in
  /// <c>AudioServiceExtensions</c>), and it would leave this null on a bare
  /// <c>new NowPlayingPanel()</c> — which is exactly how the debounce tests build this panel.
  /// </para>
  ///
  /// <para>
  /// <c>internal</c> rather than <c>private</c> so <c>Radio.Web.Tests</c> can substitute a
  /// <c>FakeTimeProvider</c> through the <c>InternalsVisibleTo</c> the csproj already declares for
  /// exactly this purpose — and so the seam is greppable rather than reachable only by reflection.
  /// See TEST-7 in <c>archive/queue/TEST-7.md</c>.
  /// </para>
  /// </summary>
  internal TimeProvider Clock { get; set; } = TimeProvider.System;

  /// <summary>
  /// Trailing-edge debounce for the source-gain slider. <c>internal</c> so the tests advance the
  /// fake clock by the production value instead of by a copied literal: a test that hardcodes
  /// 200 ms stops testing this the moment the number changes.
  /// </summary>
  internal static readonly TimeSpan SourceGainDebounce = TimeSpan.FromMilliseconds(200);

  private ITimer? _gainDebounceTimer;

  private bool _isTunerSource => SourceTypeHelper.IsRadioFamily(_nowPlayingSourceType);

  /// <summary>
  /// Mono kicker inside the gain popover header. Empty for non-radio sources; otherwise
  /// "SDR · {short-token}". The short token strips the "SDR Radio (...)" wrapper from the friendly
  /// source name so e.g. "SDR Radio (RTL-SDR)" renders as "SDR · RTL-SDR" instead of the doubled
  /// "SDR · SDR Radio (RTL-SDR)".
  /// </summary>
  private string GainPopoverKicker => _isTunerSource && !string.IsNullOrEmpty(_source)
    ? $"SDR · {GetSourceShortToken(_source)}"
    : string.Empty;

  /// <summary>
  /// Strips the conventional "SDR Radio (…)" wrapper from a friendly
  /// source name. <c>"SDR Radio (RTL-SDR)"</c> → <c>"RTL-SDR"</c>. Falls back to the
  /// input as-is for any source that doesn't follow the wrapper convention.
  /// </summary>
  internal static string GetSourceShortToken(string sourceName)
  {
    if (string.IsNullOrWhiteSpace(sourceName)) return sourceName;
    var match = System.Text.RegularExpressions.Regex.Match(
      sourceName, @"^SDR Radio\s*\(([^)]+)\)\s*$");
    if (match.Success) return match.Groups[1].Value.Trim();
    return sourceName;
  }

  /// <summary>
  /// True when the bar's readout is anything other than <c>+0.0 dB</c> (including −∞ and
  /// <c>-0.0 dB</c>), so an offset paints in the accent colour and unity in <c>--text-low</c>. Compared
  /// against the formatted string so the colour cannot disagree with the text beside it.
  /// </summary>
  private bool IsSourceGainOffset =>
    GainControlPopover.FormatGainDb(_currentSourceGain) != GainControlPopover.FormatGainDb(1.0f);

  /// <summary>
  /// The recognition match the bar's fingerprint slot reports. For a tuner source this is the row the
  /// API anchored (<c>RadioStateDto.NowPlayingMatchId</c>). Other sources receive no radio state, so
  /// the slot uses the rule the API applies to set that anchor (<c>AudioStateUpdateService.
  /// UpdateCurrentMatchAnchor</c>): the most recent matched event. Null when there is none.
  /// </summary>
  private FingerprintEventDto? _activeMatch
  {
    get
    {
      if (_fpEventsReversed == null) return null;
      if (_isTunerSource)
      {
        var anchorId = _radioState?.NowPlayingMatchId;
        if (string.IsNullOrEmpty(anchorId)) return null;
        return _fpEventsReversed.FirstOrDefault(e => e.MatchId == anchorId && e.IsMatch);
      }
      return _fpEventsReversed.FirstOrDefault(e => e.IsMatch && !string.IsNullOrEmpty(e.MatchId));
    }
  }

  /// <summary>What the status bar's fingerprint slot is showing. Recognition states only — never RDS.</summary>
  internal enum FingerprintSlotState { Waiting, Off, Listening, Identifying, Match, NoMatch, Unavailable }

  /// <summary>
  /// Resolves the fingerprint slot, first rule that applies:
  /// <list type="number">
  ///   <item>no status: <c>Unavailable</c> once a status read has been attempted (the API client
  ///         returns null on failure), <c>Waiting</c> before the first read;</item>
  ///   <item>recognition disabled: <c>Off</c>;</item>
  ///   <item>an active match (see <see cref="_activeMatch"/>): <c>Match</c>. It outranks an
  ///         in-progress attempt (on radio one starts every 40 s), which would otherwise replace the
  ///         match with "Listening…" / "Identifying…" on every attempt;</item>
  ///   <item>phase <c>Error</c>: <c>Unavailable</c> — the service holds <c>Error</c> while it is backing
  ///         off after SongRec failures; <c>Capturing</c>: <c>Listening</c> (recording the sample — no
  ///         call has been made yet); <c>Fingerprinting</c> / <c>Querying</c>: <c>Identifying</c> (the
  ///         sample is with SongRec); <c>NoMatch</c>: <c>NoMatch</c>;</item>
  ///   <item>otherwise (<c>Idle</c> — between attempts, the fingerprint call policy's waiting state)
  ///         <c>NoMatch</c> when the most recent event is a failed lookup — the service returns to
  ///         <c>Idle</c> straight after a <c>NoMatch</c>, so the phase alone would almost never show
  ///         it — and <c>Waiting</c> when it is not. Never "Identifying…": waiting is not identifying.</item>
  /// </list>
  /// </summary>
  private FingerprintSlotState FingerprintSlot
  {
    get
    {
      if (_fpStatus == null)
      {
        return _fpStatusReadAttempted ? FingerprintSlotState.Unavailable : FingerprintSlotState.Waiting;
      }
      if (!_fpStatus.IsEnabled) return FingerprintSlotState.Off;
      if (_activeMatch != null) return FingerprintSlotState.Match;
      switch (_fpStatus.Phase)
      {
        case "Error": return FingerprintSlotState.Unavailable;
        case "Capturing": return FingerprintSlotState.Listening;
        case "Fingerprinting":
        case "Querying": return FingerprintSlotState.Identifying;
        case "NoMatch": return FingerprintSlotState.NoMatch;
      }
      var latest = _fpEventsReversed?.FirstOrDefault();
      return latest is { IsMatch: false } ? FingerprintSlotState.NoMatch : FingerprintSlotState.Waiting;
    }
  }

  private static string FingerprintSlotClass(FingerprintSlotState state) => state switch
  {
    FingerprintSlotState.Off => "is-off",
    FingerprintSlotState.Listening => "is-listening",
    FingerprintSlotState.Identifying => "is-identifying",
    FingerprintSlotState.Match => "is-match",
    FingerprintSlotState.NoMatch => "is-nomatch",
    FingerprintSlotState.Unavailable => "is-unavailable",
    _ => "is-waiting",
  };

  /// <summary>
  /// The slot's text. A match reads <c>{Bucket} match · {time-ago}</c> and never a percentage.
  /// "Listening…" and "Identifying…" are static text: the panel must not add an infinite animation (#789
  /// removed two for the kiosk's CPU).
  /// </summary>
  private string FingerprintSlotLabel(FingerprintSlotState state)
  {
    switch (state)
    {
      case FingerprintSlotState.Off: return "ID off";
      case FingerprintSlotState.Listening: return "Listening…";
      case FingerprintSlotState.Identifying: return "Identifying…";
      case FingerprintSlotState.NoMatch: return "No match";
      case FingerprintSlotState.Unavailable: return "ID unavailable";
      case FingerprintSlotState.Match:
        var m = _activeMatch;
        if (m == null) return "Match";
        var label = m.Confidence switch
        {
          ConfidenceBucket.Strong => "Strong match",
          ConfidenceBucket.Likely => "Likely match",
          ConfidenceBucket.Possible => "Possible match",
          _ => "Match"
        };
        return $"{label} · {Timestamps.FormatRecentRelative(m.Timestamp)}";
      default: return "Waiting to identify";
    }
  }

  // Periodic fallback poll for now playing updates (safety net for missed SignalR events)
  private System.Threading.Timer? _nowPlayingPollTimer;
  // Tracks when the last SignalR event was received to skip redundant polls
  private DateTime _lastSignalREventUtc = DateTime.MinValue;

  private bool _hasValidAlbumArt =>
    !_albumArtFailed
    && !string.IsNullOrEmpty(_albumArtUrl)
    && _albumArtUrl != "/images/default-album-art.png";

  protected override async Task OnInitializedAsync()
  {
    try
    {
      await LoadPreferencesAsync();

      HubService.PlaybackStateChanged += OnPlaybackStateChanged;
      HubService.NowPlayingChanged += OnNowPlayingChanged;
      HubService.SourceChanged += OnSourceChanged;
      HubService.VolumeChanged += OnVolumeChangedEvent;
      HubService.FingerprintStatusChanged += OnFingerprintStatusChanged;
      HubService.RadioStateChanged += OnRadioStateChanged;

      await RefreshPlaybackStateAsync();
      await RefreshFingerprintStatusAsync();
      await RefreshRadioStateAsync();
      await LoadSourceGainOffsetsAsync();

      // Periodic fallback poll for now playing updates. Catches track identifications
      // or metadata changes if a SignalR NowPlayingChanged event is missed.
      // 60s interval — SignalR provides real-time updates; this is a safety net only.
      _nowPlayingPollTimer = new System.Threading.Timer(
        async _ => await OnNowPlayingPollAsync(),
        null,
        TimeSpan.FromSeconds(60),
        TimeSpan.FromSeconds(60));
    }
    catch (Exception ex)
    {
      Logger.LogError(ex, "Error initializing NowPlayingPanel");
    }
  }

  private async Task OnPlaybackStateChanged()
  {
    _lastSignalREventUtc = DateTime.UtcNow;
    await RefreshPlaybackStateAsync();
    await InvokeAsync(StateHasChanged);
  }

  private async Task OnNowPlayingChanged(NowPlayingDto? dto)
  {
    _lastSignalREventUtc = DateTime.UtcNow;
    if (dto != null)
    {
      // Use the SignalR payload directly instead of making a redundant HTTP call
      ApplyNowPlayingDto(dto);
    }
    else
    {
      await RefreshPlaybackStateAsync();
    }
    await InvokeAsync(StateHasChanged);
  }

  private async Task OnSourceChanged()
  {
    _lastSignalREventUtc = DateTime.UtcNow;
    // Source switched — immediately refresh to show the new source's metadata
    await RefreshPlaybackStateAsync();
    await LoadSourceGainOffsetsAsync();
    await InvokeAsync(StateHasChanged);
  }

  private async Task OnVolumeChangedEvent(VolumeDto? dto)
  {
    _lastSignalREventUtc = DateTime.UtcNow;
    if (dto != null)
    {
      // Use the SignalR payload directly instead of making a redundant HTTP call
      _volume = dto.Volume;
      _isMuted = dto.IsMuted;
    }
    else
    {
      await RefreshPlaybackStateAsync();
    }
    await InvokeAsync(StateHasChanged);
  }

  private async Task OnFingerprintStatusChanged()
  {
    _lastSignalREventUtc = DateTime.UtcNow;
    await RefreshFingerprintStatusAsync();
    await InvokeAsync(StateHasChanged);
  }

  private async Task OnRadioStateChanged(RadioStateDto dto)
  {
    _lastSignalREventUtc = DateTime.UtcNow;
    // Use the SignalR payload directly — it carries NowPlayingMatchId, which
    // the REST /api/radio/state endpoint cannot populate (RadioController
    // has no access to AudioStateUpdateService._currentMatchId).
    _radioState = dto;
    await InvokeAsync(StateHasChanged);
  }

  private async Task RefreshRadioStateAsync()
  {
    try
    {
      _radioState = await RadioApi.GetStateAsync();
    }
    catch (Exception ex)
    {
      // Non-radio sources (BT, File) return 400 here; that's fine — the
      // recognition stream simply renders without the NOW anchor.
      Logger.LogDebug(ex, "Error refreshing radio state in NowPlayingPanel");
      _radioState = null;
    }
  }

  private async Task OnNowPlayingPollAsync()
  {
    try
    {
      // Skip poll if a SignalR event was received within the last 30s —
      // the real-time path already refreshed state.
      if ((DateTime.UtcNow - _lastSignalREventUtc).TotalSeconds < 30)
        return;

      var nowPlaying = await AudioApi.GetNowPlayingAsync();
      if (nowPlaying != null && nowPlaying.Title != _title)
      {
        await RefreshPlaybackStateAsync();
        await InvokeAsync(StateHasChanged);
      }
    }
    catch
    {
      // Ignore — this is a background safety net, not critical
    }
  }

  private async Task RefreshFingerprintStatusAsync()
  {
    try
    {
      _fpStatus = await AudioApi.GetFingerprintStatusAsync();
      // Cache the reversed list so the template doesn't call .Reverse() on every render
      _fpEventsReversed = _fpStatus?.RecentEvents != null
        ? Enumerable.Reverse(_fpStatus.RecentEvents).ToList()
        : null;
    }
    catch (Exception ex)
    {
      Logger.LogDebug(ex, "Error refreshing fingerprint status");
    }
    finally
    {
      _fpStatusReadAttempted = true;
    }
  }

  private async Task RefreshPlaybackStateAsync()
  {
    try
    {
      var state = await AudioApi.GetPlaybackStateAsync();
      if (state != null)
      {
        _isPlaying = state.IsPlaying;
        _isMuted = state.IsMuted;
        _isShuffleEnabled = state.IsShuffleEnabled;
        _repeatMode = state.RepeatMode;
        _volume = state.Volume;
        _canSeek = state.CanSeek;

        // Both elapsed/total are projected through PlaybackProgressProjection so the
        // panel and dock surfaces share one rounding / em-dash / percent-clamp contract
        // (Arc 3 PR C item #14). Position-only ("elapsed only") fallback branch in the
        // template keys off _position being non-null + _duration being null, so we
        // null-out _position when the input string didn't parse and _duration when the
        // total is zero.
        var progress = PlaybackProgressProjection.From(state);
        var hasPosition = !string.IsNullOrEmpty(state.Position)
          && TimeSpan.TryParse(state.Position, System.Globalization.CultureInfo.InvariantCulture, out _);
        _position = hasPosition ? progress.ElapsedDisplay : null;
        _totalDurationSeconds = progress.TotalSeconds;
        _progressPercent = progress.Percent;
        _progressPercentDisplay = progress.PercentDisplay;
        _duration = progress.TotalSeconds > 0 ? progress.TotalDisplay : null;
      }

      var nowPlaying = await AudioApi.GetNowPlayingAsync();
      if (nowPlaying != null)
      {
        _title = nowPlaying.Title;
        _artist = nowPlaying.Artist;
        _album = nowPlaying.Album;
        if (_albumArtUrl != nowPlaying.AlbumArtUrl)
        {
          Logger.LogDebug("Album art URL changed: {OldUrl} -> {NewUrl}", _albumArtUrl, nowPlaying.AlbumArtUrl);
          _albumArtFailed = false;
        }
        _albumArtUrl = nowPlaying.AlbumArtUrl;
        _source = nowPlaying.SourceName;
        _nowPlayingSourceType = nowPlaying.SourceType;
        _currentSourceGain = _sourceGainOffsets.TryGetValue(nowPlaying.SourceType, out var g) ? g : 1.0f;
        ApplyDisplayProjection(nowPlaying);
      }
    }
    catch (Exception ex)
    {
      Logger.LogError(ex, "Error refreshing playback state in NowPlayingPanel");
    }
  }

  /// <summary>
  /// Applies a NowPlayingDto received via SignalR directly to local state,
  /// avoiding a redundant HTTP round-trip to re-fetch the same data.
  /// </summary>
  private void ApplyNowPlayingDto(NowPlayingDto dto)
  {
    _title = dto.Title;
    _artist = dto.Artist;
    _album = dto.Album;
    _isPlaying = dto.IsPlaying;
    if (_albumArtUrl != dto.AlbumArtUrl)
    {
      _albumArtFailed = false;
    }
    _albumArtUrl = dto.AlbumArtUrl;
    _source = dto.SourceName;
    _nowPlayingSourceType = dto.SourceType;
    _currentSourceGain = _sourceGainOffsets.TryGetValue(dto.SourceType, out var g) ? g : 1.0f;
    ApplyDisplayProjection(dto);
  }

  /// <summary>
  /// Computes the cleaned-up title/subtitle pair via <see cref="DisplayNames.Track"/>
  /// and caches them on the component so the UI renders the projected names instead
  /// of the raw DTO fields. Called whenever the now-playing payload changes.
  /// </summary>
  private void ApplyDisplayProjection(NowPlayingDto dto)
  {
    var (title, subtitle) = DisplayNames.Track(dto);
    // The empty-source case (no track loaded) keeps the friendly "No Track Playing"
    // copy that pre-dates PR 3, because DisplayNames returns the raw "No Track" default.
    _displayTitle = string.Equals(title, "No Track", StringComparison.Ordinal)
      ? "No Track Playing"
      : title;
    _displaySubtitle = subtitle;
  }

  // --- Fingerprint slot helpers ---

  private void ToggleFingerprintDetail()
  {
    _showFingerprintDetail = !_showFingerprintDetail;
    if (_showFingerprintDetail)
    {
      _ = RefreshFingerprintStatusAsync();
    }
  }


  // --- Source gain helpers ---

  private async Task LoadSourceGainOffsetsAsync()
  {
    try
    {
      _sourceGainOffsets = await AudioApi.GetSourceGainOffsetsAsync() ?? new();
    }
    catch (Exception ex)
    {
      Logger.LogDebug(ex, "Error loading source gain offsets");
    }
  }

  private void ToggleGainPopover() => _showGainPopover = !_showGainPopover;

  private void CloseGainPopover() => _showGainPopover = false;

  /// <summary>
  /// Reset the per-source playback gain to unity (linear 1.0 → 0 dB). The
  /// slider value-changed callback follows immediately so the debounce timer
  /// fires the API write through the same path as a manual slider drag.
  /// Synchronous body — the Async suffix on the previous name was misleading.
  /// </summary>
  private void ResetGain()
  {
    OnGainSliderChanged(1.0f);
  }

  private void OnGainSliderChanged(float newGain)
  {
    if (string.IsNullOrEmpty(_nowPlayingSourceType)) return;
    _currentSourceGain = newGain;
    _sourceGainOffsets[_nowPlayingSourceType] = newGain;

    // Debounce the API call — reuse existing timer via Change() instead of
    // dispose+recreate on each slider event to reduce GC pressure.
    _pendingGainSourceType = _nowPlayingSourceType;
    _pendingGainValue = newGain;
    if (_gainDebounceTimer != null)
    {
      _gainDebounceTimer.Change(SourceGainDebounce, Timeout.InfiniteTimeSpan);
    }
    else
    {
      _gainDebounceTimer = Clock.CreateTimer(
        OnGainDebounceElapsed, null,
        SourceGainDebounce, Timeout.InfiniteTimeSpan);
    }
  }

  private string? _pendingGainSourceType;
  private float _pendingGainValue;

  private async void OnGainDebounceElapsed(object? _)
  {
    try
    {
      var sourceType = _pendingGainSourceType;
      var gain = _pendingGainValue;
      if (!string.IsNullOrEmpty(sourceType))
        await AudioApi.SetSourceGainAsync(sourceType, gain);
    }
    catch (Exception ex)
    {
      Logger.LogWarning(ex, "Failed to set source gain for {SourceType}", _pendingGainSourceType);
    }
  }

  // --- Existing handlers ---

  // AUD-28. Display only — the SeekBar raises this during a drag and with null when the drag is over.
  // It must never seek; HandleSeekAsync is bound to the release.
  private void OnSeekScrub(double? fraction)
  {
    if (fraction is { } f && _totalDurationSeconds > 0)
    {
      var progress = PlaybackProgressProjection.From(f * _totalDurationSeconds, _totalDurationSeconds);
      _scrubPosition = progress.ElapsedDisplay;
      _scrubPercent = progress.Percent;
    }
    else
    {
      _scrubPosition = null;
      _scrubPercent = null;
    }
  }

  private async Task HandleSeekAsync(double newPercent)
  {
    if (_totalDurationSeconds > 0)
    {
      var seconds = (newPercent / 100.0) * _totalDurationSeconds;
      var newTime = TimeSpan.FromSeconds(seconds);
      // Route the formatting through the shared projection so a rapid scrub-to-zero
      // surfaces "0:00" (not em-dash) in the elapsed cell, matching the dock.
      var progress = PlaybackProgressProjection.From(seconds, _totalDurationSeconds);
      _progressPercent = progress.Percent;
      _progressPercentDisplay = progress.PercentDisplay;
      _position = progress.ElapsedDisplay;
      await AudioApi.UpdatePlaybackStateAsync(new UpdatePlaybackRequest(
        Action: "Seek", Volume: null, IsMuted: null, Balance: null, SeekPosition: newTime));
      await RefreshPlaybackStateAsync();
    }
  }

  private async Task HandlePlayPauseAsync()
  {
    try
    {
      if (_isPlaying)
        await AudioApi.UpdatePlaybackStateAsync(new UpdatePlaybackRequest("Pause", null, null, null));
      else
        await AudioApi.UpdatePlaybackStateAsync(new UpdatePlaybackRequest("Play", null, null, null));
      await RefreshPlaybackStateAsync();
    }
    catch (Exception ex)
    {
      Logger.LogError(ex, "Error in HandlePlayPauseAsync");
    }
  }

  private async Task HandleNextAsync()
  {
    await AudioApi.NextAsync();
    await RefreshPlaybackStateAsync();
  }

  private async Task HandlePreviousAsync()
  {
    await AudioApi.PreviousAsync();
    await RefreshPlaybackStateAsync();
  }

  private async Task HandleShuffleAsync()
  {
    try
    {
      var result = await AudioApi.SetShuffleAsync(!_isShuffleEnabled);
      if (result != null) await RefreshPlaybackStateAsync();
    }
    catch (Exception ex)
    {
      Logger.LogError(ex, "Error toggling shuffle");
    }
  }

  private async Task HandleRepeatAsync()
  {
    try
    {
      var nextMode = _repeatMode switch
      {
        "Off" => "All",
        "All" => "One",
        "One" => "Off",
        _ => "Off"
      };
      var result = await AudioApi.SetRepeatAsync(nextMode);
      if (result != null) await RefreshPlaybackStateAsync();
    }
    catch (Exception ex)
    {
      Logger.LogError(ex, "Error setting repeat mode");
    }
  }

  private async Task HandleMuteAsync()
  {
    await AudioApi.ToggleMuteAsync(!_isMuted);
    await RefreshPlaybackStateAsync();
  }

  private void OnVolumeChanged(double newVolume)
  {
    _volume = newVolume;
    _ = HandleVolumeChangeAsync(newVolume);
  }

  private async Task HandleVolumeChangeAsync(double newVolume)
  {
    try
    {
      // The audible change stays immediate — this is the whole point of the slider.
      await AudioApi.SetVolumeAsync((float)newVolume);

      // The *persistence* of the volume is debounced. See QueueVolumePreferenceSave.
      QueueVolumePreferenceSave(newVolume);
    }
    catch (Exception ex)
    {
      Logger.LogError(ex, "Error changing volume");
    }
  }

  // Volume-preference persistence uses the same trailing-edge debounce as the source-gain
  // slider above (OnGainSliderChanged / OnGainDebounceElapsed) — one timer, re-armed via
  // Change() rather than dispose+recreate.
  //
  // Why it matters beyond saving writes: a slider drag emits a value-changed event per
  // pixel, and persisting each one wrote ui.playback on every tick (13 writes inside one
  // second were captured in the journal). Each write reloads
  // IOptionsMonitor<AudioOutputOptions> on the API side, and each reload re-enumerates
  // audio devices — so a single drag put more than a dozen threads into MiniAudio's
  // non-thread-safe PulseAudio main loop and aborted radio-api on 2026-08-10.
  // NativeAudioDeviceGate makes that safe on the server; this removes the fan-out at
  // its source so the gate is not the only thing standing between a drag and a crash.
  internal static readonly TimeSpan VolumePreferenceDebounce = TimeSpan.FromMilliseconds(300);
  private ITimer? _volumePrefDebounceTimer;
  private double _pendingVolumePreference;

  // The null-check-then-create below is not atomic, and it is safe only because every path into
  // this method arrives on Blazor's renderer synchronization context, which serialises them:
  // QueueVolumePreferenceSave has exactly one caller (HandleVolumeChangeAsync), which has exactly
  // one caller (OnVolumeChanged), which is bound only to the RadzenSlider Change event. That is the
  // precondition, stated because it is load-bearing — two concurrent entries would each see a null
  // timer, create two, leak one past DisposeAsync, and produce the very write fan-out this debounce
  // exists to prevent. If a second caller is ever added from a timer or hub callback, this needs a
  // lock. (Found by TEST-7's pre-merge review; the property was already true and already unstated.)
  private void QueueVolumePreferenceSave(double newVolume)
  {
    _pendingVolumePreference = newVolume;
    if (_volumePrefDebounceTimer != null)
    {
      _volumePrefDebounceTimer.Change(VolumePreferenceDebounce, Timeout.InfiniteTimeSpan);
    }
    else
    {
      _volumePrefDebounceTimer = Clock.CreateTimer(
        OnVolumePreferenceDebounceElapsed, null,
        VolumePreferenceDebounce, Timeout.InfiniteTimeSpan);
    }
  }

  private async void OnVolumePreferenceDebounceElapsed(object? _)
  {
    // SavePreferenceAsync owns its own try/catch, which is what keeps this async void
    // callback from being able to throw onto a timer thread. Precisely: that holds because the
    // catch is total (catch (Exception)) AND Logger is non-null inside it — a bare
    // `new NowPlayingPanel()` leaves Logger null, so narrowing the catch, or logging before the
    // null-check a DI-activated panel makes unnecessary, would reopen this.
    await SavePreferenceAsync("volume", _pendingVolumePreference);
  }

  private void OnAlbumArtError()
  {
    Logger.LogWarning("Album art image failed to load: {Url}", _albumArtUrl);
    _albumArtFailed = true;
    StateHasChanged();
  }

  private async Task LoadPreferencesAsync()
  {
    try
    {
      var prefs = await ConfigApi.GetConfigurationAsync<Dictionary<string, object>>("ui.playback");
      if (prefs != null)
      {
        if (prefs.TryGetValue("volume", out var volumeObj) && double.TryParse(volumeObj?.ToString(), out var volume))
          _volume = volume;
      }
    }
    catch (Exception ex)
    {
      Logger.LogWarning(ex, "Failed to load playback preferences");
    }
  }

  private async Task SavePreferenceAsync(string key, object value)
  {
    try
    {
      await ConfigApi.UpdateConfigurationAsync("ui.playback", key, value);
    }
    catch (Exception ex)
    {
      Logger.LogWarning(ex, "Failed to save preference {Key}", key);
    }
  }

  public async ValueTask DisposeAsync()
  {
    HubService.PlaybackStateChanged -= OnPlaybackStateChanged;
    HubService.NowPlayingChanged -= OnNowPlayingChanged;
    HubService.SourceChanged -= OnSourceChanged;
    HubService.VolumeChanged -= OnVolumeChangedEvent;
    HubService.FingerprintStatusChanged -= OnFingerprintStatusChanged;
    HubService.RadioStateChanged -= OnRadioStateChanged;
    _gainDebounceTimer?.Dispose();
    _volumePrefDebounceTimer?.Dispose();
    _nowPlayingPollTimer?.Dispose();
    await Task.CompletedTask;
  }
}
