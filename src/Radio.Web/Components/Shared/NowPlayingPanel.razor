@rendermode InteractiveServer
@inject AudioApiService AudioApi
@inject AudioStateHubService HubService
@inject ConfigurationApiService ConfigApi
@inject ILogger<NowPlayingPanel> Logger
@inject ISnackbar Snackbar
@implements IAsyncDisposable

<div style="height: 100%; display: flex; flex-direction: column; position: relative; overflow: hidden;">
  <!-- Full-bleed album art background -->
  @if (_hasValidAlbumArt)
  {
    <div style="position: absolute; inset: 0; background-image: url('@_albumArtUrl'); background-size: cover; background-position: center; filter: blur(20px) brightness(0.3); transform: scale(1.1); @(_isPlaying ? "animation: kenBurns 20s ease-in-out infinite alternate;" : "")"></div>
    <img src="@_albumArtUrl" alt="" referrerpolicy="no-referrer"
         style="display: none;" @onerror="OnAlbumArtError" />
  }
  else
  {
    <div style="position: absolute; inset: 0; background: var(--surface-inset);"></div>
  }

  <!-- Track info overlay — centered -->
  <div style="position: relative; z-index: 1; flex: 1; display: flex; flex-direction: column; align-items: center; justify-content: center; padding: 24px 16px 0; text-align: center; min-height: 0;">
    @if (_hasValidAlbumArt)
    {
      <img src="@_albumArtUrl" alt="Album Art" referrerpolicy="no-referrer"
           style="width: 180px; height: 180px; border-radius: 8px; object-fit: cover; box-shadow: 0 8px 32px rgba(0,0,0,0.5); margin-bottom: 16px;" />
    }
    else
    {
      <MudIcon Icon="@Icons.Material.Filled.MusicNote" Style="font-size: 96px; color: var(--text-low); margin-bottom: 16px;" />
    }
    <div style="font-size: 28px; font-weight: 600; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; max-width: 100%; color: var(--text-high); text-shadow: 0 2px 8px rgba(0,0,0,0.6);">
      @(_title ?? "No Track Playing")
    </div>
    <div style="font-size: 18px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; max-width: 100%; color: rgba(255,255,255,0.85); text-shadow: 0 1px 4px rgba(0,0,0,0.5); margin-top: 4px;">
      @(_artist ?? "--")
    </div>
    <div style="font-size: 16px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; max-width: 100%; color: rgba(255,255,255,0.65); text-shadow: 0 1px 3px rgba(0,0,0,0.5); margin-top: 2px;">
      @(_album ?? "--")
    </div>
    @if (!string.IsNullOrEmpty(_source))
    {
      <MudChip T="string" Color="Color.Primary" Size="Size.Small" Style="margin-top: 8px;">@_source</MudChip>
    }
  </div>

  <!-- Transport bar — anchored to bottom with glass effect -->
  <div style="position: relative; z-index: 1; background: rgba(0,0,0,0.5); backdrop-filter: blur(12px); border-top: 1px solid var(--surface-separator); padding: 8px 16px 12px;">
    <!-- Progress Bar (full width) -->
    @if (!string.IsNullOrEmpty(_position) && !string.IsNullOrEmpty(_duration))
    {
      <div style="margin-bottom: 4px;">
        @if (_canSeek)
        {
          <MudSlider Value="@_progressPercent"
                     ValueChanged="@((double v) => HandleSeekAsync(v))"
                     Min="0" Max="100" Step="0.1"
                     Color="Color.Primary" Size="Size.Small" />
        }
        else
        {
          <MudProgressLinear Value="@_progressPercent" Color="Color.Primary" Size="Size.Small" />
        }
        <div style="display: flex; justify-content: space-between; font-size: 13px; color: var(--text-medium); margin-top: -2px; font-family: var(--font-mono);">
          <span>@_position</span>
          <span>@_duration</span>
        </div>
      </div>
    }
    else if (!string.IsNullOrEmpty(_position) && _position != "0:00")
    {
      <div style="text-align: center; font-size: 13px; color: var(--text-medium); margin-bottom: 4px; font-family: var(--font-mono);">
        <span>@_position</span>
      </div>
    }

    <!-- Transport Controls -->
    <div class="transport-group">
      <MudIconButton Icon="@Icons.Material.Filled.Shuffle"
                     Color="@(_isShuffleEnabled ? Color.Primary : Color.Default)"
                     Size="Size.Medium"
                     Class="transport-btn"
                     OnClick="HandleShuffleAsync"
                     title="Shuffle" />
      <MudIconButton Icon="@Icons.Material.Filled.SkipPrevious"
                     Color="Color.Default"
                     Size="Size.Medium"
                     Class="transport-btn"
                     OnClick="HandlePreviousAsync"
                     title="Previous" />
      <MudIconButton Icon="@(_isPlaying ? Icons.Material.Filled.Pause : Icons.Material.Filled.PlayArrow)"
                     Color="Color.Primary"
                     Size="Size.Large"
                     Class="transport-btn-primary"
                     OnClick="HandlePlayPauseAsync"
                     title="@(_isPlaying ? "Pause" : "Play")" />
      <MudIconButton Icon="@Icons.Material.Filled.SkipNext"
                     Color="Color.Default"
                     Size="Size.Medium"
                     Class="transport-btn"
                     OnClick="HandleNextAsync"
                     title="Next" />
      <MudIconButton Icon="@Icons.Material.Filled.Repeat"
                     Color="@(_repeatMode != "Off" ? Color.Primary : Color.Default)"
                     Size="Size.Medium"
                     Class="transport-btn"
                     OnClick="HandleRepeatAsync"
                     title="@($"Repeat: {_repeatMode}")" />
    </div>
  </div>
</div>

@code {
  private bool _isPlaying;
  private bool _isMuted;
  private bool _isShuffleEnabled;
  private string _repeatMode = "Off";
  private double _volume = 0.75;
  private string? _title;
  private string? _artist;
  private string? _album;
  private string? _albumArtUrl;
  private bool _albumArtFailed;
  private string? _source;
  private string? _position;
  private string? _duration;
  private bool _canSeek;
  private double _progressPercent;
  private double _totalDurationSeconds;
  private System.Threading.Timer? _timer;

  private bool _hasValidAlbumArt =>
    !_albumArtFailed
    && !string.IsNullOrEmpty(_albumArtUrl)
    && _albumArtUrl != "/images/default-album-art.png";

  protected override async Task OnInitializedAsync()
  {
    try
    {
      await LoadPreferencesAsync();

      HubService.PlaybackStateChanged += OnPlaybackStateChanged;
      HubService.NowPlayingChanged += OnNowPlayingChanged;
      HubService.VolumeChanged += OnVolumeChangedEvent;

      await RefreshPlaybackStateAsync();

      _timer = new System.Threading.Timer(TimerCallback, null, TimeSpan.FromSeconds(5), TimeSpan.FromSeconds(5));
    }
    catch (Exception ex)
    {
      Logger.LogError(ex, "Error initializing NowPlayingPanel");
    }
  }

  private async void TimerCallback(object? state)
  {
    try
    {
      await RefreshPlaybackStateAsync();
      await InvokeAsync(StateHasChanged);
    }
    catch (ObjectDisposedException) { }
    catch (Exception ex)
    {
      Logger.LogWarning(ex, "Error in NowPlayingPanel timer callback");
    }
  }

  private async Task OnPlaybackStateChanged()
  {
    await RefreshPlaybackStateAsync();
    await InvokeAsync(StateHasChanged);
  }

  private async Task OnNowPlayingChanged()
  {
    await RefreshPlaybackStateAsync();
    await InvokeAsync(StateHasChanged);
  }

  private async Task OnVolumeChangedEvent()
  {
    await RefreshPlaybackStateAsync();
    await InvokeAsync(StateHasChanged);
  }

  private async Task RefreshPlaybackStateAsync()
  {
    try
    {
      var state = await AudioApi.GetPlaybackStateAsync();
      if (state != null)
      {
        _isPlaying = state.IsPlaying;
        _isMuted = state.IsMuted;
        _isShuffleEnabled = state.IsShuffleEnabled;
        _repeatMode = state.RepeatMode;
        _volume = state.Volume;
        _canSeek = state.CanSeek;

        // Parse position and duration
        var posSeconds = 0.0;
        if (!string.IsNullOrEmpty(state.Position) && TimeSpan.TryParse(state.Position, out var pos))
        {
          posSeconds = pos.TotalSeconds;
          _position = pos.TotalHours >= 1
            ? pos.ToString(@"h\:mm\:ss")
            : pos.ToString(@"m\:ss");
        }
        else
        {
          _position = null;
        }

        // Parse duration (may be null for live/streaming sources like BT)
        if (!string.IsNullOrEmpty(state.Duration) && TimeSpan.TryParse(state.Duration, out var dur) && dur.TotalSeconds > 0)
        {
          _totalDurationSeconds = dur.TotalSeconds;
          _progressPercent = posSeconds > 0 ? (posSeconds / dur.TotalSeconds) * 100.0 : 0;
          _duration = dur.TotalHours >= 1
            ? dur.ToString(@"h\:mm\:ss")
            : dur.ToString(@"m\:ss");
        }
        else
        {
          _duration = null;
          _totalDurationSeconds = 0;
          _progressPercent = 0;
        }
      }

      var nowPlaying = await AudioApi.GetNowPlayingAsync();
      if (nowPlaying != null)
      {
        _title = nowPlaying.Title;
        _artist = nowPlaying.Artist;
        _album = nowPlaying.Album;
        if (_albumArtUrl != nowPlaying.AlbumArtUrl)
        {
          Logger.LogInformation("Album art URL changed: {OldUrl} → {NewUrl}", _albumArtUrl, nowPlaying.AlbumArtUrl);
          _albumArtFailed = false;
        }
        _albumArtUrl = nowPlaying.AlbumArtUrl;
        _source = nowPlaying.SourceName;
      }
    }
    catch (Exception ex)
    {
      Logger.LogError(ex, "Error refreshing playback state in NowPlayingPanel");
    }
  }

  private async Task HandleSeekAsync(double newPercent)
  {
    if (_totalDurationSeconds > 0)
    {
      var seconds = (newPercent / 100.0) * _totalDurationSeconds;
      var newTime = TimeSpan.FromSeconds(seconds);
      _progressPercent = newPercent;
      _position = newTime.TotalHours >= 1
        ? newTime.ToString(@"h\:mm\:ss")
        : newTime.ToString(@"m\:ss");
      await AudioApi.UpdatePlaybackStateAsync(new UpdatePlaybackRequest(
        Action: "Seek", Volume: null, IsMuted: null, Balance: null, SeekPosition: newTime));
      await RefreshPlaybackStateAsync();
    }
  }

  private async Task HandlePlayPauseAsync()
  {
    try
    {
      if (_isPlaying)
        await AudioApi.UpdatePlaybackStateAsync(new UpdatePlaybackRequest("Pause", null, null, null));
      else
        await AudioApi.UpdatePlaybackStateAsync(new UpdatePlaybackRequest("Play", null, null, null));
      await RefreshPlaybackStateAsync();
    }
    catch (Exception ex)
    {
      Logger.LogError(ex, "Error in HandlePlayPauseAsync");
    }
  }

  private async Task HandleNextAsync()
  {
    await AudioApi.NextAsync();
    await RefreshPlaybackStateAsync();
  }

  private async Task HandlePreviousAsync()
  {
    await AudioApi.PreviousAsync();
    await RefreshPlaybackStateAsync();
  }

  private async Task HandleShuffleAsync()
  {
    try
    {
      var result = await AudioApi.SetShuffleAsync(!_isShuffleEnabled);
      if (result != null) await RefreshPlaybackStateAsync();
    }
    catch (Exception ex)
    {
      Logger.LogError(ex, "Error toggling shuffle");
    }
  }

  private async Task HandleRepeatAsync()
  {
    try
    {
      var nextMode = _repeatMode switch
      {
        "Off" => "All",
        "All" => "One",
        "One" => "Off",
        _ => "Off"
      };
      var result = await AudioApi.SetRepeatAsync(nextMode);
      if (result != null) await RefreshPlaybackStateAsync();
    }
    catch (Exception ex)
    {
      Logger.LogError(ex, "Error setting repeat mode");
    }
  }

  private async Task HandleMuteAsync()
  {
    await AudioApi.ToggleMuteAsync(!_isMuted);
    await RefreshPlaybackStateAsync();
  }

  private void OnVolumeChanged(double newVolume)
  {
    _volume = newVolume;
    _ = HandleVolumeChangeAsync(newVolume);
  }

  private async Task HandleVolumeChangeAsync(double newVolume)
  {
    try
    {
      await AudioApi.SetVolumeAsync((float)newVolume);
      await SavePreferenceAsync("volume", newVolume);
    }
    catch (Exception ex)
    {
      Logger.LogError(ex, "Error changing volume");
    }
  }

  private void OnAlbumArtError()
  {
    Logger.LogWarning("Album art image failed to load: {Url}", _albumArtUrl);
    _albumArtFailed = true;
    StateHasChanged();
  }

  private async Task LoadPreferencesAsync()
  {
    try
    {
      var prefs = await ConfigApi.GetConfigurationAsync<Dictionary<string, object>>("ui.playback");
      if (prefs != null)
      {
        if (prefs.TryGetValue("volume", out var volumeObj) && double.TryParse(volumeObj?.ToString(), out var volume))
          _volume = volume;
      }
    }
    catch (Exception ex)
    {
      Logger.LogWarning(ex, "Failed to load playback preferences");
    }
  }

  private async Task SavePreferenceAsync(string key, object value)
  {
    try
    {
      await ConfigApi.UpdateConfigurationAsync("ui.playback", key, value);
    }
    catch (Exception ex)
    {
      Logger.LogWarning(ex, "Failed to save preference {Key}", key);
    }
  }

  public async ValueTask DisposeAsync()
  {
    HubService.PlaybackStateChanged -= OnPlaybackStateChanged;
    HubService.NowPlayingChanged -= OnNowPlayingChanged;
    HubService.VolumeChanged -= OnVolumeChangedEvent;
    _timer?.Dispose();
    await Task.CompletedTask;
  }
}
