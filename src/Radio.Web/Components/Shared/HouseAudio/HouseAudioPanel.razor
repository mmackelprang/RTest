@implements IAsyncDisposable
@inject Func<HouseAudioPoller> CreatePoller
@inject HouseAudioApiService Api

@* The House Audio tab: the controller's rooms, as cards. RadzenTabs keeps hidden tabs mounted, so
   polling follows IsActive rather than this component's lifetime: an unopened tab costs the box
   nothing, and leaving the tab stops the poll.

   Commands apply immediately and the card shows them at once. HouseAudioCommandLedger decides what
   each card shows after that, and its tests state the rules. RNET traffic stays in this process, off
   the audio path. Nothing here logs: a room name is not for the journal (CLAUDE.md, radio-web). *@

@{
  IReadOnlyList<HouseZone> zones = _ledger?.Zones ?? [];
  IReadOnlyList<HouseZone> powered = zones.Where(zone => zone.Power).ToList();
  bool allMuted = powered.Count > 0 && powered.All(zone => zone.Muted);
  bool stale = _snapshot?.Stale ?? false;
}

<section class="house-audio-panel" data-testid="house-audio-panel">
  <header class="house-audio-header">
    <span class="house-audio-name">@(_snapshot?.System?.Name ?? "House Audio")</span>
    <span class="house-audio-status-slot">
      @if (StatusText is { } status)
      {
        <span class="house-audio-status" role="alert" data-testid="house-audio-status">@status</span>
      }
    </span>
    <button type="button" class="house-audio-action" data-testid="house-mute-all"
            disabled="@(powered.Count == 0)" @onclick="@(() => SetAllMutedAsync(powered, !allMuted))">
      @(allMuted ? "Unmute all" : "Mute all")
    </button>
    <button type="button" class="house-audio-action" data-testid="house-all-off"
            disabled="@(powered.Count == 0)" @onclick="@(() => TurnAllOffAsync(zones))">
      All off
    </button>
    @* Opens the panel Task 10 adds. *@
    <button type="button" class="house-audio-action" data-testid="house-controller-settings" disabled>
      Controller settings
    </button>
  </header>

  @if (zones.Count > 0)
  {
    <div class="house-zone-grid">
      @foreach (HouseZone zone in zones)
      {
        <HouseZoneCard @key="@((zone.ControllerId, zone.ZoneId))"
                       Zone="@zone"
                       Sources="@(_snapshot?.Sources ?? [])"
                       Stale="@stale"
                       OnPower="@(() => SetPowerAsync(zone))"
                       OnMute="@(() => SetMutedAsync(zone))"
                       OnVolumeCommitted="@(volume => SetVolumeAsync(zone, volume))"
                       OnSource="@(sourceId => SetSourceAsync(zone, sourceId))" />
      }
    </div>
  }
  else
  {
    <div class="house-audio-empty">@(_snapshot is null ? "Connecting to the controller." : "No rooms to show.")</div>
  }
</section>

@code {
  /// <summary>True while this panel's tab is the showing tab. Polling runs only then.</summary>
  [Parameter] public bool IsActive { get; set; }

  private HouseAudioPoller? _poller;
  private HouseAudioCommandLedger? _ledger;
  private HouseAudioSnapshot? _snapshot;
  private string? _commandError;
  private bool _disposed;

  // A failed command says so until the next command, or until the tab is left.
  private string? StatusText => _commandError ?? HealthText;

  private string? HealthText => _snapshot?.Health switch
  {
    null or HouseAudioHealth.Ok => null,
    HouseAudioHealth.Unreachable or HouseAudioHealth.AmpDisconnected => $"{Reason(_snapshot.Health)} Retrying.",
    _ => Reason(_snapshot.Health)
  };

  private static string Reason(HouseAudioHealth health) => health switch
  {
    HouseAudioHealth.Ok => "The controller refused it.",
    HouseAudioHealth.AmpDisconnected => "The controller can't reach the amp.",
    HouseAudioHealth.WrongPassword => "The controller refused the password. Enter it in Controller settings.",
    HouseAudioHealth.NoPassword => "No controller password is saved. Enter it in Controller settings.",
    _ => "Can't reach the controller."
  };

  protected override async Task OnParametersSetAsync()
  {
    if (IsActive && _poller is null)
    {
      StartPolling();
    }
    else if (!IsActive && _poller is not null)
    {
      await StopPollingAsync();
    }
  }

  private void StartPolling()
  {
    HouseAudioCommandLedger ledger = new();
    HouseAudioPoller poller = CreatePoller();
    poller.Updated += snapshot =>
    {
      // Runs under the poller's lock, so this read cannot pass a release. It must be here, not in the
      // queued work, or a snapshot raised before a release and handled after it would pass for new.
      long releases = ledger.Releases;
      _ = InvokeAsync(() => ShowSnapshot(ledger, snapshot, releases));
    };

    _ledger = ledger;
    _poller = poller;
    poller.Start();
  }

  private async Task StopPollingAsync()
  {
    HouseAudioPoller poller = _poller!;
    _poller = null;
    _ledger = null;
    _snapshot = null;
    _commandError = null;
    await poller.DisposeAsync();
  }

  private void ShowSnapshot(HouseAudioCommandLedger ledger, HouseAudioSnapshot snapshot, long releases)
  {
    // Queued before the tab was left, or before this component was disposed.
    if (!ReferenceEquals(ledger, _ledger) || _disposed)
    {
      return;
    }

    if (ledger.Accept(snapshot, releases))
    {
      _snapshot = snapshot;
      StateHasChanged();
    }
  }

  private Task SetPowerAsync(HouseZone zone)
  {
    bool on = !zone.Power;
    return RunAsync([zone.Name], shown => shown with { Power = on }, $"{zone.Name} power was not changed.",
      () => Api.SetPowerAsync(zone.Name, on));
  }

  private Task SetMutedAsync(HouseZone zone)
  {
    bool muted = !zone.Muted;
    return RunAsync([zone.Name], shown => shown with { Muted = muted }, $"{zone.Name} mute was not changed.",
      () => Api.SetMuteAsync(zone.Name, muted));
  }

  private Task SetVolumeAsync(HouseZone zone, int volume) =>
    RunAsync([zone.Name], shown => shown with { Volume = volume }, $"{zone.Name} volume was not changed.",
      () => Api.SetVolumeAsync(zone.Name, volume));

  private Task SetSourceAsync(HouseZone zone, int sourceId) =>
    RunAsync([zone.Name], shown => shown with { SourceId = sourceId }, $"{zone.Name} source was not changed.",
      () => Api.SetSourceAsync(zone.Name, sourceId));

  // The controller's all-room mute acts only on powered rooms, so that is what is held and shown.
  private Task SetAllMutedAsync(IReadOnlyList<HouseZone> powered, bool muted) =>
    RunAsync(powered.Select(zone => zone.Name).ToList(), shown => shown with { Muted = muted },
      $"The rooms were not {(muted ? "muted" : "unmuted")}.", () => Api.SetAllMuteAsync(muted));

  private Task TurnAllOffAsync(IReadOnlyList<HouseZone> zones) =>
    RunAsync(zones.Select(zone => zone.Name).ToList(), shown => shown with { Power = false },
      "The rooms were not turned off.", () => Api.SetAllPowerAsync(false));

  /// <summary>
  /// Sends one command with its rooms held. The hold ends in <c>finally</c>, as a leaked one freezes
  /// the room. A command is not cancelled by leaving the tab or the page: it may already have reached
  /// the amp, and it ends on the client's own timeout.
  /// </summary>
  private async Task RunAsync(
    IReadOnlyList<string> zoneNames,
    Func<HouseZone, HouseZone> change,
    string failure,
    Func<Task<HouseAudioResult<bool>>> send)
  {
    if (_poller is not { } poller || _ledger is not { } ledger)
    {
      return;
    }

    _commandError = null;
    HouseAudioCommand command = ledger.Begin(zoneNames, change);
    List<IDisposable> holds = zoneNames.Select(poller.HoldZone).ToList();

    HouseAudioResult<bool> result;
    try
    {
      result = await send();
    }
    finally
    {
      holds.ForEach(hold => hold.Dispose());
      ledger.Release(command);
    }

    if (result is { Health: HouseAudioHealth.Ok, Value: true })
    {
      return;
    }

    ledger.Fail(command);
    if (ReferenceEquals(ledger, _ledger) && !_disposed)
    {
      _commandError = $"{failure} {Reason(result.Health)}";
      StateHasChanged();
    }
  }

  public async ValueTask DisposeAsync()
  {
    _disposed = true;
    if (_poller is not null)
    {
      await StopPollingAsync();
    }
  }
}
