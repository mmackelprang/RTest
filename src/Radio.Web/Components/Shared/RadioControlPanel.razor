@rendermode InteractiveServer
@using Radio.Web.Services.ApiClients
@using Radio.Web.Services.Rds
@using Microsoft.Extensions.Options
@inject RadioApiService RadioApi
@inject AudioStateHubService HubService
@inject IOptionsMonitor<RdsScrollOptions> RdsScrollOptionsMonitor
@inject ILogger<RadioControlPanel> Logger
@inject NotificationService NotificationService
@implements IAsyncDisposable

<div class="rcp-root">
  @if (_radioState == null)
  {
    @* Initial-load skeleton — shape mirrors the band buttons + freq well +
       meter strip that take its place once _radioState is hydrated. *@
    <Skeleton Shape="Skeleton.SkeletonShape.Radio" />
  }
  else
  {
    <!-- Tuner Module -->
    <div class="rcp-tuner">
      @{
        // PR 3 of the Radio Controller Polish arc — pull the active band's
        // metadata once per render so the header range string and preset
        // capacity stay in sync without scattering lookups across the markup.
        var activeBand = _availableBands.FirstOrDefault(b => b.Type == _radioState.Band);
        var activeBandRange = activeBand?.Range ?? "";
        var activeBandCapacity = activeBand?.BandPresetCapacity ?? 0;
        var presetCount = _presets?.Count ?? 0;
        var bandSavable = !string.IsNullOrEmpty(_radioState.Band);
      }

      <!-- Tuner section header (handoff §P1·1 step 1) -->
      <div class="rcp-tuner-header">
        <h3 class="rcp-tuner-title">Tuner</h3>
        @if (!string.IsNullOrEmpty(activeBandRange))
        {
          <span class="rcp-tuner-band-range">@_radioState.Band · @activeBandRange</span>
        }
      </div>

      <!-- Band selector — tall two-line pills (handoff §P1·1 step 2). The
           active pill carries the long-press save-preset gesture (resolved
           spec ambiguity #4): short click = switch band, long press = save. -->
      @if (_availableBands.Any())
      {
        <div class="rcp-band-group">
          @foreach (var band in _availableBands)
          {
            var isActive = band.Type == _radioState.Band;
            <button type="button"
                    class="rcp-band-btn @(isActive ? "rcp-band-active" : "")"
                    @onclick="@(async () => await HandleBandPillClickAsync(band.Type, isActive))"
                    @onpointerdown="@(e => HandleBandPointerDown(band.Type, isActive))"
                    @onpointerup="@(e => HandleBandPointerUp(band.Type, isActive))"
                    @onpointerleave="@(e => HandleBandPointerCancel())"
                    @onpointercancel="@(e => HandleBandPointerCancel())"
                    title="@(isActive ? $"{band.Name} (hold to save preset)" : band.Name)">
              <span class="rcp-band-label">@band.Type</span>
              @if (!string.IsNullOrEmpty(band.Range))
              {
                <span class="rcp-band-sub">@band.Range</span>
              }
            </button>
          }
        </div>
      }

      <!-- RDS card — mounted ABOVE the frequency well (handoff §P1·1 step 3).
           Single-row layout (post HANDOFF-rds-inline-scroll-revision): the
           light-blue PS slot itself becomes the marquee surface when RT is
           present, so PS identity + accumulating RT share one continuous
           scroll string like "Eagles • Green Day · Hotel California".
           Collapses the two-row card PR #416 shipped — that variant pushed
           the frequency display + STEREO badge below the visible viewport
           at 1920×720.
           Separator is threaded from the SQLite-backed RdsScrollOptions so
           the PS↔RT join visually matches the inter-chunk joins inside
           the RT buffer. Speed goes through RdsScrollSpeedPolicy — a modest
           1.5× catch-up boost when the buffer backlog exceeds 75% of its
           cap, so a song-change burst surfaces the newest chunk sooner.
           The JS engine restarts its leg from the preserved offset on a
           speed change, so the boost engages/disengages seamlessly. -->
      <RdsCard StationName="@_radioState.RdsStationName"
               ProgramType="@_radioState.RdsProgramType"
               RadioText="@_rdsBuffer.Text"
               ScrollSpeedPxPerSec="@RdsScrollSpeedPolicy.EffectiveSpeed(_rdsScrollOptions.RtScrollSpeedPxPerSec, _rdsBuffer.Text.Length, _rdsBuffer.MaxChars)"
               Separator="@_rdsScrollOptions.RtChunkSeparator" />

      <!-- Frequency display -->
      <div class="rcp-freq-well">
        <div class="display-frequency display-frequency-ghost"
             data-ghost="888.88 MHz"
             @onclick="OpenFrequencyDialog"
             title="Click to set frequency">
          @FrequencyValue(_radioState.Frequency, _radioState.Band)<span class="rcp-freq-unit">@FrequencyUnit(_radioState.Band)</span>
        </div>
        <div class="rcp-freq-indicators">
          <div class="rcp-step-label rcp-step-clickable" @onclick="CycleStepSizeAsync"
               title="Click to change step size">
            STEP @FormatStep(_radioState.Step, _radioState.Band)
          </div>
          @if (_radioState.Band == "FM")
          {
            <div class="rcp-stereo-indicator @(_radioState.IsStereo ? "rcp-stereo-on" : "")">
              STEREO
            </div>
          }
        </div>
      </div>

      <!-- Signal strength meter (PR 1 of Radio Controller Polish arc) -->
      @if (_radioState.SignalStrength.HasValue)
      {
        <div class="rcp-meter">
          <div class="rcp-meter-header">
            @* Task #15 PR E item #29 — header label renamed from "SIGNAL" to
               "RSSI" so it aligns with the dBu-scaled axis labels and the
               calibrated readout to its right. Mock + Tester both expected
               RSSI here; the prior SIGNAL label drifted from what the meter
               actually shows. *@
            <span>RSSI</span>
            <span class="rcp-meter-readout">
              @if (_radioState.Clip)
              {
                <span class="rcp-clip-pill">CLIP</span>
              }
              <span class="rcp-meter-dbu">@($"{_radioState.RssiDbu.ToString("0").Replace("-", "−")} dBu")</span>
            </span>
          </div>
          <div class="rcp-meter-bar">
            @{
              // The DTO clamp guarantees SignalStrength ∈ [0, 100], so the
              // 20-segment fill never overflows. CLIP is the separate signal —
              // see the pill above.
              var clampedPct = _radioState.SignalStrength ?? 0;
            }
            @for (int i = 0; i < 20; i++)
            {
              var filled = clampedPct >= (i + 1) * 5;
              var segClass = i < 12 ? "seg-green" : i < 17 ? "seg-amber" : "seg-red";
              <div class="rcp-meter-seg @(filled ? segClass : "seg-off")"></div>
            }
          </div>
          <div class="rcp-meter-scale">
            <span>−60</span><span>−30</span><span>−12</span><span>0 dBu</span>
          </div>
        </div>
      }

      <!-- Scanning indicator -->
      @if (_radioState.IsScanning)
      {
        @if (_radioState.RssiDbu >= _radioState.ScanStopThreshold)
        {
          <div class="rcp-scan-signal">
            SIGNAL @(_radioState.RssiDbu.ToString("0")) dBu
          </div>
        }
        else
        {
          <div class="rcp-scanning">
            SCANNING @_radioState.ScanDirection?.ToUpperInvariant()
          </div>
        }
      }

      <!-- Tuning + Scan Controls -->
      <div class="rcp-controls">
        <RadzenButton Icon="keyboard_arrow_left"
                      ButtonStyle="ButtonStyle.Light" Size="ButtonSize.Medium"
                      class="rcp-tune-btn" Variant="Variant.Text"
                      Click="FrequencyDownAsync" title="Frequency Down" />
        @if (_radioState.IsScanning)
        {
          <RadzenButton Variant="Variant.Filled" ButtonStyle="ButtonStyle.Danger"
                        class="rcp-scan-btn"
                        Click="StopScanAsync" Icon="stop" Text="STOP" />
        }
        else
        {
          <RadzenButton Variant="Variant.Outlined" ButtonStyle="ButtonStyle.Light"
                        class="rcp-scan-btn"
                        Click="@(() => StartScanAsync("down"))" Icon="search" Text="SCAN ◀" />
          <RadzenButton Variant="Variant.Outlined" ButtonStyle="ButtonStyle.Light"
                        class="rcp-scan-btn"
                        Click="@(() => StartScanAsync("up"))" Text="▶ SCAN" Icon="search" />
        }
        <RadzenButton Icon="keyboard_arrow_right"
                      ButtonStyle="ButtonStyle.Light" Size="ButtonSize.Medium"
                      class="rcp-tune-btn" Variant="Variant.Text"
                      Click="FrequencyUpAsync" title="Frequency Up" />
      </div>

      <!-- SDR / gain controls (PR 1 — fixed two-cell grid; right cell always rendered) -->
      @if (_radioState.Gain.HasValue)
      {
        <div class="rcp-sdr-grid">
          @* Left cell: tappable AGC toggle + AUTO/OFF chip *@
          <button type="button"
                  class="rcp-agc-cell"
                  @onclick="@(async () => await HandleAutoGainChangedAsync(!_radioState.AutoGain))"
                  aria-pressed="@_radioState.AutoGain.ToString().ToLowerInvariant()"
                  aria-label="@(_radioState.AutoGain ? "Automatic gain control on — tap to disable" : "Automatic gain control off — tap to enable")">
            <span class="rcp-agc-label">AGC</span>
            <span class="@(_radioState.AutoGain ? "rcp-agc-chip-auto" : "rcp-agc-chip-off")">
              @(_radioState.AutoGain ? "AUTO" : "OFF")
            </span>
          </button>

          @* Right cell: always rendered; content swaps on AGC state *@
          <div class="rcp-gain-cell">
            @if (_radioState.AutoGain)
            {
              <span class="rcp-gain-auto-hint">Tuner is choosing</span>
              <span class="rcp-gain-auto-value">@_radioState.AppliedGain.ToString("0.0") dB</span>
            }
            else
            {
              <span class="rcp-gain-pill">@_radioState.AppliedGain.ToString("0") dB</span>
              <RadzenSlider TValue="int" Value="@_radioState.Gain.Value"
                            Change="@(async (int val) => await HandleGainChangedAsync(val))"
                            Min="0" Max="50" Step="1" Style="flex: 1; min-width: 0;" />
              <span class="rcp-gain-range-hint">0 – 50</span>
            }
          </div>
        </div>
      }
    </div>

    <!-- Presets Memory Bank — handoff §P1·2 (slot · name+band · freq grid),
         updated by the hot-fix off PR #371 (user feedback) so:
           1. ALL presets across ALL bands are shown (not just the current
              band) — the user couldn't find their saved WB station while
              tuned to FM. The .rcp-preset-band sub-line on each row already
              communicates the band context, so cross-band visibility is
              navigable.
           2. The header counter shows total saved across all bands rather
              than "N of CAP" (mixing band capacities would be confusing).
           3. Each row gains a trailing kebab opening a Rename + Delete
              popover. Long-press on the row also opens the same popover
              (matches the band-pill long-press-to-save gesture from PR 3).
           4. The single empty-slot placeholder still scopes to the
              current band so saving stays in-band. -->
    <div class="rcp-presets">
      <div class="rcp-presets-header">
        <span class="rcp-presets-count">
          MEMORY · @presetCount saved
        </span>
        @if (bandSavable)
        {
          <span class="rcp-presets-hint">HOLD <kbd>@_radioState.Band</kbd> TO SAVE</span>
        }
      </div>

      <div class="rcp-presets-list">
        @if (_presets == null || !_presets.Any())
        {
          <div class="rcp-presets-empty">
            <span class="rzi rzi-radio" style="font-size: 40px; opacity: 0.3;"></span>
            <span>NO PRESETS</span>
          </div>
        }
        else
        {
          @foreach (var preset in _presets)
          {
            var isActivePreset = IsActivePreset(preset);
            <PresetCard Variant="PresetCardVariant.Rail"
                        PresetId="@preset.Id"
                        Name="@preset.Name"
                        Frequency="@preset.Frequency"
                        Band="@preset.Band"
                        SlotNumber="@preset.SlotNumber"
                        IsActive="@isActivePreset"
                        OnSelect="HandlePresetRowClickAsync"
                        OnKebab="HandleKebabClickAsync"
                        OnPointerDown="HandlePresetPointerDown"
                        OnPointerUp="HandlePresetPointerUp"
                        OnPointerCancel="HandlePresetPointerCancel" />
          }
        }

        @* Render exactly ONE dashed-border placeholder for the next empty
           slot when the CURRENT band has capacity left. Slot numbering is
           per-band, so this counts the active-band presets only — keeps the
           "long-press to save" affordance scoped to where a new save will
           actually land. *@
        @if (activeBandCapacity > 0 && _presets != null)
        {
          var activeBandCount = _presets.Count(p => string.Equals(p.Band, _radioState.Band, StringComparison.OrdinalIgnoreCase));
          if (activeBandCount < activeBandCapacity)
          {
            var nextSlot = activeBandCount + 1;
            <div class="rcp-preset-item rcp-preset-empty">
              <span class="rcp-preset-slot">@nextSlot.ToString("00")</span>
              <span class="rcp-preset-empty-hint">EMPTY · long-press @(_radioState.Band) to save</span>
            </div>
          }
        }
      </div>
    </div>

    @* Preset action menu — anchored by absolute positioning when open. Only
       one menu is open at a time; clicking the overlay or hitting Esc closes
       it. Actions call into RenamePresetAsync / DeletePresetAsync below.
       A11y: the popover surface carries role="menu" + aria-label so screen
       readers announce it as a menu; items carry role="menuitem". Esc
       dismissal is wired on the overlay (tabindex=0 so it can receive
       keydown) and bubbles from the focused menu items. *@
    @if (!string.IsNullOrEmpty(_actionMenuPresetId))
    {
      <div class="rcp-preset-menu-overlay"
           tabindex="0"
           @onclick="CloseActionMenu"
           @onkeydown="HandleActionMenuKeyDown">
        <div class="rcp-preset-menu"
             role="menu"
             aria-label="Preset actions"
             @onclick:stopPropagation="true">
          <button type="button" class="rcp-preset-menu-item"
                  role="menuitem"
                  @onclick="@(() => OpenRenameDialog(_actionMenuPresetId!))">
            <span class="rzi rzi-edit" aria-hidden="true"></span> Rename
          </button>
          <button type="button" class="rcp-preset-menu-item rcp-preset-menu-danger"
                  role="menuitem"
                  @onclick="@(() => ConfirmDeleteAsync(_actionMenuPresetId!))">
            <span class="rzi rzi-delete" aria-hidden="true"></span> Delete
          </button>
        </div>
      </div>
    }
  }
</div>

@if (_isFrequencyDialogOpen)
{
  <div class="overlay" style="@(_isFrequencyDialogOpen ? "display:flex" : "display:none"); position:fixed; inset:0; background:rgba(0,0,0,0.5); z-index:9999; justify-content:center; align-items:center;" @onclick="CloseFrequencyDialog">
    <div style="min-width: 300px; background: var(--rz-base-background-color, #1e1e2e); border-radius: 8px; padding: 24px; box-shadow: 0 8px 32px rgba(0,0,0,0.6);" @onclick:stopPropagation="true">
      <h6 style="margin-bottom: 12px;">Set Frequency</h6>
      <RadzenNumeric TValue="double" @bind-Value="_newFrequency"
                     Placeholder="@(_radioState?.Band == "AM" ? "Frequency (kHz)" : "Frequency (MHz)")"
                     Min="@((decimal)GetMinFrequency())" Max="@((decimal)GetMaxFrequency())" Step="@GetDialogStep().ToString()"
                     Style="width: 100%;" inputmode="decimal" />
      <div style="display: flex; justify-content: flex-end; gap: 8px; margin-top: 12px;">
        <RadzenButton Variant="Variant.Text" Click="CloseFrequencyDialog" Text="Cancel" />
        <RadzenButton ButtonStyle="ButtonStyle.Primary" Variant="Variant.Filled"
                      Click="SetFrequencyAsync" Text="Set" />
      </div>
    </div>
  </div>
}

@if (_isSavePresetDialogOpen)
{
  <div class="overlay" style="@(_isSavePresetDialogOpen ? "display:flex" : "display:none"); position:fixed; inset:0; background:rgba(0,0,0,0.5); z-index:9999; justify-content:center; align-items:center;" @onclick="CloseSavePresetDialog">
    <div style="min-width: 300px; background: var(--rz-base-background-color, #1e1e2e); border-radius: 8px; padding: 24px; box-shadow: 0 8px 32px rgba(0,0,0,0.6);" @onclick:stopPropagation="true">
      <h6 style="margin-bottom: 12px;">Save Preset</h6>
      <RadzenTextBox @bind-Value="_presetName"
                     Placeholder="Preset Name" Style="width: 100%;" />
      <div style="display: flex; justify-content: flex-end; gap: 8px; margin-top: 12px;">
        <RadzenButton Variant="Variant.Text" Click="CloseSavePresetDialog" Text="Cancel" />
        <RadzenButton ButtonStyle="ButtonStyle.Warning" Variant="Variant.Filled"
                      Click="SavePresetAsync" Text="Save" />
      </div>
    </div>
  </div>
}

@if (_isRenamePresetDialogOpen)
{
  <div class="overlay" style="display:flex; position:fixed; inset:0; background:rgba(0,0,0,0.5); z-index:9999; justify-content:center; align-items:center;" @onclick="CloseRenamePresetDialog">
    <div class="rcp-preset-rename-card" style="min-width: 320px; background: var(--rz-base-background-color, #1e1e2e); border-radius: 8px; padding: 24px; box-shadow: 0 8px 32px rgba(0,0,0,0.6);" @onclick:stopPropagation="true">
      <h6 style="margin-bottom: 12px;">Rename Preset</h6>
      <RadzenTextBox @bind-Value="_renamePresetName"
                     Placeholder="Preset Name" Style="width: 100%;" />
      <div style="display: flex; justify-content: flex-end; gap: 8px; margin-top: 12px;">
        <RadzenButton Variant="Variant.Text" Click="CloseRenamePresetDialog" Text="Cancel" />
        <RadzenButton ButtonStyle="ButtonStyle.Primary" Variant="Variant.Filled"
                      Click="RenamePresetAsync" Text="Save" />
      </div>
    </div>
  </div>
}

<style>
  /* ═══════════════════════════════════════════════════════════ */
  /*  Radio Control Panel — Command Surface Console Aesthetic   */
  /*  Professional broadcast equipment: recessed wells, beveled */
  /*  buttons, LED indicators, precision hardware feel.         */
  /* ═══════════════════════════════════════════════════════════ */

  .rcp-root {
    height: 100%;
    display: flex;
    overflow: hidden;
    background: #080809;
    border: 1px solid var(--surface-separator);
    border-radius: 4px;
    position: relative;
  }

  /* Subtle brushed-metal noise texture */
  .rcp-root::after {
    content: '';
    position: absolute;
    inset: 0;
    background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='.75' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='.035'/%3E%3C/svg%3E");
    pointer-events: none;
    z-index: 0;
    mix-blend-mode: overlay;
  }

  /* ── Tuner Section ── */

  .rcp-tuner {
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: flex-start;
    padding: 32px 24px 12px;
    gap: 10px;
    position: relative;
    z-index: 1;
    min-width: 0;
    overflow: hidden;
  }

  /* Amber accent hairline at top edge — broadcast channel strip */
  .rcp-tuner::before {
    content: '';
    position: absolute;
    top: 0;
    left: 24px;
    right: 24px;
    height: 2px;
    background: linear-gradient(90deg,
      transparent 0%,
      rgba(240, 168, 48, 0.25) 15%,
      rgba(240, 168, 48, 0.6) 40%,
      var(--signal-amber) 50%,
      rgba(240, 168, 48, 0.6) 60%,
      rgba(240, 168, 48, 0.25) 85%,
      transparent 100%
    );
    box-shadow: 0 0 12px rgba(240, 168, 48, 0.15), 0 2px 8px rgba(240, 168, 48, 0.08);
  }

  /* PR 3 of the Radio Controller Polish arc — `.rcp-module-label` was the
     absolute-positioned "TUNER" chrome label at the top of the panel. It is
     replaced by the real `.rcp-tuner-header` row (Inter h3 + band/range
     pair) defined in design-system.css §W. The legacy CSS block has been
     removed. */

  /* ── Band Selector — Console Push-Buttons ── */

  .rcp-band-group {
    /* Hot-fix off PR #371 (user feedback): even with flex-wrap, the AM
       + VHF labels were clipping at 1920×720 because the group was
       sized to its content and overflowed its parent before wrap could
       fire. width: 100% pins the row to the parent column so wrap has
       a real boundary to pivot against. Combined with the min-width
       reduction in .rcp-band-btn (design-system.css §W: 64 → 56) and
       the smaller sub-range font, six pills now fit cleanly or wrap
       to 3+3 on narrower containers.

       PR A follow-up #37: 24px top margin moved here from the tuner
       header's bottom margin (16px) to match spec §P1·1 step 1's
       wording ("24 px top margin on the content below the header"). */
    display: flex;
    flex-wrap: wrap;
    width: 100%;
    justify-content: center;
    gap: 2px;
    row-gap: 4px;
    padding: 3px;
    margin-top: 24px;
    background: #0a0a0c;
    border-radius: 5px;
    border: 1px solid #1a1a1d;
    box-shadow: inset 0 1px 4px rgba(0, 0, 0, 0.6);
  }

  /* PR 3 of the Radio Controller Polish arc — band pills are now tall and
     two-line (label + sub-range). Height/padding/flex-direction live in
     design-system.css §W so the legacy `height: 32px` rule below was
     removed. The visual treatment (gradient background, beveled border,
     amber-active state) stays here because it's specific to the
     RadioControlPanel chrome aesthetic. */
  .rcp-band-btn {
    border-radius: 3px;
    font-family: var(--font-mono);
    font-weight: 700;
    color: var(--text-low);
    background: linear-gradient(180deg, #161618 0%, #111113 100%);
    border: 1px solid #1e1e21;
    border-bottom: 2px solid #0a0a0c;
    display: flex;
    cursor: pointer;
    transition: all 80ms ease;
    user-select: none;
    -webkit-tap-highlight-color: transparent;
    box-shadow: 0 1px 2px rgba(0, 0, 0, 0.3);
  }

  .rcp-band-btn:hover {
    color: var(--text-medium);
    background: linear-gradient(180deg, #1c1c1f 0%, #141416 100%);
  }

  .rcp-band-btn:active {
    transform: translateY(1px);
    border-bottom-width: 1px;
    box-shadow: none;
  }

  .rcp-band-active {
    color: var(--signal-amber) !important;
    background: linear-gradient(180deg, #1a1508 0%, #14100a 100%) !important;
    border-color: rgba(240, 168, 48, 0.25) !important;
    border-bottom-color: rgba(240, 168, 48, 0.15) !important;
    box-shadow:
      0 0 10px rgba(240, 168, 48, 0.12),
      inset 0 1px 0 rgba(240, 168, 48, 0.08) !important;
    text-shadow: 0 0 8px rgba(240, 168, 48, 0.4);
  }

  /* ── Frequency Display Well — Recessed LCD Panel ── */

  .rcp-freq-well {
    text-align: center;
    padding: 14px 32px 10px;
    background: #040406;
    border-radius: 6px;
    border: 1px solid #0e0e10;
    box-shadow:
      inset 0 2px 10px rgba(0, 0, 0, 0.9),
      inset 0 -1px 3px rgba(0, 0, 0, 0.4),
      0 1px 0 rgba(255, 255, 255, 0.02);
    position: relative;
    overflow: hidden;
    width: 100%;
    max-width: 420px;
  }

  /* LCD scan-line texture overlay */
  .rcp-freq-well::before {
    content: '';
    position: absolute;
    inset: 0;
    background: repeating-linear-gradient(
      0deg,
      transparent 0px,
      transparent 3px,
      rgba(0, 0, 0, 0.1) 3px,
      rgba(0, 0, 0, 0.1) 4px
    );
    pointer-events: none;
    z-index: 2;
    opacity: 0.6;
  }

  /* Frequency display sizing override for the well context.
     Hot-fix off PR #371: user asked for the radio frequency to be 20%
     smaller. 54px × 0.8 = 43.2 → 43px keeps a clean pixel boundary and
     leaves more headroom for the well's bezel + scan/step row below. */
  .rcp-freq-well .display-frequency {
    font-size: 43px;
    position: relative;
    z-index: 1;
    cursor: pointer;
    white-space: nowrap;
  }

  /* Unit label (MHz/kHz) at ~33% smaller than the numeric frequency */
  .rcp-freq-unit {
    font-size: 0.65em;
    letter-spacing: 2px;
    margin-left: 2px;
    opacity: 0.8;
  }

  /* Slightly brighter ghost segments for VFD realism */
  .rcp-freq-well .display-frequency-ghost::before {
    opacity: 0.08 !important;
  }

  .rcp-freq-indicators {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-top: 6px;
    position: relative;
    z-index: 1;
  }

