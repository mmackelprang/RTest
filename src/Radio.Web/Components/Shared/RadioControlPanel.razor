        await LoadRadioStateAsync();
        await InvokeAsync(StateHasChanged);
      }
    }
    catch (Exception ex) { Logger.LogError(ex, "Error in HandleAutoGainChangedAsync"); }
  }

  private async Task HandleGainChangedAsync(int gain)
