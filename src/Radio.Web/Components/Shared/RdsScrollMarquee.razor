@* RdsScrollMarquee — accumulating RDS RadioText ticker.

   Renders the rolling buffer inside RdsCard (single-row PS-anchored layout,
   HANDOFF-rds-inline-scroll-revision). When Text is empty, renders nothing
   (matches existing rcp-rds-rt collapse-when-empty behaviour).

   Scroll engine: wwwroot/js/rds-marquee.js (Web Animations API — composited
   off the main thread, same rationale as the original CSS keyframes choice).
   The old pure-CSS marquee restarted/reinterpreted its keyframes whenever an
   append changed the track width + inline --scroll-duration, snapping the
   text many characters at once ("jerk"). The JS engine owns the scroll
   offset explicitly and preserves it across renders: appends extend the
   runway seamlessly, buffer front-evictions are compensated by the trimmed
   width (MarqueeTextDiff classifies each text change), and the static-fit
   branch is decided from REAL measured widths instead of the old 7 px/char
   × 420 px approximation that clipped in-card 14 px text.

   Spec: HANDOFF-rds-accumulating-scroll §3, §4, §7 (behaviours preserved:
   pause-on-hover/focus, prefers-reduced-motion fallback, SR-only aria-live
   mirror, static-fit branch, configurable speed). *@

@using Radio.Web.Services.Rds
@using Microsoft.JSInterop
@inject IJSRuntime JS
@implements IAsyncDisposable

@if (!string.IsNullOrEmpty(Text))
{
  <div @ref="_containerRef"
       class="rcp-rds-rt-scroll"
       tabindex="0"
       aria-label="RDS RadioText"
       title="@Text">
    @* Visible scrolling track — hidden from assistive tech (the mirror
       below carries the readable copy). The transform is driven entirely by
       the JS engine; Blazor only ever updates the text content. *@
    <div @ref="_trackRef" class="rcp-rds-rt-track" aria-hidden="true">@Text</div>

    @* SR-only mirror — aria-live="polite" so screen readers announce buffer
       updates without interrupting the user. *@
    <div class="rcp-rds-rt-sr-only" aria-live="polite" aria-atomic="true">
      @Text
    </div>
  </div>
}

@code {
  /// <summary>
  /// Current buffer text rendered into the marquee. Empty / null collapses
  /// the entire component (no markup) and disposes the JS engine instance.
  /// </summary>
  [Parameter, EditorRequired] public string? Text { get; set; }

  /// <summary>
  /// Marquee scroll speed in pixels per second. Default 40 matches the
  /// <see cref="Models.RdsScrollOptions"/> default; the parent reads from
  /// IOptionsMonitor and passes through (optionally boosted by
  /// <see cref="Services.Rds.RdsScrollSpeedPolicy"/> when the buffer backlog
  /// grows), so SQLite-store writes take effect on the next render. Speed
  /// changes restart the animation leg from the preserved offset — no jump.
  /// </summary>
  [Parameter] public int ScrollSpeedPxPerSec { get; set; } = 40;

  // Per-instance id for the JS engine registry. Keyed by number (not by
  // element) so dispose works even after Blazor detached the elements —
  // no stale Map entries holding detached DOM (leak guard).
  private static int s_nextInstanceId;
  private readonly int _instanceId = System.Threading.Interlocked.Increment(ref s_nextInstanceId);

  private ElementReference _containerRef;
  private ElementReference _trackRef;
  private IJSObjectReference? _module;
  private bool _engineAttached;

  // Last state pushed to the JS engine — the diff baseline for the next push.
  private string? _engineText;
  private int _engineSpeed;

  // Last-rendered inputs for the ShouldRender guard.
  private string? _renderedText;
  private int _renderedSpeed;

  /// <summary>
  /// Suppress re-renders that wouldn't change anything the user can see. The
  /// parent (RadioControlPanel) re-renders ~2x/second because the SignalR
  /// radio-state broadcast lumps volatile signal telemetry in with RDS text;
  /// without this guard every telemetry tick would churn the DOM and push a
  /// no-op interop call. Blazor always renders the first frame regardless of
  /// ShouldRender, so the cache-priming below correctly captures the
  /// first-render inputs.
  /// </summary>
  protected override bool ShouldRender()
  {
    var changed =
      !string.Equals(_renderedText, Text, StringComparison.Ordinal) ||
      _renderedSpeed != ScrollSpeedPxPerSec;

    if (changed)
    {
      _renderedText = Text;
      _renderedSpeed = ScrollSpeedPxPerSec;
    }

    return changed;
  }

  protected override async Task OnAfterRenderAsync(bool firstRender)
  {
    try
    {
      if (string.IsNullOrEmpty(Text))
      {
        // Markup unmounted this render — tear down the engine instance so no
        // animation/listeners/DOM refs linger (leak guard). A later non-empty
        // render re-inits against the freshly-created elements.
        if (_engineAttached && _module != null)
        {
          await _module.InvokeVoidAsync("dispose", _instanceId);
          _engineAttached = false;
          _engineText = null;
        }
        return;
      }

      _module ??= await JS.InvokeAsync<IJSObjectReference>("import", "./js/rds-marquee.js");

      if (!_engineAttached)
      {
        await _module.InvokeVoidAsync("init", _instanceId, _containerRef, _trackRef, ScrollSpeedPxPerSec);
        _engineAttached = true;
        _engineText = Text;
        _engineSpeed = ScrollSpeedPxPerSec;
        return;
      }

      if (!string.Equals(_engineText, Text, StringComparison.Ordinal))
      {
        // Text changed — classify the transition so the engine can preserve
        // the scroll offset wherever that is visually meaningful.
        var diff = MarqueeTextDiff.Compute(_engineText, Text);
        var mode = diff.Transition switch
        {
          MarqueeTransition.Continuation => "append",
          MarqueeTransition.InPlaceSwap => "swap",
          _ => "reset",
        };
        await _module.InvokeVoidAsync("update", _instanceId, mode, diff.TrimmedCharCount, ScrollSpeedPxPerSec);
        _engineText = Text;
        _engineSpeed = ScrollSpeedPxPerSec;
      }
      else if (_engineSpeed != ScrollSpeedPxPerSec)
      {
        await _module.InvokeVoidAsync("update", _instanceId, "speed", 0, ScrollSpeedPxPerSec);
        _engineSpeed = ScrollSpeedPxPerSec;
      }
    }
    catch (JSDisconnectedException)
    {
      // Circuit tearing down — nothing left to drive; DisposeAsync handles
      // the rest.
    }
    catch (Exception)
    {
      // Broad by design (mirrors VoicemailPlayer's OnAfterRenderAsync interop
      // guard): a transient module-load failure or JSException here must
      // degrade to "ticker doesn't animate until the next update" — an
      // unhandled lifecycle exception would fault the circuit, which on an
      // unattended kiosk takes down the whole page with nobody there to
      // reload it. The next text/speed change retries the interop naturally.
    }
  }

  public async ValueTask DisposeAsync()
  {
    // Mirror the VoicemailPlayer disposal pattern: best-effort interop (the
    // circuit may already be gone), then release the module reference.
    try
    {
      if (_module != null && _engineAttached)
      {
        await _module.InvokeVoidAsync("dispose", _instanceId);
      }
    }
    catch
    {
      // JSDisconnected / ObjectDisposed during teardown — nothing to clean.
    }

    try
    {
      if (_module != null)
      {
        await _module.DisposeAsync();
      }
    }
    catch
    {
      // Ignore — module handle release is best-effort at circuit teardown.
    }
  }
}
