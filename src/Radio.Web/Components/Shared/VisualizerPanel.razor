@rendermode InteractiveServer
@inject AudioVisualizationHubService VisualizationHub
@inject VisualizerTelemetryService Telemetry
@inject IJSRuntime JS
@inject ILogger<VisualizerPanel> Logger
@inject ConfigurationApiService ConfigApi
@inject RadioApiService RadioApi
@inject SourcesApiService SourcesApi
@inject AudioStateHubService AudioStateHub
@implements IAsyncDisposable

@*
  VisualizerPanel — full-bleed visualizer with a 5-segment mode picker.

  PR 4 rework (handoff §P1·3):
    • Replaced the floating chip group with a full-width header — 44px tall,
      mono 12px uppercase 0.10em letter-spacing, active segment tinted with
      --accent-dim + accent underline.
    • Canvas now fills the remaining vertical space — no inset padding.
    • "Connected" pill collapsed to an 8px dot at top-right. (Removed by UI-30.)
    • The "Updates: NN/sec" overlay moves out of the canvas into
      VisualizerTelemetryService so the dev tray (PR 6) can subscribe.
    • Frequency-band axis labels live in a 16px strip under the canvas
      (mono 10px, low-contrast).

  AUD-76 PR 2: the picker was Wave / Spectrum / BAND / Ring / Phase (UI-29 moved
  BAND last). BAND (the stored FM band map, touch-to-tune) took Fall's position; Fall (the audio
  spectrogram) and VU were removed. BAND reads /api/radio/bandmap on a timer
  and subscribes to no visualization hub stream. The default mode is Spectrum.

  AUD-91: BAND shows the map of the radio's band (the band selected in the radio
  control panel), which the API resolves when no band is asked for. The axis,
  gridlines, bar width, markers and tap snap follow that band; AM and SW cannot
  be scanned and say so. It follows a band change at once through
  AudioStateHub.RadioStateChanged (the audio-state hub, not the visualization
  hub), not only on its timer.

  UI-29: the picker is Wave / Spectrum / Ring / Phase / BAND, and BAND can be
  picked only while the radio is the active source (disabled otherwise). The
  saved preference (_preferredMode) and the mode on screen (_currentMode) are
  separate: a saved BAND shows Spectrum while the radio is not active, without
  overwriting the preference, and BAND returns when the radio does. Picking any
  enabled tab replaces the preference. See DisplayModeFor.

  UI-30: the header's connection dot is gone. While the visualization hub is not
  connected, the hub-fed modes show a "disconnected" state in the canvas area
  instead. BAND does not: it reads the REST API, not the hub.

  UI-31: the BAND tab reads RADIO (owner: "band isn't descriptive of what it does"); only user-facing text
  changed — the enum member, the saved preference value ("Band") and the API routes keep their names, so a
  saved preference still opens this view. The view's text moved from a bar over the top of the plot to a
  strip under it: the band's name and range, the discovery status and colour key, help text, and the
  sweep button, renamed Discover so it is not mistaken for the radio panel's seek SCAN buttons. The axis
  labels sit inside the canvas over the drawn axis, and presets are carets on it. Spec:
  docs/design-handoffs/2026-10-02-band-view-strip.md.
*@

<div class="viz-panel">
  <!-- 5-segment mode picker header -->
  <div class="visualizer-header">
    <div class="visualizer-mode-picker" role="tablist" aria-label="Visualizer mode">
      <button class="visualizer-mode @(_currentMode == VisualizationMode.Waveform ? "is-active" : "")"
              type="button"
              @onclick="@(() => SelectMode(VisualizationMode.Waveform))"
              role="tab"
              aria-selected="@(_currentMode == VisualizationMode.Waveform ? "true" : "false")"
              aria-label="Waveform mode">Wave</button>
      <button class="visualizer-mode @(_currentMode == VisualizationMode.Spectrum ? "is-active" : "")"
              type="button"
              @onclick="@(() => SelectMode(VisualizationMode.Spectrum))"
              role="tab"
              aria-selected="@(_currentMode == VisualizationMode.Spectrum ? "true" : "false")"
              aria-label="Spectrum mode">Spectrum</button>
      <button class="visualizer-mode @(_currentMode == VisualizationMode.Circular ? "is-active" : "")"
              type="button"
              @onclick="@(() => SelectMode(VisualizationMode.Circular))"
              role="tab"
              aria-selected="@(_currentMode == VisualizationMode.Circular ? "true" : "false")"
              aria-label="Circular spectrum mode">Ring</button>
      <button class="visualizer-mode @(_currentMode == VisualizationMode.PhaseScope ? "is-active" : "")"
              type="button"
              @onclick="@(() => SelectMode(VisualizationMode.PhaseScope))"
              role="tab"
              aria-selected="@(_currentMode == VisualizationMode.PhaseScope ? "true" : "false")"
              aria-label="Phase scope mode">Phase</button>
      @* UI-29: last, and only while the radio is the active source. `disabled` takes it out of the tab
         order and ignores taps (the brief: not focusable, not tappable); aria-disabled and the described-by
         hint say why it is there at all, for anyone reading the page rather than tabbing through it.
         UI-31: labelled RADIO (the mode is still VisualizationMode.Band, and is saved as "Band"), and no
         `title` tooltip — the owner: "No tooltip needed for the gray 'Band' selection". *@
      <button class="visualizer-mode @(_currentMode == VisualizationMode.Band ? "is-active" : "")"
              type="button"
              disabled="@(!IsBandSelectable)"
              aria-disabled="@(IsBandSelectable ? "false" : "true")"
              aria-describedby="@(IsBandSelectable ? null : BandHintId)"
              @onclick="@(() => SelectMode(VisualizationMode.Band))"
              role="tab"
              aria-selected="@(_currentMode == VisualizationMode.Band ? "true" : "false")"
              aria-label="Radio signal map mode">@RadioTabLabel</button>
    </div>
    @if (!IsBandSelectable)
    {
      <span id="@BandHintId" class="visually-hidden">@BandUnavailableHint</span>
    }
  </div>

  <!-- Full-bleed canvas -->
  <div class="visualizer-canvas-wrap">
    @*
      Canvas is rendered UNCONDITIONALLY here, not inside the @if branch
      below. visualizer.js's init call in OnAfterRenderAsync targets the
      canvas by element id (WebConstants.ElementIds.VisualizerCanvas), so
      the element must already exist in the DOM on the first render pass —
      we can't gate it on _isInitialized without creating a chicken-and-egg
      between "init runs after canvas mounts" and "canvas mounts after
      init succeeds".

      The Skeleton in the !_isInitialized branch therefore overlays the
      already-mounted-but-not-yet-drawn-to canvas for the brief window
      between first render and the successful return of visualizer.init.
      This produces a visible "skeleton sitting on top of blank canvas"
      flash for ~1 frame on slow connections. That is INTENTIONAL — it
      bridges the gap so users don't see a blank black rectangle. Don't
      "fix" the overlap by hiding the canvas behind _isInitialized; that
      would break visualizer.init's element lookup. The visualizer-canvas
      and skeleton both fill the wrap via position: absolute / inset: 0,
      and the skeleton's z-index sits above the canvas until the @if
      flips and the skeleton unmounts.
    *@
    <canvas id="@WebConstants.ElementIds.VisualizerCanvas" class="visualizer-canvas @(IsBandMode ? "is-band" : "")"
            role="@(IsBandMode ? "img" : null)"
            aria-label="@(IsBandMode ? BandCanvasLabel : null)"></canvas>

    @if (!_isInitialized)
    {
      <Skeleton Shape="Skeleton.SkeletonShape.Visualizer" />
    }
    else if (IsBandMode)
    {
      @* UI-31: the axis labels, over the axis visualizer.js draws in the canvas's bottom 32 px. Markup, not
         canvas text, so they can be read and tested; each sits at its tick's fraction of the width, the
         fraction the canvas draws the tick at. Nothing over the canvas takes pointer events, so a tap
         anywhere on it reaches the tap handler. No axis on a band this radio cannot receive: there is no
         plot to read it against. *@
      @if (IsShownBandMappable)
      {
        <div class="band-axis-labels" aria-hidden="true">
          @foreach (BandAxisLabel label in _bandAxis.Labels())
          {
            <span class="@AxisLabelClass(label.Align)" style="left: @AxisLeftPercent(label.Fraction)%">@label.Text</span>
          }
        </div>
      }

      @if (!IsShownBandMappable)
      {
        <div class="band-empty is-unavailable">
          <div class="band-empty-title">@ShownBand is out of this radio's range</div>
          @if (!string.IsNullOrWhiteSpace(_bandMap?.UnavailableReason))
          {
            <div class="band-empty-sub">@_bandMap.UnavailableReason</div>
          }
        </div>
      }
      else if (!HasBandMap && !IsSweepingShownBand)
      {
        <div class="band-empty">
          <div class="band-empty-title">No stations discovered yet</div>
          @if (ShownSeekStations().Count > 0)
          {
            @* AUD-100: a seek proves a station is there, not that the rest of the band is empty — so the band
               still reads as undiscovered, and the rings are named as Scan's. *@
            <div class="band-empty-sub">The rings mark where Scan stopped. Tap Discover to sweep the whole band.</div>
          }
          else
          {
            <div class="band-empty-sub">The band is swept automatically a few minutes after start-up, or tap Discover.</div>
          }
        </div>
      }
    }
    else if (!VisualizationHub.IsConnected)
    {
      @* UI-30: replaces the header's 8 px dot. Takes precedence over "Waiting for audio data", which would
         otherwise sit there indefinitely while nothing can arrive. Rendered once per disconnection, so the
         status is announced on the change, not on every frame. *@
      <div class="visualizer-disconnected" role="status" aria-live="polite">
        @* aria-hidden: the icon is a font ligature, so its name ("link_off") is text inside the live region. *@
        <RadzenIcon Icon="link_off" class="visualizer-disconnected-icon" aria-hidden="true" />
        <div class="visualizer-disconnected-title">Visualizer disconnected</div>
        <div class="visualizer-disconnected-sub">Reconnecting...</div>
      </div>
    }
    else if (!_hasReceivedData)
    {
      <div class="visualizer-waiting" aria-live="polite">
        <RadzenIcon Icon="graphic_eq" Style="font-size: 64px; color: var(--text-low); margin-bottom: 8px;" />
        <div style="font-size: 16px; color: var(--text-low);">Waiting for audio data...</div>
      </div>
    }
  </div>

  @if (IsBandMode)
  {
    @* UI-31: the strip under the map. Left, the band's name and range (before the first map read the band
       is not known, and nothing is named — AUD-91). Middle, the discovery status and the colour key, then
       either the help text or a tune/discover message. Right, Discover. The status line is not a live
       region: the countdown re-renders every second while a sweep runs and would be announced each tick.
       Tune confirmations go to one persistent polite region (a region inserted together with its text is
       announced unreliably); errors render on demand as an alert. *@
    <div class="band-strip">
      <div class="band-strip-band">
        @if (_bandMap != null)
        {
          <div class="band-strip-title">
            <span class="band-strip-name">@ShownBand</span>
            @if (IsVhfWindow)
            {
              <span class="band-strip-window">Window</span>
            }
          </div>
          @if (ShownRange != null)
          {
            <div class="band-strip-range">@ShownRange</div>
          }
        }
      </div>

      <div class="band-strip-text">
        <div class="band-status-line">
          @if (_bandMap?.Sweep.IsSweeping == true)
          {
            <span class="band-status-discovering">@BandMapText.FormatDiscovering(_bandMap.Sweep.EstimatedSecondsRemaining, _bandMap.Sweep.Progress, IsSweepingOtherBand ? _bandMap.Sweep.Band : null)</span>
          }
          else if (!IsShownBandMappable)
          {
            <span class="band-status-unavailable">Out of range</span>
          }
          else if (HasBandMap)
          {
            <span class="band-status-age">discovered @BandMapText.FormatAge(_bandMap!.AgeSeconds)</span>
          }
          @* UI-22: the bars' colour key, whenever the shown band's map has channels — so not for an empty
             map or a band out of range, and it stays through a sweep of a band that already has a map, which
             is drawn meanwhile. (A flat dead map has channels but no bar tall enough to draw; the key still
             shows.) Grey (noise) is not listed: it reads as nothing. The swatches are decoration. *@
          @* AUD-100: the seek-observed key shows whenever such a marker is drawn, with or without a map — on
             a never-swept band it is the only key, and the status line still says nothing was discovered. *@
          @if ((HasBandMap && IsShownBandMappable) || ShownSeekStations().Count > 0)
          {
            <span class="band-legend">
              @if (HasBandMap && IsShownBandMappable)
              {
                <span class="band-legend-item"><span class="band-legend-swatch is-weak" aria-hidden="true"></span>weak</span>
                <span class="band-legend-item"><span class="band-legend-swatch is-fair" aria-hidden="true"></span>fair</span>
                <span class="band-legend-item"><span class="band-legend-swatch is-strong" aria-hidden="true"></span>strong</span>
              }
              @if (ShownSeekStations().Count > 0)
              {
                <span class="band-legend-item"><span class="band-legend-swatch is-seek" aria-hidden="true"></span>found by scan</span>
              }
            </span>
          }
        </div>

        <div class="band-strip-lower">
          <div class="band-message-live" role="status" aria-live="polite" aria-atomic="true">
            @if (_bandMessage != null && !_bandMessageIsError)
            {
              <span class="band-status-message">@_bandMessage</span>
            }
          </div>
          @if (_bandMessage != null && _bandMessageIsError)
          {
            <div class="band-status-message is-error" role="alert">@_bandMessage</div>
          }
          else if (_bandMessage == null && IsShownBandMappable)
          {
            @* The glyphs are pictures of what to look for (the preset caret drawn on the axis; the tuner's step
               buttons), hidden from screen readers, which would read them as "black up-pointing triangle" and
               "single angle quotation marks"; words stand in for them. "The tuner", not "the radio panel":
               this view's own tab reads Radio. *@
            <div class="band-strip-help">
              <span>Touch a signal to snap to it. <span aria-hidden="true">▲</span><span class="visually-hidden">A triangle</span> marks a preset.</span>
              <span>Fine-tune with the tuner's <span aria-hidden="true">‹ ›</span><span class="visually-hidden">step</span> buttons or the knob.</span>
            </div>
          }
        </div>
      </div>

      <button type="button"
              class="band-discover-btn"
              disabled="@(_bandMap?.Sweep.IsSweeping == true || _scanRequestInFlight || !IsShownBandMappable)"
              aria-label="@(_bandMap == null ? "Discover stations in this band" : $"Discover stations in the {ShownBand} band")"
              @onclick="RequestDiscoverAsync">Discover</button>
    </div>
  }
  else if (IsSpectrumMode)
  {
    <div class="visualizer-axis" aria-hidden="true">
      <span>375 Hz</span>
      <span>750 Hz</span>
      <span>1.1 kHz</span>
      <span>1.5 kHz</span>
    </div>
  }
</div>

@code {
  /// <summary>
  /// The visualizer's modes. <c>internal</c> so the saved-preference mapping is unit-testable.
  /// VU and Spectrogram ("Fall") were removed by AUD-76; see <see cref="ParseSavedMode"/>.
  /// </summary>
  internal enum VisualizationMode
  {
    Waveform,
    Spectrum,
    Band,
    Circular,
    PhaseScope
  }

  /// <summary>
  /// How often BAND re-reads the map while a sweep runs, so the "Discovering… N s" countdown moves.
  /// <c>internal</c> so tests advance the fake clock by the production value.
  /// </summary>
  internal static readonly TimeSpan BandSweepingRefresh = TimeSpan.FromSeconds(1);

  /// <summary>How often BAND re-reads the map, the station and the presets when no sweep runs.</summary>
  internal static readonly TimeSpan BandIdleRefresh = TimeSpan.FromSeconds(30);

  /// <summary>
  /// How long a tune/scan message stays up. The refresh timer is armed for no later than the message's
  /// expiry while one is showing, and the refresh it fires clears it.
  /// </summary>
  internal static readonly TimeSpan BandMessageLifetime = TimeSpan.FromSeconds(4);

  /// <summary>The source type <c>POST /api/sources</c> takes for the radio — what MainLayout sends.</summary>
  internal const string RadioSourceType = "Radio";

  /// <summary>
  /// The clock BAND's refresh timer is armed against. Production never sets this. A parameter rather
  /// than <c>@inject</c> because neither host registers a <see cref="TimeProvider"/> — the same
  /// reasoning as DiagnosticsPanel's <c>Clock</c>.
  /// </summary>
  [Parameter] public TimeProvider Clock { get; set; } = TimeProvider.System;

  /// <summary>The accessible hint on a disabled RADIO (band map) tab (UI-29; no tooltip since UI-31).</summary>
  internal const string BandUnavailableHint = "Available when the radio is the active source";

  /// <summary>
  /// The band map tab's label (UI-31; was "BAND"), title case like its siblings — the picker's CSS
  /// upper-cases them all. The mode behind it is still
  /// <see cref="VisualizationMode.Band"/>, saved as <c>Band</c>.
  /// </summary>
  internal const string RadioTabLabel = "Radio";


  // The described-by target for the hint. One panel per page, so a fixed id is unique.
  private const string BandHintId = "visualizer-band-hint";

  // UI-29: one mode change at a time. Mode changes await hub RPCs and JS calls, and since UI-29 they come
  // from a tap, from SourceChanged (often twice per switch — the server's broadcast and MainLayout's local
  // nudge), from RadioStateChanged and from BAND's own state reads. Unserialised, a change that started
  // first could finish last and leave the screen contradicting the rule; see ReconcileModeAsync.
  private readonly SemaphoreSlim _modeGate = new(1, 1);

  // The mode on screen. UI-29: may differ from _preferredMode — see DisplayModeFor.
  private VisualizationMode _currentMode = VisualizationMode.Spectrum;

  // The mode the user picked last (the saved ui.visualizer/defaultMode).
  private VisualizationMode _preferredMode = VisualizationMode.Spectrum;

  // UI-29: whether the radio is the active source, from /api/radio/state at start-up and on every
  // SourceChanged. False until a read says otherwise; a read that fails keeps the previous value.
  private bool _radioActive;

  // UI-30: the hub's state as of the last ConnectionStateChanged this panel handled.
  private bool _wasHubConnected;
  private bool _isInitialized;
  private bool _isDisposed;
  private bool _hasReceivedData;
  private IJSObjectReference? _jsModule;

  // Updates/sec telemetry — frames drawn, counted in DrawFrameAsync and sampled every second by
  // _telemetryTimer.
  private int _frameCountSinceLastSample;
  private ITimer? _telemetryTimer;

  // ── live-stream stall watch (UI-36) ──
  // Frames that arrived from the hub since the last tick. Separate from _frameCountSinceLastSample
  // because RequestInitialData draws a frame it fetched on demand, and that frame says nothing about
  // whether the live stream is flowing.
  private int _hubFramesSinceLastTick;

  // Consecutive whole ticks with no hub frame while the stream should be flowing; 0 while healthy.
  private int _silentTicks;

  // When the current stall began (the start of its first silent tick), for the recovery log line.
  private DateTimeOffset _stallStartedAt;

  // The tick count at which the next re-subscribe may be sent, so a stream that stays down is re-asked
  // with backoff rather than every second.
  private int _nextRecoveryAtSilentTicks = StallTicks;

  // Latest-wins draw (UI-36): the newest frame not yet drawn, and whether a drain loop is running.
  // The hub's receive loop hands frames over here and returns at once; it never waits on the browser.
  private object? _pendingFrame;
  private int _drawLoopRunning;
  private Task _drawLoop = Task.CompletedTask;

  // One slow-draw warning per stall, re-armed by the next fast draw, so a browser that stays slow
  // produces one log line rather than twenty a second.
  private bool _slowDrawLogged;

  /// <summary>The telemetry tick, which is also the stall check's clock.</summary>
  internal static readonly TimeSpan TelemetryInterval = TimeSpan.FromSeconds(1);

  /// <summary>
  /// UI-36: how many consecutive silent ticks count as a stalled stream. <c>VisualizationBroadcastService</c>
  /// broadcasts at 20 fps while a client is connected, broadcasting is enabled, and the visualizer has
  /// processed any audio since radio-api started (<c>IsActive</c>) — silence included, as flat frames — so
  /// two whole seconds with no frame is a stream that has stopped, not a quiet song. ⚠ One known false
  /// positive: straight after a radio-api restart, before any audio has reached the tap, no frames are sent
  /// by design; the panel then logs one stall Warning and re-asks on its backoff (every 30 s at most).
  /// </summary>
  internal const int StallTicks = 2;

  /// <summary>
  /// UI-36: a single browser round trip for one frame longer than this is logged, once per episode. It
  /// is the measurement the row could not take: it says whether a future pause was the browser not
  /// accepting frames (this line) or the hub not delivering them (the stall line).
  /// </summary>
  internal static readonly TimeSpan SlowDrawThreshold = TimeSpan.FromSeconds(1);

  /// <summary>
  /// Stall recoveries (UI-36) that have finished running, whether or not they re-subscribed — one that
  /// finds the panel disposed or in BAND does nothing and still counts. For tests, which rendezvous on it.
  /// </summary>
  internal int StreamStallRecoveries => Volatile.Read(ref _streamStallRecoveries);

  private int _streamStallRecoveries;

  /// <summary>
  /// Stall recoveries started (UI-36) — counted on the tick itself, before the recovery is queued, so a
  /// test driving the tick from a fake clock can assert it exactly, with nothing still in flight.
  /// </summary>
  internal int StreamStallRecoveriesStarted => Volatile.Read(ref _streamStallRecoveriesStarted);

  private int _streamStallRecoveriesStarted;

  /// <summary>
  /// The most recently started stall recovery (UI-36), completed when no recovery has run. For tests:
  /// a finished recovery does not re-render the panel, so a render-driven wait (bUnit's
  /// <c>WaitForAssertion</c>) can miss it under load — tests await this instead.
  /// </summary>
  internal Task LastStreamRecovery { get; private set; } = Task.CompletedTask;

  /// <summary>Completes when no frame is waiting to be drawn. For tests, which need a rendezvous, not a sleep.</summary>
  internal Task DrawIdle => Volatile.Read(ref _drawLoop);

  // ── BAND state ──
  private BandMapResponseDto? _bandMap;

  // The axis of the band _bandMap describes: FM until a map has been read, and FM's axis, for drawing
  // only, when a non-FM map arrives without a usable axis. Set with _bandMap.
  private BandAxis _bandAxis = BandAxis.Fm;

  // The band a RadioStateChanged broadcast last triggered a map re-read for, so the telemetry ticks
  // that follow (up to two a second — AudioStateUpdateService's 500 ms interval) do not each re-read it
  // while that read is in flight. Cleared once a broadcast agrees with the band shown.
  private string? _bandReadTriggeredFor;

  // The VHF axis a broadcast whose frequency fell outside it last triggered a map re-read for (VHF's
  // map is a window around the radio's frequency). Compared by value, so it re-reads once per window
  // shown, not once per tick; a read that brings back the same window waits for the idle refresh.
  private BandAxis? _windowReadTriggeredFor;
  private RadioStateDto? _radioState;
  private List<RadioPresetDto>? _presets;

  // UI-31: the band list the radio control panel's band pills render (GET /api/RadioBands), for the
  // strip's range line ("87.5–108 MHz"). Read with the presets until a read returns any; null until then.
  private List<Radio.Core.Models.RadioBandModel>? _bandList;
  private ITimer? _bandTimer;
  private bool _bandActive;
  private bool _bandTapRegistered;
  private bool _scanRequestInFlight;
  private bool _tuneInFlight;
  private string? _bandMessage;
  private bool _bandMessageIsError;
  private DateTimeOffset _bandMessageExpiresAt;
  private DotNetObjectReference<VisualizerPanel>? _selfRef;

  // True when the last map read failed. The kept map may still say "sweeping", and polling once a
  // second against an API that is down would only add load and log lines; this drops to the idle
  // cadence until a read succeeds.
  private bool _bandMapReadFailed;

  // Refreshes can overlap — a timer refresh in flight when a tap or Discover starts its own. Each takes a
  // number, and only the newest applies its results, so an older read cannot land last and overwrite
  // a newer one (e.g. hide a sweep that a Discover has just started).
  private int _bandRefreshSeq;

  /// <summary>
  /// BAND refresh cycles that have run to completion — refreshed, rendered, and re-armed the timer.
  /// Tests rendezvous on this rather than on the request being sent, because the cycle's tail finishes
  /// after the requests are recorded, and a fake-clock advance before the re-arm would fire nothing.
  /// </summary>
  internal int CompletedBandRefreshes { get; private set; }

  /// <summary>
  /// <c>RadioStateChanged</c> broadcasts whose handling has finished, including any map re-read and
  /// redraw it started. The handler returns to the hub at once and does the work afterwards, so tests
  /// rendezvous on this count rather than on the event having been raised.
  /// </summary>
  internal int CompletedRadioStateUpdates => Volatile.Read(ref _completedRadioStateUpdates);

  private int _completedRadioStateUpdates;

  /// <summary>
  /// <c>SourceChanged</c> broadcasts whose handling — the radio-state read and any mode change — has
  /// finished (UI-29). Tests rendezvous on this count, as on <see cref="CompletedRadioStateUpdates"/>.
  /// </summary>
  internal int CompletedSourceChecks => Volatile.Read(ref _completedSourceChecks);

  private int _completedSourceChecks;

  /// <summary><c>ConnectionStateChanged</c> notifications this panel has finished handling (UI-30).</summary>
  internal int CompletedConnectionUpdates => Volatile.Read(ref _completedConnectionUpdates);

  private int _completedConnectionUpdates;

  /// <summary>UI-29: BAND can be picked only while the radio is the active source.</summary>
  private bool IsBandSelectable => _radioActive;

  // Spectrum-family modes share the freq-band axis strip beneath the canvas.
  // Picker buttons compare _currentMode directly — no per-button helper needed.
  private bool IsSpectrumMode =>
    _currentMode == VisualizationMode.Spectrum ||
    _currentMode == VisualizationMode.Circular;

  private bool IsBandMode => _currentMode == VisualizationMode.Band;

  private bool HasBandMap => _bandMap != null && _bandMap.Channels.Count > 0;

  /// <summary>
  /// The band code BAND is showing: the map's band, FM only before a map has been read (when the status
  /// line names no band). Not the axis's band — a map whose axis is unusable is drawn on FM's axis but
  /// is still that band's map.
  /// </summary>
  private string ShownBand => string.IsNullOrEmpty(_bandMap?.Band) ? "FM" : _bandMap!.Band;

  /// <summary>False when the API says the shown band cannot be scanned (AM, SW on this tuner).</summary>
  private bool IsShownBandMappable => _bandMap?.Mappable != false;

  /// <summary>A sweep is running and it is not known to be of another band (an older API names none).</summary>
  private bool IsSweepingShownBand =>
    _bandMap?.Sweep.IsSweeping == true && (_bandMap.Sweep.Band == null || SameBand(_bandMap.Sweep.Band, ShownBand));

  /// <summary>A sweep is running of a band other than the one shown.</summary>
  private bool IsSweepingOtherBand =>
    _bandMap?.Sweep.IsSweeping == true && _bandMap.Sweep.Band != null && !SameBand(_bandMap.Sweep.Band, ShownBand);

  private string BandCanvasLabel => IsShownBandMappable
    ? $"{ShownBand} signal map. Touch a signal to tune."
    : $"{ShownBand} signal map.";

  /// <summary>VHF's map is a window around the radio's frequency, not the whole band (AUD-91).</summary>
  private bool IsVhfWindow => SameBand(ShownBand, "VHF");

  /// <summary>
  /// The strip's range line (UI-31): VHF's plotted window; otherwise the band's range as the control panel's
  /// band pill names it, falling back to the plotted range when the band list has not been read. Null when
  /// neither is known (a map without a usable axis, before the band list arrives).
  /// </summary>
  private string? ShownRange
  {
    get
    {
      bool axisIsShownBand = SameBand(_bandAxis.Band, ShownBand);
      if (IsVhfWindow)
      {
        return axisIsShownBand ? BandMapText.FormatRange(_bandAxis.DisplayMinHz, _bandAxis.DisplayMaxHz, ShownBand) : null;
      }

      string? nominal = _bandList?.FirstOrDefault(b => SameBand(b.Type, ShownBand))?.Range;
      if (!string.IsNullOrWhiteSpace(nominal))
      {
        return nominal;
      }

      return axisIsShownBand ? BandMapText.FormatRange(_bandAxis.DisplayMinHz, _bandAxis.DisplayMaxHz, ShownBand) : null;
    }
  }

  private static bool SameBand(string? a, string? b) => string.Equals(a, b, StringComparison.OrdinalIgnoreCase);

  private static string AxisLeftPercent(double fraction) =>
    (fraction * 100).ToString("0.###", System.Globalization.CultureInfo.InvariantCulture);

  private static string? AxisLabelClass(BandAxisLabelAlign align) => align switch
  {
    BandAxisLabelAlign.Start => "is-edge-start",
    BandAxisLabelAlign.End => "is-edge-end",
    _ => null,
  };

  /// <summary>
  /// UI-29: the mode to show for a preference. A saved BAND shows Spectrum (the default) while the radio is
  /// not the active source, and BAND again once it is; every other mode shows as itself. The preference is
  /// not changed by this — only a pick in the picker changes it.
  /// </summary>
  internal static VisualizationMode DisplayModeFor(VisualizationMode preferred, bool radioActive) =>
    preferred == VisualizationMode.Band && !radioActive ? VisualizationMode.Spectrum : preferred;

  /// <summary>
  /// Maps a saved <c>ui.visualizer/defaultMode</c> value to a mode. AUD-76 removed two modes, and a
  /// preference naming either must still land somewhere sensible: <c>Spectrogram</c> ("Fall") becomes
  /// <see cref="VisualizationMode.Band"/>, which took its place in the picker; <c>VUMeter</c>, anything
  /// unparseable and null become <see cref="VisualizationMode.Spectrum"/>, the new default.
  /// </summary>
  internal static VisualizationMode ParseSavedMode(string? saved)
  {
    if (string.Equals(saved, "Spectrogram", StringComparison.OrdinalIgnoreCase))
    {
      return VisualizationMode.Band;
    }

    // Enum.TryParse also accepts numeric strings ("2"), which would select by ordinal and shift
    // whenever the enum changes; only names are honoured.
    if (saved != null
      && Enum.TryParse(saved, ignoreCase: true, out VisualizationMode mode)
      && Enum.IsDefined(mode)
      && !int.TryParse(saved, out _))
    {
      return mode;
    }

    return VisualizationMode.Spectrum;
  }

  protected override async Task OnInitializedAsync()
  {
    // UI-29: the start-up mode is applied under the mode gate, so a SourceChanged that arrives meanwhile
    // waits and is reconciled at the end rather than being overwritten by the start-up code.
    await _modeGate.WaitAsync();
    try
    {
      await InitializeUnderModeGateAsync();
    }
    finally
    {
      _modeGate.Release();
    }

    await ReconcileModeAsync();
  }

  private async Task InitializeUnderModeGateAsync()
  {
    try
    {
      VisualizationMode modeBeforePreferences = _currentMode;

      // UI-29: subscribed before the radio-state read, so a source change during start-up is not missed.
      AudioStateHub.SourceChanged += HandleSourceChangedAsync;

      // UI-36: the live frame handlers are attached FIRST, before the two HTTP reads below. They used
      // to be attached after them, and the first render does not wait for this method: OnAfterRenderAsync
      // initialises the canvas, subscribes, and draws ONE frame from RequestInitialData while these reads
      // are still in flight. Until they returned, no live frame reached the canvas, so a Home page built
      // straight after a wake — when radio-api is busy resuming the source and reloading its output
      // settings — showed a single frozen frame for as long as the slower read took. Frames that arrive
      // before the canvas is initialised are dropped by OfferFrame's guard. Until the saved mode is known
      // the panel shows the default mode, exactly as RequestInitialData's first frame always has, and the
      // move to the saved mode below moves the subscription as before.
      VisualizationHub.OnWaveformData += HandleWaveformData;
      VisualizationHub.OnSpectrumData += HandleSpectrumData;
      VisualizationHub.ConnectionStateChanged += HandleHubConnectionChangedAsync;

      await LoadPreferencesAsync();
      await RefreshRadioActiveAsync();
      _currentMode = DisplayModeFor(_preferredMode, _radioActive);

      if (!VisualizationHub.IsConnected)
      {
        await VisualizationHub.StartAsync();
      }

      _wasHubConnected = VisualizationHub.IsConnected;

      // AUD-91: BAND follows the radio's band. A band picked in the radio control panel arrives here
      // at once, rather than on BAND's next 30-second refresh. Ignored outside BAND.
      AudioStateHub.RadioStateChanged += HandleRadioStateChangedAsync;

      // The preference read is an HTTP call, and the first render does not wait for it: when it is
      // slow, OnAfterRenderAsync has already initialised the canvas and subscribed to the DEFAULT
      // mode's hub stream. Move that subscription to the saved mode here. (When the read wins the
      // race, OnAfterRenderAsync subscribes to the saved mode itself and there is nothing to move.)
      if (_isInitialized && _currentMode != modeBeforePreferences)
      {
        VisualizationMode savedMode = _currentMode;
        _currentMode = modeBeforePreferences;
        await UnsubscribeFromCurrentMode();
        _currentMode = savedMode;
        await SubscribeToCurrentMode();
        if (!IsBandMode)
        {
          await RequestInitialData();
        }
      }

      // ⚠ There is deliberately no remote mode subscription here. ENC-9a added one against the
      // server's VisualizationModeChanged broadcast; ENC-7 then removed the only thing that could
      // ever send it, and ENC-9 deleted the broadcast, the service behind it and this subscription
      // together. Mode is local to this circuit by decision: _preferredMode, _currentMode and the saved
      // preference below are the whole mechanism, and no remote party picks a mode. Since UI-29 the mode
      // SHOWN also follows the active source (SourceChanged, subscribed above): that can swap BAND for
      // Spectrum and back, but it never changes the preference.

      // Once a second: publish an "updates/sec" sample (the dev tray reads it via
      // VisualizerTelemetryService) and, since UI-36, check the live stream for a stall. On Clock so a
      // test can drive it; the cadence and the work are what they were, plus two integer reads.
      _telemetryTimer = Clock.CreateTimer(_ => OnTelemetryTick(), null, TelemetryInterval, TelemetryInterval);
    }
    catch (Exception ex)
    {
      Logger.LogError(ex, "Error initializing VisualizerPanel");
    }

    // BAND needs no canvas to load its data, so a saved BAND preference starts loading now. If the
    // canvas is already initialised this also draws and registers the tap handler; otherwise
    // OnAfterRenderAsync does both once visualizer.init has succeeded.
    if (IsBandMode)
    {
      await StartBandAsync();
    }
  }

  protected override async Task OnAfterRenderAsync(bool firstRender)
  {
    if (firstRender)
    {
      try
      {
        _jsModule = await JS.InvokeAsync<IJSObjectReference>("import", "./js/visualizer.js");

        var success = await _jsModule.InvokeAsync<bool>("visualizer.init", WebConstants.ElementIds.VisualizerCanvas, 0, 0);
        if (success)
        {
          _isInitialized = true;
          await SubscribeToCurrentMode();
          if (IsBandMode)
          {
            await RegisterBandTapAsync();
            await DrawBandAsync();
          }
          else
          {
            await RequestInitialData();
          }

          StateHasChanged();
        }
      }
      catch (Exception ex)
      {
        Logger.LogError(ex, "Error initializing visualizer canvas");
      }
    }
  }

  /// <summary>A tap on a picker tab: replaces the preference, saves it, and shows the mode.</summary>
  private async Task SelectMode(VisualizationMode mode)
  {
    // UI-29: the BAND tab is disabled while the radio is not active; this covers a tap that lands in the
    // moment between the radio going away and the re-render.
    if (mode == VisualizationMode.Band && !IsBandSelectable)
    {
      return;
    }

    bool preferenceChanged = _preferredMode != mode;
    _preferredMode = mode;
    await ReconcileModeAsync();

    if (preferenceChanged)
    {
      await SavePreferenceAsync("defaultMode", mode.ToString());
    }

    StateHasChanged();
  }

  /// <summary>
  /// UI-29: shows the mode the preference and the radio state call for — <see cref="DisplayModeFor"/> of
  /// <c>_preferredMode</c> and <c>_radioActive</c> as they are when the change runs, not when it was asked
  /// for. Serialised by <c>_modeGate</c>, and repeated until the screen matches, because either input can
  /// change while a change is awaiting. Saves nothing: <see cref="SelectMode"/> saves a pick, and the
  /// fallback deliberately does not.
  /// </summary>
  private async Task ReconcileModeAsync()
  {
    await _modeGate.WaitAsync();
    try
    {
      while (!_isDisposed)
      {
        VisualizationMode wanted = DisplayModeFor(_preferredMode, _radioActive);
        if (wanted == _currentMode)
        {
          break;
        }

        await ShowModeCoreAsync(wanted);
      }
    }
    finally
    {
      _modeGate.Release();
    }

    if (!_isDisposed)
    {
      StateHasChanged();
    }
  }

  /// <summary>
  /// Puts <paramref name="mode"/> on screen: stops BAND or moves the hub subscription, clears the canvas,
  /// and starts the new mode. Call only while holding <c>_modeGate</c> (<see cref="ReconcileModeAsync"/>).
  /// </summary>
  private async Task ShowModeCoreAsync(VisualizationMode mode)
  {
    if (_currentMode == mode)
    {
      return;
    }

    if (IsBandMode)
    {
      await StopBandAsync();
    }

    await UnsubscribeFromCurrentMode();
    _currentMode = mode;
    if (_isDisposed)
    {
      // Disposal already unsubscribed; subscribing now would leave the singleton hub streaming to nobody.
      return;
    }

    await SubscribeToCurrentMode();

    if (_isInitialized && _jsModule != null)
    {
      try
      {
        await _jsModule.InvokeVoidAsync("visualizer.clear", WebConstants.ElementIds.VisualizerCanvas);
        // Reset the phase-scope buffer when switching modes
        await _jsModule.InvokeVoidAsync("visualizer.resetBuffers", WebConstants.ElementIds.VisualizerCanvas);
      }
      catch (Exception ex) { Logger.LogError(ex, "Error clearing canvas"); }
    }

    if (IsBandMode)
    {
      await StartBandAsync();
      await RegisterBandTapAsync();
    }
    else
    {
      await RequestInitialData();
    }
  }

  // ── active source (UI-29) ──────────────────────────────────────────────

  /// <summary>
  /// Reads whether the radio is the active source. <c>/api/radio/state</c> answers 400 when it is not; a
  /// read that fails for any other reason says nothing about the source, so it keeps the last answer.
  /// </summary>
  private async Task RefreshRadioActiveAsync()
  {
    try
    {
      RadioStateRead read = await RadioApi.ReadStateAsync();
      if (read.Status == RadioStateReadStatus.Active)
      {
        _radioActive = true;
      }
      else if (read.Status == RadioStateReadStatus.NotActive)
      {
        _radioActive = false;
      }
    }
    catch (Exception ex)
    {
      Logger.LogDebug(ex, "Could not read whether the radio is active");
    }
  }

  /// <summary>
  /// A <c>SourceChanged</c> broadcast, or MainLayout's local nudge after its own switch. Returns to the hub
  /// at once, as <see cref="HandleRadioStateChangedAsync"/> does, and re-reads the radio state afterwards.
  /// </summary>
  private Task HandleSourceChangedAsync()
  {
    if (!_isDisposed)
    {
      _ = ApplySourceChangeInBackgroundAsync();
    }

    return Task.CompletedTask;
  }

  private async Task ApplySourceChangeInBackgroundAsync()
  {
    try
    {
      await InvokeAsync(async () =>
      {
        await RefreshRadioActiveAsync();

        // Falls back from BAND to Spectrum, or back to BAND, without touching the saved preference.
        await ReconcileModeAsync();
      });
    }
    catch (Exception ex)
    {
      Logger.LogWarning(ex, "Applying a source change to the visualizer failed");
    }
    finally
    {
      Interlocked.Increment(ref _completedSourceChecks);
    }
  }

  /// <summary>Queues <see cref="ReconcileModeAsync"/> on the dispatcher without waiting for it.</summary>
  private async Task ReconcileInBackgroundAsync()
  {
    try
    {
      await InvokeAsync(ReconcileModeAsync);
    }
    catch (Exception ex)
    {
      Logger.LogWarning(ex, "Applying the visualizer mode in the background failed");
    }
  }

  // ── hub connection (UI-30) ─────────────────────────────────────────────

  private Task HandleHubConnectionChangedAsync()
  {
    if (!_isDisposed)
    {
      _ = ApplyHubConnectionInBackgroundAsync();
    }

    return Task.CompletedTask;
  }

  private async Task ApplyHubConnectionInBackgroundAsync()
  {
    try
    {
      await InvokeAsync(async () =>
      {
        bool connected = VisualizationHub.IsConnected;
        bool dropped = _wasHubConnected && !connected;
        _wasHubConnected = connected;

        // After the reconnect, "Waiting for audio data" shows until the first new frame, rather than a
        // blank canvas with no message.
        if (dropped)
        {
          _hasReceivedData = false;
        }

        // The last frame drawn before the drop would otherwise stay on the canvas under the
        // disconnected state, looking live. BAND draws from the REST API and keeps its map.
        if (dropped && !IsBandMode && _isInitialized && _jsModule != null && !_isDisposed)
        {
          try { await _jsModule.InvokeVoidAsync("visualizer.clear", WebConstants.ElementIds.VisualizerCanvas); }
          catch (Exception ex) { Logger.LogDebug(ex, "Could not clear the canvas after a hub drop"); }
        }

        if (!_isDisposed)
        {
          StateHasChanged();
        }
      });
    }
    catch (Exception ex)
    {
      Logger.LogWarning(ex, "Applying a visualization hub state change failed");
    }
    finally
    {
      Interlocked.Increment(ref _completedConnectionUpdates);
    }
  }

  private async Task SubscribeToCurrentMode()
  {
    try
    {
      switch (_currentMode)
      {
        case VisualizationMode.Waveform:
        case VisualizationMode.PhaseScope:
          await VisualizationHub.SubscribeToWaveformAsync(); break;
        case VisualizationMode.Spectrum:
        case VisualizationMode.Circular:
          await VisualizationHub.SubscribeToSpectrumAsync(); break;
        case VisualizationMode.Band:
          // BAND reads the stored map over REST on its own timer; it has no visualization hub stream.
          break;
      }
    }
    catch (Exception ex) { Logger.LogError(ex, "Error subscribing to {Mode}", _currentMode); }
  }

  private async Task UnsubscribeFromCurrentMode()
  {
    try
    {
      switch (_currentMode)
      {
        case VisualizationMode.Waveform:
        case VisualizationMode.PhaseScope:
          await VisualizationHub.UnsubscribeFromWaveformAsync(); break;
        case VisualizationMode.Spectrum:
        case VisualizationMode.Circular:
          await VisualizationHub.UnsubscribeFromSpectrumAsync(); break;
        case VisualizationMode.Band:
          break;
      }
    }
    catch (Exception ex) { Logger.LogError(ex, "Error unsubscribing from {Mode}", _currentMode); }
  }

  private async Task RequestInitialData()
  {
    try
    {
      switch (_currentMode)
      {
        case VisualizationMode.Waveform:
        case VisualizationMode.PhaseScope:
          var waveform = await VisualizationHub.GetWaveformAsync();
          if (waveform != null) OfferFrame(waveform);
          break;
        case VisualizationMode.Spectrum:
        case VisualizationMode.Circular:
          var spectrum = await VisualizationHub.GetSpectrumAsync();
          if (spectrum != null) OfferFrame(spectrum);
          break;
      }
    }
    catch (Exception ex) { Logger.LogError(ex, "Error requesting initial visualization data"); }
  }

  // ── live frames (UI-36: latest wins, and the hub never waits on the browser) ──────────────

  /// <summary>
  /// A waveform frame from the hub. Returns at once: the frame is handed to the draw loop, which draws
  /// the newest frame it has whenever the browser is ready for one.
  /// </summary>
  /// <remarks>
  /// ⚠ <b>Why this no longer awaits the draw.</b> <c>AudioVisualizationHubService</c> is one connection
  /// shared by every circuit; its <c>InvokeEventHandlersAsync</c> awaits each subscriber in turn, and the
  /// SignalR client finishes one message's handler before it dispatches the next. A handler that awaited
  /// its browser round trip therefore held the whole stream for as long as that browser took to answer,
  /// and a browser that stopped answering for a while came back to a queue of stale frames drawn one
  /// round trip at a time. Now the hub hands over and moves on, frames that arrive while one is being
  /// drawn replace each other, and the canvas always receives the newest frame next.
  /// ⚠ <b>A guard, not a measured cure.</b> UI-36 found that while the panel is dark the kiosk's Chrome
  /// renders nothing but keeps running scripts, and it observed no slow round trip; see the row's dossier.
  /// </remarks>
  private Task HandleWaveformData(WaveformDataDto data)
  {
    if (_isDisposed) return Task.CompletedTask;
    // Counted for the stall check only when it is this panel's stream: the hub connection is shared by
    // every circuit, so another browser's Waveform frames must not hide a lost Spectrum subscription
    // here (pre-merge review M1).
    if (_currentMode is VisualizationMode.Waveform or VisualizationMode.PhaseScope)
    {
      Interlocked.Increment(ref _hubFramesSinceLastTick);
    }

    OfferFrame(data);
    return Task.CompletedTask;
  }

  /// <summary>A spectrum frame from the hub. See <see cref="HandleWaveformData"/>.</summary>
  private Task HandleSpectrumData(SpectrumDataDto data)
  {
    if (_isDisposed) return Task.CompletedTask;
    if (_currentMode is VisualizationMode.Spectrum or VisualizationMode.Circular)
    {
      Interlocked.Increment(ref _hubFramesSinceLastTick);
    }

    OfferFrame(data);
    return Task.CompletedTask;
  }

  /// <summary>Makes <paramref name="frame"/> the next frame to draw, and starts the draw loop if it is idle.</summary>
  private void OfferFrame(object frame)
  {
    if (_isDisposed || !_isInitialized || _jsModule == null)
    {
      return;
    }

    Interlocked.Exchange(ref _pendingFrame, frame);
    if (Interlocked.CompareExchange(ref _drawLoopRunning, 1, 0) == 0)
    {
      Volatile.Write(ref _drawLoop, DrainFramesAsync());
    }
  }

  /// <summary>
  /// Draws the newest pending frame until none is left. One loop at a time (<c>_drawLoopRunning</c>), so
  /// at most one draw per panel is ever in flight.
  /// </summary>
  private async Task DrainFramesAsync()
  {
    // Never inline in the caller, so the hub's receive loop is never the one that runs a draw. A loop
    // started from the hub thread continues on the thread pool; one started from the renderer (the
    // RequestInitialData frame) continues on the renderer's dispatcher, which is harmless.
    await Task.Yield();

    while (true)
    {
      object? frame = Interlocked.Exchange(ref _pendingFrame, null);
      if (frame == null)
      {
        Volatile.Write(ref _drawLoopRunning, 0);

        // A frame offered between the exchange above and the flag write found the loop "running" and
        // did not start one; pick it up here rather than leave it waiting for the next frame.
        if (Volatile.Read(ref _pendingFrame) == null || Interlocked.CompareExchange(ref _drawLoopRunning, 1, 0) != 0)
        {
          return;
        }

        continue;
      }

      await DrawFrameAsync(frame);
    }
  }

  /// <summary>Draws one frame for the mode on screen; a frame for another mode is dropped.</summary>
  private async Task DrawFrameAsync(object frame)
  {
    IJSObjectReference? module = _jsModule;
    if (_isDisposed || !_isInitialized || module == null) return;

    string method;
    object?[] args;
    switch (frame)
    {
      case SpectrumDataDto spectrum when _currentMode is VisualizationMode.Spectrum or VisualizationMode.Circular:
        method = _currentMode == VisualizationMode.Circular ? "visualizer.drawCircularSpectrum" : "visualizer.drawSpectrum";
        args = [WebConstants.ElementIds.VisualizerCanvas, spectrum.Magnitudes, spectrum.Frequencies];
        break;
      case WaveformDataDto waveform when _currentMode is VisualizationMode.Waveform or VisualizationMode.PhaseScope:
        method = _currentMode == VisualizationMode.PhaseScope ? "visualizer.drawPhaseScope" : "visualizer.drawWaveform";
        args = [WebConstants.ElementIds.VisualizerCanvas, waveform.LeftSamples, waveform.RightSamples];
        break;
      default:
        return;
    }

    Interlocked.Increment(ref _frameCountSinceLastSample);
    var wasFirst = !_hasReceivedData;
    _hasReceivedData = true;
    long started = Clock.GetTimestamp();
    try
    {
      try
      {
        await module.InvokeVoidAsync(method, args);
      }
      finally
      {
        // In a finally, so a draw that ends in the interop timeout — the slowest browser of all — is
        // logged too rather than swallowed by the cancellation catches below (pre-merge review M2).
        NoteDrawDuration(Clock.GetElapsedTime(started));
      }

      if (wasFirst) await InvokeAsync(StateHasChanged);
    }
    catch (TaskCanceledException) { }
    catch (OperationCanceledException) { }
    catch (JSDisconnectedException) { /* the circuit is going away; its dispose follows */ }
    catch (Exception ex) { Logger.LogError(ex, "Error drawing {Method}", method); }
  }

  /// <summary>
  /// UI-36's browser-side instrument: one warning when a single frame takes longer than
  /// <see cref="SlowDrawThreshold"/> to be accepted, re-armed by the next fast one.
  /// </summary>
  private void NoteDrawDuration(TimeSpan elapsed)
  {
    if (elapsed >= SlowDrawThreshold)
    {
      if (!_slowDrawLogged)
      {
        _slowDrawLogged = true;
        Logger.LogWarning(
          "Visualizer: the browser took {Milliseconds} ms to accept one frame; frames were coalesced meanwhile (UI-36)",
          (long)elapsed.TotalMilliseconds);
      }
    }
    else
    {
      _slowDrawLogged = false;
    }
  }

  /// <summary>
  /// The once-a-second tick: publishes the updates/sec sample and runs the stall check (UI-36).
  /// </summary>
  private void OnTelemetryTick()
  {
    var drawn = Interlocked.Exchange(ref _frameCountSinceLastSample, 0);
    try { Telemetry.SetUpdatesPerSecond(drawn); } catch (Exception ex) { Logger.LogDebug(ex, "Telemetry publish failed"); }

    int arrived = Interlocked.Exchange(ref _hubFramesSinceLastTick, 0);
    CheckForStall(arrived);
  }

  /// <summary>
  /// UI-36: a hub-fed panel that is initialised and connected but has received no frame for
  /// <see cref="StallTicks"/> ticks re-asserts its subscription and asks for a frame — once at the
  /// threshold, then with backoff while the stream stays down — and logs the stall's start and end.
  /// </summary>
  /// <remarks>
  /// <para>
  /// ⚠ <b>What this does and does not guard.</b> It recovers a stream whose group membership was lost
  /// while the connection stayed up — <c>UI-33</c>'s shared subscription set is one known way, since
  /// another panel's dispose can leave the group on the one shared connection — within about two
  /// seconds instead of never. It cannot make a browser present frames it is not presenting; for that
  /// case the slow-draw line in <see cref="NoteDrawDuration"/> is the evidence, and the two lines
  /// together say which side a future pause was on.
  /// </para>
  /// <para>
  /// Re-subscribing is safe to repeat: the API's <c>SubscribeTo*</c> is a SignalR group add, which is
  /// idempotent, and <c>AudioVisualizationHubService</c> records the group in a set.
  /// </para>
  /// </remarks>
  private void CheckForStall(int framesArrived)
  {
    bool watching = !_isDisposed && _isInitialized && !IsBandMode && VisualizationHub.IsConnected;
    if (!watching || framesArrived > 0)
    {
      if (_silentTicks >= StallTicks && framesArrived > 0)
      {
        Logger.LogInformation(
          "Visualizer: live frames resumed after {Seconds:0.0} s (UI-36)",
          (Clock.GetUtcNow() - _stallStartedAt).TotalSeconds);
      }

      _silentTicks = 0;
      _nextRecoveryAtSilentTicks = StallTicks;
      return;
    }

    if (_silentTicks == 0)
    {
      _stallStartedAt = Clock.GetUtcNow() - TelemetryInterval;
    }

    _silentTicks++;
    if (_silentTicks < _nextRecoveryAtSilentTicks)
    {
      return;
    }

    if (_silentTicks == StallTicks)
    {
      Logger.LogWarning(
        "Visualizer: no live frame for {Seconds} s while connected; re-subscribing to {Mode} (UI-36)",
        StallTicks * (int)TelemetryInterval.TotalSeconds, _currentMode);
    }

    // Backoff: 2, 5, 10, 30 silent ticks, then every 30 — a stream that stays down is re-asked, not hammered.
    _nextRecoveryAtSilentTicks = _silentTicks switch
    {
      < 5 => 5,
      < 10 => 10,
      _ => _silentTicks + 30,
    };

    Interlocked.Increment(ref _streamStallRecoveriesStarted);
    LastStreamRecovery = RecoverStreamAsync();
  }

  private async Task RecoverStreamAsync()
  {
    try
    {
      await InvokeAsync(async () =>
      {
        // Under the mode gate, so a mode change cannot interleave with the re-subscribe and leave the
        // panel subscribed to a mode it is not showing.
        await _modeGate.WaitAsync();
        try
        {
          if (_isDisposed || IsBandMode)
          {
            return;
          }

          await SubscribeToCurrentMode();
          await RequestInitialData();
        }
        finally
        {
          _modeGate.Release();
        }
      });
    }
    catch (Exception ex)
    {
      Logger.LogDebug(ex, "Visualizer stream recovery did not complete");
    }
    finally
    {
      Interlocked.Increment(ref _streamStallRecoveries);
    }
  }

  // ── BAND ────────────────────────────────────────────────────────────────

  /// <summary>
  /// Loads the map, the station and the presets, arms the refresh timer, and registers the canvas tap
  /// handler (a no-op until the canvas is initialised; OnAfterRenderAsync registers it then).
  /// </summary>
  private async Task StartBandAsync()
  {
    _bandActive = true;
    await RefreshBandAsync(includePresets: true);
    CompleteBandCycle();
    await RegisterBandTapAsync();
  }

  /// <summary>Stops the refresh timer and releases the canvas tap handler.</summary>
  private async Task StopBandAsync()
  {
    _bandActive = false;
    _bandTimer?.Dispose();
    _bandTimer = null;
    await UnregisterBandTapAsync();
  }

  /// <summary>Ends a refresh cycle: re-arms the timer, then counts the cycle.</summary>
  private void CompleteBandCycle()
  {
    ArmBandTimer();
    CompletedBandRefreshes++;
  }

  /// <summary>
  /// Re-arms the one-shot refresh timer: <see cref="BandSweepingRefresh"/> while the last successful
  /// map read showed a sweep, else <see cref="BandIdleRefresh"/> — and no later than the expiry of a
  /// message that is showing. The timer is one-shot and every arm disposes the previous one, so at
  /// most one timer exists and timer refreshes cannot stack up behind a slow API. (A tap or Discover
  /// refresh can still overlap a timer refresh; <see cref="_bandRefreshSeq"/> handles that.)
  /// </summary>
  private void ArmBandTimer()
  {
    _bandTimer?.Dispose();
    _bandTimer = null;
    if (_isDisposed || !_bandActive)
    {
      return;
    }

    TimeSpan due = !_bandMapReadFailed && _bandMap?.Sweep.IsSweeping == true ? BandSweepingRefresh : BandIdleRefresh;
    if (_bandMessage != null)
    {
      TimeSpan untilExpiry = _bandMessageExpiresAt - Clock.GetUtcNow();
      due = untilExpiry < due ? (untilExpiry > TimeSpan.Zero ? untilExpiry : TimeSpan.Zero) : due;
    }

    _bandTimer = Clock.CreateTimer(_ => _ = InvokeAsync(OnBandTimerAsync), null, due, Timeout.InfiniteTimeSpan);
  }

  private async Task OnBandTimerAsync()
  {
    if (_isDisposed || !_bandActive)
    {
      return;
    }

    // Presets change rarely; re-read them on the idle cadence only, not every second of a sweep.
    await RefreshBandAsync(includePresets: _bandMap?.Sweep.IsSweeping != true);
    CompleteBandCycle();
  }

  /// <summary>
  /// One BAND refresh: the map and the radio state (for the station marker), plus the presets when
  /// asked; then redraw and re-render. Each read degrades on its own — a failed preset read keeps the
  /// previous presets, a failed map read keeps the previous map (and drops the cadence to idle), and a
  /// failed state read keeps the previous station marker.
  /// </summary>
  private async Task RefreshBandAsync(bool includePresets)
  {
    int seq = ++_bandRefreshSeq;

    // Cleared before any await, so that neither a stale (discarded) refresh nor a failed one can leave
    // an expired message in place — ArmBandTimer would then re-arm at zero and refresh in a loop.
    if (_bandMessage != null && Clock.GetUtcNow() >= _bandMessageExpiresAt)
    {
      _bandMessage = null;
    }

    try
    {
      // No band: the API answers for the radio's band, which is the band BAND shows (AUD-91).
      Task<BandMapResponseDto?> mapTask = RadioApi.GetBandMapAsync();
      Task<RadioStateRead> stateTask = RadioApi.ReadStateAsync();
      Task<List<RadioPresetDto>?> presetsTask = includePresets
        ? RadioApi.GetPresetsForPollAsync()
        : Task.FromResult<List<RadioPresetDto>?>(null);
      // UI-31: the band list changes only with configuration; read until one read returns any bands.
      // GetBandsForPollAsync answers an empty list on failure (logged at Debug), so an empty answer is
      // retried next time.
      Task<IEnumerable<Radio.Core.Models.RadioBandModel>> bandsTask = includePresets && _bandList == null
        ? RadioApi.GetBandsForPollAsync()
        : Task.FromResult(Enumerable.Empty<Radio.Core.Models.RadioBandModel>());
      await Task.WhenAll(mapTask, stateTask, presetsTask, bandsTask);

      if (seq != _bandRefreshSeq)
      {
        // A newer refresh started while this one was in flight; its results win.
        return;
      }

      BandMapResponseDto? map = await mapTask;
      _bandMapReadFailed = map == null;
      _bandMap = map ?? _bandMap;
      _bandAxis = BandAxis.FromMap(_bandMap);
      RadioStateRead state = await stateTask;
      // The station marker needs the state; with the radio not active (400) there is none. When the
      // read failed outright, keep the last known station rather than blanking the marker.
      _radioState = state.Status switch
      {
        RadioStateReadStatus.Active => state.State,
        RadioStateReadStatus.NotActive => null,
        _ => _radioState,
      };

      // UI-29: BAND's own read also answers "is the radio active", which catches a SourceChanged this
      // circuit missed. The fallback cannot run inline: this refresh may itself be running inside a mode
      // change (StartBandAsync) that holds the mode gate, so it is queued instead.
      if (state.Status == RadioStateReadStatus.NotActive && _radioActive)
      {
        _radioActive = false;
        _ = ReconcileInBackgroundAsync();
      }

      _presets = await presetsTask ?? _presets;
      List<Radio.Core.Models.RadioBandModel> bands = (await bandsTask).ToList();
      if (bands.Count > 0)
      {
        _bandList = bands;
      }

      if (!_isDisposed && _bandActive)
      {
        await DrawBandAsync();
        StateHasChanged();
      }
    }
    catch (Exception ex)
    {
      Logger.LogWarning(ex, "Band map refresh failed");
    }
  }

  /// <summary>
  /// The frequencies of the shown band's seek-observed stations that are on the drawn axis (AUD-100),
  /// ascending; none on a band that cannot be received, or when the axis drawn is not the shown band's.
  /// </summary>
  private IReadOnlyList<long> ShownSeekStations()
  {
    BandAxis axis = _bandAxis;
    if (!IsShownBandMappable || _bandMap == null || !SameBand(axis.Band, ShownBand))
    {
      return Array.Empty<long>();
    }

    return (_bandMap.SeekStations ?? Array.Empty<BandMapSeekStationDto>())
      .Where(s => axis.Contains(s.FrequencyHz))
      .Select(s => s.FrequencyHz)
      .OrderBy(hz => hz)
      .ToArray();
  }

  /// <summary>
  /// Hands the canvas a drawing model in plot coordinates (0–1 across the shown band's axis; 87.5–108 MHz
  /// on FM), so the JS stays arithmetic-free: normalised channel heights, the gridline and tick positions,
  /// the axis span in channel spacings (for the bar width), each bar's colour tier (UI-22), the station
  /// marker (shown band, radio active), the shown band's presets as carets on the axis (UI-31), the
  /// seek-observed stations (AUD-100), and whether the band can be received at all (no axis is drawn
  /// when it cannot).
  /// </summary>
  private async Task DrawBandAsync()
  {
    if (_isDisposed || !_isInitialized || _jsModule == null || !IsBandMode)
    {
      return;
    }

    BandAxis axis = _bandAxis;
    IReadOnlyList<BandMapChannelDto> channels = IsShownBandMappable
      ? _bandMap?.Channels ?? Array.Empty<BandMapChannelDto>()
      : Array.Empty<BandMapChannelDto>();
    double[] heights = FmBandMath.NormalizeLevels(channels);
    // UI-22: t is the bar's colour tier, the BandSignalTier value visualizer.js indexes its colours by.
    BandSignalTier[] tiers = FmBandMath.SignalTiers(channels);
    object[] levels = channels
      .Select((c, i) => (object)new { f = axis.HzToFraction(c.FrequencyHz), v = heights[i], t = (int)tiers[i] })
      .ToArray();

    // The marker and the presets are the shown band's, and only when the axis drawn is that band's: a
    // map that came without a usable axis is drawn on FM's, and FM's stations are not on it.
    string band = ShownBand;
    bool axisIsShownBand = SameBand(axis.Band, band);
    double? station = axisIsShownBand && _radioState != null && SameBand(_radioState.Band, band) && axis.Contains(_radioState.Frequency)
      ? axis.HzToFraction(_radioState.Frequency)
      : null;

    IEnumerable<RadioPresetDto> shownPresets = axisIsShownBand && _presets != null ? _presets : Array.Empty<RadioPresetDto>();
    object[] presets = shownPresets
      .Where(p => SameBand(p.Band, band) && axis.Contains(p.Frequency))
      .OrderBy(p => p.Frequency)
      .Select(p => (object)new { f = axis.HzToFraction(p.Frequency) })
      .ToArray();

    double[] grid = axis.Ticks().Select(t => axis.HzToFraction(t.Hz)).ToArray();

    // AUD-100: where a live Scan stopped since the last sweep, drawn as markers apart from the bars.
    object[] seek = ShownSeekStations().Select(hz => (object)new { f = axis.HzToFraction(hz) }).ToArray();

    try
    {
      await _jsModule.InvokeVoidAsync("visualizer.drawBandMap", WebConstants.ElementIds.VisualizerCanvas,
        new
        {
          levels, station, presets, seek, grid, channelsAcross = axis.ChannelsAcross,
          sweeping = _bandMap?.Sweep.IsSweeping == true, mappable = IsShownBandMappable,
        });
    }
    catch (TaskCanceledException) { }
    catch (OperationCanceledException) { }
    catch (Exception ex) { Logger.LogWarning(ex, "Error drawing the band map"); }
  }

  /// <summary>
  /// A <c>RadioStateChanged</c> broadcast (AUD-91). Returns to the hub at once: the hub calls its
  /// subscribers one after another, so awaiting a map read or a canvas redraw here would hold up every
  /// subscriber after this one. The work runs on the component's dispatcher afterwards, and a failure
  /// there is logged, not thrown back at the hub. See <see cref="ApplyRadioStateAsync"/>.
  /// </summary>
  private Task HandleRadioStateChangedAsync(RadioStateDto dto)
  {
    if (!_isDisposed)
    {
      _ = ApplyRadioStateInBackgroundAsync(dto);
    }

    return Task.CompletedTask;
  }

  private async Task ApplyRadioStateInBackgroundAsync(RadioStateDto dto)
  {
    try
    {
      await InvokeAsync(() => ApplyRadioStateAsync(dto));
    }
    catch (Exception ex)
    {
      // Includes the renderer having gone away between the broadcast and the dispatch.
      Logger.LogWarning(ex, "Applying a radio state broadcast to the band map failed");
    }
    finally
    {
      Interlocked.Increment(ref _completedRadioStateUpdates);
    }
  }

  /// <summary>
  /// Applies one broadcast. UI-29 first: the server sends <c>RadioStateChanged</c> only while the radio is
  /// the active source (<c>AudioStateUpdateService.CheckRadioStateAsync</c> returns for any other source),
  /// so a broadcast while <c>_radioActive</c> is false means a start-up read failed or a SourceChanged was
  /// missed — it enables BAND and, for a saved BAND, shows it. Otherwise, outside BAND the broadcast is
  /// ignored. A band other than the one shown re-reads the map
  /// at once — once per band change, not once per broadcast, since telemetry ticks repeat the state up
  /// to twice a second. On VHF, a frequency outside the window shown re-reads the map once per window.
  /// That re-read moves the window only while no VHF map is stored: once one is, the API returns the
  /// stored map's range, and only a new sweep moves it. AUD-100: the tick on which <c>IsScanning</c> goes
  /// from true to false re-reads the map, so a live seek's stops appear at once (a refresh in flight
  /// during the scan can bring back a scanning state and cause one more such read, never one per tick).
  /// Otherwise only a changed frequency does anything: it moves the station marker, a redraw and no API
  /// call; a repeated tick does nothing at all.
  /// </summary>
  private async Task ApplyRadioStateAsync(RadioStateDto dto)
  {
    if (_isDisposed)
    {
      return;
    }

    if (!_radioActive)
    {
      _radioActive = true;
      await ReconcileModeAsync();
      return;
    }

    if (!_bandActive)
    {
      return;
    }

    if (!SameBand(dto.Band, ShownBand))
    {
      // A read that fails leaves the old band shown; the next idle refresh retries it, not the next tick.
      if (!SameBand(dto.Band, _bandReadTriggeredFor))
      {
        _bandReadTriggeredFor = dto.Band;
        // Fetch presets too while none have arrived: this read can supersede the opening read that
        // carried them, which would otherwise leave the preset ticks empty until the idle refresh.
        await RefreshBandAsync(includePresets: _presets == null);
        CompleteBandCycle();
      }

      return;
    }

    _bandReadTriggeredFor = null;
    bool markerMoved = _radioState == null
      || _radioState.Frequency != dto.Frequency
      || !SameBand(_radioState.Band, dto.Band);
    // AUD-100: a scan that has just ended may have added seek-observed stations; read them now rather
    // than at the next idle refresh, up to 30 s later. Only the tick that ends a scan does this.
    bool scanEnded = _radioState?.IsScanning == true && !dto.IsScanning;
    _radioState = dto;

    if (scanEnded)
    {
      await RefreshBandAsync(includePresets: false);
      CompleteBandCycle();
      return;
    }

    if (SameBand(dto.Band, "VHF") && SameBand(_bandAxis.Band, "VHF") && !_bandAxis.Contains(dto.Frequency)
      && _bandAxis != _windowReadTriggeredFor)
    {
      _windowReadTriggeredFor = _bandAxis;
      await RefreshBandAsync(includePresets: false);
      CompleteBandCycle();
      return;
    }

    if (markerMoved)
    {
      await DrawBandAsync();
    }
  }

  private async Task RegisterBandTapAsync()
  {
    // IsBandMode is re-checked because callers await before getting here: the user can pick another
    // mode while BAND is still loading, and the handler must not be left registered outside BAND.
    if (_bandTapRegistered || !_isInitialized || _jsModule == null || _isDisposed || !IsBandMode)
    {
      return;
    }

    try
    {
      _selfRef ??= DotNetObjectReference.Create(this);
      await _jsModule.InvokeVoidAsync("visualizer.registerBandTap", WebConstants.ElementIds.VisualizerCanvas, _selfRef);
      _bandTapRegistered = true;
    }
    catch (Exception ex) { Logger.LogWarning(ex, "Could not register the band tap handler"); }
  }

  private async Task UnregisterBandTapAsync()
  {
    if (!_bandTapRegistered || _jsModule == null)
    {
      return;
    }

    _bandTapRegistered = false;
    try
    {
      await _jsModule.InvokeVoidAsync("visualizer.unregisterBandTap", WebConstants.ElementIds.VisualizerCanvas);
    }
    catch (Exception ex) { Logger.LogDebug(ex, "Could not unregister the band tap handler"); }
  }

  /// <summary>
  /// A tap on the band plot, as a fraction of its width (0 = the shown band's left edge, 87.5 MHz on
  /// FM; 1 = its right edge). Resolved by <see cref="BandAxis.ResolveTapTarget"/> on the shown band's
  /// axis and tuned in that band by <see cref="TuneToAsync"/>. A tap during a sweep is allowed: the API
  /// cancels the sweep and the user's tune wins (AUD-76 PR 1). A tap on a band that cannot be scanned
  /// tunes nothing — there is no map to tap — and neither does a tap on a map drawn on FM's axis for
  /// want of its own, since the position would name an FM frequency in another band.
  /// </summary>
  [JSInvokable]
  public Task OnBandTap(double fraction)
  {
    if (_isDisposed || !IsBandMode || !IsShownBandMappable || !SameBand(_bandAxis.Band, ShownBand))
    {
      return Task.CompletedTask;
    }

    // The axis is captured now, so the tune names the band the tap was made on even if a band change
    // lands before it runs.
    BandAxis axis = _bandAxis;
    long target = axis.ResolveTapTarget(axis.FractionToHz(fraction), _bandMap?.Channels);
    return InvokeAsync(() => TuneToAsync(target, axis.Band));
  }

  /// <summary>
  /// Tunes the radio to <paramref name="frequencyHz"/>, switching to the radio source first when the
  /// API says it is not the active one (400 from <c>/api/radio/state</c>), and stopping a running seek
  /// scan first. A state read that fails for any other reason tunes nothing and switches nothing. A
  /// second tap while one tune is in flight is ignored.
  /// </summary>
  /// <remarks>
  /// No band is selected first. On FM the request carries no band, exactly as AUD-76 sent it:
  /// <c>RadioReceiver.SetFrequency</c> picks the band that contains the frequency (FM for 87.9–107.9,
  /// which precedes VHF in <c>BandPresets.AllBands</c>), and a separate <c>SetBand("FM")</c> would
  /// restart the stream twice and briefly tune the FM band's lower edge. Every other band sends its
  /// code with the frequency (AUD-91), so the API tunes inside that band in one retune: VHF overlaps
  /// FM, AIR and WB, and the frequency alone would land a VHF tap in one of those.
  /// </remarks>
  internal async Task TuneToAsync(long frequencyHz, string band = "FM")
  {
    if (_tuneInFlight)
    {
      return;
    }

    _tuneInFlight = true;
    // "99.5 FM" as AUD-76; elsewhere exact and with the unit, "162.4125 MHz VHF".
    string station = BandMapText.FormatStation(frequencyHz, band);
    try
    {
      RadioStateRead read = await RadioApi.ReadStateAsync();
      if (read.Status == RadioStateReadStatus.Unavailable)
      {
        // Not "not active" — unknown. Switching source on a transient failure would re-select a
        // radio that is already playing, so do nothing and say why.
        ShowBandMessage("The radio API is not reachable", isError: true);
        return;
      }

      if (read.Status == RadioStateReadStatus.NotActive)
      {
        if (!await SourcesApi.SwitchSourceAsync(RadioSourceType))
        {
          ShowBandMessage("Could not switch to the radio", isError: true);
          return;
        }

        // Let the source pills follow at once rather than on the API's next state poll — the same
        // nudge MainLayout sends after its own switch.
        await AudioStateHub.NotifySourceChangedAsync();
      }
      else if (read.State?.IsScanning == true)
      {
        // A seek scan still running would move off the tapped station a moment later — the hazard
        // PresetSelectorService guards against the same way.
        await RadioApi.StopScanAsync();
      }

      if (await RadioApi.SetFrequencyAsync(frequencyHz, BandAxis.IsFm(band) ? null : band))
      {
        ShowBandMessage($"Tuning {station}", isError: false);
      }
      else
      {
        ShowBandMessage($"Could not tune to {station}", isError: true);
      }

      await RefreshBandAsync(includePresets: false);
      CompleteBandCycle();
    }
    finally
    {
      _tuneInFlight = false;
    }
  }

  /// <summary>
  /// The Discover button (UI-31; was Scan): <c>POST /api/radio/bandmap/scan?band=</c> with the band shown (AUD-91), so a band
  /// change between the render and the tap cannot scan a band the owner was not looking at; before any
  /// map has been read, no band, and the API takes the radio's. On 202 the map is re-read at once, which
  /// shows "Discovering…" in the strip and switches the timer to the one-second cadence; on 409/503 the API's
  /// reason is shown.
  /// </summary>
  private async Task RequestDiscoverAsync()
  {
    if (_scanRequestInFlight)
    {
      return;
    }

    _scanRequestInFlight = true;
    try
    {
      BandScanRequestResult result = await RadioApi.RequestBandScanAsync(_bandMap == null ? null : ShownBand);
      if (!result.Accepted)
      {
        ShowBandMessage(result.Error ?? (result.StatusCode == 0 ? "The radio API is not reachable" : "Discover unavailable"),
          isError: true);
      }

      await RefreshBandAsync(includePresets: false);
      CompleteBandCycle();
    }
    finally
    {
      _scanRequestInFlight = false;
    }
  }

  private void ShowBandMessage(string message, bool isError)
  {
    _bandMessage = message;
    _bandMessageIsError = isError;
    _bandMessageExpiresAt = Clock.GetUtcNow() + BandMessageLifetime;
    // Re-arm so the message is cleared on time even on a path that returns without a refresh.
    ArmBandTimer();
    StateHasChanged();
  }

  // ── preferences / dispose ───────────────────────────────────────────────

  private async Task LoadPreferencesAsync()
  {
    try
    {
      var prefs = await ConfigApi.GetConfigurationAsync<Dictionary<string, object>>("ui.visualizer");
      if (prefs != null && prefs.TryGetValue("defaultMode", out var modeObj) && modeObj != null)
      {
        _preferredMode = ParseSavedMode(modeObj.ToString());
      }
    }
    catch (Exception ex) { Logger.LogWarning(ex, "Failed to load visualizer preferences"); }
  }

  private async Task SavePreferenceAsync(string key, object value)
  {
    try { await ConfigApi.UpdateConfigurationAsync("ui.visualizer", key, value); }
    catch (Exception ex) { Logger.LogWarning(ex, "Failed to save visualizer preference {Key}", key); }
  }

  public async ValueTask DisposeAsync()
  {
    _isDisposed = true;

    _telemetryTimer?.Dispose();
    // Publish a final zero so subscribers don't see a stale value after dispose.
    try { Telemetry.SetUpdatesPerSecond(0); } catch { /* ignore */ }

    _bandActive = false;
    _bandTimer?.Dispose();
    _bandTimer = null;

    VisualizationHub.OnWaveformData -= HandleWaveformData;
    VisualizationHub.OnSpectrumData -= HandleSpectrumData;
    VisualizationHub.ConnectionStateChanged -= HandleHubConnectionChangedAsync;
    AudioStateHub.RadioStateChanged -= HandleRadioStateChangedAsync;
    AudioStateHub.SourceChanged -= HandleSourceChangedAsync;

    await UnsubscribeFromCurrentMode();

    if (_jsModule != null)
    {
      await UnregisterBandTapAsync();
      try { await _jsModule.InvokeVoidAsync("visualizer.dispose", WebConstants.ElementIds.VisualizerCanvas); }
      catch { /* ignore */ }
      try { await _jsModule.DisposeAsync(); }
      catch { /* ignore */ }
    }

    _selfRef?.Dispose();
  }
}
