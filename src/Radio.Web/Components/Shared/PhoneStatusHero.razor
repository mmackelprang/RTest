@using Radio.Web.Models
@implements IDisposable

<div class="phone-hero"
     style="--phone-hero-state-color: @(StateColors.color);
            --phone-hero-state-glow: @(StateColors.glow);
            --phone-hero-glow-color: @(StateColors.glowBg);">
  <div class="phone-hero-glow"></div>
  <div class="phone-hero-body">

    @* Top row: state label + source tag *@
    <div class="phone-hero-top">
      <span class="phone-hero-state-label">@StateLabel</span>
      <span class="phone-hero-source-tag">
        <span class="dot" style="background: @(StateColors.color);
              box-shadow: 0 0 6px @(StateColors.glow);"></span>
        via @CallSource
      </span>
    </div>

    @* Big LED state word *@
    <div class="phone-hero-state @(CallState.CallState == "Ringing" ? "ring-pulse" : "")"
         style="color: @(StateColors.color);
                text-shadow: 0 0 20px @(StateColors.glow);">
      @CallState.CallState.ToUpperInvariant()
    </div>

    @* Caller info or empty state *@
    @if (ActiveNumber != null)
    {
      <div class="phone-hero-meta">
        <div class="phone-hero-meta-row">
          <span class="phone-hero-icon"
                style="background: color-mix(in oklab, @(StateColors.color) 18%, transparent);
                       color: @(StateColors.color);">
            <RadzenIcon Icon="@HeroIcon" />
          </span>
          <div style="display: flex; flex-direction: column; gap: 2px;">
            <span class="phone-hero-number">@ActiveNumber</span>
            @if (CallerName != null)
            {
              <span class="phone-hero-name">@CallerName</span>
            }
          </div>
          @if (CallState.CallState == "InCall")
          {
            <span class="phone-hero-duration">@FormattedDuration</span>
          }
        </div>
      </div>
    }
    else if (ShowsUnreachableStrip)
    {
      @* State C (handoff §3.3) — Idle, ATA known-unreachable. Replaces the
         .phone-hero-empty copy, which becomes an active lie in this state: telling
         someone to "wait for an incoming ring" when the bell cannot ring is exactly
         the confidently-wrong screen this work exists to remove.
         role="status" (polite): an ambient condition with no deadline. The live
         during-ring strip is the assertive one, and it ships with the backend
         BellInviteFailed event (§8.1). *@
      <div class="phone-hero-alert" role="status" @key="AlertKey">
        <RadzenIcon Icon="notifications_off" aria-hidden="true" />
        <div class="phone-hero-alert-body">
          <span class="phone-hero-alert-text">
            The phone can't ring right now. Calls will still appear on this screen.
          </span>
          @* Deliberate vocabulary split (§3.3): the hero says "rotary phone" — the
             thing in the hallway a household member recognises. The model number
             lives one card over in System Status, where technical rows belong.
             The "last checked HH:mm" half of this sub-line needs
             Ht801LastCheckedUtc (§6.3), which RotaryPhone has not shipped yet;
             it is omitted rather than faked from our own fetch time, which would
             report when WE asked rather than when the ATA was probed. *@
          <span class="phone-hero-alert-sub">Rotary phone unreachable</span>
        </div>
        @* In-flight state is the ONLY feedback this control has in its most common
           outcome. When the ATA is still unreachable — the expected result of most
           presses — the re-render is byte-identical, and the "last checked" timestamp
           that would otherwise tick is deferred pending Ht801LastCheckedUtc (§6.3). With
           nothing changing, the button reads as dead and a user concludes the UI is
           broken on top of the bell. Disabling + relabelling while the fetch is open
           follows the in-tree idiom (PhoneDashboardPanel's `disabled="@SwitchingMode"`);
           the page pairs it with a toast so the completed check is acknowledged even
           when the answer is unchanged. *@
        <button type="button" class="phone-btn-sm" @onclick="HandleCheckBellAsync"
                disabled="@_checking"
                aria-label="Check whether the phone can ring">
          @(_checking ? "Checking…" : "Check again")
        </button>
      </div>
    }
    else
    {
      <div class="phone-hero-empty">
        <RadzenIcon Icon="phone" />
        Lift the handset to place a call, or wait for an incoming ring.
      </div>
    }

    @* Action buttons -- contextual to state *@
    <div class="phone-hero-actions">
      @switch (CallState.CallState)
      {
        case "Ringing":
          <button type="button" class="phone-btn btn-answer" @onclick="OnAnswer">
            <RadzenIcon Icon="phone" /> Answer
          </button>
          <button type="button" class="phone-btn btn-hangup" disabled
                  title="Physical handset only">
            <RadzenIcon Icon="call_end" /> Reject
          </button>
          <button type="button" class="phone-btn btn-ghost" disabled
                  title="Not yet implemented">
            <RadzenIcon Icon="ring_volume" /> Silence
          </button>
          break;

        case "InCall":
          <button type="button" class="phone-btn btn-hangup" @onclick="OnHangup">
            <RadzenIcon Icon="call_end" /> Hang Up
          </button>
          <button type="button" class="phone-btn btn-ghost" disabled
                  title="Not yet implemented">
            <RadzenIcon Icon="mic" /> Mute
          </button>
          <button type="button" class="phone-btn btn-ghost" disabled
                  title="Not yet implemented">
            <RadzenIcon Icon="dialpad" /> Keypad
          </button>
          <button type="button" class="phone-btn btn-ghost" disabled
                  title="Not yet implemented">
            <RadzenIcon Icon="swap_horiz" /> Move to Soundbar
          </button>
          break;

        case "Dialing":
          <button type="button" class="phone-btn btn-hangup" @onclick="OnHangup">
            <RadzenIcon Icon="call_end" /> Cancel
          </button>
          <button type="button" class="phone-btn btn-ghost" disabled
                  title="Not yet implemented">
            <RadzenIcon Icon="speaker" /> Speaker
          </button>
          break;

        default: // Idle
          <button type="button" class="phone-btn btn-ghost" disabled
                  title="Not yet implemented">
            <RadzenIcon Icon="dialpad" /> New Call
          </button>
          <button type="button" class="phone-btn btn-ghost" disabled
                  title="Not yet implemented">
            <RadzenIcon Icon="contacts" /> Pick Contact
          </button>
          break;
      }
    </div>

  </div>
</div>

@code {
  [Parameter] public PhoneCallStateDto CallState { get; set; } = new();
  [Parameter] public string CallSource { get; set; } = "Rotary Phone";
  [Parameter] public EventCallback OnAnswer { get; set; }
  [Parameter] public EventCallback OnHangup { get; set; }
  [Parameter] public List<MergedContact>? Contacts { get; set; }

  /// <summary>
  /// Client-derived health of the physical bell (bell-failure handoff §2, Axis B).
  /// Defaults to <see cref="BellHealth.Unknown"/> so a caller that has not wired it up
  /// — and a cold load before the first probe returns — shows nothing rather than a
  /// false alarm (§7m).
  /// </summary>
  [Parameter] public BellHealth BellHealth { get; set; } = BellHealth.Unknown;

  /// <summary>
  /// Re-checks whether the bell can ring, behind the State C "Check again" button.
  /// Today this re-fetches the phone system status; it becomes a real probe when
  /// RotaryPhone lands <c>POST /api/phone/bell/probe</c> (§6.7).
  /// </summary>
  [Parameter] public EventCallback OnCheckBell { get; set; }

  // The hero's own switch treats anything that isn't Ringing/InCall/Dialing as Idle;
  // mirror that here so the two never disagree about which state is on screen.
  private bool IsIdle => CallState.CallState is not ("Ringing" or "InCall" or "Dialing");

  // State C is scoped to Suspect — an ATA that is known-unreachable right now — per
  // §3.3. Failed at Idle is State D (the sticky "a call at 2:14 PM didn't ring" note),
  // which is a different strip with different copy and ships with §6.4's lastBellFailure.
  private bool ShowsUnreachableStrip => IsIdle && BellHealth == BellHealth.Suspect;

  // §8.1 requires the strip be keyed stably. It is the middle arm of an if/else-if/else
  // chain of sibling <div>s, so without an explicit key Blazor is free to reuse the DOM
  // node across branches — which for a live region means an unrelated branch swap can
  // read as a content change and re-announce. A constant key pins its identity, so the
  // node is created once when the fault appears and destroyed once when it clears.
  private const string AlertKey = "phone-hero-bell-alert";

  // Guards the Check-again round trip. Local to the hero so the button owns its own
  // in-flight affordance and no caller has to thread a flag down.
  private bool _checking;

  private async Task HandleCheckBellAsync()
  {
    if (_checking)
    {
      return;   // re-entrancy guard: a double-tap must not fire two fetches
    }
    _checking = true;
    try
    {
      await OnCheckBell.InvokeAsync();
    }
    finally
    {
      _checking = false;
    }
  }

  // State color computation
  private (string color, string glow, string glowBg) StateColors => CallState.CallState switch
  {
    "Ringing" => ("var(--signal-amber)", "rgba(240,168,48,0.50)", "rgba(240,168,48,0.15)"),
    "InCall"  => ("var(--signal-green)", "rgba(74,222,128,0.45)", "rgba(74,222,128,0.12)"),
    "Dialing" => ("var(--signal-blue)",  "rgba(96,165,250,0.45)", "rgba(96,165,250,0.12)"),
    _         => ("var(--text-medium)",  "transparent",            "transparent"),
  };

  // State label mapping
  private string StateLabel => CallState.CallState switch
  {
    "Ringing" => "Incoming Call",
    "InCall"  => "Active Call",
    "Dialing" => "Dialing Out",
    _         => "Awaiting Call",
  };

  // Active phone number
  private string? ActiveNumber => CallState.CallState switch
  {
    "Ringing" => CallState.IncomingNumber,
    "InCall"  => CallState.IncomingNumber ?? CallState.DialedNumber,
    "Dialing" => CallState.DialedNumber,
    _         => null,
  };

  // Caller name lookup (client-side contact match)
  private string? CallerName
  {
    get
    {
      var number = ActiveNumber;
      if (string.IsNullOrEmpty(number) || Contacts == null) return null;
      // Normalize: strip non-digit chars, take last 10 digits for suffix match
      var digits = new string(number.Where(char.IsDigit).ToArray());
      var suffix = digits.Length > 10 ? digits[^10..] : digits;
      if (suffix.Length < 7) return null; // too short for reliable match
      return Contacts.FirstOrDefault(c =>
      {
        var cDigits = new string(c.Phone.Where(char.IsDigit).ToArray());
        var cSuffix = cDigits.Length > 10 ? cDigits[^10..] : cDigits;
        return cSuffix == suffix;
      })?.Name;
    }
  }

  // Hero icon per state
  private string HeroIcon => CallState.CallState switch
  {
    "Ringing" => "call_received",
    "Dialing" => "call_made",
    "InCall"  => "phone_in_talk",
    _         => "phone",
  };

  // InCall duration timer (client-side)
  private DateTime? _inCallStartUtc;
  private System.Threading.Timer? _durationTimer;
  private TimeSpan _inCallDuration;

  protected override void OnParametersSet()
  {
    if (CallState.CallState == "InCall" && _inCallStartUtc == null)
    {
      var capturedStart = DateTime.UtcNow;
      _inCallStartUtc = capturedStart;
      _durationTimer = new System.Threading.Timer(_ =>
      {
        // capturedStart is immutable — no race with OnParametersSet nulling _inCallStartUtc
        _inCallDuration = DateTime.UtcNow - capturedStart;
        InvokeAsync(StateHasChanged);
      }, null, TimeSpan.Zero, TimeSpan.FromSeconds(1));
    }
    else if (CallState.CallState != "InCall")
    {
      // Dispose after nulling shared refs so an in-flight callback sees null guard
      var timerToDispose = _durationTimer;
      _durationTimer = null;
      _inCallStartUtc = null;
      _inCallDuration = TimeSpan.Zero;
      timerToDispose?.Dispose();
    }
  }

  private string FormattedDuration =>
    _inCallDuration.TotalHours >= 1
      ? _inCallDuration.ToString(@"hh\:mm\:ss")
      : _inCallDuration.ToString(@"mm\:ss");

  public void Dispose()
  {
    _durationTimer?.Dispose();
  }
}
