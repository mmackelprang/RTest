@rendermode InteractiveServer
@using Microsoft.Extensions.Options
@using Radio.Web.Formatting
@using Radio.Web.Models
@using Radio.Web.Services.ApiClients
@inject QueueApiService QueueApi
@inject PlayHistoryApiService HistoryApi
@inject AudioStateHubService HubService
@inject AudioApiService AudioApi
@inject FileApiService FileApi
@inject DialogService DialogService
@inject ILogger<QueueHistoryPanel> Logger
@inject NotificationService NotificationService
@inject Radio.Web.Services.QueuePersistenceService QueuePersistence
@inject PlaylistApiService PlaylistApi
@inject SourcesApiService SourcesApi
@inject BluetoothApiService BluetoothApi
@inject ConfigurationApiService ConfigApi
@inject Radio.Web.Services.CentrePanelViewService CentrePanelViews
@inject IOptionsMonitor<DisplayOptions> DisplayOptionsMonitor
@implements IAsyncDisposable

@*
  The Home centre panel. UI-17 made it the one place the centre's content is chosen: a single tab
  strip across the top, whose tabs depend on the active primary source.

    File Player           Queue · History        opens on Queue if it has tracks, else History
    Vinyl / USB / Tone    (History only)         no tabs — the strip holds only the Stats chip
    Radio family          Radio · History        opens on Radio
    Bluetooth, none       Connect · History      opens on Connect
    Bluetooth, connected  History · Devices      opens on History

  Connect and Devices are one tab (TabBluetooth) with two labels, because they are one panel.

  Layout map:
    .centre-panel
      .queue-split-tabstrip   ← tabs, then the Stats chip (History view)
      .centre-panel-body
        Radio      → RadioControlPanel
        Bluetooth  → BluetoothConnectPanel
        otherwise  → .queue-split
                       .queue-split-list-col     queue rows OR history rows
                       .queue-split-context-col  Queue view: Queue Total + the queue actions (UI-32 — they
                                                 replaced the tab strip's ⋮ menu)
                                                 History view: stats tile, only with the chip on
*@

<div class="centre-panel">
  @{
    IReadOnlyList<int> visibleTabs = VisibleTabs;
  }
  <div class="queue-split-tabstrip">
    @* The tablist holds only the tabs; the Stats chip and kebab are ordinary buttons beside it. A
       source with no tabs (Vinyl / USB / Test Tone) renders no tablist at all. *@
    @if (visibleTabs.Count > 0)
    {
      <div class="centre-tablist" role="tablist" aria-label="Centre panel views">
        @foreach (int tab in visibleTabs)
        {
          int tabValue = tab;
          <button type="button"
                  id="@TabElementId(tabValue)"
                  class="queue-split-tab @(_activeTab == tabValue ? "is-active" : "")"
                  role="tab"
                  aria-selected="@(_activeTab == tabValue ? "true" : "false")"
                  aria-controls="centre-tabpanel"
                  @onclick="@(() => SetTab(tabValue))">
            @TabLabel(tabValue)
          </button>
        }
      </div>
    }
    <div class="queue-split-tab-spacer"></div>
    @if (_activeTab == TabHistory)
    {
      @* UI-17 point 1. Off by default; persisted console-wide in the config store. *@
      <button type="button"
              class="centre-stats-chip @(_showStats ? "is-on" : "")"
              aria-pressed="@(_showStats ? "true" : "false")"
              @onclick="ToggleStatsAsync">
        Stats
      </button>
    }
  </div>

  <div class="centre-panel-body"
       id="centre-tabpanel"
       role="@(visibleTabs.Count > 0 ? "tabpanel" : null)"
       aria-labelledby="@(visibleTabs.Contains(_activeTab) ? TabElementId(_activeTab) : null)">
    @if (_activeTab == TabRadio)
    {
      <div class="centre-panel-fill">
        <RadioControlPanel />
      </div>
    }
    else if (_activeTab == TabBluetooth)
    {
      <div class="centre-panel-fill">
        <BluetoothConnectPanel Status="@_btStatus" OnStatusChanged="RefreshBluetoothStatusAsync" />
      </div>
    }
    else
    {
      <div class="queue-split">
        <div class="queue-split-list-col">
          <div class="queue-split-list-body">
          @if (_activeTab == TabQueue)
          {
            @if (!_queueItems.Any())
            {
              <div style="flex: 1; display: flex; flex-direction: column; align-items: center; justify-content: center; color: var(--text-low);">
                <RadzenIcon Icon="queue_music" Style="font-size: 80px; opacity: 0.4; margin-bottom: 12px;" />
                <span style="font-size: 16px;">Queue is empty</span>
                @if (IsFilePlayer(_sourceType))
                {
                  @* Points at the action buttons beside the list (UI-32). *@
                  <span class="queue-empty-hint">Add files, a folder, or a playlist to start.</span>
                }
              </div>
            }
            else
            {
              <div id="queue-scroll-container" class="scrollable" style="flex: 1; overflow-y: auto; min-height: 0;">
                <Virtualize Items="@_queueItems" ItemSize="56" OverscanCount="5" Context="item">
                  @{
                    var state = item.State ?? "Upcoming";
                    var isCurrent = state == "Current";
                    var rowClasses = "list-item-touch"
                      + (isCurrent ? " list-item-active queue-row-current" : "");
                  }
                  <div class="@rowClasses"
                       style="cursor: @(state == "Error" ? "not-allowed" : "pointer");
                              opacity: @(state == "Error" ? "0.4" : state == "Played" ? "0.6" : "1");"
                       @onclick="@(() => HandleItemClickAsync(item))">
                    <div style="width: 24px; text-align: center; flex-shrink: 0;">
                      @if (isCurrent)
                      {
                        <span class="queue-row-glyph"
                              style="font-size: 16px; color: var(--signal-amber); font-family: var(--font-mono); line-height: 1;"
                              aria-label="Now playing">▶</span>
                      }
                      else if (state == "Played")
                      {
                        <RadzenIcon Icon="check" Style="font-size: 20px; color: var(--text-low);" />
                      }
                      else if (state == "Error")
                      {
                        <RadzenIcon Icon="error" Style="font-size: 20px; color: var(--rz-danger);" />
                      }
                      else
                      {
                        <span style="font-size: 13px; color: var(--text-low); font-family: var(--font-mono); font-variant-numeric: tabular-nums;">@(item.FullPlaylistIndex + 1)</span>
                      }
                    </div>
                    <div style="flex: 1; min-width: 0;">
                      <div style="font-size: 16px;
                                  font-weight: @(isCurrent ? "600" : "400");
                                  color: @(isCurrent ? "var(--signal-amber)" : state == "Error" ? "var(--signal-red)" : "var(--text-high)");
                                  white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
                                  @(state == "Error" ? "text-decoration: line-through;" : "")">
                        @item.Title
                      </div>
                      <div style="font-size: 14px; color: var(--text-medium); white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">
                        @item.Artist
                      </div>
                    </div>
                    @if (!string.IsNullOrEmpty(item.Duration))
                    {
                      <div style="font-size: 13px; color: var(--text-medium); font-family: var(--font-mono); font-variant-numeric: tabular-nums; text-align: right; min-width: 56px; flex-shrink: 0;">
                        @item.Duration
                      </div>
                    }
                    @if (state == "Upcoming")
                    {
                      <div @onclick:stopPropagation="true">
                        <RadzenButton Variant="Variant.Text"
                                      Icon="close"
                                      Size="ButtonSize.Small"
                                      ButtonStyle="ButtonStyle.Light"
                                      Click="@(() => HandleRemoveAsync(item.Index))"
                                      title="Remove" />
                      </div>
                    }
                  </div>
                </Virtualize>
              </div>
            }
          }
          else if (_activeTab == TabHistory)
          {
            @if (_isLoadingHistory)
            {
              <div style="flex: 1; min-height: 0; padding: 8px;">
                <Skeleton Shape="Skeleton.SkeletonShape.ListRow" />
                <Skeleton Shape="Skeleton.SkeletonShape.ListRow" />
                <Skeleton Shape="Skeleton.SkeletonShape.ListRow" />
                <Skeleton Shape="Skeleton.SkeletonShape.ListRow" />
              </div>
            }
            else if (_historyItems.Any())
            {
              <div class="scrollable" style="flex: 1; overflow-y: auto; min-height: 0;">
                @foreach (var item in _historyItems)
                {
                  <div class="list-item-touch">
                    <div style="width: 36px; height: 36px; flex-shrink: 0; border-radius: 4px; overflow: hidden; display: flex; align-items: center; justify-content: center;">
                      @if (!string.IsNullOrEmpty(item.Track?.CoverArtUrl)
                        && item.Track.CoverArtUrl != "/images/default-album-art.png")
                      {
                        <img src="@item.Track.CoverArtUrl"
                             style="width: 36px; height: 36px; object-fit: cover;"
                             loading="lazy" />
                      }
                      else
                      {
                        <RadzenIcon Icon="@SourceTypeHelper.GetIcon(item.Source)"
                                    Style="font-size: 20px; color: var(--text-low);" />
                      }
                    </div>
                    <div style="flex: 1; min-width: 0;">
                      <div style="font-size: 16px; font-weight: 600; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; color: var(--text-high);">
                        @(item.Title ?? "Unknown")
                      </div>
                      <div style="font-size: 14px; color: var(--text-medium); white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">
                        @(item.Artist ?? "—")
                        @if (item.DurationSeconds.HasValue && item.DurationSeconds.Value > 0)
                        {
                          <text> · </text>
                          <span style="font-family: var(--font-mono); font-variant-numeric: tabular-nums;">@Durations.FormatTrack(TimeSpan.FromSeconds(item.DurationSeconds.Value))</span>
                        }
                        <text> · </text>
                        <span style="font-family: var(--font-mono); font-variant-numeric: tabular-nums; color: var(--text-low);">@Timestamps.FormatRelative(item.PlayedAt.ToLocalTime())</span>
                      </div>
                      @if (!string.IsNullOrEmpty(item.SourceDetails) && item.SourceDetails != $"{item.Title} - {item.Artist}")
                      {
                        <div style="font-size: 12px; color: var(--text-low); white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">
                          @item.SourceDetails
                        </div>
                      }
                    </div>
                    <RadzenBadge BadgeStyle="@GetSourceBadgeStyle(item.Source)"
                                 IsPill="true"
                                 Text="@item.Source"
                                 Style="font-size: 13px;" />
                  </div>
                }
              </div>
            }
            else
            {
              <div style="flex: 1; display: flex; flex-direction: column; align-items: center; justify-content: center; color: var(--text-low);">
                <RadzenIcon Icon="history" Style="font-size: 80px; opacity: 0.4; margin-bottom: 12px;" />
                <span style="font-size: 16px;">No history yet</span>
              </div>
            }
          }
          </div>
        </div>

        @if (_activeTab == TabQueue)
        {
          <!-- Queue view right column (UI-17 point 2): Queue Total + Save as playlist. Up Next was
               dropped because it repeated the list beside it; the column is narrower to give the
               list the width. -->
          <div class="queue-split-context-col is-narrow">
            <!-- Queue Total LED tile. Formats _totalRuntime via Durations.FormatLong. -->
            <div class="queue-total-tile">
              <div class="queue-total-tile-value">@(_totalRuntime > TimeSpan.Zero ? Durations.FormatLong(_totalRuntime) : "0:00:00")</div>
              <div class="queue-total-tile-sub">
                @_queueItems.Count track@(_queueItems.Count == 1 ? "" : "s")
                @if (_totalRuntime > TimeSpan.Zero)
                {
                  @* Forward-looking estimate, not a wall clock — pass allowSeconds: false
                     so the user's global ShowSeconds setting can't introduce :ss precision
                     that's meaningless for a track-total prediction. The 12h/24h flip is
                     honored so this string reads consistently with the topbar Time cluster
                     (handoff §3.4 + §8 open question 3). *@
                  <text> · ends ~@(Clocks.FormatWallClock(DateTime.Now.Add(_totalRuntime), DisplayOptionsMonitor.CurrentValue, allowSeconds: false))</text>
                }
              </div>
            </div>

            <!-- UI-32: the queue actions, on screen rather than behind a ⋮ menu, as 56 px buttons. Add files,
                 Add folder, Load playlist and Clear queue belong to File Player's queue view only (UI-17 points 3
                 and 4): on the queue view reached from another source by the Queue pill they are hidden,
                 because adding makes the API switch the source to File Player — viewing the queue must not
                 interrupt what is playing. Save as playlist switches nothing and shows on both. Save and Clear
                 are disabled with the queue empty (saving nothing would create an empty playlist); Clear asks
                 first. -->
            <div class="queue-actions" role="group" aria-label="Queue actions">
              @if (IsFilePlayer(_sourceType))
              {
                <button type="button" class="queue-action" @onclick="OpenFileSelectionDialogAsync">
                  <RadzenIcon Icon="add" /><span>Add files</span>
                </button>
                <button type="button" class="queue-action" @onclick="OpenAddFolderDialogAsync">
                  <RadzenIcon Icon="create_new_folder" /><span>Add folder</span>
                </button>
                <button type="button" class="queue-action" @onclick="OpenLoadPlaylistDialogAsync">
                  <RadzenIcon Icon="playlist_play" /><span>Load playlist</span>
                </button>
              }
              <button type="button"
                      class="queue-action is-secondary"
                      disabled="@(!_queueItems.Any())"
                      @onclick="OpenSavePlaylistDialogAsync"
                      aria-label="Save current queue as playlist">
                <RadzenIcon Icon="playlist_add" /><span>Save as playlist</span>
              </button>
              @if (IsFilePlayer(_sourceType))
              {
                <button type="button"
                        class="queue-action is-danger"
                        disabled="@(!_queueItems.Any())"
                        @onclick="AskClearQueue">
                  <RadzenIcon Icon="delete_sweep" /><span>Clear queue</span>
                </button>
              }
            </div>
          </div>
        }
        else if (_showStats)
        {
          <!-- History stats (UI-17 point 1): rendered only while the Stats chip is on. With it off
               there is no right column and the history list takes the full width. -->
          <div class="queue-split-context-col">
            <div class="history-stats-tile">
              <div class="history-stats-row">
                <span class="history-stats-label">Total Plays</span>
                <span class="history-stats-value history-stats-value-led">@(_historyStats?.TotalPlays.ToString() ?? "—")</span>
              </div>
              <div class="history-stats-row">
                <span class="history-stats-label">Top Track</span>
                <span class="history-stats-value" title="@_topTrackTooltip">@_topTrackDisplay</span>
              </div>
              <div class="history-stats-row">
                <span class="history-stats-label">Top Artist</span>
                <span class="history-stats-value" title="@_topArtistTooltip">@_topArtistDisplay</span>
              </div>
            </div>
          </div>
        }
      </div>
    }
  </div>

  @if (_confirmClear && _activeTab == TabQueue && IsFilePlayer(_sourceType))
  {
    @* UI-32: Clear queue is a 56 px button now, easy to hit by accident, so it asks first. Same shape as Play
       History's Clear All confirmation; Cancel comes first, takes focus when the card opens, and Esc or a tap
       outside cancels. Shown only while the File Player queue view that raised it is still showing — a source
       change or tab change hides it rather than leaving it over a view with no Clear button. *@
    <div class="queue-confirm-overlay" @onclick="CancelClearQueue">
      <div class="queue-confirm-card" role="alertdialog" aria-modal="true" aria-labelledby="queue-confirm-title"
           tabindex="-1" @onkeydown="OnClearConfirmKeyDown"
           @onclick:stopPropagation="true">
        <h6 id="queue-confirm-title">Clear the queue?</h6>
        <p>@ClearQueueConfirmText(_queueItems.Count)</p>
        <div class="queue-confirm-actions">
          <RadzenButton @ref="_clearCancelButton" Text="Cancel" Variant="Variant.Text"
                        Click="CancelClearQueue" class="queue-confirm-cancel" />
          <RadzenButton Text="Clear queue" Variant="Variant.Filled" ButtonStyle="ButtonStyle.Danger"
                        Click="ConfirmClearQueueAsync" class="queue-confirm-clear" />
        </div>
      </div>
    </div>
  }
</div>

@code {
  // ── Tab constants — define once so markup and code-behind agree. ──
  internal const int TabQueue = 0;
  internal const int TabHistory = 1;
  internal const int TabRadio = 2;
  // One tab, two labels: "Connect" with no device connected, "Devices" with one (UI-17 point 6).
  internal const int TabBluetooth = 3;

  /// <summary>Config-store section holding this panel's console-wide UI preferences.</summary>
  internal const string UiPreferencesSection = "ui.centrePanel";

  /// <summary>Key, within <see cref="UiPreferencesSection"/>, of the Stats chip's on/off state.</summary>
  internal const string ShowStatsKey = "showStats";

  /// <summary>
  /// Period of <see cref="PollTickAsync"/>. A tick does work in two cases only: the last primary-source
  /// read failed (re-read it), or Bluetooth is the active source (re-read its status — nothing pushes
  /// Bluetooth connect/disconnect to Radio.Web, since the API broadcasts to a hub group no client can
  /// join, so the auto-switch in <see cref="ApplyBluetoothStatus"/> rides on this). Otherwise a tick
  /// does nothing. Five seconds matches PhonePage's status poll.
  /// </summary>
  internal static readonly TimeSpan PollInterval = TimeSpan.FromSeconds(5);

  private int _activeTab = TabHistory;

  // Set when the owner picks a view (a tab tap, the Queue nav pill, the radio chevron) and cleared
  // only when the primary source TYPE changes. While set, nothing moves the tab automatically: not
  // a Bluetooth connect/disconnect, and not a repeated SourceChanged for the same source.
  private bool _userOverrodeTab;

  // Active primary source type from the last SUCCESSFUL read of /api/sources/primary; null when the
  // API reported none, or before any read has succeeded. A failed read leaves it unchanged.
  private string? _sourceType;

  // Whether any primary-source read has succeeded yet. Until one has, _sourceType's null means
  // "unknown", not "no source", so the first successful read applies its default without counting
  // as a source change.
  private bool _sourceEverRead;

  // Set when the latest read failed; the poll re-reads the source while it is set.
  private bool _sourceStale;

  private List<QueueItemDto> _queueItems = new();
  private List<PlayHistoryEntryDto> _historyItems = new();
  private PlayHistoryStatsDto? _historyStats;
  private bool _isLoadingHistory;
  private int _playedCount;
  // Aggregate of every queue item's parsed Duration string. Surfaced as "h:mm:ss" in the
  // Queue Total tile via Durations.FormatLong. Zero when no rows have durations yet.
  private TimeSpan _totalRuntime = TimeSpan.Zero;
  private CancellationTokenSource? _refreshCts;

  // Stats chip (UI-17 point 1). Off unless the config store says otherwise.
  private bool _showStats;

  // Latest Bluetooth status (null when unread or unreadable) and whether it shows a connected device.
  // _btConnected is only changed by a successful read, so an API blip does not flip the tab.
  private BluetoothStatusDto? _btStatus;
  private bool _btConnected;

  // UI-32: the Clear queue confirmation is showing; its Cancel button, focused once when the card opens.
  private bool _confirmClear;
  private RadzenButton? _clearCancelButton;
  private bool _focusClearCancel;

  // Cached display strings for the history-stats tile so the right column can
  // render synchronously without re-querying TopTracks/TopArtists each render.
  private string _topTrackDisplay = "—";
  private string _topTrackTooltip = string.Empty;
  private string _topArtistDisplay = "—";
  private string _topArtistTooltip = string.Empty;

  private IReadOnlyList<int> VisibleTabs => TabsFor(_sourceType, _btConnected, _activeTab);

  private static string TabElementId(int tab) => $"centre-tab-{tab}";

  private string TabLabel(int tab) => tab switch
  {
    TabQueue => $"Queue · {_queueItems.Count}",
    TabRadio => "Radio",
    TabBluetooth => _btConnected ? "Devices" : "Connect",
    _ => "History",
  };

  private static bool IsFilePlayer(string? sourceType) =>
    string.Equals(sourceType, "FilePlayer", StringComparison.OrdinalIgnoreCase);

  private static bool IsBluetooth(string? sourceType) =>
    string.Equals(sourceType, "Bluetooth", StringComparison.OrdinalIgnoreCase);

  /// <summary>
  /// The tab a source opens on (UI-17 table): File Player → Queue when the queue has tracks, else
  /// History; radio family → Radio; Bluetooth → History when a device is connected, else Connect;
  /// every other source (Vinyl, USB Audio, Test Tone, none) → History.
  /// </summary>
  internal static int DefaultTabFor(string? sourceType, int queueCount, bool bluetoothConnected)
  {
    if (IsFilePlayer(sourceType))
    {
      return queueCount > 0 ? TabQueue : TabHistory;
    }
    if (SourceTypeHelper.IsRadioFamily(sourceType))
    {
      return TabRadio;
    }
    if (IsBluetooth(sourceType))
    {
      return bluetoothConnected ? TabHistory : TabBluetooth;
    }
    return TabHistory;
  }

  /// <summary>
  /// The tabs the strip shows, in order (UI-17 table). The Queue tab belongs to File Player only;
  /// on any other source it appears only while the queue view is showing — reached through the Queue
  /// nav pill — together with a History tab to leave it by. A source whose only view is History shows
  /// no tabs at all.
  /// </summary>
  internal static IReadOnlyList<int> TabsFor(string? sourceType, bool bluetoothConnected, int activeTab)
  {
    List<int> tabs;
    if (IsFilePlayer(sourceType))
    {
      tabs = [TabQueue, TabHistory];
    }
    else if (SourceTypeHelper.IsRadioFamily(sourceType))
    {
      tabs = [TabRadio, TabHistory];
    }
    else if (IsBluetooth(sourceType))
    {
      tabs = bluetoothConnected ? [TabHistory, TabBluetooth] : [TabBluetooth, TabHistory];
    }
    else
    {
      tabs = [];
    }

    if (activeTab == TabQueue && !tabs.Contains(TabQueue))
    {
      if (!tabs.Contains(TabHistory))
      {
        tabs.Add(TabHistory);
      }
      tabs.Add(TabQueue);
    }

    return tabs;
  }

  protected override async Task OnInitializedAsync()
  {
    HubService.QueueChanged += OnQueueChanged;
    HubService.SourceChanged += OnSourceChanged;
    CentrePanelViews.ViewRequested += OnViewRequested;

    await LoadStatsPreferenceAsync();

    // Reads the source and queue and applies the source's default tab — unless a view request that
    // arrived during the awaits has already set the tab and the override. If the source cannot be
    // read the panel stays on History and the poll keeps retrying (_sourceStale).
    await SyncSourceAsync();

    // A request made while no centre panel existed (Queue pill or radio chevron tapped on another
    // page, which then navigated here) waits in the service for this panel to collect it.
    CentrePanelView? pending = CentrePanelViews.TakePendingView();
    if (pending.HasValue)
    {
      ApplyViewRequest(pending.Value);
    }

    await RefreshHistoryAsync();
    StartPeriodicRefreshes();
  }

  private void StartPeriodicRefreshes()
  {
    _refreshCts = new CancellationTokenSource();
    _ = PeriodicHistoryRefreshAsync(_refreshCts.Token);
    _ = PeriodicPollAsync(_refreshCts.Token);
  }

  private async Task PeriodicHistoryRefreshAsync(CancellationToken ct)
  {
    using var timer = new PeriodicTimer(TimeSpan.FromSeconds(30));
    while (await timer.WaitForNextTickAsync(ct))
    {
      try
      {
        // Only refresh when History tab is active
        if (_activeTab == TabHistory)
        {
          var result = await HistoryApi.GetHistoryAsync(limit: 50);
          _historyItems = result?.Items ?? new();
          if (_showStats)
          {
            await RefreshHistoryStatsAsync();
          }
          await InvokeAsync(StateHasChanged);
        }
      }
      catch (OperationCanceledException) { break; }
      catch (Exception ex)
      {
        Logger.LogDebug(ex, "Periodic history refresh failed");
      }
    }
  }

  private async Task PeriodicPollAsync(CancellationToken ct)
  {
    using var timer = new PeriodicTimer(PollInterval);
    while (await timer.WaitForNextTickAsync(ct))
    {
      try
      {
        // Gate the whole tick, not just the HTTP call, so an idle tick never hops onto the renderer.
        // These two reads are off the renderer's context and may be one tick stale; PollTickAsync
        // re-checks both on the renderer before acting.
        if (_sourceStale || IsBluetooth(_sourceType))
        {
          await InvokeAsync(PollTickAsync);
        }
      }
      catch (OperationCanceledException) { break; }
      catch (Exception ex)
      {
        Logger.LogDebug(ex, "Centre panel poll failed");
      }
    }
  }

  /// <summary>
  /// One poll tick: re-read the primary source if the last read failed; otherwise, with Bluetooth
  /// active, re-read the Bluetooth status.
  /// </summary>
  internal async Task PollTickAsync()
  {
    if (_sourceStale)
    {
      await SyncSourceAsync();
      StateHasChanged();
      return;
    }

    await RefreshBluetoothStatusAsync();
  }

  /// <summary>
  /// Re-reads the Bluetooth status and applies it, auto-switch included. A no-op unless Bluetooth is
  /// the active source. Called by the poll and by <see cref="BluetoothConnectPanel"/> after each of
  /// its actions.
  /// </summary>
  internal async Task RefreshBluetoothStatusAsync()
  {
    if (!IsBluetooth(_sourceType))
    {
      return;
    }

    BluetoothStatusDto? status = await BluetoothApi.GetStatusAsync();
    ApplyBluetoothStatus(status, allowAutoSwitch: true);
    StateHasChanged();
  }

  /// <summary>
  /// Records a Bluetooth status read. With <paramref name="allowAutoSwitch"/>, a change in whether a
  /// device is connected moves the tab (UI-17 point 6): connecting while on Connect → History;
  /// disconnecting while on History → Connect. Neither happens once the owner has picked a view since
  /// the source became active. A <c>null</c> status (unreadable) leaves the connected state as it was.
  /// </summary>
  private void ApplyBluetoothStatus(BluetoothStatusDto? status, bool allowAutoSwitch)
  {
    _btStatus = status;
    if (status == null)
    {
      return;
    }

    bool wasConnected = _btConnected;
    _btConnected = status.ConnectedDevice != null;

    if (!allowAutoSwitch || wasConnected == _btConnected || _userOverrodeTab)
    {
      return;
    }

    if (_btConnected && _activeTab == TabBluetooth)
    {
      _activeTab = TabHistory;
    }
    else if (!_btConnected && _activeTab == TabHistory)
    {
      _activeTab = TabBluetooth;
    }
  }

  /// <summary>
  /// Reads the primary source and the queue, and applies a source change if there was one.
  ///
  /// <para>A failed read changes nothing — not <c>_sourceType</c>, not the tab, not the override —
  /// and sets <c>_sourceStale</c> so the poll re-reads it. An API blip is not a source change.</para>
  ///
  /// <para>A successful read is a change when the type differs from the last successful read, or
  /// when it is the first successful read. A real change clears the override; the first read does
  /// not (there was no earlier source for a tapped view to belong to). Either way the source's
  /// default tab is applied unless the override is set.</para>
  /// </summary>
  private async Task SyncSourceAsync()
  {
    bool hadPrevious = _sourceEverRead;
    string? previous = _sourceType;

    SourcesApiService.PrimarySourceRead read = await SourcesApi.ReadPrimarySourceAsync();
    await RefreshQueueAsync();
    if (!read.Succeeded)
    {
      _sourceStale = true;
      return;
    }

    _sourceStale = false;
    _sourceEverRead = true;
    _sourceType = read.Source?.Type;

    bool changed = !hadPrevious
      || !string.Equals(previous, _sourceType, StringComparison.OrdinalIgnoreCase);
    if (!changed)
    {
      return;
    }

    if (hadPrevious)
    {
      _userOverrodeTab = false;
    }

    _btStatus = null;
    _btConnected = false;
    if (IsBluetooth(_sourceType))
    {
      ApplyBluetoothStatus(await BluetoothApi.GetStatusAsync(), allowAutoSwitch: false);
    }

    if (!_userOverrodeTab)
    {
      _activeTab = DefaultTabFor(_sourceType, _queueItems.Count, _btConnected);
    }
  }

  private async Task LoadStatsPreferenceAsync()
  {
    try
    {
      Dictionary<string, object>? prefs =
        await ConfigApi.GetConfigurationAsync<Dictionary<string, object>>(UiPreferencesSection);
      if (prefs != null
        && prefs.TryGetValue(ShowStatsKey, out object? value)
        && bool.TryParse(value?.ToString(), out bool showStats))
      {
        _showStats = showStats;
      }
    }
    catch (Exception ex)
    {
      Logger.LogDebug(ex, "Failed to load centre panel preferences");
    }
  }

  private async Task ToggleStatsAsync()
  {
    _showStats = !_showStats;
    if (_showStats && _historyStats == null)
    {
      await RefreshHistoryStatsAsync();
    }

    // UpdateConfigurationAsync reports failure by returning false (it catches its own exceptions).
    // Warning, never Information: Radio.Web's console sink is unrestricted, so either reaches journald.
    bool saved = await ConfigApi.UpdateConfigurationAsync(UiPreferencesSection, ShowStatsKey, _showStats);
    if (!saved)
    {
      Logger.LogWarning("Failed to save the Stats chip preference");
    }
  }

  private async Task OnViewRequested(CentrePanelView view)
  {
    // Consume the request so a later-mounted panel does not apply it a second time.
    CentrePanelViews.TakePendingView();
    await InvokeAsync(() =>
    {
      ApplyViewRequest(view);
      StateHasChanged();
    });
  }

  /// <summary>
  /// Applies a view the layout asked for. Both count as the owner picking a view, so they hold until
  /// the source changes. The Radio request is ignored unless a radio-family source is active, since
  /// there is no Radio tab otherwise.
  /// </summary>
  private void ApplyViewRequest(CentrePanelView view)
  {
    if (view == CentrePanelView.Queue)
    {
      _activeTab = TabQueue;
      _userOverrodeTab = true;
    }
    else if (view == CentrePanelView.Radio && SourceTypeHelper.IsRadioFamily(_sourceType))
    {
      _activeTab = TabRadio;
      _userOverrodeTab = true;
    }
  }

  private async Task OnQueueChanged()
  {
    await RefreshQueueAsync();
    _ = ScheduleQueueSaveAsync();
    await InvokeAsync(StateHasChanged);
  }

  private async Task RefreshQueueAsync()
  {
    try
    {
      // Try full playlist first, fall back to regular queue
      var fullPlaylist = await QueueApi.GetFullPlaylistAsync();
      if (fullPlaylist != null)
      {
        _queueItems = fullPlaylist;
      }
      else
      {
        var queue = await QueueApi.GetQueueAsync();
        if (queue != null) _queueItems = queue;
      }

      _playedCount = _queueItems.Count(i => i.State == "Played");
      _totalRuntime = SumQueueRuntime(_queueItems);
    }
    catch (Exception ex)
    {
      Logger.LogWarning(ex, "Failed to refresh queue");
    }
  }

  /// <summary>
  /// Sums the parsed <c>Duration</c> strings across every queue item.
  /// Server delivers each row's duration as a pre-formatted "m:ss" / "h:mm:ss" string,
  /// so we round-trip through <see cref="TimeSpan.TryParse(string?, out TimeSpan)"/> with
  /// a normalized "hh:mm:ss" form. Rows with empty / unparseable durations contribute zero.
  /// Exposed as <c>internal static</c> so unit tests can pin the parsing behaviour.
  /// </summary>
  internal static TimeSpan SumQueueRuntime(IEnumerable<QueueItemDto> items)
  {
    var total = TimeSpan.Zero;
    foreach (var item in items)
    {
      if (string.IsNullOrWhiteSpace(item.Duration)) continue;
      // TimeSpan.TryParse handles both "m:ss" (treated as "h:mm") and "h:mm:ss";
      // we normalize "m:ss" to "0:mm:ss" by counting separators.
      var s = item.Duration.Trim();
      var colonCount = s.Count(c => c == ':');
      var normalized = colonCount == 1 ? "00:" + s : s;
      if (TimeSpan.TryParse(normalized, System.Globalization.CultureInfo.InvariantCulture, out var ts))
      {
        total += ts;
      }
    }
    return total;
  }

  private async Task RefreshHistoryAsync()
  {
    try
    {
      _isLoadingHistory = true;
      StateHasChanged();

      var listTask = HistoryApi.GetHistoryAsync(limit: 50);
      var statsTask = HistoryApi.GetStatsAsync();
      await Task.WhenAll(listTask, statsTask);

      _historyItems = (await listTask)?.Items ?? new();
      _historyStats = await statsTask;
      ApplyHistoryStatsProjections();
    }
    catch (Exception ex)
    {
      Logger.LogWarning(ex, "Failed to refresh history");
    }
    finally
    {
      _isLoadingHistory = false;
      StateHasChanged();
    }
  }

  /// <summary>
  /// Refreshes only the history stats payload, without disturbing the list-loading
  /// flag. Called from the periodic refresh loop so a stale stats tile doesn't
  /// linger while the list itself updates.
  /// </summary>
  private async Task RefreshHistoryStatsAsync()
  {
    try
    {
      _historyStats = await HistoryApi.GetStatsAsync();
      ApplyHistoryStatsProjections();
    }
    catch (Exception ex)
    {
      Logger.LogDebug(ex, "Failed to refresh history stats");
    }
  }

  private void ApplyHistoryStatsProjections()
  {
    if (_historyStats == null)
    {
      _topTrackDisplay = "—";
      _topTrackTooltip = string.Empty;
      _topArtistDisplay = "—";
      _topArtistTooltip = string.Empty;
      return;
    }

    var topTrack = _historyStats.TopTracks?.FirstOrDefault();
    if (topTrack != null)
    {
      _topTrackDisplay = $"{topTrack.Title} · {topTrack.PlayCount}×";
      _topTrackTooltip = $"{topTrack.Title} by {topTrack.Artist} ({topTrack.PlayCount} plays)";
    }
    else
    {
      _topTrackDisplay = "—";
      _topTrackTooltip = string.Empty;
    }

    var topArtist = _historyStats.TopArtists?.FirstOrDefault();
    if (topArtist != null)
    {
      _topArtistDisplay = $"{topArtist.Artist} · {topArtist.PlayCount}×";
      _topArtistTooltip = $"{topArtist.Artist} ({topArtist.PlayCount} plays)";
    }
    else
    {
      _topArtistDisplay = "—";
      _topArtistTooltip = string.Empty;
    }
  }

  private async Task HandleItemClickAsync(QueueItemDto item)
  {
    var state = item.State ?? "Upcoming";
    if (state == "Error") return; // Don't click error items

    try
    {
      await QueueApi.JumpToFullPlaylistPositionAsync(item.FullPlaylistIndex);
    }
    catch (Exception ex)
    {
      Logger.LogWarning(ex, "Failed to jump to playlist position");
    }
  }

  private async Task HandleRemoveAsync(int index)
  {
    try
    {
      var success = await QueueApi.RemoveFromQueueAsync(index);
      if (success) await RefreshQueueAsync();
    }
    catch (Exception ex) { Logger.LogWarning(ex, "Failed to remove queue item"); }
  }

  private async Task HandleClearQueueAsync()
  {
    try
    {
      var success = await QueueApi.ClearQueueAsync();
      if (success) _queueItems.Clear();
    }
    catch (Exception ex) { Logger.LogWarning(ex, "Failed to clear queue"); }
  }

  private async Task OpenSavePlaylistDialogAsync()
  {
    await DialogService.OpenAsync<Radio.Web.Components.Dialogs.SavePlaylistDialog>("Save Playlist",
      new Dictionary<string, object>(),
      // UI-24: name and description fields — top-anchored, clear of the in-app keyboard.
      new DialogOptions { ShowClose = true, Width = "400px", CloseDialogOnOverlayClick = true, CssClass = Radio.Web.Components.Dialogs.KioskEntryDialog.CssClass });
  }

  private async Task OpenLoadPlaylistDialogAsync()
  {
    var result = await DialogService.OpenAsync<Radio.Web.Components.Dialogs.LoadPlaylistDialog>("Load Playlist",
      new Dictionary<string, object>(),
      new DialogOptions { ShowClose = true, Width = "400px", CloseDialogOnOverlayClick = true });
    if (result != null)
    {
      await RefreshQueueAsync();
      StateHasChanged();
    }
  }

  private async Task OpenFileSelectionDialogAsync()
  {
    var result = await DialogService.OpenAsync<Radio.Web.Components.Dialogs.FileBrowserDialog>("Add Files to Queue",
      new Dictionary<string, object>
      {
        { "AllowMultiSelect", true },
        { "AllowAddToQueue", true },
        { "ShowPlayButton", true },
        { "PreferredBookmarkTag", "music" },
        { "OnAddToQueue", EventCallback.Factory.Create<List<string>>(this, HandleAddFilesToQueueAsync) }
      },
      // UI-24: path and search fields — top-anchored, clear of the in-app keyboard.
      new DialogOptions { ShowClose = true, Width = "600px", CloseDialogOnOverlayClick = true, CssClass = Radio.Web.Components.Dialogs.KioskEntryDialog.CssClass });

    if (result != null)
    {
      if (result is List<string> selectedPaths)
        await HandleAddFilesToQueueAsync(selectedPaths);
      else if (result is string selectedPath)
        await HandleAddFilesToQueueAsync(new List<string> { selectedPath });
    }
  }

  /// <summary>
  /// UI-32 Add folder: the file browser in folder mode lists, queues and reports progress itself, then closes with
  /// a <see cref="Radio.Web.Services.FolderAddResult"/> that becomes the toast. Tapping outside does not close it,
  /// so a stray tap cannot abandon an add half-way; ✕ still does (the batches already sent stay queued).
  /// </summary>
  private async Task OpenAddFolderDialogAsync()
  {
    var result = await DialogService.OpenAsync<Radio.Web.Components.Dialogs.FileBrowserDialog>("Add folder",
      new Dictionary<string, object>
      {
        { "SelectFolder", true },
        { "PreferredBookmarkTag", "music" }
      },
      // UI-24: path and search fields — top-anchored, clear of the in-app keyboard.
      new DialogOptions { ShowClose = true, Width = "600px", CloseDialogOnOverlayClick = false, CssClass = Radio.Web.Components.Dialogs.KioskEntryDialog.CssClass });

    if (result is Radio.Web.Services.FolderAddResult added)
    {
      var (severity, summary, detail) = Radio.Web.Services.FolderQueueAdder.Describe(added);
      NotificationService.Notify(severity, summary, detail);
      if (added.Added > 0)
      {
        await RefreshQueueAsync();
      }
    }
  }

  private async Task HandleAddFilesToQueueAsync(List<string> filePaths)
  {
    if (filePaths == null || !filePaths.Any()) return;

    try
    {
      var (success, addedCount, error) = await FileApi.AddFilesToQueueAsync(filePaths);
      if (addedCount > 0)
      {
        NotificationService.Notify(NotificationSeverity.Success, "Success", $"{addedCount} file{(addedCount != 1 ? "s" : "")} added");
        await RefreshQueueAsync();
      }
      if (!string.IsNullOrEmpty(error))
      {
        NotificationService.Notify(NotificationSeverity.Warning, "Warning", error);
      }
      else if (!success)
      {
        NotificationService.Notify(NotificationSeverity.Error, "Error", "Failed to add files to queue");
      }
    }
    catch (Exception ex)
    {
      Logger.LogError(ex, "Failed to add files to queue");
      NotificationService.Notify(NotificationSeverity.Error, "Error", "Error adding files to queue");
    }
  }

  private async Task ScheduleQueueSaveAsync()
  {
    try
    {
      await Task.Delay(500);
      await QueuePersistence.SaveQueueStateAsync();
    }
    catch (Exception ex) { Logger.LogWarning(ex, "Failed to auto-save queue state"); }
  }

  private static BadgeStyle GetSourceBadgeStyle(string source)
  {
    return source switch
    {
      "File" => BadgeStyle.Info,
      "Radio" => BadgeStyle.Warning,
      "Bluetooth" => BadgeStyle.Secondary,
      "Vinyl" => BadgeStyle.Success,
      _ => BadgeStyle.Light
    };
  }

  private async Task SetTab(int newTab)
  {
    if (newTab == _activeTab) return;
    _activeTab = newTab;
    _userOverrodeTab = true;
    if (newTab == TabHistory && _showStats && _historyStats == null)
    {
      // First switch to History with the chip on — ensure the stats tile has data.
      await RefreshHistoryStatsAsync();
    }
  }

  private void AskClearQueue()
  {
    _confirmClear = true;
    _focusClearCancel = true;
  }

  private void CancelClearQueue() => _confirmClear = false;

  private void OnClearConfirmKeyDown(KeyboardEventArgs e)
  {
    if (e.Key == "Escape")
    {
      CancelClearQueue();
    }
  }

  protected override async Task OnAfterRenderAsync(bool firstRender)
  {
    if (_focusClearCancel && _clearCancelButton != null)
    {
      _focusClearCancel = false;
      try
      {
        await _clearCancelButton.Element.FocusAsync();
      }
      catch (Exception ex) when (ex is JSException or InvalidOperationException or TaskCanceledException)
      {
        // Focus is a courtesy; a circuit going away or an element already gone must not break the panel.
        Logger.LogDebug(ex, "Could not focus the Clear queue confirmation");
      }
    }
  }

  private async Task ConfirmClearQueueAsync()
  {
    _confirmClear = false;
    await HandleClearQueueAsync();
  }

  /// <summary>The Clear queue confirmation's body. Clearing also stops playback (FilePlayerAudioSource.ClearQueueAsync).</summary>
  internal static string ClearQueueConfirmText(int trackCount) =>
    trackCount == 1
      ? "Removes the 1 track in the queue and stops playback."
      : $"Removes all {trackCount} tracks and stops playback.";

  /// <summary>
  /// SourceChanged fires more than once per switch (MainLayout notifies locally, then the hub pushes)
  /// and can fire without a switch, so <see cref="SyncSourceAsync"/> clears the override and
  /// re-applies the default only when the primary source TYPE actually changed. That is what makes a
  /// tapped tab stick "until the source changes" rather than until the next SourceChanged.
  /// </summary>
  private async Task OnSourceChanged()
  {
    await InvokeAsync(async () =>
    {
      await SyncSourceAsync();
      StateHasChanged();
    });
  }

  public async ValueTask DisposeAsync()
  {
    HubService.QueueChanged -= OnQueueChanged;
    HubService.SourceChanged -= OnSourceChanged;
    CentrePanelViews.ViewRequested -= OnViewRequested;
    _refreshCts?.Cancel();
    _refreshCts?.Dispose();
    await Task.CompletedTask;
  }
}
