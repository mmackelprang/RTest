@rendermode InteractiveServer
@using Radio.Web.Services.ApiClients
@inject QueueApiService QueueApi
@inject PlayHistoryApiService HistoryApi
@inject AudioStateHubService HubService
@inject AudioApiService AudioApi
@inject FileApiService FileApi
@inject IDialogService DialogService
@inject ILogger<QueueHistoryPanel> Logger
@inject ISnackbar Snackbar
@inject Radio.Web.Services.QueuePersistenceService QueuePersistence
@inject PlaylistApiService PlaylistApi
@inject SourcesApiService SourcesApi
@implements IAsyncDisposable

<div style="height: 100%; display: flex; flex-direction: column; padding: 0;">
  <MudTabs Elevation="0" Rounded="false" ApplyEffectsToContainer="true"
           ActivePanelIndex="_activeTab"
           ActivePanelIndexChanged="OnTabChanged"
           Style="height: 100%; display: flex; flex-direction: column; min-height: 0;">
    <MudTabPanel Text="Queue" Icon="@Icons.Material.Filled.QueueMusic"
                 BadgeData="@(_queueItems.Count > 0 ? _queueItems.Count.ToString() : null)"
                 BadgeColor="Color.Primary"
                 Style="flex: 1; overflow: hidden; display: flex; flex-direction: column; min-height: 0;">
      <div style="height: 100%; display: flex; flex-direction: column; min-height: 0;">
        <!-- Queue Header -->
        <div class="panel-header">
          <span>
            @if (_playedCount > 0)
            {
              @($"{_playedCount}/{_queueItems.Count} played")
            }
            else
            {
              @($"{_queueItems.Count} tracks")
            }
          </span>
          <div style="display: flex; gap: 4px;">
            <MudIconButton Icon="@Icons.Material.Filled.Add"
                           Color="Color.Primary"
                           Size="Size.Small"
                           OnClick="OpenFileSelectionDialogAsync"
                           title="Add Files" />
            <MudIconButton Icon="@Icons.Material.Filled.PlaylistPlay"
                           Color="Color.Primary"
                           Size="Size.Small"
                           OnClick="OpenLoadPlaylistDialogAsync"
                           title="Load Playlist" />
            <MudIconButton Icon="@Icons.Material.Filled.Save"
                           Color="Color.Primary"
                           Size="Size.Small"
                           Disabled="@(!_queueItems.Any())"
                           OnClick="OpenSavePlaylistDialogAsync"
                           title="Save as Playlist" />
            <MudIconButton Icon="@Icons.Material.Filled.DeleteSweep"
                           Color="Color.Error"
                           Size="Size.Small"
                           Disabled="@(!_queueItems.Any())"
                           OnClick="HandleClearQueueAsync"
                           title="Clear All" />
          </div>
        </div>

        <!-- Queue List -->
        @if (!_queueItems.Any())
        {
          <div style="flex: 1; display: flex; flex-direction: column; align-items: center; justify-content: center; color: var(--text-low);">
            <MudIcon Icon="@Icons.Material.Filled.QueueMusic" Style="font-size: 80px; opacity: 0.4; margin-bottom: 12px;" />
            <span style="font-size: 16px;">No tracks in queue</span>
          </div>
        }
        else
        {
          <div id="queue-scroll-container" class="scrollable" style="flex: 1; overflow-y: auto; min-height: 0;">
            <MudVirtualize Items="@_queueItems" ItemSize="56" OverscanCount="5" Context="item">
              @{
                var itemState = item.State ?? "Upcoming";
                var isError = itemState == "Error";
                var isCurrent = itemState == "Current";
                var isPlayed = itemState == "Played";
                var isClickable = !isError;
              }

              <div class="list-item-touch @(isCurrent ? "list-item-active" : "")"
                   style="cursor: @(isClickable ? "pointer" : "not-allowed");
                          opacity: @(isError ? "0.4" : isPlayed ? "0.6" : "1");"
                   @onclick="@(() => HandleItemClickAsync(item))">
                <!-- State icon -->
                <div style="width: 24px; text-align: center; flex-shrink: 0;">
                  @if (isCurrent)
                  {
                    <div class="now-playing-bars">
                      <span></span><span></span><span></span>
                    </div>
                  }
                  else if (isPlayed)
                  {
                    <MudIcon Icon="@Icons.Material.Filled.Check" Size="Size.Small" Style="color: var(--text-low);" />
                  }
                  else if (isError)
                  {
                    <MudIcon Icon="@Icons.Material.Filled.Error" Color="Color.Error" Size="Size.Small" />
                  }
                  else
                  {
                    <span style="font-size: 13px; color: var(--text-low); font-family: var(--font-mono);">@(item.FullPlaylistIndex + 1)</span>
                  }
                </div>

                <!-- Track info -->
                <div style="flex: 1; min-width: 0;">
                  <div style="font-size: 16px;
                              font-weight: @(isCurrent ? "600" : "400");
                              color: @(isCurrent ? "var(--accent-primary)" : isError ? "var(--signal-red)" : "var(--text-high)");
                              white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
                              @(isError ? "text-decoration: line-through;" : "")">
                    @item.Title
                  </div>
                  <div style="font-size: 14px; color: var(--text-medium); white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">
                    @item.Artist @if (!string.IsNullOrEmpty(item.Duration)) { <text> · @item.Duration</text> }
                  </div>
                </div>

                <!-- Remove button (only for upcoming items) -->
                @if (itemState == "Upcoming")
                {
                  <div @onclick:stopPropagation="true">
                    <MudIconButton Icon="@Icons.Material.Filled.Close"
                                   Size="Size.Small"
                                   Color="Color.Default"
                                   OnClick="@(() => HandleRemoveAsync(item.Index))"
                                   title="Remove" />
                  </div>
                }
              </div>
            </MudVirtualize>
          </div>
        }
      </div>
    </MudTabPanel>

    <MudTabPanel Text="History" Icon="@Icons.Material.Filled.History"
                 Style="flex: 1; overflow: hidden; display: flex; flex-direction: column; min-height: 0;">
      <div style="height: 100%; display: flex; flex-direction: column; min-height: 0;">
        <!-- History Header -->
        <div class="panel-header">
          <span>Recent Plays</span>
          <MudIconButton Icon="@Icons.Material.Filled.Refresh"
                         Color="Color.Default"
                         Size="Size.Small"
                         OnClick="RefreshHistoryAsync"
                         title="Refresh" />
        </div>

        <!-- History List -->
        @if (_isLoadingHistory)
        {
          <div style="flex: 1; display: flex; align-items: center; justify-content: center;">
            <MudProgressCircular Color="Color.Primary" Indeterminate="true" Size="Size.Small" />
          </div>
        }
        else if (_historyItems.Any())
        {
          <div class="scrollable" style="flex: 1; overflow-y: auto; min-height: 0;">
            @foreach (var item in _historyItems)
            {
              <div class="list-item-touch">
                <!-- Album art or source icon -->
                <div style="width: 36px; height: 36px; flex-shrink: 0; border-radius: 4px; overflow: hidden; display: flex; align-items: center; justify-content: center;">
                  @if (!string.IsNullOrEmpty(item.Track?.CoverArtUrl)
                    && item.Track.CoverArtUrl != "/images/default-album-art.png")
                  {
                    <img src="@item.Track.CoverArtUrl"
                         style="width: 36px; height: 36px; object-fit: cover;"
                         loading="lazy" />
                  }
                  else
                  {
                    <MudIcon Icon="@SourceTypeHelper.GetIcon(item.Source)"
                             Size="Size.Small"
                             Style="color: var(--text-low);" />
                  }
                </div>
                <!-- Track info -->
                <div style="flex: 1; min-width: 0;">
                  <div style="font-size: 16px; font-weight: 600; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; color: var(--text-high);">
                    @(item.Title ?? "Unknown")
                  </div>
                  <div style="font-size: 14px; color: var(--text-medium); white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">
                    @(item.Artist ?? "--")@if (item.DurationSeconds.HasValue) { <text> · @FormatDuration(item.DurationSeconds)</text> }
                  </div>
                  @if (!string.IsNullOrEmpty(item.SourceDetails) && item.SourceDetails != $"{item.Title} - {item.Artist}")
                  {
                    <div style="font-size: 12px; color: var(--text-low); white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">
                      @item.SourceDetails
                    </div>
                  }
                </div>
                <MudChip T="string" Size="Size.Small" Color="@GetSourceColor(item.Source)" Style="font-size: 13px;"
                         Icon="@SourceTypeHelper.GetIcon(item.Source)">
                  @item.Source
                </MudChip>
              </div>
            }
          </div>
        }
        else
        {
          <div style="flex: 1; display: flex; flex-direction: column; align-items: center; justify-content: center; color: var(--text-low);">
            <MudIcon Icon="@Icons.Material.Filled.History" Style="font-size: 80px; opacity: 0.4; margin-bottom: 12px;" />
            <span style="font-size: 16px;">No history yet</span>
          </div>
        }
      </div>
    </MudTabPanel>
  </MudTabs>
</div>

@code {
  private int _activeTab;
  private bool _userOverrodeTab;
  private List<QueueItemDto> _queueItems = new();
  private List<PlayHistoryEntryDto> _historyItems = new();
  private bool _isLoadingHistory;
  private int _playedCount;
  private CancellationTokenSource? _refreshCts;

  protected override async Task OnInitializedAsync()
  {
    HubService.QueueChanged += OnQueueChanged;
    HubService.SourceChanged += OnSourceChanged;

    await SetDefaultTabForSourceAsync();
    await RefreshQueueAsync();
    await RefreshHistoryAsync();
    StartPeriodicHistoryRefresh();
  }

  private void StartPeriodicHistoryRefresh()
  {
    _refreshCts = new CancellationTokenSource();
    _ = PeriodicHistoryRefreshAsync(_refreshCts.Token);
  }

  private async Task PeriodicHistoryRefreshAsync(CancellationToken ct)
  {
    using var timer = new PeriodicTimer(TimeSpan.FromSeconds(30));
    while (await timer.WaitForNextTickAsync(ct))
    {
      try
      {
        // Only refresh when History tab is active
        if (_activeTab == 1)
        {
          var result = await HistoryApi.GetHistoryAsync(limit: 50);
          _historyItems = result?.Items ?? new();
          await InvokeAsync(StateHasChanged);
        }
      }
      catch (OperationCanceledException) { break; }
      catch (Exception ex)
      {
        Logger.LogDebug(ex, "Periodic history refresh failed");
      }
    }
  }

  private async Task OnQueueChanged()
  {
    await RefreshQueueAsync();
    _ = ScheduleQueueSaveAsync();
    await InvokeAsync(StateHasChanged);
  }

  private async Task RefreshQueueAsync()
  {
    try
    {
      // Try full playlist first, fall back to regular queue
      var fullPlaylist = await QueueApi.GetFullPlaylistAsync();
      if (fullPlaylist != null)
      {
        _queueItems = fullPlaylist;
      }
      else
      {
        var queue = await QueueApi.GetQueueAsync();
        if (queue != null) _queueItems = queue;
      }

      _playedCount = _queueItems.Count(i => i.State == "Played");
    }
    catch (Exception ex)
    {
      Logger.LogWarning(ex, "Failed to refresh queue");
    }
  }

  private async Task RefreshHistoryAsync()
  {
    try
    {
      _isLoadingHistory = true;
      StateHasChanged();

      var result = await HistoryApi.GetHistoryAsync(limit: 50);
      _historyItems = result?.Items ?? new();
    }
    catch (Exception ex)
    {
      Logger.LogWarning(ex, "Failed to refresh history");
    }
    finally
    {
      _isLoadingHistory = false;
      StateHasChanged();
    }
  }

  private async Task HandleItemClickAsync(QueueItemDto item)
  {
    var state = item.State ?? "Upcoming";
    if (state == "Error") return; // Don't click error items

    try
    {
      await QueueApi.JumpToFullPlaylistPositionAsync(item.FullPlaylistIndex);
    }
    catch (Exception ex)
    {
      Logger.LogWarning(ex, "Failed to jump to playlist position");
    }
  }

  private async Task HandleRemoveAsync(int index)
  {
    try
    {
      var success = await QueueApi.RemoveFromQueueAsync(index);
      if (success) await RefreshQueueAsync();
    }
    catch (Exception ex) { Logger.LogWarning(ex, "Failed to remove queue item"); }
  }

  private async Task HandleClearQueueAsync()
  {
    try
    {
      var success = await QueueApi.ClearQueueAsync();
      if (success) _queueItems.Clear();
    }
    catch (Exception ex) { Logger.LogWarning(ex, "Failed to clear queue"); }
  }

  private async Task OpenSavePlaylistDialogAsync()
  {
    var options = new DialogOptions
    {
      CloseButton = true,
      MaxWidth = MaxWidth.Small,
      BackdropClick = true
    };
    await DialogService.ShowAsync<Radio.Web.Components.Dialogs.SavePlaylistDialog>("Save Playlist", options);
  }

  private async Task OpenLoadPlaylistDialogAsync()
  {
    var options = new DialogOptions
    {
      CloseButton = true,
      MaxWidth = MaxWidth.Small,
      BackdropClick = true
    };
    var dialog = await DialogService.ShowAsync<Radio.Web.Components.Dialogs.LoadPlaylistDialog>("Load Playlist", options);
    var result = await dialog.Result;
    if (result != null && !result.Canceled)
    {
      await RefreshQueueAsync();
      StateHasChanged();
    }
  }

  private async Task OpenFileSelectionDialogAsync()
  {
    var parameters = new DialogParameters
    {
      { "AllowMultiSelect", true },
      { "AllowAddToQueue", true },
      { "ShowPlayButton", true },
      { "OnAddToQueue", EventCallback.Factory.Create<List<string>>(this, HandleAddFilesToQueueAsync) }
    };
    var options = new DialogOptions
    {
      CloseButton = true,
      MaxWidth = MaxWidth.Medium,
      BackdropClick = true
    };

    var dialog = await DialogService.ShowAsync<Radio.Web.Components.Dialogs.FileBrowserDialog>("Add Files to Queue", parameters, options);
    var result = await dialog.Result;

    if (result != null && !result.Canceled)
    {
      if (result.Data is List<string> selectedPaths)
        await HandleAddFilesToQueueAsync(selectedPaths);
      else if (result.Data is string selectedPath)
        await HandleAddFilesToQueueAsync(new List<string> { selectedPath });
    }
  }

  private async Task HandleAddFilesToQueueAsync(List<string> filePaths)
  {
    if (filePaths == null || !filePaths.Any()) return;

    try
    {
      var (success, addedCount, error) = await FileApi.AddFilesToQueueAsync(filePaths);
      if (addedCount > 0)
      {
        Snackbar.Add($"{addedCount} file{(addedCount != 1 ? "s" : "")} added", Severity.Success);
        await RefreshQueueAsync();
      }
      if (!string.IsNullOrEmpty(error))
      {
        Snackbar.Add(error, Severity.Warning);
      }
      else if (!success)
      {
        Snackbar.Add("Failed to add files to queue", Severity.Error);
      }
    }
    catch (Exception ex)
    {
      Logger.LogError(ex, "Failed to add files to queue");
      Snackbar.Add("Error adding files to queue", Severity.Error);
    }
  }

  private async Task ScheduleQueueSaveAsync()
  {
    try
    {
      await Task.Delay(500);
      await QueuePersistence.SaveQueueStateAsync();
    }
    catch (Exception ex) { Logger.LogWarning(ex, "Failed to auto-save queue state"); }
  }

  private static string FormatDuration(int? seconds)
  {
    if (seconds == null || seconds <= 0) return "";
    var ts = TimeSpan.FromSeconds(seconds.Value);
    return ts.TotalHours >= 1
      ? ts.ToString(@"h\:mm\:ss")
      : ts.ToString(@"m\:ss");
  }

  private static Color GetSourceColor(string source)
  {
    return source switch
    {
      "File" => Color.Info,
      "Radio" => Color.Warning,
      "Bluetooth" => Color.Secondary,
      "Vinyl" => Color.Success,
      _ => Color.Default
    };
  }

  private void OnTabChanged(int newTab)
  {
    _activeTab = newTab;
    _userOverrodeTab = true;
  }

  private async Task OnSourceChanged()
  {
    _userOverrodeTab = false;
    await SetDefaultTabForSourceAsync();
    await RefreshQueueAsync();
    await InvokeAsync(StateHasChanged);
  }

  private async Task SetDefaultTabForSourceAsync()
  {
    if (_userOverrodeTab) return;
    try
    {
      var primary = await SourcesApi.GetPrimarySourceAsync();
      // Queue tab (0) for FilePlayer, History tab (1) for all others
      _activeTab = primary?.Type == "FilePlayer" ? 0 : 1;
    }
    catch
    {
      // Default to History if we can't determine the source
      _activeTab = 1;
    }
  }

  public async ValueTask DisposeAsync()
  {
    HubService.QueueChanged -= OnQueueChanged;
    HubService.SourceChanged -= OnSourceChanged;
    _refreshCts?.Cancel();
    _refreshCts?.Dispose();
    await Task.CompletedTask;
  }
}
