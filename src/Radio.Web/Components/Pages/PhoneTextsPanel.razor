@using Radio.Web.Models
@using Radio.Core.Utilities
@inject IJSRuntime JS
@inject NotificationService NotificationService

@* §Ph Texts surface (Screen C). One component, two render modes selected by host
   state:
     • thread list  — when no thread is open
       (loading skeleton / empty / error / loaded rows);
     • conversation — when OpenThreadId is set (bubbles + day separators + the
       reply-gate pill).
   This is a READ surface. Owner decision D31 (2026-09-05) settled that SMS
   sending stays off permanently, so PHN-4 deleted the composer, the
   new-recipient mode and the whole send path rather than leaving them disabled.
   The compose slot is kept and always holds the handoff's tier-3a pill
   ("Replies are turned off.") — an absent slot reads as a rendering bug, a
   stated one reads as an answer. Handoff §C4/C6. *@

@if (OpenThreadId != null)
{
  @* ── Conversation pane ──────────────────────────────────────── *@
  <div class="texts-conversation">
    <div class="texts-conv-header">
      <button type="button" class="phone-btn-sm btn-ghost"
              aria-label="Back to conversations" @onclick="OnBack">
        <RadzenIcon Icon="chevron_left" />
      </button>
      <div class="texts-conv-title">
        <span class="texts-conv-name">@HeaderName</span>
        <span class="texts-conv-number">@HeaderNumber</span>
      </div>
    </div>

    <div class="msg-list" aria-live="polite" @ref="_listEl">
      @* GV-8 / UAT F-1. BRANCH ORDER IS THE FIX: skeleton → error → empty → list. The
         error branch must precede the empty branch so "Start the conversation below."
         is reachable ONLY when the fetch genuinely succeeded and returned zero messages
         (UAT F-2). Same cloud_off + copy + Retry shape the thread list already uses at
         PhoneMessagesPanel.razor:110-117; copy string from
         HANDOFF-phone-dark-theme-and-scrollbars.md:310. *@
      @if (Messages == null && Loading)
      {
        @* .skeleton-loading is the shimmer primitive (animation: shimmer); the plain
           .skeleton wrapper is layout-only and never animates on its own. Canonical
           composition mirrors PhoneMessagesPanel.RenderCallSkeleton /
           Skeleton.razor's SkeletonShape.ListRow: a shimmering leading chip plus two
           shimmering text bars, not an empty static grey band. *@
        @for (var i = 0; i < 5; i++)
        {
          <div class="skeleton-list-row">
            <div class="skeleton-loading skeleton-feed-chip"></div>
            <div class="skeleton-list-row-text">
              <div class="skeleton-loading skeleton-text" style="width: 42%"></div>
              <div class="skeleton-loading skeleton-text" style="width: 26%"></div>
            </div>
          </div>
        }
      }
      else if (Error && Messages == null)
      {
        @* GV-8 M-1: content outranks a stale error flag — canonical shape is
           XError && X == null (PhoneMessagesPanel.razor:78/110). Without the
           Messages == null guard, a real inbound message arriving while
           _openThreadError is still set (PhonePage.OnGvSmsReceived can append to an
           open-but-failed thread) would stay hidden behind this branch until Retry
           or Back, even though Messages now has content to show. *@
        <div class="empty-state">
          <RadzenIcon Icon="cloud_off" class="empty-state-icon" />
          <div class="empty-state-text">Couldn't load messages.</div>
          <button type="button" class="phone-btn-sm" @onclick="OnRetry">Retry</button>
        </div>
      }
      else if (Messages != null && Messages.Count == 0)
      {
        @* Copy is state-neutral (handoff §C6, UAT F-2). It used to read "Start the
           conversation below." and point at a composer; PHN-4 deleted the composer,
           so the old string would name an affordance that is not there. *@
        <div class="empty-state">
          <RadzenIcon Icon="forum" class="empty-state-icon" />
          <div class="empty-state-text">No messages in this conversation.</div>
        </div>
      }
      else if (Messages != null)
      {
        DateTime? lastDay = null;
        @foreach (var m in Ordered(Messages))
        {
          var day = m.SentAt.ToLocalTime().Date;
          if (lastDay != day)
          {
            lastDay = day;
            <div class="msg-day-sep">@DaySeparator(day)</div>
          }
          var captured = m;
          @* Status/OnRetry are deliberately not passed. They described a send this
             console originated, and PHN-4 removed the only path that could start
             one; MessageBubble keeps the parameters (and defaults Status to None)
             because outbound bubbles still render for messages sent from the
             phone itself. *@
          @* PHN-3: SenderName is the thread's RESOLVED name or null — never an identifier
             (SpeakableSenderName below). OnSpeakFailed is the §Cross-5 toast, which the
             panel owns because a bubble has no room beside it.

             ⚠⚠ @key IS LOAD-BEARING SINCE PHN-3 AND WAS NOT BEFORE IT. MessageBubble used
             to be a pure function of its parameters, so Blazor's positional child
             matching was harmless. It now carries identity-bearing state (_playbackId),
             and this list is not append-only: PhonePage appends an inbound arrival,
             Ordered() re-sorts by SentAt so an out-of-order GV delivery lands MID-LIST,
             and PhonePage replaces the list wholesale on refresh. Without the key, any
             of those re-parameterises existing instances and the cyan `speaking` marks
             and the Stop affordance land on the WRONG bubble while the console reads the
             original — the exact thing the mark exists to answer. *@
          <MessageBubble @key="captured.Id"
                         Message="captured"
                         SenderName="@SpeakableSenderName"
                         OnSpeakFailed="OnSpeakFailed" />
        }
      }
    </div>

    @* Reply gate, handoff §C4 tier 3a. This is the resting state and the only
       state: D31 turned replies off permanently, so the pill is unconditional
       rather than one branch of a flag test. It deliberately does NOT fall back
       to the tier-3c "Texting unavailable" pill when Google Voice is
       reconnecting — that string would imply replies resume on reconnect, which
       under D31 is false. The slot is never hidden (§C4). *@
    <div class="texts-compose">
      <span class="phone-pill amber">Replies are turned off.</span>
    </div>
  </div>
}
else
{
  @* ── Thread list (feed pane) ────────────────────────────────── *@
  <div class="texts-thread-list">
    @if (Threads == null && Loading)
    {
      @* Same fix as the conversation-mode branch above: .skeleton-loading is the
         shimmer primitive, .skeleton alone is inert. Dead in production today (this
         panel is only ever hosted in conversation mode) but kept in sync so it isn't
         the next thing someone copies. *@
      @for (var i = 0; i < 6; i++)
      {
        <div class="skeleton-list-row">
          <div class="skeleton-loading skeleton-feed-chip"></div>
          <div class="skeleton-list-row-text">
            <div class="skeleton-loading skeleton-text" style="width: 42%"></div>
            <div class="skeleton-loading skeleton-text" style="width: 26%"></div>
          </div>
        </div>
      }
    }
    @* GV-9: content outranks a stale error flag — the canonical shape on this
       surface is XError && X == null (PhoneMessagesPanel.razor:78 voicemail,
       :110 threads), and GV-8's M-1 shipped exactly this one branch in
       conversation mode at :59. The thread list was the hold-out. Without the
       Threads == null guard a stale Error would outrank rows that had actually
       arrived — the same lie GV-8 removed, one level up.
       Dead in production today (this panel is only ever hosted in conversation
       mode, PhoneMessagesPanel.razor:180/185), fixed under the file's own
       stated policy for this branch at :139-141. *@
    else if (Error && Threads == null)
    {
      <div class="empty-state">
        <RadzenIcon Icon="cloud_off" class="empty-state-icon" />
        <div class="empty-state-text">Couldn't load conversations.</div>
        <button type="button" class="phone-btn-sm" @onclick="OnRetry">Retry</button>
      </div>
    }
    else if (Threads == null || Threads.Count == 0)
    {
      @* No "New message" affordance: PHN-4 removed new-recipient mode, so the
         console can only ever reply into a thread somebody else started. *@
      <div class="empty-state">
        <RadzenIcon Icon="forum" class="empty-state-icon" />
        <div class="empty-state-text">No conversations yet.</div>
      </div>
    }
    else
    {
      @foreach (var thread in Threads.OrderByDescending(t => t.LastMessageAt))
      {
        var captured = thread;
        <button type="button"
                class="list-item-touch @(captured.ThreadId == SelectedThreadId ? "list-item-active" : "")"
                @onclick="@(() => OnOpenThread.InvokeAsync(captured.ThreadId))">
          @* GV-9: dot AFTER the chip, matching both live sites
             (PhoneMessagesPanel.razor:660-663, VoicemailRow.razor:8-11) — it used to
             precede the chip here, which is a third layout for the same row. Dead in
             production (this panel is only ever hosted in conversation mode) but kept
             in sync so it isn't the next thing someone copies. *@
          <span class="phone-pill cyan" aria-hidden="true">
            <RadzenIcon Icon="chat_bubble" />
          </span>
          @if (captured.HasUnread)
          {
            <span class="unread-dot" aria-hidden="true"></span>
          }
          @* GV-9: .list-item-identity replaces an inline style that duplicated it
             verbatim (design-system.css:5838, which also adds gap: 1px). The class is
             load-bearing, not tidying: the F-7 gutter rule selects the identity column
             by class, and an unclassed div is unreachable by any selector. *@
          <div class="list-item-identity">
            <span class="list-item-title">@ResolveThreadName(captured)</span>
            <span class="list-item-subtitle">@PreviewText(captured)</span>
          </div>
          <span class="list-item-meta">@captured.LastMessageAt.ToLocalTime().ToString("g")</span>
          <RadzenIcon Icon="chevron_right" Style="color: var(--text-low);" />
        </button>
      }
    }
  </div>
}

@code {
  // ── Thread-list inputs (hosted in the feed pane) ──────────────
  // GV-8: Loading / Error / OnRetry are MODE-SCOPED, not list-scoped. One instance
  // renders exactly one mode (conversation | thread list), so they describe
  // whichever fetch that mode is showing — the OPEN CONVERSATION's fetch when
  // OpenThreadId is set, the thread list's otherwise. PhoneMessagesPanel hosts the
  // conversation mode only and forwards its OpenThreadLoading / OpenThreadError /
  // OnRetryOpenThread into these three.
  [Parameter] public List<SmsThreadDto>? Threads { get; set; }
  [Parameter] public bool Loading { get; set; }
  [Parameter] public bool Error { get; set; }
  [Parameter] public List<MergedContact> Contacts { get; set; } = [];
  [Parameter] public string? SelectedThreadId { get; set; }
  [Parameter] public EventCallback OnRetry { get; set; }
  [Parameter] public EventCallback<string> OnOpenThread { get; set; }

  // ── Conversation inputs (hosted in the detail pane) ───────────
  [Parameter] public string? OpenThreadId { get; set; }
  [Parameter] public List<SmsMessageDto>? Messages { get; set; }
  [Parameter] public string? HeaderName { get; set; }
  [Parameter] public string? HeaderNumber { get; set; }
  [Parameter] public EventCallback OnBack { get; set; }

  private ElementReference _listEl;
  private string? _lastScrolledThread;

  private static IEnumerable<SmsMessageDto> Ordered(List<SmsMessageDto> m) =>
    m.OrderBy(x => x.SentAt);

  protected override async Task OnAfterRenderAsync(bool firstRender)
  {
    // Auto-scroll to the newest bubble when a conversation first opens (and when
    // the open thread changes). Inbound arrivals into an already-open thread are
    // appended by the parent and are not scrolled here.
    if (OpenThreadId != null && _lastScrolledThread != OpenThreadId
        && Messages is { Count: > 0 })
    {
      _lastScrolledThread = OpenThreadId;
      await ScrollToBottomAsync();
    }
  }

  private async Task ScrollToBottomAsync()
  {
    try { await JS.InvokeVoidAsync("phoneScrollToBottom", _listEl); } catch { /* non-fatal */ }
  }

  // Display-name precedence mirrors PhoneMessagesPanel.ResolveName: a name GV
  // already attached (CounterpartyName) → a normalized contact match → the number.
  private string ResolveThreadName(SmsThreadDto t)
  {
    if (!string.IsNullOrWhiteSpace(t.CounterpartyName))
    {
      return t.CounterpartyName!;
    }
    var key = PhoneNumberNormalizer.Normalize(t.CounterpartyNumber);
    if (key.Length > 0)
    {
      var match = Contacts.FirstOrDefault(c =>
        PhoneNumberNormalizer.Normalize(c.Phone) == key);
      if (match != null)
      {
        return match.Name;
      }
    }
    return t.CounterpartyNumber;
  }

  // ── PHN-3: what the console is allowed to say the message is FROM ────────────

  /// <summary>
  /// The resolved contact name for this thread, or null when only an identifier is known.
  /// </summary>
  /// <remarks>
  /// ⚠ NULL RATHER THAN THE NAME PARAMETER AS-IS, and that is the whole reason this is not just
  /// HeaderName. PhoneMessagesPanel.OpenThreadName (:321-337) is what feeds HeaderName, and it
  /// falls back TWICE: to the bare CounterpartyNumber (:335) when no contact matches, and to the
  /// raw thread id (:326) when the open thread is not in Threads at all. Handoff :386 says "Do not
  /// read the identifier aloud", and 14 of the 20 live threads have no resolvable name — so this is
  /// the COMMON case, not an edge. Either identifier leaking through here would be read out to the
  /// room. See plan PHN-3 C-108.
  ///
  /// ⚠ THE SECOND CLAUSE IS NOT BELT-AND-BRACES. HeaderNumber is OpenThreadNumber (:339), which is
  /// "" when the thread is missing — exactly the case where HeaderName holds the thread id. An
  /// equality test alone answers false there and speaks the id.
  ///
  /// ⚠⚠ THE THIRD CLAUSE COMPARES NORMALISED DIGITS, NOT STRINGS, AND A STRING COMPARE WAS NOT
  /// ENOUGH. OpenThreadName returns CounterpartyName (:327) and a contact's match.Name (:333)
  /// VERBATIM, and neither is guaranteed non-numeric. A CounterpartyName of "(555) 123-4567"
  /// against a CounterpartyNumber of "+15551234567" makes `==` answer false, the guard passes, and
  /// the console reads a phone number to the room — the highest-consequence outcome in this row
  /// (handoff :386). PhoneNumberNormalizer.Normalize keeps ASCII digits only and drops the leading
  /// "1" of an 11-digit US number, so both of those reduce to "5551234567" and compare equal.
  ///
  /// ⚠ The digit-length test in front of it is what keeps this STRICTLY stronger than the old `==`
  /// rather than merely different. Normalize("Mom") is "", and so is Normalize of any name with no
  /// ASCII digits in it — so without `nameDigits.Length > 0` an ordinary name would compare equal
  /// to any HeaderNumber that also normalises to "" and be suppressed. The literal `==` is kept
  /// alongside it for the non-numeric identical case ("unknown" / "unknown"), which digits cannot
  /// see.
  ///
  /// ⛔ Do NOT route this through ResolveThreadName. Since PHN-4 its signature is
  /// ResolveThreadName(SmsThreadDto) and its only caller is the thread-list branch; conversation
  /// mode holds no SmsThreadDto for the open thread, and reconstructing one would duplicate
  /// PhoneMessagesPanel.OpenThreadData and give the name two resolution paths that can disagree.
  /// </remarks>
  private string? SpeakableSenderName
  {
    get
    {
      var name = HeaderName;
      if (string.IsNullOrWhiteSpace(name))
      {
        return null;
      }

      // No number resolved => the thread itself did not resolve, so HeaderName is an identifier.
      if (string.IsNullOrWhiteSpace(HeaderNumber))
      {
        return null;
      }

      // The same number written two ways is still the number. See the remarks above.
      var nameDigits = PhoneNumberNormalizer.Normalize(name!);
      if (nameDigits.Length > 0
          && nameDigits == PhoneNumberNormalizer.Normalize(HeaderNumber!))
      {
        return null;
      }

      return name == HeaderNumber ? null : name;
    }
  }

  /// <summary>Handoff §Cross-5 :174 — a synthesis failure is a TOAST, not an inline state.</summary>
  /// <remarks>
  /// ⚠ Warning, not Error: the message is still on screen and still readable by eye — nothing was
  /// lost, one affordance did not work. PhonePage.razor uses the same severity for the same shape of
  /// failure ("Couldn't refresh" / "Showing the last update").
  ///
  /// ⚠ NEVER put the message body, the sender or the number in a toast argument. Radzen toasts are
  /// rendered on the kiosk in a family room and this row's whole subject matter is private SMS
  /// content. The reason code is all that crosses this boundary, and it is mapped to fixed copy
  /// rather than shown. Same instruction as EventPlaybackApiService.StartSpeechAsync's "never log
  /// text".
  ///
  /// ⚠ "Transport", not "Unreachable" — that is the token StartSpeechAsync actually returns, matching
  /// StartVoicemailAsync. The plan's Task 4c sketch said "Unreachable"; see that method's remarks.
  /// TextTooLong should be unreachable (GvSpeechText caps at the same number) and is a backstop for a
  /// server configured below the client's cap (plan C-106).
  ///
  /// ⚠ Notify returns void and nothing here is awaited: a toast must not delay the button returning
  /// to rest. The name says so — it was OnSpeakFailedAsync, which promised a Task this method has
  /// never returned, and MessageBubble's own doc comment already called it OnSpeakFailed.
  ///
  /// ⚠ Reached by TWO arms of §B4's Engine-error row, not one: MessageBubble raises it for a
  /// synchronous refusal (400) and again for an asynchronous Failed broadcast, which is the common
  /// case. The "_ =>" default already produces the handoff's exact copy for SpeechSynthesisFailed,
  /// so the second arm needed no new switch case.
  /// </remarks>
  private void OnSpeakFailed(string? reason) => NotificationService.Notify(
    NotificationSeverity.Warning,
    "Couldn't read that message.",
    reason switch
    {
      "TextTooLong" => "That message is too long for the console to read.",
      "Transport" => "The console isn't responding. Try again.",
      _ => "The console couldn't read this one. Try again."
    });

  private static string PreviewText(SmsThreadDto t) =>
    string.IsNullOrEmpty(t.LastMessagePreview) ? "" : t.LastMessagePreview!;

  private static string DaySeparator(DateTime day)
  {
    var today = DateTime.Now.Date;
    if (day == today) return "Today";
    if (day == today.AddDays(-1)) return "Yesterday";
    return day.Year == today.Year ? day.ToString("MMM d") : day.ToString("MMM d, yyyy");
  }
}
