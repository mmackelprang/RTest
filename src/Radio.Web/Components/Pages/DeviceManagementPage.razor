@page "/devices"
@using Radio.Web.Services
@using Radio.Web.Services.ApiClients
@using Radio.Web.Models
@inject DevicesApiService DevicesApi
@inject DeviceDisplayStateService DisplayState
@inject ISnackbar Snackbar
@inject ILogger<DeviceManagementPage> Logger

<PageTitle>Device Management - Radio Console</PageTitle>

<div style="height: 100%; display: flex; overflow: hidden;">
  <MudTabs Elevation="0" Rounded="false" Position="Position.Start" ApplyEffectsToContainer="true"
           PanelClass="pa-4" Style="height: 100%; width: 100%;" Class="system-config-tabs">

    @* Display Settings Tab *@
    <MudTabPanel Text="Display" Icon="@Icons.Material.Filled.Visibility">
      <MudStack Spacing="2">
        <div class="d-flex justify-space-between align-center">
          <MudText Typo="Typo.h6">Device Display Settings</MudText>
          <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small"
                     OnClick="RefreshDevicesAsync" StartIcon="@Icons.Material.Filled.Refresh">Refresh</MudButton>
        </div>
        <MudText Typo="Typo.body2" Color="Color.Secondary">
          Control which output devices appear in the taskbar and set friendly names.
        </MudText>

        @if (isLoadingDisplay)
        {
          <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
        }
        else if (displaySettings == null || !displaySettings.Any())
        {
          <MudAlert Severity="Severity.Info">No devices found. Click Refresh to scan for devices.</MudAlert>
        }
        else
        {
          <MudTable Items="@displaySettings" Hover="true" Striped="true" Dense="true">
            <HeaderContent>
              <MudTh>Visible</MudTh>
              <MudTh>Type</MudTh>
              <MudTh>Device Name</MudTh>
              <MudTh>Friendly Name</MudTh>
              <MudTh Style="width: 50px"></MudTh>
            </HeaderContent>
            <RowTemplate>
              <MudTd DataLabel="Visible">
                <MudIconButton Icon="@(context.IsHidden ? Icons.Material.Filled.VisibilityOff : Icons.Material.Filled.Visibility)"
                               Color="@(context.IsHidden ? Color.Default : Color.Success)"
                               Size="Size.Small"
                               title="@(context.IsHidden ? "Hidden — click to show" : "Visible — click to hide")"
                               OnClick="@(() => ToggleDeviceVisibilityAsync(context))" />
              </MudTd>
              <MudTd DataLabel="Type">
                <MudChip T="string" Size="Size.Small"
                         Color="@(context.Type == "Output" ? Color.Info : Color.Success)"
                         Icon="@(context.Type == "Output" ? Icons.Material.Filled.VolumeUp : Icons.Material.Filled.Mic)">
                  @context.Type
                </MudChip>
              </MudTd>
              <MudTd DataLabel="Device Name">
                <MudText Style="@(context.IsHidden ? "text-decoration: line-through; opacity: 0.5;" : "")">
                  @context.RawName
                </MudText>
              </MudTd>
              <MudTd DataLabel="Friendly Name">
                <MudTextField T="string"
                              Value="@(GetFriendlyNameEditValue(context))"
                              ValueChanged="@(val => OnFriendlyNameChanged(context, val))"
                              Variant="Variant.Outlined"
                              Margin="Margin.Dense"
                              InputMode="InputMode.text"
                              Placeholder="@context.DisplayName"
                              Disabled="@context.IsHidden"
                              Immediate="false"
                              Style="@(context.IsHidden ? "opacity: 0.5;" : "")" />
              </MudTd>
              <MudTd>
                @if (!string.IsNullOrEmpty(context.FriendlyNameOverride))
                {
                  <MudIconButton Icon="@Icons.Material.Filled.Clear"
                                 Color="Color.Default"
                                 Size="Size.Small"
                                 title="Clear friendly name"
                                 OnClick="@(() => ClearFriendlyNameAsync(context))" />
                }
              </MudTd>
            </RowTemplate>
          </MudTable>
        }
      </MudStack>
    </MudTabPanel>

    @* Output Devices Tab *@
    <MudTabPanel Text="Outputs" Icon="@Icons.Material.Filled.SpeakerGroup">
      <MudStack Spacing="2">
        <MudText Typo="Typo.h6">Output Devices</MudText>
        
        @if (isLoadingOutput)
        {
          <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
        }
        else if (outputDevices == null || !outputDevices.Any())
        {
          <MudAlert Severity="Severity.Info">No output devices found. Click Refresh to scan for devices.</MudAlert>
        }
        else
        {
          <MudTable Items="@outputDevices" Hover="true" Striped="true" Dense="true">
            <HeaderContent>
              <MudTh>Name</MudTh>
              <MudTh>Type</MudTh>
              <MudTh>Status</MudTh>
              <MudTh>Actions</MudTh>
            </HeaderContent>
            <RowTemplate>
              <MudTd DataLabel="Name">
                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                  @if (context.IsDefault)
                  {
                    <MudIcon Icon="@Icons.Material.Filled.Star" Color="Color.Primary" Size="Size.Small" title="Default Device" />
                  }
                  <MudText>@context.Name</MudText>
                </MudStack>
              </MudTd>
              <MudTd DataLabel="Type">@context.Type</MudTd>
              <MudTd DataLabel="Status">
                @if (context.IsActive)
                {
                  <MudChip T="string" Size="Size.Small" Color="Color.Success" Icon="@Icons.Material.Filled.CheckCircle">Active</MudChip>
                }
                else if (context.IsDefault)
                {
                  <MudChip T="string" Size="Size.Small" Color="Color.Primary" Icon="@Icons.Material.Filled.Star">Default</MudChip>
                }
                else
                {
                  <MudChip T="string" Size="Size.Small" Color="Color.Default" Icon="@Icons.Material.Filled.Circle">Available</MudChip>
                }
              </MudTd>
              <MudTd DataLabel="Actions">
                @if (!context.IsDefault)
                {
                  <MudButton Variant="Variant.Text" Color="Color.Primary" Size="Size.Small"
                             OnClick="@(() => SetDefaultOutputAsync(context.Id))">
                    Set as Default
                  </MudButton>
                }
              </MudTd>
            </RowTemplate>
          </MudTable>
        }
      </MudStack>
    </MudTabPanel>

    @* Google Cast Devices Tab *@
    <MudTabPanel Text="Cast" Icon="@Icons.Material.Filled.Cast">
      <MudStack Spacing="2">
        <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
          <MudText Typo="Typo.h6">Google Cast Devices</MudText>
          <MudButton Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Small"
                     OnClick="ScanForCastDevicesAsync" StartIcon="@Icons.Material.Filled.Search"
                     Disabled="@isDiscoveringCast">
            @if (isDiscoveringCast)
            {
              <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
              <span>Scanning...</span>
            }
            else
            {
              <span>Scan for New Devices</span>
            }
          </MudButton>
        </MudStack>

        @if (isLoadingCast)
        {
          <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
        }
        else if (castDevices == null || !castDevices.Any())
        {
          <MudAlert Severity="Severity.Info">No cached Cast devices. Click "Scan for New Devices" to discover devices on your network.</MudAlert>
        }
        else
        {
          <MudTable Items="@castDevices" Hover="true" Striped="true" Dense="true">
            <HeaderContent>
              <MudTh>Name</MudTh>
              <MudTh>IP Address</MudTh>
              <MudTh>Model</MudTh>
              <MudTh>Default</MudTh>
              <MudTh>Actions</MudTh>
            </HeaderContent>
            <RowTemplate>
              <MudTd DataLabel="Name">
                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                  <MudIcon Icon="@Icons.Material.Filled.Cast" Size="Size.Small" />
                  <MudText>@context.Name</MudText>
                </MudStack>
              </MudTd>
              <MudTd DataLabel="IP Address">@context.IpAddress:@context.Port</MudTd>
              <MudTd DataLabel="Model">@context.Model</MudTd>
              <MudTd DataLabel="Default">
                @if (defaultCastDeviceId == context.Id)
                {
                  <MudIcon Icon="@Icons.Material.Filled.Star" Color="Color.Warning" Size="Size.Small" title="Default Device" />
                }
              </MudTd>
              <MudTd DataLabel="Actions">
                <MudStack Row="true" Spacing="1">
                  <MudButton Variant="Variant.Text" Color="Color.Primary" Size="Size.Small"
                             OnClick="@(() => ConnectCastDeviceAsync(context))"
                             Disabled="@connectingCastDeviceId.Equals(context.Id)">
                    @if (connectingCastDeviceId == context.Id)
                    {
                      <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-1" />
                      <span>Connecting</span>
                    }
                    else
                    {
                      <span>Connect</span>
                    }
                  </MudButton>
                  @if (defaultCastDeviceId != context.Id)
                  {
                    <MudButton Variant="Variant.Text" Color="Color.Secondary" Size="Size.Small"
                               OnClick="@(() => SetDefaultCastDeviceAsync(context))">
                      Set Default
                    </MudButton>
                  }
                  else
                  {
                    <MudButton Variant="Variant.Text" Color="Color.Default" Size="Size.Small"
                               OnClick="ClearDefaultCastDeviceAsync">
                      Clear Default
                    </MudButton>
                  }
                </MudStack>
              </MudTd>
            </RowTemplate>
          </MudTable>
        }
      </MudStack>
    </MudTabPanel>

    @* Input Devices Tab *@
    <MudTabPanel Text="Inputs" Icon="@Icons.Material.Filled.Mic">
      <MudStack Spacing="2">
        <MudText Typo="Typo.h6">Input Devices</MudText>
        
        @if (isLoadingInput)
        {
          <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
        }
        else if (inputDevices == null || !inputDevices.Any())
        {
          <MudAlert Severity="Severity.Info">No input devices found. Click Refresh to scan for devices.</MudAlert>
        }
        else
        {
          <MudTable Items="@inputDevices" Hover="true" Striped="true" Dense="true">
            <HeaderContent>
              <MudTh>Name</MudTh>
              <MudTh>Type</MudTh>
              <MudTh>Status</MudTh>
              <MudTh>Actions</MudTh>
            </HeaderContent>
            <RowTemplate>
              <MudTd DataLabel="Name">
                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                  @if (context.IsDefault)
                  {
                    <MudIcon Icon="@Icons.Material.Filled.Star" Color="Color.Primary" Size="Size.Small" title="Default Device" />
                  }
                  <MudText>@context.Name</MudText>
                </MudStack>
              </MudTd>
              <MudTd DataLabel="Type">@context.Type</MudTd>
              <MudTd DataLabel="Status">
                @if (context.IsActive)
                {
                  <MudChip T="string" Size="Size.Small" Color="Color.Success" Icon="@Icons.Material.Filled.CheckCircle">Active</MudChip>
                }
                else if (context.IsDefault)
                {
                  <MudChip T="string" Size="Size.Small" Color="Color.Primary" Icon="@Icons.Material.Filled.Star">Default</MudChip>
                }
                else
                {
                  <MudChip T="string" Size="Size.Small" Color="Color.Default" Icon="@Icons.Material.Filled.Circle">Available</MudChip>
                }
              </MudTd>
              <MudTd DataLabel="Actions">
                @if (!context.IsActive)
                {
                  <MudButton Variant="Variant.Text" Color="Color.Primary" Size="Size.Small"
                             OnClick="@(() => SetDefaultInputAsync(context.Id))">
                    Set as Default
                  </MudButton>
                }
              </MudTd>
            </RowTemplate>
          </MudTable>
        }
      </MudStack>
    </MudTabPanel>

    @* USB Port Reservations Tab *@
    <MudTabPanel Text="USB Ports" Icon="@Icons.Material.Filled.Usb">
      <MudStack Spacing="2">
        <MudText Typo="Typo.h6">USB Port Reservations</MudText>
        
        @if (isLoadingUsb)
        {
          <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
        }
        else if (usbPorts == null || !usbPorts.Any())
        {
          <MudAlert Severity="Severity.Info">No USB port reservations found.</MudAlert>
        }
        else
        {
          <MudTable Items="@usbPorts" Hover="true" Striped="true" Dense="true">
            <HeaderContent>
              <MudTh>Port ID</MudTh>
              <MudTh>Port Name</MudTh>
              <MudTh>Reserved</MudTh>
              <MudTh>Reserved By</MudTh>
            </HeaderContent>
            <RowTemplate>
              <MudTd DataLabel="Port ID">@context.Id</MudTd>
              <MudTd DataLabel="Port Name">@context.Name</MudTd>
              <MudTd DataLabel="Reserved">
                @if (context.IsReserved)
                {
                  <MudChip T="string" Size="Size.Small" Color="Color.Warning">Reserved</MudChip>
                }
                else
                {
                  <MudChip T="string" Size="Size.Small" Color="Color.Success" Icon="@Icons.Material.Filled.CheckCircle">Available</MudChip>
                }
              </MudTd>
              <MudTd DataLabel="Reserved By">@(context.ReservedBy ?? "-")</MudTd>
            </RowTemplate>
          </MudTable>
        }
      </MudStack>
    </MudTabPanel>

  </MudTabs>
</div>

@code {
  private List<AudioDeviceDto>? outputDevices;
  private List<AudioDeviceDto>? inputDevices;
  private List<UsbPortDto>? usbPorts;
  private List<CastDeviceDto>? castDevices;
  private List<DeviceDisplayInfoDto>? displaySettings;

  private bool isLoadingOutput = false;
  private bool isLoadingInput = false;
  private bool isLoadingUsb = false;
  private bool isLoadingCast = false;
  private bool isLoadingDisplay = false;
  private bool isDiscoveringCast = false;
  private string connectingCastDeviceId = "";
  private string defaultCastDeviceId = "";

  protected override async Task OnInitializedAsync()
  {
    await LoadAllDevicesAsync();

    // Auto-start mDNS discovery in the background to refresh cached devices
    _ = BackgroundDiscoverCastDevicesAsync();
  }

  private async Task LoadAllDevicesAsync()
  {
    try
    {
      // Set all loading flags
      isLoadingOutput = true;
      isLoadingInput = true;
      isLoadingUsb = true;
      isLoadingCast = true;
      isLoadingDisplay = true;
      StateHasChanged();

      // Load all devices in parallel for better performance
      var outputTask = DevicesApi.GetOutputDevicesAsync();
      var inputTask = DevicesApi.GetInputDevicesAsync();
      var usbTask = DevicesApi.GetUsbPortsAsync();
      var castTask = DevicesApi.GetCachedCastDevicesAsync();
      var defaultCastTask = DevicesApi.GetDefaultCastDeviceAsync();
      var displayTask = DevicesApi.GetDeviceDisplaySettingsAsync();

      await Task.WhenAll(outputTask, inputTask, usbTask, castTask, defaultCastTask, displayTask);

      // Assign results
      outputDevices = await outputTask;
      inputDevices = await inputTask;
      usbPorts = await usbTask;
      castDevices = await castTask;
      displaySettings = await displayTask;
      var defaultCast = await defaultCastTask;
      defaultCastDeviceId = defaultCast?.Id ?? "";

      // Clear loading flags
      isLoadingOutput = false;
      isLoadingInput = false;
      isLoadingUsb = false;
      isLoadingCast = false;
      isLoadingDisplay = false;


      StateHasChanged();

      Logger.LogInformation("Loaded all devices successfully");
    }
    catch (Exception ex)
    {
      Logger.LogError(ex, "Error loading devices");
      Snackbar.Add("Error loading devices", Severity.Error);
      isLoadingOutput = false;
      isLoadingInput = false;
      isLoadingUsb = false;
      isLoadingCast = false;
      isLoadingDisplay = false;
      StateHasChanged();
    }
  }

  private async Task RefreshDevicesAsync()
  {
    try
    {
      Logger.LogInformation("Refreshing devices...");
      
      var success = await DevicesApi.RefreshDevicesAsync();
      
      if (success)
      {
        Snackbar.Add("Devices refreshed successfully", Severity.Success);
        
        // Reload all devices
        await LoadAllDevicesAsync();
      }
      else
      {
        Snackbar.Add("Failed to refresh devices", Severity.Warning);
      }
    }
    catch (Exception ex)
    {
      Logger.LogError(ex, "Error refreshing devices");
      Snackbar.Add("Error refreshing devices", Severity.Error);
    }
  }

  private async Task SetDefaultInputAsync(string deviceId)
  {
    try
    {
      Logger.LogInformation("Setting default input device: {DeviceId}", deviceId);
      var success = await DevicesApi.SetInputDeviceAsync(deviceId);
      if (success)
      {
        Snackbar.Add("Default input device updated", Severity.Success);
        isLoadingInput = true;
        StateHasChanged();
        inputDevices = await DevicesApi.GetInputDevicesAsync();
        isLoadingInput = false;
        StateHasChanged();
      }
      else
      {
        Snackbar.Add("Failed to set default input device", Severity.Warning);
      }
    }
    catch (Exception ex)
    {
      Logger.LogError(ex, "Error setting default input device");
      Snackbar.Add("Error setting default input device", Severity.Error);
      isLoadingInput = false;
      StateHasChanged();
    }
  }

  private async Task SetDefaultOutputAsync(string deviceId)
  {
    try
    {
      Logger.LogInformation("Setting default output device: {DeviceId}", deviceId);

      var success = await DevicesApi.SetOutputDeviceAsync(deviceId);

      if (success)
      {
        Snackbar.Add("Default output device updated", Severity.Success);

        // Reload output devices to reflect the change
        isLoadingOutput = true;
        StateHasChanged();
        outputDevices = await DevicesApi.GetOutputDevicesAsync();
        isLoadingOutput = false;
        StateHasChanged();
      }
      else
      {
        Snackbar.Add("Failed to set default output device", Severity.Warning);
      }
    }
    catch (Exception ex)
    {
      Logger.LogError(ex, "Error setting default output device");
      Snackbar.Add("Error setting default output device", Severity.Error);
      isLoadingOutput = false;
      StateHasChanged();
    }
  }

  /// <summary>
  /// Runs mDNS discovery in the background on page load.
  /// Updates the Cast device list when complete without blocking the UI.
  /// </summary>
  private async Task BackgroundDiscoverCastDevicesAsync()
  {
    try
    {
      isDiscoveringCast = true;
      await InvokeAsync(StateHasChanged);

      var devices = await DevicesApi.DiscoverCastDevicesAsync();

      if (devices != null)
      {
        castDevices = devices;
        Logger.LogInformation("Background Cast discovery found {Count} device(s)", devices.Count);
      }
    }
    catch (Exception ex)
    {
      Logger.LogWarning(ex, "Background Cast device discovery failed");
    }
    finally
    {
      isDiscoveringCast = false;
      await InvokeAsync(StateHasChanged);
    }
  }

  private async Task ScanForCastDevicesAsync()
  {
    try
    {
      isDiscoveringCast = true;
      StateHasChanged();

      Logger.LogInformation("Scanning for Cast devices (mDNS discovery)...");
      var devices = await DevicesApi.DiscoverCastDevicesAsync();

      if (devices != null)
      {
        castDevices = devices;
        Snackbar.Add($"Found {devices.Count} Cast device(s)", Severity.Success);
      }
      else
      {
        Snackbar.Add("Cast device scan failed", Severity.Warning);
      }
    }
    catch (Exception ex)
    {
      Logger.LogError(ex, "Error scanning for Cast devices");
      Snackbar.Add("Error scanning for Cast devices", Severity.Error);
    }
    finally
    {
      isDiscoveringCast = false;
      StateHasChanged();
    }
  }

  private async Task ConnectCastDeviceAsync(CastDeviceDto device)
  {
    try
    {
      connectingCastDeviceId = device.Id;
      StateHasChanged();

      Logger.LogInformation("Connecting to Cast device: {Name}", device.Name);
      var success = await DevicesApi.ConnectToCastDeviceAsync(device);

      if (success)
      {
        Snackbar.Add($"Connected to {device.Name}", Severity.Success);
        defaultCastDeviceId = device.Id;

        // Refresh output devices to reflect updated Cast name
        outputDevices = await DevicesApi.GetOutputDevicesAsync();
      }
      else
      {
        Snackbar.Add($"Failed to connect to {device.Name}", Severity.Warning);
      }
    }
    catch (Exception ex)
    {
      Logger.LogError(ex, "Error connecting to Cast device: {Name}", device.Name);
      Snackbar.Add($"Error connecting to {device.Name}", Severity.Error);
    }
    finally
    {
      connectingCastDeviceId = "";
      StateHasChanged();
    }
  }

  private async Task SetDefaultCastDeviceAsync(CastDeviceDto device)
  {
    try
    {
      var success = await DevicesApi.SetDefaultCastDeviceAsync(device);
      if (success)
      {
        defaultCastDeviceId = device.Id;
        Snackbar.Add($"Default Cast device set to {device.Name}", Severity.Success);

        // Refresh output devices to reflect updated Cast name
        outputDevices = await DevicesApi.GetOutputDevicesAsync();
        StateHasChanged();
      }
      else
      {
        Snackbar.Add("Failed to set default Cast device", Severity.Warning);
      }
    }
    catch (Exception ex)
    {
      Logger.LogError(ex, "Error setting default Cast device");
      Snackbar.Add("Error setting default Cast device", Severity.Error);
    }
  }

  private async Task ClearDefaultCastDeviceAsync()
  {
    try
    {
      var success = await DevicesApi.ClearDefaultCastDeviceAsync();
      if (success)
      {
        defaultCastDeviceId = "";
        Snackbar.Add("Default Cast device cleared", Severity.Success);

        // Refresh output devices to reflect reverted Cast name
        outputDevices = await DevicesApi.GetOutputDevicesAsync();
        StateHasChanged();
      }
      else
      {
        Snackbar.Add("Failed to clear default Cast device", Severity.Warning);
      }
    }
    catch (Exception ex)
    {
      Logger.LogError(ex, "Error clearing default Cast device");
      Snackbar.Add("Error clearing default Cast device", Severity.Error);
    }
  }

  private string GetFriendlyNameEditValue(DeviceDisplayInfoDto device)
  {
    return device.FriendlyNameOverride ?? "";
  }

  private async Task OnFriendlyNameChanged(DeviceDisplayInfoDto device, string newValue)
  {
    if (string.IsNullOrWhiteSpace(newValue))
    {
      // If cleared, remove the override
      if (!string.IsNullOrEmpty(device.FriendlyNameOverride))
      {
        await ClearFriendlyNameAsync(device);
      }
      return;
    }

    // Don't update if value hasn't changed
    if (newValue == device.FriendlyNameOverride)
      return;

    try
    {
      var success = await DevicesApi.SetDeviceFriendlyNameAsync(device.RawName, newValue);
      if (success)
      {
        Snackbar.Add($"Friendly name set for {device.RawName}", Severity.Success);
        await ReloadDisplayAndOutputDevicesAsync();
      }
      else
      {
        Snackbar.Add("Failed to set friendly name", Severity.Warning);
      }
    }
    catch (Exception ex)
    {
      Logger.LogError(ex, "Error setting friendly name");
      Snackbar.Add("Error setting friendly name", Severity.Error);
    }
  }

  private async Task ToggleDeviceVisibilityAsync(DeviceDisplayInfoDto device)
  {
    try
    {
      var newVisible = device.IsHidden; // Toggle: hidden → visible, visible → hidden
      var success = await DevicesApi.SetDeviceVisibilityAsync(device.RawName, newVisible);
      if (success)
      {
        var action = newVisible ? "shown" : "hidden";
        Snackbar.Add($"Device {action}: {device.RawName}", Severity.Success);
        await ReloadDisplayAndOutputDevicesAsync();
      }
      else
      {
        Snackbar.Add("Failed to update device visibility", Severity.Warning);
      }
    }
    catch (Exception ex)
    {
      Logger.LogError(ex, "Error toggling device visibility");
      Snackbar.Add("Error toggling device visibility", Severity.Error);
    }
  }

  private async Task ClearFriendlyNameAsync(DeviceDisplayInfoDto device)
  {
    try
    {
      var success = await DevicesApi.ClearDeviceFriendlyNameAsync(device.RawName);
      if (success)
      {
        Snackbar.Add($"Friendly name cleared for {device.RawName}", Severity.Success);
        await ReloadDisplayAndOutputDevicesAsync();
      }
      else
      {
        Snackbar.Add("Failed to clear friendly name", Severity.Warning);
      }
    }
    catch (Exception ex)
    {
      Logger.LogError(ex, "Error clearing friendly name");
      Snackbar.Add("Error clearing friendly name", Severity.Error);
    }
  }

  private async Task ReloadDisplayAndOutputDevicesAsync()
  {
    displaySettings = await DevicesApi.GetDeviceDisplaySettingsAsync();
    outputDevices = await DevicesApi.GetOutputDevicesAsync();
    StateHasChanged();

    // Notify other components (MainLayout) that display settings changed
    await DisplayState.NotifyDisplaySettingsChangedAsync();
  }
}
