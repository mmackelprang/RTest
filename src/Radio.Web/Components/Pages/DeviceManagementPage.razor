@page "/devices"
@using Radio.Web.Services
@using Radio.Web.Services.ApiClients
@using Radio.Web.Models
@inject DevicesApiService DevicesApi
@inject DeviceDisplayStateService DisplayState
@inject NotificationService NotificationService
@inject ILogger<DeviceManagementPage> Logger

<PageTitle>Device Management - Radio Console</PageTitle>

<div style="height: 100%; display: flex; overflow: hidden;">
  <RadzenTabs TabPosition="TabPosition.Left" Style="height: 100%; width: 100%;" class="system-config-tabs">
    <Tabs>

      @* Display Settings Tab *@
      <RadzenTabsItem Text="Display" Icon="visibility">
        <div style="display:flex; flex-direction:column; gap:8px">
          <div style="display:flex; flex-direction:row; gap:8px; align-items:center; justify-content:space-between">
            <h6>Device Display Settings</h6>
            <RadzenButton Variant="Variant.Filled" ButtonStyle="ButtonStyle.Primary" Size="ButtonSize.Small"
                          Click="RefreshDevicesAsync" Icon="refresh" Text="Refresh" />
          </div>
          <span style="font-size:0.875rem">
            Control which output devices appear in the taskbar and set friendly names.
          </span>

          @if (isLoadingDisplay)
          {
            <RadzenProgressBar Mode="ProgressBarMode.Indeterminate" ProgressBarStyle="ProgressBarStyle.Primary" />
          }
          else if (displaySettings == null || !displaySettings.Any())
          {
            <RadzenAlert AlertStyle="AlertStyle.Info" AllowClose="false">No devices found. Click Refresh to scan for devices.</RadzenAlert>
          }
          else
          {
            <RadzenDataGrid TItem="DeviceDisplayInfoDto" Data="@displaySettings" Density="Density.Compact">
              <Columns>
                <RadzenDataGridColumn Title="Visible" TItem="DeviceDisplayInfoDto">
                  <Template Context="item">
                    <RadzenButton Icon="@(item.IsHidden ? "visibility_off" : "visibility")"
                                  ButtonStyle="@(item.IsHidden ? ButtonStyle.Light : ButtonStyle.Success)"
                                  Size="ButtonSize.Small"
                                  title="@(item.IsHidden ? "Hidden — click to show" : "Visible — click to hide")"
                                  Click="@(() => ToggleDeviceVisibilityAsync(item))"
                                  Variant="Variant.Text" />
                  </Template>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn Title="Type" TItem="DeviceDisplayInfoDto">
                  <Template Context="item">
                    <RadzenBadge BadgeStyle="@(item.Type == "Output" ? BadgeStyle.Info : BadgeStyle.Success)"
                                 IsPill="true" Text="@item.Type" />
                  </Template>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn Title="Device Name" TItem="DeviceDisplayInfoDto">
                  <Template Context="item">
                    <span style="@(item.IsHidden ? "text-decoration: line-through; opacity: 0.5;" : "")">
                      @item.RawName
                    </span>
                  </Template>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn Title="Friendly Name" TItem="DeviceDisplayInfoDto">
                  <Template Context="item">
                    <RadzenTextBox Value="@(GetFriendlyNameEditValue(item))"
                                   Change="@(val => OnFriendlyNameChanged(item, val))"
                                   Placeholder="@item.DisplayName"
                                   Disabled="@item.IsHidden"
                                   Style="@(item.IsHidden ? "opacity: 0.5;" : "")" />
                  </Template>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn Title="" TItem="DeviceDisplayInfoDto" Width="50px">
                  <Template Context="item">
                    @if (!string.IsNullOrEmpty(item.FriendlyNameOverride))
                    {
                      <RadzenButton Icon="clear"
                                    ButtonStyle="ButtonStyle.Light"
                                    Size="ButtonSize.Small"
                                    title="Clear friendly name"
                                    Click="@(() => ClearFriendlyNameAsync(item))"
                                    Variant="Variant.Text" />
                    }
                  </Template>
                </RadzenDataGridColumn>
              </Columns>
            </RadzenDataGrid>
          }
        </div>
      </RadzenTabsItem>

      @* Output Devices Tab *@
      <RadzenTabsItem Text="Outputs" Icon="speaker_group">
        <div style="display:flex; flex-direction:column; gap:8px">
          <h6>Output Devices</h6>

          @if (isLoadingOutput)
          {
            <RadzenProgressBar Mode="ProgressBarMode.Indeterminate" ProgressBarStyle="ProgressBarStyle.Primary" />
          }
          else if (outputDevices == null || !outputDevices.Any())
          {
            <RadzenAlert AlertStyle="AlertStyle.Info" AllowClose="false">No output devices found. Click Refresh to scan for devices.</RadzenAlert>
          }
          else
          {
            <RadzenDataGrid TItem="AudioDeviceDto" Data="@outputDevices" Density="Density.Compact">
              <Columns>
                <RadzenDataGridColumn Title="Name" TItem="AudioDeviceDto">
                  <Template Context="item">
                    <div style="display:flex; flex-direction:row; gap:4px; align-items:center">
                      @if (item.IsDefault)
                      {
                        <RadzenIcon Icon="star" title="Default Device" Style="color:var(--rz-primary)" />
                      }
                      <span>@item.Name</span>
                    </div>
                  </Template>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn Title="Type" TItem="AudioDeviceDto" Property="Type" />
                <RadzenDataGridColumn Title="Status" TItem="AudioDeviceDto">
                  <Template Context="item">
                    @if (item.IsActive)
                    {
                      <RadzenBadge BadgeStyle="BadgeStyle.Success" IsPill="true" Text="Active" />
                    }
                    else if (item.IsDefault)
                    {
                      <RadzenBadge BadgeStyle="BadgeStyle.Primary" IsPill="true" Text="Default" />
                    }
                    else
                    {
                      <RadzenBadge BadgeStyle="BadgeStyle.Light" IsPill="true" Text="Available" />
                    }
                  </Template>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn Title="Actions" TItem="AudioDeviceDto">
                  <Template Context="item">
                    @if (!item.IsDefault)
                    {
                      <RadzenButton Variant="Variant.Text" ButtonStyle="ButtonStyle.Primary" Size="ButtonSize.Small"
                                    Click="@(() => SetDefaultOutputAsync(item.Id))" Text="Set as Default" />
                    }
                  </Template>
                </RadzenDataGridColumn>
              </Columns>
            </RadzenDataGrid>
          }
        </div>
      </RadzenTabsItem>

      @* Google Cast Devices Tab *@
      <RadzenTabsItem Text="Cast" Icon="cast">
        <div style="display:flex; flex-direction:column; gap:8px">
          <div style="display:flex; flex-direction:row; gap:8px; align-items:center; justify-content:space-between">
            <h6>Google Cast Devices</h6>
            <RadzenButton Variant="Variant.Outlined" ButtonStyle="ButtonStyle.Light" Size="ButtonSize.Small"
                          Click="ScanForCastDevicesAsync" Icon="search"
                          Disabled="@isDiscoveringCast">
              <ChildContent>
                @if (isDiscoveringCast)
                {
                  <RadzenProgressBarCircular Size="ProgressBarCircularSize.Small" Mode="ProgressBarMode.Indeterminate" Style="margin-right:8px" />
                  <span>Scanning...</span>
                }
                else
                {
                  <span>Scan for New Devices</span>
                }
              </ChildContent>
            </RadzenButton>
          </div>

          @if (isLoadingCast)
          {
            <RadzenProgressBar Mode="ProgressBarMode.Indeterminate" ProgressBarStyle="ProgressBarStyle.Primary" />
          }
          else if (castDevices == null || !castDevices.Any())
          {
            <RadzenAlert AlertStyle="AlertStyle.Info" AllowClose="false">No cached Cast devices. Click "Scan for New Devices" to discover devices on your network.</RadzenAlert>
          }
          else
          {
            <RadzenDataGrid TItem="CastDeviceDto" Data="@castDevices" Density="Density.Compact">
              <Columns>
                <RadzenDataGridColumn Title="Name" TItem="CastDeviceDto">
                  <Template Context="item">
                    <div style="display:flex; flex-direction:row; gap:4px; align-items:center">
                      <RadzenIcon Icon="cast" />
                      <span>@item.Name</span>
                    </div>
                  </Template>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn Title="IP Address" TItem="CastDeviceDto">
                  <Template Context="item">
                    @item.IpAddress:@item.Port
                  </Template>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn Title="Model" TItem="CastDeviceDto" Property="Model" />
                <RadzenDataGridColumn Title="Default" TItem="CastDeviceDto">
                  <Template Context="item">
                    @if (defaultCastDeviceId == item.Id)
                    {
                      <RadzenIcon Icon="star" title="Default Device" Style="color:var(--rz-warning)" />
                    }
                  </Template>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn Title="Actions" TItem="CastDeviceDto">
                  <Template Context="item">
                    <div style="display:flex; flex-direction:row; gap:4px">
                      <RadzenButton Variant="Variant.Text" ButtonStyle="ButtonStyle.Primary" Size="ButtonSize.Small"
                                    Click="@(() => ConnectCastDeviceAsync(item))"
                                    Disabled="@connectingCastDeviceId.Equals(item.Id)">
                        <ChildContent>
                          @if (connectingCastDeviceId == item.Id)
                          {
                            <RadzenProgressBarCircular Size="ProgressBarCircularSize.Small" Mode="ProgressBarMode.Indeterminate" Style="margin-right:4px" />
                            <span>Connecting</span>
                          }
                          else
                          {
                            <span>Connect</span>
                          }
                        </ChildContent>
                      </RadzenButton>
                      @if (defaultCastDeviceId != item.Id)
                      {
                        <RadzenButton Variant="Variant.Text" ButtonStyle="ButtonStyle.Secondary" Size="ButtonSize.Small"
                                      Click="@(() => SetDefaultCastDeviceAsync(item))" Text="Set Default" />
                      }
                      else
                      {
                        <RadzenButton Variant="Variant.Text" ButtonStyle="ButtonStyle.Light" Size="ButtonSize.Small"
                                      Click="ClearDefaultCastDeviceAsync" Text="Clear Default" />
                      }
                    </div>
                  </Template>
                </RadzenDataGridColumn>
              </Columns>
            </RadzenDataGrid>
          }
        </div>
      </RadzenTabsItem>

      @* Input Devices Tab *@
      <RadzenTabsItem Text="Inputs" Icon="mic">
        <div style="display:flex; flex-direction:column; gap:8px">
          <h6>Input Devices</h6>

          @if (isLoadingInput)
          {
            <RadzenProgressBar Mode="ProgressBarMode.Indeterminate" ProgressBarStyle="ProgressBarStyle.Primary" />
          }
          else if (inputDevices == null || !inputDevices.Any())
          {
            <RadzenAlert AlertStyle="AlertStyle.Info" AllowClose="false">No input devices found. Click Refresh to scan for devices.</RadzenAlert>
          }
          else
          {
            <RadzenDataGrid TItem="AudioDeviceDto" Data="@inputDevices" Density="Density.Compact">
              <Columns>
                <RadzenDataGridColumn Title="Name" TItem="AudioDeviceDto">
                  <Template Context="item">
                    <div style="display:flex; flex-direction:row; gap:4px; align-items:center">
                      @if (item.IsDefault)
                      {
                        <RadzenIcon Icon="star" title="Default Device" Style="color:var(--rz-primary)" />
                      }
                      <span>@item.Name</span>
                    </div>
                  </Template>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn Title="Type" TItem="AudioDeviceDto" Property="Type" />
                <RadzenDataGridColumn Title="Status" TItem="AudioDeviceDto">
                  <Template Context="item">
                    @if (item.IsActive)
                    {
                      <RadzenBadge BadgeStyle="BadgeStyle.Success" IsPill="true" Text="Active" />
                    }
                    else if (item.IsDefault)
                    {
                      <RadzenBadge BadgeStyle="BadgeStyle.Primary" IsPill="true" Text="Default" />
                    }
                    else
                    {
                      <RadzenBadge BadgeStyle="BadgeStyle.Light" IsPill="true" Text="Available" />
                    }
                  </Template>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn Title="Actions" TItem="AudioDeviceDto">
                  <Template Context="item">
                    @if (!item.IsActive)
                    {
                      <RadzenButton Variant="Variant.Text" ButtonStyle="ButtonStyle.Primary" Size="ButtonSize.Small"
                                    Click="@(() => SetDefaultInputAsync(item.Id))" Text="Set as Default" />
                    }
                  </Template>
                </RadzenDataGridColumn>
              </Columns>
            </RadzenDataGrid>
          }
        </div>
      </RadzenTabsItem>

      @* USB Port Reservations Tab *@
      <RadzenTabsItem Text="USB Ports" Icon="usb">
        <div style="display:flex; flex-direction:column; gap:8px">
          <h6>USB Port Reservations</h6>

          @if (isLoadingUsb)
          {
            <RadzenProgressBar Mode="ProgressBarMode.Indeterminate" ProgressBarStyle="ProgressBarStyle.Primary" />
          }
          else if (usbPorts == null || !usbPorts.Any())
          {
            <RadzenAlert AlertStyle="AlertStyle.Info" AllowClose="false">No USB port reservations found.</RadzenAlert>
          }
          else
          {
            <RadzenDataGrid TItem="UsbPortDto" Data="@usbPorts" Density="Density.Compact">
              <Columns>
                <RadzenDataGridColumn Title="Port ID" TItem="UsbPortDto" Property="Id" />
                <RadzenDataGridColumn Title="Port Name" TItem="UsbPortDto" Property="Name" />
                <RadzenDataGridColumn Title="Reserved" TItem="UsbPortDto">
                  <Template Context="item">
                    @if (item.IsReserved)
                    {
                      <RadzenBadge BadgeStyle="BadgeStyle.Warning" IsPill="true" Text="Reserved" />
                    }
                    else
                    {
                      <RadzenBadge BadgeStyle="BadgeStyle.Success" IsPill="true" Text="Available" />
                    }
                  </Template>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn Title="Reserved By" TItem="UsbPortDto">
                  <Template Context="item">
                    @(item.ReservedBy ?? "-")
                  </Template>
                </RadzenDataGridColumn>
              </Columns>
            </RadzenDataGrid>
          }
        </div>
      </RadzenTabsItem>

    </Tabs>
  </RadzenTabs>
</div>

@code {
  private List<AudioDeviceDto>? outputDevices;
  private List<AudioDeviceDto>? inputDevices;
  private List<UsbPortDto>? usbPorts;
  private List<CastDeviceDto>? castDevices;
  private List<DeviceDisplayInfoDto>? displaySettings;

  private bool isLoadingOutput = false;
  private bool isLoadingInput = false;
  private bool isLoadingUsb = false;
  private bool isLoadingCast = false;
  private bool isLoadingDisplay = false;
  private bool isDiscoveringCast = false;
  private string connectingCastDeviceId = "";
  private string defaultCastDeviceId = "";

  protected override async Task OnInitializedAsync()
  {
    await LoadAllDevicesAsync();

    // Auto-start mDNS discovery in the background to refresh cached devices
    _ = BackgroundDiscoverCastDevicesAsync();
  }

  private async Task LoadAllDevicesAsync()
  {
    try
    {
      // Set all loading flags
      isLoadingOutput = true;
      isLoadingInput = true;
      isLoadingUsb = true;
      isLoadingCast = true;
      isLoadingDisplay = true;
      StateHasChanged();

      // Load all devices in parallel for better performance
      var outputTask = DevicesApi.GetOutputDevicesAsync();
      var inputTask = DevicesApi.GetInputDevicesAsync();
      var usbTask = DevicesApi.GetUsbPortsAsync();
      var castTask = DevicesApi.GetCachedCastDevicesAsync();
      var defaultCastTask = DevicesApi.GetDefaultCastDeviceAsync();
      var displayTask = DevicesApi.GetDeviceDisplaySettingsAsync();

      await Task.WhenAll(outputTask, inputTask, usbTask, castTask, defaultCastTask, displayTask);

      // Assign results
      outputDevices = await outputTask;
      inputDevices = await inputTask;
      usbPorts = await usbTask;
      castDevices = await castTask;
      displaySettings = await displayTask;
      var defaultCast = await defaultCastTask;
      defaultCastDeviceId = defaultCast?.Id ?? "";

      // Clear loading flags
      isLoadingOutput = false;
      isLoadingInput = false;
      isLoadingUsb = false;
      isLoadingCast = false;
      isLoadingDisplay = false;


      StateHasChanged();

      Logger.LogInformation("Loaded all devices successfully");
    }
    catch (Exception ex)
    {
      Logger.LogError(ex, "Error loading devices");
      NotificationService.Notify(NotificationSeverity.Error, "Error", "Error loading devices");
      isLoadingOutput = false;
      isLoadingInput = false;
      isLoadingUsb = false;
      isLoadingCast = false;
      isLoadingDisplay = false;
      StateHasChanged();
    }
  }

  private async Task RefreshDevicesAsync()
  {
    try
    {
      Logger.LogInformation("Refreshing devices...");

      var success = await DevicesApi.RefreshDevicesAsync();

      if (success)
      {
        NotificationService.Notify(NotificationSeverity.Success, "Success", "Devices refreshed successfully");

        // Reload all devices
        await LoadAllDevicesAsync();
      }
      else
      {
        NotificationService.Notify(NotificationSeverity.Warning, "Warning", "Failed to refresh devices");
      }
    }
    catch (Exception ex)
    {
      Logger.LogError(ex, "Error refreshing devices");
      NotificationService.Notify(NotificationSeverity.Error, "Error", "Error refreshing devices");
    }
  }

  private async Task SetDefaultInputAsync(string deviceId)
  {
    try
    {
      Logger.LogInformation("Setting default input device: {DeviceId}", deviceId);
      var success = await DevicesApi.SetInputDeviceAsync(deviceId);
      if (success)
      {
        NotificationService.Notify(NotificationSeverity.Success, "Success", "Default input device updated");
        isLoadingInput = true;
        StateHasChanged();
        inputDevices = await DevicesApi.GetInputDevicesAsync();
        isLoadingInput = false;
        StateHasChanged();
      }
      else
      {
        NotificationService.Notify(NotificationSeverity.Warning, "Warning", "Failed to set default input device");
      }
    }
    catch (Exception ex)
    {
      Logger.LogError(ex, "Error setting default input device");
      NotificationService.Notify(NotificationSeverity.Error, "Error", "Error setting default input device");
      isLoadingInput = false;
      StateHasChanged();
    }
  }

  private async Task SetDefaultOutputAsync(string deviceId)
  {
    try
    {
      Logger.LogInformation("Setting default output device: {DeviceId}", deviceId);

      var success = await DevicesApi.SetOutputDeviceAsync(deviceId);

      if (success)
      {
        NotificationService.Notify(NotificationSeverity.Success, "Success", "Default output device updated");

        // Reload output devices to reflect the change
        isLoadingOutput = true;
        StateHasChanged();
        outputDevices = await DevicesApi.GetOutputDevicesAsync();
        isLoadingOutput = false;
        StateHasChanged();
      }
      else
      {
        NotificationService.Notify(NotificationSeverity.Warning, "Warning", "Failed to set default output device");
      }
    }
    catch (Exception ex)
    {
      Logger.LogError(ex, "Error setting default output device");
      NotificationService.Notify(NotificationSeverity.Error, "Error", "Error setting default output device");
      isLoadingOutput = false;
      StateHasChanged();
    }
  }

  /// <summary>
  /// Runs mDNS discovery in the background on page load.
  /// Updates the Cast device list when complete without blocking the UI.
  /// </summary>
  private async Task BackgroundDiscoverCastDevicesAsync()
  {
    try
    {
      isDiscoveringCast = true;
      await InvokeAsync(StateHasChanged);

      var devices = await DevicesApi.DiscoverCastDevicesAsync();

      if (devices != null)
      {
        castDevices = devices;
        Logger.LogInformation("Background Cast discovery found {Count} device(s)", devices.Count);
      }
    }
    catch (Exception ex)
    {
      Logger.LogWarning(ex, "Background Cast device discovery failed");
    }
    finally
    {
      isDiscoveringCast = false;
      await InvokeAsync(StateHasChanged);
    }
  }

  private async Task ScanForCastDevicesAsync()
  {
    try
    {
      isDiscoveringCast = true;
      StateHasChanged();

      Logger.LogInformation("Scanning for Cast devices (mDNS discovery)...");
      var devices = await DevicesApi.DiscoverCastDevicesAsync();

      if (devices != null)
      {
        castDevices = devices;
        NotificationService.Notify(NotificationSeverity.Success, "Success", $"Found {devices.Count} Cast device(s)");
      }
      else
      {
        NotificationService.Notify(NotificationSeverity.Warning, "Warning", "Cast device scan failed");
      }
    }
    catch (Exception ex)
    {
      Logger.LogError(ex, "Error scanning for Cast devices");
      NotificationService.Notify(NotificationSeverity.Error, "Error", "Error scanning for Cast devices");
    }
    finally
    {
      isDiscoveringCast = false;
      StateHasChanged();
    }
  }

  private async Task ConnectCastDeviceAsync(CastDeviceDto device)
  {
    try
    {
      connectingCastDeviceId = device.Id;
      StateHasChanged();

      Logger.LogInformation("Connecting to Cast device: {Name}", device.Name);
      var success = await DevicesApi.ConnectToCastDeviceAsync(device);

      if (success)
      {
        NotificationService.Notify(NotificationSeverity.Success, "Success", $"Connected to {device.Name}");
        defaultCastDeviceId = device.Id;

        // Refresh output devices to reflect updated Cast name
        outputDevices = await DevicesApi.GetOutputDevicesAsync();
      }
      else
      {
        NotificationService.Notify(NotificationSeverity.Warning, "Warning", $"Failed to connect to {device.Name}");
      }
    }
    catch (Exception ex)
    {
      Logger.LogError(ex, "Error connecting to Cast device: {Name}", device.Name);
      NotificationService.Notify(NotificationSeverity.Error, "Error", $"Error connecting to {device.Name}");
    }
    finally
    {
      connectingCastDeviceId = "";
      StateHasChanged();
    }
  }

  private async Task SetDefaultCastDeviceAsync(CastDeviceDto device)
  {
    try
    {
      var success = await DevicesApi.SetDefaultCastDeviceAsync(device);
      if (success)
      {
        defaultCastDeviceId = device.Id;
        NotificationService.Notify(NotificationSeverity.Success, "Success", $"Default Cast device set to {device.Name}");

        // Refresh output devices to reflect updated Cast name
        outputDevices = await DevicesApi.GetOutputDevicesAsync();
        StateHasChanged();
      }
      else
      {
        NotificationService.Notify(NotificationSeverity.Warning, "Warning", "Failed to set default Cast device");
      }
    }
    catch (Exception ex)
    {
      Logger.LogError(ex, "Error setting default Cast device");
      NotificationService.Notify(NotificationSeverity.Error, "Error", "Error setting default Cast device");
    }
  }

  private async Task ClearDefaultCastDeviceAsync()
  {
    try
    {
      var success = await DevicesApi.ClearDefaultCastDeviceAsync();
      if (success)
      {
        defaultCastDeviceId = "";
        NotificationService.Notify(NotificationSeverity.Success, "Success", "Default Cast device cleared");

        // Refresh output devices to reflect reverted Cast name
        outputDevices = await DevicesApi.GetOutputDevicesAsync();
        StateHasChanged();
      }
      else
      {
        NotificationService.Notify(NotificationSeverity.Warning, "Warning", "Failed to clear default Cast device");
      }
    }
    catch (Exception ex)
    {
      Logger.LogError(ex, "Error clearing default Cast device");
      NotificationService.Notify(NotificationSeverity.Error, "Error", "Error clearing default Cast device");
    }
  }

  private string GetFriendlyNameEditValue(DeviceDisplayInfoDto device)
  {
    return device.FriendlyNameOverride ?? "";
  }

  private async Task OnFriendlyNameChanged(DeviceDisplayInfoDto device, string newValue)
  {
    if (string.IsNullOrWhiteSpace(newValue))
    {
      // If cleared, remove the override
      if (!string.IsNullOrEmpty(device.FriendlyNameOverride))
      {
        await ClearFriendlyNameAsync(device);
      }
      return;
    }

    // Don't update if value hasn't changed
    if (newValue == device.FriendlyNameOverride)
      return;

    try
    {
      var success = await DevicesApi.SetDeviceFriendlyNameAsync(device.RawName, newValue);
      if (success)
      {
        NotificationService.Notify(NotificationSeverity.Success, "Success", $"Friendly name set for {device.RawName}");
        await ReloadDisplayAndOutputDevicesAsync();
      }
      else
      {
        NotificationService.Notify(NotificationSeverity.Warning, "Warning", "Failed to set friendly name");
      }
    }
    catch (Exception ex)
    {
      Logger.LogError(ex, "Error setting friendly name");
      NotificationService.Notify(NotificationSeverity.Error, "Error", "Error setting friendly name");
    }
  }

  private async Task ToggleDeviceVisibilityAsync(DeviceDisplayInfoDto device)
  {
    try
    {
      var newVisible = device.IsHidden; // Toggle: hidden → visible, visible → hidden
      var success = await DevicesApi.SetDeviceVisibilityAsync(device.RawName, newVisible);
      if (success)
      {
        var action = newVisible ? "shown" : "hidden";
        NotificationService.Notify(NotificationSeverity.Success, "Success", $"Device {action}: {device.RawName}");
        await ReloadDisplayAndOutputDevicesAsync();
      }
      else
      {
        NotificationService.Notify(NotificationSeverity.Warning, "Warning", "Failed to update device visibility");
      }
    }
    catch (Exception ex)
    {
      Logger.LogError(ex, "Error toggling device visibility");
      NotificationService.Notify(NotificationSeverity.Error, "Error", "Error toggling device visibility");
    }
  }

  private async Task ClearFriendlyNameAsync(DeviceDisplayInfoDto device)
  {
    try
    {
      var success = await DevicesApi.ClearDeviceFriendlyNameAsync(device.RawName);
      if (success)
      {
        NotificationService.Notify(NotificationSeverity.Success, "Success", $"Friendly name cleared for {device.RawName}");
        await ReloadDisplayAndOutputDevicesAsync();
      }
      else
      {
        NotificationService.Notify(NotificationSeverity.Warning, "Warning", "Failed to clear friendly name");
      }
    }
    catch (Exception ex)
    {
      Logger.LogError(ex, "Error clearing friendly name");
      NotificationService.Notify(NotificationSeverity.Error, "Error", "Error clearing friendly name");
    }
  }

  private async Task ReloadDisplayAndOutputDevicesAsync()
  {
    displaySettings = await DevicesApi.GetDeviceDisplaySettingsAsync();
    outputDevices = await DevicesApi.GetOutputDevicesAsync();
    StateHasChanged();

    // Notify other components (MainLayout) that display settings changed
    await DisplayState.NotifyDisplaySettingsChangedAsync();
  }
}
