@page "/queue"
@rendermode InteractiveServer
@inject QueueApiService QueueApi
@inject AudioStateHubService HubService
@inject AudioApiService AudioApi
@inject ConfigurationApiService ConfigApi
@inject FileApiService FileApi
@inject IDialogService DialogService
@inject ILogger<QueuePage> Logger
@inject ISnackbar Snackbar
@implements IAsyncDisposable

<PageTitle>Queue - Radio Console</PageTitle>

<div class="queue-page" style="padding: 24px; height: 100%; display: flex; flex-direction: column;">
  <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 16px;">
    <MudText Typo="Typo.h4">Queue</MudText>
    <div style="display: flex; gap: 12px;">
      <MudButton Variant="Variant.Filled" 
                 Color="Color.Primary" 
                 OnClick="OpenFileSelectionDialogAsync"
                 StartIcon="@Icons.Material.Filled.Add">
        Add Files
      </MudButton>
      @if (_canReorderQueue && _queueItems.Any())
      {
        <MudButton Size="Size.Small" 
                   Variant="@(_isDragEnabled ? Variant.Filled : Variant.Outlined)"
                   Color="@(_isDragEnabled ? Color.Success : Color.Default)" 
                   StartIcon="@Icons.Material.Filled.DragIndicator" 
                   OnClick="@(() => { _isDragEnabled = !_isDragEnabled; StateHasChanged(); })">
          @(_isDragEnabled ? "Drag Enabled" : "Enable Drag")
        </MudButton>
      }
      <MudButton Variant="Variant.Filled" Color="Color.Error" OnClick="HandleClearQueueAsync" Disabled="@(!_queueItems.Any())">
        Clear All
      </MudButton>
    </div>
  </div>
  
  @if (!_queueItems.Any())
  {
    <!-- Empty State -->
    <div style="display: flex; flex-direction: column; align-items: center; justify-content: center; height: 100%; color: var(--text-secondary);">
      <MudIcon Icon="@Icons.Material.Filled.QueueMusic" Style="font-size: 120px; margin-bottom: 16px; opacity: 0.5;" />
      <MudText Typo="Typo.h5">No tracks in queue</MudText>
      <MudText Typo="Typo.body1" Style="margin-top: 8px; margin-bottom: 24px;">Add tracks from the File Browser or click the button below</MudText>
      <MudButton Variant="Variant.Filled" 
                 Color="Color.Primary" 
                 OnClick="OpenFileSelectionDialogAsync"
                 StartIcon="@Icons.Material.Filled.Add"
                 Size="Size.Large">
        Add Files to Queue
      </MudButton>
    </div>
  }
  else if (_isDragEnabled && _canReorderQueue)
  {
    <!-- Drag-and-Drop Queue -->
    <MudList T="string" Class="queue-drop-container" Style="height: calc(100% - 80px); overflow-y: auto;">
      @foreach (var item in _queueItems)
      {
        <MudListItem T="string" @key="item.Index">
          <MudPaper Class="queue-item-draggable" 
                    Elevation="2" 
                    Style="@GetItemStyle(item)"
                    draggable="true"
                    @ondragstart="@(() => OnDragStart(item))"
                    @ondragover:preventDefault
                    @ondrop="@(() => OnDrop(item))">
            <div style="display: grid; grid-template-columns: 60px 1fr 250px 200px 80px 80px; align-items: center; gap: 8px; padding: 8px;">
              <div style="display: flex; align-items: center; justify-content: center;">
                <MudIcon Icon="@Icons.Material.Filled.DragIndicator" Size="Size.Small" Style="cursor: grab;" />
              </div>
              <div @onclick="@(() => HandleJumpToAsync(item.Index))" style="cursor: pointer; font-weight: @(item.IsCurrent ? "600" : "400"); color: @(item.IsCurrent ? "var(--mud-palette-primary)" : "inherit");">
                @item.Title
              </div>
              <div>@item.Artist</div>
              <div>@item.Album</div>
              <div>@item.Duration</div>
              <div>
                <MudIconButton Icon="@Icons.Material.Filled.Delete" 
                               Size="Size.Small" 
                               OnClick="@(() => HandleRemoveAsync(item.Index))" 
                               title="Remove" />
              </div>
            </div>
          </MudPaper>
        </MudListItem>
      }
    </MudList>
  }
  else
  {
    <!-- Queue Table (Normal Mode) -->
    <MudTable Items="@_queueItems" Hover="true" Dense="true" FixedHeader="true" Height="calc(100% - 80px)" Style="overflow-y: auto;">
      <HeaderContent>
        <MudTh Style="width: 60px;">#</MudTh>
        <MudTh>Title</MudTh>
        <MudTh Style="width: 250px;">Artist</MudTh>
        <MudTh Style="width: 200px;">Album</MudTh>
        <MudTh Style="width: 80px;">Duration</MudTh>
        <MudTh Style="width: 80px;">Actions</MudTh>
      </HeaderContent>
      <RowTemplate>
        <MudTd Style="width: 60px;">@context.Index</MudTd>
        <MudTd DataLabel="Title" Style="cursor: pointer;" @onclick="@(() => HandleJumpToAsync(context.Index))">
          <div style="font-weight: @(context.IsCurrent ? "600" : "400"); color: @(context.IsCurrent ? "var(--mud-palette-primary)" : "inherit");">
            @context.Title
          </div>
        </MudTd>
        <MudTd DataLabel="Artist" Style="width: 250px;">@context.Artist</MudTd>
        <MudTd DataLabel="Album" Style="width: 200px;">@context.Album</MudTd>
        <MudTd DataLabel="Duration" Style="width: 80px;">@context.Duration</MudTd>
        <MudTd DataLabel="Actions" Style="width: 80px;">
          <MudIconButton Icon="@Icons.Material.Filled.Delete" 
                         Size="Size.Small" 
                         OnClick="@(() => HandleRemoveAsync(context.Index))" 
                         title="Remove" />
        </MudTd>
      </RowTemplate>
    </MudTable>
  }
</div>

@code {
  private List<QueueItemDto> _queueItems = new();
  private bool _isDragEnabled = false;
  private bool _canReorderQueue = false;
  private QueueItemDto? _draggedItem = null;

  protected override async Task OnInitializedAsync()
  {
    // Load user preferences
    await LoadPreferencesAsync();

    // Check if current source supports queue reordering
    await CheckQueueCapabilitiesAsync();

    // Subscribe to SignalR QueueChanged event
    HubService.QueueChanged += OnQueueChanged;
    HubService.SourceChanged += OnSourceChanged;

    // Start SignalR connection if not already connected
    if (!HubService.IsConnected)
    {
      try
      {
        await HubService.StartAsync();
      }
      catch (Exception ex)
      {
        Logger.LogWarning(ex, "Failed to connect to SignalR hub for queue updates.");
      }
    }

    // Initial load
    await RefreshQueueAsync();
  }

  private async Task CheckQueueCapabilitiesAsync()
  {
    try
    {
      var state = await AudioApi.GetPlaybackStateAsync();
      _canReorderQueue = state?.CanReorderQueue ?? false;
    }
    catch (Exception ex)
    {
      Logger.LogWarning(ex, "Failed to check queue capabilities");
      _canReorderQueue = false;
    }
  }

  private async Task LoadPreferencesAsync()
  {
    try
    {
      var prefs = await ConfigApi.GetConfigurationAsync<Dictionary<string, object>>("ui.queue");
      if (prefs != null)
      {
        // Load drag mode preference
        if (prefs.TryGetValue("dragEnabled", out var dragEnabled))
        {
          _isDragEnabled = Convert.ToBoolean(dragEnabled);
        }
      }
    }
    catch (Exception ex)
    {
      Logger.LogWarning(ex, "Failed to load preferences for Queue page");
    }
  }

  private async Task SavePreferenceAsync(string key, object value)
  {
    try
    {
      await ConfigApi.UpdateConfigurationAsync("ui.queue", key, value.ToString() ?? string.Empty);
    }
    catch (Exception ex)
    {
      Logger.LogWarning(ex, "Failed to save preference {Key}", key);
    }
  }

  private async Task OnQueueChanged()
  {
    await RefreshQueueAsync();
    await InvokeAsync(StateHasChanged);
  }

  private async Task OnSourceChanged()
  {
    await CheckQueueCapabilitiesAsync();
    await InvokeAsync(StateHasChanged);
  }

  private async Task RefreshQueueAsync()
  {
    try
    {
      var queue = await QueueApi.GetQueueAsync();
      if (queue != null)
      {
        _queueItems = queue;
      }
    }
    catch (Exception)
    {
      // Silently fail
    }
  }

  // HTML5 Drag-and-Drop handlers
  private void OnDragStart(QueueItemDto item)
  {
    _draggedItem = item;
  }

  private async Task OnDrop(QueueItemDto targetItem)
  {
    if (_draggedItem == null || _draggedItem == targetItem)
      return;

    var fromIndex = _draggedItem.Index;
    var toIndex = targetItem.Index;

    try
    {
      // Call API to reorder
      var success = await QueueApi.MoveItemAsync(fromIndex, toIndex);
      
      if (success)
      {
        Snackbar.Add("Queue reordered successfully", Severity.Success);
        // Refresh from server to get updated indices
        await RefreshQueueAsync();
        StateHasChanged();
      }
      else
      {
        Snackbar.Add("Failed to reorder queue", Severity.Error);
        await RefreshQueueAsync();
      }
    }
    catch (Exception ex)
    {
      Logger.LogError(ex, "Failed to reorder queue items");
      Snackbar.Add("Error reordering queue", Severity.Error);
      await RefreshQueueAsync();
    }
    finally
    {
      _draggedItem = null;
    }
  }

  private async Task HandleJumpToAsync(int index)
  {
    try
    {
      await QueueApi.JumpToPositionAsync(index);
    }
    catch (Exception)
    {
      // Silently fail
    }
  }

  private async Task HandleRemoveAsync(int index)
  {
    try
    {
      var success = await QueueApi.RemoveFromQueueAsync(index);
      if (success)
      {
        await RefreshQueueAsync();
      }
    }
    catch (Exception)
    {
      // Silently fail
    }
  }

  private async Task HandleClearQueueAsync()
  {
    try
    {
      var success = await QueueApi.ClearQueueAsync();
      if (success)
      {
        _queueItems.Clear();
      }
    }
    catch (Exception)
    {
      // Silently fail
    }
  }

  private string GetItemStyle(QueueItemDto item)
  {
    var baseStyle = "min-height: 72px; cursor: pointer;";
    if (item.IsCurrent)
    {
      return baseStyle + " border-left: 4px solid var(--mud-palette-primary);";
    }
    return baseStyle;
  }

  private async Task OpenFileSelectionDialogAsync()
  {
    var parameters = new DialogParameters();
    var options = new DialogOptions
    {
      CloseButton = true,
      MaxWidth = MaxWidth.Medium,
      FullWidth = true
    };

    var dialog = await DialogService.ShowAsync<Radio.Web.Components.Dialogs.AudioFileSelectionDialog>("Add File to Queue", parameters, options);
    var result = await dialog.Result;

    if (result != null && !result.Canceled && result.Data is string selectedPath)
    {
      try
      {
        var success = await FileApi.AddFileToQueueAsync(selectedPath);
        if (success)
        {
          Snackbar.Add("File added to queue", Severity.Success);
          await RefreshQueueAsync();
        }
        else
        {
          Snackbar.Add("Failed to add file to queue", Severity.Error);
        }
      }
      catch (Exception ex)
      {
        Logger.LogError(ex, "Failed to add file to queue");
        Snackbar.Add("Error adding file to queue", Severity.Error);
      }
    }
  }

  public async ValueTask DisposeAsync()
  {
    HubService.QueueChanged -= OnQueueChanged;
    HubService.SourceChanged -= OnSourceChanged;
  }
}
