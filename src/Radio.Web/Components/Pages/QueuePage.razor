@page "/queue"
@rendermode InteractiveServer
@inject QueueApiService QueueApi
@inject AudioStateHubService HubService
@inject AudioApiService AudioApi
@inject ConfigurationApiService ConfigApi
@inject FileApiService FileApi
@inject IDialogService DialogService
@inject ILogger<QueuePage> Logger
@inject ISnackbar Snackbar
@inject Radio.Web.Services.QueuePersistenceService QueuePersistence
@implements IAsyncDisposable

<PageTitle>Queue - Radio Console</PageTitle>

<div class="queue-page" style="padding: 24px; height: 100%; display: flex; flex-direction: column;">
  <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 16px;">
    <MudText Typo="Typo.h4">Queue</MudText>
    <div style="display: flex; gap: 12px;">
      <MudButton Variant="Variant.Filled" 
                 Color="Color.Primary" 
                 OnClick="OpenFileSelectionDialogAsync"
                 StartIcon="@Icons.Material.Filled.Add"
                 Size="Size.Large"
                 Style="min-width: 60px; min-height: 60px; font-size: 1.1rem;">
        Add Files
      </MudButton>
      @if (_canReorderQueue && _queueItems.Any())
      {
        <MudButton Size="Size.Large" 
                   Variant="@(_isDragEnabled ? Variant.Filled : Variant.Outlined)"
                   Color="@(_isDragEnabled ? Color.Success : Color.Default)" 
                   StartIcon="@Icons.Material.Filled.DragIndicator" 
                   OnClick="@(() => { _isDragEnabled = !_isDragEnabled; StateHasChanged(); })"
                   Style="min-width: 60px; min-height: 60px; font-size: 1.1rem;">
          @(_isDragEnabled ? "Drag Enabled" : "Enable Drag")
        </MudButton>
      }
      <MudButton Variant="Variant.Filled" 
                 Color="Color.Error" 
                 OnClick="HandleClearQueueAsync" 
                 Disabled="@(!_queueItems.Any())"
                 Size="Size.Large"
                 Style="min-width: 60px; min-height: 60px; font-size: 1.1rem;">
        Clear All
      </MudButton>
    </div>
  </div>
  
  @if (!_queueItems.Any())
  {
    <!-- Empty State -->
    <div style="display: flex; flex-direction: column; align-items: center; justify-content: center; height: 100%; color: var(--text-secondary);">
      <MudIcon Icon="@Icons.Material.Filled.QueueMusic" Style="font-size: 120px; margin-bottom: 16px; opacity: 0.5;" />
      <MudText Typo="Typo.h5">No tracks in queue</MudText>
      <MudText Typo="Typo.body1" Style="margin-top: 8px; margin-bottom: 24px;">Add tracks from the File Browser or click the button below</MudText>
      <MudButton Variant="Variant.Filled" 
                 Color="Color.Primary" 
                 OnClick="OpenFileSelectionDialogAsync"
                 StartIcon="@Icons.Material.Filled.Add"
                 Size="Size.Large">
        Add Files to Queue
      </MudButton>
    </div>
  }
  else if (_isDragEnabled && _canReorderQueue)
  {
    <!-- Drag-and-Drop Queue -->
    <MudList T="string" Class="queue-drop-container" Style="height: calc(100% - 80px); overflow-y: auto;">
      @if (_queueItems.Count == 1)
      {
        <!-- Single item - give it special prominence -->
        <div style="padding: 24px; text-align: center;">
          <MudText Typo="Typo.body2" Color="Color.Secondary" Style="margin-bottom: 16px;">1 track in queue</MudText>
        </div>
      }
      @foreach (var item in _queueItems)
      {
        <MudListItem T="string" @key="item.Index">
          <MudPaper Class="queue-item-draggable" 
                    Elevation="2" 
                    Style="@GetItemStyle(item, enhancedPadding: true)"
                    draggable="true"
                    @ondragstart="@(() => OnDragStart(item))"
                    @ondragover:preventDefault
                    @ondrop="@(() => OnDrop(item))">
            <div style="display: grid; grid-template-columns: 72px 1fr 250px 200px 80px 80px; align-items: center; gap: 12px; padding: 16px;">
              <div style="display: flex; align-items: center; justify-content: center;">
                <MudIcon Icon="@Icons.Material.Filled.DragIndicator" Size="Size.Large" Style="cursor: grab;" />
              </div>
              <div @onclick="@(() => HandleJumpToAsync(item.Index))" style="cursor: pointer; font-weight: @(item.IsCurrent ? "600" : "400"); color: @(item.IsCurrent ? "var(--mud-palette-primary)" : "inherit"); font-size: 1.1rem;">
                @item.Title
              </div>
              <div style="font-size: 1rem;">@item.Artist</div>
              <div style="font-size: 1rem;">@item.Album</div>
              <div style="font-size: 1rem;">@item.Duration</div>
              <div>
                <MudIconButton Icon="@Icons.Material.Filled.Delete" 
                               Size="Size.Large"
                               OnClick="@(() => HandleRemoveAsync(item.Index))" 
                               title="Remove"
                               Style="width: 60px; height: 60px;" />
              </div>
            </div>
          </MudPaper>
        </MudListItem>
      }
    </MudList>
  }
  else
  {
    <!-- Queue Table (Normal Mode) - Enhanced for touch -->
    @if (_queueItems.Count == 1)
    {
      <!-- Single item - give it special prominence -->
      <div style="padding: 24px 0 16px 0; text-align: center;">
        <MudText Typo="Typo.body2" Color="Color.Secondary">1 track in queue</MudText>
      </div>
    }
    <MudTable Items="@_queueItems" Hover="true" Dense="false" FixedHeader="true" Height="calc(100% - 80px)" Style="overflow-y: auto;">
      <HeaderContent>
        <MudTh Style="width: 60px; font-size: 1rem;">#</MudTh>
        <MudTh Style="font-size: 1rem;">Title</MudTh>
        <MudTh Style="width: 250px; font-size: 1rem;">Artist</MudTh>
        <MudTh Style="width: 200px; font-size: 1rem;">Album</MudTh>
        <MudTh Style="width: 100px; font-size: 1rem;">Duration</MudTh>
        <MudTh Style="width: 100px; font-size: 1rem;">Actions</MudTh>
      </HeaderContent>
      <RowTemplate>
        <MudTd Style="width: 60px; min-height: 60px; font-size: 1rem;">@context.Index</MudTd>
        <MudTd DataLabel="Title" Style="cursor: pointer; min-height: 60px; padding: 16px 8px;" @onclick="@(() => HandleJumpToAsync(context.Index))">
          <div style="font-weight: @(context.IsCurrent ? "600" : "400"); color: @(context.IsCurrent ? "var(--mud-palette-primary)" : "inherit"); font-size: 1.1rem; line-height: 1.5;">
            @context.Title
          </div>
        </MudTd>
        <MudTd DataLabel="Artist" Style="width: 250px; min-height: 60px; padding: 16px 8px; font-size: 1rem;">@context.Artist</MudTd>
        <MudTd DataLabel="Album" Style="width: 200px; min-height: 60px; padding: 16px 8px; font-size: 1rem;">@context.Album</MudTd>
        <MudTd DataLabel="Duration" Style="width: 100px; min-height: 60px; padding: 16px 8px; font-size: 1rem;">@context.Duration</MudTd>
        <MudTd DataLabel="Actions" Style="width: 100px; min-height: 60px; padding: 16px 8px;">
          <MudIconButton Icon="@Icons.Material.Filled.Delete" 
                         Size="Size.Large"
                         OnClick="@(() => HandleRemoveAsync(context.Index))" 
                         title="Remove"
                         Style="width: 60px; height: 60px;" />
        </MudTd>
      </RowTemplate>
    </MudTable>
  }
</div>

@code {
  private List<QueueItemDto> _queueItems = new();
  private bool _isDragEnabled = false;
  private bool _canReorderQueue = false;
  private QueueItemDto? _draggedItem = null;
  private CancellationTokenSource? _queueSaveDebounceCts;
  private static readonly TimeSpan QueueSaveDebounceDelay = TimeSpan.FromMilliseconds(500);

  protected override async Task OnInitializedAsync()
  {
    // Load user preferences
    await LoadPreferencesAsync();

    // Check if current source supports queue reordering
    await CheckQueueCapabilitiesAsync();

    // Subscribe to SignalR QueueChanged event
    HubService.QueueChanged += OnQueueChanged;
    HubService.SourceChanged += OnSourceChanged;

    // Start SignalR connection if not already connected
    if (!HubService.IsConnected)
    {
      try
      {
        await HubService.StartAsync();
      }
      catch (Exception ex)
      {
        Logger.LogWarning(ex, "Failed to connect to SignalR hub for queue updates.");
      }
    }

    // Initial load
    await RefreshQueueAsync();
  }

  private async Task CheckQueueCapabilitiesAsync()
  {
    try
    {
      var state = await AudioApi.GetPlaybackStateAsync();
      _canReorderQueue = state?.CanReorderQueue ?? false;
    }
    catch (Exception ex)
    {
      Logger.LogWarning(ex, "Failed to check queue capabilities");
      _canReorderQueue = false;
    }
  }

  private async Task LoadPreferencesAsync()
  {
    try
    {
      var prefs = await ConfigApi.GetConfigurationAsync<Dictionary<string, object>>("ui.queue");
      if (prefs != null)
      {
        // Load drag mode preference
        if (prefs.TryGetValue("dragEnabled", out var dragEnabled))
        {
          _isDragEnabled = Convert.ToBoolean(dragEnabled);
        }
      }
    }
    catch (Exception ex)
    {
      Logger.LogWarning(ex, "Failed to load preferences for Queue page");
    }
  }

  private async Task SavePreferenceAsync(string key, object value)
  {
    try
    {
      await ConfigApi.UpdateConfigurationAsync("ui.queue", key, value.ToString() ?? string.Empty);
    }
    catch (Exception ex)
    {
      Logger.LogWarning(ex, "Failed to save preference {Key}", key);
    }
  }

  private async Task ScheduleQueueSaveAsync()
  {
    // Cancel any pending save so only the latest queue state is persisted
    _queueSaveDebounceCts?.Cancel();
    _queueSaveDebounceCts?.Dispose();

    _queueSaveDebounceCts = new CancellationTokenSource();
    var cancellationToken = _queueSaveDebounceCts.Token;

    try
    {
      // Wait for a short debounce period to batch rapid queue changes
      await Task.Delay(QueueSaveDebounceDelay, cancellationToken);

      if (!cancellationToken.IsCancellationRequested)
      {
        await QueuePersistence.SaveQueueStateAsync();
      }
    }
    catch (TaskCanceledException)
    {
      // Expected when a new queue change occurs before the debounce delay elapses
    }
    catch (Exception ex)
    {
      Logger.LogWarning(ex, "Failed to auto-save queue state");
    }
  }

  private async Task OnQueueChanged()
  {
    await RefreshQueueAsync();
    
    // Auto-save queue state when it changes, using debouncing to avoid excessive I/O
    _ = ScheduleQueueSaveAsync();
    
    await InvokeAsync(StateHasChanged);
  }

  private async Task OnSourceChanged()
  {
    await CheckQueueCapabilitiesAsync();
    await InvokeAsync(StateHasChanged);
  }

  private async Task RefreshQueueAsync()
  {
    try
    {
      var queue = await QueueApi.GetQueueAsync();
      if (queue != null)
      {
        _queueItems = queue;
      }
    }
    catch (Exception)
    {
      // Silently fail
    }
  }

  // HTML5 Drag-and-Drop handlers
  private void OnDragStart(QueueItemDto item)
  {
    _draggedItem = item;
  }

  private async Task OnDrop(QueueItemDto targetItem)
  {
    if (_draggedItem == null || _draggedItem == targetItem)
      return;

    var fromIndex = _draggedItem.Index;
    var toIndex = targetItem.Index;

    try
    {
      // Call API to reorder
      var success = await QueueApi.MoveItemAsync(fromIndex, toIndex);
      
      if (success)
      {
        Snackbar.Add("Queue reordered successfully", Severity.Success);
        // Refresh from server to get updated indices
        await RefreshQueueAsync();
        StateHasChanged();
      }
      else
      {
        Snackbar.Add("Failed to reorder queue", Severity.Error);
        await RefreshQueueAsync();
      }
    }
    catch (Exception ex)
    {
      Logger.LogError(ex, "Failed to reorder queue items");
      Snackbar.Add("Error reordering queue", Severity.Error);
      await RefreshQueueAsync();
    }
    finally
    {
      _draggedItem = null;
    }
  }

  private async Task HandleJumpToAsync(int index)
  {
    try
    {
      await QueueApi.JumpToPositionAsync(index);
    }
    catch (Exception)
    {
      // Silently fail
    }
  }

  private async Task HandleRemoveAsync(int index)
  {
    try
    {
      var success = await QueueApi.RemoveFromQueueAsync(index);
      if (success)
      {
        await RefreshQueueAsync();
      }
    }
    catch (Exception)
    {
      // Silently fail
    }
  }

  private async Task HandleClearQueueAsync()
  {
    try
    {
      var success = await QueueApi.ClearQueueAsync();
      if (success)
      {
        _queueItems.Clear();
      }
    }
    catch (Exception)
    {
      // Silently fail
    }
  }

  private string GetItemStyle(QueueItemDto item, bool enhancedPadding = false)
  {
    var minHeight = enhancedPadding ? "min-height: 72px;" : "min-height: 60px;";
    var baseStyle = $"{minHeight} cursor: pointer;";
    if (item.IsCurrent)
    {
      return baseStyle + " border-left: 4px solid var(--mud-palette-primary);";
    }
    return baseStyle;
  }

  private async Task OpenFileSelectionDialogAsync()
  {
    var parameters = new DialogParameters
    {
      { "AllowMultiSelect", true },
      { "AllowAddToQueue", true },
      { "OnAddToQueue", EventCallback.Factory.Create<List<string>>(this, HandleAddFilesToQueueAsync) }
    };
    var options = new DialogOptions
    {
      CloseButton = true,
      MaxWidth = MaxWidth.Medium,
      FullWidth = true
    };

    var dialog = await DialogService.ShowAsync<Radio.Web.Components.Dialogs.AudioFileSelectionDialog>("Add Files to Queue", parameters, options);
    var result = await dialog.Result;

    if (result != null && !result.Canceled)
    {
      // Handle result - could be single string or List<string>
      if (result.Data is List<string> selectedPaths)
      {
        await HandleAddFilesToQueueAsync(selectedPaths);
      }
      else if (result.Data is string selectedPath)
      {
        await HandleAddFilesToQueueAsync(new List<string> { selectedPath });
      }
    }
  }

  private async Task HandleAddFilesToQueueAsync(List<string> filePaths)
  {
    if (filePaths == null || !filePaths.Any())
      return;

    try
    {
      var addedCount = 0;
      var failedCount = 0;

      foreach (var path in filePaths)
      {
        try
        {
          var success = await FileApi.AddFileToQueueAsync(path);
          if (success)
          {
            addedCount++;
          }
          else
          {
            failedCount++;
          }
        }
        catch (Exception ex)
        {
          Logger.LogError(ex, "Failed to add file to queue: {Path}", path);
          failedCount++;
        }
      }

      if (addedCount > 0)
      {
        Snackbar.Add($"{addedCount} file{(addedCount != 1 ? "s" : "")} added to queue", Severity.Success);
        await RefreshQueueAsync();
      }

      if (failedCount > 0)
      {
        Snackbar.Add($"Failed to add {failedCount} file{(failedCount != 1 ? "s" : "")}", Severity.Warning);
      }
    }
    catch (Exception ex)
    {
      Logger.LogError(ex, "Error adding files to queue");
      Snackbar.Add("Error adding files to queue", Severity.Error);
    }
  }

  public async ValueTask DisposeAsync()
  {
    // Cancel and dispose the debounce cancellation token source
    _queueSaveDebounceCts?.Cancel();
    _queueSaveDebounceCts?.Dispose();
    
    HubService.QueueChanged -= OnQueueChanged;
    HubService.SourceChanged -= OnSourceChanged;
    
    await Task.CompletedTask;
  }
}
