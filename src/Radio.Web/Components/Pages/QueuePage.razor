@page "/queue"
@rendermode InteractiveServer
@using System.Runtime.InteropServices
@inject QueueApiService QueueApi
@inject AudioStateHubService HubService
@inject AudioApiService AudioApi
@inject ConfigurationApiService ConfigApi
@inject FileApiService FileApi
@inject IDialogService DialogService
@inject ILogger<QueuePage> Logger
@inject ISnackbar Snackbar
@inject Radio.Web.Services.QueuePersistenceService QueuePersistence
@inject PlaylistApiService PlaylistApi
@inject IJSRuntime JSRuntime
@implements IAsyncDisposable

<PageTitle>Queue - Radio Console</PageTitle>

<div class="queue-page" style="height: 100%; display: flex; gap: 2px; overflow: hidden;">
  <!-- Left: File Browser (always visible) -->
  <div class="panel surface-raised" style="width: 50%; display: flex; flex-direction: column; overflow: hidden; padding: 12px;">
    <div class="panel-header" style="padding: 8px 4px;">
      <span>File Browser</span>
      <div style="display: flex; gap: 4px;">
        <MudButton Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Small"
                   OnClick="OpenLoadPlaylistDialogAsync" StartIcon="@Icons.Material.Filled.PlaylistPlay">
          Load
        </MudButton>
      </div>
    </div>
  @{
    <!-- ═══════════════ FILE BROWSER SECTION ═══════════════ -->
    <div style="flex: 1; display: flex; flex-direction: column; overflow: hidden;">
      <!-- Navigation Bar -->
      <div style="display: flex; gap: 8px; margin-bottom: 12px; flex-shrink: 0;">
        <MudButton Variant="Variant.Outlined" Color="Color.Default" Size="Size.Small"
                   OnClick="HandleBrowserHomeAsync" StartIcon="@Icons.Material.Filled.Home">Home</MudButton>
        <MudButton Variant="Variant.Outlined" Color="Color.Default" Size="Size.Small"
                   OnClick="HandleBrowserUpAsync" StartIcon="@Icons.Material.Filled.ArrowUpward"
                   Disabled="@(_browserPath == "/" || _browserPath == _browserRootPath)">Up</MudButton>
        <MudButton Variant="Variant.Outlined" Color="Color.Default" Size="Size.Small"
                   OnClick="LoadDrivesAsync" StartIcon="@Icons.Material.Filled.Refresh">Refresh</MudButton>

        @if (_drives != null && _drives.Any())
        {
          <MudSelect T="string" Label="Drive" Variant="Variant.Outlined" Margin="Margin.Dense"
                     Value="@_selectedDrive" ValueChanged="HandleDriveSelectionAsync"
                     Style="min-width: 200px; max-width: 300px;">
            @foreach (var drive in _drives)
            {
              <MudSelectItem T="string" Value="@drive.Name">
                <div style="display: flex; align-items: center; gap: 8px;">
                  <MudIcon Icon="@GetDriveIcon(drive.DriveType)" Size="Size.Small" />
                  <span>@drive.Label</span>
                  @if (drive.IsReady && drive.TotalSize > 0)
                  {
                    <span style="font-size: 0.8rem; color: var(--mud-palette-text-secondary);">
                      (@FormatBytes(drive.AvailableSpace) free)
                    </span>
                  }
                </div>
              </MudSelectItem>
            }
          </MudSelect>
        }
      </div>

      <!-- Custom Path Entry -->
      <div style="margin-bottom: 12px; display: flex; gap: 8px; align-items: flex-start; flex-shrink: 0;">
        <MudTextField @bind-Value="_browserCustomPath"
                      id="browser-custom-path-input"
                      Label="Path (e.g., \\server\share, /mnt/nas, C:\Music)"
                      Variant="Variant.Outlined" Margin="Margin.Dense"
                      OnKeyUp="@(async (e) => { if (e.Key == "Enter") await NavigateToCustomPathAsync(); })"
                      Style="flex: 1;" />
        <MudIconButton Icon="@Icons.Material.Filled.Keyboard"
                       Color="Color.Primary" Size="Size.Large"
                       Style="min-width: 48px; min-height: 48px;"
                       OnClick="ToggleVirtualKeyboard" title="Virtual Keyboard" />
        <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Medium"
                   OnClick="NavigateToCustomPathAsync" StartIcon="@Icons.Material.Filled.ArrowForward">Go</MudButton>
      </div>

      <!-- Breadcrumbs + Search -->
      <div style="display: flex; gap: 16px; margin-bottom: 12px; flex-shrink: 0; align-items: center;">
        <MudBreadcrumbs Items="@_browserBreadcrumbs" Style="padding: 0; flex: 1;">
          <ItemTemplate Context="item">
            <MudLink Href="#" OnClick="@(() => BrowserNavigateToPath(item.Href ?? "/"))" Style="cursor: pointer;">@item.Text</MudLink>
          </ItemTemplate>
        </MudBreadcrumbs>
        <MudTextField @bind-Value="_browserSearchQuery"
                      Label="Search" Variant="Variant.Outlined" Margin="Margin.Dense"
                      Adornment="Adornment.End" AdornmentIcon="@Icons.Material.Filled.Search"
                      OnKeyUp="@(async (e) => { if (e.Key == "Enter") await LoadBrowserFilesAsync(); })"
                      Style="max-width: 250px;" />
        <MudSelect T="string" @bind-Value="_browserFilterExtension" Label="Filter" Variant="Variant.Outlined" Margin="Margin.Dense" Style="min-width: 120px;">
          <MudSelectItem Value="@("*")">All</MudSelectItem>
          <MudSelectItem Value="@(".mp3")">MP3</MudSelectItem>
          <MudSelectItem Value="@(".flac")">FLAC</MudSelectItem>
          <MudSelectItem Value="@(".wav")">WAV</MudSelectItem>
          <MudSelectItem Value="@(".ogg")">OGG</MudSelectItem>
          <MudSelectItem Value="@(".m4a")">M4A</MudSelectItem>
        </MudSelect>
      </div>

      <!-- File List -->
      @if (_isBrowserLoading)
      {
        <div style="flex: 1; display: flex; justify-content: center; align-items: center;">
          <MudProgressCircular Color="Color.Primary" Indeterminate="true" />
        </div>
      }
      else if (!_browserFileItems.Any())
      {
        <div style="flex: 1; display: flex; flex-direction: column; align-items: center; justify-content: center; color: var(--text-secondary);">
          <MudIcon Icon="@Icons.Material.Filled.FolderOff" Style="font-size: 80px; margin-bottom: 12px; opacity: 0.5;" />
          <MudText Typo="Typo.h6">No audio files found</MudText>
          <MudText Typo="Typo.body2" Style="margin-top: 4px;">Try a different directory or search term</MudText>
        </div>
      }
      else
      {
        <div style="flex: 1; overflow-y: auto;">
          <MudList T="string" Dense="true">
            @foreach (var item in _browserFileItems.Where(f => f.IsDirectory))
            {
              <MudListItem T="string" Icon="@Icons.Material.Filled.Folder" IconColor="Color.Primary"
                           @onclick="@(() => BrowserNavigateToDirectory(item.Path))">
                <MudText Typo="Typo.body1" Style="font-weight: 500;">@item.Name</MudText>
              </MudListItem>
              <MudDivider />
            }
            @foreach (var item in _browserFileItems.Where(f => !f.IsDirectory))
            {
              <MudListItem T="string" Icon="@Icons.Material.Filled.MusicNote" IconColor="Color.Default" Style="min-height: 60px;">
                <div style="display: flex; justify-content: space-between; align-items: center; width: 100%;">
                  <div style="flex: 1; min-width: 0;">
                    <div style="font-weight: 500; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">
                      @(!string.IsNullOrEmpty(item.Artist) ? $"{item.Artist} - {item.Name}" : item.Name)
                    </div>
                    @if (!string.IsNullOrEmpty(item.Album) || !string.IsNullOrEmpty(item.Duration))
                    {
                      <div style="font-size: 0.85rem; color: var(--mud-palette-text-secondary);">
                        @item.Album @(!string.IsNullOrEmpty(item.Album) && !string.IsNullOrEmpty(item.Duration) ? " · " : "") @item.Duration
                      </div>
                    }
                  </div>
                  <div style="display: flex; gap: 4px; flex-shrink: 0;">
                    <MudIconButton Icon="@Icons.Material.Filled.PlayArrow" Size="Size.Medium"
                                   Style="min-width: 48px; min-height: 48px;"
                                   OnClick="@(() => HandlePlayFileAsync(item.Path))" title="Play" />
                    <MudIconButton Icon="@Icons.Material.Filled.Add" Size="Size.Medium"
                                   Style="min-width: 48px; min-height: 48px;"
                                   OnClick="@(() => HandleBrowserAddToQueueAsync(item.Path))" title="Add to Queue" />
                  </div>
                </div>
              </MudListItem>
              <MudDivider />
            }
          </MudList>
        </div>
      }
    </div>
  }
  </div>

  <!-- Right: Queue List (always visible) -->
  <div class="panel surface-raised" style="width: 50%; display: flex; flex-direction: column; overflow: hidden; padding: 12px;">
    <div class="panel-header" style="padding: 8px 4px;">
      <span>Queue (@_queueItems.Count tracks)</span>
      <div style="display: flex; gap: 4px;">
        <MudIconButton Icon="@Icons.Material.Filled.Save" Color="Color.Primary" Size="Size.Small"
                       Disabled="@(!_queueItems.Any())" OnClick="OpenSavePlaylistDialogAsync" title="Save Playlist" />
        @if (_canReorderQueue && _queueItems.Any())
        {
          <MudIconButton Icon="@Icons.Material.Filled.DragIndicator"
                         Color="@(_isDragEnabled ? Color.Success : Color.Default)" Size="Size.Small"
                         OnClick="@(() => { _isDragEnabled = !_isDragEnabled; StateHasChanged(); })"
                         title="@(_isDragEnabled ? "Disable Drag" : "Enable Drag")" />
        }
        <MudIconButton Icon="@Icons.Material.Filled.DeleteSweep" Color="Color.Error" Size="Size.Small"
                       Disabled="@(!_queueItems.Any())" OnClick="HandleClearQueueAsync" title="Clear All" />
      </div>
    </div>
  @{
    @if (!_queueItems.Any())
    {
      <div style="flex: 1; display: flex; flex-direction: column; align-items: center; justify-content: center; color: var(--text-low);">
        <MudIcon Icon="@Icons.Material.Filled.QueueMusic" Style="font-size: 80px; opacity: 0.4; margin-bottom: 12px;" />
        <span style="font-size: 16px;">No tracks in queue</span>
        <span style="font-size: 14px; color: var(--text-low); margin-top: 4px;">Browse files on the left to add tracks</span>
      </div>
    }
    else if (_isDragEnabled && _canReorderQueue)
    {
      <MudList T="string" Class="queue-drop-container" Style="flex: 1; overflow-y: auto;">
        @foreach (var item in _queueItems)
        {
          <MudListItem T="string" @key="item.Index">
            <MudPaper Class="queue-item-draggable"
                      Elevation="2"
                      Style="@GetItemStyle(item, enhancedPadding: true)"
                      draggable="true"
                      @ondragstart="@(() => OnDragStart(item))"
                      @ondragover:preventDefault
                      @ondrop="@(() => OnDrop(item))">
              <div style="display: grid; grid-template-columns: 72px 1fr 250px 200px 80px 80px; align-items: center; gap: 12px; padding: 16px;">
                <div style="display: flex; align-items: center; justify-content: center;">
                  <MudIcon Icon="@Icons.Material.Filled.DragIndicator" Size="Size.Large" Style="cursor: grab;" />
                </div>
                <div @onclick="@(() => HandleJumpToAsync(item.Index))" style="cursor: pointer; font-weight: @(item.IsCurrent ? "600" : "400"); color: @(item.IsCurrent ? "var(--mud-palette-primary)" : "inherit"); font-size: 1.1rem;">
                  @item.Title
                </div>
                <div style="font-size: 1rem;">@item.Artist</div>
                <div style="font-size: 1rem;">@item.Album</div>
                <div style="font-size: 1rem;">@item.Duration</div>
                <div>
                  <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                 Size="Size.Large"
                                 OnClick="@(() => HandleRemoveAsync(item.Index))"
                                 title="Remove"
                                 Style="width: 60px; height: 60px;" />
                </div>
              </div>
            </MudPaper>
          </MudListItem>
        }
      </MudList>
    }
    else
    {
      @if (_queueItems.Count == 1)
      {
        <div style="padding: 24px 0 16px 0; text-align: center; flex-shrink: 0;">
          <MudText Typo="Typo.body2" Color="Color.Secondary">1 track in queue</MudText>
        </div>
      }
      <MudTable Items="@_queueItems" Hover="true" Dense="false" FixedHeader="true" Height="400px" Style="overflow-y: auto;">
        <HeaderContent>
          <MudTh Style="width: 60px; font-size: 1rem;">#</MudTh>
          <MudTh Style="font-size: 1rem;">Title</MudTh>
          <MudTh Style="width: 250px; font-size: 1rem;">Artist</MudTh>
          <MudTh Style="width: 200px; font-size: 1rem;">Album</MudTh>
          <MudTh Style="width: 100px; font-size: 1rem;">Duration</MudTh>
          <MudTh Style="width: 100px; font-size: 1rem;">Actions</MudTh>
        </HeaderContent>
        <RowTemplate>
          <MudTd Style="width: 60px; min-height: 60px; font-size: 1rem;">
            @if (context.IsCurrent)
            {
              <div class="now-playing-bars"><span></span><span></span><span></span></div>
            }
            else
            {
              @context.Index
            }
          </MudTd>
          <MudTd DataLabel="Title" Style="cursor: pointer; min-height: 60px; padding: 16px 8px;" @onclick="@(() => HandleJumpToAsync(context.Index))">
            <div style="font-weight: @(context.IsCurrent ? "600" : "400"); color: @(context.IsCurrent ? "var(--mud-palette-primary)" : "inherit"); font-size: 1.1rem; line-height: 1.5;">
              @context.Title
            </div>
          </MudTd>
          <MudTd DataLabel="Artist" Style="width: 250px; min-height: 60px; padding: 16px 8px; font-size: 1rem;">@context.Artist</MudTd>
          <MudTd DataLabel="Album" Style="width: 200px; min-height: 60px; padding: 16px 8px; font-size: 1rem;">@context.Album</MudTd>
          <MudTd DataLabel="Duration" Style="width: 100px; min-height: 60px; padding: 16px 8px; font-size: 1rem;">@context.Duration</MudTd>
          <MudTd DataLabel="Actions" Style="width: 100px; min-height: 60px; padding: 16px 8px;">
            <MudIconButton Icon="@Icons.Material.Filled.Delete"
                           Size="Size.Large"
                           OnClick="@(() => HandleRemoveAsync(context.Index))"
                           title="Remove"
                           Style="width: 60px; height: 60px;" />
          </MudTd>
        </RowTemplate>
      </MudTable>
    }
  }
  </div>
</div>

@code {
  // ─── Queue state ───
  private List<QueueItemDto> _queueItems = new();
  private bool _isDragEnabled = false;
  private bool _canReorderQueue = false;
  private QueueItemDto? _draggedItem = null;
  private CancellationTokenSource? _queueSaveDebounceCts;
  private static readonly TimeSpan QueueSaveDebounceDelay = TimeSpan.FromMilliseconds(500);

  // ─── File browser state ───
  private string _browserPath = "/";
  private string _browserRootPath = "/";
  private string _browserSearchQuery = "";
  private string _browserFilterExtension = "*";
  private bool _isBrowserLoading = false;
  private List<FileItemDto> _browserFileItems = new();
  private List<MudBlazor.BreadcrumbItem> _browserBreadcrumbs = new();
  private List<DriveInfoDto>? _drives = null;
  private string _selectedDrive = "/";
  private string _browserCustomPath = "";
  private IJSObjectReference? _keyboardModule;

  // ─── Lifecycle ───

  protected override async Task OnInitializedAsync()
  {
    await LoadPreferencesAsync();
    await CheckQueueCapabilitiesAsync();

    HubService.QueueChanged += OnQueueChanged;
    HubService.SourceChanged += OnSourceChanged;

    if (!HubService.IsConnected)
    {
      try { await HubService.StartAsync(); }
      catch (Exception ex) { Logger.LogWarning(ex, "Failed to connect to SignalR hub"); }
    }

    await RefreshQueueAsync();

    // Pre-load file browser data
    await LoadDrivesAsync();
    await LoadBrowserPreferencesAsync();
    await LoadBrowserFilesAsync();
    UpdateBrowserBreadcrumbs();
  }

  protected override async Task OnAfterRenderAsync(bool firstRender)
  {
    if (firstRender)
    {
      try
      {
        _keyboardModule = await JSRuntime.InvokeAsync<IJSObjectReference>(
          "import", "./js/virtual-keyboard.js");
      }
      catch (Exception ex) { Logger.LogError(ex, "Failed to load virtual keyboard module"); }
    }
  }

  // ─── Queue methods ───

  private async Task CheckQueueCapabilitiesAsync()
  {
    try
    {
      var state = await AudioApi.GetPlaybackStateAsync();
      _canReorderQueue = state?.CanReorderQueue ?? false;
    }
    catch (Exception ex)
    {
      Logger.LogWarning(ex, "Failed to check queue capabilities");
      _canReorderQueue = false;
    }
  }

  private async Task LoadPreferencesAsync()
  {
    try
    {
      var prefs = await ConfigApi.GetConfigurationAsync<Dictionary<string, object>>("ui.queue");
      if (prefs != null)
      {
        if (prefs.TryGetValue("dragEnabled", out var dragEnabled))
          _isDragEnabled = Convert.ToBoolean(dragEnabled);
      }
    }
    catch (Exception ex) { Logger.LogWarning(ex, "Failed to load preferences for Queue page"); }
  }

  private async Task ScheduleQueueSaveAsync()
  {
    _queueSaveDebounceCts?.Cancel();
    _queueSaveDebounceCts?.Dispose();
    _queueSaveDebounceCts = new CancellationTokenSource();
    var ct = _queueSaveDebounceCts.Token;

    try
    {
      await Task.Delay(QueueSaveDebounceDelay, ct);
      if (!ct.IsCancellationRequested) await QueuePersistence.SaveQueueStateAsync();
    }
    catch (TaskCanceledException) { }
    catch (Exception ex) { Logger.LogWarning(ex, "Failed to auto-save queue state"); }
  }

  private async Task OnQueueChanged()
  {
    await RefreshQueueAsync();
    _ = ScheduleQueueSaveAsync();
    await InvokeAsync(StateHasChanged);
  }

  private async Task OnSourceChanged()
  {
    await CheckQueueCapabilitiesAsync();
    await InvokeAsync(StateHasChanged);
  }

  private async Task RefreshQueueAsync()
  {
    try
    {
      var queue = await QueueApi.GetQueueAsync();
      if (queue != null) _queueItems = queue;
    }
    catch { }
  }

  private void OnDragStart(QueueItemDto item) => _draggedItem = item;

  private async Task OnDrop(QueueItemDto targetItem)
  {
    if (_draggedItem == null || _draggedItem == targetItem) return;
    try
    {
      var success = await QueueApi.MoveItemAsync(_draggedItem.Index, targetItem.Index);
      if (success) { Snackbar.Add("Queue reordered", Severity.Success); }
      else { Snackbar.Add("Failed to reorder queue", Severity.Error); }
      await RefreshQueueAsync();
    }
    catch (Exception ex)
    {
      Logger.LogError(ex, "Failed to reorder queue items");
      Snackbar.Add("Error reordering queue", Severity.Error);
      await RefreshQueueAsync();
    }
    finally { _draggedItem = null; }
  }

  private async Task HandleJumpToAsync(int index)
  {
    try { await QueueApi.JumpToPositionAsync(index); }
    catch { }
  }

  private async Task HandleRemoveAsync(int index)
  {
    try { if (await QueueApi.RemoveFromQueueAsync(index)) await RefreshQueueAsync(); }
    catch { }
  }

  private async Task HandleClearQueueAsync()
  {
    try { if (await QueueApi.ClearQueueAsync()) _queueItems.Clear(); }
    catch { }
  }

  private string GetItemStyle(QueueItemDto item, bool enhancedPadding = false)
  {
    var minHeight = enhancedPadding ? "min-height: 72px;" : "min-height: 60px;";
    var baseStyle = $"{minHeight} cursor: pointer;";
    return item.IsCurrent ? baseStyle + " border-left: 4px solid var(--mud-palette-primary);" : baseStyle;
  }

  private async Task OpenSavePlaylistDialogAsync()
  {
    var options = new DialogOptions
    {
      CloseButton = true,
      MaxWidth = MaxWidth.False,
      FullWidth = true,
      BackgroundClass = "bottom-sheet-backdrop",
      Position = DialogPosition.BottomCenter,
      BackdropClick = true
    };
    await DialogService.ShowAsync<Radio.Web.Components.Dialogs.SavePlaylistDialog>("Save Playlist", options);
  }

  private async Task OpenLoadPlaylistDialogAsync()
  {
    var options = new DialogOptions
    {
      CloseButton = true,
      MaxWidth = MaxWidth.False,
      FullWidth = true,
      BackgroundClass = "bottom-sheet-backdrop",
      Position = DialogPosition.BottomCenter,
      BackdropClick = true
    };
    var dialog = await DialogService.ShowAsync<Radio.Web.Components.Dialogs.LoadPlaylistDialog>("Load Playlist", options);
    var result = await dialog.Result;
    if (result != null && !result.Canceled)
    {
      await RefreshQueueAsync();
      StateHasChanged();
    }
  }

  // ─── File browser methods ───

  private async Task LoadBrowserPreferencesAsync()
  {
    try
    {
      var prefs = await ConfigApi.GetConfigurationAsync<Dictionary<string, object>>("ui.filebrowser");
      if (prefs != null)
      {
        if (prefs.TryGetValue("lastPath", out var pathObj) && pathObj != null)
          _browserPath = pathObj.ToString() ?? "/";
        if (prefs.TryGetValue("filterExtension", out var filterObj) && filterObj != null)
        {
          var filter = filterObj.ToString() ?? "*";
          var validFilters = new HashSet<string> { "*", ".mp3", ".flac", ".wav", ".ogg", ".m4a" };
          _browserFilterExtension = validFilters.Contains(filter) ? filter : "*";
        }
      }
    }
    catch (Exception ex) { Logger.LogWarning(ex, "Failed to load file browser preferences"); }
  }

  private async Task SaveBrowserPreferenceAsync(string key, object value)
  {
    try { await ConfigApi.UpdateConfigurationAsync("ui.filebrowser", key, value); }
    catch (Exception ex) { Logger.LogWarning(ex, "Failed to save browser preference {Key}", key); }
  }

  private async Task LoadBrowserFilesAsync()
  {
    _isBrowserLoading = true;
    try
    {
      var result = await FileApi.ListFilesAsync(_browserPath, false);
      if (result != null)
      {
        _browserFileItems = result.Items ?? new List<FileItemDto>();
        if (_browserFilterExtension != "*")
          _browserFileItems = _browserFileItems.Where(f => f.IsDirectory || f.Name.EndsWith(_browserFilterExtension, StringComparison.OrdinalIgnoreCase)).ToList();
        if (!string.IsNullOrWhiteSpace(_browserSearchQuery))
          _browserFileItems = _browserFileItems.Where(f =>
            f.Name.Contains(_browserSearchQuery, StringComparison.OrdinalIgnoreCase) ||
            f.Artist?.Contains(_browserSearchQuery, StringComparison.OrdinalIgnoreCase) == true ||
            f.Album?.Contains(_browserSearchQuery, StringComparison.OrdinalIgnoreCase) == true).ToList();
        _browserFileItems = _browserFileItems.OrderByDescending(f => f.IsDirectory).ThenBy(f => f.Name).ToList();
      }
    }
    catch { }
    finally { _isBrowserLoading = false; }
  }

  private void UpdateBrowserBreadcrumbs()
  {
    _browserBreadcrumbs.Clear();
    _browserBreadcrumbs.Add(new MudBlazor.BreadcrumbItem("Home", href: _browserRootPath, icon: Icons.Material.Filled.Home));
    if (_browserPath != _browserRootPath)
    {
      var parts = _browserPath.Split('/', StringSplitOptions.RemoveEmptyEntries);
      var path = "";
      foreach (var part in parts)
      {
        path += "/" + part;
        _browserBreadcrumbs.Add(new MudBlazor.BreadcrumbItem(part, href: path));
      }
    }
  }

  private async Task BrowserNavigateToDirectory(string path)
  {
    _browserPath = path;
    UpdateBrowserBreadcrumbs();
    await LoadBrowserFilesAsync();
    await SaveBrowserPreferenceAsync("lastPath", _browserPath);
  }

  private async Task BrowserNavigateToPath(string path)
  {
    _browserPath = path;
    UpdateBrowserBreadcrumbs();
    await LoadBrowserFilesAsync();
    await SaveBrowserPreferenceAsync("lastPath", _browserPath);
  }

  private async Task HandleBrowserHomeAsync()
  {
    _browserPath = _browserRootPath;
    UpdateBrowserBreadcrumbs();
    await LoadBrowserFilesAsync();
    await SaveBrowserPreferenceAsync("lastPath", _browserPath);
  }

  private async Task HandleBrowserUpAsync()
  {
    if (_browserPath == _browserRootPath) return;
    var lastSlash = _browserPath.TrimEnd('/').LastIndexOf('/');
    _browserPath = lastSlash > 0 ? _browserPath.Substring(0, lastSlash) : _browserRootPath;
    UpdateBrowserBreadcrumbs();
    await LoadBrowserFilesAsync();
    await SaveBrowserPreferenceAsync("lastPath", _browserPath);
  }

  private async Task HandlePlayFileAsync(string path)
  {
    try { await FileApi.PlayFileAsync(path); }
    catch { }
  }

  private async Task HandleBrowserAddToQueueAsync(string path)
  {
    try
    {
      var success = await FileApi.AddFileToQueueAsync(path);
      if (success)
      {
        Snackbar.Add("Added to queue", Severity.Success);
        await RefreshQueueAsync();
      }
    }
    catch { }
  }

  private async Task LoadDrivesAsync()
  {
    try
    {
      _drives = await FileApi.GetDrivesAsync();
      if (_drives != null && _drives.Any())
      {
        if (RuntimeInformation.IsOSPlatform(OSPlatform.Windows))
          _selectedDrive = _browserPath.Length >= 2 && _browserPath[1] == ':' ? _browserPath.Substring(0, 3) : _drives.FirstOrDefault()?.Name ?? "/";
        else
          _selectedDrive = "/";
      }
    }
    catch (Exception ex) { Logger.LogWarning(ex, "Failed to load drives"); }
  }

  private async Task HandleDriveSelectionAsync(string driveName)
  {
    if (string.IsNullOrEmpty(driveName)) return;
    _selectedDrive = driveName;
    _browserPath = driveName;
    _browserRootPath = driveName;
    UpdateBrowserBreadcrumbs();
    await LoadBrowserFilesAsync();
    await SaveBrowserPreferenceAsync("lastPath", _browserPath);
  }

  private async Task NavigateToCustomPathAsync()
  {
    if (string.IsNullOrWhiteSpace(_browserCustomPath)) return;
    try
    {
      var normalized = NormalizePath(_browserCustomPath.Trim());
      if (!IsValidPath(normalized))
      {
        Snackbar.Add("Invalid path format", Severity.Warning);
        return;
      }
      _browserPath = normalized;
      _browserRootPath = normalized;
      _selectedDrive = normalized;
      UpdateBrowserBreadcrumbs();
      await LoadBrowserFilesAsync();
      await SaveBrowserPreferenceAsync("lastPath", _browserPath);
      _browserCustomPath = "";
    }
    catch (Exception ex) { Logger.LogError(ex, "Failed to navigate to path: {Path}", _browserCustomPath); }
  }

  private async Task ToggleVirtualKeyboard()
  {
    if (_keyboardModule == null) return;
    try { await _keyboardModule.InvokeVoidAsync("toggleForInput", "#browser-custom-path-input input"); }
    catch (Exception ex) { Logger.LogError(ex, "Failed to toggle virtual keyboard"); }
  }

  private static string GetDriveIcon(string driveType) => driveType switch
  {
    "Fixed" => Icons.Material.Filled.Storage,
    "Removable" => Icons.Material.Filled.Usb,
    "Network" => Icons.Material.Filled.Cloud,
    "CDRom" => Icons.Material.Filled.Album,
    _ => Icons.Material.Filled.Folder
  };

  private static string FormatBytes(long bytes)
  {
    string[] sizes = { "B", "KB", "MB", "GB", "TB" };
    double len = bytes;
    int order = 0;
    while (len >= 1024 && order < sizes.Length - 1) { order++; len /= 1024; }
    return $"{len:0.##} {sizes[order]}";
  }

  private static string NormalizePath(string path)
  {
    if (path.StartsWith("\\\\") || path.StartsWith("//")) return path.Replace("/", "\\");
    if (RuntimeInformation.IsOSPlatform(OSPlatform.Windows) && path.Length >= 2 && path[1] == ':') return path.Replace("/", "\\");
    if (path.StartsWith("/")) return path.Replace("\\", "/");
    return path.Replace("\\", "/");
  }

  private static bool IsValidPath(string path)
  {
    if (string.IsNullOrWhiteSpace(path)) return false;
    if (path.StartsWith("\\\\") && path.Length > 3) return true;
    if (path.Length >= 3 && path[1] == ':' && (path[2] == '\\' || path[2] == '/')) return true;
    if (path.StartsWith("/")) return true;
    return false;
  }

  // ─── Dispose ───

  public async ValueTask DisposeAsync()
  {
    _queueSaveDebounceCts?.Cancel();
    _queueSaveDebounceCts?.Dispose();
    HubService.QueueChanged -= OnQueueChanged;
    HubService.SourceChanged -= OnSourceChanged;

    if (_keyboardModule != null)
    {
      try { await _keyboardModule.DisposeAsync(); }
      catch (Exception ex) { Logger.LogWarning(ex, "Error disposing keyboard module"); }
    }
  }
}
