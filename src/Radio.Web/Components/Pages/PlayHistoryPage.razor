@page "/history"
@using Radio.Web.Services.ApiClients
@using Radio.Web.Models
@using Radio.Web.Components.Shared
@inject PlayHistoryApiService HistoryApi
@inject ConfigurationApiService ConfigApi
@inject ILogger<PlayHistoryPage> Logger
@inject NotificationService NotificationService
@implements IDisposable

<PageTitle>Play History - Radio Console</PageTitle>

<div style="height: 100%; display: flex; gap: 2px; overflow: hidden;">
  <!-- Left: Filters & Statistics -->
  <div class="panel surface-raised" style="width: 360px; flex-shrink: 0; overflow: hidden; padding: 12px; display: flex; flex-direction: column;">
    <div class="history-filter-scroll" style="display:flex; flex-direction:column; gap:8px; overflow-y: auto; overflow-x: hidden; flex: 1; min-height: 0;">
      <h6>Play History</h6>

      <RadzenDatePicker TValue="DateTime?" @bind-Value="_selectedDate" AllowClear="true" Placeholder="Filter by Date" />

      <RadzenDropDown TValue="string"
                      Value="_sourceFilter"
                      Change="@(async (object val) => await SetSourceFilterAsync(val?.ToString() ?? "All"))"
                      Data="@_sourceFilterOptions"
                      TextProperty="Text"
                      ValueProperty="Value"
                      AllowClear="true"
                      Placeholder="Source Filter" />

      <RadzenTextBox @bind-Value="_searchQuery"
                     Placeholder="Search title, artist, album..."
                     @onkeyup="@OnSearchKeyUp" />

      <div style="display:flex; gap:6px;">
        <RadzenButton Text="Filter"
                      Icon="filter_list"
                      ButtonStyle="ButtonStyle.Primary"
                      Variant="Variant.Filled"
                      Click="@ApplyFilters"
                      Style="flex:1" />
        <RadzenButton Text="Clear"
                      Icon="filter_list_off"
                      ButtonStyle="ButtonStyle.Secondary"
                      Variant="Variant.Outlined"
                      Click="@ClearAllFilters"
                      Style="flex:1" />
      </div>

      @if (_stats != null)
      {
        <hr style="border-color:var(--surface-separator); margin:4px 0" />
        <span style="font-size:0.875rem; font-weight:500; color: var(--text-medium); text-transform: uppercase; letter-spacing: 0.05em;">Statistics</span>
        <RadzenRow Gap="4px">
          <RadzenColumn Size="6">
            <span style="font-size:0.75rem; color:var(--text-low)">Total Plays</span>
            <h6 style="color:var(--rz-primary)">@_stats.TotalPlays</h6>
          </RadzenColumn>
          <RadzenColumn Size="6">
            <span style="font-size:0.75rem; color:var(--text-low)">Identified</span>
            <h6 style="color:var(--rz-primary)">@_stats.IdentifiedPlays</h6>
          </RadzenColumn>
          <RadzenColumn Size="12">
            <span style="font-size:0.75rem; color:var(--text-low)">Top Track</span>
            <span style="font-size:0.875rem">@(_stats.TopTracks.FirstOrDefault()?.Title ?? "-")</span>
          </RadzenColumn>
          <RadzenColumn Size="12">
            <span style="font-size:0.75rem; color:var(--text-low)">Top Artist</span>
            <span style="font-size:0.875rem">@(_stats.TopArtists.FirstOrDefault()?.Artist ?? "-")</span>
          </RadzenColumn>
        </RadzenRow>

        @if (_stats.PlaysBySource.Any())
        {
          <div style="display: flex; gap: 4px; flex-wrap: wrap;">
            @foreach (var source in _stats.PlaysBySource)
            {
              <RadzenBadge BadgeStyle="BadgeStyle.Info" IsPill="true" Text="@($"{source.Key}: {source.Value}")" />
            }
          </div>
        }
      }
    </div>
  </div>

  <!-- Right: History List -->
  <div class="panel surface-raised" style="flex: 1; overflow: hidden; padding: 16px; display: flex; flex-direction: column;">
    <div style="display:flex; flex-direction:row; justify-content:space-between; align-items:center; margin-bottom:12px; flex-shrink: 0;">
      <h6>History (@(_historyData?.TotalCount ?? 0) items)</h6>
      <div>
        <RadzenButton Text="Refresh"
                      Icon="refresh"
                      ButtonStyle="ButtonStyle.Info"
                      Variant="Variant.Outlined"
                      Size="ButtonSize.Small"
                      Click="@RefreshHistory"
                      Style="margin-right:8px" />
        @if (_historyData?.Items.Any() == true)
        {
          <RadzenButton Text="Clear All"
                        Icon="delete_sweep"
                        ButtonStyle="ButtonStyle.Danger"
                        Variant="Variant.Outlined"
                        Size="ButtonSize.Small"
                        Click="@ShowClearHistoryDialog" />
        }
      </div>
    </div>

    @if (_isLoading)
    {
      @* PR 4: panel-body initial-load shows skeleton rows so the
         placeholder reads as the grid that's about to appear. *@
      <div style="padding: 8px 0;">
        <Skeleton Shape="Skeleton.SkeletonShape.ListRow" />
        <Skeleton Shape="Skeleton.SkeletonShape.ListRow" />
        <Skeleton Shape="Skeleton.SkeletonShape.ListRow" />
        <Skeleton Shape="Skeleton.SkeletonShape.ListRow" />
        <Skeleton Shape="Skeleton.SkeletonShape.ListRow" />
      </div>
    }
    else if (_historyData?.Items.Any() == true)
    {
      <RadzenDataGrid TItem="PlayHistoryEntryDto"
                      Data="@_historyData.Items"
                      Density="Density.Compact"
                      AllowPaging="true"
                      PageSize="@_pageSize"
                      Count="@(_historyData.TotalCount)"
                      LoadData="@OnLoadData"
                      Style="flex: 1; overflow: auto;">
        <Columns>
          <RadzenDataGridColumn TItem="PlayHistoryEntryDto" Title="" Width="48px" Sortable="false" Filterable="false">
            <Template Context="item">
              @if (!string.IsNullOrEmpty(item.Track?.CoverArtUrl)
                && item.Track.CoverArtUrl != "/images/default-album-art.png")
              {
                <img src="@item.Track.CoverArtUrl"
                     style="width: 40px; height: 40px; border-radius: 4px; object-fit: cover;"
                     loading="lazy" />
              }
              else
              {
                <RadzenIcon Icon="@SourceTypeHelper.GetIcon(item.Source)"
                            Style="color: var(--text-low); width: 40px;" />
              }
            </Template>
          </RadzenDataGridColumn>
          <RadzenDataGridColumn TItem="PlayHistoryEntryDto" Title="Date/Time" Sortable="false" Filterable="false">
            <Template Context="item">
              @* Relative-time projection: "Today HH:mm", "Yesterday HH:mm", or "MMM d · HH:mm".
                 Caller must convert UTC → local; Timestamps.FormatRelative does not assume timezone. *@
              <span style="font-family: var(--font-mono); font-variant-numeric: tabular-nums;"
                    title="@item.PlayedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm:ss")">
                @Timestamps.FormatRelative(item.PlayedAt.ToLocalTime())
              </span>
            </Template>
          </RadzenDataGridColumn>
          <RadzenDataGridColumn TItem="PlayHistoryEntryDto" Title="Title" Property="Title" Sortable="false" Filterable="false" />
          <RadzenDataGridColumn TItem="PlayHistoryEntryDto" Title="Artist" Property="Artist" Sortable="false" Filterable="false" />
          <RadzenDataGridColumn TItem="PlayHistoryEntryDto" Title="Album" Property="Album" Sortable="false" Filterable="false" />
          <RadzenDataGridColumn TItem="PlayHistoryEntryDto" Title="Source" Sortable="false" Filterable="false">
            <Template Context="item">
              <RadzenBadge BadgeStyle="@GetSourceBadgeStyle(item.Source)" IsPill="true" Text="@item.Source" />
            </Template>
          </RadzenDataGridColumn>
          <RadzenDataGridColumn TItem="PlayHistoryEntryDto" Title="Duration" Sortable="false" Filterable="false" TextAlign="TextAlign.Right">
            <Template Context="item">
              <span style="font-family: var(--font-mono); font-variant-numeric: tabular-nums;">
                @FormatDuration(item.DurationSeconds)
              </span>
            </Template>
          </RadzenDataGridColumn>
          <RadzenDataGridColumn TItem="PlayHistoryEntryDto" Title="Actions" Width="100px" Sortable="false" Filterable="false">
            <Template Context="item">
              <RadzenButton Icon="info"
                            Size="ButtonSize.Small"
                            ButtonStyle="ButtonStyle.Info"
                            Variant="Variant.Text"
                            Click="@(() => ShowDetailDialog(item))" />
              <RadzenButton Icon="delete"
                            Size="ButtonSize.Small"
                            ButtonStyle="ButtonStyle.Danger"
                            Variant="Variant.Text"
                            Click="@(() => ShowDeleteDialog(item))" />
            </Template>
          </RadzenDataGridColumn>
        </Columns>
      </RadzenDataGrid>
    }
    else
    {
      <div style="display:flex; flex-direction:column; align-items:center; justify-content:center; padding:32px;">
        <RadzenIcon Icon="history" Style="font-size:48px; color:var(--text-low);" />
        <h6 style="color:var(--text-low); margin-top:8px;">No History Found</h6>
        <span style="font-size:0.875rem; color:var(--text-low);">
          Play some music to start building your history
        </span>
      </div>
    }
  </div>
</div>

@* Detail Dialog *@
@if (_showDetailDialog)
{
  <div style="position:fixed; inset:0; background:rgba(0,0,0,0.5); z-index:9999; display:flex; align-items:center; justify-content:center" @onclick="@(() => _showDetailDialog = false)">
    <div style="background:var(--surface-overlay); border:1px solid var(--surface-separator); border-radius:8px; padding:24px; max-width:500px; width:90%" @onclick:stopPropagation>
      <div style="display:flex; flex-direction:row; align-items:center; gap:4px; margin-bottom:16px;">
        <RadzenIcon Icon="info" />
        <h6>Track Details</h6>
      </div>
      @if (_selectedItem != null)
      {
        @if (!string.IsNullOrEmpty(_selectedItem.Track?.CoverArtUrl)
          && _selectedItem.Track.CoverArtUrl != "/images/default-album-art.png")
        {
          <div style="text-align: center; margin-bottom: 16px;">
            <img src="@_selectedItem.Track.CoverArtUrl"
                 style="max-width: 200px; max-height: 200px; border-radius: 8px; object-fit: cover;" />
          </div>
        }
        <RadzenRow Gap="8px">
          <RadzenColumn Size="12">
            <h6>@_selectedItem.Title</h6>
          </RadzenColumn>
          <RadzenColumn Size="6">
            <span style="font-size:0.875rem; font-weight:500; color:var(--text-low)">Artist</span>
            <div>@_selectedItem.Artist</div>
          </RadzenColumn>
          <RadzenColumn Size="6">
            <span style="font-size:0.875rem; font-weight:500; color:var(--text-low)">Album</span>
            <div>@_selectedItem.Album</div>
          </RadzenColumn>
          <RadzenColumn Size="6">
            <span style="font-size:0.875rem; font-weight:500; color:var(--text-low)">Source</span>
            <div>
              <RadzenBadge BadgeStyle="@GetSourceBadgeStyle(_selectedItem.Source)" IsPill="true" Text="@_selectedItem.Source" />
            </div>
          </RadzenColumn>
          <RadzenColumn Size="6">
            <span style="font-size:0.875rem; font-weight:500; color:var(--text-low)">Duration</span>
            <div>@FormatDuration(_selectedItem.DurationSeconds)</div>
          </RadzenColumn>
          @if (!string.IsNullOrEmpty(_selectedItem.SourceDetails))
          {
            <RadzenColumn Size="12">
              <span style="font-size:0.875rem; font-weight:500; color:var(--text-low)">Source Details</span>
              <div>@_selectedItem.SourceDetails</div>
            </RadzenColumn>
          }
          <RadzenColumn Size="6">
            <span style="font-size:0.875rem; font-weight:500; color:var(--text-low)">Played At</span>
            <div>@_selectedItem.PlayedAt.ToString("yyyy-MM-dd HH:mm:ss")</div>
          </RadzenColumn>
          <RadzenColumn Size="6">
            <span style="font-size:0.875rem; font-weight:500; color:var(--text-low)">Track ID</span>
            <div>@_selectedItem.Id</div>
          </RadzenColumn>
        </RadzenRow>
      }
      <div style="display:flex; justify-content:flex-end; margin-top:16px;">
        <RadzenButton Text="Close" Variant="Variant.Text" Click="@(() => _showDetailDialog = false)" />
      </div>
    </div>
  </div>
}

@* Delete Confirmation Dialog *@
@if (_showDeleteDialog)
{
  <div style="position:fixed; inset:0; background:rgba(0,0,0,0.5); z-index:9999; display:flex; align-items:center; justify-content:center" @onclick="@(() => _showDeleteDialog = false)">
    <div style="background:var(--surface-overlay); border:1px solid var(--surface-separator); border-radius:8px; padding:24px; max-width:500px; width:90%" @onclick:stopPropagation>
      <div style="display:flex; flex-direction:row; align-items:center; gap:4px; margin-bottom:16px;">
        <RadzenIcon Icon="warning" Style="color:var(--rz-danger);" />
        <h6>Delete History Item</h6>
      </div>
      <div>Are you sure you want to delete this history item?</div>
      @if (_selectedItem != null)
      {
        <span style="font-size:0.875rem; margin-top:8px; display:block;">
          <strong>@_selectedItem.Title</strong> by @_selectedItem.Artist
        </span>
      }
      <div style="display:flex; justify-content:flex-end; gap:8px; margin-top:16px;">
        <RadzenButton Text="Cancel" Variant="Variant.Text" Click="@(() => _showDeleteDialog = false)" />
        <RadzenButton Text="Delete" ButtonStyle="ButtonStyle.Danger" Variant="Variant.Filled" Click="@ConfirmDelete" />
      </div>
    </div>
  </div>
}

@* Clear All Confirmation Dialog *@
@if (_showClearDialog)
{
  <div style="position:fixed; inset:0; background:rgba(0,0,0,0.5); z-index:9999; display:flex; align-items:center; justify-content:center" @onclick="@(() => _showClearDialog = false)">
    <div style="background:var(--surface-overlay); border:1px solid var(--surface-separator); border-radius:8px; padding:24px; max-width:500px; width:90%" @onclick:stopPropagation>
      <div style="display:flex; flex-direction:row; align-items:center; gap:4px; margin-bottom:16px;">
        <RadzenIcon Icon="warning" Style="color:var(--rz-danger);" />
        <h6>Clear All History</h6>
      </div>
      <div>Are you sure you want to clear ALL play history?</div>
      <span style="font-size:0.875rem; color:var(--rz-danger); margin-top:8px; display:block;">
        This action cannot be undone!
      </span>
      <div style="display:flex; justify-content:flex-end; gap:8px; margin-top:16px;">
        <RadzenButton Text="Cancel" Variant="Variant.Text" Click="@(() => _showClearDialog = false)" />
        <RadzenButton Text="Clear All" ButtonStyle="ButtonStyle.Danger" Variant="Variant.Filled" Click="@ConfirmClearAll" />
      </div>
    </div>
  </div>
}

@code {
  private PlayHistoryListDto? _historyData;
  private PlayHistoryStatsDto? _stats;
  private PlayHistoryEntryDto? _selectedItem;
  private bool _isLoading = true;
  private DateTime? _selectedDate;
  private string _sourceFilter = "All";
  private string _searchQuery = "";
  private int _currentPage = 1;
  private const int _pageSize = 50;
  private bool _showDetailDialog = false;
  private bool _showDeleteDialog = false;
  private bool _showClearDialog = false;

  private readonly List<DropDownItem> _sourceFilterOptions = new()
  {
    new("All", "All Sources"),
    new("File", "File Player"),
    new("Radio", "Radio"),
    new("GenericUSB", "USB Audio"),
    new("Vinyl", "Vinyl"),
    new("Bluetooth", "Bluetooth"),
  };

  private record DropDownItem(string Value, string Text);

  protected override async Task OnInitializedAsync()
  {
    await LoadPreferencesAsync();
    await LoadDataAsync();
  }

  private Task LoadPreferencesAsync()
  {
    // Always start with "All" to avoid confusion from persisted filters
    _sourceFilter = "All";
    return Task.CompletedTask;
  }

  private async Task SavePreferenceAsync(string key, object value)
  {
    try
    {
      await ConfigApi.UpdateConfigurationAsync("ui.history", key, value);
    }
    catch (Exception ex)
    {
      Logger.LogWarning(ex, "Failed to save preference {Key}", key);
    }
  }

  private async Task SetSourceFilterAsync(string filter)
  {
    // Trim and normalize the filter to prevent comparison issues
    _sourceFilter = string.IsNullOrWhiteSpace(filter) ? "All" : filter.Trim();
    await SavePreferenceAsync("sourceFilter", _sourceFilter);
    await LoadDataAsync();
  }

  private async Task LoadDataAsync()
  {
    _isLoading = true;
    StateHasChanged();

    try
    {
      // Load history with pagination
      var offset = (_currentPage - 1) * _pageSize;

      PlayHistoryListDto? result = null;

      // Apply active filters
      // Normalize filter to avoid comparison issues (trim and handle empty/null)
      var normalizedFilter = string.IsNullOrWhiteSpace(_sourceFilter) ? "All" : _sourceFilter.Trim();

      if (!string.IsNullOrWhiteSpace(_searchQuery))
      {
        result = await HistoryApi.SearchHistoryAsync(_searchQuery, _pageSize, offset);
      }
      else if (_selectedDate.HasValue)
      {
        result = await HistoryApi.GetHistoryByDateAsync(_selectedDate.Value, _pageSize, offset);
      }
      else if (!string.Equals(normalizedFilter, "All", StringComparison.OrdinalIgnoreCase))
      {
        // Only call GetHistoryBySourceAsync for specific source filters, not "All"
        result = await HistoryApi.GetHistoryBySourceAsync(normalizedFilter, _pageSize, offset);
      }
      else
      {
        // "All" sources - use the standard history endpoint
        result = await HistoryApi.GetHistoryAsync(_pageSize, offset);
      }

      _historyData = result;

      // Load statistics (only on first load)
      if (_stats == null)
      {
        _stats = await HistoryApi.GetStatsAsync();
      }
    }
    catch (Exception ex)
    {
      NotificationService.Notify(NotificationSeverity.Error, "Error", $"Failed to load history: {ex.Message}");
    }
    finally
    {
      _isLoading = false;
      StateHasChanged();
    }
  }

  private async Task ApplyFilters()
  {
    _currentPage = 1; // Reset to first page when filtering
    await LoadDataAsync();
  }

  private async Task OnSearchKeyUp(KeyboardEventArgs e)
  {
    if (e.Key == "Enter")
    {
      await ApplyFilters();
    }
  }

  private async Task RefreshHistory()
  {
    // Reload data with current filters maintained
    await LoadDataAsync();
    NotificationService.Notify(NotificationSeverity.Success, "Refreshed", "History refreshed");
  }

  private async Task ClearAllFilters()
  {
    // Clear all filter values
    _selectedDate = null;
    _sourceFilter = "All";
    _searchQuery = "";
    _currentPage = 1;

    // Reload with no filters
    await LoadDataAsync();
    NotificationService.Notify(NotificationSeverity.Info, "Filters", "Filters cleared");
  }

  private async Task OnLoadData(LoadDataArgs args)
  {
    _currentPage = (args.Skip ?? 0) / _pageSize + 1;
    await LoadDataAsync();
  }

  private async Task OnPageChanged(int page)
  {
    _currentPage = page;
    await LoadDataAsync();
  }

  private int GetPageCount()
  {
    if (_historyData == null || _historyData.TotalCount == 0)
      return 1;

    return (int)Math.Ceiling(_historyData.TotalCount / (double)_pageSize);
  }

  private void ShowDetailDialog(PlayHistoryEntryDto item)
  {
    _selectedItem = item;
    _showDetailDialog = true;
  }

  private void ShowDeleteDialog(PlayHistoryEntryDto item)
  {
    _selectedItem = item;
    _showDeleteDialog = true;
  }

  private void ShowClearHistoryDialog()
  {
    _showClearDialog = true;
  }

  private async Task ConfirmDelete()
  {
    if (_selectedItem == null) return;

    var success = await HistoryApi.DeleteHistoryItemAsync(_selectedItem.Id);
    if (success)
    {
      NotificationService.Notify(NotificationSeverity.Success, "Deleted", "History item deleted");
      _showDeleteDialog = false;
      await LoadDataAsync();
    }
    else
    {
      NotificationService.Notify(NotificationSeverity.Error, "Error", "Failed to delete history item");
    }
  }

  private async Task ConfirmClearAll()
  {
    var success = await HistoryApi.ClearHistoryAsync();
    if (success)
    {
      NotificationService.Notify(NotificationSeverity.Success, "Cleared", "All history cleared");
      _showClearDialog = false;
      await LoadDataAsync();
    }
    else
    {
      NotificationService.Notify(NotificationSeverity.Error, "Error", "Failed to clear history");
    }
  }

  private BadgeStyle GetSourceBadgeStyle(string source)
  {
    return source switch
    {
      "File" => BadgeStyle.Info,
      "Radio" => BadgeStyle.Warning,
      "GenericUSB" => BadgeStyle.Light,
      "Vinyl" => BadgeStyle.Success,
      "Bluetooth" => BadgeStyle.Secondary,
      _ => BadgeStyle.Light
    };
  }

  /// <summary>
  /// Format a duration-in-seconds value for the history grid. Empty / zero values
  /// surface as "--:--"; positive values route through <see cref="Durations.FormatTrack(TimeSpan)"/>
  /// so the long-form ("h:mm:ss") case is handled identically to the queue rows.
  /// </summary>
  private static string FormatDuration(int? seconds)
  {
    if (!seconds.HasValue || seconds.Value <= 0) return "--:--";
    return Durations.FormatTrack(TimeSpan.FromSeconds(seconds.Value));
  }

  public void Dispose()
  {
    // Cleanup if needed
  }
}
