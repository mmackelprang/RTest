@page "/history"
@using Radio.Web.Services.ApiClients
@using Radio.Web.Models
@inject PlayHistoryApiService HistoryApi
@inject ConfigurationApiService ConfigApi
@inject ILogger<PlayHistoryPage> Logger
@inject ISnackbar Snackbar
@implements IDisposable

<PageTitle>Play History - Radio Console</PageTitle>

<div style="height: 100%; display: flex; gap: 2px; overflow: hidden;">
  <!-- Left: Filters & Statistics -->
  <div class="panel surface-raised" style="width: 360px; flex-shrink: 0; overflow-y: auto; padding: 16px;">
    <MudStack Spacing="3">
      <MudText Typo="Typo.h6">Play History</MudText>

      <MudDatePicker Label="Filter by Date" @bind-Date="_selectedDate" Clearable="true" />

      <MudSelect T="string" Label="Source Filter"
                 Value="_sourceFilter"
                 ValueChanged="@(async (string val) => await SetSourceFilterAsync(val))"
                 Clearable="true">
        <MudSelectItem Value="@("All")">All Sources</MudSelectItem>
        <MudSelectItem Value="@("File")">File Player</MudSelectItem>
        <MudSelectItem Value="@("Radio")">Radio</MudSelectItem>
        <MudSelectItem Value="@("GenericUSB")">USB Audio</MudSelectItem>
        <MudSelectItem Value="@("Vinyl")">Vinyl</MudSelectItem>
        <MudSelectItem Value="@("Bluetooth")">Bluetooth</MudSelectItem>
      </MudSelect>

      <MudTextField T="string" Label="Search"
                    @bind-Value="_searchQuery"
                    Placeholder="Search title, artist, album..."
                    Adornment="Adornment.End"
                    AdornmentIcon="@Icons.Material.Filled.Search"
                    OnKeyUp="@OnSearchKeyUp" />

      <MudButton Color="Color.Primary" Variant="Variant.Filled" FullWidth="true"
                 OnClick="@ApplyFilters" StartIcon="@Icons.Material.Filled.FilterList">
        Filter
      </MudButton>
      <MudButton Color="Color.Secondary" Variant="Variant.Outlined" FullWidth="true"
                 OnClick="@ClearAllFilters" StartIcon="@Icons.Material.Filled.FilterListOff">
        Clear Filters
      </MudButton>

      @if (_stats != null)
      {
        <MudDivider />
        <MudText Typo="Typo.subtitle2" Style="color: var(--text-medium); text-transform: uppercase; letter-spacing: 0.05em;">Statistics</MudText>
        <MudGrid Spacing="1">
          <MudItem xs="6">
            <MudText Typo="Typo.caption" Color="Color.Secondary">Total Plays</MudText>
            <MudText Typo="Typo.h6" Color="Color.Primary">@_stats.TotalPlays</MudText>
          </MudItem>
          <MudItem xs="6">
            <MudText Typo="Typo.caption" Color="Color.Secondary">Identified</MudText>
            <MudText Typo="Typo.h6" Color="Color.Primary">@_stats.IdentifiedPlays</MudText>
          </MudItem>
          <MudItem xs="12">
            <MudText Typo="Typo.caption" Color="Color.Secondary">Top Track</MudText>
            <MudText Typo="Typo.body2">@(_stats.TopTracks.FirstOrDefault()?.Title ?? "-")</MudText>
          </MudItem>
          <MudItem xs="12">
            <MudText Typo="Typo.caption" Color="Color.Secondary">Top Artist</MudText>
            <MudText Typo="Typo.body2">@(_stats.TopArtists.FirstOrDefault()?.Artist ?? "-")</MudText>
          </MudItem>
        </MudGrid>

        @if (_stats.PlaysBySource.Any())
        {
          <div style="display: flex; gap: 4px; flex-wrap: wrap;">
            @foreach (var source in _stats.PlaysBySource)
            {
              <MudChip T="string" Size="Size.Small" Color="Color.Info">@source.Key: @source.Value</MudChip>
            }
          </div>
        }
      }
    </MudStack>
  </div>

  <!-- Right: History List -->
  <div class="panel surface-raised" style="flex: 1; overflow-y: auto; padding: 16px;">
    <MudPaper Elevation="0" Style="background: transparent;">
    <div class="d-flex justify-space-between align-center mb-3">
      <MudText Typo="Typo.h6">History (@(_historyData?.TotalCount ?? 0) items)</MudText>
      <div>
        <MudButton Color="Color.Info" 
                   Variant="Variant.Outlined"
                   Size="Size.Small"
                   OnClick="@RefreshHistory"
                   StartIcon="@Icons.Material.Filled.Refresh"
                   Class="mr-2">
          Refresh
        </MudButton>
        @if (_historyData?.Items.Any() == true)
        {
          <MudButton Color="Color.Error" 
                     Variant="Variant.Outlined"
                     Size="Size.Small"
                     OnClick="@ShowClearHistoryDialog"
                     StartIcon="@Icons.Material.Filled.DeleteSweep">
            Clear All
          </MudButton>
        }
      </div>
    </div>
    
    @if (_isLoading)
    {
      <div class="d-flex justify-center pa-4">
        <MudProgressCircular Color="Color.Primary" Indeterminate="true" />
      </div>
    }
    else if (_historyData?.Items.Any() == true)
    {
      <MudTable Items="@_historyData.Items" 
                Hover="true" 
                Breakpoint="Breakpoint.Sm"
                Dense="true"
                FixedHeader="true"
                Height="400px">
        <HeaderContent>
          <MudTh>Date/Time</MudTh>
          <MudTh>Title</MudTh>
          <MudTh>Artist</MudTh>
          <MudTh>Album</MudTh>
          <MudTh>Source</MudTh>
          <MudTh>Duration</MudTh>
          <MudTh>Actions</MudTh>
        </HeaderContent>
        <RowTemplate>
          <MudTd DataLabel="Date/Time">@context.PlayedAt.ToString("yyyy-MM-dd HH:mm")</MudTd>
          <MudTd DataLabel="Title">@context.Title</MudTd>
          <MudTd DataLabel="Artist">@context.Artist</MudTd>
          <MudTd DataLabel="Album">@context.Album</MudTd>
          <MudTd DataLabel="Source">
            <MudChip T="string" Size="Size.Small" Color="@GetSourceColor(context.Source)">@context.Source</MudChip>
          </MudTd>
          <MudTd DataLabel="Duration">@FormatDuration(context.DurationSeconds)</MudTd>
          <MudTd DataLabel="Actions">
            <MudIconButton Icon="@Icons.Material.Filled.Info" 
                           Size="Size.Small"
                           Color="Color.Info"
                           OnClick="@(() => ShowDetailDialog(context))" />
            <MudIconButton Icon="@Icons.Material.Filled.Delete" 
                           Size="Size.Small"
                           Color="Color.Error"
                           OnClick="@(() => ShowDeleteDialog(context))" />
          </MudTd>
        </RowTemplate>
      </MudTable>
      
      @* Pagination *@
      <div class="d-flex justify-center mt-3">
        <MudPagination Count="@GetPageCount()" 
                       Selected="@_currentPage" 
                       SelectedChanged="@OnPageChanged"
                       ShowFirstButton="true"
                       ShowLastButton="true" />
      </div>
    }
    else
    {
      <div class="d-flex flex-column align-center justify-center pa-8">
        <MudIcon Icon="@Icons.Material.Filled.History" Size="Size.Large" Color="Color.Secondary" />
        <MudText Typo="Typo.h6" Color="Color.Secondary" Class="mt-2">No History Found</MudText>
        <MudText Typo="Typo.body2" Color="Color.Secondary">
          Play some music to start building your history
        </MudText>
      </div>
    }
  </MudPaper>
  </div>
</div>

@* Detail Dialog *@
@if (_showDetailDialog)
{
  <MudDialog>
    <TitleContent>
      <MudText Typo="Typo.h6">
        <MudIcon Icon="@Icons.Material.Filled.Info" Class="mr-1" />
        Track Details
      </MudText>
    </TitleContent>
    <DialogContent>
      @if (_selectedItem != null)
      {
        <MudGrid>
          <MudItem xs="12">
            <MudText Typo="Typo.h6">@_selectedItem.Title</MudText>
          </MudItem>
          <MudItem xs="6">
            <MudText Typo="Typo.subtitle2" Color="Color.Secondary">Artist</MudText>
            <MudText>@_selectedItem.Artist</MudText>
          </MudItem>
          <MudItem xs="6">
            <MudText Typo="Typo.subtitle2" Color="Color.Secondary">Album</MudText>
            <MudText>@_selectedItem.Album</MudText>
          </MudItem>
          <MudItem xs="6">
            <MudText Typo="Typo.subtitle2" Color="Color.Secondary">Source</MudText>
            <MudChip T="string" Size="Size.Small" Color="@GetSourceColor(_selectedItem.Source)">@_selectedItem.Source</MudChip>
          </MudItem>
          <MudItem xs="6">
            <MudText Typo="Typo.subtitle2" Color="Color.Secondary">Duration</MudText>
            <MudText>@FormatDuration(_selectedItem.DurationSeconds)</MudText>
          </MudItem>
          <MudItem xs="6">
            <MudText Typo="Typo.subtitle2" Color="Color.Secondary">Played At</MudText>
            <MudText>@_selectedItem.PlayedAt.ToString("yyyy-MM-dd HH:mm:ss")</MudText>
          </MudItem>
          <MudItem xs="6">
            <MudText Typo="Typo.subtitle2" Color="Color.Secondary">Track ID</MudText>
            <MudText>@_selectedItem.Id</MudText>
          </MudItem>
        </MudGrid>
      }
    </DialogContent>
    <DialogActions>
      <MudButton OnClick="@(() => _showDetailDialog = false)">Close</MudButton>
    </DialogActions>
  </MudDialog>
}

@* Delete Confirmation Dialog *@
@if (_showDeleteDialog)
{
  <MudDialog>
    <TitleContent>
      <MudText Typo="Typo.h6">
        <MudIcon Icon="@Icons.Material.Filled.Warning" Color="Color.Error" Class="mr-1" />
        Delete History Item
      </MudText>
    </TitleContent>
    <DialogContent>
      <MudText>Are you sure you want to delete this history item?</MudText>
      @if (_selectedItem != null)
      {
        <MudText Typo="Typo.body2" Class="mt-2">
          <strong>@_selectedItem.Title</strong> by @_selectedItem.Artist
        </MudText>
      }
    </DialogContent>
    <DialogActions>
      <MudButton OnClick="@(() => _showDeleteDialog = false)">Cancel</MudButton>
      <MudButton Color="Color.Error" Variant="Variant.Filled" OnClick="@ConfirmDelete">Delete</MudButton>
    </DialogActions>
  </MudDialog>
}

@* Clear All Confirmation Dialog *@
@if (_showClearDialog)
{
  <MudDialog>
    <TitleContent>
      <MudText Typo="Typo.h6">
        <MudIcon Icon="@Icons.Material.Filled.Warning" Color="Color.Error" Class="mr-1" />
        Clear All History
      </MudText>
    </TitleContent>
    <DialogContent>
      <MudText>Are you sure you want to clear ALL play history?</MudText>
      <MudText Typo="Typo.body2" Color="Color.Error" Class="mt-2">
        This action cannot be undone!
      </MudText>
    </DialogContent>
    <DialogActions>
      <MudButton OnClick="@(() => _showClearDialog = false)">Cancel</MudButton>
      <MudButton Color="Color.Error" Variant="Variant.Filled" OnClick="@ConfirmClearAll">Clear All</MudButton>
    </DialogActions>
  </MudDialog>
}

@code {
  private PlayHistoryListDto? _historyData;
  private PlayHistoryStatsDto? _stats;
  private PlayHistoryEntryDto? _selectedItem;
  private bool _isLoading = true;
  private DateTime? _selectedDate;
  private string _sourceFilter = "All";
  private string _searchQuery = "";
  private int _currentPage = 1;
  private const int _pageSize = 50;
  private bool _showDetailDialog = false;
  private bool _showDeleteDialog = false;
  private bool _showClearDialog = false;

  protected override async Task OnInitializedAsync()
  {
    await LoadPreferencesAsync();
    await LoadDataAsync();
  }

  private Task LoadPreferencesAsync()
  {
    // Always start with "All" to avoid confusion from persisted filters
    _sourceFilter = "All";
    return Task.CompletedTask;
  }

  private async Task SavePreferenceAsync(string key, object value)
  {
    try
    {
      await ConfigApi.UpdateConfigurationAsync("ui.history", key, value);
    }
    catch (Exception ex)
    {
      Logger.LogWarning(ex, "Failed to save preference {Key}", key);
    }
  }

  private async Task SetSourceFilterAsync(string filter)
  {
    // Trim and normalize the filter to prevent comparison issues
    _sourceFilter = string.IsNullOrWhiteSpace(filter) ? "All" : filter.Trim();
    await SavePreferenceAsync("sourceFilter", _sourceFilter);
    await LoadDataAsync();
  }

  private async Task LoadDataAsync()
  {
    _isLoading = true;
    StateHasChanged();
    
    try
    {
      // Load history with pagination
      var offset = (_currentPage - 1) * _pageSize;
      
      PlayHistoryListDto? result = null;
      
      // Apply active filters
      // Normalize filter to avoid comparison issues (trim and handle empty/null)
      var normalizedFilter = string.IsNullOrWhiteSpace(_sourceFilter) ? "All" : _sourceFilter.Trim();

      if (!string.IsNullOrWhiteSpace(_searchQuery))
      {
        result = await HistoryApi.SearchHistoryAsync(_searchQuery, _pageSize, offset);
      }
      else if (_selectedDate.HasValue)
      {
        result = await HistoryApi.GetHistoryByDateAsync(_selectedDate.Value, _pageSize, offset);
      }
      else if (!string.Equals(normalizedFilter, "All", StringComparison.OrdinalIgnoreCase))
      {
        // Only call GetHistoryBySourceAsync for specific source filters, not "All"
        result = await HistoryApi.GetHistoryBySourceAsync(normalizedFilter, _pageSize, offset);
      }
      else
      {
        // "All" sources - use the standard history endpoint
        result = await HistoryApi.GetHistoryAsync(_pageSize, offset);
      }
      
      _historyData = result;
      
      // Load statistics (only on first load)
      if (_stats == null)
      {
        _stats = await HistoryApi.GetStatsAsync();
      }
    }
    catch (Exception ex)
    {
      Snackbar.Add($"Failed to load history: {ex.Message}", Severity.Error);
    }
    finally
    {
      _isLoading = false;
      StateHasChanged();
    }
  }

  private async Task ApplyFilters()
  {
    _currentPage = 1; // Reset to first page when filtering
    await LoadDataAsync();
  }

  private async Task OnSearchKeyUp(KeyboardEventArgs e)
  {
    if (e.Key == "Enter")
    {
      await ApplyFilters();
    }
  }

  private async Task RefreshHistory()
  {
    // Reload data with current filters maintained
    await LoadDataAsync();
    Snackbar.Add("History refreshed", Severity.Success);
  }

  private async Task ClearAllFilters()
  {
    // Clear all filter values
    _selectedDate = null;
    _sourceFilter = "All";
    _searchQuery = "";
    _currentPage = 1;
    
    // Reload with no filters
    await LoadDataAsync();
    Snackbar.Add("Filters cleared", Severity.Info);
  }

  private async Task OnPageChanged(int page)
  {
    _currentPage = page;
    await LoadDataAsync();
  }

  private int GetPageCount()
  {
    if (_historyData == null || _historyData.TotalCount == 0)
      return 1;
    
    return (int)Math.Ceiling(_historyData.TotalCount / (double)_pageSize);
  }

  private void ShowDetailDialog(PlayHistoryEntryDto item)
  {
    _selectedItem = item;
    _showDetailDialog = true;
  }

  private void ShowDeleteDialog(PlayHistoryEntryDto item)
  {
    _selectedItem = item;
    _showDeleteDialog = true;
  }

  private void ShowClearHistoryDialog()
  {
    _showClearDialog = true;
  }

  private async Task ConfirmDelete()
  {
    if (_selectedItem == null) return;
    
    var success = await HistoryApi.DeleteHistoryItemAsync(_selectedItem.Id);
    if (success)
    {
      Snackbar.Add("History item deleted", Severity.Success);
      _showDeleteDialog = false;
      await LoadDataAsync();
    }
    else
    {
      Snackbar.Add("Failed to delete history item", Severity.Error);
    }
  }

  private async Task ConfirmClearAll()
  {
    var success = await HistoryApi.ClearHistoryAsync();
    if (success)
    {
      Snackbar.Add("All history cleared", Severity.Success);
      _showClearDialog = false;
      await LoadDataAsync();
    }
    else
    {
      Snackbar.Add("Failed to clear history", Severity.Error);
    }
  }

  private Color GetSourceColor(string source)
  {
    return source switch
    {
      "File" => Color.Info,
      "Radio" => Color.Warning,
      "GenericUSB" => Color.Tertiary,
      "Vinyl" => Color.Success,
      "Bluetooth" => Color.Secondary,
      _ => Color.Default
    };
  }

  private string FormatDuration(int? seconds)
  {
    if (!seconds.HasValue || seconds.Value <= 0) return "--:--";
    var ts = TimeSpan.FromSeconds(seconds.Value);
    if (ts.TotalHours >= 1)
    {
      return $"{(int)ts.TotalHours}:{ts.Minutes:D2}:{ts.Seconds:D2}";
    }
    return $"{ts.Minutes}:{ts.Seconds:D2}";
  }

  public void Dispose()
  {
    // Cleanup if needed
  }
}
