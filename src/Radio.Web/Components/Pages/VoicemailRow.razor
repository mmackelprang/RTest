@using Radio.Web.Models

<div class="vm-row-wrap @(IsNew ? "list-item-add" : "")">
  <button type="button"
          class="list-item-touch @(Expanded ? "list-item-active" : "")"
          @onclick="OnToggle">
    <span class="vm-chip"><RadzenIcon Icon="voicemail" /></span>
    @if (!Item.IsRead)
    {
      <span class="unread-dot"></span>
    }
    <span class="vm-row-main">
      <span class="vm-row-title @(Item.IsRead ? "" : "vm-row-unread")">@DisplayName</span>
      <span class="vm-row-preview">@Preview</span>
    </span>
    @if (!SingleStreamView)
    {
      <span class="vm-type-label">vmail</span>
    }
    @* Meta stack mirrors the redesigned call/text rows: smart timestamp over the
       duration, so every feed kind shares the same right-aligned spine. *@
    <div class="list-item-meta-stack">
      <span class="list-item-meta">@PhoneCallFormatting.FormatFeedTimestamp(ReceivedLocal, Clock.GetLocalNow().DateTime)</span>
      <span class="vm-row-duration">@DurationDisplay</span>
    </div>
    <RadzenIcon Icon="@(Expanded ? "expand_more" : "chevron_right")" />
  </button>

  @if (Expanded)
  {
    <VoicemailPlayer Item="Item" OnHeard="OnHeard" />
  }
</div>

@code {
  [Parameter, EditorRequired] public VoicemailItemDto Item { get; set; } = default!;
  [Parameter] public bool Expanded { get; set; }
  [Parameter] public bool IsNew { get; set; }
  [Parameter] public bool SingleStreamView { get; set; }   // hide type label in Voicemail filter
  [Parameter] public string? ResolvedName { get; set; }
  [Parameter] public EventCallback OnToggle { get; set; }
  [Parameter] public EventCallback OnHeard { get; set; }

  private string DisplayName => ResolvedName
    ?? (!string.IsNullOrWhiteSpace(Item.FromName) ? Item.FromName! : Item.FromNumber);

  /// <summary>
  /// The clock the row reads "now" and the local time zone from (TEST-12). A parameter rather than
  /// <c>@inject</c> because neither host registers a <see cref="TimeProvider"/> — the same seam
  /// <c>PresetBar.Clock</c> uses. Production leaves it at <see cref="TimeProvider.System"/>, whose
  /// local zone is <see cref="TimeZoneInfo.Local"/>, so the row renders exactly as it did; tests pass a
  /// <c>FakeTimeProvider</c> so the rendered timestamp does not depend on when the suite runs.
  /// </summary>
  [Parameter] public TimeProvider Clock { get; set; } = TimeProvider.System;

  /// <summary>
  /// <see cref="VoicemailItemDto.ReceivedAt"/> in <see cref="Clock"/>'s local zone. A value whose
  /// kind is <see cref="DateTimeKind.Unspecified"/> is read as UTC, as <c>DateTime.ToLocalTime</c>
  /// (which this replaces) reads it.
  /// </summary>
  private DateTime ReceivedLocal => TimeZoneInfo.ConvertTimeFromUtc(ReceivedUtc, Clock.LocalTimeZone);

  private DateTime ReceivedUtc => Item.ReceivedAt.Kind == DateTimeKind.Local
    ? Item.ReceivedAt.ToUniversalTime()
    : DateTime.SpecifyKind(Item.ReceivedAt, DateTimeKind.Utc);

  private bool IsRecent => (Clock.GetUtcNow().UtcDateTime - ReceivedUtc) < TimeSpan.FromMinutes(30);

  private string Preview => !string.IsNullOrWhiteSpace(Item.Transcript)
    ? FirstLine(Item.Transcript!)
    : (IsRecent ? "Transcript pending…" : "No transcript available.");

  private static string FirstLine(string s)
  {
    var nl = s.IndexOf('\n');
    return nl >= 0 ? s[..nl] : s;
  }

  private string DurationDisplay
  {
    get
    {
      if (Item.DurationSeconds <= 0) return "—";
      var ts = TimeSpan.FromSeconds(Item.DurationSeconds);
      return ts.TotalHours >= 1 ? ts.ToString(@"h\:mm\:ss") : ts.ToString(@"m\:ss");
    }
  }
}
