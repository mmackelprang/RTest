@using Radio.Web.Models
@implements IDisposable
@inject ConsolePlaybackState ConsolePlayback
@inject EventPlaybackApiService EventPlayback

@* §Ph text bubble — inbound left (raised) / outbound right (accent tint), with an
   outbound status glyph (sending spinner / sent check / failed ⚠). Defensive:
   null text → "(no text)" placeholder; direction not exactly "Outbound" → inbound.
   A failed bubble is the whole-bubble retry target (≥48px via .msg-bubble.failed).

   PHN-3 (feature B): an INBOUND bubble with something to say also gets a 44px
   play button in the gutter, which speaks the message through the console. The
   button sits OUTSIDE .msg-bubble, in the .msg-row-inbound wrapper — handoff :325
   ("inside .msg-meta a 44px control would nearly double a one-line bubble's height
   and put a touch target in an 11px text row").

   ⚠ The outbound MARKUP is untouched — handoff :323 puts the button on inbound
   bubbles only, so no outbound bubble grows a wrapper, a gutter or a control, and
   its rendered output is what it was before PHN-3. The outbound COMPONENT is not
   untouched, and saying otherwise would be false: every bubble, outbound included,
   now injects ConsolePlaybackState and EventPlaybackApiService, subscribes to a
   process-wide singleton event on init, unsubscribes on dispose, and evaluates
   IsMineAndLive on every render. The plan accepted that fan-out deliberately
   (C-111 — forty bubbles, forty subscribers) rather than gating the subscription
   on direction. *@

@if (CanSpeak)
{
  <div class="msg-row-inbound">
    @BubbleMarkup
    <button type="button"
            class="msg-speak-btn @(IsMineAndLive ? "speaking" : null)"
            title="@SpeakTitle"
            aria-label="@SpeakAriaLabel"
            @onclick="ToggleSpeakAsync">
      @if (IsMinePreparing)
      {
        <span class="spinner"></span>
      }
      else
      {
        <RadzenIcon Icon="@(IsMineAndLive ? "stop" : "play_arrow")" />
      }
    </button>
  </div>
}
else
{
  @BubbleMarkup
}

@code {
  public enum SendStatus { None, Sending, Sent, Failed }

  [Parameter, EditorRequired] public SmsMessageDto Message { get; set; } = default!;
  [Parameter] public SendStatus Status { get; set; } = SendStatus.None;
  [Parameter] public EventCallback OnRetry { get; set; }

  /// <summary>A resolved contact name for the thread, or null. Never a phone number (C-108).</summary>
  /// <remarks>
  /// ⚠ The caller passes null rather than an identifier. Handoff :386 forbids reading the identifier
  /// aloud, and PhoneTextsPanel.SpeakableSenderName is where that is enforced — this component takes
  /// whatever it is handed and does not second-guess it, because it has no contact list to check
  /// against and resolving one here would give the name two paths that can disagree.
  /// </remarks>
  [Parameter] public string? SenderName { get; set; }

  /// <summary>Raised with the rejection reason when a speak could not be started.</summary>
  /// <remarks>
  /// ⚠ An EventCallback, not a toast raised here. Handoff §Cross-5 :174 puts a synthesis failure in a
  /// TOAST — "there is no room beside a bubble" — and a presentational bubble should not own a toast
  /// host. The panel owns it (PhoneTextsPanel.OnSpeakFailed).
  /// </remarks>
  [Parameter] public EventCallback<string?> OnSpeakFailed { get; set; }

  private string? _playbackId;    // the handle THIS bubble started, or null
  private bool _starting;         // a StartSpeechAsync is in flight; see ToggleSpeakAsync

  // ⚠ The playback id whose Failed snapshot has ALREADY raised OnSpeakFailed, so §B4's Engine-error
  // toast fires exactly once per playback. ConsolePlaybackState.cs:66-71 is the reason it needs a
  // field at all: a terminal snapshot — Completed, Stopped or Failed — is RETAINED until a new
  // playback replaces it, deliberately, so the Failed snapshot is re-delivered on every subsequent
  // broadcast. Without this the room gets a fresh toast each time anything else changes. Reset when
  // a new start assigns _playbackId; see ToggleSpeakAsync.
  private string? _failureReportedFor;

  // ⚠ NO _startReason FIELD, unlike VoicemailPlayer. The plan's Task 3 sketch carried one, copied
  // from that component — but VoicemailPlayer RENDERS its refusal (ShowFailure / FailurePrimary /
  // FailureSubline) and this button does not: handoff §Cross-5 :174 says a bubble has no room beside
  // it, so the reason leaves via OnSpeakFailed and the button returns to rest. A field written on
  // every failure and read by nothing is dead weight the compiler would flag (CS0414), and worse, a
  // future reader would take it as evidence of a failure state that does not exist here.

  /// <summary>
  /// The bubble exactly as it rendered before PHN-3. ⚠ Extracted with its MARKUP unchanged — the
  /// outbound render OUTPUT must not move, per handoff :323 (the component around it did change;
  /// the file header says how). The only edit inside it is the `speaking` class, which can only
  /// ever be true on an inbound bubble, and that now rests on two things rather than one:
  /// `_playbackId` is assigned only in ToggleSpeakAsync, whose only caller is the button that
  /// CanSpeak (`!IsOutbound`) gates — AND the call site keys each bubble on Message.Id
  /// (PhoneTextsPanel), so an instance holding a `_playbackId` can never be re-parameterised onto a
  /// different message. Before that `@key` it could: Blazor matches children positionally, so a
  /// non-tail insert or a re-sort moved this state onto whatever bubble took the slot.
  /// </summary>
  private RenderFragment BubbleMarkup => @<div class="msg-bubble @DirectionClass @StatusClass @(IsMineAndLive ? "speaking" : null)"
     @onclick="OnFailedClick" role="@(IsFailed ? "button" : null)">
    <span class="msg-text">@DisplayText</span>
    <span class="msg-meta">
      <span class="msg-time">@Message.SentAt.ToLocalTime().ToString("h:mm tt")</span>
      @if (IsOutbound)
      {
        @switch (Status)
        {
          case SendStatus.Sending:
            <span class="spinner"></span>
            break;
          case SendStatus.Sent:
            <RadzenIcon Icon="done" class="msg-status-sent" />
            break;
          case SendStatus.Failed:
            <span class="msg-status-fail">
              <RadzenIcon Icon="error_outline" /> Failed to send
            </span>
            break;
        }
      }
    </span>
  </div>;

  private bool IsOutbound => GvDirection.IsOutbound(Message.Direction);  // unknown → inbound
  private bool IsFailed => Status == SendStatus.Failed;
  private string DirectionClass => IsOutbound ? "outbound" : "inbound";
  private string StatusClass => Status switch
  {
    SendStatus.Sending => "sending",
    SendStatus.Failed => "failed",
    _ => ""
  };
  private string DisplayText =>
    string.IsNullOrEmpty(Message.Text) ? "(no text)" : Message.Text!;

  private async Task OnFailedClick()
  {
    if (IsFailed) await OnRetry.InvokeAsync();
  }

  // ── the speak button (PHN-3) ─────────────────────────────────────────────────────────────────

  /// <summary>
  /// ⚠ Inbound only, and only when there is something to say. C-114: Utterance reads Message.Text,
  /// not DisplayText — a null-text bubble renders "(no text)" and must not offer to speak those two
  /// words aloud. The button is ABSENT there, not present-and-disabled.
  /// </summary>
  private bool CanSpeak => !IsOutbound && Utterance is not null;

  /// <summary>The composed utterance, or null. Cached — see <see cref="OnParametersSet"/>.</summary>
  private string? Utterance => _utterance;

  private string? _utterance;
  private string? _utteranceForText;
  private string? _utteranceForSender;
  private bool _utteranceComputed;

  /// <summary>
  /// Recomposes the utterance only when the inputs it is derived from actually changed.
  /// </summary>
  /// <remarks>
  /// ⚠ NOT a micro-optimisation on this surface. ForMessage runs three regexes and a rune pass, and
  /// CanSpeak calls it on EVERY render — while MainLayout's 1 Hz tick cascades through @Body and no
  /// component on the /phone path overrides ShouldRender, so the measured render rate is ~1.2/sec
  /// per bubble. A forty-message conversation is ~48 compositions a second and ~180 KB/s of Gen0
  /// garbage, on an N100 where churn is audible.
  ///
  /// ⚠ Keyed on the two inputs rather than computed unconditionally, because Blazor runs
  /// OnParametersSet on every parent render whether or not a value changed — which is exactly the
  /// 1 Hz cascade this is here to absorb. _utteranceComputed exists because both keys are legally
  /// null, so "the keys match" is not on its own evidence that a composition ever happened.
  /// </remarks>
  protected override void OnParametersSet()
  {
    if (_utteranceComputed
        && string.Equals(_utteranceForText, Message.Text, StringComparison.Ordinal)
        && string.Equals(_utteranceForSender, SenderName, StringComparison.Ordinal))
    {
      return;
    }

    _utteranceForText = Message.Text;
    _utteranceForSender = SenderName;
    _utterance = GvSpeechText.ForMessage(_utteranceForText, _utteranceForSender);
    _utteranceComputed = true;
  }

  // ⚠ Mine, not the ambient snapshot. VoicemailPlayer.razor:178-181 is the original; the reason is
  // that every state this button renders must first be gated on the playback THIS bubble started.
  // It is also what gives §A4b's single-selection group for free: when another item starts, the
  // ambient Id changes, Mine goes null here, and this button returns to rest silently — which is
  // §B4's "Replaced" row, with no client bookkeeping at all. See plan PHN-3 C-110.
  private EventPlaybackSnapshotDto? Mine =>
    _playbackId is not null && ConsolePlayback.Snapshot?.Id == _playbackId
      ? ConsolePlayback.Snapshot
      : null;

  private bool IsMineAndLive => Mine?.IsLive == true;

  // ⚠ Waiting renders exactly as Preparing — one spinner, two titles. PHN-1f's D28 queue means a
  // Speech playback can legitimately sit in Waiting for up to GvMedia:MaxQueuedWaitSeconds while an
  // announcement finishes, and the handoff's §B4 table predates that state. See C-107.
  private bool IsMinePreparing => Mine?.State is "Preparing" or "Waiting";

  private string SpeakTitle => Mine?.State switch
  {
    "Waiting" => "Waiting for the announcement to finish…",
    "Preparing" => "Preparing…",
    not null when IsMineAndLive => "Stop reading this message.",
    _ => "Read this message aloud."
  };

  private string SpeakAriaLabel =>
    IsMineAndLive ? "Stop reading this message" : "Read this message aloud";

  // ⚠ C-111 — ConsolePlaybackState.Changed, never AudioStateStore.EventPlaybackChanged. The store is
  // a singleton and this component is per-bubble: a conversation with forty messages mounts forty
  // subscribers, the largest fan-out this event has ever had.
  protected override void OnInitialized() => ConsolePlayback.Changed += OnPlaybackChangedAsync;

  // ⚠ And every bubble must come off again. Forty leaked handlers per opened thread, on a kiosk that
  // runs for weeks, is a real leak.
  public void Dispose() => ConsolePlayback.Changed -= OnPlaybackChangedAsync;

  /// <summary>
  /// Re-renders on every ambient change — and raises §B4's "Engine error" toast for the arm that
  /// actually happens.
  /// </summary>
  /// <remarks>
  /// ⚠⚠ THE SYNCHRONOUS REFUSAL IN ToggleSpeakAsync IS THE RARE ARM. The common synthesis failure
  /// is asynchronous: the API answers 202 Accepted, then broadcasts a Failed snapshot carrying
  /// FailureReason "SpeechSynthesisFailed". Driven live three times during PHN-3's UAT, and before
  /// this branch existed the button spun briefly, returned to rest, and the user was told NOTHING
  /// AT ALL. Handoff §B4's Engine-error row specifies "back to Rest PLUS a toast", and plan PHN-3
  /// §0.3 consequence 2 says the toast "is the whole of the UX" when cloud synthesis fails —
  /// offline is a failure mode now that the engine is not on-box. The plan's Task 3 sketch had no
  /// Failed handling either; this is a plan gap, not a stray addition.
  ///
  /// ⚠ EXACTLY ONCE per playback id, via _failureReportedFor. ConsolePlaybackState.cs:66-71 retains
  /// a terminal snapshot deliberately, so this same Failed snapshot arrives again on every later
  /// broadcast; without the guard the room gets a fresh toast for a failure it already dismissed.
  ///
  /// ⚠ StateHasChanged runs FIRST so the button reaches rest even if the parent's toast throws.
  /// </remarks>
  private Task OnPlaybackChangedAsync() => InvokeAsync(async () =>
  {
    StateHasChanged();

    if (Mine is { State: "Failed" } failed && _failureReportedFor != failed.Id)
    {
      _failureReportedFor = failed.Id;
      await OnSpeakFailed.InvokeAsync(failed.FailureReason);
    }
  });

  private async Task ToggleSpeakAsync()
  {
    // ⚠ THE RE-ENTRANCY GUARD COVERS THE START ARM, AND ONLY THE START ARM. VoicemailPlayer.razor:
    // 323-345 explains that window in its own words: _playbackId is cleared before the awaited
    // POST, so a second tap arriving while the first is in flight sees a null id and starts a
    // SECOND playback — which EventPlaybackService's replacement arm honours by tearing the first
    // one down mid-sentence. A double-tap is the default gesture on a wall panel. The button cannot
    // be disabled instead: there is no snapshot to render Preparing from until the 202 comes back,
    // which is the whole window this guards.
    //
    // ⚠⚠ THE STOP ARM IS SAFE BECAUSE THE HANDLE IS RETAINED — NOT because of _starting, which does
    // not cover it. It used to null _playbackId BEFORE awaiting the DELETE, and ComponentBase
    // re-renders at that await: the button flipped to play_arrow while the console was still
    // speaking, actively inviting the second tap, and that tap found Mine null, fell through to the
    // START arm, and posted a new playback — the message began reading again from the top. Measured
    // Deletes == 1, Posts == 2. Retaining the handle matches VoicemailPlayer.razor:394-395, which
    // never had this window for the same reason, and MainLayout.razor:1415-1417's stated rule for
    // this same stop control: "No optimistic hide. The chip disappears when the SERVER says so."
    // The button returns to rest on the Stopped broadcast, not on the tap.
    if (_starting)
    {
      return;
    }

    if (IsMineAndLive)
    {
      // IsMineAndLive implies Mine is non-null, which implies _playbackId is non-null.
      await EventPlayback.StopAsync(_playbackId!);
      return;
    }

    _starting = true;
    try
    {
      _playbackId = null;
      var (snapshot, reason) = await EventPlayback.StartSpeechAsync(Utterance!, SpeakLabel);
      if (snapshot is null)
      {
        // A refusal answered synchronously — 400 (409 is the RemoteMedia arm's:
        // EventPlaybackService.cs:222 guards that throw with `Kind == RemoteMedia`, so a Speech
        // request never reaches it) — never reaches a Failed snapshot, so the reason has to leave
        // HERE or it is lost. It goes up to the panel's toast (handoff §Cross-5) and the button
        // stays at rest, which is §B4's "Engine error" row. The ASYNCHRONOUS arm of that same row —
        // 202 then a Failed broadcast, which is the common one — is in OnPlaybackChangedAsync.
        await OnSpeakFailed.InvokeAsync(reason);
        return;
      }

      // ⚠ 202 means ACCEPTED, not speaking (EventPlaybackController.cs:17-22). Do not render Playing
      // here — the state arrives on the next broadcast.
      _playbackId = snapshot.Id;

      // A new playback may fail on its own account; the previous one's report must not suppress it.
      _failureReportedFor = null;
    }
    finally
    {
      _starting = false;
    }
  }

  /// <summary>
  /// The chip's title text, via EventPlaybackSnapshot.Label. ⚠ Shaped so MainLayout's Speech arm
  /// reads "Reading a message from Jane on the console." — see MainLayout.razor and plan PHN-3
  /// C-112. EventPlaybackRequest.MaxLabelChars is 128; a resolved contact name cannot approach it,
  /// but the server rejects LabelTooLong rather than truncating, so it is clamped here.
  /// </summary>
  private string SpeakLabel
  {
    get
    {
      var label = string.IsNullOrWhiteSpace(SenderName)
        ? "a message"
        : $"a message from {SenderName.Trim()}";

      if (label.Length <= 128)
      {
        return label;
      }

      // ⚠ Never cut a surrogate pair. Same silent failure as GvSpeechText's cap, and the same
      // reason: System.Text.Json substitutes U+FFFD for a lone surrogate rather than throwing, so
      // an over-long name would ship a replacement character with nothing anywhere to say so.
      var cut = 128;
      if (char.IsHighSurrogate(label[cut - 1]))
      {
        cut--;
      }

      return label[..cut];
    }
  }
}
