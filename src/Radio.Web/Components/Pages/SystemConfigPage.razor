  private string FormatFileSize(long bytes)
  {
    string[] sizes = { "B", "KB", "MB", "GB" };
    double len = bytes;
    int order = 0;
    while (len >= 1024 && order < sizes.Length - 1)
    {
      order++;
      len = len / 1024;
    }
    return $"{len:0.##} {sizes[order]}";
  }

  private async Task ExportLogsAsync()
  {
    try
    {
      if (_logs == null || _logs.Count == 0)
        return;

      var content = string.Join("\n", _logs.Select(log =>
        $"[{log.Timestamp:yyyy-MM-dd HH:mm:ss}] [{log.Level}] {log.SourceContext}: {log.Message}" +
        (string.IsNullOrEmpty(log.Exception) ? "" : $"\n{log.Exception}")));

      var fileName = $"radio-console-logs-{DateTime.Now:yyyyMMdd-HHmmss}.txt";
      
      // Use JavaScript interop to download the file
      var success = await JSRuntime.InvokeAsync<bool>("fileDownload.downloadTextFile", fileName, content, "text/plain");
      
      if (success)
      {
        NotificationService.Notify(NotificationSeverity.Success, "Success", $"Logs exported to {fileName}");
      }
      else
      {
        NotificationService.Notify(NotificationSeverity.Error, "Error", "Failed to download log file");
      }
    }
    catch (Exception ex)
    {
      NotificationService.Notify(NotificationSeverity.Error, "Error", $"Failed to export logs: {ex.Message}");
    }
  }

  private BadgeStyle GetLogLevelBadgeStyle(string level) => level.ToLower() switch
  {
    "error" => BadgeStyle.Danger,
    "warning" => BadgeStyle.Warning,
    "info" => BadgeStyle.Info,
    _ => BadgeStyle.Light
  };

  private string GetShortSourceName(string sourceContext)
  {
    if (string.IsNullOrEmpty(sourceContext))
      return "Unknown";
    
    var parts = sourceContext.Split('.');
    return parts.Length > 0 ? parts[^1] : sourceContext;
  }

  private BadgeStyle GetStateBadgeStyle(string state) => state switch
  {
    "Playing" => BadgeStyle.Success,
    "Paused" => BadgeStyle.Warning,
    "Stopped" => BadgeStyle.Light,
    "Error" => BadgeStyle.Danger,
    "Ready" => BadgeStyle.Info,
    _ => BadgeStyle.Light
  };

  private async Task ReplayEventAsync(AudioSourceDto source)
  {
    try
    {
      bool success = false;
      
      // Determine event type and replay accordingly
      if (source.Type == "TTS" && source.Metadata != null)
      {
        // Extract TTS parameters from metadata
        var text = source.Metadata.GetValueOrDefault("Text")?.ToString() ?? source.Name;
        var engine = source.Metadata.GetValueOrDefault("Engine")?.ToString();
        var voice = source.Metadata.GetValueOrDefault("Voice")?.ToString();
        
        // Parse speed and pitch if available
        float? speed = null;
        float? pitch = null;
        
        if (source.Metadata.TryGetValue("Speed", out var speedObj)
          && speedObj != null
          && float.TryParse(speedObj.ToString(), System.Globalization.NumberStyles.Float, System.Globalization.CultureInfo.InvariantCulture, out var speedVal))
        {
          speed = speedVal;
        }
        
        if (source.Metadata.TryGetValue("Pitch", out var pitchObj)
          && pitchObj != null
          && float.TryParse(pitchObj.ToString(), System.Globalization.NumberStyles.Float, System.Globalization.CultureInfo.InvariantCulture, out var pitchVal))
        {
          pitch = pitchVal;
        }
        
        success = await SourcesApi.PlayTTSEventAsync(text, engine, voice, speed, pitch);
      }
      else if (source.Type == "AudioFileEvent" && source.Metadata != null)
      {
        // Extract file path from metadata
        var filePath = source.Metadata.GetValueOrDefault("FilePath")?.ToString() 
                    ?? source.Metadata.GetValueOrDefault("Path")?.ToString();
        
        if (!string.IsNullOrWhiteSpace(filePath))
        {
          success = await SourcesApi.PlayFileEventAsync(filePath);
        }
        else
        {
          NotificationService.Notify(NotificationSeverity.Warning, "Warning", "Unable to replay: file path not found in metadata");
          return;
        }
      }
      
      if (success)
      {
        NotificationService.Notify(NotificationSeverity.Success, "Success", "Event replayed successfully");
        // Event sources list will auto-update via SignalR
      }
      else
      {
        NotificationService.Notify(NotificationSeverity.Error, "Error", "Failed to replay event");
      }
    }
    catch (Exception ex)
    {
      NotificationService.Notify(NotificationSeverity.Error, "Error", $"Error replaying event: {ex.Message}");
    }
  }

