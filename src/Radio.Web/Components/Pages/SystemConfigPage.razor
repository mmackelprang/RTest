  private async Task SaveDisplayConfigAsync()
  {
    _isSaving = true;
    try
    {
      if (_displayConfig == null || _weatherDisplayConfig == null)
      {
        NotificationService.Notify(NotificationSeverity.Error, "Error", "Display configuration is not loaded");
        return;
      }

      // POST a combined payload to the "display" section. Time-format keys
      // land directly under display:* (TimeFormat / ShowSeconds); the nested
      // Weather object lands as display:Weather:{...} and is then flattened
      // by SqliteConfigurationProvider into display:Weather:Enabled etc. on
      // read — same hot-reload pipeline ConfigStoreChangeNotifier already
      // drives for DisplayOptions and WeatherDisplayOptions consumers.
      //
      // We use an anonymous object rather than a strongly-typed DTO so the
      // shape is obvious at the call site (and so this method doesn't need
      // a new DTO file just to flatten two POCOs).
      var payload = new
      {
        _displayConfig.TimeFormat,
        _displayConfig.ShowSeconds,
        Weather = new
        {
          _weatherDisplayConfig.Enabled,
          _weatherDisplayConfig.Zip,
