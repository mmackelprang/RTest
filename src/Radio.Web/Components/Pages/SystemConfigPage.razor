@page "/system"
@rendermode InteractiveServer
@using Radio.Web.Models
@inject SystemApiService SystemApi
@inject ConfigurationApiService ConfigApi
@inject SourcesApiService SourcesApi
@inject AudioStateHubService HubService
@inject ISnackbar Snackbar
@inject IJSRuntime JSRuntime
@inject IDialogService DialogService
@inject ILogger<SystemConfigPage> Logger
@implements IDisposable

<PageTitle>System Configuration</PageTitle>

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Style="height: 516px; padding: 16px;">
  <MudTabs Elevation="2" Rounded="true" ApplyEffectsToContainer="true" PanelClass="pa-4" @bind-ActivePanelIndex="_activeTab">
    
    <!-- Tab 1: System Statistics -->
    <MudTabPanel Text="System Stats" Icon="@Icons.Material.Filled.Insights">
      <MudGrid Spacing="3">
        <!-- CPU Usage -->
        <MudItem xs="6" md="3">
          <MudCard>
            <MudCardContent>
              <MudText Typo="Typo.h6">CPU Usage</MudText>
              <MudProgressCircular Color="Color.Primary" Size="Size.Large" Value="@_cpuUsage" />
              <MudText Typo="Typo.h5" Color="Color.Primary">@_cpuUsage.ToString("F1")%</MudText>
            </MudCardContent>
          </MudCard>
        </MudItem>

        <!-- RAM Usage -->
        <MudItem xs="6" md="3">
          <MudCard>
            <MudCardContent>
              <MudText Typo="Typo.h6">RAM Usage</MudText>
              <MudProgressCircular Color="Color.Secondary" Size="Size.Large" Value="@(_ramUsageMb / 10)" />
              <MudText Typo="Typo.h5" Color="Color.Secondary">@_ramUsageMb.ToString("F0") MB</MudText>
            </MudCardContent>
          </MudCard>
        </MudItem>

        <!-- Disk Usage -->
        <MudItem xs="6" md="3">
          <MudCard>
            <MudCardContent>
              <MudText Typo="Typo.h6">Disk Usage</MudText>
              <MudProgressCircular Color="Color.Info" Size="Size.Large" Value="@_diskUsage" />
              <MudText Typo="Typo.h5" Color="Color.Info">@_diskUsage.ToString("F1")%</MudText>
            </MudCardContent>
          </MudCard>
        </MudItem>

        <!-- Thread Count -->
        <MudItem xs="6" md="3">
          <MudCard>
            <MudCardContent>
              <MudText Typo="Typo.h6">Active Threads</MudText>
              <MudText Typo="Typo.h3" Color="Color.Success">@_threadCount</MudText>
            </MudCardContent>
          </MudCard>
        </MudItem>

        <!-- App Uptime -->
        <MudItem xs="6" md="4">
          <MudCard>
            <MudCardContent>
              <MudText Typo="Typo.h6">App Uptime</MudText>
              <MudText Typo="Typo.body1">@_appUptime</MudText>
            </MudCardContent>
          </MudCard>
        </MudItem>

        <!-- System Uptime -->
        <MudItem xs="6" md="4">
          <MudCard>
            <MudCardContent>
              <MudText Typo="Typo.h6">System Uptime</MudText>
              <MudText Typo="Typo.body1">@_systemUptime</MudText>
            </MudCardContent>
          </MudCard>
        </MudItem>

        <!-- Temperature -->
        <MudItem xs="6" md="4">
          <MudCard>
            <MudCardContent>
              <MudText Typo="Typo.h6">Temperature</MudText>
              <MudText Typo="Typo.body1" Color="@(_temperature == "N/A" ? Color.Default : Color.Warning)">@_temperature</MudText>
            </MudCardContent>
          </MudCard>
        </MudItem>

        <!-- Audio Engine State -->
        <MudItem xs="12">
          <MudCard>
            <MudCardContent>
              <MudText Typo="Typo.h6">Audio Engine State</MudText>
              <MudText Typo="Typo.body1">@_audioEngineState</MudText>
            </MudCardContent>
          </MudCard>
        </MudItem>
      </MudGrid>
    </MudTabPanel>

    <!-- Tab 2: Configuration Management -->
    <MudTabPanel Text="Configuration" Icon="@Icons.Material.Filled.Tune">
      <MudTabs Elevation="1" Rounded="true" ApplyEffectsToContainer="true" PanelClass="pa-2">
        
        <!-- Audio Configuration -->
        <MudTabPanel Text="Audio">
          @if (_audioConfig != null)
          {
            <MudGrid Spacing="2">
              <MudItem xs="12" md="6">
                <MudSelect T="string" @bind-Value="_audioConfig.DefaultSource" Label="Default Source"
                           Variant="Variant.Outlined" HelperText="Primary audio source on startup">
                  <MudSelectItem Value="@("Radio")">Radio</MudSelectItem>
                  <MudSelectItem Value="@("Spotify")">Spotify</MudSelectItem>
                  <MudSelectItem Value="@("FilePlayer")">File Player</MudSelectItem>
                  <MudSelectItem Value="@("Vinyl")">Vinyl</MudSelectItem>
                </MudSelect>
              </MudItem>
              <MudItem xs="12" md="6">
                <MudSelect T="string" @bind-Value="_audioConfig.DuckingPolicy" Label="Ducking Policy"
                           Variant="Variant.Outlined" HelperText="How volume is reduced during events">
                  <MudSelectItem Value="@("FadeSmooth")">Fade Smooth</MudSelectItem>
                  <MudSelectItem Value="@("FadeLinear")">Fade Linear</MudSelectItem>
                  <MudSelectItem Value="@("Immediate")">Immediate</MudSelectItem>
                </MudSelect>
              </MudItem>
              <MudItem xs="12" md="4">
                <MudNumericField T="int" @bind-Value="_audioConfig.DuckingPercentage" Label="Ducking Level (%)"
                                 Variant="Variant.Outlined" Min="0" Max="100"
                                 HelperText="Volume reduction during events" />
              </MudItem>
              <MudItem xs="12" md="4">
                <MudNumericField T="int" @bind-Value="_audioConfig.DuckingAttackMs" Label="Ducking Attack (ms)"
                                 Variant="Variant.Outlined" Min="0" Max="5000"
                                 HelperText="Time to reduce volume" />
              </MudItem>
              <MudItem xs="12" md="4">
                <MudNumericField T="int" @bind-Value="_audioConfig.DuckingReleaseMs" Label="Ducking Release (ms)"
                                 Variant="Variant.Outlined" Min="0" Max="5000"
                                 HelperText="Time to restore volume" />
              </MudItem>
              <MudItem xs="12">
                <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SaveAudioConfigAsync"
                           StartIcon="@Icons.Material.Filled.Save" Disabled="@_isSaving">
                  @if (_isSaving) { <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" /> }
                  Save Audio Settings
                </MudButton>
              </MudItem>
            </MudGrid>
          }
          else
          {
            <MudProgressCircular Color="Color.Primary" Size="Size.Small" Indeterminate="true" />
            <MudText Class="ml-2">Loading audio configuration...</MudText>
          }
        </MudTabPanel>

        <!-- Visualizer Configuration -->
        <MudTabPanel Text="Visualizer">
          @if (_visualizerConfig != null)
          {
            <MudGrid Spacing="2">
              <MudItem xs="12" md="4">
                <MudSelect T="int" @bind-Value="_visualizerConfig.FFTSize" Label="FFT Size"
                           Variant="Variant.Outlined" HelperText="Frequency resolution">
                  <MudSelectItem Value="256">256</MudSelectItem>
                  <MudSelectItem Value="512">512</MudSelectItem>
                  <MudSelectItem Value="1024">1024</MudSelectItem>
                  <MudSelectItem Value="2048">2048</MudSelectItem>
                  <MudSelectItem Value="4096">4096</MudSelectItem>
                </MudSelect>
              </MudItem>
              <MudItem xs="12" md="4">
                <MudNumericField T="int" @bind-Value="_visualizerConfig.WaveformSampleCount" Label="Waveform Samples"
                                 Variant="Variant.Outlined" Min="64" Max="4096"
                                 HelperText="Points in waveform display" />
              </MudItem>
              <MudItem xs="12" md="4">
                <MudNumericField T="int" @bind-Value="_visualizerConfig.PeakHoldTimeMs" Label="Peak Hold (ms)"
                                 Variant="Variant.Outlined" Min="0" Max="5000"
                                 HelperText="Peak indicator hold time" />
              </MudItem>
              <MudItem xs="12" md="6">
                <MudNumericField T="float" @bind-Value="_visualizerConfig.SpectrumSmoothing" Label="Spectrum Smoothing"
                                 Variant="Variant.Outlined" Min="0" Max="1" Step="0.05f"
                                 HelperText="0 = no smoothing, 1 = max smoothing" />
              </MudItem>
              <MudItem xs="12" md="6">
                <MudCheckBox T="bool" @bind-Value="_visualizerConfig.ApplyWindowFunction" Label="Apply Window Function"
                             Color="Color.Primary" />
              </MudItem>
              <MudItem xs="12">
                <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SaveVisualizerConfigAsync"
                           StartIcon="@Icons.Material.Filled.Save" Disabled="@_isSaving">
                  @if (_isSaving) { <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" /> }
                  Save Visualizer Settings
                </MudButton>
              </MudItem>
            </MudGrid>
          }
          else
          {
            <MudProgressCircular Color="Color.Primary" Size="Size.Small" Indeterminate="true" />
            <MudText Class="ml-2">Loading visualizer configuration...</MudText>
          }
        </MudTabPanel>

        <!-- Output Configuration -->
        <MudTabPanel Text="Output">
          @if (_outputConfig != null)
          {
            <MudExpansionPanels MultiExpansion="true">
              <!-- Local Output -->
              <MudExpansionPanel Text="Local Output" Icon="@Icons.Material.Filled.Speaker">
                <MudGrid Spacing="2">
                  <MudItem xs="12" md="4">
                    <MudCheckBox T="bool" @bind-Value="_localOutputEnabled" Label="Enabled" Color="Color.Primary" />
                  </MudItem>
                  <MudItem xs="12" md="4">
                    <MudTextField T="string" @bind-Value="_localPreferredDevice" Label="Preferred Device ID"
                                  Variant="Variant.Outlined" HelperText="Leave empty for system default" />
                  </MudItem>
                  <MudItem xs="12" md="4">
                    <MudNumericField T="float" @bind-Value="_localDefaultVolume" Label="Default Volume"
                                     Variant="Variant.Outlined" Min="0" Max="1" Step="0.05f"
                                     HelperText="0.0 - 1.0" />
                  </MudItem>
                </MudGrid>
              </MudExpansionPanel>

              <!-- HTTP Stream -->
              <MudExpansionPanel Text="HTTP Stream" Icon="@Icons.Material.Filled.Stream">
                <MudGrid Spacing="2">
                  <MudItem xs="12" md="3">
                    <MudCheckBox T="bool" @bind-Value="_httpStreamEnabled" Label="Enabled" Color="Color.Primary" />
                  </MudItem>
                  <MudItem xs="12" md="3">
                    <MudNumericField T="int" @bind-Value="_httpStreamPort" Label="Port"
                                     Variant="Variant.Outlined" Min="1024" Max="65535" />
                  </MudItem>
                  <MudItem xs="12" md="3">
                    <MudNumericField T="int" @bind-Value="_httpStreamSampleRate" Label="Sample Rate (Hz)"
                                     Variant="Variant.Outlined" Min="8000" Max="192000" />
                  </MudItem>
                  <MudItem xs="12" md="3">
                    <MudNumericField T="int" @bind-Value="_httpStreamChannels" Label="Channels"
                                     Variant="Variant.Outlined" Min="1" Max="8" />
                  </MudItem>
                </MudGrid>
              </MudExpansionPanel>

              <!-- Google Cast -->
              <MudExpansionPanel Text="Google Cast" Icon="@Icons.Material.Filled.Cast">
                <MudGrid Spacing="2">
                  <MudItem xs="12" md="4">
                    <MudCheckBox T="bool" @bind-Value="_castEnabled" Label="Enabled" Color="Color.Primary" />
                  </MudItem>
                  <MudItem xs="12" md="4">
                    <MudNumericField T="int" @bind-Value="_castDiscoveryTimeout" Label="Discovery Timeout (s)"
                                     Variant="Variant.Outlined" Min="1" Max="60" />
                  </MudItem>
                  <MudItem xs="12" md="4">
                    <MudNumericField T="float" @bind-Value="_castDefaultVolume" Label="Default Volume"
                                     Variant="Variant.Outlined" Min="0" Max="1" Step="0.05f"
                                     HelperText="0.0 - 1.0" />
                  </MudItem>
                </MudGrid>
              </MudExpansionPanel>
            </MudExpansionPanels>

            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SaveOutputConfigAsync" Class="mt-3"
                       StartIcon="@Icons.Material.Filled.Save" Disabled="@_isSaving">
              @if (_isSaving) { <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" /> }
              Save Output Settings
            </MudButton>
          }
          else
          {
            <MudProgressCircular Color="Color.Primary" Size="Size.Small" Indeterminate="true" />
            <MudText Class="ml-2">Loading output configuration...</MudText>
          }
        </MudTabPanel>

        <!-- Devices Configuration -->
        <MudTabPanel Text="Devices">
          @if (_deviceOptions != null)
          {
            <MudGrid Spacing="2">
              <MudItem xs="12">
                <MudAlert Severity="Severity.Info" Dense="true">
                  Configure USB port paths for hardware devices. Linux/Pi uses /dev/ttyUSB*, Windows uses COM ports.
                </MudAlert>
              </MudItem>
              <MudItem xs="12" md="6">
                <MudTextField T="string" @bind-Value="_deviceOptions.Radio.USBPort" 
                              Label="Radio USB Port"
                              Variant="Variant.Outlined"
                              HelperText="USB port for Raddy RF320 radio (e.g., /dev/ttyUSB0 on Linux, COM3 on Windows)" />
              </MudItem>
              <MudItem xs="12" md="6">
                <MudTextField T="string" @bind-Value="_deviceOptions.Vinyl.USBPort" 
                              Label="Vinyl USB Port"
                              Variant="Variant.Outlined"
                              HelperText="USB port for vinyl turntable (e.g., /dev/ttyUSB1 on Linux, COM4 on Windows)" />
              </MudItem>
              <MudItem xs="12" md="6">
                <MudTextField T="string" @bind-Value="_deviceOptions.Cast.DefaultDevice" 
                              Label="Default Cast Device"
                              Variant="Variant.Outlined"
                              HelperText="Default Chromecast device name (optional)" />
              </MudItem>
              <MudItem xs="12">
                <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SaveDeviceOptionsAsync"
                           StartIcon="@Icons.Material.Filled.Save" Disabled="@_isSaving">
                  @if (_isSaving) { <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" /> }
                  Save Device Settings
                </MudButton>
              </MudItem>
            </MudGrid>
          }
          else
          {
            <MudProgressCircular Color="Color.Primary" Size="Size.Small" Indeterminate="true" />
            <MudText Class="ml-2">Loading device configuration...</MudText>
          }
        </MudTabPanel>
      </MudTabs>
    </MudTabPanel>

    <!-- Tab 3: Log Viewer -->
    <MudTabPanel Text="Logs" Icon="@Icons.Material.Filled.Article">
      <MudStack Row="true" Spacing="2" Class="mb-3">
        <MudSelect T="string" @bind-Value="_logLevel" Label="Log Level" Variant="Variant.Outlined" Dense="true" Style="min-width: 150px;">
          <MudSelectItem Value="@("info")">Info</MudSelectItem>
          <MudSelectItem Value="@("warning")">Warning</MudSelectItem>
          <MudSelectItem Value="@("error")">Error</MudSelectItem>
        </MudSelect>

        <MudNumericField @bind-Value="_logLimit" Label="Limit" Variant="Variant.Outlined" Min="1" Max="10000" Style="width: 120px;" />

        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="LoadLogsAsync" StartIcon="@Icons.Material.Filled.Refresh">
          Refresh
        </MudButton>

        <MudButton Variant="Variant.Outlined" Color="Color.Secondary" OnClick="ExportLogsAsync" StartIcon="@Icons.Material.Filled.Download" Disabled="@(_logs == null || _logs.Count == 0)">
          Export
        </MudButton>
      </MudStack>

      @if (_logsLoading)
      {
        <MudProgressLinear Color="Color.Primary" Indeterminate="true" />
      }
      else if (_logs != null && _logs.Count > 0)
      {
        <div style="height: 350px; overflow-y: auto;">
          <MudSimpleTable Dense="true" Hover="true" FixedHeader="true">
            <thead>
              <tr>
                <th style="width: 180px;">Timestamp</th>
                <th style="width: 100px;">Level</th>
                <th style="width: 250px;">Source</th>
                <th>Message</th>
              </tr>
            </thead>
            <tbody>
              @foreach (var log in _logs)
              {
                <tr>
                  <td>@log.Timestamp.ToLocalTime().ToString("yyyy-MM-dd HH:mm:ss")</td>
                  <td>
                    <MudChip T="string" Size="Size.Small" Color="@GetLogLevelColor(log.Level)">@log.Level</MudChip>
                  </td>
                  <td>@GetShortSourceName(log.SourceContext)</td>
                  <td>
                    @log.Message
                    @if (!string.IsNullOrEmpty(log.Exception))
                    {
                      <MudText Typo="Typo.caption" Color="Color.Error">@log.Exception</MudText>
                    }
                  </td>
                </tr>
              }
            </tbody>
          </MudSimpleTable>
        </div>
        <MudText Typo="Typo.caption" Class="mt-2">Showing @_logs.Count of @_totalLogCount logs</MudText>
      }
      else
      {
        <MudAlert Severity="Severity.Info">No logs found matching the current filters.</MudAlert>
      }
    </MudTabPanel>

    <!-- Tab 4: Event Sources -->
    <MudTabPanel Text="Event Sources" Icon="@Icons.Material.Filled.EventNote">
      <MudGrid Spacing="3">
        <!-- TTS Section -->
        <MudItem xs="12" md="6">
          <MudCard>
            <MudCardHeader>
              <CardHeaderContent>
                <MudText Typo="Typo.h6">Text-to-Speech</MudText>
              </CardHeaderContent>
            </MudCardHeader>
            <MudCardContent>
              <MudTextField @bind-Value="_ttsText" Label="Message" Variant="Variant.Outlined" Lines="3" />
              
              <MudSelect T="string" Value="_selectedTTSEngine" Label="TTS Engine" Variant="Variant.Outlined" Class="mt-3" ValueChanged="@((string e) => OnTTSEngineChangedAsync(e))">
                @if (_ttsEngines != null)
                {
                  @foreach (var engine in _ttsEngines.Where(e => e.IsAvailable))
                  {
                    <MudSelectItem Value="@engine.Engine">
                      @engine.Name @(engine.IsOffline ? "(Offline)" : "(Online)")
                    </MudSelectItem>
                  }
                }
              </MudSelect>

              @if (_selectedTTSEngine == "Google" && _googleVoices != null && _googleVoices.Count > 0)
              {
                <MudSelect @bind-Value="_ttsVoice" Label="Voice" Variant="Variant.Outlined" Class="mt-3">
                  @foreach (var voice in _googleVoices)
                  {
                    <MudSelectItem Value="@voice.Id">
                      @voice.Name
                    </MudSelectItem>
                  }
                </MudSelect>
              }
              else
              {
                <MudTextField @bind-Value="_ttsVoice" Label="Voice (Optional)" Variant="Variant.Outlined" Class="mt-3" 
                              HelperText="e.g., 'en', 'en-US-Standard-A'" />
              }

              <MudStack Row="true" Spacing="2" Class="mt-3">
                <MudNumericField @bind-Value="_ttsSpeed" Label="Speed" Variant="Variant.Outlined" 
                                 Min="0.5" Max="2.0" Step="0.1" Style="width: 150px;" />
                <MudNumericField @bind-Value="_ttsPitch" Label="Pitch" Variant="Variant.Outlined" 
                                 Min="0.5" Max="2.0" Step="0.1" Style="width: 150px;" />
              </MudStack>
            </MudCardContent>
            <MudCardActions>
              <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.RecordVoiceOver" 
                         OnClick="PlayTTSAsync" Disabled="@(string.IsNullOrWhiteSpace(_ttsText) || _ttsEngines == null || !_ttsEngines.Any(e => e.IsAvailable))">
                Speak
              </MudButton>
            </MudCardActions>
          </MudCard>
        </MudItem>

        <!-- Audio File Section -->
        <MudItem xs="12" md="6">
          <MudCard>
            <MudCardHeader>
              <CardHeaderContent>
                <MudText Typo="Typo.h6">Audio File Events</MudText>
              </CardHeaderContent>
            </MudCardHeader>
            <MudCardContent>
              @if (!string.IsNullOrWhiteSpace(_selectedSoundFile))
              {
                var selectedSound = _notificationSounds?.FirstOrDefault(s => s.FilePath == _selectedSoundFile);
                if (selectedSound != null)
                {
                  <div style="display: flex; align-items: center; gap: 12px; padding: 16px; background: var(--mud-palette-background-grey); border-radius: 8px;">
                    <MudIcon Icon="@Icons.Material.Filled.MusicNote" Color="Color.Primary" Size="Size.Large" />
                    <div style="flex: 1;">
                      <MudText Typo="Typo.body1" Style="font-weight: 500;">@selectedSound.FileName</MudText>
                      <MudText Typo="Typo.caption" Color="Color.Secondary">@FormatFileSize(selectedSound.FileSize)</MudText>
                    </div>
                  </div>
                }
              }
              else
              {
                <MudAlert Severity="Severity.Info" Dense="true">
                  Click "Browse Files" to select an audio file
                </MudAlert>
              }
            </MudCardContent>
            <MudCardActions>
              <MudButton Variant="Variant.Outlined" 
                         Color="Color.Primary" 
                         StartIcon="@Icons.Material.Filled.FolderOpen" 
                         OnClick="OpenFileSelectionDialogAsync"
                         Size="Size.Large">
                Browse Files
              </MudButton>
              <MudButton Variant="Variant.Filled" 
                         Color="Color.Primary" 
                         StartIcon="@Icons.Material.Filled.PlayArrow" 
                         OnClick="PlayFileEventAsync" 
                         Disabled="@(string.IsNullOrWhiteSpace(_selectedSoundFile))"
                         Size="Size.Large">
                Play
              </MudButton>
            </MudCardActions>
          </MudCard>
        </MudItem>

        <!-- Active Event Sources -->
        <MudItem xs="12">
          <MudCard>
            <MudCardHeader>
              <CardHeaderContent>
                <MudText Typo="Typo.h6">Active Event Sources</MudText>
              </CardHeaderContent>
              <CardHeaderActions>
                <MudIconButton Icon="@Icons.Material.Filled.Refresh" Color="Color.Primary" OnClick="LoadEventSourcesAsync" />
              </CardHeaderActions>
            </MudCardHeader>
            <MudCardContent>
              @if (_eventSources != null && _eventSources.Count > 0)
              {
                <MudSimpleTable Dense="true" Hover="true">
                  <thead>
                    <tr>
                      <th>Name</th>
                      <th>Type</th>
                      <th>State</th>
                      <th>Volume</th>
                      <th>Metadata</th>
                      <th style="width: 100px;">Actions</th>
                    </tr>
                  </thead>
                  <tbody>
                    @foreach (var source in _eventSources)
                    {
                      <tr>
                        <td><strong>@source.Name</strong></td>
                        <td>@source.Type</td>
                        <td><MudChip T="string" Size="Size.Small" Color="@GetStateColor(source.State)">@source.State</MudChip></td>
                        <td>@source.Volume.ToString("P0")</td>
                        <td>
                          @if (source.Metadata != null && source.Metadata.Count > 0)
                          {
                            <MudText Typo="Typo.caption">@string.Join(", ", source.Metadata.Select(m => $"{m.Key}: {m.Value}"))</MudText>
                          }
                          else
                          {
                            <MudText Typo="Typo.caption" Color="Color.Default">None</MudText>
                          }
                        </td>
                        <td>
                          <MudIconButton Icon="@Icons.Material.Filled.Replay" 
                                         Color="Color.Primary" 
                                         Size="Size.Small"
                                         OnClick="@(() => ReplayEventAsync(source))"
                                         title="Replay this event" />
                        </td>
                      </tr>
                    }
                  </tbody>
                </MudSimpleTable>
              }
              else if (_eventSourcesLoading)
              {
                <MudProgressCircular Color="Color.Primary" Indeterminate="true" />
              }
              else
              {
                <MudAlert Severity="Severity.Info">No event sources currently active.</MudAlert>
              }
            </MudCardContent>
          </MudCard>
        </MudItem>
      </MudGrid>
    </MudTabPanel>

    <!-- Tab 5: Preferences -->
    <MudTabPanel Text="Preferences" Icon="@Icons.Material.Filled.Settings">
      <MudTabs Elevation="1" Rounded="true" ApplyEffectsToContainer="true" PanelClass="pa-2">
        
        <!-- Audio Preferences -->
        <MudTabPanel Text="Audio">
          @if (_audioPreferences != null)
          {
            <MudGrid Spacing="2">
              <MudItem xs="12">
                <MudAlert Severity="Severity.Info" Dense="true">
                  Audio preferences control the default audio source and master volume settings.
                </MudAlert>
              </MudItem>
              <MudItem xs="12" md="6">
                <MudSelect T="string" @bind-Value="_audioPreferences.CurrentSource" Label="Current Source"
                           Variant="Variant.Outlined" HelperText="Currently active audio source">
                  <MudSelectItem Value="@("Spotify")">Spotify</MudSelectItem>
                  <MudSelectItem Value="@("Radio")">Radio</MudSelectItem>
                  <MudSelectItem Value="@("FilePlayer")">File Player</MudSelectItem>
                  <MudSelectItem Value="@("Vinyl")">Vinyl</MudSelectItem>
