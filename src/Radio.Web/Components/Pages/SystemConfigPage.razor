  private void OnSourceGainChanged(string sourceType, float gain)
  {
    _sourceGainOffsets[sourceType] = gain;
    // Debounce the API call to avoid churn during slider drags
    _sourceGainDebounceTimer?.Dispose();
    _sourceGainDebounceTimer = new System.Threading.Timer(async _ =>
    {
      try
      {
        await AudioApi.SetSourceGainAsync(sourceType, gain);
      }
      catch (Exception ex)
      {
        Logger.LogWarning(ex, "Failed to persist source gain for {SourceType}", sourceType);
      }
    }, null, TimeSpan.FromMilliseconds(300), Timeout.InfiniteTimeSpan);
  }


  private static string FormatGainDb(float gain)
  {
    if (gain <= 0.001f) return "-∞ dB";
    var db = 20.0 * Math.Log10(gain);
    return db >= 0 ? $"+{db:F1}dB" : $"{db:F1}dB";
  }

