  private float GetSourceGainValue(string sourceType)
  {
    return _sourceGainOffsets.TryGetValue(sourceType, out var gain) ? gain : 1.0f;
  }

  private void OnSourceGainChanged(string sourceType, float gain)
  {
    _sourceGainOffsets[sourceType] = gain;
    // Mark as manual in local state immediately for responsive UI
    if (_autoGainStatus.TryGetValue(sourceType, out var info))
      info.Mode = "manual";
    // Debounce the API call to avoid churn during slider drags
    _sourceGainDebounceTimer?.Dispose();
    _sourceGainDebounceTimer = new System.Threading.Timer(async _ =>
    {
      try
      {
        await AudioApi.SetSourceGainAsync(sourceType, gain);
      }
      catch (Exception ex)
      {
        Logger.LogWarning(ex, "Failed to persist source gain for {SourceType}", sourceType);
      }
    }, null, TimeSpan.FromMilliseconds(300), Timeout.InfiniteTimeSpan);
  }

  private AutoGainInfoDto? GetAutoGainInfo(string sourceType)
  {
    return _autoGainStatus.TryGetValue(sourceType, out var info) ? info : null;
  }

  private async Task ResetSourceToAutoAsync(string sourceType)
  {
    var success = await AudioApi.ResetSourceGainToAutoAsync(sourceType);
    if (success)
