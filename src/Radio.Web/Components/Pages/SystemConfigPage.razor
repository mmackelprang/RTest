            <MudProgressCircular Color="Color.Primary" Size="Size.Small" Indeterminate="true" />
            <MudText Class="ml-2">Loading Generic Source preferences...</MudText>
          }
        </MudTabPanel>

      </MudTabs>
    </MudTabPanel>

    <!-- Tab 6: Secrets -->
    <MudTabPanel Text="Secrets" Icon="@Icons.Material.Filled.Lock">
      <MudAlert Severity="Severity.Warning" Dense="true" Class="mb-3">
        <strong>Security Notice:</strong> Secrets are sensitive credentials. Values are masked by default and encrypted server-side. Only enter secrets in secure environments.
      </MudAlert>
      
      <MudTabs Elevation="1" Rounded="true" ApplyEffectsToContainer="true" PanelClass="pa-2">
        
        <!-- Spotify Secrets -->
        <MudTabPanel Text="Spotify">
          @if (_spotifySecrets != null)
          {
            <MudGrid Spacing="2">
              <MudItem xs="12">
                <MudAlert Severity="Severity.Info" Dense="true">
                  Spotify API credentials for authentication. Get these from <a href="https://developer.spotify.com/dashboard" target="_blank">Spotify Developer Dashboard</a>.
                </MudAlert>
              </MudItem>
              <MudItem xs="12">
                <MudTextField T="string" @bind-Value="_spotifySecrets.ClientID" Label="Client ID"
                              Variant="Variant.Outlined" 
                              InputType="@(_showSpotifyClientId ? InputType.Text : InputType.Password)"
                              Adornment="Adornment.End"
                              AdornmentIcon="@(_showSpotifyClientId ? Icons.Material.Filled.VisibilityOff : Icons.Material.Filled.Visibility)"
                              OnAdornmentClick="@(() => _showSpotifyClientId = !_showSpotifyClientId)"
                              HelperText="Spotify application client identifier" />
              </MudItem>
              <MudItem xs="12">
                <MudTextField T="string" @bind-Value="_spotifySecrets.ClientSecret" Label="Client Secret"
                              Variant="Variant.Outlined" 
                              InputType="@(_showSpotifyClientSecret ? InputType.Text : InputType.Password)"
                              Adornment="Adornment.End"
                              AdornmentIcon="@(_showSpotifyClientSecret ? Icons.Material.Filled.VisibilityOff : Icons.Material.Filled.Visibility)"
                              OnAdornmentClick="@(() => _showSpotifyClientSecret = !_showSpotifyClientSecret)"
                              HelperText="Spotify application client secret key" />
              </MudItem>
              <MudItem xs="12">
                <MudTextField T="string" @bind-Value="_spotifySecrets.RefreshToken" Label="Refresh Token"
                              Variant="Variant.Outlined" 
                              InputType="@(_showSpotifyRefreshToken ? InputType.Text : InputType.Password)"
                              Adornment="Adornment.End"
                              AdornmentIcon="@(_showSpotifyRefreshToken ? Icons.Material.Filled.VisibilityOff : Icons.Material.Filled.Visibility)"
                              OnAdornmentClick="@(() => _showSpotifyRefreshToken = !_showSpotifyRefreshToken)"
                              HelperText="OAuth refresh token for user authorization" />
              </MudItem>
              <MudItem xs="12">
                <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SaveSpotifySecretsAsync"
                           StartIcon="@Icons.Material.Filled.Save" Disabled="@_isSaving" Class="mr-2">
                  @if (_isSaving) { <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" /> }
                  Save Secrets
                </MudButton>
                <MudButton Variant="Variant.Outlined" Color="Color.Error" OnClick="ClearSpotifySecretsAsync"
                           StartIcon="@Icons.Material.Filled.DeleteForever" Disabled="@_isSaving">
                  Clear All
                </MudButton>
              </MudItem>
            </MudGrid>
          }
          else
          {
            <MudProgressCircular Color="Color.Primary" Size="Size.Small" Indeterminate="true" />
            <MudText Class="ml-2">Loading Spotify secrets...</MudText>
          }
        </MudTabPanel>

        <!-- TTS Secrets -->
        <MudTabPanel Text="TTS Services">
          @if (_ttsSecrets != null)
          {
            <MudGrid Spacing="2">
              <MudItem xs="12">
                <MudAlert Severity="Severity.Info" Dense="true">
                  API keys for cloud-based Text-to-Speech services. Optional - only needed if using Google or Azure TTS.
                </MudAlert>
              </MudItem>
              <MudItem xs="12">
                <MudTextField T="string" @bind-Value="_ttsSecrets.GoogleAPIKey" Label="Google API Key"
                              Variant="Variant.Outlined" 
                              InputType="@(_showGoogleApiKey ? InputType.Text : InputType.Password)"
                              Adornment="Adornment.End"
                              AdornmentIcon="@(_showGoogleApiKey ? Icons.Material.Filled.VisibilityOff : Icons.Material.Filled.Visibility)"
                              OnAdornmentClick="@(() => _showGoogleApiKey = !_showGoogleApiKey)"
                              HelperText="Google Cloud Text-to-Speech API key" />
              </MudItem>
              <MudItem xs="12">
                <MudTextField T="string" @bind-Value="_ttsSecrets.AzureAPIKey" Label="Azure API Key"
                              Variant="Variant.Outlined" 
                              InputType="@(_showAzureApiKey ? InputType.Text : InputType.Password)"
                              Adornment="Adornment.End"
                              AdornmentIcon="@(_showAzureApiKey ? Icons.Material.Filled.VisibilityOff : Icons.Material.Filled.Visibility)"
                              OnAdornmentClick="@(() => _showAzureApiKey = !_showAzureApiKey)"
                              HelperText="Azure Cognitive Services Speech API key" />
              </MudItem>
              <MudItem xs="12">
                <MudTextField T="string" @bind-Value="_ttsSecrets.AzureRegion" Label="Azure Region"
                              Variant="Variant.Outlined" 
                              HelperText="Azure region (e.g., eastus, westus2)" />
              </MudItem>
              <MudItem xs="12">
                <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SaveTTSSecretsAsync"
                           StartIcon="@Icons.Material.Filled.Save" Disabled="@_isSaving" Class="mr-2">
                  @if (_isSaving) { <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" /> }
                  Save Secrets
                </MudButton>
                <MudButton Variant="Variant.Outlined" Color="Color.Error" OnClick="ClearTTSSecretsAsync"
                           StartIcon="@Icons.Material.Filled.DeleteForever" Disabled="@_isSaving">
                  Clear All
                </MudButton>
              </MudItem>
            </MudGrid>
          }
          else
          {
            <MudProgressCircular Color="Color.Primary" Size="Size.Small" Indeterminate="true" />
            <MudText Class="ml-2">Loading TTS secrets...</MudText>
          }
        </MudTabPanel>

        <!-- AcoustID Secret -->
        <MudTabPanel Text="AcoustID">
          @if (_acoustIdSecret != null)
          {
            <MudGrid Spacing="2">
              <MudItem xs="12">
                <MudAlert Severity="Severity.Info" Dense="true">
                  AcoustID API key for audio fingerprinting. Get your key from <a href="https://acoustid.org/new-application" target="_blank">AcoustID</a>.
                </MudAlert>
              </MudItem>
              <MudItem xs="12">
                <MudTextField T="string" @bind-Value="_acoustIdSecret.ApiKey" Label="API Key"
                              Variant="Variant.Outlined" 
                              InputType="@(_showAcoustIdApiKey ? InputType.Text : InputType.Password)"
                              Adornment="Adornment.End"
                              AdornmentIcon="@(_showAcoustIdApiKey ? Icons.Material.Filled.VisibilityOff : Icons.Material.Filled.Visibility)"
                              OnAdornmentClick="@(() => _showAcoustIdApiKey = !_showAcoustIdApiKey)"
                              HelperText="AcoustID application API key" />
              </MudItem>
              <MudItem xs="12">
                <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SaveAcoustIdSecretAsync"
                           StartIcon="@Icons.Material.Filled.Save" Disabled="@_isSaving" Class="mr-2">
                  @if (_isSaving) { <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" /> }
                  Save Secret
                </MudButton>
                <MudButton Variant="Variant.Outlined" Color="Color.Error" OnClick="ClearAcoustIdSecretAsync"
                           StartIcon="@Icons.Material.Filled.DeleteForever" Disabled="@_isSaving">
                  Clear
                </MudButton>
              </MudItem>
            </MudGrid>
          }
          else
          {
            <MudProgressCircular Color="Color.Primary" Size="Size.Small" Indeterminate="true" />
            <MudText Class="ml-2">Loading AcoustID secret...</MudText>
          }
        </MudTabPanel>

      </MudTabs>
    </MudTabPanel>

  </MudTabs>
</MudContainer>

@code {
  private int _activeTab = 0;
  private System.Threading.Timer? _statsTimer;

  // System Stats
  private double _cpuUsage = 0;
  private double _ramUsageMb = 0;
  private double _diskUsage = 0;
  private int _threadCount = 0;
  private string _appUptime = "N/A";
  private string _systemUptime = "N/A";
  private string _temperature = "N/A";
  private string _audioEngineState = "Unknown";

  // Configuration
  private AudioConfigurationDto? _audioConfig;
  private VisualizerConfigurationDto? _visualizerConfig;
  private OutputConfigurationDto? _outputConfig;
  private DeviceOptionsDto? _deviceOptions;
  private bool _isSaving = false;

  // Preferences
  private AudioPreferencesDto? _audioPreferences;
  private SpotifyPreferencesDto? _spotifyPreferences;
  private FilePlayerPreferencesDto? _filePlayerPreferences;
  private RadioPreferencesDto? _radioPreferences;
  private GenericSourcePreferencesDto? _genericSourcePreferences;

  // Secrets
  private SpotifySecretsDto? _spotifySecrets;
  private TTSSecretsDto? _ttsSecrets;
  private AcoustIdSecretDto? _acoustIdSecret;
  
  // Secrets visibility toggles
  private bool _showSpotifyClientId = false;
  private bool _showSpotifyClientSecret = false;
  private bool _showSpotifyRefreshToken = false;
  private bool _showGoogleApiKey = false;
  private bool _showAzureApiKey = false;
  private bool _showAcoustIdApiKey = false;

  // Output configuration individual fields (for binding)
  private bool _localOutputEnabled;
  private string _localPreferredDevice = "";
  private float _localDefaultVolume;
  private bool _httpStreamEnabled;
  private int _httpStreamPort;
  private int _httpStreamSampleRate;
  private int _httpStreamChannels;
  private bool _castEnabled;
  private int _castDiscoveryTimeout;
  private float _castDefaultVolume;

  // Logs
  private string _logLevel = "warning";
  private int _logLimit = 100;
  private List<LogEntryDto> _logs = new();
  private int _totalLogCount = 0;
  private bool _logsLoading = false;

  // Event Sources
  private List<AudioSourceDto>? _eventSources;
  private bool _eventSourcesLoading = false;

  // TTS
  private List<TTSEngineInfoDto>? _ttsEngines;
  private List<TTSVoiceInfoDto>? _googleVoices;
  private string _ttsText = string.Empty;
  private string _selectedTTSEngine = "ESpeak";
  private string _ttsVoice = "en";
  private double _ttsSpeed = 1.0;
  private double _ttsPitch = 1.0;

  // Audio Files
  private List<NotificationSoundDto>? _notificationSounds;
  private string _selectedSoundFile = string.Empty;

  protected override async Task OnInitializedAsync()
  {
    // Load initial data
    await LoadSystemStatsAsync();
    await LoadConfigurationAsync();
    await LoadPreferencesAsync();
    await LoadSecretsAsync();
    await LoadLogsAsync();
    await LoadEventSourcesAsync();
    await LoadTTSEnginesAsync();
    await LoadNotificationSoundsAsync();

    // Setup SignalR for real-time event source updates
    await InitializeSignalRAsync();

    // Update system stats every 5 seconds
    _statsTimer = new System.Threading.Timer(_ =>
    {
      InvokeAsync(async () =>
      {
        await LoadSystemStatsAsync();
        StateHasChanged();
      });
    }, null, TimeSpan.FromSeconds(5), TimeSpan.FromSeconds(5));
  }

  private async Task InitializeSignalRAsync()
  {
    try
    {
      // Subscribe to source changes to catch event source updates
      HubService.SourceChanged += async () =>
      {
        await InvokeAsync(async () =>
        {
          await LoadEventSourcesAsync();
          StateHasChanged();
        });
      };

      // Start the hub connection if not already connected
      if (!HubService.IsConnected)
      {
        await HubService.StartAsync();
      }
    }
    catch (Exception ex)
    {
      Logger.LogWarning(ex, "Failed to initialize SignalR for event source updates, falling back to manual refresh");
      // Silently fail - fallback to manual refresh
    }
  }

  private async Task LoadSystemStatsAsync()
  {
    try
    {
      var stats = await SystemApi.GetSystemStatsAsync();
      if (stats != null)
      {
        _cpuUsage = stats.CpuUsagePercent;
        _ramUsageMb = stats.RamUsageMb;
        _diskUsage = stats.DiskUsagePercent;
        _threadCount = stats.ThreadCount;
        _appUptime = stats.AppUptime;
        _systemUptime = stats.SystemUptime;
        _temperature = stats.SystemTemperature;
        _audioEngineState = stats.AudioEngineState;
      }
    }
    catch (Exception)
    {
      // Silently fail - stats will show default values
    }
  }

  private async Task LoadConfigurationAsync()
  {
    try
    {
      _audioConfig = await ConfigApi.GetConfigurationAsync<AudioConfigurationDto>("audio");
      _visualizerConfig = await ConfigApi.GetConfigurationAsync<VisualizerConfigurationDto>("visualizer");
      _outputConfig = await ConfigApi.GetConfigurationAsync<OutputConfigurationDto>("output");
      
      // Load device options, create default if not found
      var deviceOptions = await ConfigApi.GetConfigurationAsync<DeviceOptionsDto>("devices");
      _deviceOptions = deviceOptions ?? new DeviceOptionsDto();

      // Populate output config individual fields for binding
      if (_outputConfig != null)
      {
        _localOutputEnabled = _outputConfig.Local?.Enabled ?? false;
        _localPreferredDevice = _outputConfig.Local?.PreferredDeviceId ?? "";
        _localDefaultVolume = _outputConfig.Local?.DefaultVolume ?? 0.8f;
        _httpStreamEnabled = _outputConfig.HttpStream?.Enabled ?? false;
        _httpStreamPort = _outputConfig.HttpStream?.Port ?? 8080;
        _httpStreamSampleRate = _outputConfig.HttpStream?.SampleRate ?? 48000;
        _httpStreamChannels = _outputConfig.HttpStream?.Channels ?? 2;
        _castEnabled = _outputConfig.GoogleCast?.Enabled ?? false;
        _castDiscoveryTimeout = _outputConfig.GoogleCast?.DiscoveryTimeoutSeconds ?? 10;
        _castDefaultVolume = _outputConfig.GoogleCast?.DefaultVolume ?? 0.7f;
      }
    }
    catch (Exception ex)
    {
      Snackbar.Add($"Failed to load configuration: {ex.Message}", Severity.Error);
    }
  }

  private async Task LoadLogsAsync()
  {
    _logsLoading = true;
    try
    {
      var response = await SystemApi.GetSystemLogsAsync(_logLevel, _logLimit);
      if (response != null)
      {
        _logs = response.Logs;
        _totalLogCount = response.TotalCount;
      }
      else
      {
        _logs = new List<LogEntryDto>();
        _totalLogCount = 0;
      }
    }
    catch (Exception)
    {
      Snackbar.Add("Failed to load logs", Severity.Error);
      _logs = new List<LogEntryDto>();
    }
    finally
    {
      _logsLoading = false;
    }
  }

  private async Task LoadEventSourcesAsync()
  {
    _eventSourcesLoading = true;
    try
    {
      _eventSources = await SourcesApi.GetEventSourcesAsync();
    }
    catch (Exception)
    {
      Snackbar.Add("Failed to load event sources", Severity.Error);
    }
    finally
    {
      _eventSourcesLoading = false;
    }
  }

  private async Task LoadTTSEnginesAsync()
  {
    try
    {
      _ttsEngines = await SourcesApi.GetTTSEnginesAsync();
      if (_ttsEngines != null && _ttsEngines.Any(e => e.IsAvailable))
      {
        _selectedTTSEngine = _ttsEngines.First(e => e.IsAvailable).Engine;
        
        // Load voices if Google is selected
        if (_selectedTTSEngine == "Google")
        {
          await LoadGoogleVoicesAsync();
        }
      }
    }
    catch (Exception)
    {
      // Silently fail - TTS section will show as unavailable
    }
  }

  private async Task OnTTSEngineChangedAsync(string engine)
  {
    _selectedTTSEngine = engine;
    
    // Load Google voices when Google engine is selected
    if (engine == "Google")
    {
      await LoadGoogleVoicesAsync();
    }
    else
    {
      _googleVoices = null;
    }
    
    StateHasChanged();
  }

  private async Task LoadGoogleVoicesAsync()
  {
    try
    {
      _googleVoices = await SourcesApi.GetTTSVoicesAsync("Google");
      
      // Set default voice if available
      if (_googleVoices != null && _googleVoices.Count > 0)
      {
        _ttsVoice = _googleVoices[0].Id;
      }
    }
    catch (Exception ex)
    {
      Logger.LogWarning(ex, "Failed to load Google TTS voices for engine {Engine}", "Google");
      // Silently fail - voice dropdown will not be shown
    }
  }

  private async Task LoadNotificationSoundsAsync()
  {
    try
    {
      _notificationSounds = await SourcesApi.GetNotificationSoundsAsync();
      if (_notificationSounds != null && _notificationSounds.Count > 0)
      {
        _selectedSoundFile = _notificationSounds[0].FilePath;
      }
    }
    catch (Exception)
    {
      // Silently fail - audio file section will show as unavailable
    }
