@page "/system"
@rendermode InteractiveServer
@inject SystemApiService SystemApi
@inject ConfigurationApiService ConfigApi
@inject SourcesApiService SourcesApi
@inject AudioStateHubService HubService
@inject ISnackbar Snackbar
@inject IJSRuntime JSRuntime
@inject IDialogService DialogService
@implements IDisposable

<PageTitle>System Configuration</PageTitle>

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Style="height: 516px; padding: 16px;">
  <MudTabs Elevation="2" Rounded="true" ApplyEffectsToContainer="true" PanelClass="pa-4" @bind-ActivePanelIndex="_activeTab">
    
    <!-- Tab 1: System Statistics -->
    <MudTabPanel Text="System Stats" Icon="@Icons.Material.Filled.Insights">
      <MudGrid Spacing="3">
        <!-- CPU Usage -->
        <MudItem xs="6" md="3">
          <MudCard>
            <MudCardContent>
              <MudText Typo="Typo.h6">CPU Usage</MudText>
              <MudProgressCircular Color="Color.Primary" Size="Size.Large" Value="@_cpuUsage" />
              <MudText Typo="Typo.h5" Color="Color.Primary">@_cpuUsage.ToString("F1")%</MudText>
            </MudCardContent>
          </MudCard>
        </MudItem>

        <!-- RAM Usage -->
        <MudItem xs="6" md="3">
          <MudCard>
            <MudCardContent>
              <MudText Typo="Typo.h6">RAM Usage</MudText>
              <MudProgressCircular Color="Color.Secondary" Size="Size.Large" Value="@(_ramUsageMb / 10)" />
              <MudText Typo="Typo.h5" Color="Color.Secondary">@_ramUsageMb.ToString("F0") MB</MudText>
            </MudCardContent>
          </MudCard>
        </MudItem>

        <!-- Disk Usage -->
        <MudItem xs="6" md="3">
          <MudCard>
            <MudCardContent>
              <MudText Typo="Typo.h6">Disk Usage</MudText>
              <MudProgressCircular Color="Color.Info" Size="Size.Large" Value="@_diskUsage" />
              <MudText Typo="Typo.h5" Color="Color.Info">@_diskUsage.ToString("F1")%</MudText>
            </MudCardContent>
          </MudCard>
        </MudItem>

        <!-- Thread Count -->
        <MudItem xs="6" md="3">
          <MudCard>
            <MudCardContent>
              <MudText Typo="Typo.h6">Active Threads</MudText>
              <MudText Typo="Typo.h3" Color="Color.Success">@_threadCount</MudText>
            </MudCardContent>
          </MudCard>
        </MudItem>

        <!-- App Uptime -->
        <MudItem xs="6" md="4">
          <MudCard>
            <MudCardContent>
              <MudText Typo="Typo.h6">App Uptime</MudText>
              <MudText Typo="Typo.body1">@_appUptime</MudText>
            </MudCardContent>
          </MudCard>
        </MudItem>

        <!-- System Uptime -->
        <MudItem xs="6" md="4">
          <MudCard>
            <MudCardContent>
              <MudText Typo="Typo.h6">System Uptime</MudText>
              <MudText Typo="Typo.body1">@_systemUptime</MudText>
            </MudCardContent>
          </MudCard>
        </MudItem>

        <!-- Temperature -->
        <MudItem xs="6" md="4">
          <MudCard>
            <MudCardContent>
              <MudText Typo="Typo.h6">Temperature</MudText>
              <MudText Typo="Typo.body1" Color="@(_temperature == "N/A" ? Color.Default : Color.Warning)">@_temperature</MudText>
            </MudCardContent>
          </MudCard>
        </MudItem>

        <!-- Audio Engine State -->
        <MudItem xs="12">
          <MudCard>
            <MudCardContent>
              <MudText Typo="Typo.h6">Audio Engine State</MudText>
              <MudText Typo="Typo.body1">@_audioEngineState</MudText>
            </MudCardContent>
          </MudCard>
        </MudItem>
      </MudGrid>
    </MudTabPanel>

    <!-- Tab 2: Configuration Management -->
    <MudTabPanel Text="Configuration" Icon="@Icons.Material.Filled.Tune">
      <MudTabs Elevation="1" Rounded="true" ApplyEffectsToContainer="true" PanelClass="pa-2">
        
        <!-- Audio Configuration -->
        <MudTabPanel Text="Audio">
          @if (_audioConfig != null)
          {
            <MudSimpleTable Dense="true" Hover="true">
              <thead>
                <tr>
                  <th>Setting</th>
                  <th>Value</th>
                </tr>
              </thead>
              <tbody>
                <tr><td><strong>Default Source</strong></td><td>@(_audioConfig.DefaultSource ?? "N/A")</td></tr>
                <tr><td><strong>Ducking Percentage</strong></td><td>@_audioConfig.DuckingPercentage%</td></tr>
                <tr><td><strong>Ducking Policy</strong></td><td>@(_audioConfig.DuckingPolicy ?? "N/A")</td></tr>
                <tr><td><strong>Ducking Attack (ms)</strong></td><td>@_audioConfig.DuckingAttackMs</td></tr>
                <tr><td><strong>Ducking Release (ms)</strong></td><td>@_audioConfig.DuckingReleaseMs</td></tr>
              </tbody>
            </MudSimpleTable>
          }
          else
          {
            <MudProgressCircular Color="Color.Primary" Size="Size.Small" Indeterminate="true" />
            <MudText Class="ml-2">Loading audio configuration...</MudText>
          }
        </MudTabPanel>

        <!-- Visualizer Configuration -->
        <MudTabPanel Text="Visualizer">
          @if (_visualizerConfig != null)
          {
            <MudSimpleTable Dense="true" Hover="true">
              <thead>
                <tr>
                  <th>Setting</th>
                  <th>Value</th>
                </tr>
              </thead>
              <tbody>
                <tr><td><strong>FFT Size</strong></td><td>@_visualizerConfig.FFTSize</td></tr>
                <tr><td><strong>Waveform Samples</strong></td><td>@_visualizerConfig.WaveformSampleCount</td></tr>
                <tr><td><strong>Peak Hold (ms)</strong></td><td>@_visualizerConfig.PeakHoldTimeMs</td></tr>
                <tr><td><strong>Window Function</strong></td><td>@(_visualizerConfig.ApplyWindowFunction ? "Enabled" : "Disabled")</td></tr>
                <tr><td><strong>Spectrum Smoothing</strong></td><td>@_visualizerConfig.SpectrumSmoothing.ToString("F2")</td></tr>
              </tbody>
            </MudSimpleTable>
          }
          else
          {
            <MudProgressCircular Color="Color.Primary" Size="Size.Small" Indeterminate="true" />
            <MudText Class="ml-2">Loading visualizer configuration...</MudText>
          }
        </MudTabPanel>

        <!-- Output Configuration -->
        <MudTabPanel Text="Output">
          @if (_outputConfig != null)
          {
            <MudText Typo="Typo.subtitle1" Class="mb-2">Local Output</MudText>
            <MudSimpleTable Dense="true" Hover="true" Class="mb-4">
              <tbody>
                <tr><td><strong>Enabled</strong></td><td>@(_outputConfig.Local?.Enabled == true ? "Yes" : "No")</td></tr>
                <tr><td><strong>Preferred Device</strong></td><td>@(_outputConfig.Local?.PreferredDeviceId ?? "Default")</td></tr>
                <tr><td><strong>Default Volume</strong></td><td>@((_outputConfig.Local?.DefaultVolume ?? 0) * 100)%</td></tr>
              </tbody>
            </MudSimpleTable>

            <MudText Typo="Typo.subtitle1" Class="mb-2">HTTP Stream</MudText>
            <MudSimpleTable Dense="true" Hover="true" Class="mb-4">
              <tbody>
                <tr><td><strong>Enabled</strong></td><td>@(_outputConfig.HttpStream?.Enabled == true ? "Yes" : "No")</td></tr>
                <tr><td><strong>Port</strong></td><td>@(_outputConfig.HttpStream?.Port ?? 0)</td></tr>
                <tr><td><strong>Endpoint</strong></td><td>@(_outputConfig.HttpStream?.EndpointPath ?? "N/A")</td></tr>
                <tr><td><strong>Sample Rate</strong></td><td>@(_outputConfig.HttpStream?.SampleRate ?? 0) Hz</td></tr>
                <tr><td><strong>Channels</strong></td><td>@(_outputConfig.HttpStream?.Channels ?? 0)</td></tr>
              </tbody>
            </MudSimpleTable>

            <MudText Typo="Typo.subtitle1" Class="mb-2">Google Cast</MudText>
            <MudSimpleTable Dense="true" Hover="true">
              <tbody>
                <tr><td><strong>Enabled</strong></td><td>@(_outputConfig.GoogleCast?.Enabled == true ? "Yes" : "No")</td></tr>
                <tr><td><strong>Discovery Timeout</strong></td><td>@(_outputConfig.GoogleCast?.DiscoveryTimeoutSeconds ?? 0)s</td></tr>
                <tr><td><strong>Default Volume</strong></td><td>@((_outputConfig.GoogleCast?.DefaultVolume ?? 0) * 100)%</td></tr>
              </tbody>
            </MudSimpleTable>
          }
          else
          {
            <MudProgressCircular Color="Color.Primary" Size="Size.Small" Indeterminate="true" />
            <MudText Class="ml-2">Loading output configuration...</MudText>
          }
        </MudTabPanel>
      </MudTabs>
      
      <MudAlert Severity="Severity.Info" Class="mt-4">
        Configuration editing will be enhanced in future updates. Currently showing read-only values.
      </MudAlert>
    </MudTabPanel>

    <!-- Tab 3: Log Viewer -->
    <MudTabPanel Text="Logs" Icon="@Icons.Material.Filled.Article">
      <MudStack Row="true" Spacing="2" Class="mb-3">
        <MudSelect T="string" @bind-Value="_logLevel" Label="Log Level" Variant="Variant.Outlined" Dense="true" Style="min-width: 150px;">
          <MudSelectItem Value="@("info")">Info</MudSelectItem>
          <MudSelectItem Value="@("warning")">Warning</MudSelectItem>
          <MudSelectItem Value="@("error")">Error</MudSelectItem>
        </MudSelect>

        <MudNumericField @bind-Value="_logLimit" Label="Limit" Variant="Variant.Outlined" Min="1" Max="10000" Style="width: 120px;" />

        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="LoadLogsAsync" StartIcon="@Icons.Material.Filled.Refresh">
          Refresh
        </MudButton>

        <MudButton Variant="Variant.Outlined" Color="Color.Secondary" OnClick="ExportLogsAsync" StartIcon="@Icons.Material.Filled.Download" Disabled="@(_logs == null || _logs.Count == 0)">
          Export
        </MudButton>
      </MudStack>

      @if (_logsLoading)
      {
        <MudProgressLinear Color="Color.Primary" Indeterminate="true" />
      }
      else if (_logs != null && _logs.Count > 0)
      {
        <div style="height: 350px; overflow-y: auto;">
          <MudSimpleTable Dense="true" Hover="true" FixedHeader="true">
            <thead>
              <tr>
                <th style="width: 180px;">Timestamp</th>
                <th style="width: 100px;">Level</th>
                <th style="width: 250px;">Source</th>
                <th>Message</th>
              </tr>
            </thead>
            <tbody>
              @foreach (var log in _logs)
              {
                <tr>
                  <td>@log.Timestamp.ToLocalTime().ToString("yyyy-MM-dd HH:mm:ss")</td>
                  <td>
                    <MudChip T="string" Size="Size.Small" Color="@GetLogLevelColor(log.Level)">@log.Level</MudChip>
                  </td>
                  <td>@GetShortSourceName(log.SourceContext)</td>
                  <td>
                    @log.Message
                    @if (!string.IsNullOrEmpty(log.Exception))
                    {
                      <MudText Typo="Typo.caption" Color="Color.Error">@log.Exception</MudText>
                    }
                  </td>
                </tr>
              }
            </tbody>
          </MudSimpleTable>
        </div>
        <MudText Typo="Typo.caption" Class="mt-2">Showing @_logs.Count of @_totalLogCount logs</MudText>
      }
      else
      {
        <MudAlert Severity="Severity.Info">No logs found matching the current filters.</MudAlert>
      }
    </MudTabPanel>

    <!-- Tab 4: Event Sources -->
    <MudTabPanel Text="Event Sources" Icon="@Icons.Material.Filled.EventNote">
      <MudGrid Spacing="3">
        <!-- TTS Section -->
        <MudItem xs="12" md="6">
          <MudCard>
            <MudCardHeader>
              <CardHeaderContent>
                <MudText Typo="Typo.h6">Text-to-Speech</MudText>
              </CardHeaderContent>
            </MudCardHeader>
            <MudCardContent>
              <MudTextField @bind-Value="_ttsText" Label="Message" Variant="Variant.Outlined" Lines="3" />
              
              <MudSelect T="string" Value="_selectedTTSEngine" Label="TTS Engine" Variant="Variant.Outlined" Class="mt-3" ValueChanged="@((string e) => OnTTSEngineChangedAsync(e))">
                @if (_ttsEngines != null)
                {
                  @foreach (var engine in _ttsEngines.Where(e => e.IsAvailable))
                  {
                    <MudSelectItem Value="@engine.Engine">
                      @engine.Name @(engine.IsOffline ? "(Offline)" : "(Online)")
                    </MudSelectItem>
                  }
                }
              </MudSelect>

              @if (_selectedTTSEngine == "Google" && _googleVoices != null && _googleVoices.Count > 0)
              {
                <MudSelect @bind-Value="_ttsVoice" Label="Voice" Variant="Variant.Outlined" Class="mt-3">
                  @foreach (var voice in _googleVoices)
                  {
                    <MudSelectItem Value="@voice.Id">
                      @voice.Name
                    </MudSelectItem>
                  }
                </MudSelect>
              }
              else
              {
                <MudTextField @bind-Value="_ttsVoice" Label="Voice (Optional)" Variant="Variant.Outlined" Class="mt-3" 
                              HelperText="e.g., 'en', 'en-US-Standard-A'" />
              }

              <MudStack Row="true" Spacing="2" Class="mt-3">
                <MudNumericField @bind-Value="_ttsSpeed" Label="Speed" Variant="Variant.Outlined" 
                                 Min="0.5" Max="2.0" Step="0.1" Style="width: 150px;" />
                <MudNumericField @bind-Value="_ttsPitch" Label="Pitch" Variant="Variant.Outlined" 
                                 Min="0.5" Max="2.0" Step="0.1" Style="width: 150px;" />
              </MudStack>
            </MudCardContent>
            <MudCardActions>
              <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.RecordVoiceOver" 
                         OnClick="PlayTTSAsync" Disabled="@(string.IsNullOrWhiteSpace(_ttsText) || _ttsEngines == null || !_ttsEngines.Any(e => e.IsAvailable))">
                Speak
              </MudButton>
            </MudCardActions>
          </MudCard>
        </MudItem>

        <!-- Audio File Section -->
        <MudItem xs="12" md="6">
          <MudCard>
            <MudCardHeader>
              <CardHeaderContent>
                <MudText Typo="Typo.h6">Audio File Events</MudText>
              </CardHeaderContent>
            </MudCardHeader>
            <MudCardContent>
              @if (!string.IsNullOrWhiteSpace(_selectedSoundFile))
              {
                var selectedSound = _notificationSounds?.FirstOrDefault(s => s.FilePath == _selectedSoundFile);
                if (selectedSound != null)
                {
                  <div style="display: flex; align-items: center; gap: 12px; padding: 16px; background: var(--mud-palette-background-grey); border-radius: 8px;">
                    <MudIcon Icon="@Icons.Material.Filled.MusicNote" Color="Color.Primary" Size="Size.Large" />
                    <div style="flex: 1;">
                      <MudText Typo="Typo.body1" Style="font-weight: 500;">@selectedSound.FileName</MudText>
                      <MudText Typo="Typo.caption" Color="Color.Secondary">@FormatFileSize(selectedSound.FileSize)</MudText>
                    </div>
                  </div>
                }
              }
              else
              {
                <MudAlert Severity="Severity.Info" Dense="true">
                  Click "Browse Files" to select an audio file
                </MudAlert>
              }
            </MudCardContent>
            <MudCardActions>
              <MudButton Variant="Variant.Outlined" 
                         Color="Color.Primary" 
                         StartIcon="@Icons.Material.Filled.FolderOpen" 
                         OnClick="OpenFileSelectionDialogAsync"
                         Size="Size.Large">
                Browse Files
              </MudButton>
              <MudButton Variant="Variant.Filled" 
                         Color="Color.Primary" 
                         StartIcon="@Icons.Material.Filled.PlayArrow" 
                         OnClick="PlayFileEventAsync" 
                         Disabled="@(string.IsNullOrWhiteSpace(_selectedSoundFile))"
                         Size="Size.Large">
                Play
              </MudButton>
            </MudCardActions>
          </MudCard>
        </MudItem>

        <!-- Active Event Sources -->
        <MudItem xs="12">
          <MudCard>
            <MudCardHeader>
              <CardHeaderContent>
                <MudText Typo="Typo.h6">Active Event Sources</MudText>
              </CardHeaderContent>
              <CardHeaderActions>
                <MudIconButton Icon="@Icons.Material.Filled.Refresh" Color="Color.Primary" OnClick="LoadEventSourcesAsync" />
              </CardHeaderActions>
            </MudCardHeader>
            <MudCardContent>
              @if (_eventSources != null && _eventSources.Count > 0)
              {
                <MudSimpleTable Dense="true" Hover="true">
                  <thead>
                    <tr>
                      <th>Name</th>
                      <th>Type</th>
                      <th>State</th>
                      <th>Volume</th>
                      <th>Metadata</th>
                      <th style="width: 100px;">Actions</th>
                    </tr>
                  </thead>
                  <tbody>
                    @foreach (var source in _eventSources)
                    {
                      <tr>
                        <td><strong>@source.Name</strong></td>
                        <td>@source.Type</td>
                        <td><MudChip T="string" Size="Size.Small" Color="@GetStateColor(source.State)">@source.State</MudChip></td>
                        <td>@source.Volume.ToString("P0")</td>
                        <td>
                          @if (source.Metadata != null && source.Metadata.Count > 0)
                          {
                            <MudText Typo="Typo.caption">@string.Join(", ", source.Metadata.Select(m => $"{m.Key}: {m.Value}"))</MudText>
                          }
                          else
                          {
                            <MudText Typo="Typo.caption" Color="Color.Default">None</MudText>
                          }
                        </td>
                        <td>
                          <MudIconButton Icon="@Icons.Material.Filled.Replay" 
                                         Color="Color.Primary" 
                                         Size="Size.Small"
                                         OnClick="@(() => ReplayEventAsync(source))"
                                         title="Replay this event" />
                        </td>
                      </tr>
                    }
                  </tbody>
                </MudSimpleTable>
              }
              else if (_eventSourcesLoading)
              {
                <MudProgressCircular Color="Color.Primary" Indeterminate="true" />
              }
              else
              {
                <MudAlert Severity="Severity.Info">No event sources currently active.</MudAlert>
              }
            </MudCardContent>
          </MudCard>
        </MudItem>
      </MudGrid>
    </MudTabPanel>

  </MudTabs>
</MudContainer>

@code {
  private int _activeTab = 0;
  private System.Threading.Timer? _statsTimer;

  // System Stats
  private double _cpuUsage = 0;
  private double _ramUsageMb = 0;
  private double _diskUsage = 0;
  private int _threadCount = 0;
  private string _appUptime = "N/A";
  private string _systemUptime = "N/A";
  private string _temperature = "N/A";
  private string _audioEngineState = "Unknown";

  // Configuration
  private AudioConfigurationDto? _audioConfig;
  private VisualizerConfigurationDto? _visualizerConfig;
  private OutputConfigurationDto? _outputConfig;

  // Logs
  private string _logLevel = "warning";
  private int _logLimit = 100;
  private List<LogEntryDto> _logs = new();
  private int _totalLogCount = 0;
  private bool _logsLoading = false;

  // Event Sources
  private List<AudioSourceDto>? _eventSources;
  private bool _eventSourcesLoading = false;

  // TTS
  private List<TTSEngineInfoDto>? _ttsEngines;
  private List<TTSVoiceInfoDto>? _googleVoices;
  private string _ttsText = string.Empty;
  private string _selectedTTSEngine = "ESpeak";
  private string _ttsVoice = "en";
  private double _ttsSpeed = 1.0;
  private double _ttsPitch = 1.0;

  // Audio Files
  private List<NotificationSoundDto>? _notificationSounds;
  private string _selectedSoundFile = string.Empty;

  protected override async Task OnInitializedAsync()
  {
    // Load initial data
    await LoadSystemStatsAsync();
    await LoadConfigurationAsync();
    await LoadLogsAsync();
    await LoadEventSourcesAsync();
    await LoadTTSEnginesAsync();
    await LoadNotificationSoundsAsync();

    // Setup SignalR for real-time event source updates
    await InitializeSignalRAsync();

    // Update system stats every 5 seconds
    _statsTimer = new System.Threading.Timer(_ =>
    {
      InvokeAsync(async () =>
      {
        await LoadSystemStatsAsync();
        StateHasChanged();
      });
    }, null, TimeSpan.FromSeconds(5), TimeSpan.FromSeconds(5));
  }

  private async Task InitializeSignalRAsync()
  {
    try
    {
      // Subscribe to source changes to catch event source updates
      HubService.SourceChanged += async () =>
      {
        await InvokeAsync(async () =>
        {
          await LoadEventSourcesAsync();
          StateHasChanged();
        });
      };

      // Start the hub connection if not already connected
      if (!HubService.IsConnected)
      {
        await HubService.StartAsync();
      }
    }
    catch (Exception)
    {
      // Silently fail - fallback to manual refresh
    }
  }

  private async Task LoadSystemStatsAsync()
  {
    try
    {
      var stats = await SystemApi.GetSystemStatsAsync();
      if (stats != null)
      {
        _cpuUsage = stats.CpuUsagePercent;
        _ramUsageMb = stats.RamUsageMb;
        _diskUsage = stats.DiskUsagePercent;
        _threadCount = stats.ThreadCount;
        _appUptime = stats.AppUptime;
        _systemUptime = stats.SystemUptime;
        _temperature = stats.SystemTemperature;
        _audioEngineState = stats.AudioEngineState;
      }
    }
    catch (Exception)
    {
      // Silently fail - stats will show default values
    }
  }

  private async Task LoadConfigurationAsync()
  {
    try
    {
      _audioConfig = await ConfigApi.GetConfigurationAsync<AudioConfigurationDto>("audio");
      _visualizerConfig = await ConfigApi.GetConfigurationAsync<VisualizerConfigurationDto>("visualizer");
      _outputConfig = await ConfigApi.GetConfigurationAsync<OutputConfigurationDto>("output");
    }
    catch (Exception ex)
    {
      Snackbar.Add($"Failed to load configuration: {ex.Message}", Severity.Error);
    }
  }

  private async Task LoadLogsAsync()
  {
    _logsLoading = true;
    try
    {
      var response = await SystemApi.GetSystemLogsAsync(_logLevel, _logLimit);
      if (response != null)
      {
        _logs = response.Logs;
        _totalLogCount = response.TotalCount;
      }
      else
      {
        _logs = new List<LogEntryDto>();
        _totalLogCount = 0;
      }
    }
    catch (Exception)
    {
      Snackbar.Add("Failed to load logs", Severity.Error);
      _logs = new List<LogEntryDto>();
    }
    finally
    {
      _logsLoading = false;
    }
  }

  private async Task LoadEventSourcesAsync()
  {
    _eventSourcesLoading = true;
    try
    {
      _eventSources = await SourcesApi.GetEventSourcesAsync();
    }
    catch (Exception)
    {
      Snackbar.Add("Failed to load event sources", Severity.Error);
    }
    finally
    {
      _eventSourcesLoading = false;
    }
  }

  private async Task LoadTTSEnginesAsync()
  {
    try
    {
      _ttsEngines = await SourcesApi.GetTTSEnginesAsync();
      if (_ttsEngines != null && _ttsEngines.Any(e => e.IsAvailable))
      {
        _selectedTTSEngine = _ttsEngines.First(e => e.IsAvailable).Engine;
        
        // Load voices if Google is selected
        if (_selectedTTSEngine == "Google")
        {
          await LoadGoogleVoicesAsync();
        }
      }
    }
    catch (Exception)
    {
      // Silently fail - TTS section will show as unavailable
    }
  }

  private async Task OnTTSEngineChangedAsync(string engine)
  {
    _selectedTTSEngine = engine;
    
    // Load Google voices when Google engine is selected
    if (engine == "Google")
    {
      await LoadGoogleVoicesAsync();
    }
    else
    {
      _googleVoices = null;
    }
    
    StateHasChanged();
  }

  private async Task LoadGoogleVoicesAsync()
  {
    try
    {
      _googleVoices = await SourcesApi.GetTTSVoicesAsync("Google");
      
      // Set default voice if available
      if (_googleVoices != null && _googleVoices.Count > 0)
      {
        _ttsVoice = _googleVoices[0].Id;
      }
    }
    catch (Exception)
    {
      // Silently fail - voice dropdown will not be shown
    }
  }

  private async Task LoadNotificationSoundsAsync()
  {
    try
    {
      _notificationSounds = await SourcesApi.GetNotificationSoundsAsync();
      if (_notificationSounds != null && _notificationSounds.Count > 0)
      {
        _selectedSoundFile = _notificationSounds[0].FilePath;
      }
    }
    catch (Exception)
    {
      // Silently fail - audio file section will show as unavailable
    }
  }

  private async Task PlayTTSAsync()
  {
    try
    {
      if (string.IsNullOrWhiteSpace(_ttsText))
      {
        Snackbar.Add("Please enter text to speak", Severity.Warning);
        return;
      }

      var success = await SourcesApi.PlayTTSEventAsync(
        _ttsText,
        _selectedTTSEngine,
        _ttsVoice,
        (float)_ttsSpeed,
        (float)_ttsPitch);

      if (success)
      {
        Snackbar.Add("TTS event started successfully", Severity.Success);
        // Refresh event sources list to show the new event
        await LoadEventSourcesAsync();
      }
      else
      {
        Snackbar.Add("Failed to start TTS event", Severity.Error);
      }
    }
    catch (Exception ex)
    {
      Snackbar.Add($"Error playing TTS: {ex.Message}", Severity.Error);
    }
  }

  private async Task OpenFileSelectionDialogAsync()
  {
    var parameters = new DialogParameters
    {
      { "InitialSelection", _selectedSoundFile },
      { "Subdirectory", null }
    };

    var options = new DialogOptions 
    { 
      MaxWidth = MaxWidth.Medium, 
      FullWidth = true,
      CloseButton = true,
      CloseOnEscapeKey = true
    };

    var dialog = await DialogService.ShowAsync<Radio.Web.Components.Dialogs.AudioFileSelectionDialog>("Select Audio File", parameters, options);
    var result = await dialog.Result;

    if (result != null && !result.Canceled && result.Data is string selectedPath)
    {
      _selectedSoundFile = selectedPath;
      
      // Load notification sounds if not already loaded to get file info
      if (_notificationSounds == null)
      {
        await LoadNotificationSoundsAsync();
      }
    }
  }

  private async Task PlayFileEventAsync()
  {
    try
    {
      if (string.IsNullOrWhiteSpace(_selectedSoundFile))
      {
        Snackbar.Add("Please select a sound file", Severity.Warning);
        return;
      }

      var success = await SourcesApi.PlayFileEventAsync(_selectedSoundFile);

      if (success)
      {
        Snackbar.Add("Audio file event started successfully", Severity.Success);
        // Refresh event sources list to show the new event
        await LoadEventSourcesAsync();
      }
      else
      {
        Snackbar.Add("Failed to start audio file event", Severity.Error);
      }
    }
    catch (Exception ex)
    {
      Snackbar.Add($"Error playing file: {ex.Message}", Severity.Error);
    }
  }

  private string FormatFileSize(long bytes)
  {
    string[] sizes = { "B", "KB", "MB", "GB" };
    double len = bytes;
    int order = 0;
    while (len >= 1024 && order < sizes.Length - 1)
    {
      order++;
      len = len / 1024;
    }
    return $"{len:0.##} {sizes[order]}";
  }

  private async Task ExportLogsAsync()
  {
    try
    {
      if (_logs == null || _logs.Count == 0)
        return;

      var content = string.Join("\n", _logs.Select(log =>
        $"[{log.Timestamp:yyyy-MM-dd HH:mm:ss}] [{log.Level}] {log.SourceContext}: {log.Message}" +
        (string.IsNullOrEmpty(log.Exception) ? "" : $"\n{log.Exception}")));

      var fileName = $"radio-console-logs-{DateTime.Now:yyyyMMdd-HHmmss}.txt";
      
      // Use JavaScript interop to download the file
      var success = await JSRuntime.InvokeAsync<bool>("fileDownload.downloadTextFile", fileName, content, "text/plain");
      
      if (success)
      {
        Snackbar.Add($"Logs exported to {fileName}", Severity.Success);
      }
      else
      {
        Snackbar.Add("Failed to download log file", Severity.Error);
      }
    }
    catch (Exception ex)
    {
      Snackbar.Add($"Failed to export logs: {ex.Message}", Severity.Error);
    }
  }

  private Color GetLogLevelColor(string level) => level.ToLower() switch
  {
    "error" => Color.Error,
    "warning" => Color.Warning,
    "info" => Color.Info,
    _ => Color.Default
  };

  private string GetShortSourceName(string sourceContext)
  {
    if (string.IsNullOrEmpty(sourceContext))
      return "Unknown";
    
    var parts = sourceContext.Split('.');
    return parts.Length > 0 ? parts[^1] : sourceContext;
  }

  private Color GetStateColor(string state) => state switch
  {
    "Playing" => Color.Success,
    "Paused" => Color.Warning,
    "Stopped" => Color.Default,
    "Error" => Color.Error,
    "Ready" => Color.Info,
    _ => Color.Default
  };

  private async Task ReplayEventAsync(AudioSourceDto source)
  {
    try
    {
      bool success = false;
      
      // Determine event type and replay accordingly
      if (source.Type == "TTS" && source.Metadata != null)
      {
        // Extract TTS parameters from metadata
        var text = source.Metadata.GetValueOrDefault("Text")?.ToString() ?? source.Name;
        var engine = source.Metadata.GetValueOrDefault("Engine")?.ToString();
        var voice = source.Metadata.GetValueOrDefault("Voice")?.ToString();
        
        // Parse speed and pitch if available
        float? speed = null;
        float? pitch = null;
        
        if (source.Metadata.TryGetValue("Speed", out var speedObj) && speedObj != null)
        {
          if (float.TryParse(speedObj.ToString(), out var speedVal))
            speed = speedVal;
        }
        
        if (source.Metadata.TryGetValue("Pitch", out var pitchObj) && pitchObj != null)
        {
          if (float.TryParse(pitchObj.ToString(), out var pitchVal))
            pitch = pitchVal;
        }
        
        success = await SourcesApi.PlayTTSEventAsync(text, engine, voice, speed, pitch);
      }
      else if (source.Type == "AudioFileEvent" && source.Metadata != null)
      {
        // Extract file path from metadata
        var filePath = source.Metadata.GetValueOrDefault("FilePath")?.ToString() 
                    ?? source.Metadata.GetValueOrDefault("Path")?.ToString();
        
        if (!string.IsNullOrWhiteSpace(filePath))
        {
          success = await SourcesApi.PlayFileEventAsync(filePath);
        }
      }
      
      if (success)
      {
        Snackbar.Add("Event replayed successfully", Severity.Success);
        // Event sources list will auto-update via SignalR
      }
      else
      {
        Snackbar.Add("Failed to replay event", Severity.Error);
      }
    }
    catch (Exception ex)
    {
      Snackbar.Add($"Error replaying event: {ex.Message}", Severity.Error);
    }
  }

  public void Dispose()
  {
    _statsTimer?.Dispose();
  }
