  private async Task LoadConfigurationAsync()
  {
    try
    {
      _audioConfig = await ConfigApi.GetConfigurationAsync<AudioConfigurationDto>("audio");
      _visualizerConfig = await ConfigApi.GetConfigurationAsync<VisualizerConfigurationDto>("visualizer");
      _outputConfig = await ConfigApi.GetConfigurationAsync<OutputConfigurationDto>("output");
      
      // Load device options, create default if not found
      var deviceOptions = await ConfigApi.GetConfigurationAsync<DeviceOptionsDto>("devices");
      _deviceOptions = deviceOptions ?? new DeviceOptionsDto();

      // Load display options. The Display section is a composite that carries
      // both PR #1's wall-clock keys (TimeFormat / ShowSeconds) at the root
      // and PR #2's weather keys under a nested "Weather" key. We fetch the
      // section once as a typed envelope and split it into two POCOs so the
      // existing _displayConfig keeps its narrow shape and the new
      // _weatherDisplayConfig binds cleanly to the Weather group.
      //
      // Falls through to defaults when the section has never been saved —
      // matches the historical hardcoded behaviour so an unconfigured kiosk
      // renders identically to the pre-PR build.
      var displayEnvelope = await ConfigApi.GetConfigurationAsync<DisplayConfigEnvelope>("display") ?? new DisplayConfigEnvelope();
      _displayConfig = new DisplayOptions
      {
        TimeFormat = displayEnvelope.TimeFormat ?? "24h",
        ShowSeconds = displayEnvelope.ShowSeconds ?? false,
      };
      _weatherDisplayConfig = displayEnvelope.Weather ?? new Radio.Core.Configuration.WeatherDisplayOptions();

      // Load additional configuration sections
      _bluetoothConfig = await ConfigApi.GetConfigurationAsync<BluetoothConfigDto>("bluetooth") ?? new();
      _radioConfig = await ConfigApi.GetConfigurationAsync<RadioConfigDto>("radio") ?? new();
      _filePlayerConfig = await ConfigApi.GetConfigurationAsync<FilePlayerConfigDto>("fileplayer") ?? new();
      _fingerprintingConfig = await ConfigApi.GetConfigurationAsync<FingerprintingConfigDto>("fingerprinting") ?? new();
      _ttsConfig = await ConfigApi.GetConfigurationAsync<TTSConfigDto>("tts") ?? new();
      _metricsConfig = await ConfigApi.GetConfigurationAsync<MetricsConfigDto>("metrics") ?? new();
      _audioEngineConfig = await ConfigApi.GetConfigurationAsync<AudioEngineConfigDto>("audioengine") ?? new();

      // Populate output config individual fields for binding
      if (_outputConfig != null)
      {
        _localOutputEnabled = _outputConfig.Local?.Enabled ?? false;
        _localPreferredDevice = _outputConfig.Local?.PreferredDeviceId ?? "";
        _localDefaultVolume = _outputConfig.Local?.DefaultVolume ?? 0.8f;
        _httpStreamEnabled = _outputConfig.HttpStream?.Enabled ?? false;
        _httpStreamPort = _outputConfig.HttpStream?.Port ?? 8080;
        _httpStreamSampleRate = _outputConfig.HttpStream?.SampleRate ?? 48000;
        _httpStreamChannels = _outputConfig.HttpStream?.Channels ?? 2;
        _castEnabled = _outputConfig.GoogleCast?.Enabled ?? false;
        _castDiscoveryTimeout = _outputConfig.GoogleCast?.DiscoveryTimeoutSeconds ?? 10;
        _castDefaultVolume = _outputConfig.GoogleCast?.DefaultVolume ?? 0.7f;
        _castMaxBufferAhead = _outputConfig.GoogleCast?.DirectChannelMaxBufferAhead ?? 3.0f;
        _castBufferBeforePlay = _outputConfig.GoogleCast?.DirectChannelBufferBeforePlay ?? 3;
        _castReaderLagSeconds = _outputConfig.GoogleCast?.DirectChannelReaderLagSeconds ?? 1.0f;
      }
    }
    catch (Exception ex)
    {
      NotificationService.Notify(NotificationSeverity.Error, "Error", $"Failed to load configuration: {ex.Message}");
    }
  }

