                </MudButton>
              </MudItem>
            </MudGrid>
          }
          else
          {
            <MudProgressCircular Color="Color.Primary" Size="Size.Small" Indeterminate="true" />
            <MudText Class="ml-2">Loading audio preferences...</MudText>
          }
        </MudTabPanel>

        <!-- Spotify Preferences -->
        <MudTabPanel Text="Spotify">
          @if (_spotifyPreferences != null)
          {
            <MudGrid Spacing="2">
              <MudItem xs="12">
                <MudAlert Severity="Severity.Info" Dense="true">
                  Spotify preferences store the last played track and playback state.
                </MudAlert>
              </MudItem>
              <MudItem xs="12">
                <MudTextField T="string" @bind-Value="_spotifyPreferences.LastSongPlayed" Label="Last Song Played (URI)"
                              Variant="Variant.Outlined" ReadOnly="true"
                              HelperText="Spotify URI of last played track (read-only)" />
              </MudItem>
              <MudItem xs="12" md="4">
                <MudNumericField T="long" @bind-Value="_spotifyPreferences.SongPositionMs" Label="Position (ms)"
                                 Variant="Variant.Outlined" Min="0"
                                 HelperText="Last playback position in milliseconds" />
              </MudItem>
              <MudItem xs="12" md="4">
                <MudCheckBox T="bool" @bind-Value="_spotifyPreferences.Shuffle" Label="Shuffle" Color="Color.Primary" />
              </MudItem>
              <MudItem xs="12" md="4">
                <MudSelect T="string" @bind-Value="_spotifyPreferences.Repeat" Label="Repeat Mode"
                           Variant="Variant.Outlined">
                  <MudSelectItem Value="@("Off")">Off</MudSelectItem>
                  <MudSelectItem Value="@("One")">One</MudSelectItem>
                  <MudSelectItem Value="@("All")">All</MudSelectItem>
                </MudSelect>
              </MudItem>
              <MudItem xs="12">
                <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SaveSpotifyPreferencesAsync"
                           StartIcon="@Icons.Material.Filled.Save" Disabled="@_isSaving">
                  @if (_isSaving) { <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" /> }
                  Save Spotify Preferences
                </MudButton>
              </MudItem>
            </MudGrid>
          }
          else
          {
            <MudProgressCircular Color="Color.Primary" Size="Size.Small" Indeterminate="true" />
            <MudText Class="ml-2">Loading Spotify preferences...</MudText>
          }
        </MudTabPanel>

        <!-- File Player Preferences -->
        <MudTabPanel Text="File Player">
          @if (_filePlayerPreferences != null)
          {
            <MudGrid Spacing="2">
              <MudItem xs="12">
                <MudAlert Severity="Severity.Info" Dense="true">
                  File Player preferences store the last played file and playback state.
                </MudAlert>
              </MudItem>
              <MudItem xs="12">
                <MudTextField T="string" @bind-Value="_filePlayerPreferences.LastSongPlayed" Label="Last Song Played (Path)"
                              Variant="Variant.Outlined"
