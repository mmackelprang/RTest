  // ========== Phase 5: Store Management Methods ==========

  private string FormatBytes(long bytes)
  {
    string[] sizes = { "B", "KB", "MB", "GB" };
    double len = bytes;
    int order = 0;
    while (len >= 1024 && order < sizes.Length - 1)
    {
      order++;
      len = len / 1024;
    }
    return $"{len:0.##} {sizes[order]}";
  }

  private Color GetStatusColor(string status)
  {
    return status switch
    {
      "OnlyInJson" => Color.Primary,
      "OnlyInSqlite" => Color.Secondary,
      "Different" => Color.Warning,
      "Same" => Color.Success,
      _ => Color.Default
    };
  }

  private async Task LoadStoreComparisonAsync()
  {
    _isLoadingComparison = true;
    _selectedDifferences.Clear();
    try
    {
      _comparison = await ConfigApi.CompareStoresAsync();
      if (_comparison == null)
      {
        Snackbar.Add("Failed to load store comparison", Severity.Error);
      }
    }
    catch (Exception ex)
    {
      Logger.LogError(ex, "Error loading store comparison");
      Snackbar.Add($"Error loading comparison: {ex.Message}", Severity.Error);
    }
    finally
    {
      _isLoadingComparison = false;
      StateHasChanged();
    }
  }

  private void ToggleDifferenceSelection(string key, bool selected)
  {
    if (selected)
    {
      _selectedDifferences.Add(key);
    }
    else
    {
      _selectedDifferences.Remove(key);
    }
  }

  private void SelectAllDifferences()
  {
    if (_comparison != null)
    {
      foreach (var diff in _comparison.Differences.Where(d => d.Status != "Same"))
      {
        _selectedDifferences.Add(diff.Key);
      }
    }
  }

  private void ClearSelection()
  {
    _selectedDifferences.Clear();
  }

  private async Task ReconcileSelectedAsync(string source, string target)
  {
    if (!_selectedDifferences.Any())
    {
      Snackbar.Add("No differences selected", Severity.Warning);
      return;
    }

    var sourceName = source.ToUpperInvariant();
    var targetName = target.ToUpperInvariant();

    bool? result = await DialogService.ShowMessageBox(
      "Confirm Reconciliation",
      $"Copy {_selectedDifferences.Count} selected entries from {sourceName} to {targetName}?",
      yesText: "Copy",
      cancelText: "Cancel");

    if (result == true)
    {
      _isSaving = true;
      try
      {
        var request = new ReconcileConfigurationRequestDto
        {
          SourceStore = source,
          TargetStore = target,
          Keys = _selectedDifferences.ToList()
        };

        var success = await ConfigApi.ReconcileStoresAsync(request);
        if (success)
        {
          Snackbar.Add($"Successfully copied {_selectedDifferences.Count} entries", Severity.Success);
          _selectedDifferences.Clear();
          // Reload comparison
          await LoadStoreComparisonAsync();
        }
        else
        {
          Snackbar.Add("Failed to reconcile stores", Severity.Error);
        }
      }
      catch (Exception ex)
      {
        Logger.LogError(ex, "Error reconciling stores");
        Snackbar.Add($"Error reconciling stores: {ex.Message}", Severity.Error);
      }
      finally
      {
        _isSaving = false;
      }
    }
  }

  private async Task ExportConfigurationAsync(string format)
  {
    try
    {
      var bytes = await ConfigApi.ExportConfigurationAsync(format);
      if (bytes != null)
      {
        var fileName = $"radio-config-{DateTime.Now:yyyyMMdd-HHmmss}.{format}";
        await JSRuntime.InvokeVoidAsync("downloadFile", fileName, Convert.ToBase64String(bytes));
        Snackbar.Add($"Configuration exported as {format.ToUpper()}", Severity.Success);
      }
      else
      {
        Snackbar.Add("Failed to export configuration", Severity.Error);
      }
    }
    catch (Exception ex)
    {
      Logger.LogError(ex, "Error exporting configuration");
      Snackbar.Add($"Error exporting: {ex.Message}", Severity.Error);
    }
  }

  private async Task ImportConfigurationAsync(IBrowserFile? file)
  {
    if (file == null) return;

    bool? result = await DialogService.ShowMessageBox(
      "Confirm Import",
      $"Import configuration from {file.Name}? This will overwrite existing values.",
      yesText: "Import",
      cancelText: "Cancel");

    if (result == true)
    {
      try
      {
        using var stream = file.OpenReadStream(maxAllowedSize: 10 * 1024 * 1024); // 10MB max
        var success = await ConfigApi.ImportConfigurationAsync(stream, file.Name);
        
        if (success)
        {
          Snackbar.Add("Configuration imported successfully", Severity.Success);
          // Reload store info
          _storeInfo = await ConfigApi.GetStoreInfoAsync();
          StateHasChanged();
        }
        else
        {
          Snackbar.Add("Failed to import configuration", Severity.Error);
        }
      }
      catch (Exception ex)
      {
        Logger.LogError(ex, "Error importing configuration");
        Snackbar.Add($"Error importing: {ex.Message}", Severity.Error);
      }
    }
  }

  public void Dispose()
  {
    _statsTimer?.Dispose();
    _sourceGainDebounceTimer?.Dispose();
  }
