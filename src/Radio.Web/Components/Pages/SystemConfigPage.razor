@page "/system"
@rendermode InteractiveServer
@using Radio.Web.Models
@inject SystemApiService SystemApi
@inject ConfigurationApiService ConfigApi
@inject SecretsApiService SecretsApi
@inject SourcesApiService SourcesApi
@inject AudioApiService AudioApi
@inject AudioStateHubService HubService
@inject ISnackbar Snackbar
@inject IJSRuntime JSRuntime
@inject IDialogService DialogService
@inject ILogger<SystemConfigPage> Logger
@implements IDisposable

<PageTitle>System Configuration</PageTitle>

<div style="height: 100%; display: flex; overflow: hidden;">
  <MudTabs Elevation="0" Rounded="false" Position="Position.Start" ApplyEffectsToContainer="true" PanelClass="pa-4" @bind-ActivePanelIndex="_activeTab"
           Style="height: 100%; width: 100%;" Class="system-config-tabs">
    
    <!-- Tab 1: System Statistics -->
    <MudTabPanel Text="System Stats" Icon="@Icons.Material.Filled.Insights">
      <MudGrid Spacing="3">
        <!-- CPU Usage -->
        <MudItem xs="6" md="3">
          <MudCard>
            <MudCardContent>
              <MudText Typo="Typo.h6">CPU Usage</MudText>
              <MudProgressCircular Color="Color.Primary" Size="Size.Large" Value="@_cpuUsage" />
              <MudText Typo="Typo.h5" Color="Color.Primary">@_cpuUsage.ToString("F1")%</MudText>
            </MudCardContent>
          </MudCard>
        </MudItem>

        <!-- RAM Usage -->
        <MudItem xs="6" md="3">
          <MudCard>
            <MudCardContent>
              <MudText Typo="Typo.h6">RAM Usage</MudText>
              <MudProgressCircular Color="Color.Secondary" Size="Size.Large" Value="@(_ramUsageMb / 10)" />
              <MudText Typo="Typo.h5" Color="Color.Secondary">@_ramUsageMb.ToString("F0") MB</MudText>
            </MudCardContent>
          </MudCard>
        </MudItem>

        <!-- Disk Usage -->
        <MudItem xs="6" md="3">
          <MudCard>
            <MudCardContent>
              <MudText Typo="Typo.h6">Disk Usage</MudText>
              <MudProgressCircular Color="Color.Info" Size="Size.Large" Value="@_diskUsage" />
              <MudText Typo="Typo.h5" Color="Color.Info">@_diskUsage.ToString("F1")%</MudText>
            </MudCardContent>
          </MudCard>
        </MudItem>

        <!-- Thread Count -->
        <MudItem xs="6" md="3">
          <MudCard>
            <MudCardContent>
              <MudText Typo="Typo.h6">Active Threads</MudText>
              <MudText Typo="Typo.h3" Color="Color.Success">@_threadCount</MudText>
            </MudCardContent>
          </MudCard>
        </MudItem>

        <!-- App Uptime -->
        <MudItem xs="6" md="4">
          <MudCard>
            <MudCardContent>
              <MudText Typo="Typo.h6">App Uptime</MudText>
              <MudText Typo="Typo.body1">@_appUptime</MudText>
            </MudCardContent>
          </MudCard>
        </MudItem>

        <!-- System Uptime -->
        <MudItem xs="6" md="4">
          <MudCard>
            <MudCardContent>
              <MudText Typo="Typo.h6">System Uptime</MudText>
              <MudText Typo="Typo.body1">@_systemUptime</MudText>
            </MudCardContent>
          </MudCard>
        </MudItem>

        <!-- Temperature -->
        <MudItem xs="6" md="4">
          <MudCard>
            <MudCardContent>
              <MudText Typo="Typo.h6">Temperature</MudText>
              <MudText Typo="Typo.body1" Color="@(_temperature == "N/A" ? Color.Default : Color.Warning)">@_temperature</MudText>
            </MudCardContent>
          </MudCard>
        </MudItem>

        <!-- Audio Engine State -->
        <MudItem xs="12" md="6">
          <MudCard>
            <MudCardContent>
              <MudText Typo="Typo.h6">Audio Engine State</MudText>
              <MudText Typo="Typo.body1">@_audioEngineState</MudText>
            </MudCardContent>
          </MudCard>
        </MudItem>

        <!-- Platform Info -->
        <MudItem xs="12" md="6">
          <MudCard>
            <MudCardContent>
              <MudText Typo="Typo.h6">Platform</MudText>
              <MudSimpleTable Dense="true" Hover="true" Style="overflow-x: auto;">
                <tbody>
                  <tr><td><b>OS</b></td><td>@System.Runtime.InteropServices.RuntimeInformation.OSDescription</td></tr>
                  <tr><td><b>Architecture</b></td><td>@System.Runtime.InteropServices.RuntimeInformation.ProcessArchitecture</td></tr>
                  <tr><td><b>Runtime</b></td><td>@System.Runtime.InteropServices.RuntimeInformation.FrameworkDescription</td></tr>
                  <tr><td><b>Runtime ID</b></td><td>@System.Runtime.InteropServices.RuntimeInformation.RuntimeIdentifier</td></tr>
                </tbody>
              </MudSimpleTable>
            </MudCardContent>
          </MudCard>
        </MudItem>
      </MudGrid>
    </MudTabPanel>

    <!-- Tab 2: Configuration Management -->
    <MudTabPanel Text="Configuration" Icon="@Icons.Material.Filled.Tune">
      <MudTabs Elevation="1" Rounded="true" ApplyEffectsToContainer="true" PanelClass="pa-2">
        
        <!-- Audio Configuration -->
        <MudTabPanel Text="Audio">
          @if (_audioConfig != null)
          {
            <MudGrid Spacing="2">
              <MudItem xs="12" md="6">
                <MudSelect T="string" @bind-Value="_audioConfig.DefaultSource" Label="Default Source"
                           Variant="Variant.Outlined" HelperText="Primary audio source on startup">
                  <MudSelectItem Value="@("Radio")">Radio</MudSelectItem>
                  <MudSelectItem Value="@("FilePlayer")">File Player</MudSelectItem>
                  <MudSelectItem Value="@("Vinyl")">Vinyl</MudSelectItem>
                </MudSelect>
              </MudItem>
              <MudItem xs="12" md="6">
                <MudSelect T="string" @bind-Value="_audioConfig.DuckingPolicy" Label="Ducking Policy"
                           Variant="Variant.Outlined" HelperText="How volume is reduced during events">
                  <MudSelectItem Value="@("FadeSmooth")">Fade Smooth</MudSelectItem>
                  <MudSelectItem Value="@("FadeLinear")">Fade Linear</MudSelectItem>
                  <MudSelectItem Value="@("Immediate")">Immediate</MudSelectItem>
                </MudSelect>
              </MudItem>
              <MudItem xs="12" md="4">
                <MudNumericField T="int" @bind-Value="_audioConfig.DuckingPercentage" Label="Ducking Level (%)"
                                 Variant="Variant.Outlined" Min="0" Max="100"
                                 HelperText="Volume reduction during events" />
              </MudItem>
              <MudItem xs="12" md="4">
                <MudNumericField T="int" @bind-Value="_audioConfig.DuckingAttackMs" Label="Ducking Attack (ms)"
                                 Variant="Variant.Outlined" Min="0" Max="5000"
                                 HelperText="Time to reduce volume" />
              </MudItem>
              <MudItem xs="12" md="4">
                <MudNumericField T="int" @bind-Value="_audioConfig.DuckingReleaseMs" Label="Ducking Release (ms)"
                                 Variant="Variant.Outlined" Min="0" Max="5000"
                                 HelperText="Time to restore volume" />
              </MudItem>
              <MudItem xs="12">
                <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SaveAudioConfigAsync"
                           StartIcon="@Icons.Material.Filled.Save" Disabled="@_isSaving">
                  @if (_isSaving) { <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" /> }
                  Save Audio Settings
                </MudButton>
              </MudItem>
            </MudGrid>
          }
          else
          {
            <MudProgressCircular Color="Color.Primary" Size="Size.Small" Indeterminate="true" />
            <MudText Class="ml-2">Loading audio configuration...</MudText>
          }
        </MudTabPanel>

        <!-- Visualizer Configuration -->
        <MudTabPanel Text="Visualizer">
          @if (_visualizerConfig != null)
          {
            <MudGrid Spacing="2">
              <MudItem xs="12" md="4">
                <MudSelect T="int" @bind-Value="_visualizerConfig.FFTSize" Label="FFT Size"
                           Variant="Variant.Outlined" HelperText="Frequency resolution">
                  <MudSelectItem Value="256">256</MudSelectItem>
                  <MudSelectItem Value="512">512</MudSelectItem>
                  <MudSelectItem Value="1024">1024</MudSelectItem>
                  <MudSelectItem Value="2048">2048</MudSelectItem>
                  <MudSelectItem Value="4096">4096</MudSelectItem>
                </MudSelect>
              </MudItem>
              <MudItem xs="12" md="4">
                <MudNumericField T="int" @bind-Value="_visualizerConfig.WaveformSampleCount" Label="Waveform Samples"
                                 Variant="Variant.Outlined" Min="64" Max="4096"
                                 HelperText="Points in waveform display" />
              </MudItem>
              <MudItem xs="12" md="4">
                <MudNumericField T="int" @bind-Value="_visualizerConfig.PeakHoldTimeMs" Label="Peak Hold (ms)"
                                 Variant="Variant.Outlined" Min="0" Max="5000"
                                 HelperText="Peak indicator hold time" />
              </MudItem>
              <MudItem xs="12" md="6">
                <MudNumericField T="float" @bind-Value="_visualizerConfig.SpectrumSmoothing" Label="Spectrum Smoothing"
                                 Variant="Variant.Outlined" Min="0" Max="1" Step="0.05f"
                                 HelperText="0 = no smoothing, 1 = max smoothing" />
              </MudItem>
              <MudItem xs="12" md="6">
                <MudCheckBox T="bool" @bind-Value="_visualizerConfig.ApplyWindowFunction" Label="Apply Window Function"
                             Color="Color.Primary" />
              </MudItem>
              <MudItem xs="12">
                <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SaveVisualizerConfigAsync"
                           StartIcon="@Icons.Material.Filled.Save" Disabled="@_isSaving">
                  @if (_isSaving) { <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" /> }
                  Save Visualizer Settings
                </MudButton>
              </MudItem>
            </MudGrid>
          }
          else
          {
            <MudProgressCircular Color="Color.Primary" Size="Size.Small" Indeterminate="true" />
            <MudText Class="ml-2">Loading visualizer configuration...</MudText>
          }
        </MudTabPanel>

        <!-- Output Configuration -->
        <MudTabPanel Text="Output">
          @if (_outputConfig != null)
          {
            <MudExpansionPanels MultiExpansion="true">
              <!-- Local Output -->
              <MudExpansionPanel Text="Local Output" Icon="@Icons.Material.Filled.Speaker">
                <MudGrid Spacing="2">
                  <MudItem xs="12" md="4">
                    <MudCheckBox T="bool" @bind-Value="_localOutputEnabled" Label="Enabled" Color="Color.Primary" />
                  </MudItem>
                  <MudItem xs="12" md="4">
                    <MudTextField T="string" @bind-Value="_localPreferredDevice" Label="Preferred Device ID"
                                  Variant="Variant.Outlined" HelperText="Leave empty for system default" />
                  </MudItem>
                  <MudItem xs="12" md="4">
                    <MudNumericField T="float" @bind-Value="_localDefaultVolume" Label="Default Volume"
                                     Variant="Variant.Outlined" Min="0" Max="1" Step="0.05f"
                                     HelperText="0.0 - 1.0" />
                  </MudItem>
                </MudGrid>
              </MudExpansionPanel>

              <!-- HTTP Stream -->
              <MudExpansionPanel Text="HTTP Stream" Icon="@Icons.Material.Filled.Stream">
                <MudGrid Spacing="2">
                  <MudItem xs="12" md="3">
                    <MudCheckBox T="bool" @bind-Value="_httpStreamEnabled" Label="Enabled" Color="Color.Primary" />
                  </MudItem>
                  <MudItem xs="12" md="3">
                    <MudNumericField T="int" @bind-Value="_httpStreamPort" Label="Port"
                                     Variant="Variant.Outlined" Min="1024" Max="65535" />
                  </MudItem>
                  <MudItem xs="12" md="3">
                    <MudNumericField T="int" @bind-Value="_httpStreamSampleRate" Label="Sample Rate (Hz)"
                                     Variant="Variant.Outlined" Min="8000" Max="192000" />
                  </MudItem>
                  <MudItem xs="12" md="3">
                    <MudNumericField T="int" @bind-Value="_httpStreamChannels" Label="Channels"
                                     Variant="Variant.Outlined" Min="1" Max="8" />
                  </MudItem>
                </MudGrid>
              </MudExpansionPanel>

              <!-- Google Cast -->
              <MudExpansionPanel Text="Google Cast" Icon="@Icons.Material.Filled.Cast">
                <MudGrid Spacing="2">
                  <MudItem xs="12" md="4">
                    <MudCheckBox T="bool" @bind-Value="_castEnabled" Label="Enabled" Color="Color.Primary" />
                  </MudItem>
                  <MudItem xs="12" md="4">
                    <MudNumericField T="int" @bind-Value="_castDiscoveryTimeout" Label="Discovery Timeout (s)"
                                     Variant="Variant.Outlined" Min="1" Max="60" />
                  </MudItem>
                  <MudItem xs="12" md="4">
                    <MudNumericField T="float" @bind-Value="_castDefaultVolume" Label="Default Volume"
                                     Variant="Variant.Outlined" Min="0" Max="1" Step="0.05f"
                                     HelperText="0.0 - 1.0" />
                  </MudItem>
                </MudGrid>
                <MudText Typo="Typo.subtitle2" Class="mt-3 mb-1">DirectChannel Latency Tuning</MudText>
                <MudGrid Spacing="2">
                  <MudItem xs="12" md="4">
                    <MudNumericField T="float" @bind-Value="_castMaxBufferAhead" Label="Max Buffer Ahead (s)"
                                     Variant="Variant.Outlined" Min="1.0f" Max="5.0f" Step="0.5f"
                                     HelperText="Drift protection cap. Lower = less latency (1.0-5.0)" />
                  </MudItem>
                  <MudItem xs="12" md="4">
                    <MudNumericField T="int" @bind-Value="_castBufferBeforePlay" Label="Buffer Before Play (chunks)"
                                     Variant="Variant.Outlined" Min="1" Max="10"
                                     HelperText="Chunks buffered before playback starts (1-10)" />
                  </MudItem>
                  <MudItem xs="12" md="4">
                    <MudNumericField T="float" @bind-Value="_castReaderLagSeconds" Label="Reader Lag (s)"
                                     Variant="Variant.Outlined" Min="0.1f" Max="2.0f" Step="0.1f"
                                     HelperText="Stream reader lag behind write position (0.1-2.0)" />
                  </MudItem>
                </MudGrid>
              </MudExpansionPanel>
            </MudExpansionPanels>

            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SaveOutputConfigAsync" Class="mt-3"
                       StartIcon="@Icons.Material.Filled.Save" Disabled="@_isSaving">
              @if (_isSaving) { <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" /> }
              Save Output Settings
            </MudButton>
          }
          else
          {
            <MudProgressCircular Color="Color.Primary" Size="Size.Small" Indeterminate="true" />
            <MudText Class="ml-2">Loading output configuration...</MudText>
          }
        </MudTabPanel>

        <!-- Devices Configuration -->
        <MudTabPanel Text="Devices">
          @if (_deviceOptions != null)
          {
            <MudGrid Spacing="2">
              <MudItem xs="12">
                <MudAlert Severity="Severity.Info" Dense="true">
                  Enter a substring of the USB audio device name (case-insensitive). Run <code>aplay -l</code> on Linux to list device names.
                </MudAlert>
              </MudItem>
              <MudItem xs="12" md="6">
                <MudTextField T="string" @bind-Value="_deviceOptions.Radio.USBPort"
                              Label="Radio USB Audio (RF320 only)"
                              Variant="Variant.Outlined"
                              HelperText="Leave empty if using RTL-SDR. Only set for RF320 USB audio capture." />
              </MudItem>
              <MudItem xs="12" md="6">
                <MudTextField T="string" @bind-Value="_deviceOptions.Vinyl.USBPort"
                              Label="Vinyl Audio Device"
                              Variant="Variant.Outlined"
                              HelperText="USB audio device name pattern for turntable (e.g., USB Microphone)" />
              </MudItem>
              <MudItem xs="12" md="6">
                <MudTextField T="string" @bind-Value="_deviceOptions.Cast.DefaultDevice"
                              Label="Default Cast Device"
                              Variant="Variant.Outlined"
                              HelperText="Default Chromecast device name (optional)" />
              </MudItem>

              <MudItem xs="12">
                <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SaveDeviceOptionsAsync"
                           StartIcon="@Icons.Material.Filled.Save" Disabled="@_isSaving">
                  @if (_isSaving) { <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" /> }
                  Save Device Settings
                </MudButton>
              </MudItem>
            </MudGrid>
          }
          else
          {
            <MudProgressCircular Color="Color.Primary" Size="Size.Small" Indeterminate="true" />
            <MudText Class="ml-2">Loading device configuration...</MudText>
          }
        </MudTabPanel>

        <!-- Audio Engine Configuration -->
        <MudTabPanel Text="Audio Engine">
          @if (_audioEngineConfig != null)
          {
            <MudGrid Spacing="2">
              <MudItem xs="12">
                <MudAlert Severity="Severity.Warning" Dense="true">
                  Changes to audio engine settings require an application restart to take effect.
                </MudAlert>
              </MudItem>
              <MudItem xs="12" md="4">
                <MudSelect T="int" @bind-Value="_audioEngineConfig.SampleRate" Label="Sample Rate (Hz)"
                           Variant="Variant.Outlined" HelperText="Audio sample rate">
                  <MudSelectItem Value="22050">22050</MudSelectItem>
                  <MudSelectItem Value="44100">44100</MudSelectItem>
                  <MudSelectItem Value="48000">48000</MudSelectItem>
                  <MudSelectItem Value="96000">96000</MudSelectItem>
                </MudSelect>
              </MudItem>
              <MudItem xs="12" md="4">
                <MudSelect T="int" @bind-Value="_audioEngineConfig.Channels" Label="Channels"
                           Variant="Variant.Outlined" HelperText="Audio channel count">
                  <MudSelectItem Value="1">1 (Mono)</MudSelectItem>
                  <MudSelectItem Value="2">2 (Stereo)</MudSelectItem>
                </MudSelect>
              </MudItem>
              <MudItem xs="12" md="4">
                <MudSelect T="int" @bind-Value="_audioEngineConfig.BufferSize" Label="Buffer Size (samples)"
                           Variant="Variant.Outlined" HelperText="Audio buffer size">
                  <MudSelectItem Value="256">256</MudSelectItem>
                  <MudSelectItem Value="512">512</MudSelectItem>
                  <MudSelectItem Value="1024">1024</MudSelectItem>
                  <MudSelectItem Value="2048">2048</MudSelectItem>
                  <MudSelectItem Value="4096">4096</MudSelectItem>
                </MudSelect>
              </MudItem>
              <MudItem xs="12" md="4">
                <MudNumericField T="int" @bind-Value="_audioEngineConfig.HotPlugIntervalSeconds" Label="Hot Plug Interval (s)"
                                 Variant="Variant.Outlined" Min="1" Max="60"
                                 HelperText="Device detection interval" />
              </MudItem>
              <MudItem xs="12" md="4">
                <MudNumericField T="int" @bind-Value="_audioEngineConfig.OutputBufferSizeSeconds" Label="Output Buffer (s)"
                                 Variant="Variant.Outlined" Min="1" Max="30"
                                 HelperText="Output buffer size in seconds" />
              </MudItem>
              <MudItem xs="12" md="4">
                <MudCheckBox T="bool" @bind-Value="_audioEngineConfig.EnableHotPlugDetection" Label="Enable Hot Plug Detection"
                             Color="Color.Primary" />
              </MudItem>
              <MudItem xs="12">
                <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SaveAudioEngineConfigAsync"
                           StartIcon="@Icons.Material.Filled.Save" Disabled="@_isSaving">
                  @if (_isSaving) { <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" /> }
                  Save Audio Engine Settings
                </MudButton>
              </MudItem>
            </MudGrid>
          }
          else
          {
            <MudProgressCircular Color="Color.Primary" Size="Size.Small" Indeterminate="true" />
            <MudText Class="ml-2">Loading audio engine configuration...</MudText>
          }
        </MudTabPanel>

        <!-- Radio Configuration -->
        <MudTabPanel Text="Radio">
          @if (_radioConfig != null)
          {
            <MudGrid Spacing="2">
              <MudItem xs="12" md="4">
                <MudSelect T="string" @bind-Value="_radioConfig.DefaultDevice" Label="Default Radio Device"
                           Variant="Variant.Outlined" HelperText="Radio hardware backend">
                  <MudSelectItem Value="@("RTLSDRCore")">RTL-SDR</MudSelectItem>
                  <MudSelectItem Value="@("RF320")">Raddy RF320</MudSelectItem>
                </MudSelect>
              </MudItem>
              <MudItem xs="12" md="4">
                <MudNumericField T="double" @bind-Value="_radioConfig.DefaultFMFrequencyMHz" Label="Default FM Frequency (MHz)"
                                 Variant="Variant.Outlined" Min="87.5" Max="108.0" Step="0.1"
                                 HelperText="Startup FM frequency" />
              </MudItem>
              <MudItem xs="12" md="4">
                <MudNumericField T="double" @bind-Value="_radioConfig.DefaultAMFrequencyKHz" Label="Default AM Frequency (kHz)"
                                 Variant="Variant.Outlined" Min="520" Max="1710" Step="10.0"
                                 HelperText="Startup AM frequency" />
              </MudItem>
              <MudItem xs="12" md="3">
                <MudNumericField T="double" @bind-Value="_radioConfig.DefaultFMStepMHz" Label="FM Step (MHz)"
                                 Variant="Variant.Outlined" Min="0.05" Max="1.0" Step="0.05"
                                 HelperText="FM tuning step size" />
              </MudItem>
              <MudItem xs="12" md="3">
                <MudNumericField T="double" @bind-Value="_radioConfig.DefaultAMStepKHz" Label="AM Step (kHz)"
                                 Variant="Variant.Outlined" Min="1" Max="50" Step="1.0"
                                 HelperText="AM tuning step size" />
              </MudItem>
              <MudItem xs="12" md="3">
                <MudNumericField T="double" @bind-Value="_radioConfig.MinFMFrequencyMHz" Label="Min FM (MHz)"
                                 Variant="Variant.Outlined" Min="50" Max="200" Step="0.5" />
              </MudItem>
              <MudItem xs="12" md="3">
                <MudNumericField T="double" @bind-Value="_radioConfig.MaxFMFrequencyMHz" Label="Max FM (MHz)"
                                 Variant="Variant.Outlined" Min="50" Max="200" Step="0.5" />
              </MudItem>
              <MudItem xs="12" md="3">
                <MudNumericField T="double" @bind-Value="_radioConfig.MinAMFrequencyKHz" Label="Min AM (kHz)"
                                 Variant="Variant.Outlined" Min="100" Max="2000" Step="10.0" />
              </MudItem>
              <MudItem xs="12" md="3">
                <MudNumericField T="double" @bind-Value="_radioConfig.MaxAMFrequencyKHz" Label="Max AM (kHz)"
                                 Variant="Variant.Outlined" Min="100" Max="2000" Step="10.0" />
              </MudItem>
              <MudItem xs="12" md="3">
                <MudNumericField T="int" @bind-Value="_radioConfig.ScanStopThreshold" Label="Scan Stop Threshold"
                                 Variant="Variant.Outlined" Min="0" Max="200"
                                 HelperText="Signal strength to stop scan" />
              </MudItem>
              <MudItem xs="12" md="3">
                <MudNumericField T="int" @bind-Value="_radioConfig.ScanStepDelayMs" Label="Scan Step Delay (ms)"
                                 Variant="Variant.Outlined" Min="10" Max="1000"
                                 HelperText="Delay between scan steps" />
              </MudItem>
              <MudItem xs="12" md="4">
                <MudNumericField T="int" @bind-Value="_radioConfig.DefaultDeviceVolume" Label="Default Device Volume"
                                 Variant="Variant.Outlined" Min="0" Max="100"
                                 HelperText="Radio hardware volume (0-100)" />
              </MudItem>
              <MudItem xs="12">
                <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SaveRadioConfigAsync"
                           StartIcon="@Icons.Material.Filled.Save" Disabled="@_isSaving">
                  @if (_isSaving) { <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" /> }
                  Save Radio Settings
                </MudButton>
              </MudItem>
            </MudGrid>
          }
          else
          {
            <MudProgressCircular Color="Color.Primary" Size="Size.Small" Indeterminate="true" />
            <MudText Class="ml-2">Loading radio configuration...</MudText>
          }
        </MudTabPanel>

        <!-- Bluetooth Configuration -->
        <MudTabPanel Text="Bluetooth">
          @if (_bluetoothConfig != null)
          {
            <MudGrid Spacing="2">
              <MudItem xs="12">
                <MudAlert Severity="Severity.Info" Dense="true">
                  Bluetooth A2DP sink allows phones to stream audio to this device. Note: On Windows, the adapter starts but A2DP sink is not natively supported. This feature works on the target Linux/Raspberry Pi platform where BlueZ supports A2DP sink.
                </MudAlert>
              </MudItem>
              <MudItem xs="12" md="6">
                <MudTextField T="string" @bind-Value="_bluetoothConfig.DeviceName" Label="Device Name"
                              Variant="Variant.Outlined"
                              HelperText="Name visible to Bluetooth scanners" />
              </MudItem>
              <MudItem xs="12" md="6">
                <MudSelect T="string" @bind-Value="_bluetoothConfig.AudioQuality" Label="Audio Quality"
                           Variant="Variant.Outlined" HelperText="Bluetooth audio quality">
                  <MudSelectItem Value="@("Standard")">Standard (44.1 kHz)</MudSelectItem>
                  <MudSelectItem Value="@("High")">High (48 kHz)</MudSelectItem>
                </MudSelect>
              </MudItem>
              <MudItem xs="12" md="4">
                <MudCheckBox T="bool" @bind-Value="_bluetoothConfig.Enabled" Label="Enabled" Color="Color.Primary" />
              </MudItem>
              <MudItem xs="12" md="4">
                <MudCheckBox T="bool" @bind-Value="_bluetoothConfig.EnableOnStartup" Label="Enable on Startup" Color="Color.Primary" />
              </MudItem>
              <MudItem xs="12" md="4">
                <MudCheckBox T="bool" @bind-Value="_bluetoothConfig.AutoSwitchOnConnect" Label="Auto-Switch on Connect" Color="Color.Primary" />
              </MudItem>
              <MudItem xs="12" md="6">
                <MudCheckBox T="bool" @bind-Value="_bluetoothConfig.AutoAcceptConnections" Label="Auto-Accept Connections" Color="Color.Primary" />
              </MudItem>
              <MudItem xs="12" md="6">
                <MudCheckBox T="bool" @bind-Value="_bluetoothConfig.RequirePairing" Label="Require Pairing" Color="Color.Primary" />
              </MudItem>
              <MudItem xs="12">
                <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SaveBluetoothConfigAsync"
                           StartIcon="@Icons.Material.Filled.Save" Disabled="@_isSaving">
                  @if (_isSaving) { <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" /> }
                  Save Bluetooth Settings
                </MudButton>
              </MudItem>
            </MudGrid>
          }
          else
          {
            <MudProgressCircular Color="Color.Primary" Size="Size.Small" Indeterminate="true" />
            <MudText Class="ml-2">Loading Bluetooth configuration...</MudText>
          }
        </MudTabPanel>

        <!-- File Player Configuration -->
        <MudTabPanel Text="File Player">
          @if (_filePlayerConfig != null)
          {
            <MudGrid Spacing="2">
              <MudItem xs="12" md="6">
                <MudTextField T="string" @bind-Value="_filePlayerConfig.RootDirectory" Label="Root Directory"
                              Variant="Variant.Outlined"
                              HelperText="Root path for music library" />
              </MudItem>
              <MudItem xs="12" md="6">
                <MudTextField T="string" @bind-Value="_filePlayerConfig.SupportedExtensions" Label="Supported Extensions"
                              Variant="Variant.Outlined"
                              HelperText="Comma-separated file extensions (e.g., .mp3,.flac,.wav)" />
              </MudItem>
              <MudItem xs="12">
                <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SaveFilePlayerConfigAsync"
                           StartIcon="@Icons.Material.Filled.Save" Disabled="@_isSaving">
                  @if (_isSaving) { <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" /> }
                  Save File Player Settings
                </MudButton>
              </MudItem>
            </MudGrid>
          }
          else
          {
            <MudProgressCircular Color="Color.Primary" Size="Size.Small" Indeterminate="true" />
            <MudText Class="ml-2">Loading file player configuration...</MudText>
          }
        </MudTabPanel>

        <!-- TTS Configuration -->
        <MudTabPanel Text="TTS">
          @if (_ttsConfig != null)
          {
            <MudGrid Spacing="2">
              <MudItem xs="12" md="4">
                <MudSelect T="string" @bind-Value="_ttsConfig.DefaultEngine" Label="Default Engine"
                           Variant="Variant.Outlined" HelperText="Text-to-speech engine">
                  <MudSelectItem Value="@("ESpeak")">ESpeak (Offline)</MudSelectItem>
                  <MudSelectItem Value="@("Google")">Google Cloud TTS</MudSelectItem>
                  <MudSelectItem Value="@("Azure")">Azure Cognitive Services</MudSelectItem>
                </MudSelect>
              </MudItem>
              <MudItem xs="12" md="4">
                <MudTextField T="string" @bind-Value="_ttsConfig.DefaultVoice" Label="Default Voice"
                              Variant="Variant.Outlined"
                              HelperText="Voice ID (e.g., 'en' for ESpeak)" />
              </MudItem>
              <MudItem xs="12" md="4">
                <MudTextField T="string" @bind-Value="_ttsConfig.ESpeakPath" Label="ESpeak Path"
                              Variant="Variant.Outlined"
                              HelperText="Path to espeak-ng binary" />
              </MudItem>
              <MudItem xs="12" md="4">
                <MudNumericField T="float" @bind-Value="_ttsConfig.DefaultPitch" Label="Default Pitch"
                                 Variant="Variant.Outlined" Min="0.5f" Max="2.0f" Step="0.1f"
                                 HelperText="1.0 = normal pitch" />
              </MudItem>
              <MudItem xs="12" md="4">
                <MudNumericField T="float" @bind-Value="_ttsConfig.DefaultSpeed" Label="Default Speed"
                                 Variant="Variant.Outlined" Min="0.5f" Max="2.0f" Step="0.1f"
                                 HelperText="1.0 = normal speed" />
              </MudItem>
              <MudItem xs="12" md="4">
                <MudNumericField T="int" @bind-Value="_ttsConfig.GenerationTimeoutSeconds" Label="Generation Timeout (s)"
                                 Variant="Variant.Outlined" Min="5" Max="120"
                                 HelperText="Max time for TTS generation" />
              </MudItem>
              <MudItem xs="12">
                <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SaveTTSConfigAsync"
                           StartIcon="@Icons.Material.Filled.Save" Disabled="@_isSaving">
                  @if (_isSaving) { <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" /> }
                  Save TTS Settings
                </MudButton>
              </MudItem>
            </MudGrid>
          }
          else
          {
            <MudProgressCircular Color="Color.Primary" Size="Size.Small" Indeterminate="true" />
            <MudText Class="ml-2">Loading TTS configuration...</MudText>
          }
        </MudTabPanel>

        <!-- Fingerprinting Configuration -->
        <MudTabPanel Text="Fingerprinting">
          @if (_fingerprintingConfig != null)
          {
            <MudGrid Spacing="2">
              <MudItem xs="12">
                <MudAlert Severity="Severity.Info" Dense="true">
                  AcoustID and MusicBrainz API keys are managed in the Secrets tab.
                </MudAlert>
              </MudItem>
              <MudItem xs="12" md="4">
                <MudCheckBox T="bool" @bind-Value="_fingerprintingConfig.Enabled" Label="Enabled" Color="Color.Primary" />
              </MudItem>
              <MudItem xs="12" md="4">
                <MudNumericField T="int" @bind-Value="_fingerprintingConfig.SampleDurationSeconds" Label="Sample Duration (s)"
                                 Variant="Variant.Outlined" Min="5" Max="60"
                                 HelperText="Audio sample length for fingerprinting" />
              </MudItem>
              <MudItem xs="12" md="4">
                <MudNumericField T="int" @bind-Value="_fingerprintingConfig.IdentificationIntervalSeconds" Label="Identification Interval (s)"
                                 Variant="Variant.Outlined" Min="10" Max="300"
                                 HelperText="Time between identification attempts" />
              </MudItem>
              <MudItem xs="12" md="4">
                <MudNumericField T="double" @bind-Value="_fingerprintingConfig.MinimumConfidenceThreshold" Label="Min Confidence"
                                 Variant="Variant.Outlined" Min="0.0" Max="1.0" Step="0.05"
                                 HelperText="0.0 - 1.0 confidence threshold" />
              </MudItem>
              <MudItem xs="12" md="4">
                <MudNumericField T="int" @bind-Value="_fingerprintingConfig.DuplicateSuppressionMinutes" Label="Duplicate Suppression (min)"
                                 Variant="Variant.Outlined" Min="1" Max="60"
                                 HelperText="Ignore re-identification within this window" />
              </MudItem>
              <MudItem xs="12" md="4">
                <MudTextField T="string" @bind-Value="_fingerprintingConfig.FpcalcPath" Label="fpcalc Path"
                              Variant="Variant.Outlined"
                              HelperText="Path to fpcalc binary (blank = auto-detect)" />
              </MudItem>
              <MudItem xs="12" md="6">
                <MudTextField T="string" @bind-Value="_fingerprintingConfig.DatabasePath" Label="Database Path"
                              Variant="Variant.Outlined"
                              HelperText="Path to fingerprinting database" />
              </MudItem>
              <MudItem xs="12">
                <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SaveFingerprintingConfigAsync"
                           StartIcon="@Icons.Material.Filled.Save" Disabled="@_isSaving">
                  @if (_isSaving) { <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" /> }
                  Save Fingerprinting Settings
                </MudButton>
              </MudItem>
            </MudGrid>
          }
          else
          {
            <MudProgressCircular Color="Color.Primary" Size="Size.Small" Indeterminate="true" />
            <MudText Class="ml-2">Loading fingerprinting configuration...</MudText>
          }
        </MudTabPanel>

        <!-- Metrics Configuration -->
        <MudTabPanel Text="Metrics">
          @if (_metricsConfig != null)
          {
            <MudGrid Spacing="2">
              <MudItem xs="12" md="4">
                <MudCheckBox T="bool" @bind-Value="_metricsConfig.Enabled" Label="Enabled" Color="Color.Primary" />
              </MudItem>
              <MudItem xs="12" md="4">
                <MudNumericField T="int" @bind-Value="_metricsConfig.FlushIntervalSeconds" Label="Flush Interval (s)"
                                 Variant="Variant.Outlined" Min="10" Max="600"
                                 HelperText="How often metrics are flushed to DB" />
              </MudItem>
              <MudItem xs="12" md="4">
                <MudTextField T="string" @bind-Value="_metricsConfig.DatabasePath" Label="Database Path"
                              Variant="Variant.Outlined"
                              HelperText="Path to metrics database" />
              </MudItem>
              <MudItem xs="12" md="3">
                <MudNumericField T="int" @bind-Value="_metricsConfig.RetentionMinuteData" Label="Retention: Minutes"
                                 Variant="Variant.Outlined" Min="1" Max="10080"
                                 HelperText="Minute-level data retention (minutes)" />
              </MudItem>
              <MudItem xs="12" md="3">
                <MudNumericField T="int" @bind-Value="_metricsConfig.RetentionHourData" Label="Retention: Hours"
                                 Variant="Variant.Outlined" Min="1" Max="8760"
                                 HelperText="Hour-level data retention (hours)" />
              </MudItem>
              <MudItem xs="12" md="3">
                <MudNumericField T="int" @bind-Value="_metricsConfig.RetentionDayData" Label="Retention: Days"
                                 Variant="Variant.Outlined" Min="1" Max="3650"
                                 HelperText="Day-level data retention (days)" />
              </MudItem>
              <MudItem xs="12" md="3">
                <MudNumericField T="int" @bind-Value="_metricsConfig.RollupIntervalMinutes" Label="Rollup Interval (min)"
                                 Variant="Variant.Outlined" Min="1" Max="1440"
                                 HelperText="How often rollups are computed" />
              </MudItem>
              <MudItem xs="12">
                <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SaveMetricsConfigAsync"
                           StartIcon="@Icons.Material.Filled.Save" Disabled="@_isSaving">
                  @if (_isSaving) { <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" /> }
                  Save Metrics Settings
                </MudButton>
              </MudItem>
            </MudGrid>
          }
          else
          {
            <MudProgressCircular Color="Color.Primary" Size="Size.Small" Indeterminate="true" />
            <MudText Class="ml-2">Loading metrics configuration...</MudText>
          }
        </MudTabPanel>

      </MudTabs>
    </MudTabPanel>

    <!-- Tab 3: Log Viewer -->
    <MudTabPanel Text="Logs" Icon="@Icons.Material.Filled.Article">
      <MudStack Row="true" Spacing="2" Class="mb-3">
        <MudSelect T="string" @bind-Value="_logLevel" Label="Log Level" Variant="Variant.Outlined" Dense="true" Style="min-width: 150px;">
          <MudSelectItem Value="@("info")">Info</MudSelectItem>
          <MudSelectItem Value="@("warning")">Warning</MudSelectItem>
          <MudSelectItem Value="@("error")">Error</MudSelectItem>
        </MudSelect>

        <MudNumericField @bind-Value="_logLimit" Label="Limit" Variant="Variant.Outlined" Min="1" Max="10000" Style="width: 120px;" />

        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="LoadLogsAsync" StartIcon="@Icons.Material.Filled.Refresh">
          Refresh
        </MudButton>

        <MudButton Variant="Variant.Outlined" Color="Color.Secondary" OnClick="ExportLogsAsync" StartIcon="@Icons.Material.Filled.Download" Disabled="@(_logs == null || _logs.Count == 0)">
          Export
        </MudButton>
      </MudStack>

      @if (_logsLoading)
      {
        <MudProgressLinear Color="Color.Primary" Indeterminate="true" />
      }
      else if (_logs != null && _logs.Count > 0)
      {
        <div style="height: 350px; overflow-y: auto;">
          <MudSimpleTable Dense="true" Hover="true" FixedHeader="true">
            <thead>
              <tr>
                <th style="width: 180px;">Timestamp</th>
                <th style="width: 100px;">Level</th>
                <th style="width: 250px;">Source</th>
                <th>Message</th>
              </tr>
            </thead>
            <tbody>
              @foreach (var log in _logs)
              {
                <tr>
                  <td>@log.Timestamp.ToLocalTime().ToString("yyyy-MM-dd HH:mm:ss")</td>
                  <td>
                    <MudChip T="string" Size="Size.Small" Color="@GetLogLevelColor(log.Level)">@log.Level</MudChip>
                  </td>
                  <td>@GetShortSourceName(log.SourceContext)</td>
                  <td>
                    @log.Message
                    @if (!string.IsNullOrEmpty(log.Exception))
                    {
                      <MudText Typo="Typo.caption" Color="Color.Error">@log.Exception</MudText>
                    }
                  </td>
                </tr>
              }
            </tbody>
          </MudSimpleTable>
        </div>
        <MudText Typo="Typo.caption" Class="mt-2">Showing @_logs.Count of @_totalLogCount logs</MudText>
      }
      else
      {
        <MudAlert Severity="Severity.Info">No logs found matching the current filters.</MudAlert>
      }
    </MudTabPanel>

    <!-- Tab 4: Event Sources -->
    <MudTabPanel Text="Event Sources" Icon="@Icons.Material.Filled.EventNote">
      <MudGrid Spacing="3">
        <!-- TTS Section -->
        <MudItem xs="12" md="6">
          <MudCard>
            <MudCardHeader>
              <CardHeaderContent>
                <MudText Typo="Typo.h6">Text-to-Speech</MudText>
              </CardHeaderContent>
            </MudCardHeader>
            <MudCardContent>
              <MudTextField @bind-Value="_ttsText" Label="Message" Variant="Variant.Outlined" Lines="3" />
              
              <MudSelect T="string" Value="_selectedTTSEngine" Label="TTS Engine" Variant="Variant.Outlined" Class="mt-3" ValueChanged="@((string e) => OnTTSEngineChangedAsync(e))">
                @if (_ttsEngines != null)
                {
                  @foreach (var engine in _ttsEngines.Where(e => e.IsAvailable))
                  {
                    <MudSelectItem Value="@engine.Engine">
                      @engine.Name @(engine.IsOffline ? "(Offline)" : "(Online)")
                    </MudSelectItem>
                  }
                }
              </MudSelect>

              @if (_selectedTTSEngine is "Google" or "Azure")
              {
                @if (_cloudVoices != null && _cloudVoices.Count > 0)
                {
                  <MudSelect @bind-Value="_ttsVoice" Label="Voice" Variant="Variant.Outlined" Class="mt-3">
                    @foreach (var voice in _cloudVoices)
                    {
                      <MudSelectItem Value="@voice.Id">
                        @(voice.IsFavorite ? "* " : "")@voice.Name (@voice.PriceTier)
                      </MudSelectItem>
                    }
                  </MudSelect>
                  <MudStack Row="true" Spacing="1" Class="mt-2" AlignItems="AlignItems.Center">
                    <MudButton Variant="Variant.Text" Size="Size.Small" StartIcon="@Icons.Material.Filled.Refresh"
                               OnClick="ScanForVoicesAsync" Disabled="_scanningVoices">
                      @(_scanningVoices ? "Scanning..." : "Scan for Voices")
                    </MudButton>
                    @if (!string.IsNullOrEmpty(_ttsVoice))
                    {
                      var isFav = _cloudVoices.Any(v => v.Id == _ttsVoice && v.IsFavorite);
                      <MudIconButton Icon="@(isFav ? Icons.Material.Filled.Star : Icons.Material.Outlined.StarBorder)"
                                     Color="@(isFav ? Color.Warning : Color.Default)" Size="Size.Small"
                                     OnClick="ToggleVoiceFavoriteAsync" />
                    }
                  </MudStack>
                }
                else
                {
                  <MudTextField @bind-Value="_ttsVoice" Label="Voice (Optional)" Variant="Variant.Outlined" Class="mt-3"
                                HelperText="Click 'Scan for Voices' to discover available voices" />
                  <MudButton Variant="Variant.Text" Size="Size.Small" StartIcon="@Icons.Material.Filled.Search"
                             OnClick="ScanForVoicesAsync" Disabled="_scanningVoices" Class="mt-2">
                    @(_scanningVoices ? "Scanning..." : "Scan for Voices")
                  </MudButton>
                }
              }
              else
              {
                <MudTextField @bind-Value="_ttsVoice" Label="Voice (Optional)" Variant="Variant.Outlined" Class="mt-3"
                              HelperText="e.g., 'en', 'en-US-Standard-A'" />
              }

              <MudStack Row="true" Spacing="2" Class="mt-3">
                <MudNumericField @bind-Value="_ttsSpeed" Label="Speed" Variant="Variant.Outlined" 
                                 Min="0.5" Max="2.0" Step="0.1" Style="width: 150px;" />
                <MudNumericField @bind-Value="_ttsPitch" Label="Pitch" Variant="Variant.Outlined" 
                                 Min="0.5" Max="2.0" Step="0.1" Style="width: 150px;" />
              </MudStack>
            </MudCardContent>
            <MudCardActions>
              <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.RecordVoiceOver" 
                         OnClick="PlayTTSAsync" Disabled="@(string.IsNullOrWhiteSpace(_ttsText) || _ttsEngines == null || !_ttsEngines.Any(e => e.IsAvailable))">
                Speak
              </MudButton>
            </MudCardActions>
          </MudCard>
        </MudItem>

        <!-- Audio File Section -->
        <MudItem xs="12" md="6">
          <MudCard>
            <MudCardHeader>
              <CardHeaderContent>
                <MudText Typo="Typo.h6">Audio File Events</MudText>
              </CardHeaderContent>
            </MudCardHeader>
            <MudCardContent>
              @if (!string.IsNullOrWhiteSpace(_selectedSoundFile))
              {
                var selectedSound = _notificationSounds?.FirstOrDefault(s => s.FilePath == _selectedSoundFile);
                if (selectedSound != null)
                {
                  <div style="display: flex; align-items: center; gap: 12px; padding: 16px; background: var(--mud-palette-background-grey); border-radius: 8px;">
                    <MudIcon Icon="@Icons.Material.Filled.MusicNote" Color="Color.Primary" Size="Size.Large" />
                    <div style="flex: 1;">
                      <MudText Typo="Typo.body1" Style="font-weight: 500;">@selectedSound.FileName</MudText>
                      <MudText Typo="Typo.caption" Color="Color.Secondary">@FormatFileSize(selectedSound.FileSize)</MudText>
                    </div>
                  </div>
                }
              }
              else
              {
                <MudAlert Severity="Severity.Info" Dense="true">
                  Click "Browse Files" to select an audio file
                </MudAlert>
              }
            </MudCardContent>
            <MudCardActions>
              <MudButton Variant="Variant.Outlined" 
                         Color="Color.Primary" 
                         StartIcon="@Icons.Material.Filled.FolderOpen" 
                         OnClick="OpenFileSelectionDialogAsync"
                         Size="Size.Large">
                Browse Files
              </MudButton>
              <MudButton Variant="Variant.Filled" 
                         Color="Color.Primary" 
                         StartIcon="@Icons.Material.Filled.PlayArrow" 
                         OnClick="PlayFileEventAsync" 
                         Disabled="@(string.IsNullOrWhiteSpace(_selectedSoundFile))"
                         Size="Size.Large">
                Play
              </MudButton>
            </MudCardActions>
          </MudCard>
        </MudItem>

        <!-- Active Event Sources -->
        <MudItem xs="12">
          <MudCard>
            <MudCardHeader>
              <CardHeaderContent>
                <MudText Typo="Typo.h6">Active Event Sources</MudText>
              </CardHeaderContent>
              <CardHeaderActions>
                <MudIconButton Icon="@Icons.Material.Filled.Refresh" Color="Color.Primary" OnClick="LoadEventSourcesAsync" />
              </CardHeaderActions>
            </MudCardHeader>
            <MudCardContent>
              @if (_eventSources != null && _eventSources.Count > 0)
              {
                <MudSimpleTable Dense="true" Hover="true">
                  <thead>
                    <tr>
                      <th>Name</th>
                      <th>Type</th>
                      <th>State</th>
                      <th>Volume</th>
                      <th>Metadata</th>
                      <th style="width: 100px;">Actions</th>
                    </tr>
                  </thead>
                  <tbody>
                    @foreach (var source in _eventSources)
                    {
                      <tr>
                        <td><strong>@source.Name</strong></td>
                        <td>@source.Type</td>
                        <td><MudChip T="string" Size="Size.Small" Color="@GetStateColor(source.State)">@source.State</MudChip></td>
                        <td>@source.Volume.ToString("P0")</td>
                        <td>
                          @if (source.Metadata != null && source.Metadata.Count > 0)
                          {
                            <MudText Typo="Typo.caption">@string.Join(", ", source.Metadata.Select(m => $"{m.Key}: {m.Value}"))</MudText>
                          }
                          else
                          {
                            <MudText Typo="Typo.caption" Color="Color.Default">None</MudText>
                          }
                        </td>
                        <td>
                          <MudIconButton Icon="@Icons.Material.Filled.Replay" 
                                         Color="Color.Primary" 
                                         Size="Size.Small"
                                         OnClick="@(() => ReplayEventAsync(source))"
                                         title="Replay this event" />
                        </td>
                      </tr>
                    }
                  </tbody>
                </MudSimpleTable>
              }
              else if (_eventSourcesLoading)
              {
                <MudProgressCircular Color="Color.Primary" Indeterminate="true" />
              }
              else
              {
                <MudAlert Severity="Severity.Info">No event sources currently active.</MudAlert>
              }
            </MudCardContent>
          </MudCard>
        </MudItem>
      </MudGrid>
    </MudTabPanel>

    <!-- Tab 5: Preferences -->
    <MudTabPanel Text="Preferences" Icon="@Icons.Material.Filled.Settings">
      <MudTabs Elevation="1" Rounded="true" ApplyEffectsToContainer="true" PanelClass="pa-2">
        
        <!-- Audio Preferences -->
        <MudTabPanel Text="Audio">
          @if (_audioPreferences != null)
          {
            <MudGrid Spacing="2">
              <MudItem xs="12">
                <MudAlert Severity="Severity.Info" Dense="true">
                  Audio preferences control the default audio source and master volume settings.
                </MudAlert>
              </MudItem>
              <MudItem xs="12" md="6">
                <MudSelect T="string" @bind-Value="_audioPreferences.CurrentSource" Label="Current Source"
                           Variant="Variant.Outlined" HelperText="Currently active audio source">
                  <MudSelectItem Value="@("Radio")">Radio</MudSelectItem>
                  <MudSelectItem Value="@("FilePlayer")">File Player</MudSelectItem>
                  <MudSelectItem Value="@("Vinyl")">Vinyl</MudSelectItem>
                  <MudSelectItem Value="@("Bluetooth")">Bluetooth</MudSelectItem>
                </MudSelect>
              </MudItem>
              <MudItem xs="12" md="6">
                <MudNumericField T="int" @bind-Value="_audioPreferences.MasterVolume" Label="Master Volume"
                                 Variant="Variant.Outlined" Min="0" Max="100"
                                 HelperText="Master volume level (0-100)" />
              </MudItem>
              <!-- Source Gain Levels -->
              <MudItem xs="12">
                <MudText Typo="Typo.subtitle1" Class="mt-4 mb-2">Source Levels</MudText>
                <MudAlert Severity="Severity.Info" Dense="true" Class="mb-2">
                  Adjust gain per source to compensate for volume differences. 0dB = unity (no change). Range: -∞ to +6dB.
                </MudAlert>
              </MudItem>
              @foreach (var kvp in _sourceGainLabels)
              {
                <MudItem xs="12" md="6">
                  <div style="display: flex; align-items: center; gap: 8px;">
                    <MudText Style="min-width: 90px; font-size: 14px;">@kvp.Value</MudText>
                    @{ var autoInfo = GetAutoGainInfo(kvp.Key); }
                    @if (autoInfo?.Mode == "manual")
                    {
                      <MudChip T="string" Size="Size.Small" Color="Color.Warning"
                               Style="font-size: 10px; height: 20px; min-width: 0;">MANUAL</MudChip>
                    }
                    else if (autoInfo != null && autoInfo.SampleCount >= 10)
                    {
                      <MudChip T="string" Size="Size.Small" Color="Color.Success"
                               Style="font-size: 10px; height: 20px; min-width: 0;">AUTO</MudChip>
                    }
                    else
                    {
                      <MudChip T="string" Size="Size.Small" Color="Color.Default"
                               Style="font-size: 10px; height: 20px; min-width: 0; opacity: 0.5;">AUTO</MudChip>
                    }
                    <MudSlider T="float" Value="@GetSourceGainValue(kvp.Key)"
                               ValueChanged="@((float v) => OnSourceGainChanged(kvp.Key, v))"
                               Min="0.0f" Max="25.0f" Step="0.1f"
                               Color="Color.Primary" Style="flex: 1;"  />
                    <MudText Style="min-width: 50px; font-family: var(--font-mono); font-size: 12px; text-align: right;">
                      @FormatGainDb(GetSourceGainValue(kvp.Key))
                    </MudText>
                    @if (autoInfo?.Mode == "manual")
                    {
                      <MudIconButton Icon="@Icons.Material.Filled.Refresh" Size="Size.Small"
                                     Color="Color.Warning" title="Reset to Auto"
                                     OnClick="@(() => ResetSourceToAutoAsync(kvp.Key))"
                                     Style="padding: 2px;" />
                    }
                    @if (autoInfo?.LearnedRms != null)
                    {
                      <MudText Style="min-width: 70px; font-family: var(--font-mono); font-size: 10px; color: var(--mud-palette-text-secondary); text-align: right;">
                        @FormatRmsDb(autoInfo.LearnedRms.Value)
                      </MudText>
                    }
                  </div>
                </MudItem>
              }
              <MudItem xs="12">
                <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SaveAudioPreferencesAsync"
                           StartIcon="@Icons.Material.Filled.Save" Disabled="@_isSaving">
                  @if (_isSaving) { <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" /> }
                  Save Audio Preferences
                </MudButton>
              </MudItem>
            </MudGrid>
          }
          else
          {
            <MudProgressCircular Color="Color.Primary" Size="Size.Small" Indeterminate="true" />
            <MudText Class="ml-2">Loading audio preferences...</MudText>
          }
        </MudTabPanel>

        <!-- File Player Preferences -->
        <MudTabPanel Text="File Player">
          @if (_filePlayerPreferences != null)
          {
            <MudGrid Spacing="2">
              <MudItem xs="12">
                <MudAlert Severity="Severity.Info" Dense="true">
                  File Player preferences store the last played file and playback state.
                </MudAlert>
              </MudItem>
              <MudItem xs="12">
                <MudTextField T="string" @bind-Value="_filePlayerPreferences.LastSongPlayed" Label="Last Song Played (Path)"
                              Variant="Variant.Outlined"
                              HelperText="File path of last played track" />
              </MudItem>
              <MudItem xs="12" md="4">
                <MudNumericField T="long" @bind-Value="_filePlayerPreferences.SongPositionMs" Label="Position (ms)"
                                 Variant="Variant.Outlined" Min="0"
                                 HelperText="Last playback position in milliseconds" />
              </MudItem>
              <MudItem xs="12" md="4">
                <MudCheckBox T="bool" @bind-Value="_filePlayerPreferences.Shuffle" Label="Shuffle" Color="Color.Primary" />
              </MudItem>
              <MudItem xs="12" md="4">
                <MudSelect T="string" @bind-Value="_filePlayerPreferences.Repeat" Label="Repeat Mode"
                           Variant="Variant.Outlined">
                  <MudSelectItem Value="@("Off")">Off</MudSelectItem>
                  <MudSelectItem Value="@("One")">One</MudSelectItem>
                  <MudSelectItem Value="@("All")">All</MudSelectItem>
                </MudSelect>
              </MudItem>
              <MudItem xs="12">
                <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SaveFilePlayerPreferencesAsync"
                           StartIcon="@Icons.Material.Filled.Save" Disabled="@_isSaving">
                  @if (_isSaving) { <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" /> }
                  Save File Player Preferences
                </MudButton>
              </MudItem>
            </MudGrid>
          }
          else
          {
            <MudProgressCircular Color="Color.Primary" Size="Size.Small" Indeterminate="true" />
            <MudText Class="ml-2">Loading File Player preferences...</MudText>
          }
        </MudTabPanel>

        <!-- Radio Preferences -->
        <MudTabPanel Text="Radio">
          @if (_radioPreferences != null)
          {
            <MudGrid Spacing="2">
              <MudItem xs="12">
                <MudAlert Severity="Severity.Info" Dense="true">
                  Radio preferences store the last tuned frequency and band.
                </MudAlert>
              </MudItem>
              <MudItem xs="12" md="6">
                <MudNumericField T="float" @bind-Value="_radioPreferences.LastFrequency" Label="Last Frequency (MHz)"
                                 Variant="Variant.Outlined" Min="0"
                                 HelperText="Last tuned frequency" />
              </MudItem>
              <MudItem xs="12" md="6">
                <MudSelect T="string" @bind-Value="_radioPreferences.LastBand" Label="Last Band"
                           Variant="Variant.Outlined">
                  <MudSelectItem Value="@("AM")">AM</MudSelectItem>
                  <MudSelectItem Value="@("FM")">FM</MudSelectItem>
                  <MudSelectItem Value="@("WB")">WB (Weather Band)</MudSelectItem>
                  <MudSelectItem Value="@("VHF")">VHF</MudSelectItem>
                  <MudSelectItem Value="@("SW")">SW (Shortwave)</MudSelectItem>
                </MudSelect>
              </MudItem>
              <MudItem xs="12">
                <MudTextField T="string" @bind-Value="_radioPreferences.LastEQMode" Label="Last EQ Mode"
                              Variant="Variant.Outlined"
                              HelperText="Last equalizer mode (optional)" />
              </MudItem>
              <MudItem xs="12">
                <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SaveRadioPreferencesAsync"
                           StartIcon="@Icons.Material.Filled.Save" Disabled="@_isSaving">
                  @if (_isSaving) { <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" /> }
                  Save Radio Preferences
                </MudButton>
              </MudItem>
            </MudGrid>
          }
          else
          {
            <MudProgressCircular Color="Color.Primary" Size="Size.Small" Indeterminate="true" />
            <MudText Class="ml-2">Loading Radio preferences...</MudText>
          }
        </MudTabPanel>

        <!-- Generic Source Preferences -->
        <MudTabPanel Text="Generic Source">
          @if (_genericSourcePreferences != null)
          {
            <MudGrid Spacing="2">
              <MudItem xs="12">
                <MudAlert Severity="Severity.Info" Dense="true">
                  Generic Source preferences for USB-based audio sources.
                </MudAlert>
              </MudItem>
              <MudItem xs="12">
                <MudTextField T="string" @bind-Value="_genericSourcePreferences.USBPort" Label="Generic USB Audio Device"
                              Variant="Variant.Outlined"
                              HelperText="USB audio device name pattern (e.g., AB13X)" />
              </MudItem>
              <MudItem xs="12">
                <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SaveGenericSourcePreferencesAsync"
                           StartIcon="@Icons.Material.Filled.Save" Disabled="@_isSaving">
                  @if (_isSaving) { <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" /> }
                  Save Generic Source Preferences
                </MudButton>
              </MudItem>
            </MudGrid>
          }
          else
          {
            <MudProgressCircular Color="Color.Primary" Size="Size.Small" Indeterminate="true" />
            <MudText Class="ml-2">Loading Generic Source preferences...</MudText>
          }
        </MudTabPanel>

      </MudTabs>
    </MudTabPanel>

    <!-- Tab 6: Secrets -->
    <MudTabPanel Text="Secrets" Icon="@Icons.Material.Filled.Lock">
      <MudAlert Severity="Severity.Warning" Dense="true" Class="mb-3">
        <strong>Security Notice:</strong> Secrets are sensitive credentials. Values are masked by default and encrypted server-side. Only enter secrets in secure environments.
        Secrets must be explicitly saved using the "Save Secrets" button (not auto-saved).
      </MudAlert>
      
      <MudTabs Elevation="1" Rounded="true" ApplyEffectsToContainer="true" PanelClass="pa-2">
        
        <!-- TTS Secrets -->
        <MudTabPanel Text="TTS Services">
          @if (_ttsSecrets != null)
          {
            <MudGrid Spacing="2">
              <MudItem xs="12">
                <MudAlert Severity="Severity.Info" Dense="true">
                  API keys for cloud-based Text-to-Speech services. Optional - only needed if using Google or Azure TTS.
                </MudAlert>
              </MudItem>
              <MudItem xs="12">
                <MudTextField T="string" @bind-Value="_ttsSecrets.GoogleAPIKey" Label="Google API Key - ${secret:tts_google_api_key}"
                              Variant="Variant.Outlined" 
                              InputType="@(_showGoogleApiKey ? InputType.Text : InputType.Password)"
                              Adornment="Adornment.End"
                              AdornmentIcon="@(_showGoogleApiKey ? Icons.Material.Filled.VisibilityOff : Icons.Material.Filled.Visibility)"
                              OnAdornmentClick="@(() => _showGoogleApiKey = !_showGoogleApiKey)"
                              HelperText="Google Cloud Text-to-Speech API key"
                              Class="@(string.IsNullOrWhiteSpace(_ttsSecrets.GoogleAPIKey) ? "secret-empty" : "secret-filled")" />
              </MudItem>
              <MudItem xs="12">
                <MudTextField T="string" @bind-Value="_ttsSecrets.AzureAPIKey" Label="Azure API Key - ${secret:tts_azure_api_key}"
                              Variant="Variant.Outlined" 
                              InputType="@(_showAzureApiKey ? InputType.Text : InputType.Password)"
                              Adornment="Adornment.End"
                              AdornmentIcon="@(_showAzureApiKey ? Icons.Material.Filled.VisibilityOff : Icons.Material.Filled.Visibility)"
                              OnAdornmentClick="@(() => _showAzureApiKey = !_showAzureApiKey)"
                              HelperText="Azure Cognitive Services Speech API key"
                              Class="@(string.IsNullOrWhiteSpace(_ttsSecrets.AzureAPIKey) ? "secret-empty" : "secret-filled")" />
              </MudItem>
              <MudItem xs="12">
                <MudTextField T="string" @bind-Value="_ttsSecrets.AzureRegion" Label="Azure Region - ${secret:tts_azure_region}"
                              Variant="Variant.Outlined" 
                              HelperText="Azure region (e.g., eastus, westus2)"
                              Class="@(string.IsNullOrWhiteSpace(_ttsSecrets.AzureRegion) ? "secret-empty" : "secret-filled")" />
              </MudItem>
              <MudItem xs="12">
                <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SaveTTSSecretsAsync"
                           StartIcon="@Icons.Material.Filled.Save" Disabled="@_isSaving" Class="mr-2">
                  @if (_isSaving) { <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" /> }
                  Save Secrets
                </MudButton>
                <MudButton Variant="Variant.Outlined" Color="Color.Error" OnClick="ClearTTSSecretsAsync"
                           StartIcon="@Icons.Material.Filled.DeleteForever" Disabled="@_isSaving">
                  Clear All
                </MudButton>
              </MudItem>
            </MudGrid>
          }
          else
          {
            <MudProgressCircular Color="Color.Primary" Size="Size.Small" Indeterminate="true" />
            <MudText Class="ml-2">Loading TTS secrets...</MudText>
          }
        </MudTabPanel>

        <!-- AcoustID Secret -->
        <MudTabPanel Text="AcoustID">
          @if (_acoustIdSecret != null)
          {
            <MudGrid Spacing="2">
              <MudItem xs="12">
                <MudAlert Severity="Severity.Info" Dense="true">
                  AcoustID API key for audio fingerprinting. Get your key from <a href="https://acoustid.org/new-application" target="_blank">AcoustID</a>.
                </MudAlert>
              </MudItem>
              <MudItem xs="12">
                <MudTextField T="string" @bind-Value="_acoustIdSecret.ApiKey" Label="API Key - ${secret:acoustid_api_key}"
                              Variant="Variant.Outlined" 
                              InputType="@(_showAcoustIdApiKey ? InputType.Text : InputType.Password)"
                              Adornment="Adornment.End"
                              AdornmentIcon="@(_showAcoustIdApiKey ? Icons.Material.Filled.VisibilityOff : Icons.Material.Filled.Visibility)"
                              OnAdornmentClick="@(() => _showAcoustIdApiKey = !_showAcoustIdApiKey)"
                              HelperText="AcoustID application API key"
                              Class="@(string.IsNullOrWhiteSpace(_acoustIdSecret.ApiKey) ? "secret-empty" : "secret-filled")" />
              </MudItem>
              <MudItem xs="12">
                <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SaveAcoustIdSecretAsync"
                           StartIcon="@Icons.Material.Filled.Save" Disabled="@_isSaving" Class="mr-2">
                  @if (_isSaving) { <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" /> }
                  Save Secret
                </MudButton>
                <MudButton Variant="Variant.Outlined" Color="Color.Error" OnClick="ClearAcoustIdSecretAsync"
                           StartIcon="@Icons.Material.Filled.DeleteForever" Disabled="@_isSaving">
                  Clear
                </MudButton>
              </MudItem>
            </MudGrid>
          }
          else
          {
            <MudProgressCircular Color="Color.Primary" Size="Size.Small" Indeterminate="true" />
            <MudText Class="ml-2">Loading AcoustID secret...</MudText>
          }
        </MudTabPanel>

      </MudTabs>
    </MudTabPanel>

    <!-- Tab 7: Store Management -->
    <MudTabPanel Text="Store Management" Icon="@Icons.Material.Filled.Storage">
      <MudStack Spacing="3">
        
        <!-- Store Info Section -->
        <MudPaper Elevation="2" Class="pa-4">
          <MudText Typo="Typo.h6" Class="mb-3">Current Store Information</MudText>
          @if (_storeInfo != null)
          {
            <MudGrid>
              <MudItem xs="12" md="6">
                <MudText><strong>Store Type:</strong> @_storeInfo.StoreType</MudText>
              </MudItem>
              <MudItem xs="12" md="6">
                <MudText><strong>Entry Count:</strong> @_storeInfo.EntryCount</MudText>
              </MudItem>
              <MudItem xs="12" md="6">
                <MudText><strong>Size:</strong> @FormatBytes(_storeInfo.SizeBytes)</MudText>
              </MudItem>
              <MudItem xs="12" md="6">
                <MudText><strong>Last Modified:</strong> @(_storeInfo.LastModified?.ToString("g") ?? "N/A")</MudText>
              </MudItem>
              <MudItem xs="12">
                <MudText Typo="Typo.caption">@_storeInfo.Location</MudText>
              </MudItem>
            </MudGrid>
          }
          else
          {
            <MudStack Row="true" AlignItems="AlignItems.Center">
              <MudProgressCircular Size="Size.Small" Indeterminate="true" />
              <MudText Class="ml-2">Loading store information...</MudText>
            </MudStack>
          }
        </MudPaper>

        <!-- Import/Export Section -->
        <MudPaper Elevation="2" Class="pa-4">
          <MudText Typo="Typo.h6" Class="mb-3">Import / Export</MudText>
          <MudStack Row="true" Spacing="2">
            <MudButton Variant="Variant.Filled" Color="Color.Primary" 
                       OnClick="@(() => ExportConfigurationAsync("json"))"
                       StartIcon="@Icons.Material.Filled.Download">
              Export JSON
            </MudButton>
            <MudButton Variant="Variant.Filled" Color="Color.Secondary" 
                       OnClick="@(() => ExportConfigurationAsync("radiobak"))"
                       StartIcon="@Icons.Material.Filled.Download">
              Export Backup
            </MudButton>
            <MudFileUpload T="IBrowserFile" Accept=".json,.radiobak" FilesChanged="ImportConfigurationAsync">
              <ActivatorContent>
                <MudButton Variant="Variant.Filled" Color="Color.Info"
                           StartIcon="@Icons.Material.Filled.Upload"
                           HtmlTag="label">
                  Import
                </MudButton>
              </ActivatorContent>
            </MudFileUpload>
          </MudStack>
        </MudPaper>

        <!-- Store Comparison Section -->
        <MudPaper Elevation="2" Class="pa-4">
          <MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-3">
            <MudText Typo="Typo.h6">Store Comparison</MudText>
            <MudSpacer />
            <MudButton Variant="Variant.Outlined" Color="Color.Primary" 
                       OnClick="LoadStoreComparisonAsync"
                       StartIcon="@Icons.Material.Filled.Refresh"
                       Disabled="@_isLoadingComparison">
              @if (_isLoadingComparison) { <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" /> }
              Refresh
            </MudButton>
          </MudStack>

          @if (_comparison != null)
          {
            <MudAlert Severity="Severity.Info" Dense="true" Class="mb-3">
              JSON: @_comparison.JsonEntryCount entries | SQLite: @_comparison.SqliteEntryCount entries | 
              Differences: @_comparison.Differences.Count(d => d.Status != "Same")
            </MudAlert>

            @if (_comparison.Differences.Any(d => d.Status != "Same"))
            {
              <MudStack Row="true" Spacing="2" Class="mb-2">
                <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small"
                           OnClick="@(() => ReconcileSelectedAsync("json", "sqlite"))"
                           Disabled="@(!_selectedDifferences.Any() || _isSaving)">
                  Copy JSON → SQLite (@_selectedDifferences.Count)
                </MudButton>
                <MudButton Variant="Variant.Filled" Color="Color.Secondary" Size="Size.Small"
                           OnClick="@(() => ReconcileSelectedAsync("sqlite", "json"))"
                           Disabled="@(!_selectedDifferences.Any() || _isSaving)">
                  Copy SQLite → JSON (@_selectedDifferences.Count)
                </MudButton>
                <MudButton Variant="Variant.Outlined" Size="Size.Small"
                           OnClick="SelectAllDifferences">
                  Select All Differences
                </MudButton>
                <MudButton Variant="Variant.Outlined" Size="Size.Small"
                           OnClick="ClearSelection">
                  Clear Selection
                </MudButton>
              </MudStack>

              <MudTable Items="@_comparison.Differences" Dense="true" Hover="true" 
                        FixedHeader="true" Height="400px">
                <HeaderContent>
                  <MudTh Style="width:50px"></MudTh>
                  <MudTh>Key</MudTh>
                  <MudTh>JSON Value</MudTh>
                  <MudTh>SQLite Value</MudTh>
                  <MudTh>Status</MudTh>
                </HeaderContent>
                <RowTemplate>
                  <MudTd>
                    @if (context.Status != "Same")
                    {
                      <MudCheckBox T="bool" 
                                   Value="@_selectedDifferences.Contains(context.Key)"
                                   ValueChanged="@((bool val) => ToggleDifferenceSelection(context.Key, val))"
                                   Color="Color.Primary" />
                    }
                  </MudTd>
                  <MudTd>
                    <MudText Typo="Typo.caption">@context.Key</MudText>
                  </MudTd>
                  <MudTd>
                    <MudText Typo="Typo.caption">@(context.JsonValue ?? "-")</MudText>
                  </MudTd>
                  <MudTd>
                    <MudText Typo="Typo.caption">@(context.SqliteValue ?? "-")</MudText>
                  </MudTd>
                  <MudTd>
                    <MudChip T="string" Size="Size.Small" Color="@GetStatusColor(context.Status)">
                      @context.Status
                    </MudChip>
                  </MudTd>
                </RowTemplate>
              </MudTable>
            }
            else
            {
              <MudAlert Severity="Severity.Success">
                All configuration entries are in sync between JSON and SQLite stores.
              </MudAlert>
            }
          }
          else if (_isLoadingComparison)
          {
            <MudProgressCircular Size="Size.Small" Indeterminate="true" />
            <MudText Class="ml-2">Loading comparison...</MudText>
          }
          else
          {
            <MudText Color="Color.Default">Click Refresh to compare stores</MudText>
          }
        </MudPaper>

      </MudStack>
    </MudTabPanel>

  </MudTabs>
</div>

@code {
  private int _activeTab = 0;
  private System.Threading.Timer? _statsTimer;

  // System Stats
  private double _cpuUsage = 0;
  private double _ramUsageMb = 0;
  private double _diskUsage = 0;
  private int _threadCount = 0;
  private string _appUptime = "N/A";
  private string _systemUptime = "N/A";
  private string _temperature = "N/A";
  private string _audioEngineState = "Unknown";

  // Configuration
  private AudioConfigurationDto? _audioConfig;
  private VisualizerConfigurationDto? _visualizerConfig;
  private OutputConfigurationDto? _outputConfig;
  private DeviceOptionsDto? _deviceOptions;
  private BluetoothConfigDto? _bluetoothConfig;
  private RadioConfigDto? _radioConfig;
  private FilePlayerConfigDto? _filePlayerConfig;
  private FingerprintingConfigDto? _fingerprintingConfig;
  private TTSConfigDto? _ttsConfig;
  private MetricsConfigDto? _metricsConfig;
  private AudioEngineConfigDto? _audioEngineConfig;
  private bool _isSaving = false;

  // Preferences
  private AudioPreferencesDto? _audioPreferences;
  private FilePlayerPreferencesDto? _filePlayerPreferences;
  private RadioPreferencesDto? _radioPreferences;
  private GenericSourcePreferencesDto? _genericSourcePreferences;

  // Source Gain Offsets
  private Dictionary<string, float> _sourceGainOffsets = new();
  private Dictionary<string, AutoGainInfoDto> _autoGainStatus = new();
  private System.Threading.Timer? _sourceGainDebounceTimer;
  private static readonly Dictionary<string, string> _sourceGainLabels = new()
  {
    ["Radio"] = "Radio",
    ["FilePlayer"] = "File Player",
    ["Bluetooth"] = "Bluetooth",
    ["Vinyl"] = "Vinyl",
    ["GenericUSB"] = "USB Audio",
  };

  // Secrets
  private TTSSecretsDto? _ttsSecrets;
  private AcoustIdSecretDto? _acoustIdSecret;
  
  // Secrets visibility toggles
  private bool _showGoogleApiKey = false;
  private bool _showAzureApiKey = false;
  private bool _showAcoustIdApiKey = false;

  // Store Management (Phase 5)
  private ConfigurationStoreInfoDto? _storeInfo;
  private ConfigurationComparisonDto? _comparison;
  private HashSet<string> _selectedDifferences = new();
  private bool _isLoadingComparison = false;

  // Output configuration individual fields (for binding)
  private bool _localOutputEnabled;
  private string _localPreferredDevice = "";
  private float _localDefaultVolume;
  private bool _httpStreamEnabled;
  private int _httpStreamPort;
  private int _httpStreamSampleRate;
  private int _httpStreamChannels;
  private bool _castEnabled;
  private int _castDiscoveryTimeout;
  private float _castDefaultVolume;
  private float _castMaxBufferAhead;
  private int _castBufferBeforePlay;
  private float _castReaderLagSeconds;

  // Logs
  private string _logLevel = "warning";
  private int _logLimit = 100;
  private List<LogEntryDto> _logs = new();
  private int _totalLogCount = 0;
  private bool _logsLoading = false;

  // Event Sources
  private List<AudioSourceDto>? _eventSources;
  private bool _eventSourcesLoading = false;

  // TTS
  private List<TTSEngineInfoDto>? _ttsEngines;
  private List<TTSVoiceInfoDto>? _cloudVoices;
  private bool _scanningVoices;
  private string _ttsText = string.Empty;
  private string _selectedTTSEngine = "ESpeak";
  private string _ttsVoice = "en";
  private double _ttsSpeed = 1.0;
  private double _ttsPitch = 1.0;

  // Audio Files
  private List<NotificationSoundDto>? _notificationSounds;
  private string _selectedSoundFile = string.Empty;

  protected override async Task OnInitializedAsync()
  {
    // Load initial data
    await LoadSystemStatsAsync();
    await LoadConfigurationAsync();
    await LoadPreferencesAsync();
    await LoadSecretsAsync();
    await LoadLogsAsync();
    await LoadEventSourcesAsync();
    await LoadTTSEnginesAsync();
    await LoadNotificationSoundsAsync();
    
    // Load store info (Phase 5)
    try
    {
      _storeInfo = await ConfigApi.GetStoreInfoAsync();
      if (_storeInfo == null)
      {
        Logger.LogWarning("GetStoreInfoAsync returned null");
      }
    }
    catch (Exception ex)
    {
      Logger.LogError(ex, "Failed to load store info");
    }

    // Setup SignalR for real-time event source updates
    await InitializeSignalRAsync();

    // Update system stats every 5 seconds
    _statsTimer = new System.Threading.Timer(_ =>
    {
      InvokeAsync(async () =>
      {
        await LoadSystemStatsAsync();
        StateHasChanged();
      });
    }, null, TimeSpan.FromSeconds(5), TimeSpan.FromSeconds(5));
  }

  private async Task InitializeSignalRAsync()
  {
    try
    {
      // Subscribe to source changes to catch event source updates
      HubService.SourceChanged += async () =>
      {
        await InvokeAsync(async () =>
        {
          await LoadEventSourcesAsync();
          StateHasChanged();
        });
      };

      // Start the hub connection if not already connected
      if (!HubService.IsConnected)
      {
        await HubService.StartAsync();
      }
    }
    catch (Exception ex)
    {
      Logger.LogWarning(ex, "Failed to initialize SignalR for event source updates, falling back to manual refresh");
      // Silently fail - fallback to manual refresh
    }
  }

  private async Task LoadSystemStatsAsync()
  {
    try
    {
      var stats = await SystemApi.GetSystemStatsAsync();
      if (stats != null)
      {
        _cpuUsage = stats.CpuUsagePercent;
        _ramUsageMb = stats.RamUsageMb;
        _diskUsage = stats.DiskUsagePercent;
        _threadCount = stats.ThreadCount;
        _appUptime = stats.AppUptime;
        _systemUptime = stats.SystemUptime;
        _temperature = stats.SystemTemperature;
        _audioEngineState = stats.AudioEngineState;
      }
    }
    catch (Exception)
    {
      // Silently fail - stats will show default values
    }
  }

  private async Task LoadConfigurationAsync()
  {
    try
    {
      _audioConfig = await ConfigApi.GetConfigurationAsync<AudioConfigurationDto>("audio");
