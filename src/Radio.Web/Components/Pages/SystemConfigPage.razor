  private async Task<T> LoadOrCreatePreferenceAsync<T>(string section) where T : class, new()
  {
    try
    {
      var preference = await ConfigApi.GetConfigurationAsync<T>(section);
      if (preference == null)
      {
        preference = new T();
        Logger.LogInformation("Preference {Section} not found, creating with default values: {@DefaultValue}", section, preference);
        await ConfigApi.UpdateConfigurationAsync(section, preference);
      }
      return preference;
    }
    catch (Exception ex)
    {
      Logger.LogWarning(ex, "Failed to load or create preference {Section}, using default", section);
      return new T();
    }
  }

