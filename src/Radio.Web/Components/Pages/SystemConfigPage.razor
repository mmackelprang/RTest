      _autoGainStatus = await AudioApi.GetAutoGainStatusAsync() ?? new();
      Snackbar.Add($"{_sourceGainLabels.GetValueOrDefault(sourceType, sourceType)} reset to auto gain", Severity.Success);
      StateHasChanged();
    }
    else
    {
      Snackbar.Add("Failed to reset to auto gain", Severity.Error);
    }
  }

  private static string FormatGainDb(float gain)
  {
    if (gain <= 0.001f) return "-∞ dB";
    var db = 20.0 * Math.Log10(gain);
    return db >= 0 ? $"+{db:F1}dB" : $"{db:F1}dB";
  }

  private static string FormatRmsDb(float rms)
  {
    if (rms <= 0.0001f) return "-∞ dB";
    var db = 20.0 * Math.Log10(rms);
    return $"{db:F1} dB";
  }

