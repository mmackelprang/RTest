              <MudItem xs="12" md="4">
                <MudCheckBox T="bool" @bind-Value="_filePlayerPreferences.Shuffle" Label="Shuffle" Color="Color.Primary" />
              </MudItem>
              <MudItem xs="12" md="4">
                <MudSelect T="string" @bind-Value="_filePlayerPreferences.Repeat" Label="Repeat Mode"
                           Variant="Variant.Outlined">
                  <MudSelectItem Value="@("Off")">Off</MudSelectItem>
