  // ========== Secrets Management ==========
  //
  // The contract this page implements, matching SecretsController:
  //   * a read returns masks only, so a mask is display material and never input material;
  //   * a save sends only the boxes the user filled in, so an untouched secret is not transmitted;
  //   * a blank box means "unchanged" here and on the server;
  //   * clearing is an explicit action - per field, or for the whole section.

  private async Task LoadSecretsAsync()
  {
    try
    {
      // Masked status only - see the comment on _ttsSecretStatus.
      _ttsSecretStatus = await LoadOrCreateSecretAsync<TTSSecretsDto>("tts");
    }
    catch (Exception ex)
    {
      Logger.LogError(ex, "Error loading secrets");
      // Continue even if secrets fail to load
    }
  }

  private async Task<T> LoadOrCreateSecretAsync<T>(string section) where T : class, new()
  {
    try
    {
      var secret = await SecretsApi.GetSecretsAsync<T>(section);
      return secret ?? new T();
    }
    catch (Exception ex)
    {
      Logger.LogWarning(ex, "Failed to load secret {Section}, using default", section);
      return new T();
    }
  }

  /// <summary>
  /// True when the API reported that a value is stored for this property.
  /// </summary>
  /// <remarks>
  /// The API returns "" for a secret that is not set and a mask for one that is, so a non-blank
  /// value here means "something is stored" - it never means the caller is holding the secret.
  /// </remarks>
  private static bool IsSecretStored(string? maskedValue) => !string.IsNullOrWhiteSpace(maskedValue);

  private static BadgeStyle SecretBadgeStyle(string? maskedValue) =>
    IsSecretStored(maskedValue) ? BadgeStyle.Success : BadgeStyle.Warning;

  private static string SecretBadgeText(string? maskedValue) =>
    IsSecretStored(maskedValue) ? "Stored" : "Not set";

  private static string SecretFieldClass(string? maskedValue) =>
    IsSecretStored(maskedValue) ? "secret-filled" : "secret-empty";

  /// <summary>
  /// Hint text for an empty secret box: what is stored, and what typing into it will do. The mask
  /// appears here as a placeholder rather than as a value, so it stays visible - it is what made
  /// the two TTS slots reading alike noticeable at all - but cannot be submitted. Note what it
  /// cannot tell you: a mask is a fixed point of the masking function, so a secret overwritten with
  /// its own mask reads back exactly like an intact one.
  /// </summary>
  private static string SecretPlaceholder(string? maskedValue, string label)
  {
    if (!IsSecretStored(maskedValue))
    {
      return $"Not set - enter the {label}";
    }

    // The short-value mask ("********") carries nothing worth showing.
    return maskedValue!.Contains("...", StringComparison.Ordinal)
      ? $"Stored ({maskedValue}) - type to replace"
      : "Stored - type to replace";
  }

  private string GoogleApiKeyPlaceholder => SecretPlaceholder(_ttsSecretStatus?.GoogleAPIKey, "Google API key");
  private string AzureApiKeyPlaceholder => SecretPlaceholder(_ttsSecretStatus?.AzureAPIKey, "Azure API key");
  private string AzureRegionPlaceholder => SecretPlaceholder(_ttsSecretStatus?.AzureRegion, "Azure region");

  private void ResetSecretInputs()
  {
    _googleApiKeyInput = "";
    _azureApiKeyInput = "";
    _azureRegionInput = "";
    _showGoogleApiKey = false;
    _showAzureApiKey = false;
  }

  /// <summary>
  /// Sends only the boxes the user filled in. A blank box is omitted from the request entirely, so
  /// an untouched secret is never transmitted and cannot be overwritten by this save.
  /// </summary>
  private async Task SaveTTSSecretsAsync()
  {
    var payload = SecretsApiService.OnlyProvided(new Dictionary<string, string?>
    {
      ["GoogleAPIKey"] = _googleApiKeyInput,
      ["AzureAPIKey"] = _azureApiKeyInput,
      ["AzureRegion"] = _azureRegionInput
    });

    if (payload.Count == 0)
    {
      NotificationService.Notify(NotificationSeverity.Info, "Nothing to save",
        "No box was filled in, so nothing was changed. Use Clear to remove a stored secret.");
      return;
    }

    _isSaving = true;
    try
    {
      var result = await SecretsApi.SaveSecretsAsync("tts", payload);
      if (result.Success)
      {
        Logger.LogInformation(
          "TTS secrets: submitted {Submitted} value(s); the API stored {Stored} and left {Unchanged} unchanged",
          payload.Count, result.StoredCount, result.UnchangedCount);

        // Report the API's counts, not the request's. They differ when a submitted value turns out
        // to be the mask of the secret already stored, and saying "saved" for one of those would be
        // the same false reassurance that hid this bug.
        if (result.StoredCount == 0)
        {
          NotificationService.Notify(NotificationSeverity.Warning, "Nothing was stored",
            "What you entered matched the placeholder for the secret already stored, so it was left as it was.");
        }
        else
        {
          var message = result.UnchangedCount > 0
            ? $"Stored and encrypted {result.StoredCount} secret(s); {result.UnchangedCount} left unchanged."
            : $"Stored and encrypted {result.StoredCount} secret(s). Boxes left blank were not changed.";
          NotificationService.Notify(NotificationSeverity.Success, "Success", message);
        }

        ResetSecretInputs();
        await LoadSecretsAsync();
      }
      else
      {
        NotificationService.Notify(NotificationSeverity.Error, "Error", "Failed to save TTS secrets");
      }
    }
    catch (Exception ex)
    {
      Logger.LogError(ex, "Error saving TTS secrets");
      NotificationService.Notify(NotificationSeverity.Error, "Error", $"Error saving TTS secrets: {ex.Message}");
    }
    finally
    {
      _isSaving = false;
      StateHasChanged();
    }
  }

