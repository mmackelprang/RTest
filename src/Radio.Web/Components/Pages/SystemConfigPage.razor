  private async Task ReconcileSelectedAsync(string source, string target)
  {
    if (!_selectedDifferences.Any())
    {
      NotificationService.Notify(NotificationSeverity.Warning, "Warning", "No differences selected");
      return;
    }

    var sourceName = source.ToUpperInvariant();
    var targetName = target.ToUpperInvariant();

    var result = await DialogService.Confirm(
      $"Copy {_selectedDifferences.Count} selected entries from {sourceName} to {targetName}?",
      "Confirm Reconciliation",
      new Radzen.ConfirmOptions { OkButtonText = "Copy", CancelButtonText = "Cancel" });

    if (result == true)
    {
      _isSaving = true;
      try
      {
        var request = new ReconcileConfigurationRequestDto
        {
          SourceStore = source,
          TargetStore = target,
          Keys = _selectedDifferences.ToList()
        };

        var success = await ConfigApi.ReconcileStoresAsync(request);
        if (success)
        {
          NotificationService.Notify(NotificationSeverity.Success, "Success", $"Successfully copied {_selectedDifferences.Count} entries");
          _selectedDifferences.Clear();
          // Reload comparison
          await LoadStoreComparisonAsync();
        }
        else
        {
          NotificationService.Notify(NotificationSeverity.Error, "Error", "Failed to reconcile stores");
        }
      }
      catch (Exception ex)
      {
        Logger.LogError(ex, "Error reconciling stores");
        NotificationService.Notify(NotificationSeverity.Error, "Error", $"Error reconciling stores: {ex.Message}");
      }
      finally
      {
        _isSaving = false;
      }
    }
  }

