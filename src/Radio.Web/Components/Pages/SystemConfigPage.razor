  private async Task<T> LoadOrCreateSecretAsync<T>(string section) where T : class, new()
  {
    try
    {
      var secret = await ConfigApi.GetConfigurationAsync<T>(section);
      if (secret == null)
      {
        // Create empty in-memory object without persisting until user explicitly saves
        secret = new T();
        Logger.LogInformation("Secret section {Section} not found, creating empty in-memory object", section);
      }
      return secret;
    }
    catch (Exception ex)
    {
      Logger.LogWarning(ex, "Failed to load secret {Section}, using default", section);
      return new T();
    }
  }

  /// <summary>
  /// Generic method to save secrets and hide visibility toggles after successful save
  /// </summary>
  private async Task SaveSecretsAsync<T>(string section, T? secrets, string displayName, params Action[] hideVisibilityToggles) where T : class
  {
    _isSaving = true;
    try
    {
      if (secrets == null) return;
      
      var success = await ConfigApi.UpdateConfigurationAsync(section, secrets);
      if (success)
      {
        Logger.LogInformation("{DisplayName} secrets updated successfully", displayName);
        Snackbar.Add($"{displayName} secrets saved and encrypted successfully", Severity.Success);
        // Hide all visibility toggles
        foreach (var hideToggle in hideVisibilityToggles)
        {
          hideToggle?.Invoke();
        }
        StateHasChanged();
      }
      else
      {
        Snackbar.Add($"Failed to save {displayName} secrets", Severity.Error);
      }
    }
    catch (Exception ex)
    {
      Logger.LogError(ex, "Error saving {DisplayName} secrets", displayName);
      Snackbar.Add($"Error saving {displayName} secrets: {ex.Message}", Severity.Error);
    }
    finally
    {
      _isSaving = false;
    }
  }

  /// <summary>
  /// Generic method to clear secrets with confirmation dialog
  /// </summary>
  private async Task ClearSecretsAsync<T>(string section, T? secrets, string displayName, Action clearFields) where T : class
  {
    bool? result = await DialogService.ShowMessageBox(
      "Confirm Clear Secrets",
      $"Are you sure you want to clear all {displayName} secrets? This action cannot be undone.",
      yesText: "Clear", 
      cancelText: "Cancel");

    if (result == true)
    {
      _isSaving = true;
      try
      {
        if (secrets != null)
        {
          clearFields?.Invoke();
          
          var success = await ConfigApi.UpdateConfigurationAsync(section, secrets);
          if (success)
          {
            Logger.LogInformation("{DisplayName} secrets cleared successfully", displayName);
            Snackbar.Add($"{displayName} secrets cleared successfully", Severity.Success);
            StateHasChanged();
          }
          else
          {
            Snackbar.Add($"Failed to clear {displayName} secrets", Severity.Error);
          }
        }
      }
      catch (Exception ex)
      {
        Logger.LogError(ex, "Error clearing {DisplayName} secrets", displayName);
        Snackbar.Add($"Error clearing {displayName} secrets: {ex.Message}", Severity.Error);
      }
      finally
      {
        _isSaving = false;
      }
    }
  }

