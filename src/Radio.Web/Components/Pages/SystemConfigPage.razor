  /// <summary>
  /// Removes one stored secret. Clearing needs its own request because a blank box means
  /// "unchanged", so a single secret cannot be removed by saving the form.
  /// </summary>
  /// <param name="property">The section property name, e.g. "AzureAPIKey".</param>
  /// <param name="displayName">How the field is named to the user in dialogs and notifications.</param>
  /// <param name="resetInput">
  /// Empties that field's own box, and only that one. Text left in it after a clear would be sent
  /// by the next Save, quietly re-setting the secret the user had just asked to remove.
  /// </param>
  private async Task ClearSecretFieldAsync(string property, string displayName, Action resetInput)
  {
    var confirmed = await DialogService.Confirm(
      $"Remove the stored {displayName}? This action cannot be undone.",
      "Confirm Clear",
      new Radzen.ConfirmOptions { OkButtonText = "Clear", CancelButtonText = "Cancel" });

    if (confirmed != true) return;

    _isSaving = true;
    try
    {
      var success = await SecretsApi.ClearSecretAsync("tts", property);
      if (success)
      {
        Logger.LogInformation("TTS secret {Property}: clear requested", property);
        // "no longer set" rather than "cleared": the API returns 200 whether or not there was
        // anything stored to remove, and this does not read the flag that would tell them apart.
        NotificationService.Notify(NotificationSeverity.Success, "Success", $"{displayName} is no longer set");
        resetInput();
        await LoadSecretsAsync();
      }
      else
      {
        NotificationService.Notify(NotificationSeverity.Error, "Error", $"Failed to clear {displayName}");
      }
    }
    catch (Exception ex)
    {
      Logger.LogError(ex, "Error clearing TTS secret {Property}", property);
      NotificationService.Notify(NotificationSeverity.Error, "Error", $"Error clearing {displayName}: {ex.Message}");
    }
    finally
    {
      _isSaving = false;
      StateHasChanged();
    }
  }

