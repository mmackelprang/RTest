  protected override async Task OnInitializedAsync()
  {
    // Load initial data
    await LoadSystemStatsAsync();
    await LoadConfigurationAsync();
    await LoadPreferencesAsync();
    await LoadSecretsAsync();
    await LoadLogsAsync();
    await LoadEventSourcesAsync();
    await LoadTTSEnginesAsync();
    await LoadNotificationSoundsAsync();
    
    // Load store info (Phase 5)
    try
    {
      _storeInfo = await ConfigApi.GetStoreInfoAsync();
      if (_storeInfo == null)
      {
        Logger.LogWarning("GetStoreInfoAsync returned null");
      }
    }
    catch (Exception ex)
    {
      Logger.LogError(ex, "Failed to load store info");
    }

    // Load integration status and config
    await LoadIntegrationDataAsync();

    // Setup SignalR for real-time event source updates
    await InitializeSignalRAsync();

    // Update system stats every 5 seconds
    _statsTimer = new System.Threading.Timer(_ =>
    {
      InvokeAsync(async () =>
      {
        await LoadSystemStatsAsync();
        StateHasChanged();
      });
    }, null, TimeSpan.FromSeconds(5), TimeSpan.FromSeconds(5));
  }

  private async Task InitializeSignalRAsync()
  {
    try
    {
      // Subscribe to source changes to catch event source updates
      HubService.SourceChanged += async () =>
      {
        await InvokeAsync(async () =>
        {
          await LoadEventSourcesAsync();
          StateHasChanged();
        });
      };

      // Subscribe to encoder connection changes
      HubService.EncoderConnectionChanged += async (_) =>
      {
        await InvokeAsync(async () =>
        {
          _encoderStatus = await IntegrationsApi.GetEncoderStatusAsync();
          StateHasChanged();
        });
      };

      // Subscribe to phone call state changes
      HubService.PhoneCallStateChanged += async () =>
      {
        await InvokeAsync(async () =>
        {
          _phoneStatus = await IntegrationsApi.GetPhoneStatusAsync();
          StateHasChanged();
        });
      };

      // Start the hub connection if not already connected
      if (!HubService.IsConnected)
      {
        await HubService.StartAsync();
      }
    }
    catch (Exception ex)
    {
      Logger.LogWarning(ex, "Failed to initialize SignalR for event source updates, falling back to manual refresh");
      // Silently fail - fallback to manual refresh
    }
  }

