  private static BadgeStyle GetPhoneStateBadgeStyle(string state) => state switch
  {
    "Ringing" => BadgeStyle.Warning,
    "InCall" => BadgeStyle.Success,
    "Ended" => BadgeStyle.Info,
    _ => BadgeStyle.Light
  };

