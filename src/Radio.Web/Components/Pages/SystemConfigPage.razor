    if (file == null) return;

    var result = await DialogService.Confirm(
      $"Import configuration from {file.Name}? This will overwrite existing values.",
      "Confirm Import",
      new Radzen.ConfirmOptions { OkButtonText = "Import", CancelButtonText = "Cancel" });

    if (result == true)
    {
      try
      {
        using var stream = file.OpenReadStream(maxAllowedSize: 10 * 1024 * 1024); // 10MB max
        var success = await ConfigApi.ImportConfigurationAsync(stream, file.Name);
        
        if (success)
        {
          NotificationService.Notify(NotificationSeverity.Success, "Success", "Configuration imported successfully");
          // Reload store info
          _storeInfo = await ConfigApi.GetStoreInfoAsync();
          StateHasChanged();
        }
        else
        {
          NotificationService.Notify(NotificationSeverity.Error, "Error", "Failed to import configuration");
        }
      }
      catch (Exception ex)
      {
        Logger.LogError(ex, "Error importing configuration");
        NotificationService.Notify(NotificationSeverity.Error, "Error", $"Error importing: {ex.Message}");
      }
    }
  }

  private async Task RestartServicesAsync()
  {
    var confirmed = await DialogService.Confirm(
      "Restart radio-api and radio-web services? The UI will disconnect briefly.",
      "Restart Services",
      new Radzen.ConfirmOptions { OkButtonText = "Restart", CancelButtonText = "Cancel" });

    if (confirmed == true)
    {
      NotificationService.Notify(NotificationSeverity.Info, "Info", "Restarting services...");
      var ok = await SystemApi.RestartServicesAsync();
      if (!ok)
        NotificationService.Notify(NotificationSeverity.Error, "Error", "Failed to restart services");
    }
  }

  private async Task ShutdownSystemAsync()
  {
    var confirmed = await DialogService.Confirm(
      "Power off the system? You will need physical access to turn it back on.",
      "Shutdown System",
      new Radzen.ConfirmOptions { OkButtonText = "Shutdown", CancelButtonText = "Cancel" });

    if (confirmed == true)
    {
      NotificationService.Notify(NotificationSeverity.Warning, "Warning", "System shutting down...");
      var ok = await SystemApi.PowerOffSystemAsync();
      if (!ok)
        NotificationService.Notify(NotificationSeverity.Error, "Error", "Failed to power off system");
    }
  }

  // Integration methods

  private async Task LoadIntegrationDataAsync()
  {
    try
    {
      _encoderStatus = await IntegrationsApi.GetEncoderStatusAsync();
      _phoneStatus = await IntegrationsApi.GetPhoneStatusAsync();
      _encoderConfig = await ConfigApi.GetConfigurationAsync<RotaryEncoderConfigDto>("rotaryencoder") ?? new();
      _phoneConfig = await ConfigApi.GetConfigurationAsync<PhoneIntegrationConfigDto>("phoneintegration") ?? new();
      _pbapConfig = await ConfigApi.GetConfigurationAsync<PbapConfigDto>("bluetooth:pbap") ?? new();
    }
    catch (Exception ex)
    {
      Logger.LogWarning(ex, "Failed to load integration data");
    }
  }

  private async Task SaveEncoderConfigAsync()
  {
    if (_encoderConfig == null) return;

    _isSaving = true;
    try
    {
      var success = await ConfigApi.UpdateConfigurationAsync("rotaryencoder", _encoderConfig);
      if (success)
      {
        NotificationService.Notify(NotificationSeverity.Success, "Success", "Encoder configuration saved. Restart required for changes to take effect.");
      }
      else
      {
        NotificationService.Notify(NotificationSeverity.Error, "Error", "Failed to save encoder configuration");
      }
    }
    catch (Exception ex)
    {
      NotificationService.Notify(NotificationSeverity.Error, "Error", $"Error saving configuration: {ex.Message}");
    }
    finally
    {
      _isSaving = false;
    }
  }

