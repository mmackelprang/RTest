  private string FormatFileSize(long bytes)
  {
    string[] sizes = { "B", "KB", "MB", "GB" };
    double len = bytes;
    int order = 0;
    while (len >= 1024 && order < sizes.Length - 1)
    {
      order++;
      len = len / 1024;
    }
    return $"{len:0.##} {sizes[order]}";
  }

  private async Task ExportLogsAsync()
  {
    try
    {
      if (_logs == null || _logs.Count == 0)
        return;

      var content = string.Join("\n", _logs.Select(log =>
        $"[{log.Timestamp:yyyy-MM-dd HH:mm:ss}] [{log.Level}] {log.SourceContext}: {log.Message}" +
        (string.IsNullOrEmpty(log.Exception) ? "" : $"\n{log.Exception}")));

      var fileName = $"radio-console-logs-{DateTime.Now:yyyyMMdd-HHmmss}.txt";
      
      // Use JavaScript interop to download the file
      var success = await JSRuntime.InvokeAsync<bool>("fileDownload.downloadTextFile", fileName, content, "text/plain");
      
      if (success)
      {
        Snackbar.Add($"Logs exported to {fileName}", Severity.Success);
      }
      else
      {
        Snackbar.Add("Failed to download log file", Severity.Error);
      }
    }
    catch (Exception ex)
    {
      Snackbar.Add($"Failed to export logs: {ex.Message}", Severity.Error);
    }
  }

  private Color GetLogLevelColor(string level) => level.ToLower() switch
  {
    "error" => Color.Error,
    "warning" => Color.Warning,
