@page "/system"
@rendermode InteractiveServer
@using Radio.Web.Models
@inject SystemApiService SystemApi
@inject ConfigurationApiService ConfigApi
@inject SecretsApiService SecretsApi
@inject SourcesApiService SourcesApi
@inject AudioApiService AudioApi
@inject AudioStateHubService HubService
@inject NotificationService NotificationService
@inject IJSRuntime JSRuntime
@inject DialogService DialogService
@inject IntegrationsApiService IntegrationsApi
@inject ILogger<SystemConfigPage> Logger
@implements IDisposable

<PageTitle>System Configuration</PageTitle>

<div style="height: 100%; display: flex; overflow: hidden;">
  <RadzenTabs TabPosition="TabPosition.Left" SelectedIndex="@_activeTab" Change="@OnTopLevelTabChanged"
              Style="height: 100%; width: 100%;" class="system-config-tabs">
    <Tabs>

    <!-- Tab 1: System Statistics -->
    <RadzenTabsItem Text="System Stats" Icon="insights">
      <!-- Row 1: Gauge cards — compact with small circular progress -->
      <div style="display:grid; grid-template-columns:repeat(4, 1fr); gap:10px; margin-bottom:10px;">
        <RadzenCard Style="padding:10px; text-align:center">
          <span style="font-size:0.75rem; color:var(--text-low)">CPU</span>
          <RadzenProgressBarCircular ProgressBarStyle="ProgressBarStyle.Primary" Size="ProgressBarCircularSize.Medium" Value="@_cpuUsage" ShowValue="true" />
        </RadzenCard>
        <RadzenCard Style="padding:10px; text-align:center">
          <span style="font-size:0.75rem; color:var(--text-low)">RAM</span>
          <RadzenProgressBarCircular ProgressBarStyle="ProgressBarStyle.Secondary" Size="ProgressBarCircularSize.Medium" Value="@(_ramUsageMb / 10)" ShowValue="false" />
          <div style="font-size:0.875rem; font-weight:500; color:var(--rz-secondary)">@_ramUsageMb.ToString("F0") MB</div>
        </RadzenCard>
        <RadzenCard Style="padding:10px; text-align:center">
          <span style="font-size:0.75rem; color:var(--text-low)">Disk</span>
          <RadzenProgressBarCircular ProgressBarStyle="ProgressBarStyle.Info" Size="ProgressBarCircularSize.Medium" Value="@_diskUsage" ShowValue="true" />
        </RadzenCard>
        <RadzenCard Style="padding:10px; text-align:center">
          <span style="font-size:0.75rem; color:var(--text-low)">Threads</span>
          <div style="font-size:1.5rem; font-weight:600; color:var(--rz-success); margin:8px 0">@_threadCount</div>
        </RadzenCard>
      </div>

      <!-- Row 2: Text stats — single row of compact cards -->
      <div style="display:grid; grid-template-columns:repeat(4, 1fr); gap:10px; margin-bottom:10px;">
        <RadzenCard Style="padding:10px">
          <span style="font-size:0.75rem; color:var(--text-low)">App Uptime</span>
          <div style="font-size:0.875rem">@_appUptime</div>
        </RadzenCard>
        <RadzenCard Style="padding:10px">
          <span style="font-size:0.75rem; color:var(--text-low)">System Uptime</span>
          <div style="font-size:0.875rem">@_systemUptime</div>
        </RadzenCard>
        <RadzenCard Style="padding:10px">
          <span style="font-size:0.75rem; color:var(--text-low)">Temperature</span>
          <div style="font-size:0.875rem; @(_temperature != "N/A" ? "color:var(--rz-warning)" : "")">@_temperature</div>
        </RadzenCard>
        <RadzenCard Style="padding:10px">
          <span style="font-size:0.75rem; color:var(--text-low)">Audio Engine</span>
          <div style="font-size:0.875rem">@_audioEngineState</div>
        </RadzenCard>
      </div>

      <!-- Row 3: Platform info — compact inline -->
      <RadzenCard Style="padding:10px; margin-bottom:10px;">
        <span style="font-size:0.75rem; color:var(--text-low)">Platform</span>
        <div style="display:flex; gap:16px; flex-wrap:wrap; font-size:0.8rem; margin-top:4px;">
          <span><b>OS:</b> @System.Runtime.InteropServices.RuntimeInformation.OSDescription</span>
          <span><b>Arch:</b> @System.Runtime.InteropServices.RuntimeInformation.ProcessArchitecture</span>
          <span><b>Runtime:</b> @System.Runtime.InteropServices.RuntimeInformation.FrameworkDescription</span>
        </div>
      </RadzenCard>

      <!-- Row 4: System Actions -->
      @if (OperatingSystem.IsLinux())
      {
        <div style="display:flex; gap:10px; align-items:center;">
          <span style="font-size:0.75rem; color:var(--text-low); margin-right:8px">System Actions</span>
          <RadzenButton Variant="Variant.Filled" ButtonStyle="ButtonStyle.Warning"
                        Icon="refresh" Click="RestartServicesAsync" Text="Restart Services" />
          <RadzenButton Variant="Variant.Filled" ButtonStyle="ButtonStyle.Danger"
                        Icon="power_settings_new" Click="ShutdownSystemAsync" Text="Shutdown System" />
        </div>
      }
    </RadzenTabsItem>

    <!-- Tab 2: Configuration Management -->
    <RadzenTabsItem Text="Configuration" Icon="tune">
      <RadzenTabs Style="max-width: 900px;">
        <Tabs>

        <!-- Audio Configuration -->
        <RadzenTabsItem Text="Audio">
          @if (_audioConfig != null)
          {
            <RadzenRow Gap="0.5rem">
              <RadzenColumn Size="12" SizeMD="6">
                <RadzenDropDown TValue="string" @bind-Value="_audioConfig.DefaultSource" Data="@_defaultSourceOptions"
                                TextProperty="Text" ValueProperty="Value" Placeholder="Default Source" Style="width:100%" />
                <small>Primary audio source on startup</small>
              </RadzenColumn>
              <RadzenColumn Size="12" SizeMD="6">
                <RadzenDropDown TValue="string" @bind-Value="_audioConfig.DuckingPolicy" Data="@_duckingPolicyOptions"
                                TextProperty="Text" ValueProperty="Value" Placeholder="Ducking Policy" Style="width:100%" />
                <small>How volume is reduced during events</small>
              </RadzenColumn>
              <RadzenColumn Size="12" SizeMD="4">
                <RadzenNumeric TValue="int" @bind-Value="_audioConfig.DuckingPercentage" Min="0" Max="100" Placeholder="Ducking Level (%)" Style="width:100%" />
                <small>Volume reduction during events</small>
              </RadzenColumn>
              <RadzenColumn Size="12" SizeMD="4">
                <RadzenNumeric TValue="int" @bind-Value="_audioConfig.DuckingAttackMs" Min="0" Max="5000" Placeholder="Ducking Attack (ms)" Style="width:100%" />
                <small>Time to reduce volume</small>
              </RadzenColumn>
              <RadzenColumn Size="12" SizeMD="4">
                <RadzenNumeric TValue="int" @bind-Value="_audioConfig.DuckingReleaseMs" Min="0" Max="5000" Placeholder="Ducking Release (ms)" Style="width:100%" />
                <small>Time to restore volume</small>
              </RadzenColumn>
              <RadzenColumn Size="12">
                <RadzenButton Variant="Variant.Filled" ButtonStyle="ButtonStyle.Primary" Click="SaveAudioConfigAsync"
                              Icon="save" Disabled="@_isSaving" Text="Save Audio Settings" />
              </RadzenColumn>
            </RadzenRow>
          }
          else
          {
            <RadzenProgressBarCircular ProgressBarStyle="ProgressBarStyle.Primary" Size="ProgressBarCircularSize.Small" Mode="ProgressBarMode.Indeterminate" />
            <span style="margin-left:8px">Loading audio configuration...</span>
          }
        </RadzenTabsItem>

        <!-- Visualizer Configuration -->
        <RadzenTabsItem Text="Visualizer">
          @if (_visualizerConfig != null)
          {
            <RadzenRow Gap="0.5rem">
              <RadzenColumn Size="12" SizeMD="4">
                <RadzenDropDown TValue="int" @bind-Value="_visualizerConfig.FFTSize" Data="@_fftSizeOptions" Placeholder="FFT Size" Style="width:100%" />
                <small>Frequency resolution</small>
              </RadzenColumn>
              <RadzenColumn Size="12" SizeMD="4">
                <RadzenNumeric TValue="int" @bind-Value="_visualizerConfig.WaveformSampleCount" Min="64" Max="4096" Placeholder="Waveform Samples" Style="width:100%" />
                <small>Points in waveform display</small>
              </RadzenColumn>
              <RadzenColumn Size="12" SizeMD="4">
                <RadzenNumeric TValue="int" @bind-Value="_visualizerConfig.PeakHoldTimeMs" Min="0" Max="5000" Placeholder="Peak Hold (ms)" Style="width:100%" />
                <small>Peak indicator hold time</small>
              </RadzenColumn>
              <RadzenColumn Size="12" SizeMD="6">
                <RadzenNumeric TValue="float" @bind-Value="_visualizerConfig.SpectrumSmoothing" Min="0" Max="1" Step="(decimal)0.05f" Placeholder="Spectrum Smoothing" Style="width:100%" />
                <small>0 = no smoothing, 1 = max smoothing</small>
              </RadzenColumn>
              <RadzenColumn Size="12" SizeMD="6">
                <div style="display:flex;align-items:center;gap:8px">
                  <RadzenCheckBox TValue="bool" @bind-Value="_visualizerConfig.ApplyWindowFunction" />
                  <span>Apply Window Function</span>
                </div>
              </RadzenColumn>
              <RadzenColumn Size="12">
                <RadzenButton Variant="Variant.Filled" ButtonStyle="ButtonStyle.Primary" Click="SaveVisualizerConfigAsync"
                              Icon="save" Disabled="@_isSaving" Text="Save Visualizer Settings" />
              </RadzenColumn>
            </RadzenRow>
          }
          else
          {
            <RadzenProgressBarCircular ProgressBarStyle="ProgressBarStyle.Primary" Size="ProgressBarCircularSize.Small" Mode="ProgressBarMode.Indeterminate" />
            <span style="margin-left:8px">Loading visualizer configuration...</span>
          }
        </RadzenTabsItem>

        <!-- Output Configuration -->
        <RadzenTabsItem Text="Output">
          @if (_outputConfig != null)
          {
            <RadzenAccordion Multiple="true">
              <Items>
              <!-- Local Output -->
              <RadzenAccordionItem Text="Local Output" Icon="speaker">
                <RadzenRow Gap="0.5rem">
                  <RadzenColumn Size="12" SizeMD="4">
                    <div style="display:flex;align-items:center;gap:8px">
                      <RadzenCheckBox TValue="bool" @bind-Value="_localOutputEnabled" />
                      <span>Enabled</span>
                    </div>
                  </RadzenColumn>
                  <RadzenColumn Size="12" SizeMD="4">
                    <RadzenTextBox @bind-Value="_localPreferredDevice" Placeholder="Preferred Device ID" Style="width:100%" />
                    <small>Leave empty for system default</small>
                  </RadzenColumn>
                  <RadzenColumn Size="12" SizeMD="4">
                    <RadzenNumeric TValue="float" @bind-Value="_localDefaultVolume" Min="0" Max="1" Step="(decimal)0.05f" Placeholder="Default Volume" Style="width:100%" />
                    <small>0.0 - 1.0</small>
                  </RadzenColumn>
                </RadzenRow>
              </RadzenAccordionItem>

              <!-- HTTP Stream -->
              <RadzenAccordionItem Text="HTTP Stream" Icon="stream">
                <RadzenRow Gap="0.5rem">
                  <RadzenColumn Size="12" SizeMD="3">
                    <div style="display:flex;align-items:center;gap:8px">
                      <RadzenCheckBox TValue="bool" @bind-Value="_httpStreamEnabled" />
                      <span>Enabled</span>
                    </div>
                  </RadzenColumn>
                  <RadzenColumn Size="12" SizeMD="3">
                    <RadzenNumeric TValue="int" @bind-Value="_httpStreamPort" Min="1024" Max="65535" Placeholder="Port" Style="width:100%" />
                  </RadzenColumn>
                  <RadzenColumn Size="12" SizeMD="3">
                    <RadzenNumeric TValue="int" @bind-Value="_httpStreamSampleRate" Min="8000" Max="192000" Placeholder="Sample Rate (Hz)" Style="width:100%" />
                  </RadzenColumn>
                  <RadzenColumn Size="12" SizeMD="3">
                    <RadzenNumeric TValue="int" @bind-Value="_httpStreamChannels" Min="1" Max="8" Placeholder="Channels" Style="width:100%" />
                  </RadzenColumn>
                </RadzenRow>
              </RadzenAccordionItem>

              <!-- Google Cast -->
              <RadzenAccordionItem Text="Google Cast" Icon="cast">
                <RadzenRow Gap="0.5rem">
                  <RadzenColumn Size="12" SizeMD="4">
                    <div style="display:flex;align-items:center;gap:8px">
                      <RadzenCheckBox TValue="bool" @bind-Value="_castEnabled" />
                      <span>Enabled</span>
                    </div>
                  </RadzenColumn>
                  <RadzenColumn Size="12" SizeMD="4">
                    <RadzenNumeric TValue="int" @bind-Value="_castDiscoveryTimeout" Min="1" Max="60" Placeholder="Discovery Timeout (s)" Style="width:100%" />
                  </RadzenColumn>
                  <RadzenColumn Size="12" SizeMD="4">
                    <RadzenNumeric TValue="float" @bind-Value="_castDefaultVolume" Min="0" Max="1" Step="(decimal)0.05f" Placeholder="Default Volume" Style="width:100%" />
                    <small>0.0 - 1.0</small>
                  </RadzenColumn>
                </RadzenRow>
                <strong style="display:block; margin-top:12px; margin-bottom:4px;">DirectChannel Latency Tuning</strong>
                <RadzenRow Gap="0.5rem">
                  <RadzenColumn Size="12" SizeMD="4">
                    <RadzenNumeric TValue="float" @bind-Value="_castMaxBufferAhead" Min="(decimal)1.0f" Max="(decimal)5.0f" Step="(decimal)0.5f" Placeholder="Max Buffer Ahead (s)" Style="width:100%" />
                    <small>Drift protection cap. Lower = less latency (1.0-5.0)</small>
                  </RadzenColumn>
                  <RadzenColumn Size="12" SizeMD="4">
                    <RadzenNumeric TValue="int" @bind-Value="_castBufferBeforePlay" Min="1" Max="10" Placeholder="Buffer Before Play (chunks)" Style="width:100%" />
                    <small>Chunks buffered before playback starts (1-10)</small>
                  </RadzenColumn>
                  <RadzenColumn Size="12" SizeMD="4">
                    <RadzenNumeric TValue="float" @bind-Value="_castReaderLagSeconds" Min="(decimal)0.1f" Max="(decimal)2.0f" Step="(decimal)0.1f" Placeholder="Reader Lag (s)" Style="width:100%" />
                    <small>Stream reader lag behind write position (0.1-2.0)</small>
                  </RadzenColumn>
                </RadzenRow>
              </RadzenAccordionItem>
              </Items>
            </RadzenAccordion>

            <RadzenButton Variant="Variant.Filled" ButtonStyle="ButtonStyle.Primary" Click="SaveOutputConfigAsync" Style="margin-top:12px"
                          Icon="save" Disabled="@_isSaving" Text="Save Output Settings" />
          }
          else
          {
            <RadzenProgressBarCircular ProgressBarStyle="ProgressBarStyle.Primary" Size="ProgressBarCircularSize.Small" Mode="ProgressBarMode.Indeterminate" />
            <span style="margin-left:8px">Loading output configuration...</span>
          }
        </RadzenTabsItem>

        <!-- Devices Configuration -->
        <RadzenTabsItem Text="Devices">
          @if (_deviceOptions != null)
          {
            <RadzenRow Gap="0.5rem">
              <RadzenColumn Size="12">
                <RadzenAlert AlertStyle="AlertStyle.Info" Size="AlertSize.Small" AllowClose="false">
                  Enter a substring of the USB audio device name (case-insensitive). Run <code>aplay -l</code> on Linux to list device names.
                </RadzenAlert>
              </RadzenColumn>
              <RadzenColumn Size="12" SizeMD="6">
                <RadzenTextBox @bind-Value="_deviceOptions.Radio.USBPort" Placeholder="Radio USB Audio (RF320 only)" Style="width:100%" />
                <small>Leave empty if using RTL-SDR. Only set for RF320 USB audio capture.</small>
              </RadzenColumn>
              <RadzenColumn Size="12" SizeMD="6">
                <RadzenTextBox @bind-Value="_deviceOptions.Vinyl.USBPort" Placeholder="Vinyl Audio Device" Style="width:100%" />
                <small>USB audio device name pattern for turntable (e.g., USB Microphone)</small>
              </RadzenColumn>
              <RadzenColumn Size="12">
                <RadzenButton Variant="Variant.Filled" ButtonStyle="ButtonStyle.Primary" Click="SaveDeviceOptionsAsync"
                              Icon="save" Disabled="@_isSaving" Text="Save Device Settings" />
              </RadzenColumn>
            </RadzenRow>
          }
          else
          {
            <RadzenProgressBarCircular ProgressBarStyle="ProgressBarStyle.Primary" Size="ProgressBarCircularSize.Small" Mode="ProgressBarMode.Indeterminate" />
            <span style="margin-left:8px">Loading device configuration...</span>
          }
        </RadzenTabsItem>

        <!-- Display Configuration -->
        @* Wall-clock format settings (12h/24h + seconds) + sleep-screen
           weather forecast group. Both groups hot-reload via the SQLite-config
           bridge → IOptionsMonitor<DisplayOptions> / <WeatherDisplayOptions>;
           the topbar Time cluster, Sleep screen, and Queue ends-prediction
           repaint on their next 1 s tick. See HANDOFF-configurable-time-format.md §6
           and HANDOFF-sleep-mode-weather-forecast.md §5. *@
        <RadzenTabsItem Text="Display" Icon="schedule">
          @if (_displayConfig != null && _weatherDisplayConfig != null)
          {
            <RadzenRow Gap="0.5rem">
              <RadzenColumn Size="12">
                <RadzenAlert AlertStyle="AlertStyle.Info" Size="AlertSize.Small" AllowClose="false">
                  Controls how the kiosk renders the wall clock and the sleep-screen forecast. Saves take effect within ~1 second — no restart required.
                </RadzenAlert>
              </RadzenColumn>

              @* ── Time Format group ─────────────────────────────────────── *@
              <RadzenColumn Size="12">
                <h4 style="margin-top:0.5rem;margin-bottom:0.25rem;font-size:0.9rem;text-transform:uppercase;letter-spacing:0.06em;color:var(--rz-text-tertiary-color)">Time format</h4>
              </RadzenColumn>
              <RadzenColumn Size="12" SizeMD="6">
                <RadzenDropDown TValue="string" @bind-Value="_displayConfig.TimeFormat"
                                Data="@_timeFormatOptions"
                                TextProperty="Text" ValueProperty="Value"
                                Placeholder="Time Format" Style="width:100%"
                                aria-label="Time format" />
                <small>24-hour matches the historical default. Affects topbar clock, sleep screen, and queue end-time predictions.</small>
              </RadzenColumn>
              <RadzenColumn Size="12" SizeMD="6">
                <div style="display:flex;align-items:center;gap:8px">
                  <RadzenCheckBox TValue="bool" @bind-Value="_displayConfig.ShowSeconds"
                                  aria-label="Show seconds in wall clocks" />
                  <span>Show seconds</span>
                </div>
                <small>Adds <code>:ss</code> to the topbar and sleep clocks (e.g. <code>15:45:22</code> / <code>3:45:22 PM</code>). Off by default — the sleep screen is designed to be calm. Queue end-time always omits seconds regardless of this setting.</small>
              </RadzenColumn>

              @* ── Sleep-screen Weather group ────────────────────────────── *@
              <RadzenColumn Size="12">
                <h4 style="margin-top:1.25rem;margin-bottom:0.25rem;font-size:0.9rem;text-transform:uppercase;letter-spacing:0.06em;color:var(--rz-text-tertiary-color)">Sleep-screen weather</h4>
                <small>Adds a 3-day forecast that alternates with the clock on the sleep screen, using the US National Weather Service. Free, no API key required.</small>
              </RadzenColumn>
              <RadzenColumn Size="12">
                <div style="display:flex;align-items:center;gap:8px">
                  <RadzenCheckBox TValue="bool" @bind-Value="_weatherDisplayConfig.Enabled"
                                  aria-label="Enable weather on sleep screen" />
                  <span>Enable weather on sleep screen</span>
                </div>
              </RadzenColumn>
              <RadzenColumn Size="12" SizeMD="6">
                <RadzenLabel Text="ZIP code" />
                <RadzenTextBox @bind-Value="_weatherDisplayConfig.Zip"
                               MaxLength="5"
                               Disabled="@(!_weatherDisplayConfig.Enabled)"
                               Style="width:100%"
                               aria-label="ZIP code" />
                <small>5-digit US ZIP. Invalid ZIPs cause the sleep screen to fall back to clock-only (no error toast).</small>
              </RadzenColumn>
              <RadzenColumn Size="12" SizeMD="6">
                <RadzenLabel Text="Refresh interval (minutes)" />
                <RadzenNumeric TValue="int" @bind-Value="_weatherDisplayConfig.RefreshIntervalMinutes"
                               Min="15" Max="360" Step="15"
                               Disabled="@(!_weatherDisplayConfig.Enabled)"
                               Style="width:100%"
                               aria-label="Forecast refresh interval in minutes" />
                <small>15 – 360 minutes. NWS updates roughly hourly; anything less aggressive than 60 min is wasted bandwidth.</small>
              </RadzenColumn>
              <RadzenColumn Size="12" SizeMD="6">
                <RadzenLabel Text="Temperature unit" />
                <RadzenDropDown TValue="string" @bind-Value="_weatherDisplayConfig.TemperatureUnit"
                                Data="@_temperatureUnitOptions"
                                TextProperty="Text" ValueProperty="Value"
                                Disabled="@(!_weatherDisplayConfig.Enabled)"
                                Style="width:100%"
                                aria-label="Temperature unit" />
              </RadzenColumn>
              <RadzenColumn Size="12" SizeMD="6">
                <RadzenLabel Text="Contact email (optional)" />
                <RadzenTextBox @bind-Value="_weatherDisplayConfig.ContactEmail"
                               Disabled="@(!_weatherDisplayConfig.Enabled)"
                               Style="width:100%"
                               aria-label="NWS contact email" />
                <small>Sent to NWS as a User-Agent so they can contact you if there's an issue. Defaults to a placeholder when blank.</small>
              </RadzenColumn>

              <RadzenColumn Size="12">
                <RadzenButton Variant="Variant.Filled" ButtonStyle="ButtonStyle.Primary" Click="SaveDisplayConfigAsync"
                              Icon="save" Disabled="@_isSaving" Text="Save Display Settings" />
              </RadzenColumn>
            </RadzenRow>
          }
          else
          {
            <RadzenProgressBarCircular ProgressBarStyle="ProgressBarStyle.Primary" Size="ProgressBarCircularSize.Small" Mode="ProgressBarMode.Indeterminate" />
            <span style="margin-left:8px">Loading display configuration...</span>
          }
        </RadzenTabsItem>

        <!-- Audio Engine Configuration -->
        <RadzenTabsItem Text="Audio Engine">
          @if (_audioEngineConfig != null)
          {
            <RadzenRow Gap="0.5rem">
              <RadzenColumn Size="12">
                <RadzenAlert AlertStyle="AlertStyle.Warning" Size="AlertSize.Small" AllowClose="false">
                  Changes to audio engine settings require an application restart to take effect.
                </RadzenAlert>
              </RadzenColumn>
              <RadzenColumn Size="12" SizeMD="4">
                <RadzenDropDown TValue="int" @bind-Value="_audioEngineConfig.SampleRate" Data="@_sampleRateOptions"
                                TextProperty="Text" ValueProperty="Value" Placeholder="Sample Rate (Hz)" Style="width:100%" />
                <small>Audio sample rate</small>
              </RadzenColumn>
              <RadzenColumn Size="12" SizeMD="4">
                <RadzenDropDown TValue="int" @bind-Value="_audioEngineConfig.Channels" Data="@_channelOptions"
                                TextProperty="Text" ValueProperty="Value" Placeholder="Channels" Style="width:100%" />
                <small>Audio channel count</small>
              </RadzenColumn>
              <RadzenColumn Size="12" SizeMD="4">
                <RadzenDropDown TValue="int" @bind-Value="_audioEngineConfig.BufferSize" Data="@_bufferSizeOptions"
                                TextProperty="Text" ValueProperty="Value" Placeholder="Buffer Size (samples)" Style="width:100%" />
                <small>Audio buffer size</small>
              </RadzenColumn>
              <RadzenColumn Size="12" SizeMD="4">
                <RadzenNumeric TValue="int" @bind-Value="_audioEngineConfig.HotPlugIntervalSeconds" Min="1" Max="60" Placeholder="Hot Plug Interval (s)" Style="width:100%" />
                <small>Device detection interval</small>
              </RadzenColumn>
              <RadzenColumn Size="12" SizeMD="4">
                <RadzenNumeric TValue="int" @bind-Value="_audioEngineConfig.OutputBufferSizeSeconds" Min="1" Max="30" Placeholder="Output Buffer (s)" Style="width:100%" />
                <small>Output buffer size in seconds</small>
              </RadzenColumn>
              <RadzenColumn Size="12" SizeMD="4">
                <div style="display:flex;align-items:center;gap:8px">
                  <RadzenCheckBox TValue="bool" @bind-Value="_audioEngineConfig.EnableHotPlugDetection" />
                  <span>Enable Hot Plug Detection</span>
                </div>
              </RadzenColumn>
              <RadzenColumn Size="12">
                <RadzenButton Variant="Variant.Filled" ButtonStyle="ButtonStyle.Primary" Click="SaveAudioEngineConfigAsync"
                              Icon="save" Disabled="@_isSaving" Text="Save Audio Engine Settings" />
              </RadzenColumn>
            </RadzenRow>
          }
          else
          {
            <RadzenProgressBarCircular ProgressBarStyle="ProgressBarStyle.Primary" Size="ProgressBarCircularSize.Small" Mode="ProgressBarMode.Indeterminate" />
            <span style="margin-left:8px">Loading audio engine configuration...</span>
          }
        </RadzenTabsItem>

        <!-- Radio Configuration -->
        <RadzenTabsItem Text="Radio">
          @if (_radioConfig != null)
          {
            <RadzenRow Gap="0.5rem">
              <RadzenColumn Size="12" SizeMD="4">
                <RadzenDropDown TValue="string" @bind-Value="_radioConfig.DefaultDevice" Data="@_radioDeviceOptions"
                                TextProperty="Text" ValueProperty="Value" Placeholder="Default Radio Device" Style="width:100%" />
                <small>Radio hardware backend</small>
              </RadzenColumn>
              <RadzenColumn Size="12" SizeMD="4">
                <RadzenNumeric TValue="double" @bind-Value="_radioConfig.DefaultFMFrequencyMHz" Min="(decimal)87.5" Max="(decimal)108.0" Step="(decimal)0.1" Placeholder="Default FM Frequency (MHz)" Style="width:100%" />
                <small>Startup FM frequency</small>
              </RadzenColumn>
              <RadzenColumn Size="12" SizeMD="4">
                <RadzenNumeric TValue="double" @bind-Value="_radioConfig.DefaultAMFrequencyKHz" Min="520" Max="1710" Step="(decimal)10.0" Placeholder="Default AM Frequency (kHz)" Style="width:100%" />
                <small>Startup AM frequency</small>
              </RadzenColumn>
              <RadzenColumn Size="12" SizeMD="3">
                <RadzenNumeric TValue="double" @bind-Value="_radioConfig.DefaultFMStepMHz" Min="(decimal)0.05" Max="(decimal)1.0" Step="(decimal)0.05" Placeholder="FM Step (MHz)" Style="width:100%" />
                <small>FM tuning step size</small>
              </RadzenColumn>
              <RadzenColumn Size="12" SizeMD="3">
                <RadzenNumeric TValue="double" @bind-Value="_radioConfig.DefaultAMStepKHz" Min="1" Max="50" Step="(decimal)1.0" Placeholder="AM Step (kHz)" Style="width:100%" />
                <small>AM tuning step size</small>
              </RadzenColumn>
              <RadzenColumn Size="12" SizeMD="3">
                <RadzenNumeric TValue="double" @bind-Value="_radioConfig.MinFMFrequencyMHz" Min="50" Max="200" Step="(decimal)0.5" Placeholder="Min FM (MHz)" Style="width:100%" />
              </RadzenColumn>
              <RadzenColumn Size="12" SizeMD="3">
                <RadzenNumeric TValue="double" @bind-Value="_radioConfig.MaxFMFrequencyMHz" Min="50" Max="200" Step="(decimal)0.5" Placeholder="Max FM (MHz)" Style="width:100%" />
              </RadzenColumn>
              <RadzenColumn Size="12" SizeMD="3">
                <RadzenNumeric TValue="double" @bind-Value="_radioConfig.MinAMFrequencyKHz" Min="100" Max="2000" Step="(decimal)10.0" Placeholder="Min AM (kHz)" Style="width:100%" />
              </RadzenColumn>
              <RadzenColumn Size="12" SizeMD="3">
                <RadzenNumeric TValue="double" @bind-Value="_radioConfig.MaxAMFrequencyKHz" Min="100" Max="2000" Step="(decimal)10.0" Placeholder="Max AM (kHz)" Style="width:100%" />
              </RadzenColumn>
              <RadzenColumn Size="12" SizeMD="3">
                <RadzenNumeric TValue="int" @bind-Value="_radioConfig.ScanStopThreshold" Min="0" Max="100" Placeholder="Scan Stop Threshold" Style="width:100%" />
                <small>Signal strength to stop scan</small>
              </RadzenColumn>
              <RadzenColumn Size="12" SizeMD="3">
                <RadzenNumeric TValue="int" @bind-Value="_radioConfig.ScanStepDelayMs" Min="10" Max="1000" Placeholder="Scan Step Delay (ms)" Style="width:100%" />
                <small>Delay between scan steps</small>
              </RadzenColumn>
              <RadzenColumn Size="12" SizeMD="4">
                <RadzenNumeric TValue="int" @bind-Value="_radioConfig.DefaultDeviceVolume" Min="0" Max="100" Placeholder="Default Device Volume" Style="width:100%" />
                <small>Radio hardware volume (0-100)</small>
              </RadzenColumn>

              @* HANDOFF-rds-accumulating-scroll §5 — RDS RadioText ticker
                 settings live under the existing Radio tab so all "how the
                 radio behaves" tunables stay co-located. The sub-heading row
                 separates this group visually from the tuning / scan settings
                 above. *@
              <RadzenColumn Size="12">
                <div style="margin-top: 12px; padding-top: 8px; border-top: 1px solid var(--rz-border, #ddd);
                            font-family: var(--font-mono, monospace); font-size: 0.75rem;
                            letter-spacing: 0.12em; text-transform: uppercase;
                            color: var(--text-low, #888);">
                  RDS RADIOTEXT TICKER
                </div>
              </RadzenColumn>
              <RadzenColumn Size="12" SizeMD="4">
                <RadzenNumeric TValue="int" @bind-Value="_radioConfig.RtBufferMaxChars" Min="64" Max="2048" Step="32" Placeholder="Max length (chars)" Style="width:100%" />
                <small>Rolling buffer cap (64-2048)</small>
              </RadzenColumn>
              <RadzenColumn Size="12" SizeMD="4">
                <RadzenNumeric TValue="int" @bind-Value="_radioConfig.RtScrollSpeedPxPerSec" Min="10" Max="200" Step="5" Placeholder="Scroll speed (px/s)" Style="width:100%" />
                <small>Marquee speed (10-200 px/s)</small>
              </RadzenColumn>
              <RadzenColumn Size="12" SizeMD="4">
                <RadzenTextBox @bind-Value="_radioConfig.RtChunkSeparator" Placeholder="Chunk separator" Style="width:100%" MaxLength="8" />
                <small>Between chunks (1-8 chars)</small>
              </RadzenColumn>

              <RadzenColumn Size="12">
                <RadzenButton Variant="Variant.Filled" ButtonStyle="ButtonStyle.Primary" Click="SaveRadioConfigAsync"
                              Icon="save" Disabled="@_isSaving" Text="Save Radio Settings" />
              </RadzenColumn>
            </RadzenRow>
          }
          else
          {
            <RadzenProgressBarCircular ProgressBarStyle="ProgressBarStyle.Primary" Size="ProgressBarCircularSize.Small" Mode="ProgressBarMode.Indeterminate" />
            <span style="margin-left:8px">Loading radio configuration...</span>
          }
        </RadzenTabsItem>

        <!-- Bluetooth Configuration -->
        <RadzenTabsItem Text="Bluetooth">
          @if (_bluetoothConfig != null)
          {
            <RadzenRow Gap="0.5rem">
              <RadzenColumn Size="12">
                <RadzenAlert AlertStyle="AlertStyle.Info" Size="AlertSize.Small" AllowClose="false">
                  Bluetooth A2DP sink allows phones to stream audio to this device. Note: On Windows, the adapter starts but A2DP sink is not natively supported. This feature works on the target Linux/Raspberry Pi platform where BlueZ supports A2DP sink.
                </RadzenAlert>
              </RadzenColumn>
              <RadzenColumn Size="12" SizeMD="6">
                <RadzenTextBox @bind-Value="_bluetoothConfig.DeviceName" Placeholder="Device Name" Style="width:100%" />
                <small>Name visible to Bluetooth scanners</small>
              </RadzenColumn>
              <RadzenColumn Size="12" SizeMD="6">
                <RadzenDropDown TValue="string" @bind-Value="_bluetoothConfig.AudioQuality" Data="@_audioQualityOptions"
                                TextProperty="Text" ValueProperty="Value" Placeholder="Audio Quality" Style="width:100%" />
                <small>Bluetooth audio quality</small>
              </RadzenColumn>
              <RadzenColumn Size="12" SizeMD="4">
                <div style="display:flex;align-items:center;gap:8px"><RadzenCheckBox TValue="bool" @bind-Value="_bluetoothConfig.Enabled" /><span>Enabled</span></div>
              </RadzenColumn>
              <RadzenColumn Size="12" SizeMD="4">
                <div style="display:flex;align-items:center;gap:8px"><RadzenCheckBox TValue="bool" @bind-Value="_bluetoothConfig.EnableOnStartup" /><span>Enable on Startup</span></div>
              </RadzenColumn>
              <RadzenColumn Size="12" SizeMD="4">
                <div style="display:flex;align-items:center;gap:8px"><RadzenCheckBox TValue="bool" @bind-Value="_bluetoothConfig.AutoSwitchOnConnect" /><span>Auto-Switch on Connect</span></div>
              </RadzenColumn>
              <RadzenColumn Size="12" SizeMD="6">
                <div style="display:flex;align-items:center;gap:8px"><RadzenCheckBox TValue="bool" @bind-Value="_bluetoothConfig.AutoAcceptConnections" /><span>Auto-Accept Connections</span></div>
              </RadzenColumn>
              <RadzenColumn Size="12" SizeMD="6">
                <div style="display:flex;align-items:center;gap:8px"><RadzenCheckBox TValue="bool" @bind-Value="_bluetoothConfig.RequirePairing" /><span>Require Pairing</span></div>
              </RadzenColumn>
              <RadzenColumn Size="12">
                <RadzenButton Variant="Variant.Filled" ButtonStyle="ButtonStyle.Primary" Click="SaveBluetoothConfigAsync"
                              Icon="save" Disabled="@_isSaving" Text="Save Bluetooth Settings" />
              </RadzenColumn>
            </RadzenRow>
          }
          else
          {
            <RadzenProgressBarCircular ProgressBarStyle="ProgressBarStyle.Primary" Size="ProgressBarCircularSize.Small" Mode="ProgressBarMode.Indeterminate" />
            <span style="margin-left:8px">Loading Bluetooth configuration...</span>
          }
        </RadzenTabsItem>

        <!-- File Player Configuration -->
        <RadzenTabsItem Text="File Player">
          @if (_filePlayerConfig != null)
          {
            <RadzenRow Gap="0.5rem">
              <RadzenColumn Size="12" SizeMD="6">
                <RadzenTextBox @bind-Value="_filePlayerConfig.RootDirectory" Placeholder="Root Directory" Style="width:100%" />
                <small>Root path for music library</small>
              </RadzenColumn>
              <RadzenColumn Size="12" SizeMD="6">
                <RadzenTextBox @bind-Value="_filePlayerConfig.SupportedExtensions" Placeholder="Supported Extensions" Style="width:100%" />
                <small>Comma-separated file extensions (e.g., .mp3,.flac,.wav)</small>
              </RadzenColumn>

              <!-- Bookmarked Paths -->
              <RadzenColumn Size="12">
                <div style="display: flex; align-items: center; justify-content: space-between; margin-top: 8px; margin-bottom: 4px;">
                  <span style="font-weight: 600;">
                    <RadzenIcon Icon="star" Style="vertical-align: middle; margin-right: 4px; color:var(--rz-warning)" />
                    Bookmarked Folders
                  </span>
                  <RadzenButton Variant="Variant.Text" ButtonStyle="ButtonStyle.Primary" Size="ButtonSize.Small"
                                Icon="add" Click="AddBookmark" Text="Add Bookmark" />
                </div>
                <span style="font-size:0.75rem; color:var(--text-low); display:block; margin-bottom:8px">
                  Quick-access folders shown at the top of the file browser. Tag with "music" for queue browsing or "sounds" for event file selection.
                </span>

                @if (_filePlayerConfig.BookmarkedPaths.Count == 0)
                {
                  <RadzenAlert AlertStyle="AlertStyle.Info" Size="AlertSize.Small" AllowClose="false" Variant="Radzen.Variant.Text" Style="margin-bottom:8px">
                    No bookmarks configured. The file browser will open to the media library root.
                  </RadzenAlert>
                }
                else
                {
                  @for (int i = 0; i < _filePlayerConfig.BookmarkedPaths.Count; i++)
                  {
                    var index = i;
                    var bookmark = _filePlayerConfig.BookmarkedPaths[index];
                    <div style="border:1px solid var(--rz-border-color); border-radius:4px; padding:12px; margin-bottom:8px; background:rgba(255,255,255,0.02);">
                      <RadzenRow Gap="0.5rem">
                        <RadzenColumn Size="12" SizeMD="5">
                          <RadzenTextBox @bind-Value="bookmark.Path" Placeholder="/mnt/nas/music" Style="width:100%" />
                        </RadzenColumn>
                        <RadzenColumn Size="12" SizeMD="3">
                          <RadzenTextBox @bind-Value="bookmark.Label" Placeholder="NAS Music Library" Style="width:100%" />
                        </RadzenColumn>
                        <RadzenColumn Size="8" SizeMD="2">
                          <RadzenDropDown TValue="string" @bind-Value="bookmark.Tag" Data="@_bookmarkTagOptions"
                                          TextProperty="Text" ValueProperty="Value" Placeholder="Tag" Style="width:100%" />
                        </RadzenColumn>
                        <RadzenColumn Size="4" SizeMD="2" Style="display: flex; align-items: center; gap: 4px; justify-content: flex-end;">
                          @if (index > 0)
                          {
                            <RadzenButton Icon="arrow_upward" ButtonStyle="ButtonStyle.Light" Variant="Variant.Text" Size="ButtonSize.Small"
                                          Click="@(() => MoveBookmarkUp(index))" title="Move up" />
                          }
                          @if (index < _filePlayerConfig.BookmarkedPaths.Count - 1)
                          {
                            <RadzenButton Icon="arrow_downward" ButtonStyle="ButtonStyle.Light" Variant="Variant.Text" Size="ButtonSize.Small"
                                          Click="@(() => MoveBookmarkDown(index))" title="Move down" />
                          }
                          <RadzenButton Icon="delete" ButtonStyle="ButtonStyle.Danger" Variant="Variant.Text" Size="ButtonSize.Small"
                                        Click="@(() => RemoveBookmark(index))" title="Remove bookmark" />
                        </RadzenColumn>
                      </RadzenRow>
                    </div>
                  }
                }
              </RadzenColumn>

              <RadzenColumn Size="12">
                <RadzenButton Variant="Variant.Filled" ButtonStyle="ButtonStyle.Primary" Click="SaveFilePlayerConfigAsync"
                              Icon="save" Disabled="@_isSaving" Text="Save File Player Settings" />
              </RadzenColumn>
            </RadzenRow>
          }
          else
          {
            <RadzenProgressBarCircular ProgressBarStyle="ProgressBarStyle.Primary" Size="ProgressBarCircularSize.Small" Mode="ProgressBarMode.Indeterminate" />
            <span style="margin-left:8px">Loading file player configuration...</span>
          }
        </RadzenTabsItem>

        <!-- TTS Configuration -->
        <RadzenTabsItem Text="TTS">
          @if (_ttsConfig != null)
          {
            <RadzenRow Gap="0.5rem">
              <RadzenColumn Size="12" SizeMD="4">
                <RadzenDropDown TValue="string" @bind-Value="_ttsConfig.DefaultEngine" Data="@_ttsEngineOptions"
                                TextProperty="Text" ValueProperty="Value" Placeholder="Default Engine" Style="width:100%" />
                <small>Text-to-speech engine</small>
              </RadzenColumn>
              <RadzenColumn Size="12" SizeMD="4">
                <RadzenTextBox @bind-Value="_ttsConfig.DefaultVoice" Placeholder="Default Voice" Style="width:100%" />
                <small>Voice ID — engine-specific (e.g. 'en-US-News-K' for Google, 'en' for ESpeak)</small>
              </RadzenColumn>
              <RadzenColumn Size="12" SizeMD="4">
                <RadzenTextBox @bind-Value="_ttsConfig.ESpeakPath" Placeholder="ESpeak Path" Style="width:100%" />
                <small>Path to espeak-ng binary</small>
              </RadzenColumn>
              <RadzenColumn Size="12" SizeMD="4">
                <RadzenNumeric TValue="float" @bind-Value="_ttsConfig.DefaultPitch" Min="(decimal)0.5f" Max="(decimal)2.0f" Step="(decimal)0.1f" Placeholder="Default Pitch" Style="width:100%" />
                <small>1.0 = normal pitch</small>
              </RadzenColumn>
              <RadzenColumn Size="12" SizeMD="4">
                <RadzenNumeric TValue="float" @bind-Value="_ttsConfig.DefaultSpeed" Min="(decimal)0.5f" Max="(decimal)2.0f" Step="(decimal)0.1f" Placeholder="Default Speed" Style="width:100%" />
                <small>1.0 = normal speed</small>
              </RadzenColumn>
              <RadzenColumn Size="12" SizeMD="4">
                <RadzenNumeric TValue="int" @bind-Value="_ttsConfig.GenerationTimeoutSeconds" Min="5" Max="120" Placeholder="Generation Timeout (s)" Style="width:100%" />
                <small>Max time for TTS generation</small>
              </RadzenColumn>
              <RadzenColumn Size="12">
                <RadzenButton Variant="Variant.Filled" ButtonStyle="ButtonStyle.Primary" Click="SaveTTSConfigAsync"
                              Icon="save" Disabled="@_isSaving" Text="Save TTS Settings" />
              </RadzenColumn>
            </RadzenRow>
          }
          else
          {
            <RadzenProgressBarCircular ProgressBarStyle="ProgressBarStyle.Primary" Size="ProgressBarCircularSize.Small" Mode="ProgressBarMode.Indeterminate" />
            <span style="margin-left:8px">Loading TTS configuration...</span>
          }
        </RadzenTabsItem>

        <!-- Fingerprinting Configuration -->
        <RadzenTabsItem Text="Fingerprinting">
          @if (_fingerprintingConfig != null)
          {
            <RadzenRow Gap="0.5rem">
              <RadzenColumn Size="12">
                <RadzenAlert AlertStyle="AlertStyle.Info" Size="AlertSize.Small" AllowClose="false">
                  Fingerprinting uses SongRec (Shazam) for audio recognition. Enable "Use Shazam for All Sources" to get higher-quality cover art from Apple Music CDN on Bluetooth and file sources.
                </RadzenAlert>
              </RadzenColumn>
              <RadzenColumn Size="12" SizeMD="4">
                <div style="display:flex;align-items:center;gap:8px"><RadzenCheckBox TValue="bool" @bind-Value="_fingerprintingConfig.Enabled" /><span>Enabled</span></div>
              </RadzenColumn>
              <RadzenColumn Size="12" SizeMD="8">
                <div style="display:flex;align-items:center;gap:8px">
                  <RadzenCheckBox TValue="bool" @bind-Value="_fingerprintingConfig.UseShazamForAllSources" Disabled="@(!_fingerprintingConfig.Enabled)" />
                  <span>Use Shazam for All Sources</span>
                </div>
                <span style="font-size:0.75rem; color:var(--text-low); margin-left:32px; display:block">Use Shazam (SongRec) for metadata and high-quality cover art on all sources, even when Bluetooth AVRCP or file ID3 tags are available</span>
              </RadzenColumn>
              <RadzenColumn Size="12" SizeMD="4">
                <RadzenNumeric TValue="int" @bind-Value="_fingerprintingConfig.SampleDurationSeconds" Min="5" Max="60" Placeholder="Sample Duration (s)" Style="width:100%" />
                <small>Audio sample length for fingerprinting</small>
              </RadzenColumn>
              <RadzenColumn Size="12" SizeMD="4">
                <RadzenNumeric TValue="int" @bind-Value="_fingerprintingConfig.IdentificationIntervalSeconds" Min="10" Max="300" Placeholder="Identification Interval (s)" Style="width:100%" />
                <small>Time between identification attempts</small>
              </RadzenColumn>
              <RadzenColumn Size="12" SizeMD="4">
                <RadzenNumeric TValue="double" @bind-Value="_fingerprintingConfig.MinimumConfidenceThreshold" Min="(decimal)0.0" Max="(decimal)1.0" Step="(decimal)0.05" Placeholder="Min Confidence" Style="width:100%" />
                <small>0.0 - 1.0 confidence threshold</small>
              </RadzenColumn>
              <RadzenColumn Size="12" SizeMD="4">
                <RadzenNumeric TValue="int" @bind-Value="_fingerprintingConfig.DuplicateSuppressionMinutes" Min="1" Max="60" Placeholder="Duplicate Suppression (min)" Style="width:100%" />
                <small>Ignore re-identification within this window</small>
              </RadzenColumn>
              <RadzenColumn Size="12" SizeMD="6">
                <RadzenTextBox @bind-Value="_fingerprintingConfig.DatabasePath" Placeholder="Database Path" Style="width:100%" />
                <small>Path to fingerprinting database</small>
              </RadzenColumn>
              <RadzenColumn Size="12">
                <RadzenButton Variant="Variant.Filled" ButtonStyle="ButtonStyle.Primary" Click="SaveFingerprintingConfigAsync"
                              Icon="save" Disabled="@_isSaving" Text="Save Fingerprinting Settings" />
              </RadzenColumn>
            </RadzenRow>
          }
          else
          {
            <RadzenProgressBarCircular ProgressBarStyle="ProgressBarStyle.Primary" Size="ProgressBarCircularSize.Small" Mode="ProgressBarMode.Indeterminate" />
            <span style="margin-left:8px">Loading fingerprinting configuration...</span>
          }
        </RadzenTabsItem>

        <!-- Metrics Configuration -->
        <RadzenTabsItem Text="Metrics">
          @if (_metricsConfig != null)
          {
            <RadzenRow Gap="0.5rem">
              <RadzenColumn Size="12" SizeMD="4">
                <div style="display:flex;align-items:center;gap:8px"><RadzenCheckBox TValue="bool" @bind-Value="_metricsConfig.Enabled" /><span>Enabled</span></div>
              </RadzenColumn>
              <RadzenColumn Size="12" SizeMD="4">
                <RadzenNumeric TValue="int" @bind-Value="_metricsConfig.FlushIntervalSeconds" Min="10" Max="600" Placeholder="Flush Interval (s)" Style="width:100%" />
                <small>How often metrics are flushed to DB</small>
              </RadzenColumn>
              <RadzenColumn Size="12" SizeMD="4">
                <RadzenTextBox @bind-Value="_metricsConfig.DatabasePath" Placeholder="Database Path" Style="width:100%" />
                <small>Path to metrics database</small>
              </RadzenColumn>
              <RadzenColumn Size="12" SizeMD="3">
                <RadzenNumeric TValue="int" @bind-Value="_metricsConfig.RetentionMinuteData" Min="1" Max="10080" Placeholder="Retention: Minutes" Style="width:100%" />
                <small>Minute-level data retention (minutes)</small>
              </RadzenColumn>
              <RadzenColumn Size="12" SizeMD="3">
                <RadzenNumeric TValue="int" @bind-Value="_metricsConfig.RetentionHourData" Min="1" Max="8760" Placeholder="Retention: Hours" Style="width:100%" />
                <small>Hour-level data retention (hours)</small>
              </RadzenColumn>
              <RadzenColumn Size="12" SizeMD="3">
                <RadzenNumeric TValue="int" @bind-Value="_metricsConfig.RetentionDayData" Min="1" Max="3650" Placeholder="Retention: Days" Style="width:100%" />
                <small>Day-level data retention (days)</small>
              </RadzenColumn>
              <RadzenColumn Size="12" SizeMD="3">
                <RadzenNumeric TValue="int" @bind-Value="_metricsConfig.RollupIntervalMinutes" Min="1" Max="1440" Placeholder="Rollup Interval (min)" Style="width:100%" />
                <small>How often rollups are computed</small>
              </RadzenColumn>
              <RadzenColumn Size="12">
                <RadzenButton Variant="Variant.Filled" ButtonStyle="ButtonStyle.Primary" Click="SaveMetricsConfigAsync"
                              Icon="save" Disabled="@_isSaving" Text="Save Metrics Settings" />
              </RadzenColumn>
            </RadzenRow>
          }
          else
          {
            <RadzenProgressBarCircular ProgressBarStyle="ProgressBarStyle.Primary" Size="ProgressBarCircularSize.Small" Mode="ProgressBarMode.Indeterminate" />
            <span style="margin-left:8px">Loading metrics configuration...</span>
          }
        </RadzenTabsItem>

        </Tabs>
      </RadzenTabs>
    </RadzenTabsItem>

    <!-- Tab 3: Log Viewer -->
    <RadzenTabsItem Text="Logs" Icon="article">
      <div style="display:flex; flex-direction:row; gap:8px; margin-bottom:12px">
        <RadzenDropDown TValue="string" @bind-Value="_logLevel" Data="@_logLevelOptions"
                        TextProperty="Text" ValueProperty="Value" Placeholder="Log Level" Style="min-width:150px" />

        <RadzenNumeric TValue="int" @bind-Value="_logLimit" Min="1" Max="10000" Placeholder="Limit" Style="width:120px" />

        <RadzenButton Variant="Variant.Filled" ButtonStyle="ButtonStyle.Primary" Click="LoadLogsAsync" Icon="refresh" Text="Refresh" />

        <RadzenButton Variant="Variant.Outlined" ButtonStyle="ButtonStyle.Secondary" Click="ExportLogsAsync" Icon="download" Disabled="@(_logs == null || _logs.Count == 0)" Text="Export" />
      </div>

      @if (_logsLoading)
      {
        <RadzenProgressBar Mode="ProgressBarMode.Indeterminate" ProgressBarStyle="ProgressBarStyle.Primary" />
      }
      else if (_logs != null && _logs.Count > 0)
      {
        <div style="height: 350px; overflow-y: auto;">
          <table class="rz-datatable" style="width:100%">
            <thead>
              <tr>
                <th style="width: 180px;">Timestamp</th>
                <th style="width: 100px;">Level</th>
                <th style="width: 250px;">Source</th>
                <th>Message</th>
              </tr>
            </thead>
            <tbody>
              @foreach (var log in _logs)
              {
                <tr>
                  <td>@log.Timestamp.ToLocalTime().ToString("yyyy-MM-dd HH:mm:ss")</td>
                  <td>
                    <RadzenBadge Text="@log.Level" BadgeStyle="@GetLogLevelBadgeStyle(log.Level)" />
                  </td>
                  <td>@GetShortSourceName(log.SourceContext)</td>
                  <td>
                    @log.Message
                    @if (!string.IsNullOrEmpty(log.Exception))
                    {
                      <span style="font-size:0.75rem; color:var(--rz-danger)">@log.Exception</span>
                    }
                  </td>
                </tr>
              }
            </tbody>
          </table>
        </div>
        <span style="font-size:0.75rem; color:var(--text-low); margin-top:8px; display:block">Showing @_logs.Count of @_totalLogCount logs</span>
      }
      else
      {
        <RadzenAlert AlertStyle="AlertStyle.Info" AllowClose="false">No logs found matching the current filters.</RadzenAlert>
      }
    </RadzenTabsItem>

    <!-- Tab 4: Event Sources -->
    <RadzenTabsItem Text="Event Sources" Icon="event_note">
      <RadzenRow Gap="1rem">
        <!-- TTS Section -->
        <RadzenColumn Size="12" SizeMD="6">
          <RadzenCard>
            <h6>Text-to-Speech</h6>
            <RadzenTextArea @bind-Value="_ttsText" Placeholder="Enter text to speak..." Rows="3" Style="width:100%" />

            <div style="margin-top:12px">
              <RadzenDropDown TValue="string" Value="_selectedTTSEngine" Data="@_availableTTSEngineOptions"
                              TextProperty="Text" ValueProperty="Value" Placeholder="TTS Engine" Style="width:100%"
                              Change="@(async (object args) => await OnTTSEngineChangedAsync((string)args))" />
            </div>

            @if (_selectedTTSEngine is "Google" or "Azure")
            {
              @if (_cloudVoices != null && _cloudVoices.Count > 0)
              {
                <div style="margin-top:12px">
                  <RadzenDropDown TValue="string" @bind-Value="_ttsVoice" Data="@_cloudVoiceOptions"
                                  TextProperty="Text" ValueProperty="Value" Placeholder="Voice" Style="width:100%" />
                </div>
                <div style="display:flex; flex-direction:row; gap:4px; margin-top:8px; align-items:center">
                  <RadzenButton Variant="Variant.Text" Size="ButtonSize.Small" Icon="refresh"
                                Click="ScanForVoicesAsync" Disabled="_scanningVoices"
                                Text="@(_scanningVoices ? "Scanning..." : "Scan for Voices")" />
                  @if (!string.IsNullOrEmpty(_ttsVoice))
                  {
                    var isFav = _cloudVoices.Any(v => v.Id == _ttsVoice && v.IsFavorite);
                    <RadzenButton Icon="@(isFav ? "star" : "star_border")"
                                  ButtonStyle="@(isFav ? ButtonStyle.Warning : ButtonStyle.Light)" Variant="Variant.Text" Size="ButtonSize.Small"
                                  Click="ToggleVoiceFavoriteAsync" />
                  }
                </div>
              }
              else
              {
                <div style="margin-top:12px">
                  <RadzenTextBox @bind-Value="_ttsVoice" Placeholder="Voice (Optional)" Style="width:100%" />
                  <small>Click 'Scan for Voices' to discover available voices</small>
                </div>
                <RadzenButton Variant="Variant.Text" Size="ButtonSize.Small" Icon="search"
                              Click="ScanForVoicesAsync" Disabled="_scanningVoices" Style="margin-top:8px"
                              Text="@(_scanningVoices ? "Scanning..." : "Scan for Voices")" />
              }
            }
            else
            {
              <div style="margin-top:12px">
                <RadzenTextBox @bind-Value="_ttsVoice" Placeholder="Voice (Optional)" Style="width:100%" />
                <small>e.g., 'en', 'en-US-Standard-A'</small>
              </div>
            }

            <div style="display:flex; flex-direction:row; gap:8px; margin-top:12px">
              <RadzenNumeric TValue="double" @bind-Value="_ttsSpeed" Min="(decimal)0.5" Max="(decimal)2.0" Step="(decimal)0.1" Placeholder="Speed" Style="width:150px" />
              <RadzenNumeric TValue="double" @bind-Value="_ttsPitch" Min="(decimal)0.5" Max="(decimal)2.0" Step="(decimal)0.1" Placeholder="Pitch" Style="width:150px" />
            </div>

            <div style="margin-top:12px">
              <RadzenButton Variant="Variant.Filled" ButtonStyle="ButtonStyle.Primary" Icon="record_voice_over"
                            Click="PlayTTSAsync" Disabled="@(string.IsNullOrWhiteSpace(_ttsText) || _ttsEngines == null || !_ttsEngines.Any(e => e.IsAvailable))"
                            Text="Speak" />
            </div>
          </RadzenCard>
        </RadzenColumn>

        <!-- Audio File Section -->
        <RadzenColumn Size="12" SizeMD="6">
          <RadzenCard>
            <h6>Audio File Events</h6>
            @if (!string.IsNullOrWhiteSpace(_selectedSoundFile))
            {
              var selectedSound = _notificationSounds?.FirstOrDefault(s => s.FilePath == _selectedSoundFile);
              if (selectedSound != null)
              {
                <div style="display: flex; align-items: center; gap: 12px; padding: 16px; background: var(--rz-base-200); border-radius: 8px;">
                  <RadzenIcon Icon="music_note" Style="color:var(--rz-primary); font-size:2rem" />
                  <div style="flex: 1;">
                    <span style="font-size:1rem; font-weight:500">@selectedSound.FileName</span><br/>
                    <span style="font-size:0.75rem; color:var(--rz-secondary)">@FormatFileSize(selectedSound.FileSize)</span>
                  </div>
                </div>
              }
            }
            else
            {
              <RadzenAlert AlertStyle="AlertStyle.Info" Size="AlertSize.Small" AllowClose="false">
                Click "Browse Files" to select an audio file
              </RadzenAlert>
            }

            <div style="display:flex; gap:8px; margin-top:12px">
              <RadzenButton Variant="Variant.Outlined" ButtonStyle="ButtonStyle.Primary"
                            Icon="folder_open" Click="OpenFileSelectionDialogAsync" Text="Browse Files" />
              <RadzenButton Variant="Variant.Filled" ButtonStyle="ButtonStyle.Primary"
                            Icon="play_arrow" Click="PlayFileEventAsync"
                            Disabled="@(string.IsNullOrWhiteSpace(_selectedSoundFile))" Text="Play" />
            </div>
          </RadzenCard>
        </RadzenColumn>

        <!-- Active Event Sources -->
        <RadzenColumn Size="12">
          <RadzenCard>
            <div style="display:flex; align-items:center; justify-content:space-between; margin-bottom:12px">
              <h6 style="margin:0">Active Event Sources</h6>
              <RadzenButton Icon="refresh" ButtonStyle="ButtonStyle.Primary" Variant="Variant.Text" Click="LoadEventSourcesAsync" />
            </div>
            @if (_eventSources != null && _eventSources.Count > 0)
            {
              <table class="rz-datatable" style="width:100%">
                <thead>
                  <tr>
                    <th>Name</th>
                    <th>Type</th>
                    <th>State</th>
                    <th>Volume</th>
                    <th>Metadata</th>
                    <th style="width: 100px;">Actions</th>
                  </tr>
                </thead>
                <tbody>
                  @foreach (var source in _eventSources)
                  {
                    <tr>
                      <td><strong>@source.Name</strong></td>
                      <td>@source.Type</td>
                      <td><RadzenBadge Text="@source.State" BadgeStyle="@GetStateBadgeStyle(source.State)" /></td>
                      <td>@source.Volume.ToString("P0")</td>
                      <td>
                        @if (source.Metadata != null && source.Metadata.Count > 0)
                        {
                          <span style="font-size:0.75rem; color:var(--text-low)">@string.Join(", ", source.Metadata.Select(m => $"{m.Key}: {m.Value}"))</span>
                        }
                        else
                        {
                          <span style="font-size:0.75rem; color:var(--text-low)">None</span>
                        }
                      </td>
                      <td>
                        <RadzenButton Icon="replay" ButtonStyle="ButtonStyle.Primary" Variant="Variant.Text" Size="ButtonSize.Small"
                                      Click="@(() => ReplayEventAsync(source))" title="Replay this event" />
                      </td>
                    </tr>
                  }
                </tbody>
              </table>
            }
            else if (_eventSourcesLoading)
            {
              <RadzenProgressBarCircular ProgressBarStyle="ProgressBarStyle.Primary" Mode="ProgressBarMode.Indeterminate" />
            }
            else
            {
              <RadzenAlert AlertStyle="AlertStyle.Info" AllowClose="false">No event sources currently active.</RadzenAlert>
            }
          </RadzenCard>
        </RadzenColumn>
      </RadzenRow>
    </RadzenTabsItem>

    <!-- Tab 5: Preferences -->
    <RadzenTabsItem Text="Preferences" Icon="settings">
      <RadzenTabs>
        <Tabs>

        <!-- Audio Preferences -->
        <RadzenTabsItem Text="Audio">
          @if (_audioPreferences != null)
          {
            <RadzenRow Gap="0.5rem">
              <RadzenColumn Size="12">
                <RadzenAlert AlertStyle="AlertStyle.Info" Size="AlertSize.Small" AllowClose="false">
                  Audio preferences control the default audio source and master volume settings.
                </RadzenAlert>
              </RadzenColumn>
              <RadzenColumn Size="12" SizeMD="6">
                <RadzenDropDown TValue="string" @bind-Value="_audioPreferences.CurrentSource" Data="@_currentSourceOptions"
                                TextProperty="Text" ValueProperty="Value" Placeholder="Current Source" Style="width:100%" />
                <small>Currently active audio source</small>
              </RadzenColumn>
              <RadzenColumn Size="12" SizeMD="6">
                <RadzenNumeric TValue="int" @bind-Value="_audioPreferences.MasterVolume" Min="0" Max="100" Placeholder="Master Volume" Style="width:100%" />
                <small>Master volume level (0-100)</small>
              </RadzenColumn>
              <!-- Source Visibility -->
              <RadzenColumn Size="12" SizeMD="6">
                <div style="display:flex;align-items:center;gap:8px">
                  <RadzenSwitch Value="@(!_audioPreferences.HiddenSources.Contains("TestTone", StringComparer.OrdinalIgnoreCase))"
                                Change="@((bool v) => OnTestToneVisibilityChanged(v))" />
                  <span>Show Test Tone source</span>
                </div>
              </RadzenColumn>
              <!-- Source Gain Levels -->
              <RadzenColumn Size="12">
                <strong style="display:block; margin-top:16px; margin-bottom:8px">Source Levels</strong>
                <RadzenAlert AlertStyle="AlertStyle.Info" Size="AlertSize.Small" AllowClose="false" Style="margin-bottom:8px">
                  Adjust gain per source to compensate for volume differences. 0dB = unity (no change). Range: -inf to +6dB.
                </RadzenAlert>
              </RadzenColumn>
              @foreach (var kvp in _sourceGainLabels)
              {
                <RadzenColumn Size="12" SizeMD="6">
                  <div style="display: flex; align-items: center; gap: 8px;">
                    <span style="min-width: 90px; font-size: 14px;">@kvp.Value</span>
                    <RadzenSlider TValue="float" Value="@GetSourceGainValue(kvp.Key)"
                                  Change="@((float v) => OnSourceGainChanged(kvp.Key, v))"
                                  Min="(decimal)0.0f" Max="(decimal)2.0f" Step="(decimal)0.05f" Style="flex: 1;" />
                    <span style="min-width: 50px; font-family: var(--font-mono); font-size: 12px; text-align: right;">
                      @FormatGainDb(GetSourceGainValue(kvp.Key))
                    </span>
                  </div>
                </RadzenColumn>
              }
              <RadzenColumn Size="12">
                <RadzenButton Variant="Variant.Filled" ButtonStyle="ButtonStyle.Primary" Click="SaveAudioPreferencesAsync"
                              Icon="save" Disabled="@_isSaving" Text="Save Audio Preferences" />
              </RadzenColumn>
            </RadzenRow>
          }
          else
          {
            <RadzenProgressBarCircular ProgressBarStyle="ProgressBarStyle.Primary" Size="ProgressBarCircularSize.Small" Mode="ProgressBarMode.Indeterminate" />
            <span style="margin-left:8px">Loading audio preferences...</span>
          }
        </RadzenTabsItem>

        <!-- File Player Preferences -->
        <RadzenTabsItem Text="File Player">
          @if (_filePlayerPreferences != null)
          {
            <RadzenRow Gap="0.5rem">
              <RadzenColumn Size="12">
                <RadzenAlert AlertStyle="AlertStyle.Info" Size="AlertSize.Small" AllowClose="false">
                  File Player preferences store the last played file and playback state.
                </RadzenAlert>
              </RadzenColumn>
              <RadzenColumn Size="12">
                <RadzenTextBox @bind-Value="_filePlayerPreferences.LastSongPlayed" Placeholder="Last Song Played (Path)" Style="width:100%" />
                <small>File path of last played track</small>
              </RadzenColumn>
              <RadzenColumn Size="12" SizeMD="4">
                <RadzenNumeric TValue="long" @bind-Value="_filePlayerPreferences.SongPositionMs" Min="0" Placeholder="Position (ms)" Style="width:100%" />
                <small>Last playback position in milliseconds</small>
              </RadzenColumn>
              <RadzenColumn Size="12" SizeMD="4">
                <div style="display:flex;align-items:center;gap:8px"><RadzenCheckBox TValue="bool" @bind-Value="_filePlayerPreferences.Shuffle" /><span>Shuffle</span></div>
              </RadzenColumn>
              <RadzenColumn Size="12" SizeMD="4">
                <RadzenDropDown TValue="string" @bind-Value="_filePlayerPreferences.Repeat" Data="@_repeatModeOptions"
                                TextProperty="Text" ValueProperty="Value" Placeholder="Repeat Mode" Style="width:100%" />
              </RadzenColumn>
              <RadzenColumn Size="12">
                <RadzenButton Variant="Variant.Filled" ButtonStyle="ButtonStyle.Primary" Click="SaveFilePlayerPreferencesAsync"
                              Icon="save" Disabled="@_isSaving" Text="Save File Player Preferences" />
              </RadzenColumn>
            </RadzenRow>
          }
          else
          {
            <RadzenProgressBarCircular ProgressBarStyle="ProgressBarStyle.Primary" Size="ProgressBarCircularSize.Small" Mode="ProgressBarMode.Indeterminate" />
            <span style="margin-left:8px">Loading File Player preferences...</span>
          }
        </RadzenTabsItem>

        <!-- Radio Preferences -->
        <RadzenTabsItem Text="Radio">
          @if (_radioPreferences != null)
          {
            <RadzenRow Gap="0.5rem">
              <RadzenColumn Size="12">
                <RadzenAlert AlertStyle="AlertStyle.Info" Size="AlertSize.Small" AllowClose="false">
                  Radio preferences store the last tuned frequency and band.
                </RadzenAlert>
              </RadzenColumn>
              <RadzenColumn Size="12" SizeMD="6">
                <RadzenNumeric TValue="float" @bind-Value="_radioPreferences.LastFrequency" Min="0" Placeholder="Last Frequency (MHz)" Style="width:100%" />
                <small>Last tuned frequency</small>
              </RadzenColumn>
              <RadzenColumn Size="12" SizeMD="6">
                <RadzenDropDown TValue="string" @bind-Value="_radioPreferences.LastBand" Data="@_radioBandOptions"
                                TextProperty="Text" ValueProperty="Value" Placeholder="Last Band" Style="width:100%" />
              </RadzenColumn>
              <RadzenColumn Size="12">
                <RadzenTextBox @bind-Value="_radioPreferences.LastEQMode" Placeholder="Last EQ Mode" Style="width:100%" />
                <small>Last equalizer mode (optional)</small>
              </RadzenColumn>
              <RadzenColumn Size="12">
                <RadzenButton Variant="Variant.Filled" ButtonStyle="ButtonStyle.Primary" Click="SaveRadioPreferencesAsync"
                              Icon="save" Disabled="@_isSaving" Text="Save Radio Preferences" />
              </RadzenColumn>
            </RadzenRow>
          }
          else
          {
            <RadzenProgressBarCircular ProgressBarStyle="ProgressBarStyle.Primary" Size="ProgressBarCircularSize.Small" Mode="ProgressBarMode.Indeterminate" />
            <span style="margin-left:8px">Loading Radio preferences...</span>
          }
        </RadzenTabsItem>

        <!-- Generic Source Preferences -->
        <RadzenTabsItem Text="Generic Source">
          @if (_genericSourcePreferences != null)
          {
            <RadzenRow Gap="0.5rem">
              <RadzenColumn Size="12">
                <RadzenAlert AlertStyle="AlertStyle.Info" Size="AlertSize.Small" AllowClose="false">
                  Generic Source preferences for USB-based audio sources.
                </RadzenAlert>
              </RadzenColumn>
              <RadzenColumn Size="12">
                <RadzenTextBox @bind-Value="_genericSourcePreferences.USBPort" Placeholder="Generic USB Audio Device" Style="width:100%" />
                <small>USB audio device name pattern (e.g., AB13X)</small>
              </RadzenColumn>
              <RadzenColumn Size="12">
                <RadzenButton Variant="Variant.Filled" ButtonStyle="ButtonStyle.Primary" Click="SaveGenericSourcePreferencesAsync"
                              Icon="save" Disabled="@_isSaving" Text="Save Generic Source Preferences" />
              </RadzenColumn>
            </RadzenRow>
          }
          else
          {
            <RadzenProgressBarCircular ProgressBarStyle="ProgressBarStyle.Primary" Size="ProgressBarCircularSize.Small" Mode="ProgressBarMode.Indeterminate" />
            <span style="margin-left:8px">Loading Generic Source preferences...</span>
          }
        </RadzenTabsItem>

        </Tabs>
      </RadzenTabs>
    </RadzenTabsItem>

    <!-- Tab 6: Secrets -->
    <RadzenTabsItem Text="Secrets" Icon="lock">
      <div style="max-width: 720px;">
      <RadzenAlert AlertStyle="AlertStyle.Warning" Size="AlertSize.Small" AllowClose="false" Style="margin-bottom:12px">
        <strong>Security Notice:</strong> Secrets are sensitive credentials, encrypted server-side. A stored secret is never
        sent back to this page - reads return a mask only - so what you see here is a status, not the value.
        Secrets must be explicitly saved using the "Save Secrets" button (not auto-saved). Only enter secrets in secure environments.
      </RadzenAlert>

      <RadzenTabs>
        <Tabs>

        <!-- TTS Secrets -->
        <RadzenTabsItem Text="TTS Services">
          @if (_ttsSecretStatus != null)
          {
            <RadzenRow Gap="0.5rem">
              <RadzenColumn Size="12">
                <RadzenAlert AlertStyle="AlertStyle.Info" Size="AlertSize.Small" AllowClose="false">
                  API keys for cloud-based Text-to-Speech services. Optional - only needed if using Google or Azure TTS.
                  A stored key is never sent back to this page, so every box below starts empty. Type in a box only to
                  <strong>replace</strong> what is stored; leave it empty to keep the stored value, and use
                  <strong>Clear</strong> to remove one.
                </RadzenAlert>
              </RadzenColumn>

              <RadzenColumn Size="12">
                <div style="display:flex; align-items:center; gap:8px; margin-bottom:2px;">
                  <strong>Google API Key</strong>
                  <RadzenBadge BadgeStyle="@SecretBadgeStyle(_ttsSecretStatus.GoogleAPIKey)" IsPill="true"
                               Text="@SecretBadgeText(_ttsSecretStatus.GoogleAPIKey)" />
                </div>
                <div class="secret-field secret-field-google @SecretFieldClass(_ttsSecretStatus.GoogleAPIKey)" style="display:flex; align-items:center; gap:4px;">
                  @if (_showGoogleApiKey)
                  {
                    <RadzenTextBox @bind-Value="_googleApiKeyInput" Placeholder="@GoogleApiKeyPlaceholder" Style="flex:1" />
                  }
                  else
                  {
                    <RadzenPassword @bind-Value="_googleApiKeyInput" Placeholder="@GoogleApiKeyPlaceholder" Style="flex:1" />
                  }
                  @* Not disabled on an empty box: Radzen inputs write their bound value on change,
                     i.e. on blur, so a disabled-when-empty button would swallow the first click -
                     the blur that fills the field is the same interaction that would enable it. *@
                  <RadzenButton Icon="@(_showGoogleApiKey ? "visibility_off" : "visibility")" Variant="Variant.Text" ButtonStyle="ButtonStyle.Light"
                                Click="@(() => _showGoogleApiKey = !_showGoogleApiKey)" />
                  <RadzenButton Icon="backspace" Variant="Variant.Text" ButtonStyle="ButtonStyle.Danger" Size="ButtonSize.Small"
                                Disabled="@(_isSaving || !IsSecretStored(_ttsSecretStatus.GoogleAPIKey))"
                                Click="ClearGoogleApiKeyAsync" Text="Clear" />
                </div>
                <small>Google Cloud Text-to-Speech API key. The eye button shows what you have typed here - it cannot show the stored key.</small>
              </RadzenColumn>

              <RadzenColumn Size="12">
                <div style="display:flex; align-items:center; gap:8px; margin-bottom:2px;">
                  <strong>Azure API Key</strong>
                  <RadzenBadge BadgeStyle="@SecretBadgeStyle(_ttsSecretStatus.AzureAPIKey)" IsPill="true"
                               Text="@SecretBadgeText(_ttsSecretStatus.AzureAPIKey)" />
                </div>
                <div class="secret-field secret-field-azure-key @SecretFieldClass(_ttsSecretStatus.AzureAPIKey)" style="display:flex; align-items:center; gap:4px;">
                  @if (_showAzureApiKey)
                  {
                    <RadzenTextBox @bind-Value="_azureApiKeyInput" Placeholder="@AzureApiKeyPlaceholder" Style="flex:1" />
                  }
                  else
                  {
                    <RadzenPassword @bind-Value="_azureApiKeyInput" Placeholder="@AzureApiKeyPlaceholder" Style="flex:1" />
                  }
                  @* See the note on the Google toggle: not disabled when the box is empty. *@
                  <RadzenButton Icon="@(_showAzureApiKey ? "visibility_off" : "visibility")" Variant="Variant.Text" ButtonStyle="ButtonStyle.Light"
                                Click="@(() => _showAzureApiKey = !_showAzureApiKey)" />
                  <RadzenButton Icon="backspace" Variant="Variant.Text" ButtonStyle="ButtonStyle.Danger" Size="ButtonSize.Small"
                                Disabled="@(_isSaving || !IsSecretStored(_ttsSecretStatus.AzureAPIKey))"
                                Click="ClearAzureApiKeyAsync" Text="Clear" />
                </div>
                <small>Azure Cognitive Services Speech API key. The eye button shows what you have typed here - it cannot show the stored key.</small>
              </RadzenColumn>

              <RadzenColumn Size="12">
                <div style="display:flex; align-items:center; gap:8px; margin-bottom:2px;">
                  <strong>Azure Region</strong>
                  <RadzenBadge BadgeStyle="@SecretBadgeStyle(_ttsSecretStatus.AzureRegion)" IsPill="true"
                               Text="@SecretBadgeText(_ttsSecretStatus.AzureRegion)" />
                </div>
                <div class="secret-field secret-field-azure-region @SecretFieldClass(_ttsSecretStatus.AzureRegion)" style="display:flex; align-items:center; gap:4px;">
                  <RadzenTextBox @bind-Value="_azureRegionInput" Placeholder="@AzureRegionPlaceholder" Style="flex:1" />
                  <RadzenButton Icon="backspace" Variant="Variant.Text" ButtonStyle="ButtonStyle.Danger" Size="ButtonSize.Small"
                                Disabled="@(_isSaving || !IsSecretStored(_ttsSecretStatus.AzureRegion))"
                                Click="ClearAzureRegionAsync" Text="Clear" />
                </div>
                <small>Azure region (e.g., eastus, westus2). Stored alongside the keys, so it is masked on read like they are.</small>
              </RadzenColumn>

              <RadzenColumn Size="12">
                <div style="display:flex; gap:8px">
                  <RadzenButton Variant="Variant.Filled" ButtonStyle="ButtonStyle.Primary" Click="SaveTTSSecretsAsync"
                                Icon="save" Disabled="@_isSaving" Text="Save Secrets" />
                  <RadzenButton Variant="Variant.Outlined" ButtonStyle="ButtonStyle.Danger" Click="ClearTTSSecretsAsync"
                                Icon="delete_forever" Disabled="@_isSaving" Text="Clear All" />
                </div>
              </RadzenColumn>
            </RadzenRow>
          }
          else
          {
            <RadzenProgressBarCircular ProgressBarStyle="ProgressBarStyle.Primary" Size="ProgressBarCircularSize.Small" Mode="ProgressBarMode.Indeterminate" />
            <span style="margin-left:8px">Loading TTS secrets...</span>
          }
        </RadzenTabsItem>

        </Tabs>
      </RadzenTabs>
      </div>
    </RadzenTabsItem>

    <!-- Tab 7: Store Management -->
    <RadzenTabsItem Text="Store Management" Icon="storage">
      <div style="display:flex; flex-direction:column; gap:12px">

        <!-- Store Info Section -->
        <RadzenCard>
          <h6 style="margin-bottom:12px">Current Store Information</h6>
          @if (_storeInfo != null)
          {
            <RadzenRow>
              <RadzenColumn Size="12" SizeMD="6">
                <span><strong>Store Type:</strong> @_storeInfo.StoreType</span>
              </RadzenColumn>
              <RadzenColumn Size="12" SizeMD="6">
                <span><strong>Entry Count:</strong> @_storeInfo.EntryCount</span>
              </RadzenColumn>
              <RadzenColumn Size="12" SizeMD="6">
                <span><strong>Size:</strong> @FormatBytes(_storeInfo.SizeBytes)</span>
              </RadzenColumn>
              <RadzenColumn Size="12" SizeMD="6">
                <span><strong>Last Modified:</strong> @(_storeInfo.LastModified?.ToString("g") ?? "N/A")</span>
              </RadzenColumn>
              <RadzenColumn Size="12">
                <span style="font-size:0.75rem; color:var(--text-low)">@_storeInfo.Location</span>
              </RadzenColumn>
            </RadzenRow>
          }
          else
          {
            <div style="display:flex; flex-direction:row; align-items:center">
              <RadzenProgressBarCircular Size="ProgressBarCircularSize.Small" Mode="ProgressBarMode.Indeterminate" />
              <span style="margin-left:8px">Loading store information...</span>
            </div>
          }
        </RadzenCard>

        <!-- Import/Export Section -->
        <RadzenCard>
          <h6 style="margin-bottom:12px">Import / Export</h6>
          <div style="display:flex; flex-direction:row; gap:8px">
            <RadzenButton Variant="Variant.Filled" ButtonStyle="ButtonStyle.Primary"
                          Click="@(() => ExportConfigurationAsync("json"))"
                          Icon="download" Text="Export JSON" />
            <RadzenButton Variant="Variant.Filled" ButtonStyle="ButtonStyle.Secondary"
                          Click="@(() => ExportConfigurationAsync("radiobak"))"
                          Icon="download" Text="Export Backup" />
            <label style="display:inline-flex; cursor:pointer;">
              <InputFile OnChange="ImportConfigurationFromInputFileAsync" accept=".json,.radiobak" style="display:none" />
              <RadzenButton Variant="Variant.Filled" ButtonStyle="ButtonStyle.Info"
                            Icon="upload" Text="Import" Style="pointer-events:none" />
            </label>
          </div>
        </RadzenCard>

        <!-- Store Comparison Section -->
        <RadzenCard>
          <div style="display:flex; flex-direction:row; align-items:center; margin-bottom:12px">
            <h6 style="margin:0">Store Comparison</h6>
            <div style="flex:1"></div>
            <RadzenButton Variant="Variant.Outlined" ButtonStyle="ButtonStyle.Primary"
                          Click="LoadStoreComparisonAsync"
                          Icon="refresh" Disabled="@_isLoadingComparison" Text="Refresh" />
          </div>

          @if (_comparison != null)
          {
            <RadzenAlert AlertStyle="AlertStyle.Info" Size="AlertSize.Small" AllowClose="false" Style="margin-bottom:12px">
              JSON: @_comparison.JsonEntryCount entries | SQLite: @_comparison.SqliteEntryCount entries |
              Differences: @_comparison.Differences.Count(d => d.Status != "Same")
            </RadzenAlert>

            @if (_comparison.Differences.Any(d => d.Status != "Same"))
            {
              <div style="display:flex; flex-direction:row; gap:8px; margin-bottom:8px; flex-wrap:wrap">
                <RadzenButton Variant="Variant.Filled" ButtonStyle="ButtonStyle.Primary" Size="ButtonSize.Small"
                              Click="@(() => ReconcileSelectedAsync("json", "sqlite"))"
                              Disabled="@(!_selectedDifferences.Any() || _isSaving)"
                              Text="@($"Copy JSON -> SQLite ({_selectedDifferences.Count})")" />
                <RadzenButton Variant="Variant.Filled" ButtonStyle="ButtonStyle.Secondary" Size="ButtonSize.Small"
                              Click="@(() => ReconcileSelectedAsync("sqlite", "json"))"
                              Disabled="@(!_selectedDifferences.Any() || _isSaving)"
                              Text="@($"Copy SQLite -> JSON ({_selectedDifferences.Count})")" />
                <RadzenButton Variant="Variant.Outlined" ButtonStyle="ButtonStyle.Light" Size="ButtonSize.Small"
                              Click="SelectAllDifferences" Text="Select All Differences" />
                <RadzenButton Variant="Variant.Outlined" ButtonStyle="ButtonStyle.Light" Size="ButtonSize.Small"
                              Click="ClearSelection" Text="Clear Selection" />
              </div>

              <div style="height:400px; overflow-y:auto">
                <table class="rz-datatable" style="width:100%">
                  <thead>
                    <tr>
                      <th style="width:50px"></th>
                      <th>Key</th>
                      <th>JSON Value</th>
                      <th>SQLite Value</th>
                      <th>Status</th>
                    </tr>
                  </thead>
                  <tbody>
                    @foreach (var diff in _comparison.Differences)
                    {
                      <tr>
                        <td>
                          @if (diff.Status != "Same")
                          {
                            <RadzenCheckBox TValue="bool"
                                            Value="@_selectedDifferences.Contains(diff.Key)"
                                            Change="@((bool val) => ToggleDifferenceSelection(diff.Key, val))" />
                          }
                        </td>
                        <td><span style="font-size:0.75rem; color:var(--text-low)">@diff.Key</span></td>
                        <td><span style="font-size:0.75rem; color:var(--text-low)">@(diff.JsonValue ?? "-")</span></td>
                        <td><span style="font-size:0.75rem; color:var(--text-low)">@(diff.SqliteValue ?? "-")</span></td>
                        <td><RadzenBadge Text="@diff.Status" BadgeStyle="@GetStatusBadgeStyle(diff.Status)" /></td>
                      </tr>
                    }
                  </tbody>
                </table>
              </div>
            }
            else
            {
              <RadzenAlert AlertStyle="AlertStyle.Success" AllowClose="false">
                All configuration entries are in sync between JSON and SQLite stores.
              </RadzenAlert>
            }
          }
          else if (_isLoadingComparison)
          {
            <RadzenProgressBarCircular Size="ProgressBarCircularSize.Small" Mode="ProgressBarMode.Indeterminate" />
            <span style="margin-left:8px">Loading comparison...</span>
          }
          else
          {
            <span>Click Refresh to compare stores</span>
          }
        </RadzenCard>

      </div>
    </RadzenTabsItem>

    <!-- Tab 8: Integrations -->
    <RadzenTabsItem Text="Integrations" Icon="extension">
      <RadzenTabs SelectedIndex="@_integrationsSubTab" Change="@OnIntegrationsSubTabChanged">
        <Tabs>

        <!-- Sub-tab 1: Rotary Encoders -->
        <RadzenTabsItem Text="Rotary Encoders" Icon="tune">
          @* encoder-settings-panel is a structural hook for the bUnit fixture, not a style: Radzen
             renders only the selected tab's body, so every test asserting that an affordance is
             ABSENT from this panel needs to first prove the panel rendered at all. Keyed to this
             class rather than to a card heading because the headings are copy, and renaming one
             would silently turn those assertions back into vacuous ones. No CSS rule targets it. *@
          <div class="encoder-settings-panel" style="display:flex; flex-direction:column; gap:12px">
            <!-- Status -->
            <RadzenCard>
              <h6 style="margin-bottom:12px">Encoder Status</h6>
              @if (_encoderStatus != null)
              {
                <RadzenRow>
                  <RadzenColumn Size="12" SizeMD="6">
                    <div style="display:flex; flex-direction:row; gap:8px; align-items:center">
                      <span><strong>Connection:</strong></span>
                      @if (!_encoderStatus.Enabled)
                      {
                        <RadzenBadge Text="Disabled" BadgeStyle="BadgeStyle.Light" />
                      }
                      else if (_encoderStatus.IsConnected)
                      {
                        <RadzenBadge Text="Connected" BadgeStyle="BadgeStyle.Success" />
                      }
                      else
                      {
                        <RadzenBadge Text="Disconnected" BadgeStyle="BadgeStyle.Danger" />
                      }
                    </div>
                  </RadzenColumn>
                  @if (_encoderStatus.Enabled)
                  {
                    <RadzenColumn Size="12" SizeMD="6">
                      <span><strong>VID/PID:</strong> 0x@(_encoderStatus.VendorId.ToString("X4")):0x@(_encoderStatus.ProductId.ToString("X4"))</span>
                    </RadzenColumn>
                    @if (!string.IsNullOrEmpty(_encoderStatus.DevicePath))
                    {
                      <RadzenColumn Size="12">
                        <span style="font-size:0.75rem; color:var(--text-low)"><strong>Device:</strong> @_encoderStatus.DevicePath</span>
                      </RadzenColumn>
                    }
                  }
                  @if (_encoderProvisioning != null && _encoderProvisioning.Enabled)
                  {
                    <RadzenColumn Size="12" SizeMD="6">
                      <div style="display:flex; flex-direction:row; gap:8px; align-items:center">
                        <span><strong>Configuration:</strong></span>
                        <RadzenBadge Text="@EncoderTierText(_encoderProvisioning.Status)"
                                     BadgeStyle="@EncoderTierBadge(_encoderProvisioning.Status)" />
                        @if (_encoderProvisioning.LastVerifiedUtc is { } verified)
                        {
                          @* "verified" means a read-back MATCHED at this time. LastVerifiedUtc is set
                             nowhere else — see the ENC-8 plan §0.5. *@
                          <span style="font-size:0.75rem; color:var(--text-low)">
                            verified @verified.ToLocalTime().ToString("yyyy-MM-dd HH:mm:ss")
                          </span>
                        }
                        else
                        {
                          <span style="font-size:0.75rem; color:var(--text-low)">never verified</span>
                        }
                      </div>
                    </RadzenColumn>
                    <RadzenColumn Size="12">
                      <div style="display:flex; flex-direction:row; gap:8px; align-items:center">
                        <span><strong>Saved to device:</strong></span>
                        @if (_encoderProvisioning.LastSavedToDeviceUtc is { } saved)
                        {
                          <span>@saved.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</span>
                        }
                        <span style="color:@EncoderFlashColor(_encoderProvisioning.Flash)">
                          @EncoderFlashText(_encoderProvisioning.Flash)
                        </span>
                      </div>
                    </RadzenColumn>
                  }
                </RadzenRow>
              }
              else
              {
                <RadzenProgressBarCircular Size="ProgressBarCircularSize.Small" Mode="ProgressBarMode.Indeterminate" />
              }
            </RadzenCard>

            <!-- Device configuration — read-only by design (handoff §7.8 card 2). These numbers are a
                 designed feel derived against the FM channel grid (§5.5) and a volume-safety budget
                 (§5.4), not preferences. The one editable field is Reverse, in its own card below. -->
            <RadzenCard>
              <h6 style="margin-bottom:12px">Device configuration</h6>
              @if (_encoderProvisioning == null)
              {
                <RadzenProgressBarCircular Size="ProgressBarCircularSize.Small" Mode="ProgressBarMode.Indeterminate" />
              }
              else if (_encoderProvisioning.Fields.Count == 0)
              {
                <span style="color:var(--text-low)">
                  No configuration has been pushed on this connection yet.
                </span>
              }
              else
              {
                <table class="rz-datatable encoder-config-table" style="width:100%; max-width:900px">
                  <thead>
                    <tr>
                      <th>Knob</th><th>Step</th><th>Wrap</th><th>Direction</th>
                      <th>Tier 1</th><th>Tier 2</th><th>Tier 3</th><th>Device</th>
                    </tr>
                  </thead>
                  <tbody>
                    @for (int i = 0; i < 4; i++)
                    {
                      var idx = i;
                      <tr>
                        <td><strong>@EncoderCabinetName(idx)</strong> <span style="color:var(--text-low)">· knob @(idx + 1)</span></td>
                        <td>@FieldValue(idx, "step_size")</td>
                        <td>@FieldValue(idx, "wrap")</td>
                        <td>@(FieldValue(idx, "reverse") == "True" ? "Reversed" : "Normal")</td>
                        <td>@TierText(idx, 1)</td>
                        <td>@TierText(idx, 2)</td>
                        <td>@TierText(idx, 3)</td>
                        <td>@RowAgreementText(idx)</td>
                      </tr>
                    }
                  </tbody>
                </table>

                @* Fields the six columns above do not show — min_value, max_value, steps_per_detent —
                   are still compared by the verifier. A mismatch on one of them must not be invisible
                   just because the table has no column for it. *@
                @if (OffTableMismatches().Any())
                {
                  <div style="margin-top:8px; font-size:0.75rem; color:var(--signal-amber)">
                    Also disagreeing: @string.Join(", ", OffTableMismatches())
                  </div>
                }
              }
            </RadzenCard>

            <!-- Direction -->
            <RadzenCard>
              <h6 style="margin-bottom:4px">Direction</h6>
              <small style="color:var(--text-low); display:block; margin-bottom:12px">
                Turn a knob clockwise and the value should go up. If one goes the wrong way, reverse it
                here — this depends on how that knob was wired, not on preference. Changing one sends it
                to the knobs straight away.
              </small>
              @if (_encoderProvisioning is { Enabled: true })
              {
                <RadzenRow>
                  @for (int i = 0; i < 4; i++)
                  {
                    var idx = i;
                    <RadzenColumn Size="6" SizeMD="3">
                      <div style="display:flex; align-items:center; gap:8px">
                        <RadzenSwitch Value="@(FieldValue(idx, "reverse") == "True")"
                                      Disabled="@(_encoderBusy || !_encoderProvisioning.IsConnected)"
                                      Change="@(async (bool v) => await SetEncoderReverseAsync(idx, v))" />
                        <span>@EncoderCabinetName(idx)</span>
                      </div>
                    </RadzenColumn>
                  }
                </RadzenRow>
              }
            </RadzenCard>

            <!-- Actions -->
            <RadzenCard>
              <h6 style="margin-bottom:12px">Actions</h6>
              <div style="display:flex; flex-direction:row; gap:12px; flex-wrap:wrap; align-items:flex-start">
                <div style="display:flex; flex-direction:column; gap:4px; max-width:320px">
                  <RadzenButton Variant="Variant.Filled" ButtonStyle="ButtonStyle.Primary" Icon="save"
                                Text="Save to device"
                                Disabled="@(_encoderBusy || _encoderProvisioning?.IsConnected != true)"
                                Click="SaveEncoderToDeviceAsync" />
                  @* Handoff §7.8, verbatim. It says what it writes, and because Rev 3 dropped the
                     "safe baseline" what it writes is what is on screen. If a future revision
                     reintroduces any divergence, this copy has to change with it and the reviewer
                     should treat a mismatch as a defect. *@
                  <small style="color:var(--text-low)">
                    Saves the settings above to the knobs so they work the same way even if the app is restarting.
                  </small>
                </div>
                <div style="display:flex; flex-direction:column; gap:4px; max-width:320px">
                  <RadzenButton Variant="Variant.Outlined" ButtonStyle="ButtonStyle.Primary" Icon="refresh"
                                Text="Re-apply settings"
                                Disabled="@(_encoderBusy || _encoderProvisioning?.IsConnected != true)"
                                Click="ReapplyEncoderAsync" />
                  <small style="color:var(--text-low)">
                    Sends the settings to the knobs again and checks they took. Does not change what is saved on the device.
                  </small>
                </div>
                <div style="display:flex; flex-direction:column; gap:4px; max-width:320px">
                  <RadzenButton Variant="Variant.Outlined" ButtonStyle="ButtonStyle.Light" Icon="restart_alt"
                                Text="Reset counters"
                                Disabled="@(_encoderBusy || _encoderProvisioning?.IsConnected != true)"
                                Click="ResetEncoderCountersAsync" />
                  <small style="color:var(--text-low)">
                    Zeroes the movement counters the knobs keep. Nothing on this page shows them yet.
                  </small>
                </div>
              </div>
            </RadzenCard>

            <!-- Encoder Mapping Reference -->
            <RadzenCard>
              <h6 style="margin-bottom:12px">Encoder Mapping</h6>
              <table class="rz-datatable" style="max-width: 600px;">
                <thead>
                  <tr>
                    <th>Encoder</th>
                    <th>Turn</th>
                    <th>Press</th>
                  </tr>
                </thead>
                <tbody>
                  @foreach (var m in _encoderMapping ?? [])
                  {
                    <tr>
                      <td>@(m.EncoderIndex) — @m.CabinetName</td>
                      <td>@m.TurnDescription</td>
                      <td>@m.PressDescription</td>
                    </tr>
                  }
                </tbody>
              </table>
              @* The engraved order and the software mapping genuinely disagree right now. Rendering
                 only one of them would assert something false, so the page states it. Computed from
                 the two orders rather than written down, so it vanishes by itself when ENC-5 / ENC-7
                 remap the router and never becomes a stale warning about a fixed problem. *@
              @if (MappingDisagreesWithCabinet())
              {
                <div style="margin-top:8px; font-size:0.75rem; color:var(--signal-amber)">
                  These are what the software does today. They do not all match the labels on the
                  cabinet yet — the SOURCE, PRESETS and TUNING knobs are still wired to the older
                  order in software. VOLUME is correct.
                </div>
              }
            </RadzenCard>

            <!-- Connection settings -->
            <RadzenCard>
              <div style="display:flex; flex-direction:row; align-items:center; margin-bottom:12px">
                <h6 style="margin:0">Connection settings</h6>
                <div style="flex:1"></div>
                <RadzenButton Variant="Variant.Filled" ButtonStyle="ButtonStyle.Primary"
                              Click="SaveEncoderConfigAsync" Icon="save"
                              Disabled="@(_isSaving || _encoderConfig == null)" Text="Save connection settings" />
              </div>
              @if (_encoderConfig != null)
              {
                <RadzenRow>
                  <RadzenColumn Size="12" SizeMD="4">
                    <div style="display:flex;align-items:center;gap:8px">
                      <RadzenSwitch @bind-Value="_encoderConfig.Enabled" />
                      <span>Enabled</span>
                    </div>
                  </RadzenColumn>
                  <RadzenColumn Size="6" SizeMD="4">
                    <RadzenNumeric TValue="int" @bind-Value="_encoderConfig.VendorId" Placeholder="Vendor ID (hex)" Style="width:100%" />
                    <small>e.g. 51966 = 0xCAFE</small>
                  </RadzenColumn>
                  <RadzenColumn Size="6" SizeMD="4">
                    <RadzenNumeric TValue="int" @bind-Value="_encoderConfig.ProductId" Placeholder="Product ID (hex)" Style="width:100%" />
                    <small>e.g. 16389 = 0x4005</small>
                  </RadzenColumn>
                  <RadzenColumn Size="12" SizeMD="6">
                    <RadzenTextBox @bind-Value="_encoderConfig.DevicePath" Placeholder="Device Path" Style="width:100%" />
                    <small>Leave empty for auto-detect</small>
                  </RadzenColumn>
                  <RadzenColumn Size="6" SizeMD="3">
                    <RadzenNumeric TValue="int" @bind-Value="_encoderConfig.PollIntervalMs" Min="1" Max="1000" Placeholder="Poll Interval (ms)" Style="width:100%" />
                  </RadzenColumn>
                  <RadzenColumn Size="6" SizeMD="3">
                    <RadzenNumeric TValue="int" @bind-Value="_encoderConfig.ReconnectDelayMs" Min="500" Max="30000" Placeholder="Reconnect Delay (ms)" Style="width:100%" />
                  </RadzenColumn>
                </RadzenRow>
              }
              else
              {
                <span>Loading configuration...</span>
              }
            </RadzenCard>
          </div>
        </RadzenTabsItem>

        <!-- Sub-tab 2: Phone Integration -->
        <RadzenTabsItem Text="Phone Integration" Icon="phone">
          <div style="display:flex; flex-direction:column; gap:12px">
            <!-- Status -->
            <RadzenCard>
              <h6 style="margin-bottom:12px">Phone Integration Status</h6>
              @if (_phoneStatus != null)
              {
                <RadzenRow>
                  <RadzenColumn Size="12" SizeMD="4">
                    <div style="display:flex; flex-direction:row; gap:8px; align-items:center">
                      <span><strong>Hub Connection:</strong></span>
                      @if (!_phoneStatus.Enabled)
                      {
                        <RadzenBadge Text="Disabled" BadgeStyle="BadgeStyle.Light" />
                      }
                      else if (_phoneStatus.IsConnected)
                      {
                        <RadzenBadge Text="Connected" BadgeStyle="BadgeStyle.Success" />
                      }
                      else
                      {
                        <RadzenBadge Text="Disconnected" BadgeStyle="BadgeStyle.Danger" />
                      }
                    </div>
                  </RadzenColumn>
                  <RadzenColumn Size="12" SizeMD="4">
                    <div style="display:flex; flex-direction:row; gap:8px; align-items:center">
                      <span><strong>Call State:</strong></span>
                      <RadzenBadge Text="@_phoneStatus.CurrentState" BadgeStyle="@GetPhoneStateBadgeStyle(_phoneStatus.CurrentState)" />
                    </div>
                  </RadzenColumn>
                  @if (_phoneStatus.Enabled && _phoneStatus.CurrentState != "Idle")
                  {
                    <RadzenColumn Size="12" SizeMD="4">
                      <span><strong>Caller:</strong> @(string.IsNullOrEmpty(_phoneStatus.CallerName) ? _phoneStatus.CallerNumber : $"{_phoneStatus.CallerName} ({_phoneStatus.CallerNumber})")</span>
                    </RadzenColumn>
                  }
                  @if (_phoneStatus.Enabled && !string.IsNullOrEmpty(_phoneStatus.HubUrl))
                  {
                    <RadzenColumn Size="12">
                      <span style="font-size:0.75rem; color:var(--text-low)"><strong>Hub URL:</strong> @_phoneStatus.HubUrl</span>
                    </RadzenColumn>
                  }
                </RadzenRow>
              }
              else
              {
                <RadzenProgressBarCircular Size="ProgressBarCircularSize.Small" Mode="ProgressBarMode.Indeterminate" />
              }
            </RadzenCard>

            <!-- Configuration -->
            <RadzenCard>
              <div style="display:flex; flex-direction:row; align-items:center; margin-bottom:12px">
                <h6 style="margin:0">Configuration</h6>
                <div style="flex:1"></div>
                <RadzenButton Variant="Variant.Filled" ButtonStyle="ButtonStyle.Primary"
                              Click="SavePhoneConfigAsync" Icon="save"
                              Disabled="@(_isSaving || _phoneConfig == null)" Text="Save" />
              </div>
              @if (_phoneConfig != null)
              {
                <RadzenRow>
                  <RadzenColumn Size="12" SizeMD="4">
                    <div style="display:flex;align-items:center;gap:8px">
                      <RadzenSwitch @bind-Value="_phoneConfig.Enabled" />
                      <span>Enabled</span>
                    </div>
                  </RadzenColumn>
                  <RadzenColumn Size="12" SizeMD="8">
                    <RadzenTextBox @bind-Value="_phoneConfig.HubUrl" Placeholder="SignalR Hub URL" Style="width:100%" />
                    <small>RotaryPhone server hub endpoint</small>
                  </RadzenColumn>
                  <RadzenColumn Size="12" SizeMD="6">
                    <RadzenTextBox @bind-Value="_phoneConfig.ContactsApiBaseUrl" Placeholder="Contacts API Base URL" Style="width:100%" />
                    <small>RotaryPhone contacts REST API</small>
                  </RadzenColumn>
                  <RadzenColumn Size="12" SizeMD="6">
                    <RadzenTextBox @bind-Value="_phoneConfig.RingSoundPath" Placeholder="Ring Sound Path" Style="width:100%" />
                    <small>Path to ring sound WAV/MP3 file</small>
                  </RadzenColumn>
                  <RadzenColumn Size="6" SizeMD="3">
                    <RadzenNumeric TValue="int" @bind-Value="_phoneConfig.RingPriority" Min="1" Max="10" Placeholder="Ring Priority" Style="width:100%" />
                  </RadzenColumn>
                  <RadzenColumn Size="6" SizeMD="3">
                    <RadzenNumeric TValue="int" @bind-Value="_phoneConfig.AnnouncementPriority" Min="1" Max="10" Placeholder="Announcement Priority" Style="width:100%" />
                  </RadzenColumn>
                  <RadzenColumn Size="6" SizeMD="3">
                    <RadzenNumeric TValue="int" @bind-Value="_phoneConfig.ReconnectBaseDelayMs" Min="500" Max="60000" Placeholder="Reconnect Base (ms)" Style="width:100%" />
                  </RadzenColumn>
                  <RadzenColumn Size="6" SizeMD="3">
                    <RadzenNumeric TValue="int" @bind-Value="_phoneConfig.ReconnectMaxDelayMs" Min="1000" Max="120000" Placeholder="Reconnect Max (ms)" Style="width:100%" />
                  </RadzenColumn>
                </RadzenRow>
              }
              else
              {
                <span>Loading configuration...</span>
              }
            </RadzenCard>

            <!-- PBAP Contact Sync -->
            <RadzenCard>
              <div style="display:flex; align-items:center; justify-content:space-between; margin-bottom:12px">
                <h6>Phone Book (PBAP) Sync</h6>
                <RadzenButton Variant="Variant.Outlined" ButtonStyle="ButtonStyle.Primary" Size="ButtonSize.Small"
                              Click="SavePbapConfigAsync" Icon="save"
                              Disabled="@(_isSaving || _pbapConfig == null)" Text="Save" />
              </div>
              <small style="color:var(--rz-text-secondary-color)">Pull contacts from connected phone for caller ID announcements</small>
              @if (_pbapConfig != null)
              {
                <RadzenRow style="margin-top:12px">
                  <RadzenColumn Size="12" SizeMD="4">
                    <div style="display:flex; align-items:center; gap:8px">
                      <RadzenSwitch @bind-Value="_pbapConfig.AutoSyncOnConnect" />
                      <span>Auto-sync on connect</span>
                    </div>
                  </RadzenColumn>
                  <RadzenColumn Size="6" SizeMD="4">
                    <RadzenNumeric TValue="int" @bind-Value="_pbapConfig.SyncStaleThresholdHours"
                                   Min="1" Max="168" Style="width:100%" />
                    <small>Re-sync interval (hours)</small>
                  </RadzenColumn>
                  <RadzenColumn Size="6" SizeMD="4">
                    <RadzenNumeric TValue="int" @bind-Value="_pbapConfig.TransferTimeoutSeconds"
                                   Min="5" Max="120" Style="width:100%" />
                    <small>Transfer timeout (seconds)</small>
                  </RadzenColumn>
                </RadzenRow>
              }
              else
              {
                <span>Loading configuration...</span>
              }
            </RadzenCard>
          </div>
        </RadzenTabsItem>

        <!-- Sub-tab 3: Notifications -->
        <RadzenTabsItem Text="Notifications" Icon="notifications">
          <div style="display:flex; flex-direction:column; gap:12px">
            <RadzenCard>
              <h6 style="margin-bottom:12px">Test Announcement</h6>
              <span style="font-size:0.875rem; display:block; margin-bottom:12px">
                Send a test TTS announcement with audio ducking. Any service can POST to
                <code>/api/notifications/announce</code> to trigger announcements.
              </span>
              <RadzenRow>
                <RadzenColumn Size="12" SizeMD="8">
                  <RadzenTextBox @bind-Value="_testMessage" Placeholder="Enter announcement text..." Style="width:100%" />
                </RadzenColumn>
                <RadzenColumn Size="6" SizeMD="2">
                  <RadzenNumeric TValue="int" @bind-Value="_testPriority" Min="1" Max="10" Placeholder="Priority" Style="width:100%" />
                </RadzenColumn>
                <RadzenColumn Size="6" SizeMD="2">
                  <RadzenButton Variant="Variant.Filled" ButtonStyle="ButtonStyle.Primary"
                                Click="SendTestNotificationAsync" Icon="volume_up"
                                Disabled="@(_isSendingNotification || string.IsNullOrWhiteSpace(_testMessage))"
                                Style="width:100%; height:56px" Text="Send Test" />
                </RadzenColumn>
              </RadzenRow>
            </RadzenCard>
          </div>
        </RadzenTabsItem>

        </Tabs>
      </RadzenTabs>
    </RadzenTabsItem>

    </Tabs>
  </RadzenTabs>
</div>

@code {
  private int _activeTab = 0;

  // Where the Rotary Encoders panel lives, as a pair of tab indices. RadzenTabs identifies a tab by
  // its position, so inserting a tab above either of these moves the panel and both constants have to
  // move with it. They exist because the encoder poll is only allowed to run while that panel shows.
  private const int IntegrationsTabIndex = 7;
  private const int RotaryEncoderSubTabIndex = 0;
  private int _integrationsSubTab = 0;
  private System.Threading.Timer? _statsTimer;

  // System Stats
  private double _cpuUsage = 0;
  private double _ramUsageMb = 0;
  private double _diskUsage = 0;
  private int _threadCount = 0;
  private string _appUptime = "N/A";
  private string _systemUptime = "N/A";
  private string _temperature = "N/A";
  private string _audioEngineState = "Unknown";

  // Configuration
  private AudioConfigurationDto? _audioConfig;
  private VisualizerConfigurationDto? _visualizerConfig;
  private OutputConfigurationDto? _outputConfig;
  private DeviceOptionsDto? _deviceOptions;
  private BluetoothConfigDto? _bluetoothConfig;
  private RadioConfigDto? _radioConfig;
  private FilePlayerConfigDto? _filePlayerConfig;
  private FingerprintingConfigDto? _fingerprintingConfig;
  private TTSConfigDto? _ttsConfig;
  private MetricsConfigDto? _metricsConfig;
  private AudioEngineConfigDto? _audioEngineConfig;
  // Display:* wall-clock format settings. The POCO doubles as both the bound
  // form model and the IOptionsMonitor target — reusable because it has only
  // public get/set primitives. Hot-reload propagation happens via the
  // SQLite-bridge → IOptionsMonitor pipeline (no extra wiring needed here).
  private DisplayOptions? _displayConfig;
  // Display:Weather:* sleep-screen forecast settings. Bound to the same
  // Display sub-tab as _displayConfig and saved by the same Save button
  // (one round trip writes both sets per HANDOFF-sleep-mode-weather-forecast.md §5).
  private Radio.Core.Configuration.WeatherDisplayOptions? _weatherDisplayConfig;
  private bool _isSaving = false;

  // Preferences
  private AudioPreferencesDto? _audioPreferences;
  private FilePlayerPreferencesDto? _filePlayerPreferences;
  private RadioPreferencesDto? _radioPreferences;
  private GenericSourcePreferencesDto? _genericSourcePreferences;

  // Source Gain Offsets
  private Dictionary<string, float> _sourceGainOffsets = new();
  private System.Threading.Timer? _sourceGainDebounceTimer;
  private static readonly Dictionary<string, string> _sourceGainLabels = new()
  {
    ["Radio"] = "Radio",
    ["FilePlayer"] = "File Player",
    ["Bluetooth"] = "Bluetooth",
    ["Vinyl"] = "Vinyl",
    ["GenericUSB"] = "USB Audio",
  };

  // Secrets.
  // _ttsSecretStatus holds what the API returns, which is only ever masked - "" for a secret that
  // is not set, and a placeholder such as "abcd...wxyz" or "********" for one that is. It drives
  // the badges and the hint text and is never bound to an input, because a value bound to an input
  // is a value the next Save would send back, and sending a mask back is what overwrote the real
  // Google key on 2026-09-02.
  private TTSSecretsDto? _ttsSecretStatus;

  // What the user has typed this visit. Empty means "leave the stored secret alone"; only
  // non-blank entries are sent, and the API applies the same rule on its side.
  private string _googleApiKeyInput = "";
  private string _azureApiKeyInput = "";
  private string _azureRegionInput = "";

  // Reveal toggles for the two password boxes. They reveal the text in the box - i.e. what the
  // user just typed - and nothing else; the stored secret never reaches the browser.
  private bool _showGoogleApiKey = false;
  private bool _showAzureApiKey = false;

  // Store Management (Phase 5)
  private ConfigurationStoreInfoDto? _storeInfo;
  private ConfigurationComparisonDto? _comparison;
  private HashSet<string> _selectedDifferences = new();
  private bool _isLoadingComparison = false;

  // Integrations
  private EncoderStatusDto? _encoderStatus;
  private PhoneIntegrationStatusDto? _phoneStatus;
  private RotaryEncoderConfigDto? _encoderConfig;
  private EncoderProvisioningDto? _encoderProvisioning;
  private List<EncoderMappingDto>? _encoderMapping;
  private System.Threading.Timer? _encoderPollTimer;
  private bool _encoderBusy;
  private PhoneIntegrationConfigDto? _phoneConfig;
  private PbapConfigDto? _pbapConfig;
  private string _testMessage = "";
  private int _testPriority = 8;
  private bool _isSendingNotification = false;

  // Output configuration individual fields (for binding)
  private bool _localOutputEnabled;
  private string _localPreferredDevice = "";
  private float _localDefaultVolume;
  private bool _httpStreamEnabled;
  private int _httpStreamPort;
  private int _httpStreamSampleRate;
  private int _httpStreamChannels;
  private bool _castEnabled;
  private int _castDiscoveryTimeout;
  private float _castDefaultVolume;
  private float _castMaxBufferAhead;
  private int _castBufferBeforePlay;
  private float _castReaderLagSeconds;

  // Logs
  private string _logLevel = "warning";
  private int _logLimit = 100;
  private List<LogEntryDto> _logs = new();
  private int _totalLogCount = 0;
  private bool _logsLoading = false;

  // Event Sources
  private List<AudioSourceDto>? _eventSources;
  private bool _eventSourcesLoading = false;

  // TTS
  private List<TTSEngineInfoDto>? _ttsEngines;
  private List<TTSVoiceInfoDto>? _cloudVoices;
  private bool _scanningVoices;
  private string _ttsText = string.Empty;
  private string _selectedTTSEngine = "ESpeak";
  private string _ttsVoice = "en";
  private double _ttsSpeed = 1.0;
  private double _ttsPitch = 1.0;

  // Audio Files
  private List<NotificationSoundDto>? _notificationSounds;
  private string _selectedSoundFile = string.Empty;

  // Dropdown data collections for RadzenDropDown
  private record DropDownItem(string Text, string Value);
  private record DropDownItem<T>(string Text, T Value);

  /// <summary>
  /// Round-trip shape for the <c>display</c> configuration section. Carries
  /// the wall-clock keys at the root and the weather group as a nested
  /// object so a single GET/POST covers both groups in the Display sub-tab.
  /// Nullable members so an unconfigured section gracefully falls back to
  /// type defaults at the call site.
  /// </summary>
  private sealed class DisplayConfigEnvelope
  {
    public string? TimeFormat { get; set; }
    public bool? ShowSeconds { get; set; }
    public Radio.Core.Configuration.WeatherDisplayOptions? Weather { get; set; }
  }

  private static readonly List<DropDownItem> _defaultSourceOptions = new()
  {
    new("Radio", "Radio"), new("File Player", "FilePlayer"), new("Vinyl", "Vinyl")
  };
  private static readonly List<DropDownItem> _duckingPolicyOptions = new()
  {
