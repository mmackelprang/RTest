@page "/files"
@rendermode InteractiveServer
@using System.Runtime.InteropServices
@inject FileApiService FileApi
@inject AudioApiService AudioApi
@inject QueueApiService QueueApi
@inject ConfigurationApiService ConfigApi
@inject IJSRuntime JSRuntime
@inject ILogger<FileBrowserPage> Logger
@implements IAsyncDisposable

<PageTitle>File Browser - Radio Console</PageTitle>

<!-- Include virtual keyboard CSS -->
<link href="css/virtual-keyboard.css" rel="stylesheet" />

<div class="file-browser-page" style="padding: 24px; height: 100%; display: flex; flex-direction: column;">
  <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 16px;">
    <MudText Typo="Typo.h4">File Browser</MudText>
    <div style="display: flex; gap: 8px;">
      <MudButton Variant="Variant.Outlined" 
                 Color="Color.Default" 
                 Size="Size.Small" 
                 OnClick="HandleHomeAsync"
                 StartIcon="@Icons.Material.Filled.Home"
                 title="Home">
        Home
      </MudButton>
      <MudButton Variant="Variant.Outlined" 
                 Color="Color.Default" 
                 Size="Size.Small" 
                 OnClick="HandleUpAsync"
                 StartIcon="@Icons.Material.Filled.ArrowUpward"
                 Disabled="@(_currentPath == "/" || _currentPath == _rootPath)"
                 title="Up">
        Up
      </MudButton>
      <MudButton Variant="Variant.Outlined" 
                 Color="Color.Default" 
                 Size="Size.Small" 
                 OnClick="LoadDrivesAsync"
                 StartIcon="@Icons.Material.Filled.Refresh"
                 title="Refresh Drives">
        Refresh
      </MudButton>
    </div>
  </div>
  
  <!-- Drive Selector -->
  @if (_drives != null && _drives.Any())
  {
    <div style="margin-bottom: 16px;">
      <MudSelect T="string" 
                 Label="Drive / Location" 
                 Variant="Variant.Outlined" 
                 Value="@_selectedDrive" 
                 ValueChanged="HandleDriveSelectionAsync"
                 Dense="false"
                 Style="width: 100%; max-width: 500px;">
        @foreach (var drive in _drives)
        {
          <MudSelectItem T="string" Value="@drive.Name">
            <div style="display: flex; align-items: center; gap: 12px; min-height: 48px;">
              <MudIcon Icon="@GetDriveIcon(drive.DriveType)" Color="@(drive.IsReady ? Color.Primary : Color.Default)" />
              <div style="flex: 1;">
                <div style="font-weight: 500;">@drive.Label</div>
                @if (drive.IsReady && drive.TotalSize > 0)
                {
                  <div style="font-size: 0.875rem; color: var(--mud-palette-text-secondary);">
                    @FormatBytes(drive.AvailableSpace) free of @FormatBytes(drive.TotalSize)
                  </div>
                }
                else if (!drive.IsReady)
                {
                  <div style="font-size: 0.875rem; color: var(--mud-palette-text-secondary);">Not ready</div>
                }
              </div>
            </div>
          </MudSelectItem>
        }
      </MudSelect>
    </div>
  }
  
  <!-- Custom Path Entry -->
  <div style="margin-bottom: 16px;">
    <div style="display: flex; gap: 8px; align-items: flex-start;">
      <MudTextField @bind-Value="_customPath" 
                    id="custom-path-input"
                    Label="Custom Path (e.g., \\server\share, /mnt/nas, C:\Music)" 
                    Variant="Variant.Outlined" 
                    HelperText="Enter a UNC path, network share, or local directory"
                    OnKeyUp="@(async (e) => { if (e.Key == "Enter") await NavigateToCustomPathAsync(); })"
                    Style="flex: 1;" />
      <MudIconButton Icon="@Icons.Material.Filled.Keyboard" 
                     Color="Color.Primary"
                     Size="Size.Large"
                     Style="min-width: 56px; min-height: 56px;"
                     OnClick="ToggleVirtualKeyboard"
                     title="Show/Hide Virtual Keyboard" />
      <MudButton Variant="Variant.Filled" 
                 Color="Color.Primary" 
                 Size="Size.Large"
                 Style="min-width: 80px; min-height: 56px;"
                 OnClick="NavigateToCustomPathAsync"
                 StartIcon="@Icons.Material.Filled.ArrowForward">
        Go
      </MudButton>
    </div>
    @if (_recentPaths.Any())
    {
      <div style="margin-top: 8px; display: flex; gap: 8px; flex-wrap: wrap;">
        <MudText Typo="Typo.caption" Style="margin-right: 8px; align-self: center; color: var(--mud-palette-text-secondary);">Recent:</MudText>
        @foreach (var path in _recentPaths.Take(5))
        {
          <MudChip T="string" 
                   Size="Size.Small" 
                   OnClick="@(() => NavigateToRecentPath(path))"
                   Icon="@Icons.Material.Filled.History"
                   Style="cursor: pointer;">
            @TruncatePath(path, 40)
          </MudChip>
        }
      </div>
    }
  </div>
  
  <!-- Breadcrumb Navigation -->
  <div style="margin-bottom: 16px;">
    <MudBreadcrumbs Items="@_breadcrumbs" Style="padding: 8px 0;">
      <ItemTemplate Context="item">
        <MudLink Href="#" OnClick="@(() => NavigateToPath(item.Href ?? "/"))" Style="cursor: pointer;">@item.Text</MudLink>
      </ItemTemplate>
    </MudBreadcrumbs>
  </div>
  
  <!-- Search and Filter -->
  <div style="margin-bottom: 16px; display: flex; gap: 16px;">
    <MudTextField @bind-Value="_searchQuery" 
                  Label="Search files" 
                  Variant="Variant.Outlined" 
                  Adornment="Adornment.End" 
                  AdornmentIcon="@Icons.Material.Filled.Search"
                  OnKeyUp="@(async (e) => { if (e.Key == "Enter") await LoadFilesAsync(); })"
                  Style="flex: 1;" />
    <MudSwitch T="bool" @bind-Value="_recursive" Label="Recursive" Color="Color.Primary" />
    <MudSelect T="string" @bind-Value="_filterExtension" Label="Filter" Variant="Variant.Outlined" Dense="true" Style="min-width: 150px;">
      <MudSelectItem Value="@("*")">All</MudSelectItem>
      <MudSelectItem Value="@(".mp3")">MP3</MudSelectItem>
      <MudSelectItem Value="@(".flac")">FLAC</MudSelectItem>
      <MudSelectItem Value="@(".wav")">WAV</MudSelectItem>
      <MudSelectItem Value="@(".ogg")">OGG</MudSelectItem>
      <MudSelectItem Value="@(".m4a")">M4A/AAC</MudSelectItem>
    </MudSelect>
  </div>
  
  @if (_isLoading)
  {
    <div style="display: flex; justify-content: center; padding: 64px;">
      <MudProgressCircular Color="Color.Primary" Indeterminate="true" />
    </div>
  }
  else if (!_fileItems.Any())
  {
    <!-- Empty State -->
    <div style="display: flex; flex-direction: column; align-items: center; justify-content: center; height: 100%; color: var(--text-secondary);">
      <MudIcon Icon="@Icons.Material.Filled.FolderOff" Style="font-size: 120px; margin-bottom: 16px; opacity: 0.5;" />
      <MudText Typo="Typo.h5">No audio files found</MudText>
      <MudText Typo="Typo.body2" Style="margin-top: 8px;">Try a different directory or search term</MudText>
    </div>
  }
  else
  {
    <!-- File List -->
    <div style="flex: 1; overflow-y: auto;">
      <MudList T="string" Dense="true">
        @foreach (var item in _fileItems.Where(f => f.IsDirectory))
        {
          <MudListItem T="string" Icon="@Icons.Material.Filled.Folder" IconColor="Color.Primary" @onclick="@(() => NavigateToDirectory(item.Path))">
            <div style="display: flex; justify-content: space-between; width: 100%;">
              <MudText Typo="Typo.body1" Style="font-weight: 500;">@item.Name</MudText>
            </div>
          </MudListItem>
          <MudDivider />
        }
        
        @foreach (var item in _fileItems.Where(f => !f.IsDirectory))
        {
          <MudListItem T="string" Icon="@Icons.Material.Filled.MusicNote" IconColor="Color.Default" Style="min-height: 72px;">
            <div style="display: flex; justify-content: space-between; align-items: center; width: 100%;">
              <div style="flex: 1;">
                <MudText Typo="Typo.body1" Style="font-weight: 500; margin-bottom: 4px;">
                  @(!string.IsNullOrEmpty(item.Artist) ? $"{item.Artist} - {item.Name}" : item.Name)
                </MudText>
                @if (!string.IsNullOrEmpty(item.Album) || !string.IsNullOrEmpty(item.Duration))
                {
                  <MudText Typo="Typo.caption" Style="color: var(--text-secondary);">
                    @item.Album @(!string.IsNullOrEmpty(item.Album) && !string.IsNullOrEmpty(item.Duration) ? " • " : "") @item.Duration
                  </MudText>
                }
              </div>
              <div style="display: flex; gap: 8px;">
                <MudIconButton Icon="@Icons.Material.Filled.PlayArrow" 
                               Size="Size.Medium" 
                               OnClick="@(() => HandlePlayFileAsync(item.Path))" 
                               title="Play" />
                <MudIconButton Icon="@Icons.Material.Filled.Add" 
                               Size="Size.Medium" 
                               OnClick="@(() => HandleAddToQueueAsync(item.Path))" 
                               title="Add to Queue" />
              </div>
            </div>
          </MudListItem>
          <MudDivider />
        }
      </MudList>
    </div>
  }
</div>

@code {
  private string _currentPath = "/";
  private string _rootPath = "/";
  private string _searchQuery = "";
  private string _filterExtension = "*";
  private bool _recursive = false;
  private bool _isLoading = false;
  private List<FileItemDto> _fileItems = new();
  private List<MudBlazor.BreadcrumbItem> _breadcrumbs = new();
  private List<DriveInfoDto>? _drives = null;
  private string _selectedDrive = "/";
  private string _customPath = "";
  private List<string> _recentPaths = new();
  private IJSObjectReference? _keyboardModule;

  protected override async Task OnInitializedAsync()
  {
    await LoadDrivesAsync();
    await LoadPreferencesAsync();
    await LoadFilesAsync();
    UpdateBreadcrumbs();
  }

  protected override async Task OnAfterRenderAsync(bool firstRender)
  {
    if (firstRender)
    {
      try
      {
        _keyboardModule = await JSRuntime.InvokeAsync<IJSObjectReference>(
          "import", "./js/virtual-keyboard.js");
      }
      catch (Exception ex)
      {
        Logger.LogError(ex, "Failed to load virtual keyboard module");
      }
    }
  }

  private async Task ToggleVirtualKeyboard()
  {
    if (_keyboardModule == null)
    {
      Logger.LogWarning("Virtual keyboard module not initialized");
      return;
    }

    try
    {
      // Find the input element by its container ID and toggle keyboard
      await JSRuntime.InvokeVoidAsync("eval", @"
        const input = document.querySelector('#custom-path-input input');
        if (input && window.virtualKeyboard) {
          window.virtualKeyboard.toggle(input);
        }
      ");
    }
    catch (Exception ex)
    {
      Logger.LogError(ex, "Failed to toggle virtual keyboard");
    }
  }

  public async ValueTask DisposeAsync()
  {
    if (_keyboardModule != null)
    {
      try
      {
        await _keyboardModule.DisposeAsync();
      }
      catch (Exception ex)
      {
        Logger.LogWarning(ex, "Error disposing keyboard module");
      }
    }
  }

  private async Task LoadPreferencesAsync()
  {
    try
    {
      var prefs = await ConfigApi.GetConfigurationAsync<Dictionary<string, object>>("ui.filebrowser");
      if (prefs != null)
      {
        // Load saved path preference
        if (prefs.TryGetValue("lastPath", out var pathObj) && pathObj != null)
        {
          _currentPath = pathObj.ToString() ?? "/";
        }
        
        // Load saved filter preference
        if (prefs.TryGetValue("filterExtension", out var filterObj) && filterObj != null)
        {
          _filterExtension = filterObj.ToString() ?? "*";
        }
        
        // Load recent paths
        if (prefs.TryGetValue("recentPaths", out var recentObj) && recentObj != null)
        {
          var recentStr = recentObj.ToString();
          if (!string.IsNullOrEmpty(recentStr))
          {
            _recentPaths = System.Text.Json.JsonSerializer.Deserialize<List<string>>(recentStr) ?? new List<string>();
          }
        }
      }
      else
      {
        // Save defaults
        await SavePreferenceAsync("lastPath", _currentPath);
        await SavePreferenceAsync("filterExtension", _filterExtension);
        await SavePreferenceAsync("recentPaths", "[]");
      }
    }
    catch (Exception ex)
    {
      Logger.LogWarning(ex, "Failed to load preferences for FileBrowser page");
    }
  }

  private async Task SavePreferenceAsync(string key, object value)
  {
    try
    {
      await ConfigApi.UpdateConfigurationAsync("ui.filebrowser", key, value);
    }
    catch (Exception ex)
    {
      Logger.LogWarning(ex, "Failed to save preference {Key}", key);
    }
  }

  private async Task LoadFilesAsync()
  {
    _isLoading = true;
    try
    {
      var result = await FileApi.ListFilesAsync(_currentPath, _recursive);
      if (result != null)
      {
        _fileItems = result.Items ?? new List<FileItemDto>();
        
        // Apply filter
        if (_filterExtension != "*")
        {
          _fileItems = _fileItems.Where(f => f.IsDirectory || f.Name.EndsWith(_filterExtension, StringComparison.OrdinalIgnoreCase)).ToList();
        }
        
        // Apply search
        if (!string.IsNullOrWhiteSpace(_searchQuery))
        {
          _fileItems = _fileItems.Where(f => 
            f.Name.Contains(_searchQuery, StringComparison.OrdinalIgnoreCase) ||
            f.Artist?.Contains(_searchQuery, StringComparison.OrdinalIgnoreCase) == true ||
            f.Album?.Contains(_searchQuery, StringComparison.OrdinalIgnoreCase) == true
          ).ToList();
        }
        
        // Sort: directories first, then files alphabetically
        _fileItems = _fileItems.OrderByDescending(f => f.IsDirectory).ThenBy(f => f.Name).ToList();
      }
    }
    catch (Exception)
    {
      // Silently fail
    }
    finally
    {
      _isLoading = false;
    }
  }

  private void UpdateBreadcrumbs()
  {
    _breadcrumbs.Clear();
    _breadcrumbs.Add(new MudBlazor.BreadcrumbItem("Home", href: _rootPath, icon: Icons.Material.Filled.Home));
    
    if (_currentPath != _rootPath)
    {
      var parts = _currentPath.Split('/', StringSplitOptions.RemoveEmptyEntries);
      var path = "";
      foreach (var part in parts)
      {
        path += "/" + part;
        _breadcrumbs.Add(new MudBlazor.BreadcrumbItem(part, href: path));
      }
    }
  }

  private async Task NavigateToDirectory(string path)
  {
    _currentPath = path;
    UpdateBreadcrumbs();
    await LoadFilesAsync();
    await SavePreferenceAsync("lastPath", _currentPath);
  }

  private async Task NavigateToPath(string path)
  {
    _currentPath = path;
    UpdateBreadcrumbs();
    await LoadFilesAsync();
    await SavePreferenceAsync("lastPath", _currentPath);
  }

  private async Task HandleHomeAsync()
  {
    _currentPath = _rootPath;
    UpdateBreadcrumbs();
    await LoadFilesAsync();
    await SavePreferenceAsync("lastPath", _currentPath);
  }

  private async Task HandleUpAsync()
  {
    if (_currentPath == _rootPath) return;
    
    var lastSlash = _currentPath.TrimEnd('/').LastIndexOf('/');
    _currentPath = lastSlash > 0 ? _currentPath.Substring(0, lastSlash) : _rootPath;
    UpdateBreadcrumbs();
    await LoadFilesAsync();
    await SavePreferenceAsync("lastPath", _currentPath);
  }

  private async Task HandlePlayFileAsync(string path)
  {
    try
    {
      await FileApi.PlayFileAsync(path);
    }
    catch (Exception)
    {
      // Silently fail
    }
  }

  private async Task HandleAddToQueueAsync(string path)
  {
    try
    {
      await FileApi.AddFilesToQueueAsync(new List<string> { path });
    }
    catch (Exception)
    {
      // Silently fail
    }
  }

  private async Task LoadDrivesAsync()
  {
    try
    {
      _drives = await FileApi.GetDrivesAsync();
      if (_drives != null && _drives.Any())
      {
        // Set selected drive based on current path or default to first drive
        if (RuntimeInformation.IsOSPlatform(OSPlatform.Windows))
        {
          // On Windows, extract drive letter from path (e.g., "C:\")
          _selectedDrive = _currentPath.Length >= 2 && _currentPath[1] == ':'
            ? _currentPath.Substring(0, 3) // "C:\"
            : _drives.FirstOrDefault()?.Name ?? "/";
        }
        else
        {
          // On Linux, use root
          _selectedDrive = "/";
        }
      }
    }
    catch (Exception ex)
    {
      Logger.LogWarning(ex, "Failed to load drives");
    }
  }

  private async Task HandleDriveSelectionAsync(string driveName)
  {
    if (string.IsNullOrEmpty(driveName)) return;
    
    _selectedDrive = driveName;
    _currentPath = driveName;
    _rootPath = driveName;
    UpdateBreadcrumbs();
    await LoadFilesAsync();
    await SavePreferenceAsync("lastPath", _currentPath);
  }

  private string GetDriveIcon(string driveType)
  {
    return driveType switch
    {
      "Fixed" => Icons.Material.Filled.Storage,
      "Removable" => Icons.Material.Filled.Usb,
      "Network" => Icons.Material.Filled.Cloud,
      "CDRom" => Icons.Material.Filled.Album,
      _ => Icons.Material.Filled.Folder
    };
  }

  private string FormatBytes(long bytes)
  {
    string[] sizes = { "B", "KB", "MB", "GB", "TB" };
    double len = bytes;
    int order = 0;
    while (len >= 1024 && order < sizes.Length - 1)
    {
      order++;
      len = len / 1024;
    }
    return $"{len:0.##} {sizes[order]}";
  }
  
  private async Task NavigateToCustomPathAsync()
  {
    if (string.IsNullOrWhiteSpace(_customPath))
    {
      return;
    }
    
    try
    {
      // Normalize the path
      var normalizedPath = NormalizePath(_customPath.Trim());
      
      // Validate path format
      if (!IsValidPath(normalizedPath))
      {
        Logger.LogWarning("Invalid path format: {Path}", _customPath);
        // TODO: Show error message to user
        return;
      }
      
      // Add to recent paths (don't duplicate)
      if (!_recentPaths.Contains(normalizedPath))
      {
        _recentPaths.Insert(0, normalizedPath);
        
        // Keep only last 10 paths
        if (_recentPaths.Count > 10)
        {
          _recentPaths = _recentPaths.Take(10).ToList();
        }
        
        // Save recent paths
        var json = System.Text.Json.JsonSerializer.Serialize(_recentPaths);
        await SavePreferenceAsync("recentPaths", json);
      }
      
      // Navigate to the path
      _currentPath = normalizedPath;
      _rootPath = normalizedPath;
      _selectedDrive = normalizedPath;
      UpdateBreadcrumbs();
      await LoadFilesAsync();
      await SavePreferenceAsync("lastPath", _currentPath);
      
      // Clear the input
      _customPath = "";
    }
    catch (Exception ex)
    {
      Logger.LogError(ex, "Failed to navigate to custom path: {Path}", _customPath);
    }
  }
  
  private void NavigateToRecentPath(string path)
  {
    _customPath = path;
    InvokeAsync(NavigateToCustomPathAsync);
  }
  
  private string NormalizePath(string path)
  {
    // Handle UNC paths (\\server\share)
    if (path.StartsWith("\\\\") || path.StartsWith("//"))
    {
      return path.Replace("/", "\\"); // Normalize to Windows UNC format
    }
    
    // Handle Windows paths (C:\, D:\, etc.)
    if (RuntimeInformation.IsOSPlatform(OSPlatform.Windows) && path.Length >= 2 && path[1] == ':')
    {
      return path.Replace("/", "\\");
    }
    
    // Handle Unix paths
    if (path.StartsWith("/"))
    {
      return path.Replace("\\", "/");
    }
    
    // Default: assume Unix path
    return path.Replace("\\", "/");
  }
  
  private bool IsValidPath(string path)
  {
    if (string.IsNullOrWhiteSpace(path))
    {
      return false;
    }
    
    // UNC path: \\server\share
    if (path.StartsWith("\\\\") && path.Length > 3)
    {
      return true;
    }
    
    // Windows absolute path: C:\, D:\, etc.
    if (path.Length >= 3 && path[1] == ':' && (path[2] == '\\' || path[2] == '/'))
    {
      return true;
    }
    
    // Unix absolute path: /path/to/dir
    if (path.StartsWith("/"))
    {
      return true;
    }
    
    return false;
  }
  
  private string TruncatePath(string path, int maxLength)
  {
    if (path.Length <= maxLength)
    {
      return path;
    }
    
    // Show first and last parts of path
    var halfLength = (maxLength - 3) / 2;
    return path.Substring(0, halfLength) + "..." + path.Substring(path.Length - halfLength);
  }
}
