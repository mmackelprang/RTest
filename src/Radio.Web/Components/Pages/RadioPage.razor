@page "/radio"
@rendermode InteractiveServer
@inject RadioApiService RadioApi
@inject AudioStateHubService HubService
@inject ConfigurationApiService ConfigApi
@inject ILogger<RadioPage> Logger
@implements IAsyncDisposable

<PageTitle>Radio - Radio Console</PageTitle>

<div style="height: 100%; display: flex; gap: 2px; overflow: hidden;">
  @if (_radioState == null)
  {
    @* Initial-load skeleton — shape mirrors the band buttons + freq well +
       meter strip that take its place once _radioState is hydrated. *@
    <Skeleton Shape="Skeleton.SkeletonShape.Radio" />
  }
  else
  {
    <!-- Left: Instrument Panel (tuner display + controls) -->
    <div class="panel surface-raised" style="flex: 1; display: flex; flex-direction: column; align-items: center; justify-content: center; padding: 24px; gap: 16px;">
      <!-- Band selector: pill-style toggle group -->
      @if (_availableBands.Any())
      {
        <div class="route-group" style="padding: 4px 8px;">
          @foreach (var band in _availableBands)
          {
            <div class="route-toggle @(band.Type == _radioState.Band ? "route-active" : "")"
                 style="width: auto; padding: 0 16px; height: 40px; border-radius: 20px; font-size: 15px; font-weight: 600;"
                 @onclick="@(async () => await HandleBandChangeAsync(band.Type))">
              @band.Name
            </div>
          }
        </div>
      }

      <!-- DSEG Frequency Display -->
      <div style="text-align: center;">
        <div class="display-frequency" @onclick="OpenFrequencyDialog" style="cursor: pointer;" title="Click to set frequency">
          @FormatFrequency(_radioState.Frequency, _radioState.Band)
        </div>
        <div style="font-size: 14px; color: var(--text-low); margin-top: 4px; font-family: var(--font-mono);">
          Step: @FormatStep(_radioState.Step, _radioState.Band)
        </div>
      </div>

      <!-- Signal strength: segmented bar -->
      @if (_radioState.SignalStrength.HasValue)
      {
        <div style="width: 400px;">
          <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 4px;">
            <span style="font-size: 13px; color: var(--text-medium); text-transform: uppercase; letter-spacing: 0.05em;">Signal</span>
            <span style="font-size: 13px; color: var(--text-medium); font-family: var(--font-mono);">@_radioState.SignalStrength%</span>
          </div>
          <div style="display: flex; gap: 2px; height: 8px;">
            @for (int i = 0; i < 20; i++)
            {
              var filled = (_radioState.SignalStrength ?? 0) >= (i + 1) * 5;
              var barColor = i < 12 ? "var(--signal-green)" : i < 17 ? "var(--signal-amber)" : "var(--signal-red)";
              <div style="flex: 1; border-radius: 2px; background: @(filled ? barColor : "var(--surface-separator)"); transition: background 100ms ease;"></div>
            }
          </div>
        </div>
      }

      <!-- Scanning indicator -->
      @if (_radioState.IsScanning)
      {
        <div style="font-size: 16px; color: var(--signal-amber); animation: blink 1s infinite; letter-spacing: 2px; font-family: var(--font-mono);">
          SCANNING @_radioState.ScanDirection
        </div>
      }

      <!-- Tuning + Scan Controls -->
      <div style="display: flex; gap: 8px; align-items: center;">
        <RadzenButton Icon="keyboard_arrow_left" ButtonStyle="ButtonStyle.Primary" Size="ButtonSize.Large"
                      Variant="Variant.Text"
                      Style="min-width: 56px; min-height: 56px;"
                      Click="FrequencyDownAsync" title="Frequency Down" />
        @if (_radioState.IsScanning)
        {
          <RadzenButton Variant="Variant.Filled" ButtonStyle="ButtonStyle.Danger"
                        Style="min-width: 120px; min-height: 48px; font-size: 16px;"
                        Click="StopScanAsync" Icon="stop" Text="Stop" />
        }
        else
        {
          <RadzenButton Variant="Variant.Filled" ButtonStyle="ButtonStyle.Primary"
                        Style="min-width: 100px; min-height: 48px; font-size: 15px;"
                        Click="@(() => StartScanAsync("down"))" Icon="search" Text="Scan ◀" />
          <RadzenButton Variant="Variant.Filled" ButtonStyle="ButtonStyle.Primary"
                        Style="min-width: 100px; min-height: 48px; font-size: 15px;"
                        Click="@(() => StartScanAsync("up"))" Icon="search" Text="▶ Scan" />
        }
        <RadzenButton Icon="keyboard_arrow_right" ButtonStyle="ButtonStyle.Primary" Size="ButtonSize.Large"
                      Variant="Variant.Text"
                      Style="min-width: 56px; min-height: 56px;"
                      Click="FrequencyUpAsync" title="Frequency Up" />
      </div>

      <!-- Step size selector -->
      <RadzenDropDown TValue="string" Value="@_radioState.Step.ToString("0")" Change="@HandleStepDropDownChangeAsync"
                      Data="@_stepSizeOptions" TextProperty="Label" ValueProperty="Value"
                      Placeholder="Step Size"
                      Style="min-width: 160px; max-width: 180px;" />

      <!-- SDR Controls (if applicable) -->
      @if (_radioState.Gain.HasValue)
      {
        <div style="display: flex; gap: 16px; align-items: center; width: 400px;">
          <div style="display: flex; align-items: center; gap: 8px;">
            <RadzenSwitch Value="@_radioState.AutoGain" Change="@HandleAutoGainSwitchChangedAsync" />
            <span>AGC</span>
          </div>
          @if (!_radioState.AutoGain && _radioState.Gain.HasValue)
          {
            <div style="flex: 1; display: flex; flex-direction: column;">
              <span style="font-size: 13px; color: var(--text-medium);">Gain: @_radioState.Gain dB</span>
              <RadzenSlider TValue="int" Value="@_radioState.Gain.Value" Change="@HandleGainSliderChangedAsync"
                            Min="0" Max="50" Step="1" />
            </div>
          }
        </div>
      }
    </div>

    <!-- Right: Presets Panel -->
    <div class="panel surface-raised" style="width: 480px; flex-shrink: 0; display: flex; flex-direction: column; overflow: hidden;">
      <div class="panel-header">
        <span>Presets</span>
        <RadzenButton Variant="Variant.Filled" ButtonStyle="ButtonStyle.Primary" Size="ButtonSize.Small"
                      Click="OpenSavePresetDialog" Icon="save" Text="Save Current" />
      </div>

      <div style="flex: 1; overflow-y: auto; padding: 12px;">
        @if (_presets == null || !_presets.Any())
        {
          <div style="display: flex; flex-direction: column; align-items: center; justify-content: center; height: 100%; color: var(--text-low);">
            <RadzenIcon Icon="radio" Style="font-size: 80px; opacity: 0.4; margin-bottom: 12px;" />
            <span style="font-size: 16px;">No presets saved yet</span>
            <span style="font-size: 14px; color: var(--text-low); margin-top: 4px;">Save the current station to create a preset</span>
          </div>
        }
        else
        {
          <div style="display: grid; grid-template-columns: repeat(2, 1fr); gap: 8px;">
            @foreach (var preset in _presets.OrderBy(p => p.CreatedAt))
            {
              <div class="list-item-touch" style="flex-direction: column; align-items: stretch; padding: 12px; border-radius: 8px; border: 1px solid var(--surface-separator); cursor: pointer;"
                   @onclick="@(() => LoadPresetAsync(preset.Id))">
                <div style="font-size: 16px; font-weight: 600; color: var(--text-high);">@preset.Name</div>
                <div style="font-size: 14px; color: var(--signal-amber); font-family: var(--font-mono);">
                  @FormatFrequency(preset.Frequency, preset.Band)
                </div>
                <div style="display: flex; justify-content: space-between; align-items: center; margin-top: 4px;">
                  <span style="font-size: 13px; color: var(--text-low);">@preset.Band</span>
                  <div @onclick:stopPropagation="true">
                    <RadzenButton Icon="delete" ButtonStyle="ButtonStyle.Danger" Size="ButtonSize.Small"
                                  Variant="Variant.Text"
                                  Click="@(() => DeletePresetAsync(preset.Id))" title="Delete" />
                  </div>
                </div>
              </div>
            }
          </div>
        }
      </div>
    </div>
  }
</div>

@if (_isFrequencyDialogOpen)
{
  <!-- Frequency Set Dialog (CSS overlay) -->
  <div style="position: fixed; inset: 0; background: rgba(0,0,0,0.5); z-index: 9999; display: flex; justify-content: center; align-items: center;"
       @onclick="CloseFrequencyDialog">
    <div style="background: var(--surface-raised, #1e1e1e); border-radius: 12px; padding: 24px; min-width: 320px; max-width: 400px;"
         @onclick:stopPropagation="true">
      <h6 style="margin: 0 0 16px 0;">Set Frequency</h6>
      <RadzenNumeric TValue="double" @bind-Value="_newFrequency"
                     Placeholder="@(_radioState?.Band == "AM" ? "Frequency (kHz)" : "Frequency (MHz)")"
                     Min="@((decimal)GetMinFrequency())"
                     Max="@((decimal)GetMaxFrequency())"
                     Step="@GetDialogStep().ToString()"
                     Style="width: 100%;" inputmode="decimal" />
      <div style="display: flex; justify-content: flex-end; gap: 8px; margin-top: 16px;">
        <RadzenButton Variant="Variant.Text" ButtonStyle="ButtonStyle.Light" Text="Cancel"
                      Click="CloseFrequencyDialog" />
        <RadzenButton Variant="Variant.Filled" ButtonStyle="ButtonStyle.Primary" Text="Set"
                      Click="SetFrequencyAsync" />
      </div>
    </div>
  </div>
}

@if (_isSavePresetDialogOpen)
{
  <!-- Save Preset Dialog (CSS overlay) -->
  <div style="position: fixed; inset: 0; background: rgba(0,0,0,0.5); z-index: 9999; display: flex; justify-content: center; align-items: center;"
       @onclick="CloseSavePresetDialog">
    <div style="background: var(--surface-raised, #1e1e1e); border-radius: 12px; padding: 24px; min-width: 320px; max-width: 400px;"
         @onclick:stopPropagation="true">
      <h6 style="margin: 0 0 16px 0;">Save Preset</h6>
      <RadzenTextBox @bind-Value="_presetName"
                     Placeholder="Preset Name"
                     Style="width: 100%;" />
      <div style="display: flex; justify-content: flex-end; gap: 8px; margin-top: 16px;">
        <RadzenButton Variant="Variant.Text" ButtonStyle="ButtonStyle.Light" Text="Cancel"
                      Click="CloseSavePresetDialog" />
        <RadzenButton Variant="Variant.Filled" ButtonStyle="ButtonStyle.Primary" Text="Save"
                      Click="SavePresetAsync" />
      </div>
    </div>
  </div>
}

<style>
  @@keyframes blink {
    0%, 49% { opacity: 1; }
    50%, 100% { opacity: 0.3; }
  }
</style>

@code {
  private RadioStateDto? _radioState = null;
  private List<RadioPresetDto>? _presets = null;
  private IEnumerable<Radio.Core.Models.RadioBandModel> _availableBands = Enumerable.Empty<Radio.Core.Models.RadioBandModel>();

  // Frequency dialog
  private bool _isFrequencyDialogOpen = false;
  private double _newFrequency = 88.0;

  // Save preset dialog
  private bool _isSavePresetDialogOpen = false;
  private string _presetName = "";

  // Step size options for RadzenDropDown
  private List<StepSizeOption> _stepSizeOptions = new()
  {
    new("1 kHz", "1000"),
    new("9 kHz", "9000"),
    new("10 kHz", "10000"),
    new("25 kHz", "25000"),
    new("100 kHz", "100000"),
    new("200 kHz", "200000"),
    new("1 MHz", "1000000"),
  };

  private record StepSizeOption(string Label, string Value);

  protected override async Task OnInitializedAsync()
  {
    await LoadPreferencesAsync();
    await LoadRadioStateAsync();
    await LoadPresetsAsync();
    await LoadBandsAsync();

    // Subscribe to SignalR radio state changes
    HubService.RadioStateChanged += HandleRadioStateChanged;
    try
    {
      await HubService.StartAsync();
    }
    catch (Exception ex)
    {
      Logger.LogWarning(ex, "Failed to connect to SignalR hub — radio page will not receive live updates");
    }
  }

  private async Task LoadBandsAsync()
  {
    try
    {
      _availableBands = await RadioApi.GetBandsAsync();
    }
    catch (Exception ex)
    {
      Logger.LogWarning(ex, "Failed to load radio bands");
    }
  }

  private async Task LoadPreferencesAsync()
  {
    try
    {
      var prefs = await ConfigApi.GetConfigurationAsync<Dictionary<string, object>>("ui.radio");
      if (prefs != null)
      {
        // Reserved for future: default band, step size preferences
        // Currently radio state comes from backend
      }
    }
    catch (Exception ex)
    {
      Logger.LogWarning(ex, "Failed to load preferences for Radio page");
    }
  }

  private async Task SavePreferenceAsync(string key, object value)
  {
    try
    {
      await ConfigApi.UpdateConfigurationAsync("ui.radio", key, value);
    }
    catch (Exception ex)
    {
      Logger.LogWarning(ex, "Failed to save preference {Key}", key);
    }
  }

  private async Task LoadRadioStateAsync()
  {
    try
    {
      _radioState = await RadioApi.GetStateAsync();
      if (_radioState == null)
      {
        Logger.LogWarning("Radio state returned null - radio may not be active");
      }
    }
    catch (Exception ex)
    {
      Logger.LogError(ex, "Failed to load radio state");
      _radioState = null;
    }
  }

  private async Task LoadPresetsAsync()
  {
    try
    {
      _presets = await RadioApi.GetPresetsAsync();
    }
    catch (Exception ex)
    {
      Logger.LogWarning(ex, "Failed to load radio presets");
    }
  }

  private async Task HandleRadioStateChanged()
  {
    await LoadRadioStateAsync();
    await InvokeAsync(StateHasChanged);
  }

  private async Task FrequencyUpAsync()
  {
    try
    {
      Logger.LogDebug("Calling FrequencyUpAsync");
      var success = await RadioApi.FrequencyUpAsync();
      Logger.LogDebug("FrequencyUpAsync result: {Success}", success);
      if (success)
      {
        await LoadRadioStateAsync();
        await InvokeAsync(StateHasChanged);
      }
    }
    catch (Exception ex)
    {
      Logger.LogError(ex, "Error calling FrequencyUpAsync");
    }
  }

  private async Task FrequencyDownAsync()
  {
    try
    {
      Logger.LogDebug("Calling FrequencyDownAsync");
      var success = await RadioApi.FrequencyDownAsync();
      Logger.LogDebug("FrequencyDownAsync result: {Success}", success);
      if (success)
      {
        await LoadRadioStateAsync();
        await InvokeAsync(StateHasChanged);
      }
    }
    catch (Exception ex)
    {
      Logger.LogError(ex, "Error calling FrequencyDownAsync");
    }
  }

  private void OpenFrequencyDialog()
  {
    if (_radioState != null)
    {
      // Convert Hz to display units for the dialog
      _newFrequency = _radioState.Band == "AM"
        ? _radioState.Frequency / 1_000.0       // Hz → kHz
        : _radioState.Frequency / 1_000_000.0;  // Hz → MHz
    }
    _isFrequencyDialogOpen = true;
  }

  private void CloseFrequencyDialog()
  {
    _isFrequencyDialogOpen = false;
  }

  private async Task SetFrequencyAsync()
  {
    try
    {
      // Convert display units back to Hz for API
      var frequencyHz = _radioState?.Band == "AM"
        ? _newFrequency * 1_000.0       // kHz → Hz
        : _newFrequency * 1_000_000.0;  // MHz → Hz
      var success = await RadioApi.SetFrequencyAsync(frequencyHz);
      _isFrequencyDialogOpen = false;
      if (success)
      {
        await LoadRadioStateAsync();
        await InvokeAsync(StateHasChanged);
      }
    }
    catch (Exception)
    {
      // Silently fail
    }
  }

  private async Task HandleBandChangeAsync(string newBand)
  {
    try
    {
      Logger.LogDebug("Calling HandleBandChangeAsync with band: {Band}", newBand);

      // Optimistic update
      if (_radioState != null)
      {
         _radioState = _radioState with { Band = newBand };
         // Also update visible frequency limits immediately if possible, but bands have different ranges
         // so current frequency might be invalid. The API will handle clamping.
         // We'll trust the eventual state update for frequency.
      }

      var success = await RadioApi.SetBandAsync(newBand);
      Logger.LogDebug("SetBandAsync result: {Success}", success);

      // Trigger a reload to get the clamped frequency and step immediately
      if (success)
      {
          await LoadRadioStateAsync();
          await InvokeAsync(StateHasChanged);
      }
    }
    catch (Exception ex)
    {
      Logger.LogError(ex, "Error calling HandleBandChangeAsync");
    }
  }

  // Wrapper for RadzenDropDown Change event (receives object)
  private async Task HandleStepDropDownChangeAsync(object value)
  {
    if (value is string strValue)
    {
      await HandleStepChangeAsync(strValue);
    }
  }

  private async Task HandleStepChangeAsync(string newStep)
  {
    try
    {
      Logger.LogDebug("Calling HandleStepChangeAsync with step Hz: {Step}", newStep);
      if (double.TryParse(newStep, out var stepHz))
      {
        // Optimistic update (value is Hz)
        if (_radioState != null)
        {
            _radioState = _radioState with { Step = stepHz };
        }

        // API expects Hz
        var success = await RadioApi.SetStepAsync(stepHz);
        Logger.LogDebug("SetStepAsync result: {Success}", success);
      }
      else
      {
        Logger.LogWarning("Failed to parse step value: {Step}", newStep);
      }
    }
    catch (Exception ex)
    {
      Logger.LogError(ex, "Error calling HandleStepChangeAsync");
    }
  }

  private async Task StartScanAsync(string direction)
  {
    try
    {
      Logger.LogDebug("Calling StartScanAsync with direction: {Direction}", direction);
      var success = await RadioApi.StartScanAsync(direction);
      Logger.LogDebug("StartScanAsync result: {Success}", success);
      if (success)
      {
        await LoadRadioStateAsync();
        await InvokeAsync(StateHasChanged);
      }
    }
    catch (Exception ex)
    {
      Logger.LogError(ex, "Error calling StartScanAsync");
    }
  }

  private async Task StopScanAsync()
  {
    try
    {
      Logger.LogDebug("Calling StopScanAsync");
      var success = await RadioApi.StopScanAsync();
      Logger.LogDebug("StopScanAsync result: {Success}", success);
      if (success)
      {
        await LoadRadioStateAsync();
        await InvokeAsync(StateHasChanged);
      }
    }
    catch (Exception ex)
    {
      Logger.LogError(ex, "Error calling StopScanAsync");
    }
  }

  private void OpenSavePresetDialog()
  {
    if (_radioState != null)
    {
      _presetName = $"{_radioState.Band} - {FormatFrequency(_radioState.Frequency, _radioState.Band)}";
    }
    _isSavePresetDialogOpen = true;
  }

  private void CloseSavePresetDialog()
  {
    _isSavePresetDialogOpen = false;
  }

  private async Task SavePresetAsync()
  {
    try
    {
      if (_radioState != null && !string.IsNullOrWhiteSpace(_presetName))
      {
        var success = await RadioApi.SavePresetAsync(_presetName, _radioState.Frequency, _radioState.Band);
        if (success)
        {
          await LoadPresetsAsync();
          _isSavePresetDialogOpen = false;
        }
      }
    }
    catch (Exception ex)
    {
      Logger.LogWarning(ex, "Failed to save radio preset");
    }
  }

  private async Task LoadPresetAsync(string id)
  {
    try
    {
      var success = await RadioApi.LoadPresetAsync(id);
      if (success)
      {
        await LoadRadioStateAsync();
        await InvokeAsync(StateHasChanged);
      }
    }
    catch (Exception ex)
    {
      Logger.LogWarning(ex, "Failed to load radio preset {PresetId}", id);
    }
  }

  private async Task DeletePresetAsync(string id)
  {
    try
    {
      var success = await RadioApi.DeletePresetAsync(id);
      if (success)
      {
        await LoadPresetsAsync();
      }
    }
    catch (Exception ex)
    {
      Logger.LogWarning(ex, "Failed to delete radio preset {PresetId}", id);
    }
  }

  // Wrapper for RadzenSwitch Change event (receives bool)
  private async Task HandleAutoGainSwitchChangedAsync(bool enabled)
  {
    await HandleAutoGainChangedAsync(enabled);
  }

  private async Task HandleAutoGainChangedAsync(bool enabled)
  {
    try
    {
      var success = await RadioApi.SetAutoGainAsync(enabled);
      if (success)
      {
        await LoadRadioStateAsync();
        await InvokeAsync(StateHasChanged);
      }
    }
    catch (Exception ex)
    {
      Logger.LogWarning(ex, "Failed to set auto gain to {Enabled}", enabled);
    }
  }

  // Wrapper for RadzenSlider Change event (receives int)
  private async Task HandleGainSliderChangedAsync(int gain)
  {
    await HandleGainChangedAsync(gain);
  }

  private async Task HandleGainChangedAsync(int gain)
  {
    try
    {
      var success = await RadioApi.SetGainAsync(gain);
      if (success)
      {
        await LoadRadioStateAsync();
        await InvokeAsync(StateHasChanged);
      }
    }
    catch (Exception ex)
    {
      Logger.LogWarning(ex, "Failed to set gain to {Gain}", gain);
    }
  }

  // Frequency formatting — delegates to shared FrequencyFormatter
  private static string FormatFrequency(double frequencyHz, string band) => FrequencyFormatter.FormatFrequency(frequencyHz, band);
  private static string FormatStep(double stepHz, string band) => FrequencyFormatter.FormatStep(stepHz);

  private double GetDialogStep() =>
    _radioState == null ? 0.1 : FrequencyFormatter.GetDialogStep(_radioState.Step, _radioState.Band);

  private double GetMinFrequency() =>
    _radioState == null ? 0 : FrequencyFormatter.GetMinFrequency(_radioState.Band, _availableBands);

  private double GetMaxFrequency() =>
    _radioState == null ? 1000 : FrequencyFormatter.GetMaxFrequency(_radioState.Band, _availableBands);

  public async ValueTask DisposeAsync()
  {
    HubService.RadioStateChanged -= HandleRadioStateChanged;
    await Task.CompletedTask;
  }
}
