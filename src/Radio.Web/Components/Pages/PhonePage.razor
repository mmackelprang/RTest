@page "/phone"
@using Radio.Core.Utilities
@inject PhoneApiService PhoneApi
@inject PhoneHubService PhoneHub
@inject GvBridgeApiService GvBridgeApi
@inject GvTrunkApiService GvTrunkApi
@inject GvTrunkHubService GvTrunkHub
@inject NotificationService NotificationService
@inject PbapApiService PbapApi
@inject BluetoothApiService BluetoothApi
@inject GvBridgeStatusService GvBridgeStatus
@inject PhoneUnreadState PhoneUnread
@inject BellHealthService BellHealth
@implements IDisposable

<PageTitle>Phone - Radio Console</PageTitle>

<div class="phone-shell">
  <div class="phone-tab-rail">
    <span class="phone-rail-heading">Phone</span>

    <button type="button" class="phone-rail-tab @(IsTab("messages") ? "active" : "")"
            @onclick='@(() => _activeTab = "messages")'>
      <RadzenIcon Icon="forum" />
      <span class="phone-rail-label">Messages</span>
      @if (UnreadSum > 0)
      {
        <span class="nav-badge" aria-hidden="true">@UnreadSum</span>
      }
    </button>

    <div class="phone-rail-divider"></div>

    <button type="button" class="phone-rail-tab phone-rail-more"
            aria-expanded="@(_moreExpanded ? "true" : "false")"
            @onclick="@(() => _moreExpanded = !_moreExpanded)">
      <RadzenIcon Icon="@(_moreExpanded ? "expand_more" : "chevron_right")" />
      <span class="phone-rail-label">More</span>
    </button>

    @if (_moreExpanded)
    {
      <button type="button" class="phone-rail-tab phone-rail-sub @(IsTab("dashboard") ? "active" : "")"
              @onclick='@(() => _activeTab = "dashboard")'>
        <RadzenIcon Icon="dashboard" /><span class="phone-rail-label">Dashboard</span>
      </button>
      <button type="button" class="phone-rail-tab phone-rail-sub @(IsTab("contacts") ? "active" : "")"
              @onclick='@(() => _activeTab = "contacts")'>
        <RadzenIcon Icon="contacts" /><span class="phone-rail-label">Contacts</span>
      </button>
      <button type="button" class="phone-rail-tab phone-rail-sub @(IsTab("history") ? "active" : "")"
              @onclick='@(() => _activeTab = "history")'>
        <RadzenIcon Icon="history" /><span class="phone-rail-label">Call History</span>
      </button>
      <button type="button" class="phone-rail-tab phone-rail-sub @(IsTab("diagnostics") ? "active" : "")"
              @onclick='@(() => _activeTab = "diagnostics")'>
        <RadzenIcon Icon="monitor_heart" /><span class="phone-rail-label">Diagnostics</span>
      </button>
    }
  </div>

  <div style="overflow: hidden; min-height: 0;">
    @if (_activeTab == "messages")
    {
      <PhoneMessagesPanel @ref="_messagesPanel"
                          GvAvailable="_gvBridgeAvailable"
                          CallHistory="_callHistory"
                          Contacts="MergedContacts"
                          Voicemails="_voicemails"
                          VoicemailLoading="_voicemailLoading"
                          VoicemailError="_voicemailError"
                          UnheardVoicemailCount="UnheardVoicemailCount"
                          UnreadThreadCount="UnreadThreadCount"
                          Threads="_threads"
                          ThreadsLoading="_threadsLoading"
                          ThreadsError="_threadsError"
                          OpenThreadMessages="_openThreadMessages"
                          OpenThreadLoading="_openThreadLoading"
                          OpenThreadError="_openThreadError"
                          OnRetryOpenThread="RetryOpenThreadAsync"
                          OnRefresh="RefreshMessagesAsync"
                          OnRetryVoicemail="LoadVoicemailsAsync"
                          OnVoicemailHeard="OnVoicemailHeard"
                          OnRetryThreads="LoadThreadsAsync"
                          OnOpenThread="OpenThreadAsync"
                          OnCloseThread="CloseThreadAsync" />
    }
    else if (_activeTab == "dashboard")
    {
      <PhoneDashboardPanel CallState="_callState"
                           SystemStatus="_systemStatus"
                           IsAvailable="_isAvailable"
                           GvActiveMode="_gvActiveMode"
                           GvBridgeAvailable="_gvBridgeAvailable"
                           GvTrunkRegistered="_gvTrunkRegistered"
                           SwitchingMode="_switchingMode"
                           DevTrayExpanded="_devTrayExpanded"
                           DevTrayExpandedChanged="@((bool v) => { _devTrayExpanded = v; StateHasChanged(); })"
                           DialDigits="_dialDigits"
                           DialDigitsChanged="@((string v) => { _dialDigits = v; StateHasChanged(); })"
                           OnSwitchMode="SwitchModeAsync"
                           OnReregisterTrunk="ReregisterTrunkAsync"
                           OnSimulateHook="SimulateHookAsync"
                           OnSimulateIncoming="SimulateIncomingCallAsync"
                           OnSimulateDial="SimulateDialStringAsync"
                           OnCheckBell="CheckBellAsync"
                           Contacts="MergedContacts" />
    }
    else if (_activeTab == "contacts")
    {
      <PhoneContactsPanel MergedContacts="MergedContacts"
                          ConnectedDeviceSyncInfo="ConnectedDeviceSyncInfo"
                          BtStatus="_btStatus"
                          IsSyncing="_isSyncing"
                          ShowSyncDropdown="_showSyncDropdown"
                          ShowSyncDropdownChanged="@((bool v) => { _showSyncDropdown = v; StateHasChanged(); })"
                          OnSyncFromDevice="SyncFromDeviceAsync"
                          OnAddContact="OpenAddContactDialog"
                          OnEditContact="OpenEditContactDialog"
                          OnDeleteContact="DeleteContactAsync"
                          Contacts="_contacts" />
    }
    else if (_activeTab == "history")
    {
      <PhoneHistoryPanel CallHistory="_callHistory"
                         Contacts="MergedContacts"
                         OnClearHistory="ClearCallHistoryAsync" />
    }
    else if (_activeTab == "diagnostics")
    {
      <PhoneDiagnosticsPanel />
    }
  </div>
</div>

@code {
  private string _activeTab = "messages";
  private bool _moreExpanded;
  private bool _devTrayExpanded;
  private PhoneSystemStatusDto? _systemStatus;
  private PhoneCallStateDto _callState = new();
  private List<ContactDto>? _contacts;
  private List<CallHistoryEntryDto>? _callHistory;
  private string _dialDigits = "";
  private bool _isAvailable;
  private bool _disposed;
  private bool _polling;
  private System.Timers.Timer? _pollTimer;
  private PbapSyncStatusDto? _pbapStatus;
  private BluetoothStatusDto? _btStatus;
  private List<PbapContactDto>? _pbapContacts;
  private bool _isSyncing;
  private bool _showSyncDropdown;
  private int _pollCount;

  // GV Bridge/Trunk state
  private string _gvActiveMode = "";
  private bool _gvBridgeAvailable;
  private bool _gvTrunkRegistered;
  private bool _switchingMode;

  // ── GV-12: the recovery edge ──────────────────────────────────
  // ⚠⚠ _gvHealthyLast IS SEPARATE FROM _gvBridgeAvailable ON PURPOSE, AND MERGING THEM
  // REINTRODUCES THE BUG SILENTLY. _gvBridgeAvailable takes four assignments across three
  // methods — OnInitializedAsync (twice: once from its own GvBridgeApi.GetStatusAsync, once
  // from GvBridgeStatus.IsAvailable), RefreshGvStatusAsync (reached every 6th 5 s poll = 30 s),
  // and OnGvStatusChanged — because this page runs its OWN status poll alongside the
  // singleton's. If RefreshGvStatusAsync lands the recovery first, the field is already true
  // when OnGvStatusChanged runs, the comparison reads true→true, the edge is swallowed and the
  // panels stay stuck. Intermittently, on a timer alignment nobody can reproduce on demand.
  // This field is written by OnGvStatusChanged and by NOTHING else. Plan GV-12 §0.7.
  //
  // null = no status seen yet. The FIRST delivery must never refetch: OnInitializedAsync has
  // already fired LoadVoicemailsAsync/LoadThreadsAsync and a refetch here would duplicate the
  // mount fetch on every page open.
  private bool? _gvHealthyLast;

  // Re-entrancy guard shared by BOTH unattended refetch paths — the recovery edge
  // (RefetchAfterRecoveryAsync) and the poll backstop (BackstopRefetchAsync). The status poll
  // is 10 s and a refetch is two upstream list calls through RotaryPhone to Google; a slow one
  // must not stack behind the next edge, and the two paths must not stack on each other.
  //
  // ⚠ Plain bool with no barrier, and that is sound ONLY because every read and every write
  // happens on the Blazor sync context: both writers are reached exclusively through
  // InvokeAsync. Reading or setting it from the timer thread — as the backstop originally did
  // — makes it an unsynchronized cross-thread field and half a guard: it would stop the
  // backstop starting during an edge, but not an edge starting during the backstop.
  private bool _gvRefetching;

  // _messagesPanel is captured so the inbound SMS handler can ask which thread is
  // open (toast vs append-in-place) and the voicemail-arrival path can flag the
  // new row for its one-shot animation.
  private PhoneMessagesPanel? _messagesPanel;

  // GV voicemail state (PR2). The panel renders this; the page owns fetch + push.
  // Read-state is durable via GV write-through (GV-4 / ADR-024): list endpoints are
  // source-of-truth on (re)load; the optimistic flip is presentation-only and is never
  // replayed onto fresh list data.
  private List<VoicemailItemDto>? _voicemails;
  private bool _voicemailLoading;
  private bool _voicemailError;

  // GV SMS (PR3) — thread list + the open conversation. Read-state is durable via GV
  // write-through (GV-4 / ADR-024); hasUnread from the list endpoint is source-of-truth.
  private List<SmsThreadDto>? _threads;
  private bool _threadsLoading;
  private bool _threadsError;
  private string? _openThreadId;
  private List<SmsMessageDto>? _openThreadMessages;

  // GV-8 / UAT F-1 — the open conversation's own load state, deliberately SEPARATE from
  // _threadsLoading/_threadsError: the thread list and the open conversation are two
  // independent fetches, and one failing must never be described by the other's flag.
  private bool _openThreadLoading;
  private bool _openThreadError;

  private bool IsTab(string t) => _activeTab == t;

  // UI-local unread badge sum. Missed calls DO count (owner decision 2); PR2 folds
  // in unheard voicemail; PR3 folds in unread SMS threads.
  private int MissedCallCount => _callHistory?
    .Count(c => c.Direction == CallDirection.Incoming
             && c.AnsweredOn == CallAnsweredOn.NotAnswered) ?? 0;
  private int UnheardVoicemailCount =>
    _voicemails?.Count(v => !v.IsRead) ?? 0;
  private int UnreadThreadCount => _threads?.Count(t => t.HasUnread) ?? 0;
  private int UnreadSum => MissedCallCount + UnheardVoicemailCount + UnreadThreadCount;

  protected override async Task OnInitializedAsync()
  {
    _isAvailable = await PhoneApi.IsAvailableAsync();
    if (_isAvailable)
    {
      await RefreshAllAsync();
    }

    // Fetch BT, PBAP, and GV status in parallel
    var btTask = BluetoothApi.GetStatusAsync();
    var pbapTask = PbapApi.GetSyncStatusAsync();
    var gvBridgeTask = GvBridgeApi.GetStatusAsync();
    var gvTrunkTask = GvTrunkApi.GetStatusAsync();
    await Task.WhenAll(btTask, pbapTask, gvBridgeTask, gvTrunkTask);
    _btStatus = btTask.Result;
    _pbapStatus = pbapTask.Result;

    var bridgeStatus = gvBridgeTask.Result;
    if (bridgeStatus != null)
    {
      _gvBridgeAvailable = bridgeStatus.Available;
      _gvActiveMode = bridgeStatus.ActiveMode;
    }

    var trunkStatus = gvTrunkTask.Result;
    if (trunkStatus != null)
    {
      _gvTrunkRegistered = trunkStatus.IsRegistered;
    }

    // Load PBAP contacts -- prefer connected device, fall back to most recently synced
    var pbapDeviceAddress = _btStatus?.ConnectedDevice?.Address
      ?? _pbapStatus?.Devices.OrderByDescending(d => d.LastSynced).FirstOrDefault()?.DeviceAddress;
    if (pbapDeviceAddress != null)
    {
      _pbapContacts = await PbapApi.GetContactsAsync(pbapDeviceAddress);
    }
    RebuildMergedContacts();

    // Subscribe to SignalR events
    PhoneHub.CallStateChanged += OnCallStateChanged;
    PhoneHub.IncomingCall += OnIncomingCall;
    PhoneHub.CallHistoryUpdated += OnCallHistoryUpdated;
    PhoneHub.SystemStatusChanged += OnSystemStatusChanged;
    PhoneHub.GvVoicemailReceived += OnGvVoicemailReceived;
    PhoneHub.GvSmsReceived += OnGvSmsReceived;
    PhoneHub.ReadStateChanged += OnReadStateChanged;
    GvTrunkHub.RegistrationChanged += OnRegistrationChanged;

    // GV Messages: bind to the shared status poll (reconnecting banner) and seed
    // + publish the UI-local unread badge sum to the topbar /phone pill.
    _gvBridgeAvailable = GvBridgeStatus.IsAvailable;
    GvBridgeStatus.StatusChanged += OnGvStatusChanged;
    PhoneUnread.Set(UnreadSum);

    // GV Messages: fetch the voicemail list + the SMS thread list without blocking
    // the page. Both REST lists backstop the SignalR push (poll catches missed ones).
    _ = LoadVoicemailsAsync();
    _ = LoadThreadsAsync();

    // Poll for status every 5 seconds as fallback
    _pollTimer = new System.Timers.Timer(5000);
    _pollTimer.Elapsed += async (_, _) => await PollStatusAsync();
    _pollTimer.Start();
  }

  /// <summary>
  /// Fetches the phone system status and mirrors it into the app-wide
  /// <see cref="BellHealthService"/> so the topbar /phone fault badge tracks this page
  /// instead of lagging it by up to a full background-poll interval. Every assignment
  /// to <c>_systemStatus</c> goes through here so a future call site cannot silently
  /// skip the publish and leave the badge asserting a fault the page no longer shows.
  /// </summary>
  private async Task RefreshSystemStatusAsync()
  {
    var status = await PhoneApi.GetSystemStatusAsync();
    // A null return means the FETCH failed (PhoneApiService swallows and returns null),
    // which tells us nothing about the bell — so keep the last good snapshot instead of
    // blanking to Unknown. This is the in-tree idiom (LoadVoicemailsAsync keeps its last
    // good list; the call-history poll guards on non-null), and here it is load-bearing:
    // without it one dropped request makes an established fault blink out of the hero
    // AND the topbar badge, then reappear on the next poll. An indicator that flickers
    // off while the fault persists is the confidently-wrong screen all over again.
    // Distinct from a status that arrives WITH Ht801Reachable == null — that is the
    // server explicitly saying "not probed yet", and it does correctly map to Unknown.
    if (status != null)
    {
      _systemStatus = status;
    }
    BellHealth.Publish(_systemStatus);
  }

  /// <summary>
  /// Backs the hero's State C "Check again" button (bell-failure handoff §3.3).
  /// Re-reads the server's current view of ATA reachability. It does NOT force a fresh
  /// probe — that needs <c>POST /api/phone/bell/probe</c> (§6.7), which RotaryPhone has
  /// not shipped; this is the spec's declared fallback for that case.
  /// </summary>
  /// <remarks>
  /// The toast is not decoration. The most likely outcome of pressing "Check again" is
  /// that the ATA is still unreachable, and that outcome renders identically to the
  /// state the user was already looking at. Without an explicit acknowledgement the
  /// control is indistinguishable from a dead button. Severity follows the phone page's
  /// two-tier rule: recovery is a Success, an unchanged degraded condition is a calm
  /// Info — never red, because nothing new has broken.
  /// </remarks>
  private async Task CheckBellAsync()
  {
    await RefreshSystemStatusAsync();

    switch (BellHealthRules.FromSystemStatus(_systemStatus))
    {
      case Radio.Web.Models.BellHealth.Ok:
        NotificationService.Notify(NotificationSeverity.Success,
          "The phone can ring again", "The rotary phone is reachable.");
        break;
      case Radio.Web.Models.BellHealth.Suspect:
        NotificationService.Notify(NotificationSeverity.Info,
          "Still can't reach the phone", "Calls will still appear on this screen.");
        break;
      default:
        NotificationService.Notify(NotificationSeverity.Info,
          "Couldn't check just now", "Try again in a moment.");
        break;
    }

    await InvokeAsync(StateHasChanged);
  }

  private async Task RefreshAllAsync()
  {
    await RefreshSystemStatusAsync();
    var callState = await PhoneApi.GetCallStateAsync();
    if (callState != null) _callState = callState;
    _contacts = await PhoneApi.GetContactsAsync();
    _callHistory = await PhoneApi.GetCallHistoryAsync();
    await RefreshGvStatusAsync();
    RebuildMergedContacts();
    PhoneUnread.Set(UnreadSum);
    await InvokeAsync(StateHasChanged);
  }

  private async Task RefreshGvStatusAsync()
  {
    var bridgeTask = GvBridgeApi.GetStatusAsync();
    var trunkTask = GvTrunkApi.GetStatusAsync();
    await Task.WhenAll(bridgeTask, trunkTask);
    var bridgeStatus = bridgeTask.Result;
    if (bridgeStatus != null)
    {
      _gvBridgeAvailable = bridgeStatus.Available;
      _gvActiveMode = bridgeStatus.ActiveMode;
    }
    var trunkStatus = trunkTask.Result;
    if (trunkStatus != null)
    {
      _gvTrunkRegistered = trunkStatus.IsRegistered;
    }
  }

  private async Task PollStatusAsync()
  {
    if (_disposed || _polling) return;
    _polling = true;
    try
    {
      var available = await PhoneApi.IsAvailableAsync();
      if (_disposed) return;
      if (available != _isAvailable)
      {
        _isAvailable = available;
        if (available) await RefreshAllAsync();
        else await InvokeAsync(StateHasChanged);
      }
      else if (available)
      {
        var callState = await PhoneApi.GetCallStateAsync();
        if (callState != null) _callState = callState;
        await RefreshSystemStatusAsync();
        // Poll-based fallback for call history. The SignalR CallHistoryUpdated
        // event (OnCallHistoryUpdated) is the primary trigger, but if it's missed
        // — hub reconnect after a deploy/service restart, or not fired for a given
        // call path — the list would otherwise never catch up. This is the "next
        // poll will catch up" the OnCallHistoryUpdated catch-block assumes. Guard
        // on non-null so a transient fetch failure doesn't blank the existing list.
        var history = await PhoneApi.GetCallHistoryAsync();
        if (history != null) _callHistory = history;
        PhoneUnread.Set(UnreadSum);
        // Refresh GV status every 6th poll (30s) as SignalR fallback
        if (++_pollCount % 6 == 0)
        {
          await RefreshGvStatusAsync();

          // GV-12 backstop, on this poll's 30 s cadence. Marshalled onto the Blazor sync
          // context, and deliberately NOT awaited — BackstopRefetchAsync's remarks give both
          // reasons, and both are load-bearing.
          _ = InvokeAsync(BackstopRefetchAsync);
        }
        if (!_disposed) await InvokeAsync(StateHasChanged);
      }
    }
    catch { /* Polling failure is non-fatal */ }
    finally { _polling = false; }
  }

  // SignalR event handlers

  private void OnCallStateChanged(string phoneId, string state)
  {
    if (_disposed) return;
    _callState.CallState = state;
    _ = InvokeAsync(StateHasChanged);
  }

  private void OnIncomingCall(string phoneId, string phoneNumber)
  {
    if (_disposed) return;
    _callState.CallState = "Ringing";
    _callState.IncomingNumber = phoneNumber;
    _ = InvokeAsync(StateHasChanged);
  }

  private async void OnCallHistoryUpdated()
  {
    if (_disposed) return;
    try
    {
      _callHistory = await PhoneApi.GetCallHistoryAsync();
      PhoneUnread.Set(UnreadSum);
      if (!_disposed) await InvokeAsync(StateHasChanged);
    }
    catch { /* Non-fatal -- next poll will catch up */ }
  }

  private void OnSystemStatusChanged(object status)
  {
    if (_disposed) return;
    _ = Task.Run(async () =>
    {
      try
      {
        await RefreshSystemStatusAsync();
        if (!_disposed) await InvokeAsync(StateHasChanged);
      }
      catch { /* Non-fatal */ }
    });
  }

  private void OnRegistrationChanged(bool registered)
  {
    if (_disposed) return;
    _gvTrunkRegistered = registered;
    _ = InvokeAsync(StateHasChanged);
  }

  // GV Messages: the shared status poll drives the reconnecting banner and may
  // change the badge sum; reflect both and re-render.
  //
  // GV-12 — this is also the refetch trigger. The unhealthy→healthy transition of the shared
  // poll is precisely the instant a "Couldn't load…" panel becomes WRONG rather than merely
  // unlucky. One trigger, one clock.
  //
  // ⚠ The trigger is the HEALTH edge (GvBridgeStatus.IsHealthy), which is NOT the banner. The
  // banner above the panel is gated on GvAvailable → _gvBridgeAvailable →
  // GvBridgeStatus.IsAvailable, a single field; IsHealthy is the fuller shape and is the
  // stricter of the two — GvBridgeStatusService's own remarks say IsAvailable is allowed to be
  // true while IsHealthy is false. So this can fire while the banner is already clear, and that
  // ordering is intended: the stricter signal is the one worth spending upstream calls on.
  //
  // ⚠⚠ THIS IS THE ONLY MECHANISM BY WHICH A LONG-LIVED CIRCUIT EVER RECOVERS. A Blazor Server
  // circuit that drops and reconnects resumes the SAME component instances with the SAME
  // fields — OnInitializedAsync runs once per CIRCUIT, not once per connection, which is the
  // whole point of DisconnectedCircuitRetentionPeriod (Program.cs:69). So reconnection never
  // re-mounts and never re-fetches, however clean it is. Only a full page load does, which is
  // why the 2026-09-08 16:07 restart cleared every stuck panel and the preceding 83 minutes
  // cleared none. Plan GV-12 §0.2.
  private void OnGvStatusChanged(GvBridgeStatusDto? status)
  {
    if (_disposed) return;
    _gvBridgeAvailable = GvBridgeStatus.IsAvailable;
    PhoneUnread.Set(UnreadSum);

    var healthy = GvBridgeStatus.IsHealthy;
    var recovered = _gvHealthyLast == false && healthy;
    _gvHealthyLast = healthy;

    if (!recovered)
    {
      _ = InvokeAsync(StateHasChanged);
      return;
    }

    // Fired on the status service's poll thread, not the Blazor sync context. Marshal the
    // WHOLE body before touching component state — the same rule OnReadStateChanged and
    // OnGvSmsReceived already follow on this page.
    _ = InvokeAsync(RefetchAfterRecoveryAsync);
  }

  /// <summary>
  /// GV-12 — re-run the Messages fetches after the bridge came back, without user input.
  /// </summary>
  /// <remarks>
  /// ⚠ The open conversation is refetched ONLY when it is currently showing its error state.
  /// A successfully-loaded conversation is left alone: re-opening one costs 2-3 upstream Google
  /// calls (see RetryOpenThreadAsync's remarks) and would re-run the mark-read write-through for
  /// a thread whose read state is already settled. The lists are cheap by comparison — one call
  /// each — and are refreshed unconditionally, because a list that succeeded before the outage
  /// is stale rather than wrong and the badge sum depends on it.
  ///
  /// ⚠⚠ LoadOpenThreadMessagesAsync IS CALLED DIRECTLY, AND RetryOpenThreadAsync MUST NOT BE
  /// REUSED HERE. RetryOpenThreadAsync ends in MarkOpenThreadReadAsync — a DURABLE write to
  /// Google that clears the unread marker across every one of the owner's devices. That is
  /// correct for the Retry BUTTON, where a human is looking at the conversation the instant it
  /// renders. It is wrong here: this runs unattended, possibly hours after the user walked away
  /// from the kiosk, and would silently mark a conversation read that nobody has seen. It is
  /// also the direct inverse of the rule OpenThreadAsync states for exactly this situation —
  /// "the conversation never rendered, do NOT tell Google it was read". So the pane recovers its
  /// bodies and the unread marker is left for the human to clear by actually opening it.
  ///
  /// ⚠ The catch is a backstop against an UNEXPECTED throw, not the failure path. A failed list
  /// fetch does not throw — GvBridgeApiService swallows and returns null — so on the ordinary
  /// failure path this catch sees nothing. What that path does do, when a prior good list
  /// exists, is raise the page's existing calm "Couldn't refresh" warning toast from inside
  /// LoadThreadsAsync/LoadVoicemailsAsync, and keep the last good list. That is the page's
  /// established behaviour for a refresh that failed, and it is deliberately not suppressed
  /// here.
  /// </remarks>
  private async Task RefetchAfterRecoveryAsync()
  {
    if (_disposed || _gvRefetching) return;
    _gvRefetching = true;
    try
    {
      await LoadVoicemailsAsync();
      if (_disposed) return;
      await LoadThreadsAsync();
      if (_disposed) return;

      if (_openThreadError && _openThreadId != null)
      {
        await LoadOpenThreadMessagesAsync(_openThreadId);
      }
    }
    catch { /* unattended refresh — the next edge or the poll backstop retries */ }
    finally
    {
      _gvRefetching = false;
      if (!_disposed) await InvokeAsync(StateHasChanged);
    }
  }

  /// <summary>
  /// GV-12 backstop — re-run whichever Messages list is currently rendering its hard error,
  /// on the 30 s cadence of this page's own status poll, without user input.
  /// </summary>
  /// <remarks>
  /// The recovery edge in OnGvStatusChanged handles the case the row was filed for — the bridge
  /// went down and came back. It CANNOT handle a list fetch that failed while the bridge stayed
  /// healthy: GetSmsThreadsAsync returns null on any exception (a one-off timeout, a reset
  /// connection, a 500 on that route alone), the shared status poll never leaves healthy, and no
  /// edge ever occurs. Same stuck panel, no trigger. Plan GV-12 §0.5.
  ///
  /// ⚠ ERROR-GATED, NOT UNCONDITIONAL, and that is the difference between this and the backoff
  /// loop §0.6 rejected. It runs only while a surface is actually showing "Couldn't load…", so a
  /// healthy console adds zero calls, and a console stuck against a dead upstream adds two calls
  /// per 30 s rather than per 5 s. RotaryPhone's uptime is not settled — a confirmed
  /// session-starvation issue — so retry volume into them is a real cost, not a rounding error.
  ///
  /// ⚠⚠ THE GATE IS (error AND list == null), MIRRORING PhoneMessagesPanel'S OWN ERROR-RENDER
  /// CONDITION (ThreadsError &amp;&amp; Threads == null), AND THE SECOND HALF IS NOT REDUNDANT. An
  /// earlier version gated on the error flag alone, reasoning that the flag is only ever set
  /// when the list is null. That reasoning is false: BumpThread does `_threads ??= new()` and
  /// OnGvVoicemailReceived does `_voicemails ??= new()`, so a single inbound SignalR push during
  /// an outage leaves a NON-NULL list with the error flag still set. In that state the panel
  /// renders content, not an error — and the flag-only gate called it stuck. Two consequences,
  /// both bad: LoadThreadsAsync took its "keep the last good list" branch and fired an
  /// unrequested "Couldn't refresh" toast on an unattended kiosk, and it cleared the error flag
  /// on entry without re-setting it, permanently disarming this backstop for the rest of the
  /// circuit.
  ///
  /// ⚠ Dispatched via InvokeAsync from PollStatusAsync, which is what makes _gvRefetching,
  /// _threads and _voicemails dispatcher-only here. Running this body inline on the
  /// System.Timers.Timer thread mutated the lists off the Blazor sync context, against the rule
  /// this page states at OnReadStateChanged and OnGvSmsReceived.
  ///
  /// ⚠ And it is NOT awaited by PollStatusAsync, deliberately. Two list fetches are up to 20 s
  /// of HttpClient timeout; awaiting them inside the poll degrades the 5 s call-state and bell
  /// poll to ~25 s during precisely the window GV is broken — on an appliance whose primary job
  /// is answering the phone. The refetch is the lower-priority of the two and must not stall the
  /// higher.
  /// </remarks>
  private async Task BackstopRefetchAsync()
  {
    // Both early returns sit BEFORE the flag is set: an early return must never clear an
    // in-flight call's guard.
    if (_disposed || _gvRefetching) return;
    if (!((_threadsError && _threads == null) || (_voicemailError && _voicemails == null)))
    {
      return;
    }

    _gvRefetching = true;
    try
    {
      if (_voicemailError && _voicemails == null)
      {
        await LoadVoicemailsAsync();
        if (_disposed) return;
      }
      if (_threadsError && _threads == null)
      {
        await LoadThreadsAsync();
      }
    }
    catch { /* unattended refresh — the next poll or a recovery edge retries */ }
    finally
    {
      _gvRefetching = false;
      if (!_disposed) await InvokeAsync(StateHasChanged);
    }
  }

  // GV-4 (ADR-024 §9): the central join point for ALL THREE read-state signal paths —
  // our own mark route's returned DTO, the echoed broadcast (RotaryPhone re-broadcasts
  // unconditionally, including back to the originator), and the 502-deferred reconcile on
  // the next list/poll. The reconciler is idempotent on (id-or-threadId + isRead): an echo
  // of an already-applied mark is a no-op, so we skip StateHasChanged and never flicker.
  private void OnReadStateChanged(ReadStateChangedDto dto)
  {
    if (_disposed) return;
    // Fired on the SignalR receive thread (not the Blazor sync context). Marshal the
    // WHOLE body — list mutation included — onto the render context before touching
    // _voicemails/_threads, matching OnGvVoicemailReceived/OnGvSmsReceived. Reconciling
    // off-context would race a concurrent LoadVoicemailsAsync that replaces the list.
    _ = InvokeAsync(() =>
    {
      if (_disposed) return;
      var changed = false;

      if (string.Equals(dto.Kind, "Voicemail", StringComparison.OrdinalIgnoreCase))
      {
        if (_voicemails != null)
        {
          changed = ReadStateReconciler.ApplyVoicemail(_voicemails, dto.Id, dto.IsRead);
        }
        // dto.ThreadId is informational here; no thread-badge bump needed for v1.
      }
      else if (string.Equals(dto.Kind, "Sms", StringComparison.OrdinalIgnoreCase))
      {
        if (_threads != null)
        {
          changed = ReadStateReconciler.ApplyThread(_threads, dto.ThreadId, dto.IsRead);
        }
      }

      if (changed)                       // skip re-render on an echo of an already-applied mark
      {
        PhoneUnread.Set(UnreadSum);
        StateHasChanged();
      }
    });
  }

  // Messages refresh = re-fetch call history + voicemail + SMS threads (the
  // Messages data sources).
  private async Task RefreshMessagesAsync()
  {
    var history = await PhoneApi.GetCallHistoryAsync();
    if (history != null) _callHistory = history;
    await LoadVoicemailsAsync();
    await LoadThreadsAsync();
    PhoneUnread.Set(UnreadSum);
    await InvokeAsync(StateHasChanged);
  }

  // ── GV voicemail (PR2) ───────────────────────────────────────

  // GV Messages PR2 — voicemail fetch. REST is source-of-truth on (re)load; the
  // SignalR push only freshens. Keep last good list on a refresh failure (warning
  // toast, never an error wipe); only surface an error when we have nothing yet.
  private async Task LoadVoicemailsAsync()
  {
    _voicemailLoading = true; _voicemailError = false;
    var list = await GvBridgeApi.GetVoicemailsAsync();
    if (list != null)
    {
      _voicemails = list.Items.ToList();   // list endpoint is source-of-truth (ADR-024 §2)
    }
    else if (_voicemails == null)
    {
      _voicemailError = true;   // only show error if we have no prior good list
    }
    else
    {
      NotificationService.Notify(NotificationSeverity.Warning, "Couldn't refresh",
        "Showing the last update.");
    }
    _voicemailLoading = false;
    PhoneUnread.Set(UnreadSum);
    await InvokeAsync(StateHasChanged);
  }

  // New voicemail push (PhoneHubService.GvVoicemailReceived). HARD RULE: never
  // steal the screen, never pause audio — calm Info toast only, prepend + animate.
  private void OnGvVoicemailReceived(VoicemailItemDto vm)
  {
    if (_disposed) return;
    _voicemails ??= new();
    if (_voicemails.All(v => v.Id != vm.Id))
    {
      // New arrivals carry their authoritative isRead from the push DTO (ADR-024 §2);
      // do not re-seed from any local state.
      _voicemails.Insert(0, vm);
    }
    // Calm toast — never modal, never audio (hard rule). For v1 it's low-urgency Info.
    NotificationService.Notify(NotificationSeverity.Info, "New voicemail",
      $"{vm.FromName ?? vm.FromNumber}{(vm.DurationSeconds > 0 ? $" · {FormatVmDuration(vm.DurationSeconds)}" : "")}");
    PhoneUnread.Set(UnreadSum);
    // This handler runs on the SignalR receive thread (not the render sync
    // context), so FlagNewVoicemail — which calls StateHasChanged on the panel —
    // MUST be marshalled onto the render thread or it throws InvalidOperationException.
    _ = InvokeAsync(() =>
    {
      _messagesPanel?.FlagNewVoicemail(vm.Id);   // animate the row
      StateHasChanged();
    });
  }

  // Mark-heard (GV-4 / ADR-024): the SINGLE durable write path for voicemail read-state.
  // Optimistic flip (presentation-only) → durable write-through → idempotent reconcile.
  private async Task OnVoicemailHeard(string id)
  {
    if (_voicemails == null) return;
    // 1) Optimistic flip (presentation-only; no local persistence).
    ReadStateReconciler.ApplyVoicemail(_voicemails, id, isRead: true);
    PhoneUnread.Set(UnreadSum);
    await InvokeAsync(StateHasChanged);

    // 2) Durable write-through. 200 → authoritative DTO reconciles (idempotent — no flicker
    //    since the optimistic flip already set it). 502/404 → null; the optimistic flip stays
    //    and the next list/poll/push reconciles. The echoed ReadStateChanged also reconciles
    //    via OnReadStateChanged — same (id, isRead) key, so it's a no-op.
    var dto = await GvBridgeApi.MarkVoicemailReadAsync(id, isRead: true);
    if (dto != null)
    {
      var changed = ReadStateReconciler.ApplyVoicemail(_voicemails, dto.Id, dto.IsRead);
      if (changed)
      {
        PhoneUnread.Set(UnreadSum);
        await InvokeAsync(StateHasChanged);
      }
    }
  }

  private static string FormatVmDuration(int s)
  {
    var ts = TimeSpan.FromSeconds(s);
    return ts.TotalHours >= 1 ? ts.ToString(@"h\:mm\:ss") : ts.ToString(@"m\:ss");
  }

  // ── GV SMS (PR3) ─────────────────────────────────────────────

  // Fetch the thread list. On a transient refresh failure keep the last good
  // list (calm warning toast); only flag a hard error when there's nothing yet.
  private async Task LoadThreadsAsync()
  {
    _threadsLoading = true;
    _threadsError = false;
    var list = await GvBridgeApi.GetSmsThreadsAsync();
    if (list != null)
    {
      _threads = list.Threads.ToList();    // hasUnread is source-of-truth (ADR-024 §2)
    }
    else if (_threads == null)
    {
      _threadsError = true;
    }
    else
    {
      NotificationService.Notify(NotificationSeverity.Warning, "Couldn't refresh",
        "Showing the last update.");
    }
    _threadsLoading = false;
    PhoneUnread.Set(UnreadSum);
    await InvokeAsync(StateHasChanged);
  }

  // Open thread (GV-4 / ADR-024): optimistic flip (presentation-only) → durable
  // write-through (mark whole thread read) → idempotent reconcile. hasUnread from the
  // list endpoint is source-of-truth on (re)load; the optimistic flip is not replayed.
  private async Task OpenThreadAsync(string threadId)
  {
    _openThreadId = threadId;

    // 1) Optimistic flip (presentation-only). Remember what it was: if the bodies fail
    // to load we put the unread marker back (GV-8) rather than clearing the dot for a
    // conversation the user was never actually shown.
    var wasUnread = _threads?.FirstOrDefault(t => t.ThreadId == threadId)?.HasUnread ?? false;
    if (_threads != null)
    {
      ReadStateReconciler.ApplyThread(_threads, threadId, isRead: true);
    }

    var loaded = await LoadOpenThreadMessagesAsync(threadId);

    if (!loaded)
    {
      // The conversation never rendered. Do NOT tell Google it was read, and do not
      // spend the 2-3 further upstream calls MarkThreadRead costs inside what is almost
      // always a dead auth window. Restore the unread marker we optimistically cleared.
      // Deliberately NOT gated on _openThreadId: if the user has since opened another
      // thread, THIS thread's marker still has to go back, or a failed open silently
      // leaves a conversation the user never saw marked read for the rest of the
      // session (nothing re-fetches the thread list except a manual Refresh).
      await RestoreThreadUnreadAsync(threadId, wasUnread);
      return;
    }

    await MarkOpenThreadReadAsync(threadId);
  }

  // Put back the unread marker that OpenThreadAsync optimistically cleared, after the
  // conversation's bodies failed to load. No-op when the thread was already read.
  private async Task RestoreThreadUnreadAsync(string threadId, bool wasUnread)
  {
    if (wasUnread && _threads != null
        && ReadStateReconciler.ApplyThread(_threads, threadId, isRead: false))
    {
      PhoneUnread.Set(UnreadSum);
      await InvokeAsync(StateHasChanged);
    }
  }

  // Durable write-through (idempotent reconcile; 502/404 keep the optimistic flip).
  private async Task MarkOpenThreadReadAsync(string threadId)
  {
    var dto = await GvBridgeApi.MarkSmsThreadReadAsync(threadId, isRead: true);
    if (dto != null && _threads != null)
    {
      var changed = ReadStateReconciler.ApplyThread(_threads, dto.ThreadId, isRead: !dto.HasUnread);
      if (changed)
      {
        PhoneUnread.Set(UnreadSum);
        await InvokeAsync(StateHasChanged);
      }
    }
  }

  // Fetch the open conversation's bodies (GV-8 / UAT F-1). Returns TRUE iff the fetch
  // succeeded. The old body did `messages?.Messages.ToList() ?? new()`, which made a 502
  // byte-identical to a genuinely empty conversation and rendered it as "Start the
  // conversation below." A failure now sets _openThreadError and leaves the message list
  // NULL, so the pane's error branch owns the state instead of the empty branch.
  private async Task<bool> LoadOpenThreadMessagesAsync(string threadId)
  {
    // Drop the previous thread's bubbles BEFORE awaiting: they are not this thread's
    // history, and the pane's skeleton branch requires Messages == null to be reachable.
    _openThreadMessages = null;
    _openThreadError = false;
    _openThreadLoading = true;
    await InvokeAsync(StateHasChanged);

    var result = await GvBridgeApi.GetSmsThreadMessagesAsync(threadId);

    // The user may have opened a different thread while this fetch was in flight. The
    // newer open owns the PANE, so don't write this thread's messages or error flag
    // into it — but the READ-STATE decision still belongs to THIS thread, so report
    // the real outcome rather than a blanket failure. Pane state is scoped to
    // _openThreadId; read state is scoped to the threadId parameter.
    if (_openThreadId != threadId)
    {
      return result.IsSuccess;
    }

    if (result.IsSuccess)
    {
      _openThreadMessages = result.Value!.Messages.ToList();
    }
    else
    {
      _openThreadError = true;    // leave _openThreadMessages null — never `?? new()`
    }
    _openThreadLoading = false;
    PhoneUnread.Set(UnreadSum);
    await InvokeAsync(StateHasChanged);
    return result.IsSuccess;
  }

  // Retry from the conversation pane's error state. On failure this deliberately does
  // NOT repeat the mark-read write-through — a retry usually happens while the upstream
  // is still unhealthy, and each thread open already costs 2-3 upstream Google calls
  // (F-1-DIAGNOSIS § Scope-affecting notes). On SUCCESS the user is finally looking at
  // the conversation, so it must carry the same read-marking the failed open skipped —
  // otherwise the thread keeps its unread dot for the rest of the session.
  private async Task RetryOpenThreadAsync()
  {
    var threadId = _openThreadId;
    if (threadId == null)
    {
      return;
    }
    if (!await LoadOpenThreadMessagesAsync(threadId))
    {
      return;
    }
    if (_threads != null && ReadStateReconciler.ApplyThread(_threads, threadId, isRead: true))
    {
      PhoneUnread.Set(UnreadSum);
      await InvokeAsync(StateHasChanged);
    }
    await MarkOpenThreadReadAsync(threadId);
  }

  // Conversation closed (Back). Clear the open-thread state the page owns so a
  // later inbound for this thread is treated as closed (toast + bump, not a silent
  // append/de-dupe against a list that's no longer shown). Re-opening the thread
  // re-fetches its messages via OpenThreadAsync.
  private async Task CloseThreadAsync()
  {
    _openThreadId = null;
    _openThreadMessages = null;
    // GV-8 M-1 hygiene: also clear the error/loading flags, so re-opening a thread
    // that previously failed doesn't carry a stale flag into the pane before
    // LoadOpenThreadMessagesAsync's own reset (line ~698) runs.
    _openThreadError = false;
    _openThreadLoading = false;
    await InvokeAsync(StateHasChanged);
  }

  // Live inbound SMS. HARD RULE: when the affected thread is open, append the
  // bubble in place — no toast, no unread increment. Otherwise bump the thread to
  // the top, mark it unread, and fire a calm Info toast with a truncated preview.
  // Runs on the SignalR/background thread, so the whole mutation body is marshalled
  // onto the Blazor sync context via InvokeAsync before touching component state.
  private void OnGvSmsReceived(SmsMessageDto msg)
  {
    if (_disposed) return;
    _ = InvokeAsync(() =>
    {
      if (_disposed) return;

      // PHN-4 removed the optimistic→confirmed de-dupe that used to run here. It
      // collapsed a client-generated "temp-" bubble when the server echoed back a
      // send this console had made; owner decision D31 turned sending off
      // permanently, so no "temp-" message can be created any more and the match
      // could never fire. Outbound messages still arrive — sent from the phone
      // itself — and are appended by the ordinary path below.
      var threadOpen = _openThreadId == msg.ThreadId
                       && (_messagesPanel?.IsThreadOpen(msg.ThreadId) ?? false);

      if (threadOpen)
      {
        _openThreadMessages ??= new();
        if (_openThreadMessages.All(m => m.Id != msg.Id))
        {
          _openThreadMessages.Add(msg);
        }
        // Keep the thread at the top + preview fresh, but do NOT mark unread.
        BumpThread(msg, markUnread: false);
      }
      else
      {
        BumpThread(msg, markUnread: true);
        NotificationService.Notify(NotificationSeverity.Info,
          ResolveThreadName(msg.ThreadId, msg.CounterpartyNumber),
          Truncate(msg.Text));
      }

      PhoneUnread.Set(UnreadSum);
      StateHasChanged();
    });
  }

  // Move a thread to the top of the list (newest activity first), refreshing its
  // preview/timestamp. Insert a new thread row if this is the first message we've
  // seen for it. markUnread=false keeps an open thread read.
  private void BumpThread(SmsMessageDto msg, bool markUnread)
  {
    _threads ??= new();
    var idx = _threads.FindIndex(t => t.ThreadId == msg.ThreadId);
    if (idx >= 0)
    {
      var existing = _threads[idx];
      var t = existing with
      {
        HasUnread = markUnread || existing.HasUnread,
        LastMessageAt = msg.SentAt,
        LastMessagePreview = msg.Text
      };
      _threads.RemoveAt(idx);
      _threads.Insert(0, t);
    }
    else
    {
      _threads.Insert(0, new SmsThreadDto(msg.ThreadId, msg.CounterpartyNumber,
        null, msg.SentAt, markUnread, msg.Text));
    }
  }

  // Toast title: a contact/thread name when known, else the counterparty number.
  private string ResolveThreadName(string threadId, string counterpartyNumber)
  {
    var thread = _threads?.FirstOrDefault(t => t.ThreadId == threadId);
    if (thread != null && !string.IsNullOrWhiteSpace(thread.CounterpartyName))
    {
      return thread.CounterpartyName!;
    }
    var key = PhoneNumberNormalizer.Normalize(counterpartyNumber);
    if (key.Length > 0)
    {
      var match = MergedContacts.FirstOrDefault(c =>
        PhoneNumberNormalizer.Normalize(c.Phone) == key);
      if (match != null) return match.Name;
    }
    return counterpartyNumber;
  }

  private static string Truncate(string? s, int n = 80) =>
    string.IsNullOrEmpty(s) ? "" : (s!.Length <= n ? s : s[..n] + "…");

  private async Task SwitchModeAsync(string mode)
  {
    if (_switchingMode || _gvActiveMode == mode) return;
    _switchingMode = true;
    try
    {
      var success = await GvBridgeApi.SetAdapterModeAsync(mode);
      if (success)
      {
        _gvActiveMode = mode;
        NotificationService.Notify(NotificationSeverity.Success, "Mode Changed",
          $"Switched to {mode}");
      }
      else
      {
        NotificationService.Notify(NotificationSeverity.Error, "Mode Switch Failed",
          $"Could not switch to {mode}");
      }
    }
    finally
    {
      _switchingMode = false;
    }
  }

  private async Task ReregisterTrunkAsync()
  {
    var success = await GvTrunkApi.ReregisterAsync();
    if (success)
    {
      NotificationService.Notify(NotificationSeverity.Info, "Re-registration",
        "SIP trunk re-registration initiated");
    }
    else
    {
      NotificationService.Notify(NotificationSeverity.Error, "Re-registration Failed",
        "Could not initiate SIP trunk re-registration");
    }
  }

