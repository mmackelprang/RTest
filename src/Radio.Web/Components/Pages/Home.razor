@page "/"
@rendermode InteractiveServer

<PageTitle>Radio Console</PageTitle>

<div style="height: 100%; display: flex; gap: 2px; overflow: hidden;">
  <!-- Left: Now Playing (520px) -->
  <div class="panel" style="width: 520px; flex-shrink: 0;">
    <Radio.Web.Components.Shared.NowPlayingPanel />
  </div>

  <!-- Center (flex fill ~688px). UI-17: one tab strip for every source — queue, history, radio
       controls and the Bluetooth connect panel are all tabs of this one component, so the page no
       longer swaps it for RadioControlPanel. -->
  <div class="panel surface-raised" style="flex: 1;">
    <Radio.Web.Components.Shared.QueueHistoryPanel />
  </div>

  <!-- Right: Visualizer (710px) -->
  <div class="panel" style="width: 710px; flex-shrink: 0;">
    <Radio.Web.Components.Shared.VisualizerPanel />
  </div>
</div>
