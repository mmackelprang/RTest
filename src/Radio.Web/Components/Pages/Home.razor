@page "/"
@rendermode InteractiveServer
@inject AudioApiService AudioApi
@inject AudioStateHubService HubService
@inject ConfigurationApiService ConfigApi
@inject DevicesApiService DevicesApi
@inject ILogger<Home> Logger
@implements IAsyncDisposable

<PageTitle>Now Playing - Radio Console</PageTitle>

<div class="home-page" style="padding: 24px; height: 100%; display: flex; flex-direction: column; align-items: center; justify-content: center;">
  <!-- Now Playing Display -->
  <MudCard Elevation="2" Style="width: 100%; max-width: 800px; padding: 32px;">
    <MudCardContent>
      <div style="text-align: center;">
        <!-- Album Art or Generic Icon -->
        <div style="margin-bottom: 24px;">
          @if (string.IsNullOrEmpty(_albumArtUrl))
          {
            <MudIcon Icon="@Icons.Material.Filled.MusicNote" Style="font-size: 200px; color: var(--text-secondary);" />
          }
          else
          {
            <img src="@_albumArtUrl" alt="Album Art" style="width: 400px; height: 400px; object-fit: cover; border-radius: 8px;" />
          }
        </div>
        
        <!-- Track Info -->
        <MudText Typo="Typo.h3" Style="font-weight: 600; margin-bottom: 8px;">
          @(_title ?? "No Track Playing")
        </MudText>
        <MudText Typo="Typo.h5" Style="margin-bottom: 4px; color: var(--text-secondary);">
          @(_artist ?? "--")
        </MudText>
        <MudText Typo="Typo.h6" Style="color: var(--text-tertiary);">
          @(_album ?? "--")
        </MudText>
        
        <!-- Source Badge -->
        @if (!string.IsNullOrEmpty(_source))
        {
          <MudChip T="string" Color="Color.Primary" Style="margin-top: 16px;">@_source</MudChip>
        }
      </div>
    </MudCardContent>
  </MudCard>
  
  <!-- Transport Controls -->
  <div style="margin-top: 32px; display: flex; gap: 16px; align-items: center;">
    <MudIconButton Icon="@Icons.Material.Filled.Shuffle" 
                   Color="@(_isShuffleEnabled ? Color.Primary : Color.Default)" 
                   Size="Size.Large"
                   Style="min-width: 60px; min-height: 60px;"
                   OnClick="HandleShuffleAsync"
                   title="Shuffle" />
    
    <MudIconButton Icon="@Icons.Material.Filled.SkipPrevious" 
                   Color="Color.Default" 
                   Size="Size.Large"
                   Style="min-width: 60px; min-height: 60px;"
                   OnClick="HandlePreviousAsync"
                   title="Previous" />
    
    <MudIconButton Icon="@(_isPlaying ? Icons.Material.Filled.Pause : Icons.Material.Filled.PlayArrow)" 
                   Color="Color.Primary" 
                   Size="Size.Large"
                   Style="min-width: 80px; min-height: 80px; font-size: 48px;"
                   Class="primary-action"
                   OnClick="HandlePlayPauseAsync"
                   title="@(_isPlaying ? "Pause" : "Play")" />
    
    <MudIconButton Icon="@Icons.Material.Filled.SkipNext" 
                   Color="Color.Default" 
                   Size="Size.Large"
                   Style="min-width: 60px; min-height: 60px;"
                   OnClick="HandleNextAsync"
                   title="Next" />
    
    <MudIconButton Icon="@Icons.Material.Filled.Repeat" 
                   Color="@(_repeatMode != "Off" ? Color.Primary : Color.Default)" 
                   Size="Size.Large"
                   Style="min-width: 60px; min-height: 60px;"
                   OnClick="HandleRepeatAsync"
                   title="@($"Repeat: {_repeatMode}")" />
  </div>
  
  <!-- Progress Bar -->
  @if (!string.IsNullOrEmpty(_position) && !string.IsNullOrEmpty(_duration))
  {
    <div style="margin-top: 32px; width: 100%; max-width: 600px;">
      <MudProgressLinear Color="Color.Primary" Size="Size.Medium" Value="@_progressPercent" Style="height: 8px; border-radius: 4px;" />
      <div style="display: flex; justify-content: space-between; margin-top: 8px; font-size: 14px; color: var(--text-secondary);">
        <span>@_position</span>
        <span>@_duration</span>
      </div>
    </div>
  }
  
  <!-- Volume Control -->
  <div style="margin-top: 32px; width: 100%; max-width: 500px;">
    <div style="display: flex; align-items: center; gap: 16px;">
      <MudIconButton Icon="@(_isMuted ? Icons.Material.Filled.VolumeOff : Icons.Material.Filled.VolumeUp)" 
                     Color="Color.Default" 
                     OnClick="HandleMuteAsync"
                     title="@(_isMuted ? "Unmute" : "Mute")" />
      <MudSlider Value="_volume" ValueChanged="@((double v) => OnVolumeChanged(v))" Min="0" Max="1" Step="0.01" Style="flex: 1;" Color="Color.Primary">
        Volume: @((_volume * 100).ToString("F0"))%
      </MudSlider>
    </div>
  </div>
  
  <!-- Balance Control -->
  <div style="margin-top: 16px; width: 100%; max-width: 500px;">
    <div style="display: flex; align-items: center; gap: 16px;">
      <span style="min-width: 20px; text-align: center; color: var(--text-secondary);">L</span>
      <MudSlider Value="_balance" ValueChanged="@((double b) => OnBalanceChanged(b))" Min="-1" Max="1" Step="0.01" Style="flex: 1;" Color="Color.Primary">
        Balance: @(_balance == 0 ? "Center" : _balance < 0 ? $"L {(-_balance * 100):F0}%" : $"R {(_balance * 100):F0}%")
      </MudSlider>
      <span style="min-width: 20px; text-align: center; color: var(--text-secondary);">R</span>
    </div>
  </div>

  <!-- Audio Output Selection -->
  @if (_outputDevices != null && _outputDevices.Any())
  {
    <div style="margin-top: 24px; width: 100%; max-width: 500px;">
      <MudSelect T="string" 
                 Label="Audio Output" 
                 @bind-Value="_selectedOutputDevice" 
                 ValueChanged="OnOutputDeviceChanged"
                 Variant="Variant.Outlined" 
                 AnchorOrigin="Origin.BottomCenter">
        @foreach (var device in _outputDevices)
        {
          <MudSelectItem T="string" Value="@device.Id">@device.Name</MudSelectItem>
        }
      </MudSelect>
    </div>
  }
</div>

@code {
  private bool _isPlaying = false;
  private bool _isMuted = false;
  private bool _isShuffleEnabled = false;
  private string _repeatMode = "Off";
  private double _volume = 0.75;
  private double _balance = 0.0;
  private string? _title = null;
  private string? _artist = null;
  private string? _album = null;
  private string? _albumArtUrl = null;
  private string? _source = null;
  private string? _position = null;
  private string? _duration = null;
  private double _progressPercent = 0.0;
  private System.Threading.Timer? _timer;
  private List<AudioDeviceDto> _outputDevices = new();
  private string? _selectedOutputDevice = null;

  protected override async Task OnInitializedAsync()
  {
    try
    {
      Logger.LogInformation("Home.OnInitializedAsync starting");

      // Load user preferences first
      await LoadPreferencesAsync();
      Logger.LogDebug("Preferences loaded");

      // Load available output devices
      await LoadOutputDevicesAsync();
      Logger.LogDebug("Output devices loaded");

      // Subscribe to SignalR events for real-time updates
      HubService.PlaybackStateChanged += OnPlaybackStateChanged;
      HubService.NowPlayingChanged += OnNowPlayingChanged;
      HubService.VolumeChanged += OnVolumeChanged;
      Logger.LogDebug("Event handlers subscribed to AudioStateHubService");

      // Initial load (this will override preferences with actual current state)
      await RefreshPlaybackStateAsync();
      Logger.LogDebug("Initial playback state refreshed");

      // Fallback polling every 5 seconds if SignalR is disconnected
      _timer = new System.Threading.Timer(TimerCallback, null, TimeSpan.FromSeconds(5), TimeSpan.FromSeconds(5));

      Logger.LogInformation("Home.OnInitializedAsync completed successfully");
    }
    catch (Exception ex)
    {
      Logger.LogError(ex, "CRITICAL: Exception in Home.OnInitializedAsync - this will crash the Blazor circuit!");
      throw; // Re-throw to see the actual error
    }
  }

  private async void TimerCallback(object? state)
  {
    try
    {
      // Always poll since SignalR is disabled for debugging
      await RefreshPlaybackStateAsync();
      await InvokeAsync(StateHasChanged);
    }
    catch (ObjectDisposedException)
    {
      // Component was disposed, ignore
    }
    catch (Exception ex)
    {
      Logger.LogWarning(ex, "Error in timer callback");
    }
  }

  private async Task OnPlaybackStateChanged()
  {
    await RefreshPlaybackStateAsync();
    await InvokeAsync(StateHasChanged);
  }

  private async Task OnNowPlayingChanged()
  {
    await RefreshPlaybackStateAsync();
    await InvokeAsync(StateHasChanged);
  }

  private async Task OnVolumeChanged()
  {
    await RefreshPlaybackStateAsync();
    await InvokeAsync(StateHasChanged);
  }

  private async Task RefreshPlaybackStateAsync()
  {
    try
    {
      var state = await AudioApi.GetPlaybackStateAsync();
      if (state != null)
      {
        _isPlaying = state.IsPlaying;
        _isMuted = state.IsMuted;
        _isShuffleEnabled = state.IsShuffleEnabled;
        _repeatMode = state.RepeatMode;
        _volume = state.Volume;
        _balance = state.Balance;
        _position = state.Position;
        _duration = state.Duration;
        
        // Calculate progress percentage
        if (!string.IsNullOrEmpty(_position) && !string.IsNullOrEmpty(_duration))
        {
          if (TimeSpan.TryParse(_position, out var pos) && TimeSpan.TryParse(_duration, out var dur) && dur.TotalSeconds > 0)
          {
            _progressPercent = (pos.TotalSeconds / dur.TotalSeconds) * 100.0;
          }
        }
      }

      var nowPlaying = await AudioApi.GetNowPlayingAsync();
      if (nowPlaying != null)
      {
        _title = nowPlaying.Title;
        _artist = nowPlaying.Artist;
        _album = nowPlaying.Album;
        _albumArtUrl = nowPlaying.AlbumArtUrl;
        _source = nowPlaying.Source;
      }
    }
    catch (Exception)
    {
      // Silently fail to avoid disrupting UI updates
    }
  }

  private async Task HandlePlayPauseAsync()
  {
    Logger.LogInformation("HandlePlayPauseAsync called. Current state: IsPlaying={IsPlaying}", _isPlaying);
    try
    {
      if (_isPlaying)
      {
        Logger.LogDebug("Sending pause request to API");
        await AudioApi.UpdatePlaybackStateAsync(new UpdatePlaybackRequest("pause", null, null, null));
      }
      else
      {
        Logger.LogDebug("Sending start request to API");
        await AudioApi.StartAsync();
      }
      await RefreshPlaybackStateAsync();
      Logger.LogInformation("HandlePlayPauseAsync completed successfully");
    }
    catch (Exception ex)
    {
      Logger.LogError(ex, "Error in HandlePlayPauseAsync");
    }
  }

  private async Task HandleNextAsync()
  {
    await AudioApi.NextAsync();
    await RefreshPlaybackStateAsync();
  }

  private async Task HandlePreviousAsync()
  {
    await AudioApi.PreviousAsync();
    await RefreshPlaybackStateAsync();
  }

  private async Task HandleShuffleAsync()
  {
    await AudioApi.SetShuffleAsync(!_isShuffleEnabled);
    await RefreshPlaybackStateAsync();
  }

  private async Task HandleRepeatAsync()
  {
    await AudioApi.SetRepeatAsync(_repeatMode);
    await RefreshPlaybackStateAsync();
  }

  private async Task HandleMuteAsync()
  {
    await AudioApi.ToggleMuteAsync(!_isMuted);
    await RefreshPlaybackStateAsync();
  }

  private async Task HandleVolumeChangeAsync(double newVolume)
  {
    Logger.LogInformation("HandleVolumeChangeAsync called. Volume={Volume}", newVolume);
    try
    {
      _volume = newVolume;
      await AudioApi.SetVolumeAsync((float)newVolume);
      await SavePreferenceAsync("volume", newVolume);
      Logger.LogDebug("Volume change completed");
    }
    catch (Exception ex)
    {
      Logger.LogError(ex, "Error in HandleVolumeChangeAsync");
    }
  }

  private void OnVolumeChanged(double newVolume)
  {
    Logger.LogDebug("OnVolumeChanged event triggered. Volume={Volume}", newVolume);
    _volume = newVolume;
    _ = HandleVolumeChangeAsync(newVolume); // Fire and forget
  }
  
  private async Task HandleBalanceChangeAsync(double newBalance)
  {
    _balance = newBalance;
    await AudioApi.UpdatePlaybackStateAsync(new UpdatePlaybackRequest(null, null, null, (float)newBalance));
    await SavePreferenceAsync("balance", newBalance);
  }
  
  private void OnBalanceChanged(double newBalance)
  {
    _balance = newBalance;
    _ = HandleBalanceChangeAsync(newBalance); // Fire and forget
  }

  /// <summary>
  /// Load user preferences from Configuration API
  /// </summary>
  private async Task LoadPreferencesAsync()
  {
    try
    {
      var prefs = await ConfigApi.GetConfigurationAsync<Dictionary<string, object>>("ui.playback");
      if (prefs != null)
      {
        // Only apply preferences for user-controllable settings
        // Note: Playback state (isPlaying, shuffle, repeat) should come from the actual audio engine,
        // not from saved preferences, so we only load volume and balance
        if (prefs.TryGetValue("volume", out var volumeObj))
        {
          if (double.TryParse(volumeObj?.ToString(), out var volume))
          {
            _volume = volume;
          }
        }
        
        if (prefs.TryGetValue("balance", out var balanceObj))
        {
          if (double.TryParse(balanceObj?.ToString(), out var balance))
          {
            _balance = balance;
          }
        }

        // Load selected output device
        if (prefs.TryGetValue("outputDevice", out var outputDeviceObj))
        {
          _selectedOutputDevice = outputDeviceObj?.ToString();
        }
      }
      else
      {
        // Save defaults if no preferences exist
        await SavePreferenceAsync("volume", _volume);
        await SavePreferenceAsync("balance", _balance);
      }
    }
    catch (Exception ex)
    {
      // Fail silently, use defaults
      Logger.LogWarning(ex, "Failed to load playback preferences");
    }
  }

  /// <summary>
  /// Load available output devices from API
  /// </summary>
  private async Task LoadOutputDevicesAsync()
  {
    try
    {
      var devices = await DevicesApi.GetOutputDevicesAsync();
      if (devices != null)
      {
        _outputDevices = devices;
        
        // If no device is selected, try to get the current default
        if (string.IsNullOrEmpty(_selectedOutputDevice))
        {
          var currentDevice = await DevicesApi.GetCurrentOutputDeviceAsync();
          if (currentDevice != null)
          {
            _selectedOutputDevice = currentDevice.Id;
          }
          else
          {
            // Fall back to the first device
            _selectedOutputDevice = _outputDevices.FirstOrDefault()?.Id;
          }
        }
      }
    }
    catch (Exception ex)
    {
      Logger.LogWarning(ex, "Failed to load output devices");
    }
  }

  /// <summary>
  /// Handle output device selection change
  /// </summary>
  private async Task OnOutputDeviceChanged(string deviceId)
  {
    try
    {
      _selectedOutputDevice = deviceId;
      
      // Set the device via API
      var success = await DevicesApi.SetOutputDeviceAsync(deviceId);
      if (success)
      {
        // Save the preference
        await SavePreferenceAsync("outputDevice", deviceId);
        Logger.LogInformation("Output device changed to {DeviceId}", deviceId);
      }
      else
      {
        Logger.LogWarning("Failed to set output device to {DeviceId}", deviceId);
      }
    }
    catch (Exception ex)
    {
      Logger.LogError(ex, "Error changing output device");
    }
  }

  /// <summary>
  /// Save a single preference value to Configuration API
  /// </summary>
  private async Task SavePreferenceAsync(string key, object value)
  {
    try
    {
      await ConfigApi.UpdateConfigurationAsync("ui.playback", key, value);
    }
    catch (Exception ex)
    {
      // Fail silently, don't interrupt user workflow
      Logger.LogWarning(ex, "Failed to save preference {Key}", key);
    }
  }

  public async ValueTask DisposeAsync()
  {
    // Unsubscribe from SignalR events
    HubService.PlaybackStateChanged -= OnPlaybackStateChanged;
    HubService.NowPlayingChanged -= OnNowPlayingChanged;
    HubService.VolumeChanged -= OnVolumeChanged;

    _timer?.Dispose();
    await Task.CompletedTask;
  }
}
