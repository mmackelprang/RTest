@page "/"
@rendermode InteractiveServer

<PageTitle>Radio Console</PageTitle>

<div style="height: 100%; display: flex; gap: 0; overflow: hidden;">
  <!-- Left: Now Playing (~480px) -->
  <MudPaper Elevation="2" Style="width: 480px; flex-shrink: 0; height: 100%; overflow: hidden;">
    <Radio.Web.Components.Shared.NowPlayingPanel />
  </MudPaper>

  <!-- Center: Queue / History (flex fill) -->
  <MudPaper Elevation="2" Style="flex: 1; height: 100%; overflow: hidden;">
    <Radio.Web.Components.Shared.QueueHistoryPanel />
  </MudPaper>

  <!-- Right: Visualizer (~670px) -->
  <MudPaper Elevation="2" Style="width: 670px; flex-shrink: 0; height: 100%; overflow: hidden;">
    <Radio.Web.Components.Shared.VisualizerPanel />
  </MudPaper>
</div>
