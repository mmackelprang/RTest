@page "/bluetooth"
@using Radio.Web.Services.ApiClients
@using Radio.Web.Models
@inject BluetoothApiService BluetoothApi
@inject NotificationService NotificationService
@inject ILogger<BluetoothPage> Logger

<PageTitle>Bluetooth - Radio Console</PageTitle>

<div style="height: 100%; display: flex; gap: 2px; overflow: hidden;">
  <!-- Left: Adapter Status & Controls -->
  <div class="panel surface-raised" style="width: 50%; overflow-y: auto; padding: 16px;">
  <div style="display:flex; flex-direction:column; gap:12px">
    <div style="display:flex; flex-direction:row; gap:8px; align-items:center; justify-content:space-between">
      <div style="display:flex; flex-direction:row; gap:8px; align-items:center">
        <RadzenIcon Icon="bluetooth" Style="font-size:2rem" />
        <h5>Bluetooth</h5>
      </div>
      <RadzenButton Variant="Variant.Filled" ButtonStyle="ButtonStyle.Primary"
                    Click="RefreshStatusAsync" Icon="refresh" Text="Refresh" />
    </div>

    @if (_isLoading)
    {
      <RadzenProgressBar Mode="ProgressBarMode.Indeterminate" ProgressBarStyle="ProgressBarStyle.Primary" />
    }
    else if (_status == null)
    {
      <RadzenAlert AlertStyle="AlertStyle.Warning" AllowClose="false">
        Unable to reach the Bluetooth API. Make sure the API server is running.
      </RadzenAlert>
    }
    else
    {
      @* Adapter Status Card *@
      <RadzenCard Style="padding:16px">
        <div style="display:flex; flex-direction:column; gap:8px">
          <h6>Adapter Status</h6>

          <div style="display:flex; flex-direction:row; gap:16px; align-items:center">
            <div style="display:flex; flex-direction:column; gap:0">
              <span style="font-size:0.75rem; color:var(--text-low)">Available</span>
              <RadzenBadge BadgeStyle="@(_status.IsAvailable ? BadgeStyle.Success : BadgeStyle.Danger)" IsPill="true"
                           Text="@(_status.IsAvailable ? "Yes" : "No")" />
            </div>

            <div style="display:flex; flex-direction:column; gap:0">
              <span style="font-size:0.75rem; color:var(--text-low)">State</span>
              <RadzenBadge BadgeStyle="@GetStateBadgeStyle(_status.State)" IsPill="true"
                           Text="@_status.State" />
            </div>

            <div style="display:flex; flex-direction:column; gap:0">
              <span style="font-size:0.75rem; color:var(--text-low)">Discovery</span>
              <RadzenBadge BadgeStyle="@(_status.IsDiscovering ? BadgeStyle.Info : BadgeStyle.Light)" IsPill="true"
                           Text="@(_status.IsDiscovering ? "Scanning..." : "Idle")" />
            </div>

            <div style="flex:1"></div>

            @* Adapter Controls *@
            @if (_status.IsAvailable && _status.State == "On")
            {
              <RadzenButton Variant="Variant.Outlined" ButtonStyle="ButtonStyle.Warning" Size="ButtonSize.Small"
                            Click="StopAdapterAsync" Icon="bluetooth_disabled" Text="Disable" />
            }
            else if (_status.IsAvailable)
            {
              <RadzenButton Variant="Variant.Filled" ButtonStyle="ButtonStyle.Primary" Size="ButtonSize.Small"
                            Click="StartAdapterAsync" Icon="bluetooth" Text="Enable" />
            }
          </div>
        </div>
      </RadzenCard>

      @* Connected Device Card *@
      <RadzenCard Style="padding:16px">
        <div style="display:flex; flex-direction:column; gap:8px">
          <h6>Connected Device</h6>

          @if (_status.ConnectedDevice != null)
          {
            <div style="display:flex; flex-direction:row; gap:12px; align-items:center">
              <RadzenIcon Icon="bluetooth_connected" Style="font-size:2rem; color:var(--rz-success)" />
              <div style="display:flex; flex-direction:column; gap:0">
                <span style="font-size:1rem; font-weight:600">@_status.ConnectedDevice.Name</span>
                <span style="font-size:0.75rem; color:var(--text-low)">@_status.ConnectedDevice.Address</span>
              </div>
              <div style="flex:1"></div>
              <RadzenButton Variant="Variant.Outlined" ButtonStyle="ButtonStyle.Danger" Size="ButtonSize.Small"
                            Click="DisconnectAsync" Icon="link_off"
                            Disabled="@_isDisconnecting">
                @if (_isDisconnecting)
                {
                  <RadzenProgressBarCircular Size="ProgressBarCircularSize.Small" Mode="ProgressBarMode.Indeterminate" Style="margin-right:4px" />
                  <span>Disconnecting</span>
                }
                else
                {
                  <span>Disconnect</span>
                }
              </RadzenButton>
            </div>
          }
          else
          {
            <RadzenAlert AlertStyle="AlertStyle.Info" Size="AlertSize.Small" AllowClose="false">
              No device connected. Pair a device below, or connect a previously paired device.
            </RadzenAlert>
          }
        </div>
      </RadzenCard>
    }

  </div>
  </div>

  <!-- Right: Paired Devices & Discovery -->
  <div class="panel surface-raised" style="flex: 1; overflow-y: auto; padding: 16px;">
  @if (_status != null)
  {
    <div style="display:flex; flex-direction:column; gap:12px">
      @* Paired Devices *@
      <div style="background:var(--surface-raised); border:1px solid var(--surface-separator); border-radius:8px; padding:16px">

        <div style="display:flex; flex-direction:column; gap:8px">
          <h6>Paired Devices</h6>

          @if (_status.PairedDevices.Count == 0)
          {
            <RadzenAlert AlertStyle="AlertStyle.Info" Size="AlertSize.Small" AllowClose="false">No paired devices. Use Discovery below to find and pair devices.</RadzenAlert>
          }
          else
          {
            <RadzenDataGrid TItem="BluetoothDeviceDto" Data="@_status.PairedDevices" Density="Density.Compact">
              <Columns>
                <RadzenDataGridColumn TItem="BluetoothDeviceDto" Title="Name">
                  <Template Context="device">
                    <div style="display:flex; flex-direction:row; gap:4px; align-items:center">
                      <RadzenIcon Icon="bluetooth_connected" Style="@($"font-size:1.25rem; color:{(device.IsConnected ? "var(--rz-success)" : "var(--rz-text-color)")}")" />
                      <span>@device.Name</span>
                    </div>
                  </Template>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="BluetoothDeviceDto" Title="Address">
                  <Template Context="device">
                    <span style="font-size:0.875rem; font-family:monospace">@device.Address</span>
                  </Template>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="BluetoothDeviceDto" Title="Status">
                  <Template Context="device">
                    @if (device.IsConnected)
                    {
                      <RadzenBadge BadgeStyle="BadgeStyle.Success" IsPill="true" Text="Connected" />
                    }
                    else
                    {
                      <RadzenBadge BadgeStyle="BadgeStyle.Light" IsPill="true" Text="Paired" />
                    }
                  </Template>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="BluetoothDeviceDto" Title="Actions">
                  <Template Context="device">
                    <div style="display:flex; flex-direction:row; gap:4px">
                      @if (device.IsConnected)
                      {
                        <RadzenButton Variant="Variant.Text" ButtonStyle="ButtonStyle.Warning" Size="ButtonSize.Small"
                                      Click="@(() => DisconnectDeviceAsync(device.Address))"
                                      Disabled="@(_connectingAddress != null)"
                                      Icon="link_off" Text="Disconnect" />
                      }
                      else
                      {
                        <RadzenButton Variant="Variant.Text" ButtonStyle="ButtonStyle.Primary" Size="ButtonSize.Small"
                                      Click="@(() => ConnectDeviceAsync(device.Address))"
                                      Disabled="@(_connectingAddress != null)"
                                      Icon="link">
                          @if (_connectingAddress == device.Address)
                          {
                            <RadzenProgressBarCircular Size="ProgressBarCircularSize.Small" Mode="ProgressBarMode.Indeterminate" Style="margin-right:4px" />
                            <span>Connecting...</span>
                          }
                          else
                          {
                            <span>Connect</span>
                          }
                        </RadzenButton>
                        <RadzenButton Variant="Variant.Text" ButtonStyle="ButtonStyle.Danger" Size="ButtonSize.Small"
                                      Click="@(() => UnpairAsync(device.Address))"
                                      Disabled="@(_connectingAddress != null)" Text="Unpair" />
                      }
                    </div>
                  </Template>
                </RadzenDataGridColumn>
              </Columns>
            </RadzenDataGrid>
          }
        </div>
      </div>

      @* Discovery Section *@
      <div style="background:var(--surface-raised); border:1px solid var(--surface-separator); border-radius:8px; padding:16px">
        <div style="display:flex; flex-direction:column; gap:8px">
          <div style="display:flex; flex-direction:row; gap:8px; align-items:center; justify-content:space-between">
            <h6>Device Discovery</h6>
            @if (_status.IsDiscovering)
            {
              <RadzenButton Variant="Variant.Outlined" ButtonStyle="ButtonStyle.Warning" Size="ButtonSize.Small"
                            Click="StopDiscoveryAsync" Icon="stop" Text="Stop Scan" />
            }
            else
            {
              <RadzenButton Variant="Variant.Filled" ButtonStyle="ButtonStyle.Primary" Size="ButtonSize.Small"
                            Click="StartDiscoveryAsync" Icon="search"
                            Disabled="@(!_status.IsAvailable)" Text="Start Scan" />
            }
          </div>

          @if (_status.IsDiscovering)
          {
            <RadzenProgressBar Mode="ProgressBarMode.Indeterminate" ProgressBarStyle="ProgressBarStyle.Info" />
          }

          @if (_status.DiscoveredDevices.Count == 0)
          {
            <RadzenAlert AlertStyle="AlertStyle.Info" Size="AlertSize.Small" AllowClose="false">
              @if (_status.IsDiscovering)
              {
                <span>Scanning for nearby Bluetooth devices...</span>
              }
              else
              {
                <span>No devices discovered. Click "Start Scan" to search for nearby devices.</span>
              }
            </RadzenAlert>
          }
          else
          {
            <RadzenDataGrid TItem="BluetoothDeviceDto" Data="@_status.DiscoveredDevices" Density="Density.Compact">
              <Columns>
                <RadzenDataGridColumn TItem="BluetoothDeviceDto" Title="Name">
                  <Template Context="device">
                    <div style="display:flex; flex-direction:row; gap:4px; align-items:center">
                      <RadzenIcon Icon="bluetooth_searching" Style="font-size:1.25rem" />
                      <span>@(string.IsNullOrEmpty(device.Name) ? "(Unknown)" : device.Name)</span>
                    </div>
                  </Template>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="BluetoothDeviceDto" Title="Address">
                  <Template Context="device">
                    <span style="font-size:0.875rem; font-family:monospace">@device.Address</span>
                  </Template>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="BluetoothDeviceDto" Title="Actions">
                  <Template Context="device">
                    @if (device.IsPaired)
                    {
                      <RadzenBadge BadgeStyle="BadgeStyle.Success" IsPill="true" Text="Already Paired" />
                    }
                    else
                    {
                      <RadzenButton Variant="Variant.Text" ButtonStyle="ButtonStyle.Primary" Size="ButtonSize.Small"
                                    Click="@(() => PairAsync(device.Address))"
                                    Disabled="@(_pairingAddress == device.Address)">
                        @if (_pairingAddress == device.Address)
                        {
                          <RadzenProgressBarCircular Size="ProgressBarCircularSize.Small" Mode="ProgressBarMode.Indeterminate" Style="margin-right:4px" />
                          <span>Pairing...</span>
                        }
                        else
                        {
                          <span>Pair</span>
                        }
                      </RadzenButton>
                    }
                  </Template>
                </RadzenDataGridColumn>
              </Columns>
            </RadzenDataGrid>
          }
        </div>
      </div>
    </div>
  }
  </div>
</div>

@code {
  private BluetoothStatusDto? _status;
  private bool _isLoading = true;
  private bool _isDisconnecting;
  private string? _pairingAddress;
  private string? _connectingAddress;

  protected override async Task OnInitializedAsync()
  {
    await RefreshStatusAsync();
  }

  private async Task RefreshStatusAsync()
  {
    try
    {
      _isLoading = true;
      StateHasChanged();

      _status = await BluetoothApi.GetStatusAsync();
    }
    catch (Exception ex)
    {
      Logger.LogError(ex, "Error loading Bluetooth status");
      NotificationService.Notify(NotificationSeverity.Error, "Error", "Error loading Bluetooth status");
    }
    finally
    {
      _isLoading = false;
      StateHasChanged();
    }
  }

  private async Task StartAdapterAsync()
  {
    try
    {
      var success = await BluetoothApi.StartAsync();
      if (success)
      {
        NotificationService.Notify(NotificationSeverity.Success, "Bluetooth", "Bluetooth adapter enabled");
        await RefreshStatusAsync();
      }
      else
      {
        NotificationService.Notify(NotificationSeverity.Warning, "Bluetooth", "Failed to enable Bluetooth adapter");
      }
    }
    catch (Exception ex)
    {
      Logger.LogError(ex, "Error enabling Bluetooth adapter");
      NotificationService.Notify(NotificationSeverity.Error, "Error", "Error enabling Bluetooth adapter");
    }
  }

  private async Task StopAdapterAsync()
  {
    try
    {
      var success = await BluetoothApi.StopAsync();
      if (success)
      {
        NotificationService.Notify(NotificationSeverity.Success, "Bluetooth", "Bluetooth adapter disabled");
        await RefreshStatusAsync();
      }
      else
      {
        NotificationService.Notify(NotificationSeverity.Warning, "Bluetooth", "Failed to disable Bluetooth adapter");
      }
    }
    catch (Exception ex)
    {
      Logger.LogError(ex, "Error disabling Bluetooth adapter");
      NotificationService.Notify(NotificationSeverity.Error, "Error", "Error disabling Bluetooth adapter");
    }
  }

  private async Task StartDiscoveryAsync()
  {
    try
    {
      var success = await BluetoothApi.StartDiscoveryAsync();
      if (success)
      {
        NotificationService.Notify(NotificationSeverity.Info, "Discovery", "Discovery started — scanning for devices");
        await RefreshStatusAsync();
      }
      else
      {
        NotificationService.Notify(NotificationSeverity.Warning, "Discovery", "Failed to start discovery");
      }
    }
    catch (Exception ex)
    {
      Logger.LogError(ex, "Error starting Bluetooth discovery");
      NotificationService.Notify(NotificationSeverity.Error, "Error", "Error starting discovery");
    }
  }

  private async Task StopDiscoveryAsync()
  {
    try
    {
      var success = await BluetoothApi.StopDiscoveryAsync();
      if (success)
      {
        NotificationService.Notify(NotificationSeverity.Info, "Discovery", "Discovery stopped");
        await RefreshStatusAsync();
      }
      else
      {
        NotificationService.Notify(NotificationSeverity.Warning, "Discovery", "Failed to stop discovery");
      }
    }
    catch (Exception ex)
    {
      Logger.LogError(ex, "Error stopping Bluetooth discovery");
      NotificationService.Notify(NotificationSeverity.Error, "Error", "Error stopping discovery");
    }
  }

  private async Task PairAsync(string address)
  {
    try
    {
      _pairingAddress = address;
      StateHasChanged();

      var success = await BluetoothApi.PairAsync(address);
      if (success)
      {
        NotificationService.Notify(NotificationSeverity.Success, "Pairing", "Device paired successfully");
        await RefreshStatusAsync();
      }
      else
      {
        NotificationService.Notify(NotificationSeverity.Warning, "Pairing", "Failed to pair device");
      }
    }
    catch (Exception ex)
    {
      Logger.LogError(ex, "Error pairing Bluetooth device {Address}", address);
      NotificationService.Notify(NotificationSeverity.Error, "Error", "Error pairing device");
    }
    finally
    {
      _pairingAddress = null;
      StateHasChanged();
    }
  }

  private async Task UnpairAsync(string address)
  {
    try
    {
      var success = await BluetoothApi.UnpairAsync(address);
      if (success)
      {
        NotificationService.Notify(NotificationSeverity.Success, "Unpair", "Device unpaired");
        await RefreshStatusAsync();
      }
      else
      {
        NotificationService.Notify(NotificationSeverity.Warning, "Unpair", "Failed to unpair device");
      }
    }
    catch (Exception ex)
    {
      Logger.LogError(ex, "Error unpairing Bluetooth device {Address}", address);
      NotificationService.Notify(NotificationSeverity.Error, "Error", "Error unpairing device");
    }
  }

  private async Task DisconnectAsync()
  {
    try
    {
      _isDisconnecting = true;
      StateHasChanged();

      var success = await BluetoothApi.DisconnectAsync();
      if (success)
      {
        NotificationService.Notify(NotificationSeverity.Success, "Bluetooth", "Device disconnected");
        await RefreshStatusAsync();
      }
      else
      {
        NotificationService.Notify(NotificationSeverity.Warning, "Bluetooth", "Failed to disconnect device");
      }
    }
    catch (Exception ex)
    {
      Logger.LogError(ex, "Error disconnecting Bluetooth device");
      NotificationService.Notify(NotificationSeverity.Error, "Error", "Error disconnecting device");
    }
    finally
    {
      _isDisconnecting = false;
      StateHasChanged();
    }
  }

  private async Task ConnectDeviceAsync(string address)
  {
    try
    {
      _connectingAddress = address;
      StateHasChanged();

      var success = await BluetoothApi.ConnectAsync(address);
      if (success)
      {
        NotificationService.Notify(NotificationSeverity.Success, "Bluetooth", "Connected to device");
        await RefreshStatusAsync();
      }
      else
      {
        NotificationService.Notify(NotificationSeverity.Warning, "Bluetooth", "Failed to connect — device may be out of range or need re-pairing");
      }
    }
    catch (Exception ex)
    {
      Logger.LogError(ex, "Error connecting to Bluetooth device {Address}", address);
      NotificationService.Notify(NotificationSeverity.Error, "Error", "Error connecting to device");
    }
    finally
    {
      _connectingAddress = null;
      StateHasChanged();
    }
  }

  private async Task DisconnectDeviceAsync(string address)
  {
    try
    {
      _connectingAddress = address;
      StateHasChanged();

      var success = await BluetoothApi.DisconnectAsync(address);
      if (success)
      {
        NotificationService.Notify(NotificationSeverity.Success, "Bluetooth", "Device disconnected");
        await RefreshStatusAsync();
      }
      else
      {
        NotificationService.Notify(NotificationSeverity.Warning, "Bluetooth", "Failed to disconnect device");
      }
    }
    catch (Exception ex)
    {
      Logger.LogError(ex, "Error disconnecting Bluetooth device {Address}", address);
      NotificationService.Notify(NotificationSeverity.Error, "Error", "Error disconnecting device");
    }
    finally
    {
      _connectingAddress = null;
      StateHasChanged();
    }
  }

  private static BadgeStyle GetStateBadgeStyle(string state)
  {
    return state switch
    {
      "On" => BadgeStyle.Success,
      "Off" => BadgeStyle.Danger,
      _ => BadgeStyle.Light
    };
  }
}
