<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>

    <!-- NuGet package metadata -->
    <PackageId>RTLSDRCore</PackageId>
    <Version>1.0.0</Version>
    <Description>Modern C# library for RTL-SDR radio receivers with support for AM, FM, SW, AIR, WB, and VHF bands. Includes DSP demodulators (AM, FM, SSB), stereo FM decoder, RDS, band presets, and a hardware abstraction layer.</Description>
    <Authors>Mark Mackelprang</Authors>
    <Copyright>Copyright (c) 2026 Mark Mackelprang</Copyright>
    <PackageTags>sdr;rtl-sdr;radio;am;fm;shortwave;aircraft;weather;vhf;dsp;demodulator;rds</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/mmackelprang/RTest</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <!-- Core Serilog only — consumers configure their own sinks -->
    <PackageReference Include="Serilog" Version="4.0.0" />
  </ItemGroup>

</Project>
