<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework Condition="$([MSBuild]::IsOSPlatform('Windows'))">net10.0-windows10.0.19041.0</TargetFramework>
    <TargetFramework Condition="!$([MSBuild]::IsOSPlatform('Windows'))">net10.0</TargetFramework>
    <SupportedOSPlatformVersion Condition="$([MSBuild]::IsOSPlatform('Windows'))">10.0.19041.0</SupportedOSPlatformVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Serilog.Sinks.Async" Version="2.1.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.0" />
    <!-- Direct pin to override the vulnerable transitive Microsoft.OpenApi 2.0.0
         pulled in by Microsoft.AspNetCore.OpenApi (which still declares 2.0.0 as
         of the latest 10.0.x servicing release). 2.0.0 is affected by
         CVE-2026-49451 / GHSA-v5pm-xwqc-g5wc (uncontrolled recursion on circular
         schema refs -> stack overflow), flagged as NU1903 and, because Release
         builds treat warnings as errors, breaking the full-solution build.
         2.7.5 is the first patched version in the 2.x line; API-compatible with
         the >=2.0.0 requirement of Microsoft.AspNetCore.OpenApi. -->
    <PackageReference Include="Microsoft.OpenApi" Version="2.7.5" />
    <PackageReference Include="Scalar.AspNetCore" Version="2.*" />
    <PackageReference Include="Serilog.AspNetCore" Version="8.*" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Radio.Configuration\Radio.Configuration.csproj" />
    <ProjectReference Include="..\Radio.Core\Radio.Core.csproj" />
    <ProjectReference Include="..\Radio.Infrastructure\Radio.Infrastructure.csproj" />
    <ProjectReference Include="..\Radio.Metrics\Radio.Metrics.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- Expose `internal` helpers (UpdateCurrentMatchAnchor and friends) to the
         test project so unit tests can exercise the private/internal anchor
         logic without going through full SignalR/HostedService plumbing. -->
    <InternalsVisibleTo Include="Radio.API.Tests" />
  </ItemGroup>
</Project>
