{
  "$schema": "https://json.schemastore.org/appsettings.json",
  "Kestrel": {
    "Endpoints": {
      "Http": {
        "Url": "http://0.0.0.0:5000"
      }
    }
  },
  "Serilog": {
    "Using": [
      "Serilog.Sinks.File",
      "Serilog.Sinks.Async"
    ],
    "//": "LOG-2: Radio.Infrastructure.Audio and Radio.Infrastructure.Platform.Bluetooth are held at Warning - measured on the box, Audio.Sources (the SDR drift line) was 11.1k of 69.8k file lines/day, on a box where log volume is an audio problem. Audio.Services (source switching, announcements) and Audio.SoundFlow (engine and device selection) stay at Information: ~600 lines/day, and the triage signal for AUD-73/74 and device faults. Every one of these is a runtime switch (LOG-5): their Information lines are toggled, not deleted (O7) - PUT /api/system/logging/levels/<namespace> {\"level\":\"Information\"}, then POST .../reset. scripts/research/bt_*.py read the FILE sink and need both Audio and Platform.Bluetooth raised. Set here, not in deploy/*/appsettings.Production.json: that overlay is seed-only and never reaches an installed box.",
    "MinimumLevel": {
      "Default": "Warning",
      "Override": {
        "Radio": "Information",
        "Radio.Infrastructure.Audio": "Warning",
        "Radio.Infrastructure.Audio.Services": "Information",
        "Radio.Infrastructure.Audio.SoundFlow": "Information",
        "Radio.Infrastructure.Platform.Bluetooth": "Warning",
        "Radio.Fingerprinting": "Information",
        "RTLSDRCore": "Information",
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.Hosting.Lifetime": "Information"
      }
    },
    "WriteTo": [
      {
        "Name": "Async",
        "Args": {
          "configure": [
            {
              "Name": "File",
              "Args": {
                "path": "./logs/radio-.txt",
                "rollingInterval": "Day",
                "retainedFileCountLimit": 7,
                "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} [{Level:u3}] [{SourceContext}] {Message:lj}{NewLine}{Exception}",
                "fileSizeLimitBytes": 52428800,
                "rollOnFileSizeLimit": true
              }
            }
          ]
        }
      }
    ],
    "Enrich": [
      "FromLogContext"
    ]
  },
  "AllowedHosts": "*",
  "Devices": {
    "Vinyl": {
      "USBPort": ""
    }
  },
  "Database": {
    "RootPath": "./data",
    "ConfigurationSubdirectory": "config",
    "ConfigurationFileName": "configuration.db",
    "FingerprintingSubdirectory": "fingerprints",
    "FingerprintingFileName": "fingerprints.db",
    "SecretsSubdirectory": "secrets",
    "SecretsFileName": "secrets.db",
    "BackupSubdirectory": "backups",
    "BackupRetentionDays": 30
  },
  "BandMap": {
    "//": "AUD-76 band map, per band since AUD-91. Each band's map is stored at <Database:RootPath>/bandmap/<band>.json (fm.json, wb.json, air.json, vhf.json); AM and SW are below the tuner's range and are never swept. The timer sweeps only the radio's current band: silently while the RTL-SDR is idle; while the radio source holds it, only while the console is asleep (ISleepService.IsSleeping). POST /api/radio/bandmap/scan?band= sweeps on request, muting a playing radio for the sweep (~21 s FM, ~30 s AIR, seconds for WB and VHF). AUD-100: Scan Up/Down hops between the stations of the band's map while it is at most ScanMapMaxAgeMinutes old (0 = always seek live); each live-seek stop is kept at bandmap/<band>-seek.json until the next sweep of that frequency.",
    "Enabled": true,
    "InitialDelaySeconds": 120,
    "RescanIntervalMinutes": 60,
    "SweepGainDb": 28.0,
    "SamplesPerMeasurement": 16384,
    "ScanMapMaxAgeMinutes": 1440
  },
  "DataProtection": {
    "//": "Key ring for encrypted secrets. Explicit + deploy-safe: lives under the persistent data root (survives Deploy-ToLinux.ps1's rsync --delete of api/) and is HOME-independent. Resolves relative to the process working directory -> /opt/radio-console/data/keys on the box. See design/plans/SECRET-KEYRING-INVESTIGATION.md.",
    "KeysPath": "./data/keys"
  },
  "ManagedConfiguration": {
    "DefaultStoreType": "Sqlite",
    "BasePath": "./config",
    "JsonExtension": ".json",
    "SqliteFileName": "configuration.db",
    "SecretsFileName": "secrets",
    "BackupPath": "./config/backups",
    "AutoSave": true,
    "BackupRetentionDays": 30
  },
  "Metrics": {
    "Enabled": true,
    "FlushIntervalSeconds": 60,
    "DatabasePath": "./data/metrics.db",
    "RetentionMinuteData": 120,
    "RetentionHourData": 48,
    "RetentionDayData": 365,
    "RollupIntervalMinutes": 60
  },
  "Fingerprinting": {
    "Enabled": true,
    "UseShazamForAllSources": false,
    "SampleDurationSeconds": 15,
    "MinimumConfidenceThreshold": 0.5,
    "DuplicateSuppressionMinutes": 5,
    "MinimumSecondsBetweenSongChanges": 20,
    "DatabasePath": "./data/fingerprints.db",
    "MusicBrainz": {
      "BaseUrl": "https://musicbrainz.org/ws/2",
      "ApplicationName": "RadioConsole",
      "ApplicationVersion": "1.0.0",
      "ContactEmail": "mark@mackelprang.com",
      "MaxRequestsPerSecond": 1,
      "TimeoutSeconds": 10
    },
    "SongRec": {
      "Enabled": true,
      "SongRecPath": "",
      "TimeoutSeconds": 15
    }
  },
  "PlayHistory": {
    "RetentionEnabled": true,
    "RetentionDays": 180,
    "PruneIntervalHours": 24
  },
  "Diagnostics": {
    "CaptureBaseDirectory": "data/diagnostics",
    "RetentionEnabled": true,
    "MaxRetainedRuns": 20,
    "RetentionDays": 7
  },
  "AudioEngine": {
    "SampleRate": 48000,
    "Channels": 2,
    "BufferSize": 1024,
    "HotPlugIntervalSeconds": 5,
    "OutputBufferSizeSeconds": 5,
    "StreamReaderLagSeconds": 0.2,
    "EnableHotPlugDetection": true
  },
  "AudioOutput": {
    "Local": {
      "Enabled": true,
      "PreferredDeviceId": "",
      "DefaultVolume": 0.8
    },
    "GoogleCast": {
      "Enabled": true,
      "ApplicationId": "567E3DBA",
      "DiscoveryTimeoutSeconds": 10,
      "StartupConnectTimeoutSeconds": 40,
      "DefaultVolume": 0.7,
      "StreamingMode": "HttpMp3",
      "DirectChannelChunkSizeMs": 100,
      "DirectChannelNamespace": "urn:x-cast:com.radioconsole.audio"
    },
    "HttpStream": {
      "Enabled": true,
      "Port": 8080,
      "EndpointPath": "/stream/audio",
      "ContentType": "audio/wav",
      "SampleRate": 48000,
      "Channels": 2,
      "BitsPerSample": 16,
      "MaxConcurrentClients": 10,
      "ClientBufferSize": 65536,
      "Mp3Bitrate": 320
    }
  },
  "Audio": {
    "DefaultSource": "FilePlayer",
    "DuckingPercentage": 20,
    "DuckingPolicy": "FadeSmooth",
    "DuckingAttackMs": 100,
    "DuckingReleaseMs": 500
  },
  "AudioPreferences": {
    "CurrentSource": "FilePlayer",
    "CurrentOutput": "",
    "MasterVolume": 75
  },
  "TTS": {
    "GoogleAPIKey": "${secret:tts_google_api_key}",
    "AzureAPIKey": "${secret:tts_azure_api_key}",
    "AzureRegion": "eastus",
    "DefaultEngine": "Google",
    "DefaultVoice": "en-US-Standard-A",
    "DefaultSpeed": 1.0,
    "DefaultPitch": 1.0
  },
  "FilePlayer": {
    "RootDirectory": "media/audio",
    "SupportedExtensions": [
      ".mp3",
      ".flac",
      ".wav",
      ".ogg",
      ".aac",
      ".m4a",
      ".wma"
    ],
    "BookmarkedPaths": [
      {
        "Path": "/mnt/nas_media/Music",
        "Label": "NAS Music Library",
        "Tag": "music"
      },
      {
        "Path": "/opt/radio-console/media/audio",
        "Label": "Local Audio Files",
        "Tag": "sounds"
      }
    ],
    "MaxFolderTracks": 500,
    "FolderScanTimeoutSeconds": 20
  },
  "FilePlayerPreferences": {
    "LastSongPlayed": "",
    "SongPositionMs": 0,
    "Shuffle": false,
    "Repeat": "Off"
  },
  "NotificationSounds": {
    "Directory": "media/sounds"
  },
  "Bluetooth": {
    "DeviceName": "Grandpas Radio",
    "AutoAcceptConnections": true,
    "RequirePairing": false,
    "EnableOnStartup": true,
    "AutoSwitchOnConnect": true,
    "AudioQuality": "High",
    "EnableA2dpSink": true,
    "EnableMediaSessionMonitoring": true,
    "AutoReconnect": true,
    "ReconnectBaseDelayMs": 3000,
    "ReconnectMaxDelayMs": 60000,
    "MaxReconnectAttempts": 20,
    "OnProcessStallThresholdMs": 5000,
    "WatchdogTickIntervalMs": 2000,
    "ConsecutiveStalledChecks": 3,
    "AutoSwitchProbeWindowMs": 5000,
    "AutoSwitchMaxWaitMs": 60000,
    "CaptureNodeRescanIntervalMs": 1000,
    "UseInputResampler": true,
    "InputResamplerInitialRatio": 1.00025,
    "Pbap": {
      "AutoSyncOnConnect": true,
      "SyncStaleThresholdHours": 24,
      "TransferTimeoutSeconds": 30
    }
  },
  "BluetoothPreferences": {
    "LastConnectedDevice": "",
    "PairedDevices": [],
    "TrustedDevices": []
  },
  "Sleep": {
    "PanelOffAfterMinutes": 0,
    "EncoderStableSeconds": 30,
    "WakeGraceMilliseconds": 2000,
    "SessionBusAddress": "unix:path=/run/user/1000/bus"
  },
  "RotaryEncoder": {
    "Enabled": true,
    "VendorId": 51966,
    "ProductId": 16389,
    "DevicePath": "",
    "PollIntervalMs": 10,
    "VolumeStepPercent": 1,
    "ReconnectDelayMs": 2000
  },
  "PhoneIntegration": {
    "Enabled": false,
    "HubUrl": "http://radio:5004/hub",
    "ContactsApiBaseUrl": "http://radio:5004",
    "RingSoundPath": "media/sounds/phone-ring.wav",
    "RingPriority": 9,
    "AnnouncementPriority": 9,
    "ReconnectBaseDelayMs": 2000,
    "ReconnectMaxDelayMs": 30000
  },
  "GvMedia": {
    "Enabled": true,
    "BaseUrl": "http://radio:5004",
    "AuthKey": "",
    "CacheDirectory": "./data/gvmedia",
    "CacheMaxMegabytes": 50,
    "MaxPlaybackSeconds": 300,
    "MaxSpeechChars": 1000,
    "PreemptAtPriority": 8,
    "MaxQueuedWaitSeconds": 30,
    "FetchTimeoutSeconds": 15
  }
}
