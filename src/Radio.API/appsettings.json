{
  "$schema": "https://json.schemastore.org/appsettings.json",
  "Kestrel": {
    "Endpoints": {
      "Http": {
        "Url": "http://0.0.0.0:5000"
      }
    }
  },
  "Serilog": {
    "Using": [
      "Serilog.Sinks.File"
    ],
    "MinimumLevel": {
      "Default": "Warning",
      "Override": {
        "Radio": "Information",
        "RTLSDRCore": "Information",
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.Hosting.Lifetime": "Information"
      }
    },
    "WriteTo": [
      {
        "Name": "File",
        "Args": {
          "path": "./logs/radio-.txt",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 7,
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} [{Level:u3}] [{SourceContext}] {Message:lj}{NewLine}{Exception}"
        }
      }
    ],
    "Enrich": [
      "FromLogContext"
    ]
  },
  "AllowedHosts": "*",
  "Devices": {
    "Radio": {
      "USBPort": ""
    },
    "Vinyl": {
      "USBPort": ""
    },
  },
  "Database": {
    "RootPath": "./data",
    "ConfigurationSubdirectory": "config",
    "ConfigurationFileName": "configuration.db",
    "FingerprintingSubdirectory": "fingerprints",
    "FingerprintingFileName": "fingerprints.db",
    "SecretsSubdirectory": "secrets",
    "SecretsFileName": "secrets.db",
    "BackupSubdirectory": "backups",
    "BackupRetentionDays": 30
  },
  "ManagedConfiguration": {
    "DefaultStoreType": "Sqlite",
    "BasePath": "./config",
    "JsonExtension": ".json",
    "SqliteFileName": "configuration.db",
    "SecretsFileName": "secrets",
    "BackupPath": "./config/backups",
    "AutoSave": true,
    "BackupRetentionDays": 30
  },
  "Metrics": {
    "Enabled": true,
    "FlushIntervalSeconds": 60,
    "DatabasePath": "./data/metrics.db",
    "RetentionMinuteData": 120,
    "RetentionHourData": 48,
    "RetentionDayData": 365,
    "RollupIntervalMinutes": 60
  },
  "Fingerprinting": {
    "Enabled": true,
    "SampleDurationSeconds": 15,
    "IdentificationIntervalSeconds": 30,
    "MinimumConfidenceThreshold": 0.5,
    "DuplicateSuppressionMinutes": 5,
    "MinimumSecondsBetweenSongChanges": 20,
    "DatabasePath": "./data/fingerprints.db",
    "AcoustId": {
      "ApiKey": "${secret:acoustid_api_key}",
      "BaseUrl": "https://api.acoustid.org/v2",
      "MaxRequestsPerSecond": 3,
      "TimeoutSeconds": 10
    },
    "MusicBrainz": {
      "BaseUrl": "https://musicbrainz.org/ws/2",
      "ApplicationName": "RadioConsole",
      "ApplicationVersion": "1.0.0",
      "ContactEmail": "mark@mackelprang.com",
      "MaxRequestsPerSecond": 1,
      "TimeoutSeconds": 10
    },
    "SongRec": {
      "Enabled": true,
      "SongRecPath": "",
      "TimeoutSeconds": 15
    }
  },
  "AudioEngine": {
    "SampleRate": 48000,
    "Channels": 2,
    "BufferSize": 1024,
    "HotPlugIntervalSeconds": 5,
    "OutputBufferSizeSeconds": 5,
    "StreamReaderLagSeconds": 0.2,
    "EnableHotPlugDetection": true
  },
  "AudioOutput": {
    "Local": {
      "Enabled": true,
      "PreferredDeviceId": "",
      "DefaultVolume": 0.8
    },
    "GoogleCast": {
      "Enabled": true,
      "ApplicationId": "567E3DBA",
      "DiscoveryTimeoutSeconds": 10,
      "DefaultVolume": 0.7,
      "StreamingMode": "HttpMp3",
      "DirectChannelChunkSizeMs": 100,
      "DirectChannelNamespace": "urn:x-cast:com.radioconsole.audio"
    },
    "HttpStream": {
      "Enabled": true,
      "Port": 8080,
      "EndpointPath": "/stream/audio",
      "ContentType": "audio/wav",
      "SampleRate": 48000,
      "Channels": 2,
      "BitsPerSample": 16,
      "MaxConcurrentClients": 10,
      "ClientBufferSize": 65536,
      "Mp3Bitrate": 320
    }
  },
  "Audio": {
    "DefaultSource": "FilePlayer",
    "DuckingPercentage": 20,
    "DuckingPolicy": "FadeSmooth",
    "DuckingAttackMs": 100,
    "DuckingReleaseMs": 500
  },
  "AudioPreferences": {
    "CurrentSource": "FilePlayer",
    "CurrentOutput": "",
    "MasterVolume": 75
  },
  "TTS": {
    "GoogleAPIKey": "${secret:tts_google_api_key}",
    "AzureAPIKey": "${secret:tts_azure_api_key}",
    "AzureRegion": "eastus",
    "DefaultEngine": "Google",
    "DefaultVoice": "en-US-Standard-A",
    "DefaultSpeed": 1.0,
    "DefaultPitch": 1.0
  },
  "FilePlayer": {
    "RootDirectory": "media/audio",
    "SupportedExtensions": [
      ".mp3",
      ".flac",
      ".wav",
      ".ogg",
      ".aac",
      ".m4a",
      ".wma"
    ]
  },
  "FilePlayerPreferences": {
    "LastSongPlayed": "",
    "SongPositionMs": 0,
    "Shuffle": false,
    "Repeat": "Off"
  },
  "NotificationSounds": {
    "Directory": "media/sounds"
  },
  "Bluetooth": {
    "DeviceName": "Grandpas Radio",
    "AutoAcceptConnections": true,
    "RequirePairing": false,
    "EnableOnStartup": true,
    "AutoSwitchOnConnect": true,
    "AudioQuality": "High",
    "EnableA2dpSink": true,
    "EnableMediaSessionMonitoring": true
  },
  "BluetoothPreferences": {
    "LastConnectedDevice": "",
    "PairedDevices": [],
    "TrustedDevices": []
  },
  "RotaryEncoder": {
    "Enabled": false,
    "VendorId": 51966,
    "ProductId": 16389,
    "DevicePath": "",
    "PollIntervalMs": 10,
    "VolumeStepPercent": 2,
    "TuningStepKHz": 10,
    "ReconnectDelayMs": 2000
  },
  "PhoneIntegration": {
    "Enabled": false,
    "HubUrl": "http://localhost:5555/hubs/phone",
    "ContactsApiBaseUrl": "http://localhost:5555",
    "RingSoundPath": "media/sounds/phone-ring.wav",
    "RingPriority": 9,
    "AnnouncementPriority": 8,
    "ReconnectBaseDelayMs": 2000,
    "ReconnectMaxDelayMs": 30000
  }
}