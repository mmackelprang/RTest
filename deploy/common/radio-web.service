[Unit]
Description=Radio Console Web UI (Blazor Server)
After=network.target radio-api.service
Requires=radio-api.service

# === Restart rate limit (added 2026-08-10, crash-forensics) ===
# radio-web carried the identical defect as radio-api: no explicit StartLimit*
# keys, so it inherited DefaultStartLimitIntervalSec=10s / Burst=5, which
# RestartSec=10 below makes unreachable. See radio-api.service for the full
# rationale and the tradeoff this accepts.
#
# Note what this deliberately does NOT do. Requires=radio-api.service does not
# couple the two lifecycles the way it appears to: systemd propagates only an
# EXPLICIT stop/restart of radio-api to this unit. A unit that deactivates on
# its own — exactly what radio-api does when it exhausts StartLimitBurst and
# lands in `failed` — is NOT propagated across Requires= (see systemd.unit(5);
# BindsTo= is the dependency type that gives joint failure).
#
# So when radio-api trips its limiter, radio-web KEEPS RUNNING and serves a UI
# whose API is gone. That is a worse-looking failure than the console going
# dark, but switching Requires= to BindsTo= is a real behavior change to
# production service coupling and is deliberately out of scope for this change.
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
# Matches radio-api's user/group for consistent file ownership in /opt/radio-console.
User=mmack
Group=mmack
WorkingDirectory=/opt/radio-console

# === Complement to radio-api's pin to cores 2,3 (Plan D, 2026-05-22) ===
# Keep radio-web on cores 0,1 so it doesn't crowd the audio cores.
CPUAffinity=0 1
# Web is not audio-critical — default scheduling priority.
# === end ===

# === Memory guard (SOFT — added 2026-07-16, memory-hardening) ===
# SOFT limit (throttle + reclaim, never OOM-kill) — see radio-api.service for the
# full rationale on why this is MemoryHigh and not MemoryMax. The Blazor Server UI
# is lighter than the API; 350M is ample headroom.
MemoryHigh=350M
# .NET GC hard heap cap (768 MiB) — folded in from the box-only
# radio-web.service.d/memory-limit.conf drop-in (IAC audit §3.1). See
# radio-api.service for the MemoryHigh-vs-GC-cap rationale.
Environment=DOTNET_GCHeapHardLimit=0x30000000
# === end memory guard ===

ExecStart=/opt/radio-console/web/Radio.Web
Restart=always
RestartSec=10
KillSignal=SIGINT
SyslogIdentifier=radio-web
TimeoutStopSec=30

# Environment
Environment=ASPNETCORE_URLS=http://0.0.0.0:5002
Environment=ASPNETCORE_ENVIRONMENT=Production
Environment=DOTNET_EnableDiagnostics=0
Environment=DOTNET_BUNDLE_EXTRACT_BASE_DIR=/opt/radio-console/web/.bundle
Environment=ASPNETCORE_CONTENTROOT=/opt/radio-console/web
Environment=ApiBaseUrl=http://localhost:5000

# Security hardening
ProtectSystem=strict
# /opt/radio-console/data is needed for the SQLite config bridge (PR #422):
# SqliteConfigurationProvider reads configuration.db so the Web side honors
# user-saved Display:* / Radio:Rds:* values from the System Config page.
# Without this path, ProtectSystem=strict makes the DB file invisible and
# SqliteConfigurationProvider.Load() silently returns empty data — every
# IOptionsMonitor binding then falls back to its hardcoded default with
# no error or log line, defeating the bridge fix in production.
# Read-only access would suffice but ReadWritePaths is the established
# idiom in this codebase (matches radio-api.service line 81).
ReadWritePaths=/opt/radio-console/logs /opt/radio-console/web /opt/radio-console/data
PrivateTmp=true
ProtectHome=true
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
