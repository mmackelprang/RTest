[Unit]
Description=Radio Console API (audio engine, REST, SignalR)
After=network.target sound.target bluetooth.target avahi-daemon.service radio-pipewire-access.service radio-bt-setup.service
Wants=avahi-daemon.service radio-pipewire-access.service radio-bt-setup.service

# === Restart rate limit (added 2026-08-10, crash-forensics) ===
# These MUST live in [Unit], not [Service]. systemd >= 229 parses StartLimit*
# only from [Unit]; in [Service] it logs "Unknown key name ... ignoring" and the
# setting silently does nothing.
#
# Previously these keys were absent, so the unit inherited the system defaults
# (DefaultStartLimitIntervalSec=10s, DefaultStartLimitBurst=5). That combination
# is unreachable by construction: tripping it needs 5 starts inside 10s, but
# RestartSec=10 below guarantees consecutive restarts are >= 10s apart. The
# limiter could therefore NEVER engage and the service restarted forever no
# matter how hard it was failing — which is how a 37-hour outage went
# undiagnosed.
#
# 300s comfortably exceeds RestartSec (10s), so 5 failures inside 5 minutes now
# actually halts the unit.
#
# TRADEOFF, stated plainly: a genuine crash loop now leaves the radio DEAD until
# someone intervenes (`systemctl reset-failed radio-api && systemctl start
# radio-api`), instead of endlessly half-working. For a home audio appliance
# that is a real product decision, not a free win. It is deliberate: a unit
# stuck in `failed` is visible and diagnosable; silent infinite restarting is
# not. Reverting is a one-line change back to the defaults.
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
# Runs as mmack (uid 1000) — needed for PipeWire access via XDG_RUNTIME_DIR=/run/user/1000.
# Group=audio gives access to /dev/snd/* devices.
User=mmack
Group=audio
WorkingDirectory=/opt/radio-console

# === Audio-thread isolation (added 2026-05-22, Plan D) ===
# Pin to cores 2,3 (leave 0,1 for OS + journald + sshd + radio-web).
# Ubuntu N100 has 4 cores; layout: [OS,web] [audio,audio].
CPUAffinity=2 3

# Boost scheduling priority. LimitNICE is soft:hard where soft=highest-allowed-nice
# (least privilege) and hard=lowest-allowed-nice (most privilege). To allow the
# process to lower its nice to -5 we need hard=-5, soft=0 (or any value ≥ -5).
Nice=-5
LimitNICE=0:-5

# IO best-effort near-realtime (class 2, priority 2). Class 1 (realtime) is
# usually overkill for application audio; class 2 + low prio matches CCRMA/JACK
# guidance.
IOSchedulingClass=2
IOSchedulingPriority=2

# Allow process to use SCHED_FIFO up to priority 99 if it requests it via
# pthread_setschedparam (feature-flagged behind BluetoothOptions.UseRealtimeCaptureThread,
# default off). Without this limit the call would fail with EPERM.
LimitRTPRIO=99

# Allow mlock for any future low-latency pages (not used today; cheap to allow).
LimitMEMLOCK=infinity
# === end audio-thread isolation ===

# === Memory guard (SOFT — added 2026-07-16, memory-hardening) ===
# MemoryHigh is a SOFT limit: when the cgroup's memory usage exceeds it the
# kernel throttles the process and reclaims aggressively, but it is NEVER
# OOM-killed for crossing it. This is deliberately NOT MemoryMax (a hard cap
# that WOULD OOM-kill) — killing the audio service on a memory spike is worse
# than a brief throttle. 350M is generous headroom above the observed ~146MB
# steady-state cgroup footprint, leaving room for transient allocations
# (fingerprinting buffers, PlayHistory queries) without normal-operation churn.
MemoryHigh=350M
# .NET GC hard heap cap (768 MiB). Complements MemoryHigh: this bounds the
# managed heap the runtime will grow to (GC gets more aggressive as it nears the
# cap) BEFORE the cgroup soft-throttle engages. Folded in from the box-only
# radio-api.service.d/memory-limit.conf drop-in (IAC audit §3.1 / P0 memory-hardening).
Environment=DOTNET_GCHeapHardLimit=0x30000000
# === end memory guard ===

ExecStart=/opt/radio-console/api/Radio.API
Restart=always
RestartSec=10
KillSignal=SIGINT
SyslogIdentifier=radio-api
TimeoutStopSec=30

# Logging — Serilog prefixes app log lines with <N> syslog priority (e.g. <6>=info).
# SyslogLevelPrefix=true tells journald to parse these prefixes for priority assignment.
# C library noise (ALSA/JACK/PulseAudio) written to stdout WITHOUT a prefix defaults
# to StandardOutputPriority=debug, so it's filtered by `journalctl -p info`.
# View clean logs: journalctl -u radio-api -p info
# View everything:  journalctl -u radio-api -p debug
StandardOutput=journal
StandardError=journal
SyslogLevelPrefix=true
SyslogLevel=debug

# Environment
Environment=ASPNETCORE_URLS=http://0.0.0.0:5000
Environment=ASPNETCORE_ENVIRONMENT=Production
Environment=DOTNET_EnableDiagnostics=0
Environment=DOTNET_BUNDLE_EXTRACT_BASE_DIR=/opt/radio-console/api/.bundle
Environment=ASPNETCORE_CONTENTROOT=/opt/radio-console/api
Environment=HOME=/opt/radio-console

# Audio access
SupplementaryGroups=bluetooth pulse-access

# PipeWire access for Bluetooth audio capture (pw-record, pw-cli).
# PipeWire socket lives at /run/user/1000/pipewire-0 (login user session).
# XDG_RUNTIME_DIR tells pw-cli/pw-record where to find it.
# ACL on /run/user/1000 grants the radio user traverse permission
# (radio-pipewire-access.service sets: setfacl -m u:radio:x /run/user/1000).
Environment=XDG_RUNTIME_DIR=/run/user/1000
# DBus session bus — required for obexd (PBAP contact sync) and GNOME sleep/DPMS
# D-Bus calls. Folded in from the box-only radio-api.service.d/pipewire.conf
# drop-in (IAC audit §3.1 / P0-3). Same session as XDG_RUNTIME_DIR above.
Environment=DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/1000/bus

# Security hardening
# NOTE: ProtectHome=true hides /run/user (PipeWire socket), so we can't use it.
# ProtectSystem=strict creates a read-only overlay over /run, also blocking PipeWire.
# Both are disabled to allow PipeWire access for BT audio capture.
ProtectSystem=false
ReadWritePaths=/opt/radio-console
PrivateTmp=true
ProtectHome=false
NoNewPrivileges=false
AmbientCapabilities=CAP_NET_ADMIN

[Install]
WantedBy=multi-user.target
