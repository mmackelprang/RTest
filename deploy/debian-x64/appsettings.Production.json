{
  "AudioOutput": {
    "DeviceDisplay": {
      "HiddenDevicePatterns": [
        "^Monitor of ",
        "Rate Converter Plugin",
        "JACK Audio",
        "Open Sound System",
        "PulseAudio",
        "Speex DSP",
        "channel upmix",
        "channel downmix",
        "Discard all samples"
      ],
      "FriendlyNames": [
        { "Pattern": "Default Audio Output", "FriendlyName": "System Default" }
      ]
    },
    "GoogleCast": {
